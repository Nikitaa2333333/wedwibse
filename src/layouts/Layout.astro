---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** абсолютный или корневой путь к обложке для соцсетей */
  ogImage?: string;
}

const {
  title,
  description = 'WED Secrets — свадебный онлайн-сервис',
  ogImage,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://wedwed.ru');

// ВРЕМЕННО (снять перед запуском, см. SEO.md): сайт закрыт от поисковиков.
// Пока идёт дизайн-фаза, сырые страницы не должны попасть в индекс —
// выкатились бы в выдачу недоделанными и потом висели там месяцами.
// Открыть индексацию — собрать с SITE_INDEXABLE=true (см. .github/workflows).
const indexable = process.env.SITE_INDEXABLE === 'true';
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {/* Цвет адресной строки мобильного браузера — под тему; правит его
        applyTheme из lib/theme.ts. Здесь стоит светлый: сборка статическая,
        и что выбрал человек, сервер знать не может. Системные части,
        которые CSS не красит (резинка скролла, встроенные контролы),
        держит color-scheme в global.css — он меняется вместе с палитрой. */}
    <meta name="theme-color" content="#ffffff" />
    {!indexable && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Onest:wght@200;300;400;500;600&display=swap"
      rel="stylesheet"
    />
    <link rel="canonical" href={canonical.href} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content="WED Secrets" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    {ogImage && <meta property="og:image" content={new URL(ogImage, canonical).href} />}
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    <slot name="head" />
    <script is:inline>
      // Стартовые состояния анимации применяются только при живом JS —
      // без него контент виден сразу (защита от «пустой страницы»).
      document.documentElement.classList.add('js');

      // ТЕМА ДО ОТРИСОВКИ. Сборка статическая: HTML уезжает на сервер
      // светлым, и выбранную тёмную ставит уже браузер. Сделать это надо
      // здесь, в <head> до <body>, иначе человек с тёмной темой ловит
      // белую вспышку страницы на каждом переходе.
      //
      // Скрипт намеренно самостоятельный (is:inline = не бандлится, импорт
      // сюда невозможен) — отсюда единственное в проекте дублирование
      // ключа и цвета: остальное живёт в lib/theme.ts, правим парой.
      try {
        if (localStorage.getItem('wed:theme') === 'dark') {
          document.documentElement.dataset.theme = 'dark';
          document
            .querySelector('meta[name="theme-color"]')
            .setAttribute('content', '#1c1815');
        }
      } catch (e) {
        // приватный режим — едем на светлой, это не повод ронять страницу
      }
    </script>
  </head>
  <body>
    <slot />

    <script>
      // ============ МОУШН-ФУНДАМЕНТ ============
      // Lenis — плавный инерционный скролл (нативный scroll остаётся,
      // поэтому CSS scroll-driven анимации продолжают работать).
      //
      // ПОЯВЛЕНИЯ БЛОКОВ ПРИ ПРОКРУТКЕ В ПРОЕКТЕ НЕТ. Был reveal на
      // IntersectionObserver (data-reveal / data-reveal-group) — снят
      // намеренно, и на телефоне, и на ПК: контент должен стоять на месте
      // сразу, а не проявляться по мере доскролла. Каталог листают быстро,
      // и блок, который догоняет прокрутку, читается как подтормаживание,
      // а не как оживление. Заводить обратно — только по отдельной просьбе.
      import Lenis from 'lenis';

      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // ВРЕМЕННО: плавный скролл выключен — проверяем, он ли ощущается
      // как «тормоза» (инерция Lenis даёт задержку отклика на колесо).
      // Вернуть — поставить true.
      const SMOOTH_SCROLL = false;

      if (!reduced && SMOOTH_SCROLL) {
        const lenis = new Lenis({ lerp: 0.1 });
        const raf = (time: number) => {
          lenis.raf(time);
          requestAnimationFrame(raf);
        };
        requestAnimationFrame(raf);
      }

    </script>
  </body>
</html>
