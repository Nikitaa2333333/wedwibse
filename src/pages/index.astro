---
import Layout from '../layouts/Layout.astro';
import BottomDock from '../components/BottomDock.astro';
import EntryRail from '../components/EntryRail.astro';
import PhotoBoard from '../components/PhotoBoard.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import Icon from '../components/Icon.astro';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

// ЛОГОТИП — встроенный <svg>, не CSS-маска (маской браузер растрирует
// svg в родном размере и растягивает — знак выходил пиксельным).
// Знак «крем» (06.10.2026): Cormorant Unicase + Tenor Sans в кривых,
// цвет — currentColor, сам берёт --ink и тёмную тему. Прежний знак
// с биркой лежит в public/logo-tag.svg.
const creamFile = readFileSync(join(process.cwd(), 'public/logo-unicase.svg'), 'utf8');
const creamViewBox = creamFile.match(/viewBox="([^"]+)"/)![1];
const creamShapes = (creamFile.match(/<path\b[^>]*\/>/g) ?? []).join('');
const logoCreamSvg = `<svg viewBox="${creamViewBox}" xmlns="http://www.w3.org/2000/svg" focusable="false">${creamShapes}</svg>`;
---

<Layout title="Свадебные Секреты — лучшие площадки и специалисты">
  <div class="page">
    <!-- ГЕРОЙ: шапка (бренд / меню / метка) + крупный заголовок с лидом
         сразу под ней — без пустого экрана, плашки идут следующим блоком. -->
    <section class="hero container--wide">
      <!-- Шапка главной: логотип по центру, справа тумблер темы и вход
           в кабинет. Разделы живут в BottomDock — дублировать их сверху
           не нужно.
           Тумблер стоит здесь, а не в доке: док — это разделы сайта,
           пятая ячейка ужала бы подписи («Специалисты» и сейчас с
           многоточием). Выбор темы запоминается, поэтому одной точки
           переключения хватает — на внутренних страницах тема уже стоит. -->
      <header class="hero__bar">
        <!-- Знак в левом углу шапки, как у сайтов обычно (заказчик,
             06.10.2026), а не крупно по центру: первый экран сразу
             начинается с разделов. Он же h1 главной: текст остаётся
             в HTML для поиска и экранного диктора, глазам виден знак. -->
        <h1 class="hero__title">
          <span class="hero__title-text">Свадебные секреты</span>
          <span class="hero__logo" aria-hidden="true" set:html={logoCreamSvg}></span>
        </h1>

        <div class="hero__actions">
          <ThemeToggle />

          <a class="icon-btn" href="#" aria-label="Личный кабинет">
            <Icon name="account" />
          </a>
        </div>
      </header>
    </section>

    <!-- ВХОДЫ: цветные карточки разделов и направлений, лента вбок.
         Раньше это были две фото-плашки первой строкой доски; теперь
         разделов не два, а два плюс два десятка направлений — см.
         EntryRail и DESIGN.md. -->
    <EntryRail />

    <!-- ДОСКА: все кадры каталога масонри-раскладкой, часть плиток
         листается. Статьи лежат в том же потоке (см. PhotoBoard) —
         отдельной секции «Журнал» на главной нет: она дублировала бы то,
         что человек уже встретил, пока листал. Внизу остаётся только
         вход в блог целиком. -->
    <PhotoBoard />

    {/* Вход в журнал снят вместе со статьями в доске (06.10.2026):
        журнал пока не показываем. Вернуть — блок .journal-more
        с пилюлей «Весь журнал» на /blog/ (стили ниже оставлены). */}

    <BottomDock active="feed" />
  </div>
</Layout>

<style>
  .page {
    background: var(--bg);
    min-height: 100svh;
    padding-bottom: calc(var(--safe-b) + 96px); /* воздух под плавающие пилюли */
  }

  /* Главная живёт шире обычного контента: почти в край экрана */
  .container--wide {
    width: 100%;
    max-width: none;
    margin-inline: auto;
    padding-inline: var(--home-edge);
  }

  /* ============ ГЕРОЙ: шапка + заголовок, без пустого экрана ============ */
  /* Снизу — минимум: первая плитка доски прижата к подсказке про избранное,
     воздух между заголовком и лентой съедал полэкрана на телефоне. */
  .hero {
    background: var(--bg);
    color: var(--ink);
    /* Снизу поле поджато (заказчик, 21.09.2026): вместе с полем ряда
       входов под ним между подписью и плитками стояло 40px — дыра,
       из-за которой первый экран читался двумя разными блоками,
       а не одним. Теперь 16px: плитки идут сразу за обещанием. */
    padding-block: var(--s-5) var(--s-3);
  }

  /* Шапка: знак прижат к левому краю, тумблер темы и кабинет — к правому
     (заказчик, 06.10.2026: «как обычно стоит»). До этого знак крупно
     стоял по центру под шапкой и съедал полэкрана телефона. */
  .hero__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    padding-block: var(--s-1) 0;
  }

  /* h1 главной — это знак: обнуляем типографику заголовка, размер
     задаёт ширина знака. min-width: 0 — во flex элемент иначе не
     сжимается меньше содержимого и выталкивает кнопки за экран. */
  .hero__title {
    min-width: 0;
    margin: 0;
    line-height: 0;
  }

  /* Знак двухстрочный, пропорция ~3:1. В шапке, но не мелко (заказчик,
     06.10.2026): на телефоне ~180px в ширину — заметно выше кнопок справа,
     на ПК до 280px. Цвет из --ink через currentColor — сам берёт тёмную тему. */
  .hero__logo {
    display: block;
    width: clamp(172px, 48vw, 280px);
    color: var(--ink);
  }

  /* svg вставлен через set:html — scoped-атрибута у него нет, поэтому
     :global внутри своего же элемента (не чужого компонента) */
  .hero__logo :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  /* Текст h1 — для поиска и экранного диктора, глазам виден знак */
  .hero__title-text {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Кружки справа — .icon-btn из реестра. */
  .hero__actions {
    flex: none;
    display: flex;
    align-items: center;
    gap: var(--s-2);
  }

  /* ============ ВХОД В БЛОГ ============
     Сами статьи попадаются в доске выше; тут только ссылка на журнал
     целиком — по центру, без заголовка и без карточек. */
  .journal-more {
    display: flex;
    justify-content: center;
    padding-bottom: var(--s-8);
  }
</style>

<script>
  // ВЕТКА-ПРЕВЬЮ: сердце теперь на каждой плитке доски (PhotoMasonry) —
  // значит и главной нужен обработчик избранного, раньше его тут не было.
  import { bindSaveButtons } from '../lib/save';

  bindSaveButtons();
</script>
