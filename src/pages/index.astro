---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import BottomDock from '../components/BottomDock.astro';
import PhotoRail from '../components/PhotoRail.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { ARTICLES } from '../data/articles';

// Галерея: колонки фотографий, каждая едет со своей скоростью.
// Кадры не наезжают друг на друга; крайние колонки срезаются краем экрана.
// ratio — пропорция кадра, off — стартовый сдвиг колонки вниз (vh).
import { collectGalShots, collectWelcomeShots } from '../lib/imageSize';

// Настоящие фото Ривер Лофт. Пропорции читаются из самих файлов —
// вёрстка подстраивается под кадр, а не кадр под вёрстку.
const pool = [...collectGalShots(), ...collectWelcomeShots()];

// w — доля ширины колонки. Широкие колонки просят горизонтальные кадры,
// узкие — вертикальные: так каждый снимок попадает в свою форму.
const columnDefs = [
  { w: 0.85, speed: 1.0, off: 0 },
  { w: 1.5, speed: 1.5, off: 14 },
  { w: 0.8, speed: 0.7, off: 5 },
  { w: 1.35, speed: 1.3, off: 20 },
];

const PER_COLUMN = 5;
const left = [...pool];

// Для каждой ячейки берём кадр, чья пропорция ближе к «аппетиту» колонки:
// широкой нужен горизонтальный (ratio ~1.4), узкой — вертикальный (~0.7).
const columns = columnDefs.map((col) => {
  const want = col.w >= 1.1 ? 1.4 : 0.72;
  const shots = [];

  for (let i = 0; i < PER_COLUMN && left.length; i++) {
    let best = 0;
    for (let j = 1; j < left.length; j++) {
      if (Math.abs(left[j].ratio - want) < Math.abs(left[best].ratio - want)) best = j;
    }
    shots.push(left.splice(best, 1)[0]);
  }

  return { ...col, shots };
});

const galTemplate = columnDefs.map((c) => `${c.w}fr`).join(' ');

// ПРЕИМУЩЕСТВА: крупные плашки в два столбца с минимальным стыком —
// сразу на главном экране показываем, что умеет сервис.
const perks = [
  {
    kind: 'photo',
    name: 'Площадки',
    tag: 'Выберите площадку под&nbsp;свой формат',
    imgs: [
      '/venues/river-loft/hero-pt-5.webp',
      '/venues/river-loft/hero-pt-6.webp',
      '/venues/river-loft/hero-pt-7.webp',
      '/venues/river-loft/hero-pt-8.webp',
    ],
    alt: 'Зал площадки Ривер Лофт',
    href: '/moskva/ploshchadki/',
  },
  {
    kind: 'light',
    name: 'Специалисты',
    tag: '30+ направлений',
    words: ['Ведущие', 'Хореографы', 'Диджеи', 'Фотографы', 'Декораторы'],
    // Кадры специалистов за работой — тот же слайдер, что у площадок,
    // только кадр уходит в бумажный градиент: поверх идут колесо и подписи.
    imgs: [
      '/specialists/glavnaya/fotograf.png',
      '/specialists/glavnaya/konditer.png',
    ],
    alt: 'Специалисты за работой',
    href: '/moskva/podryadchiki/vedushchie/',
  },
];

// ЖУРНАЛ: три свежих статьи прямо на главной. Блог — вход воронки
// «статья → подборка → карточка» (SEO.md), поэтому ссылки на него
// лежат в HTML главной, а не только в шапке каталога.
const latest = ARTICLES.slice(0, 3);
---

<Layout title="Свадебные Секреты — лучшие площадки и специалисты">
  <div class="page">
    <!-- ГЕРОЙ: шапка (бренд / меню / метка) + крупный заголовок с лидом
         сразу под ней — без пустого экрана, плашки идут следующим блоком. -->
    <section class="hero container--wide">
      <!-- Шапка главной: только логотип по центру и вход в кабинет.
           Разделы живут в BottomDock — дублировать их сверху не нужно. -->
      <header class="hero__bar">
        <a class="hero__brand" href="/" aria-label="WED Secrets — на главную">
          <span class="hero__logo" aria-hidden="true"></span>
        </a>

        <a class="hero__account" href="#" aria-label="Личный кабинет">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
            <circle cx="12" cy="8" r="3.6" />
            <path d="M4.5 20c1.6-3.6 5-5.4 7.5-5.4s5.9 1.8 7.5 5.4" stroke-linecap="round" />
          </svg>
        </a>
      </header>

      <div class="hero__intro">
        <h1 class="hero__title">Всё для вашей свадьбы в пару кликов</h1>

        <a class="hero__hint" href="/izbrannoe/">
          <span class="perk__heart-wrap">
            <svg class="perk__heart" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <path
                d="M12 20.2s-7.2-4.4-9.7-8.6C.7 8 2 4.3 5.4 3.5c2.4-.6 4.6.5 6.6 3.2 2-2.7 4.2-3.8 6.6-3.2 3.4.8 4.7 4.5 3.1 8.1-2.5 4.2-9.7 8.6-9.7 8.6Z"
                stroke-linejoin="round"
              />
            </svg>
            <span class="perk__badge" aria-hidden="true">1</span>
          </span>
          <span class="hero__hint-text t-small">
            Сохраняйте в избранное и обращайтесь ко всем сразу — так вы найдёте лучшее
            предложение для своей свадьбы
          </span>
        </a>
      </div>
    </section>

    <!-- ПРЕИМУЩЕСТВА: крупные плашки, минимальный стык -->
    <section class="perks container--wide">
      <div class="perks__grid" data-reveal-group>
        <a class="perk perk--photo" href={perks[0].href}>
          <PhotoRail
            photos={perks[0].imgs}
            alt={perks[0].alt}
            sizes="(min-width: 1024px) 50vw, 100vw"
            widths={[560, 900, 1400]}
          />
          <span class="perk__index" aria-hidden="true">(01)</span>
          <span class="perk__overlay">
            <span class="perk__name">{perks[0].name}</span>
            <span class="perk__tag" set:html={perks[0].tag} />
          </span>
        </a>

        <a class="perk perk--light" href={perks[1].href}>
          <PhotoRail
            photos={perks[1].imgs}
            alt={perks[1].alt}
            sizes="(min-width: 1024px) 50vw, 100vw"
            widths={[560, 900, 1400]}
          />
          <span class="perk__scrim" aria-hidden="true"></span>

          <div class="perk__body">
            <span class="perk__top">
              <span class="perk__tag">{perks[1].tag}</span>
              <span class="perk__arrow">↗</span>
            </span>
            <span class="perk__name">{perks[1].name}</span>
          </div>

          <span class="perk__list" aria-hidden="true">
            <span class="perk__list-track">
              {perks[1].words.concat(perks[1].words).map((word) => (
                <span class="perk__word">{word}</span>
              ))}
            </span>
          </span>

          <span class="perk__index" aria-hidden="true">(02)</span>
        </a>
      </div>
    </section>

    <!-- КОЛЛАЖ: фотографии внахлёст, каждая своей скоростью — «эффект праздника» -->
    <section class="scatter">

      <div class="gal" style={`--tpl:${galTemplate};`}>
        {columns.map((col) => (
          <div class="gal__col" style={`--off:${col.off};`} data-speed={col.speed}>
            {col.shots.map((s) => (
              <figure class="shot" style={`--ratio:${s.w} / ${s.h};`}>
                <a class="shot__link" href="/moskva/ploshchadki/river-loft/" aria-label="Ривер Лофт — страница площадки">
                  <Image
                    src={s.image}
                    widths={[440, 760, 1100]}
                    sizes="(min-width: 1024px) 32vw, 46vw"
                    alt="Свадьба в Ривер Лофт"
                    loading="lazy"
                    decoding="async"
                  />
                </a>
              </figure>
            ))}
          </div>
        ))}
      </div>
    </section>

    <!-- ЖУРНАЛ: вход в блог с главной -->
    <section class="journal container--wide" aria-labelledby="journal-title">
      <header class="journal__head">
        <h2 class="journal__title" id="journal-title">Журнал</h2>
        <a class="pill pill--sm" href="/blog/">Все статьи</a>
      </header>

      <div class="journal__grid" data-reveal-group>
        {latest.map((article) => <ArticleCard article={article} />)}
      </div>
    </section>

    <BottomDock active="feed" />
  </div>
</Layout>

<script>
  // ============ ХОРЕОГРАФИЯ ЗАГРУЗКИ ============
  // 1. Строки заголовка выезжают из масок.
  // 2. Следом «раскрываются» фотографии: clip-path снизу вверх
  //    + одновременный отъезд масштаба (кадр будто оживает).
  // 3. Всё, что ниже первого экрана, раскрывается при подходе скролла.
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Параллакс коллажа — только от планшета. На телефоне колонки-обёртки
  // распущены в две многоколоночные (см. media-блок в стилях): двигать
  // там нечего, и мобильный моушн-бюджет на это не тратится.
  const wideEnough = window.matchMedia('(min-width: 768px)').matches;

  if (wideEnough && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    // ============ ГАЛЕРЕЯ: колонки едут с разной скоростью ============
    // Стартовый сдвиг колонки берём из --off, дальше сдвигаем по скроллу.
    const vh = () => window.innerHeight / 100;

    gsap.utils.toArray<HTMLElement>('.gal__col').forEach((col) => {
      const speed = parseFloat(col.dataset.speed || '1');
      const off = parseFloat(getComputedStyle(col).getPropertyValue('--off')) || 0;

      gsap.fromTo(
        col,
        { y: () => off * vh() },
        {
          y: () => off * vh() + (1 - speed) * 34 * vh(),
          ease: 'none',
          scrollTrigger: {
            trigger: '.scatter',
            start: 'top bottom',
            end: 'bottom top',
            scrub: 0.6,
            invalidateOnRefresh: true,
          },
        }
      );
    });
  }
</script>

<style>
  .page {
    background: var(--bg);
    min-height: 100svh;
    padding-bottom: calc(var(--safe-b) + 96px); /* воздух под плавающие пилюли */
  }

  /* Главная живёт шире обычного контента: почти в край экрана */
  .container--wide {
    width: 100%;
    max-width: none;
    margin-inline: auto;
    padding-inline: clamp(10px, 1.5vw, 24px);
  }

  /* ============ ГЕРОЙ: шапка + заголовок, без пустого экрана ============ */
  .hero {
    background: var(--bg);
    color: var(--ink);
    padding-block: var(--s-5) var(--section-gap-tight);
  }

  /* Три колонки: логотип стоит ровно по центру экрана независимо от того,
     что справа (кабинет), — крайние колонки одинаковой ширины. */
  /* Логотип слева, аккаунт справа — крайние колонки, середина пустая
     и распирает их по краям контейнера. */
  .hero__bar {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--s-4);
    padding-block: var(--s-4);
  }

  .hero__brand {
    grid-column: 1;
    display: inline-flex;
    text-decoration: none;
    color: inherit;
  }

  /* Логотип-леттеринг «Wed secrets». Цвет берём не из файла, а маской:
     форма из SVG, заливка — из токена, поэтому знак сам подхватывает
     палитру секции. Прежний каллиграфический знак лежит рядом
     (public/logo-script.svg) — вернуть можно одной строкой.
     Высота ниже прежней: у гротеска буквы занимают почти весь кадр,
     а у каллиграфии половину высоты съедали поля. */
  .hero__logo {
    display: block;
    height: clamp(15px, 1.8vw, 22px);
    aspect-ratio: 1614 / 210;   /* пропорции самого файла logo.svg */
    background: var(--ink);
    -webkit-mask: url('/logo.svg') no-repeat center / contain;
    mask: url('/logo.svg') no-repeat center / contain;
  }

  .hero__account {
    grid-column: 3;
    justify-self: end;
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1.5px solid currentColor;
    display: flex;
    align-items: center;
    justify-content: center;
    color: inherit;
  }

  .hero__account svg { width: 18px; height: 18px; }

  .hero__intro { padding-top: var(--s-3); }

  /* На широком экране лид встаёт рядом с заголовком, справа, одним блоком */
  @media (min-width: 768px) {
    .hero__intro {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: var(--s-6);
    }
  }

  /* Крупный заголовок — сразу виден, без прокрутки пустого экрана.
     Цветом не красится: на первом экране акцент несёт логотип, и второй
     оранжевый узел рядом с ним отбирает у него внимание. */
  .hero__title {
    /* сжиматься обязаны оба: с flex-shrink: 0 у заголовка и подсказки
       их сумма на 1280 не влезала в строку и подсказку выносило за экран */
    min-width: 0;
    /* потолки кеглей героя и плашек = −10% от прежних: ровно тот масштаб,
       в котором главная читалась при зуме браузера 90%.
       Нижняя граница поднята с 30 до 34, резина считается от ширины экрана
       (8.6vw): на 390px заголовок первого экрана шёл вровень с именем
       плашки под ним — две ступени иерархии схлопывались в одну. */
    font-size: clamp(34px, 8.6vw, 50px);
    font-weight: var(--w-head-lg);
    line-height: 0.9;
    letter-spacing: -0.03em;
    max-width: var(--measure-head);
  }

  /* Подсказка про избранное: сердце из перка (та же мини-демо-анимация)
     + короткая строка — единственная подсказка, что делать на сайте */
  .hero__hint {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    margin-top: var(--s-5);
    min-width: 0;
    text-decoration: none;
    color: inherit;
  }

  .hero__hint-text { font-weight: var(--w-medium); }

  @media (min-width: 768px) {
    .hero__hint { margin-top: 0; }

    /* Мера подсказки: ch считается от кегля элемента, поэтому при снижении
       --fs-body с 21 до 18px прежние 44ch съехали в три строки. 52ch дают
       ту же физическую ширину (~465px) и держат фразу в две строки. */
    .hero__hint-text { max-width: 52ch; }
  }

  /* ============ ПРЕИМУЩЕСТВА: крупные плашки, минимальный стык ============ */
  .perks {
    background: var(--bg);
    padding: 0;
    max-width: none;
  }

  .perks__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;                   /* плашки встык, без шва */
    background: var(--surface-dim);
  }

  .perk {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    aspect-ratio: 3 / 4;
    padding: var(--s-5);
    background: var(--surface);
    color: var(--ink);
    text-decoration: none;
    overflow: hidden;
  }

  .perk__top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-3);
  }

  .perk__tag {
    font-size: var(--fs-small);
    font-weight: var(--w-medium);
    line-height: 1.35;
  }

  .perk__arrow {
    font-size: var(--fs-body);
    line-height: 1;
  }

  /* Имя плашки — витринный кегль: плашка занимает полэкрана, и заголовок
     считается от её ширины, а не от страницы. Потолок держим ниже кегля h1
     (50px): на 58px имя плашки перебивало главный заголовок страницы. */
  .perk__name {
    font-size: clamp(27px, 4.5vw, 44px);
    font-weight: var(--w-head);
    line-height: 1.05;
    letter-spacing: -0.015em;
  }

  /* Фото-плашка: тот же слайдер, что в каталоге (PhotoRail) — кадры
     листаются при наведении и свайпом, с точками-индикаторами.
     Медленной автопрокрутки нет: движение только по действию пользователя. */
  .perk--photo { padding: 0; overflow: hidden; }

  .perk--photo :global(.prail-wrap) {
    position: absolute;
    inset: 0;
  }

  .perk--photo :global(.prail) {
    aspect-ratio: auto;
    height: 100%;
  }

  .perk__overlay {
    position: relative;
    margin-top: auto;
    padding: var(--s-5);
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    color: var(--white);
  }

  /* Светлая плашка: слева статичный текст, справа — колесо категорий
     во всю высоту карточки (там как раз оставалось пустое место). */
  .perk--light {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: stretch;
    background: var(--paper);
    color: var(--ink);
  }

  /* Фото занимает левую часть плашки и растворяется в бумажном фоне:
     колесо категорий справа остаётся на чистой бумаге, а текст лежит
     не на самом кадре, а на плотной части градиента. */
  .perk--light :global(.prail-wrap) {
    position: absolute;
    inset: 0 34% 0 0;
  }

  .perk--light :global(.prail) {
    aspect-ratio: auto;
    height: 100%;
    background: var(--paper);
  }

  /* Затемнение под подписи из PhotoRail тут лишнее: текст на этой плашке
     тёмный, и тёмный низ кадра его только глушит. */
  .perk--light :global(.veil) { display: none; }

  /* Переход фото → бумага. Слева кадр почти чистый, к середине светлеет,
     справа — сплошной фон плашки, стык кадра не читается. */
  .perk__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      transparent 0%,
      color-mix(in srgb, var(--paper) 55%, transparent) 34%,
      var(--paper) 66%
    );
    pointer-events: none;
  }

  .perk__body {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-width: 0;
    grid-column: 1;
  }

  /* Колесо категорий — крутится непрерывно, крупно, обрезается краями
     самой карточки. Маска глушит верх/низ: в фокусе только середина,
     к краям слова уходят в прозрачность — как у «колеса» с активной точкой. */
  .perk__list {
    position: relative;
    grid-column: 2;
    overflow: hidden;
    text-align: right;
    mask-image: linear-gradient(to bottom, transparent 0%, black 38%, black 62%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 38%, black 62%, transparent 100%);
  }

  .perk__list-track {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    animation: perk-scroll 14s linear infinite;
  }

  .perk__word {
    height: 1.15em;
    display: flex;
    align-items: center;
    /* Бегущая колонка направлений — фон-текстура, а не заголовок: на 48px
       она вставала вровень с h1 и с именем плашки, три уровня схлопывались. */
    font-size: clamp(27px, 4vw, 38px);
    font-weight: var(--w-head);
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  @keyframes perk-scroll {
    from { transform: translateY(0); }
    to { transform: translateY(-50%); }
  }

  /* Номер плашки — как «(01)» в углу карточки, чисто декоративная деталь */
  .perk__index {
    position: absolute;
    right: var(--s-5);
    bottom: var(--s-5);
    font-size: var(--fs-caption);
    font-weight: var(--w-medium);
    color: var(--white);
  }

  .perk--light .perk__index { color: inherit; }

  .perk__heart-wrap {
    position: relative;
    display: inline-flex;
  }

  .perk__heart {
    width: clamp(32px, 4vw, 48px);
    height: clamp(32px, 4vw, 48px);
    transform-origin: center;
    animation: perk-heart-tap 4s ease-in-out infinite, perk-heart-fill 4s steps(1, end) infinite;
  }

  /* Мини-демо «сохранили в избранное»: сердце жмётся и заливается,
     следом всплывает счётчик — короткий цикл, крутится по кругу. */
  @keyframes perk-heart-tap {
    0%, 16% { transform: scale(1); }
    20% { transform: scale(1.3); }
    24%, 88% { transform: scale(1); }
    100% { transform: scale(1); }
  }

  @keyframes perk-heart-fill {
    0%, 19% { fill: none; }
    20%, 88% { fill: currentColor; }
    89%, 100% { fill: none; }
  }

  .perk__badge {
    position: absolute;
    top: -6px;
    right: -10px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--bg);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    font-weight: var(--w-medium);
    animation: perk-badge-pop 4s ease-out infinite;
  }

  @keyframes perk-badge-pop {
    0%, 22% { transform: scale(0); opacity: 0; }
    28% { transform: scale(1.2); opacity: 1; }
    34%, 82% { transform: scale(1); opacity: 1; }
    90%, 100% { transform: scale(0); opacity: 0; }
  }

  @media (hover: hover) {
    .perk { transition: transform var(--dur-fast) var(--ease-out); }
    .perk__arrow { transition: transform var(--dur-fast) var(--ease-out); }
    .perk:hover .perk__arrow { transform: translate(3px, -3px); }
  }

  /* ============ ПЛАШКИ НА ТЕЛЕФОНЕ ============
     На 390px плашка шириной ~190px, и раскладка «текст слева, колесо
     справа» разваливалась: слова направлений (nowrap, 27px) не влезали
     в свою колонку и наезжали на имя. Разворачиваем плашку в три яруса
     сверху вниз — кадр, колесо направлений, подпись: то же содержание,
     но каждому ярусу достаётся вся ширина.
     Плашка заодно вытягивается (2:3 вместо 3:4): три яруса в приземистый
     кадр не помещаются, да и первый экран от вертикали только выигрывает. */
  @media (max-width: 639px) {
    .perk {
      aspect-ratio: 2 / 3;
      padding: var(--s-4);
    }

    .perk--photo { padding: 0; }
    .perk--photo .perk__overlay { padding: var(--s-4); }
    .perk__index { right: var(--s-4); bottom: var(--s-4); }

    /* Ярусы: кадр держит свою долю высоты сам (он вне потока),
       под ним колесо, ещё ниже подпись. */
    .perk--light {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: 44% minmax(0, 1fr) auto;
    }

    .perk--light :global(.prail-wrap) { inset: 0 0 auto 0; height: 46%; }

    /* Кадр растворяется в бумаге не вбок, а вниз: под ним живёт текст */
    .perk__scrim {
      background: linear-gradient(
        to bottom,
        transparent 30%,
        color-mix(in srgb, var(--paper) 60%, transparent) 40%,
        var(--paper) 48%
      );
    }

    .perk__list {
      grid-column: 1;
      grid-row: 2;
      text-align: left;
    }

    .perk__list-track { align-items: flex-start; }

    .perk__word { font-size: clamp(19px, 5.6vw, 26px); }

    .perk__body {
      grid-column: 1;
      grid-row: 3;
      justify-content: flex-start;
      gap: var(--s-2);
    }

    /* Стрелка уводит взгляд вправо от подписи, которой рядом уже нет */
    .perk--light .perk__top { justify-content: flex-start; gap: var(--s-2); }
  }

  /* ============ КОЛЛАЖ «ПРАЗДНИК» ============ */
  .scatter {
    position: relative;
    z-index: 1;
    background: var(--bg);
