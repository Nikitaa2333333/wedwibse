    padding-bottom: var(--section-gap);
  }

  /* Колонки фотографий: шире экрана, поэтому крайние срезаются краем.
     --gal-gap — единственная ручка зазора коллажа: на телефоне волосок,
     как стык карточек каталога, на ПК полноценный шов. */
  .gal {
    --gal-gap: clamp(3px, 0.8vw, 10px);
    display: grid;
    grid-template-columns: var(--tpl); /* колонки разной ширины */
    gap: var(--gal-gap);
    width: 100%;
  }

  .gal__col {
    display: flex;
    flex-direction: column;
    gap: var(--gal-gap);
    transform: translateY(calc(var(--off) * 1vh));
  }

  .shot {
    display: block;
    aspect-ratio: var(--ratio); /* пропорция берётся из самого файла */
    overflow: hidden;
    background: var(--surface-dim);
  }

  /* ============ КОЛЛАЖ НА ТЕЛЕФОНЕ: ДВЕ КОЛОНКИ ============
     Четыре колонки на 390px давали марки вместо фотографий. Колонки-обёртки
     распускаем (display: contents) и раскладываем сами кадры в две колонки
     многоколоночной вёрсткой — она сама уравнивает их высоту, чего сетка
     из четырёх разноскоростных колонок сделать не может. Параллакс на
     телефоне при этом выключен (скрипт ниже): двигать нечего — коробок
     колонок больше нет, да и моушн-бюджет мобилки этого не просит.
     Кадров показываем по три из каждой исходной колонки: все двадцать
     в две колонки — пять экранов прокрутки только галереи. */
  @media (max-width: 767px) {
    .gal {
      display: block;
      column-count: 2;
      column-gap: var(--gal-gap);
    }

    .gal__col { display: contents; }

    .gal__col .shot:nth-child(n + 4) { display: none; }

    .shot {
      break-inside: avoid;
      margin-bottom: var(--gal-gap);
    }
  }

  .shot__link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
  }

  /* ============ ЖУРНАЛ: три статьи + вход в блог ============ */
  .journal { padding-bottom: var(--s-8); }

  .journal__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    margin-bottom: var(--s-6);
  }

  .journal__title {
    font-size: var(--fs-h2);
    font-weight: var(--w-head);
    line-height: var(--lh-heading);
    letter-spacing: var(--ls-display);
  }

  .journal__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-7) clamp(8px, 1vw, 16px);
  }

  @media (min-width: 768px) {
    .journal__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  /* ============ ПК ============ */
  @media (min-width: 1024px) {
    .perk { padding: var(--s-6); }
    .perk--photo .perk__overlay { padding: var(--s-6); }

    /* Плашки не растут по ширине колонки — высота ограничена, чтобы
       обе помещались на экран без прокрутки */
    .perk {
      aspect-ratio: auto;
      height: clamp(480px, 68vh, 700px);
    }
  }
