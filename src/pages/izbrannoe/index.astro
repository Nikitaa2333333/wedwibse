---
// ИЗБРАННОЕ — раздел «Корзина» из ТЗ (wedwibse-app-scope): копит выбранные
// площадки и подрядчиков, даёт из них отобрать финалистов и сравнить.
// Персональный экран без бэкенда — источник данных localStorage
// (см. src/lib/favorites.ts), поэтому вся разметка
// ниже — пустой каркас, который наполняет клиентский скрипт. SEO это
// не касается: раздел открывается из BottomDock, а не приходит из поиска.
//
// Два уровня:
//   1. «Все» — по стопке на направление (площадки, ведущие, …): последние
//      кадры веером внахлёст, четвёртый — размытый со счётчиком «+N»,
//      под стопкой название и давность (реф. коллекции в духе iOS, 30.09.2026);
//   2. внутри направления — сетка карточек в две колонки и прибитая к низу
//      полоса действий: «Сравнить» и «Написать всем».
// Между уровнями — полоса чипов «Все · Площадки 15 · Ведущие 14» над
// содержимым: она же и навигация, отдельной пилюли «← Папки» больше нет.
// Уровень задаётся хэшем `#<cat>`, поэтому системный «назад» возвращает к «Все».
//
// Сценарий (заказчик, 30.09.2026): человек открывает направление, ещё раз
// пробегает свои карточки и делает одно из двух —
//   «Написать всем» — одно сообщение каждой карточке направления сразу
//      (в шторке можно снять лишних). Бэкенда нет — отправка-заглушка;
//   «Сравнить» (`#<cat>/compare`) — таблица по всем карточкам направления,
//      только строки, где данные есть хотя бы у двух: сравнивать «—» с «—»
//      незачем, а незаполненная строка у одной карточки не валидна.
// Прежний отбор финалистов свайпом и полоса «Отобрать / Заново / Сравнить
// финалистов» сняты: второй проход по карточкам и есть сама сетка.
import Layout from '../../layouts/Layout.astro';
import BottomDock from '../../components/BottomDock.astro';
import Icon from '../../components/Icon.astro';
import { compareCovers, compareFacts } from '../../lib/compare-facts';

// Факты для таблицы сравнения собираются на сборке и уезжают на страницу
// одним JSON — клиент ничего не запрашивает. `</` экранируем: JSON лежит
// внутри <script>, и «</script>» в значении закрыл бы тег раньше времени.
const factsJson = JSON.stringify(compareFacts()).replace(/</g, '\\u003c');

// Обложки для сцены отбора — тем же путём. Кадр из снимка в localStorage
// для неё не годится: там лежит адрес прошлой сборки, а имена файлов
// с хешем, и после деплоя ссылка мертва (см. compareCovers).
const coversJson = JSON.stringify(await compareCovers()).replace(/</g, '\\u003c');
---

<Layout title="Избранное — WED Secrets" description="Площадки и подрядчики, которые вы сохранили: сравните их между собой и напишите всем сразу.">
  <Fragment slot="head">
    <meta name="robots" content="noindex" />
  </Fragment>

  <!-- Заголовок раздела — крупный, в контенте, как ScopePicker у каталогов:
       h1 + счётчик рядом. Внутри направления h1 становится его именем. -->
  <header class="scope">
    <div class="scope__title-row">
      <h1 class="t-h1" data-title>Избранное</h1>
      <p class="scope__count" data-count hidden></p>
    </div>

    <!-- Направления: «Все» и по чипу на каждое, с числом. Чип — ссылка на
         хэш, поэтому переключение живёт в истории и «назад» работает. -->
    <nav class="fav-tabs" data-tabs aria-label="Направления" hidden></nav>

  </header>

  <main class="wrap">
    <p class="empty t-small" data-empty>
      Пока пусто. Добавляйте площадки и подрядчиков сердечком на карточке — они появятся здесь:
      их можно будет сравнить между собой и написать всем сразу.
    </p>

    <div class="stacks" data-boards hidden></div>

    <div class="grid" data-grid hidden></div>

    <div class="cmp" data-compare hidden></div>
  </main>

  <!-- ПОЛОСА ДЕЙСТВИЙ НАПРАВЛЕНИЯ. Прибита к низу над доком, как капсула
       заявки на карточке (StickyCta): контент под ней растворяется в бумагу,
       пилюли стоят на сплошном фоне. В сетке — «Сравнить» и «Написать всем»,
       в сравнении — «К карточкам» и «Написать всем». -->
  <div class="fav-bar" data-bar hidden>
    <a class="pill fav-bar__ghost" href="#" data-bar-compare>Сравнить</a>
    <a class="pill fav-bar__ghost" href="#" data-bar-back hidden>К карточкам</a>
    <button class="pill fav-bar__main" type="button" data-write>Написать всем</button>
  </div>

  <!-- «НАПИСАТЬ ВСЕМ». Реестровая шторка: список карточек направления,
       все отмечены — лишних можно снять; после отправки та же шторка
       показывает, кому ушло. ЗАГЛУШКА: бэкенда нет, см. TODO в скрипте. -->
  <div class="sheet" data-sheet="write">
    <div class="sheet__backdrop" data-sheet-close></div>
    <section class="sheet__panel" role="dialog" aria-modal="true" aria-labelledby="write-title">
      <header class="sheet__head">
        <h2 class="sheet__title" id="write-title" data-write-title>Написать всем</h2>
        <button class="icon-btn" type="button" data-sheet-close aria-label="Закрыть">
          <Icon name="close" />
        </button>
      </header>
      <div class="sheet__body" data-lenis-prevent>
        <p class="t-small" data-write-lead></p>
        <ul class="write-list" data-write-list></ul>
        <p class="t-small write-note" data-write-note hidden>Ответы соберутся в чате — по одному диалогу на каждого.</p>
      </div>
      <footer class="sheet__foot">
        <button class="pill" type="button" data-write-send>Отправить</button>
        <button class="pill" type="button" data-sheet-close data-write-ok hidden>Готово</button>
      </footer>
    </section>
  </div>

  <script is:inline type="application/json" data-facts set:html={factsJson}></script>
  <script is:inline type="application/json" data-covers set:html={coversJson}></script>

  <BottomDock active="saved" />
</Layout>

<style is:global>
  /* ============ ШАПКА РАЗДЕЛА (как ScopePicker) ============ */
  .scope {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-4);
    padding: var(--s-6) var(--gutter) var(--s-2);
  }

  .scope__title-row {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--s-3);
  }

  .scope__count {
    font-size: var(--fs-h3);
    font-weight: var(--w-medium);
  }

  .scope__count[hidden] { display: none; }

  /* ============ ПУСТОЕ СОСТОЯНИЕ ============ */
  .empty {
    max-width: var(--measure-text);
    padding: var(--s-7) var(--gutter);
  }

  .empty[hidden] { display: none; }

  /* ============ ПАПКИ (доски) ============ */
  .wrap {
    max-width: none;
    padding: var(--s-4) clamp(8px, 1vw, 16px) calc(var(--dock-space) + var(--s-6));
  }

  /* ============ ЧИПЫ НАПРАВЛЕНИЙ ============
     Одна строка во всю ширину, лишнее уезжает вбок пальцем. Край строки
     выходит за поля страницы, чтобы чипы уходили под край экрана, а не
     обрезались посреди бумаги. Вертикаль закрыта явно — см. ловушку
     «панель ездит» в CLAUDE.md. */
  .fav-tabs {
    flex: 1 0 100%;
    display: flex;
    gap: var(--s-2);
    margin: var(--s-2) calc(-1 * var(--gutter)) 0;
    padding: 0 var(--gutter);
    overflow-x: auto;
    overflow-y: clip;
    scrollbar-width: none;
  }

  .fav-tabs::-webkit-scrollbar { display: none; }
  .fav-tabs[hidden] { display: none; }
  .fav-tabs .chip { flex: none; text-decoration: none; }

  /* ============ СТОПКИ НАПРАВЛЕНИЙ ============
     Кадры направления разложены веером внахлёст, как фотографии на столе:
     каждый чуть повёрнут, правый лежит поверх левого. Без обводки —
     кадр отделяет от соседа только мягкая тень. Четвёртый кадр размыт
     и несёт «+N» — сколько ещё внутри. Подпись — по центру под стопкой.
     Телефон — одна стопка на строку (веер читается только крупно),
     от планшета две, на ПК три. */
  .stacks {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-6);
    padding-top: var(--s-2);
  }

  .stacks[hidden] { display: none; }

  @media (min-width: 640px) {
    .stacks { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (min-width: 1024px) {
    .stacks { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  .stack {
    display: block;
    min-width: 0;
    color: inherit;
    text-decoration: none;
    text-align: center;
  }

  .stack > span { display: block; }

  /* Поле веера. Кадр — 34% ширины поля в пропорции 3:4; позицию по
     горизонтали (--x) ставит скрипт по числу кадров, чтобы стопка из
     одного-двух кадров стояла по центру, а не жалась влево. */
  .stack__fan {
    position: relative;
    isolation: isolate; /* свой слой: «+N» с z-index -1 уходит под соседей, а не под страницу */
    aspect-ratio: 2 / 1; /* кадр 3:4 шириной 34% — это 45% ширины по высоте, плюс запас на наклон */
  }

  .stack__card {
    position: absolute;
    top: 50%;
    left: var(--x);
    width: 34%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--surface-dim);
    box-shadow: var(--shadow-stack);
    /* Веер «дышит» от --o (0…1): чем больше, тем шире кадры расходятся
       от центра (--k — место кадра относительно середины, ставит скрипт)
       и тем круче наклон. На 0 стопка собрана плотнее, на 1 — раскрыта. */
    transform:
      translateY(-50%)
      translateX(calc(var(--k, 0) * (var(--o) - 0.4) * 9%))
      rotate(calc(var(--r) * var(--flip) * (0.7 + var(--o) * 0.6)))
      translateY(var(--y));
    /* Без transition: веер ведёт прокрутка, значение и так меняется
       каждый кадр, а переход поверх неё только отставал бы и заставлял
       браузер пересчитывать анимацию на каждом кадре. Свой слой —
       чтобы сдвиг кадра не перерисовывал тень и размытие «+N». */
    will-change: transform;
  }

  /* Раскрытие веера: --open ставит скрипт по положению стопки на экране
     (у середины экрана — 1, у краёв — 0), --hov — курсор на ПК. */
  .stack {
    --flip: 1;
    --o: max(var(--open, 0), var(--hov, 0));
  }

  /* Наклон и сдвиг по вертикали — постоянный узор по позиции в веере.
     Каждая вторая стопка — зеркально (--flip): иначе стопки из одного
     кадра все валятся в одну сторону, и колонка выглядит перекошенной. */
  .stack:nth-child(even) { --flip: -1; }
  .stack__card:nth-child(1) { --r: -4deg; --y: 2%; }
  .stack__card:nth-child(2) { --r: 2deg;  --y: -3%; }
  .stack__card:nth-child(3) { --r: -2deg; --y: 1%; }
  .stack__card:nth-child(4) { --r: 4deg;  --y: -2%; }
  .stack__card:only-child { --r: -3deg; --y: 0%; }

  .stack__card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
  }

  /* «+N»: тот же кадр, размытый в пятно, цифра — поверх. Размытие
     статичное (не анимируется), поэтому в моушн-бюджет телефона входит. */
  /* Размытый «+N» лежит ПОД соседом, а не поверх: он фон стопки,
     а не её лицо (заказчик, 30.09.2026). */
  .stack__card--more { z-index: -1; }

  .stack__card--more img {
    filter: blur(6px);
    transform: scale(1.15);
  }

  .stack__more {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding-left: 40%; /* левую часть кадра закрывает сосед — число в видимой */
    background: color-mix(in srgb, var(--paper) 20%, transparent);
    color: var(--ink);
    font-size: var(--fs-h2);
    font-weight: var(--w-medium);
  }

  /* На ПК под курсором веер раскрывается целиком. */
  @media (hover: hover) and (pointer: fine) {
    .stack:hover { --hov: 1; }
    .stack__card { transition: transform var(--dur-base) var(--ease-out); }
  }

  /* Отклик на нажатие: веер чуть проседает под пальцем — дешёвый
     transform, работает и на тач-экране.
     Был ещё переход «стопка ⇄ плитка» на View Transitions (кадры веера
     перелетали в сетку) — снят 30.09.2026: браузер на время перехода
     фотографирует всю страницу, на телефоне это давало рывки по кадрам,
     а нижний док пропадал и появлялся вместе со снимком. */
  .stack__fan { transition: transform var(--dur-fast) var(--ease-out); }
  .stack:active .stack__fan { transform: scale(0.97); }

  .stack__name {
    margin-top: var(--s-4);
    font-size: var(--fs-h3);
    font-weight: var(--w-head);
    line-height: 1.15;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .stack__meta {
    margin-top: var(--s-1);
    font-size: var(--fs-caption);
    font-weight: var(--w-medium);
    opacity: 0.55;
  }

  /* ============ СЕТКА КАРТОЧЕК ============ */
  /* Две колонки уже на телефоне (заказчик, 30.09.2026): направление
     пробегают глазами целиком, по одной карточке во весь экран это
     была лента, а не обзор. От планшета три, на ПК четыре. */
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-5) var(--pin-gap);
  }

  .grid[hidden] { display: none; }

  @media (min-width: 640px) {
    .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  @media (min-width: 1024px) {
    .grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }

  /* Под прибитой полосой действий последний ряд не должен прятаться */
  .wrap.has-bar { padding-bottom: calc(var(--dock-space) + var(--float-cta-space) + var(--s-6)); }

  /* ============ КАРТОЧКА ИЗБРАННОГО ============ */
  .fcard {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    min-width: 0;
  }

  .fcard__media {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--surface-dim);
  }

  .fcard__link { display: block; width: 100%; height: 100%; }

  .fcard__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
  }

  /* «Убрать» — чернильный квадрат из реестра (.hero-btn): на кадре
     допустима только иконка, и та в языке кнопок первого экрана. */
  .fcard__remove {
    position: absolute;
    top: var(--s-2);
    right: var(--s-2);
    z-index: 1;
  }

  .fcard__top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-3);
  }

  /* Кегль под половину экрана: в две колонки --fs-h3 рвал имя на три строки */
  .fcard__name {
    min-width: 0;
    font-size: var(--fs-body);
    font-weight: var(--w-head);
    line-height: 1.15;
  }

  .fcard__rate {
    font-size: var(--fs-small);
    font-weight: var(--w-medium);
    flex-shrink: 0;
  }

  .fcard__meta { margin-top: 2px; }

  /* ============ ТАБЛИЦА СРАВНЕНИЯ ============
     Колонки — карточки, строки — факты. Подпись факта не стоит слева
     отдельной колонкой (на телефоне она съедала треть ширины, а крестик
     «убрать» ехал мимо кадра), а лежит строкой над значениями и при
     горизонтальной прокрутке остаётся у левого края (sticky).
     Крестик на кадре убирает карточку только из этой таблицы. */
  .cmp[hidden] { display: none; }

  .cmp__scroll {
    overflow-x: auto;
    overflow-y: clip;
    scrollbar-width: none;
  }

  .cmp__scroll::-webkit-scrollbar { display: none; }

  .cmp__table {
    display: grid;
    /* Колонка — чуть меньше половины экрана: на телефоне видно две
       карточки и край третьей, который и зовёт листать вбок. */
    grid-template-columns: repeat(var(--cols), min(42vw, 220px));
    column-gap: var(--pin-gap);
    min-width: 100%;
    width: max-content;
  }

  /* Шапка колонки: кадр и имя — ссылка на карточку; крестик поверх кадра
     убирает карточку из этой таблицы (заказчик, 30.09.2026: не выходить
     из сравнения, чтобы отсеять явно неподходящий вариант). Из избранного
     крестик в таблице НЕ удаляет — это делает крестик в сетке. */
  .cmp__head {
    position: relative;
    min-width: 0;
    padding-bottom: var(--s-4);
  }

  .cmp__link {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    color: inherit;
    text-decoration: none;
  }

  .cmp__drop {
    position: absolute;
    top: var(--s-2);
    right: var(--s-2);
  }

  /* «Убрано: N · Вернуть» — над таблицей, а не под ней: таблица длинная,
     и строка внизу терялась бы за краем экрана */
  .cmp__note--top { margin: 0 0 var(--s-4); }

  .cmp__note--back {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    opacity: 1;
  }

  .cmp__img {
    width: 100%;
    height: auto; /* иначе атрибут height тянет кадр в столбик и ломает квадрат */
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius-card);
    background: var(--surface-dim);
  }

  .cmp__name {
    font-size: var(--fs-small);
    font-weight: var(--w-head);
    line-height: 1.2;
  }

  /* Подпись строки — во всю ширину таблицы, волосяная линия сверху
     (линии — структура таблицы, единственное место, где они уместны). */
  .cmp__label {
    grid-column: 1 / -1;
    padding-top: var(--s-4);
    border-top: 1px solid var(--hairline);
  }

  .cmp__label span {
    position: sticky;
    left: 0;
    font-size: var(--fs-caption);
    font-weight: var(--w-medium);
    opacity: 0.6;
  }

  .cmp__cell {
    min-width: 0;
    padding: var(--s-1) 0 var(--s-4);
    font-size: var(--fs-small);
  }

  .cmp__cell--empty { opacity: 0.35; }

  .cmp__note {
    margin-top: var(--s-4);
    max-width: var(--measure-text);
    opacity: 0.6;
  }

  /* ============ ПОЛОСА ДЕЙСТВИЙ ============
     Прибита к низу над доком, как капсула заявки StickyCta: контент под
     ней растворяется в цвет бумаги, пилюли стоят на сплошном фоне.
     Считается от вьюпорта — место рельса на ПК вычитается руками. */
  .fav-bar {
    position: fixed;
    left: var(--rail-w);
    right: 0;
    bottom: var(--dock-h);
    z-index: var(--z-nav);
    display: flex;
    gap: var(--s-2);
    padding: var(--s-7) var(--gutter) var(--s-3);
    background: linear-gradient(
      to bottom,
      transparent 0,
      color-mix(in srgb, var(--bg) 60%, transparent) calc(var(--s-7) * 0.5),
      var(--bg) var(--s-7)
    );
    pointer-events: none;
  }

  .fav-bar[hidden] { display: none; }

  .fav-bar > * {
    flex: 1 1 0;
    min-width: 0;
    text-align: center;
    white-space: nowrap;
    pointer-events: auto;
  }

  .fav-bar > [hidden] { display: none; }

  /* Главное действие — чернильная капсула, как «Забронировать» */
  .fav-bar__main {
    background: var(--fg);
    color: var(--bg);
    border-color: var(--fg);
  }

  .fav-bar__ghost { background: var(--bg); }

  @media (hover: hover) {
    .fav-bar__main:hover { background: var(--fg); color: var(--bg); }
  }

  @media (min-width: 640px) {
    .fav-bar { justify-content: center; }
    .fav-bar > * { flex: 0 0 auto; padding-inline: 40px; }
  }

  /* ============ ШТОРКА «НАПИСАТЬ ВСЕМ» ============ */
  .write-list {
    list-style: none;
    display: grid;
    gap: var(--s-3);
    margin: var(--s-4) 0 0;
  }

  .write-item {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    min-width: 0;
    cursor: pointer;
  }

  .write-item input {
    flex: none;
    width: 20px;
    height: 20px;
    margin: 0;
    accent-color: var(--ink);
  }

  .write-item__pic {
    width: 44px;
    height: 44px;
    flex: none;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--surface-dim);
  }

  .write-item__pic img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
  }

  .write-item__name {
    min-width: 0;
    font-weight: var(--w-medium);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .write-note { margin-top: var(--s-4); }

  .sheet__foot > [hidden] { display: none; }
</style>

<script>
  import { getFavorites, removeFavorite, CHANGE_EVENT, STORAGE_KEY, type FavoriteItem } from '../../lib/favorites';
  import { bindSheet } from '../../lib/sheet';
  import { withCount } from '../../lib/plural';
  import { icons, type IconName } from '../../lib/icons';
  import type { Fact } from '../../lib/compare-facts';

  const $ = <T extends HTMLElement>(sel: string) => document.querySelector<T>(sel);

  const emptyEl = $('[data-empty]');
  const gridEl = $('[data-grid]');
  const boardsEl = $('[data-boards]');
  const titleEl = $('[data-title]');
  const countEl = $('[data-count]');
  const tabsEl = $('[data-tabs]');
  const compareEl = $('[data-compare]');

  const wrapEl = $('main.wrap');
  const barEl = $('[data-bar]');
  const barCompare = $<HTMLAnchorElement>('[data-bar-compare]');
  const barBack = $<HTMLAnchorElement>('[data-bar-back]');
  const writeBtn = $<HTMLButtonElement>('[data-write]');

  const writeSheetEl = $('[data-sheet="write"]');
  const writeTitle = $('[data-write-title]');
  const writeLead = $('[data-write-lead]');
  const writeList = $('[data-write-list]');
  const writeNote = $('[data-write-note]');
  const writeSend = $<HTMLButtonElement>('[data-write-send]');
  const writeOk = $<HTMLButtonElement>('[data-write-ok]');

  /** факты для таблицы — id → строки; собраны на сборке (lib/compare-facts.ts) */
  const FACTS: Record<string, Fact[]> = JSON.parse($('[data-facts]')?.textContent || '{}');

  // Обложки текущей сборки. Снимок в localStorage хранит адрес той сборки,
  // на которой нажали сердце, — после деплоя он ведёт в никуда, поэтому
  // кадр берём отсюда, а снимок оставляем запасным.
  const COVERS: Record<string, string> = JSON.parse($('[data-covers]')?.textContent || '{}');

  /** направления без действий: булавки из галереи — не подрядчики,
      писать и сравнивать там некого */
  const NO_ACTIONS = new Set(['board']);

  const CARD_FORMS: [string, string, string] = ['карточка', 'карточки', 'карточек'];

  let items: FavoriteItem[] = [];
  /** открытая папка (cat) или null — уровень папок; читается из location.hash */
  let activeCat: string | null = null;
  /** внутри папки: сетка карточек или таблица сравнения (`#cat/compare`) */
  let view: 'grid' | 'compare' = 'grid';

  function escapeHtml(s: string): string {
    return s.replace(/[&<>"']/g, (c) => (
      { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string
    ));
  }

  function iconSvg(name: IconName): string {
    const { viewBox, body } = icons[name];
    return `<svg viewBox="${viewBox}" fill="currentColor" aria-hidden="true">${body}</svg>`;
  }

  function parseHash(): { cat: string | null; view: 'grid' | 'compare' } {
    const h = decodeURIComponent(location.hash.replace(/^#/, ''));
    if (!h) return { cat: null, view: 'grid' };
    const [cat, sub] = h.split('/');
    return { cat: cat || null, view: sub === 'compare' ? 'compare' : 'grid' };
  }

  function catLabelOf(cat: string): string {
    return items.find((i) => i.cat === cat)?.catLabel ?? cat;
  }

  function currentItems(): FavoriteItem[] {
    return activeCat ? items.filter((i) => i.cat === activeCat) : [];
  }

  /** давность последнего добавления в папку: «сегодня», «3 дн.», «2 нед.», «1 мес.» */
  function ago(ts: number | undefined): string {
    if (!ts) return '';
    const days = Math.floor((Date.now() - ts) / 86_400_000);
    if (days < 1) return 'сегодня';
    if (days < 7) return `${days} дн.`;
    if (days < 30) return `${Math.floor(days / 7)} нед.`;
    if (days < 365) return `${Math.floor(days / 30)} мес.`;
    return `${Math.floor(days / 365)} г.`;
  }

  /* ---------- уровень «Все»: стопки ---------- */

  /** сколько кадров веера показываем целиком; следующий — размытый «+N» */
  const FAN_SHOWN = 3;
  /** ширина кадра и шаг веера в % поля — те же 34%, что в .stack__card */
  const FAN_CARD = 34;
  const FAN_STEP = 20;

  /** направления в порядке первого добавления */
  function catsOf(): string[] {
    return Array.from(new Set(items.map((i) => i.cat)));
  }

  /** Одна стопка на направление: свежие кадры веером, хвост — «+N» */
  function renderBoards() {
    if (!boardsEl) return;

    boardsEl.innerHTML = catsOf()
      .map((cat) => {
        const list = items.filter((i) => i.cat === cat);
        const label = list[0]?.catLabel ?? cat;
        const recent = [...list].reverse();
        const rest = recent.length - FAN_SHOWN;
        // Четвёртый кадр веера размываем в «+N», только если за ним больше
        // одной карточки: «+1» на месте кадра — просто спрятанный кадр,
        // его честнее показать целиком.
        const shown = recent.slice(0, FAN_SHOWN + 1);
        const n = shown.length;
        const span = FAN_CARD + FAN_STEP * (n - 1);
        const start = (100 - span) / 2;

        const cards = shown.map((it, i) => {
          const more = rest > 1 && i === FAN_SHOWN;
          const img = `<img src="${escapeHtml(COVERS[it.id] || it.img)}" width="240" height="320" alt="" loading="lazy" decoding="async" />`;
          return `<span class="stack__card${more ? ' stack__card--more' : ''}" style="--x:${start + FAN_STEP * i}%;--k:${i - (n - 1) / 2}">${img}${
            more ? `<span class="stack__more">+${rest}</span>` : ''
          }</span>`;
        }).join('');

        const latest = Math.max(0, ...list.map((i) => i.addedAt ?? 0));
        const when = ago(latest || undefined);
        const count = withCount(list.length, CARD_FORMS);

        return `
          <a class="stack" href="#${encodeURIComponent(cat)}" data-board="${escapeHtml(cat)}">
            <span class="stack__fan" aria-hidden="true">${cards}</span>
            <span class="stack__name">${escapeHtml(label)}</span>
            <span class="stack__meta">${count}${when ? ` · ${when === 'сегодня' ? 'сегодня' : `${when} назад`}` : ''}</span>
          </a>
        `;
      })
      .join('');
  }

  /** Полоса чипов: «Все» и направления с числом карточек */
  function renderTabs() {
    if (!tabsEl) return;
    const chip = (href: string, label: string, n: number, on: boolean) =>
      `<a class="chip${on ? ' is-active' : ''}" href="${href}"${on ? ' aria-current="page"' : ''}>${escapeHtml(label)} <span class="chip__count">${n}</span></a>`;

    tabsEl.innerHTML = [
      chip(location.pathname, 'Все', items.length, !activeCat),
      ...catsOf().map((cat) =>
        chip(`#${encodeURIComponent(cat)}`, catLabelOf(cat), items.filter((i) => i.cat === cat).length, cat === activeCat)),
    ].join('');
    // в сравнении чипы прячем: там своя навигация «← К карточкам»
    tabsEl.hidden = view === 'compare';
    tabsEl.querySelector('.is-active')?.scrollIntoView({ block: 'nearest', inline: 'nearest' });
  }

  /* ---------- внутри папки: сетка ---------- */

  function renderGrid() {
    if (!gridEl || !activeCat) return;
    // Свежие сверху — в том же порядке, что кадры веера: при переходе
    // из стопки верхний кадр ложится в первую карточку, а не улетает
    // в хвост сетки за край экрана.
    const list = [...currentItems()].reverse();

    gridEl.innerHTML = list
      .map((it) => {
        const tail = [it.meta, it.price].filter(Boolean).map(escapeHtml).join(' · ');
        return `
          <article class="fcard" data-id="${escapeHtml(it.id)}">
            <div class="fcard__media">
              <a class="fcard__link" href="${escapeHtml(it.href)}">
                <img src="${escapeHtml(COVERS[it.id] || it.img)}" width="320" height="400" alt="${escapeHtml(it.name)}" loading="lazy" decoding="async" />
              </a>
              <button class="hero-btn fcard__remove" type="button" data-remove="${escapeHtml(it.id)}" aria-label="Убрать «${escapeHtml(it.name)}» из избранного">${iconSvg('close')}</button>
            </div>
            <div class="fcard__body">
              <div class="fcard__top">
                <h2 class="fcard__name">${escapeHtml(it.name)}</h2>
                ${it.rating ? `<span class="fcard__rate">★ ${it.rating.toFixed(1)}</span>` : ''}
              </div>
              ${tail ? `<p class="fcard__meta t-caption">${tail}</p>` : ''}
            </div>
          </article>
        `;
      })
      .join('');

    gridEl.querySelectorAll<HTMLButtonElement>('[data-remove]').forEach((btn) => {
      btn.addEventListener('click', () => removeFavorite(btn.dataset.remove!));
    });
  }

  /* ---------- полоса действий ---------- */

  function renderBar() {
    if (!barEl) return;
    const cat = activeCat;
    const n = cat ? currentItems().length : 0;
    const show = !!cat && !NO_ACTIONS.has(cat) && n > 0;
    barEl.hidden = !show;
    wrapEl?.classList.toggle('has-bar', show);
    if (!show || !cat) return;

    const inCompare = view === 'compare';
    if (barCompare) {
      barCompare.hidden = inCompare || n < 2;
      barCompare.href = `#${encodeURIComponent(cat)}/compare`;
    }
    if (barBack) {
      barBack.hidden = !inCompare;
      barBack.href = `#${encodeURIComponent(cat)}`;
    }
  }

  /* ---------- сравнение ---------- */

  /** факты карточки: из реестра сборки, иначе — что есть в снимке */
  function factsOf(it: FavoriteItem): Fact[] {
    const known = FACTS[it.id];
    if (known?.length) return known;
    const out: Fact[] = [];
    if (it.price) out.push({ label: 'Цена', value: it.price });
    if (it.meta) out.push({ label: 'Детали', value: it.meta });
    if (it.rating) out.push({ label: 'Рейтинг', value: `★ ${it.rating.toFixed(1)}` });
    return out;
  }

  /** строка сравнения нужна, только если данные есть хотя бы у двух */
  const MIN_FILLED = 2;

  /** Убранные из сравнения крестиком — только на этот заход в таблицу:
      из избранного они не удаляются. Сбрасывается при выходе из сравнения. */
  const cmpHidden = new Set<string>();
  let cmpCat: string | null = null;

  function renderCompare() {
    if (!compareEl || !activeCat) return;
    if (cmpCat !== activeCat) { cmpHidden.clear(); cmpCat = activeCat; }
    const all = [...currentItems()].reverse();
    const list = all.filter((i) => !cmpHidden.has(i.id));

    // строки — объединение подписей фактов, в порядке появления
    const labels: string[] = [];
    const byItem = new Map<string, Map<string, string>>();
    for (const it of list) {
      const m = new Map<string, string>();
      for (const f of factsOf(it)) {
        if (!labels.includes(f.label)) labels.push(f.label);
        m.set(f.label, f.value);
      }
      byItem.set(it.id, m);
    }
    const rows = labels.filter((l) => list.filter((i) => byItem.get(i.id)?.has(l)).length >= MIN_FILLED);
    const dropped = labels.length - rows.length;

    const head = list.map((i) => `
      <div class="cmp__head">
        <a class="cmp__link" href="${escapeHtml(i.href)}">
          <img class="cmp__img" src="${escapeHtml(COVERS[i.id] || i.img)}" width="280" height="280" alt="" loading="lazy" decoding="async" />
          <span class="cmp__name">${escapeHtml(i.name)}</span>
        </a>
        <button class="hero-btn cmp__drop" type="button" data-drop="${escapeHtml(i.id)}" aria-label="Убрать «${escapeHtml(i.name)}» из сравнения">${iconSvg('close')}</button>
      </div>
    `).join('');

    const body = rows.map((label) => `
      <div class="cmp__label"><span>${escapeHtml(label)}</span></div>
      ${list.map((i) => {
        const v = byItem.get(i.id)?.get(label);
        return v
          ? `<div class="cmp__cell">${escapeHtml(v)}</div>`
          : '<div class="cmp__cell cmp__cell--empty">нет данных</div>';
      }).join('')}
    `).join('');

    compareEl.innerHTML = `
      ${list.length ? '' : '<p class="t-small cmp__note">Все карточки убраны из сравнения.</p>'}
      ${cmpHidden.size ? `<p class="t-caption cmp__note cmp__note--back cmp__note--top">Убрано из сравнения: ${cmpHidden.size} <button class="pill pill--sm" type="button" data-restore>Вернуть</button></p>` : ''}
      <div class="cmp__scroll">
        <div class="cmp__table" style="--cols:${list.length}">${head}${body}</div>
      </div>
      ${dropped ? '<p class="t-caption cmp__note">Строки, заполненные меньше чем у двух карточек, не показаны — сравнивать там нечего.</p>' : ''}
    `;

    compareEl.querySelectorAll<HTMLButtonElement>('[data-drop]').forEach((btn) => {
      btn.addEventListener('click', () => { cmpHidden.add(btn.dataset.drop!); renderCompare(); });
    });
    compareEl.querySelector<HTMLButtonElement>('[data-restore]')?.addEventListener('click', () => {
      cmpHidden.clear();
      renderCompare();
    });
  }

  /* ---------- шапка и переключение уровней ---------- */

  function applyLevel() {
    const inFolder = !!activeCat;
    const n = inFolder ? currentItems().length : items.length;
    if (titleEl) titleEl.textContent = inFolder && activeCat ? catLabelOf(activeCat) : 'Избранное';
    if (countEl) {
      countEl.textContent = withCount(n, CARD_FORMS);
      countEl.hidden = n === 0;
    }
    if (boardsEl) boardsEl.hidden = inFolder;
    if (gridEl) gridEl.hidden = !inFolder || view === 'compare';
    if (compareEl) compareEl.hidden = !inFolder || view !== 'compare';
  }

  function render() {
    items = getFavorites();
    const empty = items.length === 0;

    emptyEl?.toggleAttribute('hidden', !empty);

    // папка, которой больше нет (удалили последнюю карточку) — назад к папкам
    const h = parseHash();
    activeCat = h.cat;
    view = h.view;
    if (activeCat && !items.some((i) => i.cat === activeCat)) {
      activeCat = null;
      view = 'grid';
      history.replaceState(null, '', location.pathname);
    }
    // сравнивать некого (меньше двух карточек) — назад к сетке
    if (activeCat && view === 'compare' && currentItems().length < 2) {
      view = 'grid';
      history.replaceState(null, '', `${location.pathname}#${encodeURIComponent(activeCat)}`);
    }

    if (empty) {
      if (boardsEl) { boardsEl.innerHTML = ''; boardsEl.hidden = true; }
      if (gridEl) gridEl.hidden = true;
      if (compareEl) compareEl.hidden = true;
      if (titleEl) titleEl.textContent = 'Избранное';
      if (countEl) countEl.hidden = true;
      if (tabsEl) tabsEl.hidden = true;
      if (barEl) barEl.hidden = true;
      wrapEl?.classList.remove('has-bar');
      return;
    }

    renderBoards();
    renderTabs();
    if (view !== 'compare') cmpCat = null; // вышли из таблицы — убранные крестиком вернутся
    if (activeCat) {
      renderGrid();
      if (view === 'compare') renderCompare();
    }
    applyLevel();
    updateFans(); // до первой отрисовки: стопки сразу в своём положении, а не «раскрываются» при открытии
    renderBar();
  }

  /* ---------- «Написать всем» ---------- */

  // TODO(бэкенд): заглушка. Настоящая отправка — один запрос со списком id
  // отмеченных карточек; здесь только показываем, кому сообщение «ушло».
  const writeSheet = writeSheetEl ? bindSheet(writeSheetEl) : null;

  function pic(i: FavoriteItem): string {
    return `<span class="write-item__pic" aria-hidden="true"><img src="${escapeHtml(COVERS[i.id] || i.img)}" alt="" loading="lazy" decoding="async" /></span>`;
  }

  function checkedIds(): string[] {
    return [...(writeList?.querySelectorAll<HTMLInputElement>('input:checked') ?? [])].map((c) => c.value);
  }

  function syncSendLabel() {
    const n = checkedIds().length;
    if (writeSend) {
      writeSend.textContent = n ? `Отправить · ${n}` : 'Отметьте, кому';
      writeSend.disabled = n === 0;
    }
  }

  writeBtn?.addEventListener('click', () => {
    if (!activeCat || !writeSheet) return;
    const list = [...currentItems()].reverse();
    if (writeTitle) writeTitle.textContent = 'Написать всем';
    if (writeLead) writeLead.textContent = `Одно сообщение уйдёт каждой отмеченной карточке раздела «${catLabelOf(activeCat)}». Лишних можно снять.`;
    if (writeList) {
      writeList.innerHTML = list.map((i) => `
        <li>
          <label class="write-item">
            <input type="checkbox" value="${escapeHtml(i.id)}" checked />
            ${pic(i)}
            <span class="write-item__name">${escapeHtml(i.name)}</span>
          </label>
        </li>
      `).join('');
      writeList.querySelectorAll('input').forEach((c) => c.addEventListener('change', syncSendLabel));
    }
    if (writeNote) writeNote.hidden = true;
    if (writeSend) writeSend.hidden = false;
    if (writeOk) writeOk.hidden = true;
    syncSendLabel();
    writeSheet.open(writeBtn);
  });

  writeSend?.addEventListener('click', () => {
    const ids = new Set(checkedIds());
    // в том же порядке, что список в шторке (свежие сверху)
    const sent = [...items].reverse().filter((i) => ids.has(i.id));
    if (!sent.length) return;
    if (writeTitle) writeTitle.textContent = `Отправлено: ${withCount(sent.length, ['адресат', 'адресата', 'адресатов'])}`;
    if (writeLead) writeLead.textContent = 'Сообщение ушло:';
    if (writeList) {
      writeList.innerHTML = sent.map((i) => `
        <li class="write-item">${pic(i)}<span class="write-item__name">${escapeHtml(i.name)}</span></li>
      `).join('');
    }
    if (writeNote) writeNote.hidden = false;
    writeSend.hidden = true;
    if (writeOk) writeOk.hidden = false;
  });

  /* ---------- моушн стопок ---------- */

  const reducedMotion = () => matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Веер у середины экрана раскрыт, у краёв собран: пока листаешь,
  // стопки мягко расходятся и сходятся — видно, что они живые.
  // Только transform через CSS-переменную, один проход на кадр.
  let fanFrame = 0;
  function updateFans() {
    fanFrame = 0;
    if (!boardsEl || boardsEl.hidden || reducedMotion()) return;
    const mid = innerHeight / 2;
    boardsEl.querySelectorAll<HTMLElement>('.stack').forEach((el) => {
      const r = el.getBoundingClientRect();
      if (r.bottom < 0 || r.top > innerHeight) return;
      const d = Math.abs(r.top + r.height * 0.35 - mid) / mid;
      const v = Math.max(0, 1 - d).toFixed(2);
      // одинаковое значение не пишем: лишняя запись — лишний пересчёт стилей
      if (el.style.getPropertyValue('--open') !== v) el.style.setProperty('--open', v);
    });
  }
  window.addEventListener('scroll', () => { fanFrame ||= requestAnimationFrame(updateFans); }, { passive: true });
  window.addEventListener('resize', () => { fanFrame ||= requestAnimationFrame(updateFans); });

  // Смена уровня (чип, стопка, «назад») — мгновенно. Прокрутку «Все»
  // запоминаем: вернувшись из направления, человек оказывается у той же
  // стопки, а не в начале списка.
  let allScroll = 0;
  window.addEventListener('hashchange', () => {
    const wasAll = !activeCat;
    if (wasAll) allScroll = scrollY;
    render();
    window.scrollTo({ top: !activeCat && !wasAll ? allScroll : 0 });
    updateFans();
  });

  window.addEventListener(CHANGE_EVENT, render);
  window.addEventListener('storage', (e) => {
    if (e.key === STORAGE_KEY) render();
  });

  render();
</script>
