---
// ИЗБРАННОЕ — раздел «Корзина» из ТЗ (wedwibse-app-scope): копит выбранные
// площадки и подрядчиков, даёт сравнить их между собой.
// Персональный экран без бэкенда — источник данных localStorage
// (см. src/lib/favorites.ts), поэтому вся разметка ниже — пустой каркас,
// который наполняет клиентский скрипт. SEO это не касается: раздел
// открывается из BottomDock, а не приходит из поиска.
//
// Два уровня, как «Доски» в Pinterest:
//   1. папки по направлениям (площадки, ведущие, …) — обложка-коллаж из трёх
//      последних кадров, название, счётчик и давность;
//   2. внутри папки — сетка карточек и режим сравнения.
// Уровень задаётся хэшем `#<cat>`, поэтому системный «назад» возвращает к папкам.
import Layout from '../../layouts/Layout.astro';
import BottomDock from '../../components/BottomDock.astro';
import Icon from '../../components/Icon.astro';
---

<Layout title="Избранное — WED Secrets" description="Площадки и подрядчики, которые вы сохранили — сравните их между собой.">
  <Fragment slot="head">
    <meta name="robots" content="noindex" />
  </Fragment>

  <!-- Заголовок раздела — крупный, в контенте, как ScopePicker у каталогов:
       h1 + счётчик рядом. Внутри папки h1 становится именем папки, а над ним
       появляется пилюля «← Папки». -->
  <header class="scope">
    <a class="pill pill--sm scope__back" href="/izbrannoe/" data-back hidden>← Папки</a>
    <div class="scope__title-row">
      <h1 class="t-h1" data-title>Избранное</h1>
      <p class="scope__count" data-count hidden></p>
    </div>
    <div class="scope__tools">
      <button class="pill pill--sm" type="button" data-compare-toggle hidden>Сравнить</button>
    </div>
  </header>

  <main class="wrap">
    <p class="empty t-small" data-empty>
      Пока пусто. Добавляйте площадки и подрядчиков сердечком на карточке — они появятся здесь,
      и их можно будет сравнить между собой.
    </p>

    <div class="boards" data-boards hidden></div>

    <div class="grid" data-grid hidden></div>

    <div class="cmp" data-compare hidden></div>
  </main>

  <div class="compare-bar" data-compare-bar hidden>
    <span class="t-small" data-compare-count>Выбрано: 0</span>
    <button class="pill pill--sm" type="button" data-compare-show disabled>Сравнить</button>
    <button class="icon-btn compare-bar__cancel" type="button" data-compare-cancel aria-label="Отменить сравнение">
      <Icon name="close" />
    </button>
  </div>

  <BottomDock active="saved" />
</Layout>

<style is:global>
  /* ============ ШАПКА РАЗДЕЛА (как ScopePicker) ============ */
  .scope {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-4);
    padding: var(--s-6) var(--gutter) var(--s-2);
  }

  .scope__back { flex: 1 0 100%; align-self: start; width: max-content; }
  .scope__back[hidden] { display: none; }

  .scope__title-row {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--s-3);
  }

  .scope__count {
    font-size: var(--fs-h3);
    font-weight: var(--w-medium);
  }

  .scope__count[hidden] { display: none; }

  .scope__tools {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    flex: 1 0 100%;
  }

  .scope__tools:empty,
  .scope__tools > [hidden] { display: none; }

  @media (min-width: 640px) {
    .scope__tools { flex: 0 0 auto; margin-left: auto; }
  }

  /* ============ ПУСТОЕ СОСТОЯНИЕ ============ */
  .empty {
    max-width: var(--measure-text);
    padding: var(--s-7) var(--gutter);
  }

  .empty[hidden] { display: none; }

  /* ============ ПАПКИ (доски) ============ */
  .wrap {
    max-width: none;
    padding: var(--s-4) clamp(8px, 1vw, 16px) calc(var(--safe-b) + 160px);
  }

  /* На телефоне — одна колонка: обложка во всю ширину, под ней имя, счётчик
     и кто внутри. От планшета — две, на ПК — три. */
  .boards {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-7) var(--s-4);
  }

  .boards[hidden] { display: none; }

  @media (min-width: 640px) {
    .boards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (min-width: 1024px) {
    .boards { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  .board {
    display: block;
    min-width: 0;
    color: inherit;
    text-decoration: none;
  }

  .board > span { display: block; }

  /* Обложка: слева крупный кадр 2/3, справа колонка из двух мелких.
     Пустые ячейки — подложка фото, как у Pinterest. */
  .board__cover {
    display: grid;
    grid-template-columns: 2fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 2px;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: var(--radius-media);
  }

  .board__tile {
    background: var(--surface-dim);
    min-width: 0;
    min-height: 0;
    overflow: hidden;
  }

  .board__tile--main { grid-row: 1 / 3; }

  .board__tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
    transition: transform var(--dur-fast) var(--ease-out);
  }

  @media (hover: hover) {
    .board:hover .board__tile img { transform: scale(1.04); }
  }

  .board > .board__cover { display: grid; }

  /* Подпись: имя папки и счётчик в одну строку по базовой линии,
     ниже — кто внутри (имена последних сохранённых). */
  .board__top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-3);
    margin-top: var(--s-3);
  }

  .board__name {
    font-size: var(--fs-h3);
    font-weight: var(--w-head);
    line-height: 1.15;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .board__meta {
    flex-shrink: 0;
    font-size: var(--fs-small);
    font-weight: var(--w-medium);
  }

  .board__who {
    margin-top: var(--s-1);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* ============ СЕТКА КАРТОЧЕК ============ */

  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-6) clamp(8px, 1vw, 12px);
  }

  .grid[hidden] { display: none; }

  @media (min-width: 640px) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (min-width: 1024px) {
    .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  /* ============ КАРТОЧКА ИЗБРАННОГО ============ */
  .fcard {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    min-width: 0;
  }

  .fcard__media {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--surface-dim);
  }

  .fcard__link { display: block; width: 100%; height: 100%; }

  .fcard__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .fcard__remove {
    position: absolute;
    top: var(--s-3);
    right: var(--s-3);
    z-index: 1;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 1.5px solid var(--white);
    border-radius: 50%;
    background: rgb(0 0 0 / 0.25);
    color: var(--white);
    font-size: 18px;
    line-height: 1;
    cursor: pointer;
    filter: drop-shadow(0 1px 8px rgb(0 0 0 / 0.45));
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .fcard__remove:active { transform: scale(0.85); }

  .fcard__check {
    position: absolute;
    top: var(--s-3);
    left: var(--s-3);
    z-index: 1;
    display: none;
  }

  .grid.is-compare .fcard__check { display: block; }
  .grid.is-compare .fcard__remove { display: none; }

  .fcard__check input {
    position: absolute;
    inset: 0;
    width: 28px;
    height: 28px;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .fcard__check-mark {
    display: flex;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 1.5px solid var(--white);
    background: rgb(0 0 0 / 0.25);
    filter: drop-shadow(0 1px 8px rgb(0 0 0 / 0.45));
  }

  .fcard__check input:checked + .fcard__check-mark {
    background: var(--white);
    border-color: var(--white);
  }

  .fcard__check-mark::after {
    content: '';
    margin: auto;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--ink);
    opacity: 0;
  }

  .fcard__check input:checked + .fcard__check-mark::after { opacity: 1; }

  .fcard__top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-3);
  }

  .fcard__name {
    font-size: var(--fs-h3);
    font-weight: var(--w-head);
    line-height: 1.15;
  }

  .fcard__rate {
    font-size: var(--fs-small);
    font-weight: var(--w-medium);
    flex-shrink: 0;
  }

  .fcard__meta { margin-top: 2px; }

  /* ============ ПЛАВАЮЩАЯ ПАНЕЛЬ СРАВНЕНИЯ ============ */
  .compare-bar {
    position: fixed;
    left: 50%;
    bottom: calc(var(--safe-b) + var(--s-5) + 64px);
    transform: translateX(-50%);
    z-index: var(--z-nav);
    display: flex;
    align-items: center;
    gap: var(--s-4);
    padding: var(--s-2) var(--s-2) var(--s-2) var(--s-4);
    border-radius: var(--radius-pill);
    background: var(--ink);
    color: var(--white);
    box-shadow: var(--shadow-float);
    max-width: calc(100vw - var(--s-5) * 2);
  }

  .compare-bar[hidden] { display: none; }

  .compare-bar .pill {
    border-color: var(--white);
    color: var(--white);
    white-space: nowrap;
  }

  @media (hover: hover) {
    .compare-bar .pill:hover { background: var(--white); color: var(--ink); }
  }

  .compare-bar .pill:disabled {
    pointer-events: none;
    border-color: var(--line-dark);
    color: var(--line-dark);
  }

  .compare-bar__cancel {
    border-color: var(--white);
    color: var(--white);
  }

  @media (hover: hover) {
    .compare-bar__cancel:hover { background: var(--white); color: var(--ink); }
  }

  /* ============ ТАБЛИЦА СРАВНЕНИЯ ============ */
  .cmp {
    padding: var(--s-4) clamp(8px, 1vw, 16px) calc(var(--safe-b) + 160px);
  }

  .cmp[hidden] { display: none; }

  .cmp__back { margin: 0 0 var(--s-5); }

  .cmp__scroll {
    overflow-x: auto;
    scrollbar-width: none;
  }

  .cmp__scroll::-webkit-scrollbar { display: none; }

  .cmp__table {
    display: grid;
    grid-template-columns: minmax(110px, 140px) repeat(var(--cols), minmax(160px, 1fr));
    border-top: 1px solid var(--hairline);
    min-width: 100%;
    width: max-content;
  }

  .cmp__row { display: contents; }

  .cmp__label,
  .cmp__cell {
    padding: var(--s-4);
    border-bottom: 1px solid var(--hairline);
  }

  .cmp__label {
    position: sticky;
    left: 0;
    font-size: var(--fs-small);
    font-weight: var(--w-medium);
    background: var(--bg);
  }

  .cmp__cell { min-width: 0; }
  .cmp__cell a { text-decoration: none; }

  .cmp__img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
</style>

<script>
  import { getFavorites, removeFavorite, CHANGE_EVENT, STORAGE_KEY, type FavoriteItem } from '../../lib/favorites';

  const emptyEl = document.querySelector<HTMLElement>('[data-empty]');
  const gridEl = document.querySelector<HTMLElement>('[data-grid]');
  const boardsEl = document.querySelector<HTMLElement>('[data-boards]');
  const titleEl = document.querySelector<HTMLElement>('[data-title]');
  const countEl = document.querySelector<HTMLElement>('[data-count]');
  const backEl = document.querySelector<HTMLAnchorElement>('[data-back]');
  const compareToggleBtn = document.querySelector<HTMLButtonElement>('[data-compare-toggle]');
  const compareBar = document.querySelector<HTMLElement>('[data-compare-bar]');
  const compareCountEl = document.querySelector<HTMLElement>('[data-compare-count]');
  const compareShowBtn = document.querySelector<HTMLButtonElement>('[data-compare-show]');
  const compareCancelBtn = document.querySelector<HTMLButtonElement>('[data-compare-cancel]');
  const compareEl = document.querySelector<HTMLElement>('[data-compare]');

  let items: FavoriteItem[] = [];
  /** открытая папка (cat) или null — уровень папок; читается из location.hash */
  let activeCat: string | null = null;
  let compareMode = false;
  const selected = new Set<string>();

  function escapeHtml(s: string): string {
    return s.replace(/[&<>"']/g, (c) => (
      { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string
    ));
  }

  function catFromHash(): string | null {
    const h = decodeURIComponent(location.hash.replace(/^#/, ''));
    return h || null;
  }

  function currentItems(): FavoriteItem[] {
    return activeCat ? items.filter((i) => i.cat === activeCat) : [];
  }

  function updateCompareToggleVisibility() {
    if (!compareToggleBtn) return;
    const eligible = !!activeCat && currentItems().length >= 2;
    compareToggleBtn.hidden = !eligible || compareMode;
  }

  /** «1 карточка / 2 карточки / 5 карточек» */
  function plural(n: number, one: string, few: string, many: string): string {
    const m10 = n % 10;
    const m100 = n % 100;
    if (m10 === 1 && m100 !== 11) return one;
    if (m10 >= 2 && m10 <= 4 && (m100 < 12 || m100 > 14)) return few;
    return many;
  }

  /** давность последнего добавления в папку: «сегодня», «3 дн.», «2 нед.», «1 мес.» */
  function ago(ts: number | undefined): string {
    if (!ts) return '';
    const days = Math.floor((Date.now() - ts) / 86_400_000);
    if (days < 1) return 'сегодня';
    if (days < 7) return `${days} дн.`;
    if (days < 30) return `${Math.floor(days / 7)} нед.`;
    if (days < 365) return `${Math.floor(days / 30)} мес.`;
    return `${Math.floor(days / 365)} г.`;
  }

  function updateCompareBar() {
    if (compareCountEl) compareCountEl.textContent = `Выбрано: ${selected.size}`;
    if (compareShowBtn) compareShowBtn.disabled = selected.size < 2;
  }

  function exitCompareMode() {
    compareMode = false;
    selected.clear();
    gridEl?.classList.remove('is-compare');
    gridEl?.querySelectorAll<HTMLInputElement>('[data-compare-check]').forEach((i) => { i.checked = false; });
    compareBar?.setAttribute('hidden', '');
    updateCompareToggleVisibility();
  }

  /** Уровень папок: одна доска на направление, обложка — три последних кадра */
  function renderBoards() {
    if (!boardsEl) return;
    const cats = Array.from(new Set(items.map((i) => i.cat)));

    boardsEl.innerHTML = cats
      .map((cat) => {
        const list = items.filter((i) => i.cat === cat);
        const label = list[0]?.catLabel ?? cat;
        const recent = [...list].reverse();
        const tiles = [0, 1, 2].map((n) => {
          const it = recent[n];
          const cls = n === 0 ? 'board__tile board__tile--main' : 'board__tile';
          return it
            ? `<span class="${cls}"><img src="${escapeHtml(it.img)}" alt="" loading="lazy" decoding="async" /></span>`
            : `<span class="${cls}"></span>`;
        }).join('');
        const latest = Math.max(0, ...list.map((i) => i.addedAt ?? 0));
        const when = ago(latest || undefined);
        const count = `${list.length} ${plural(list.length, 'карточка', 'карточки', 'карточек')}`;
        // кто внутри: имена последних трёх, дальше «и ещё N»
        const names = recent.slice(0, 3).map((i) => i.name);
        const rest = list.length - names.length;
        const who = names.join(', ') + (rest > 0 ? ` и ещё ${rest}` : '');

        return `
          <a class="board" href="#${encodeURIComponent(cat)}" data-board="${escapeHtml(cat)}">
            <span class="board__cover" aria-hidden="true">${tiles}</span>
            <span class="board__top">
              <span class="board__name">${escapeHtml(label)}</span>
              <span class="board__meta">${count}${when ? ` · ${when}` : ''}</span>
            </span>
            <span class="board__who t-small">${escapeHtml(who)}</span>
          </a>
        `;
      })
      .join('');
  }

  /** Переключение уровня: шапка, видимость блоков */
  function applyLevel() {
    const inFolder = !!activeCat;
    const n = inFolder ? currentItems().length : items.length;
    if (titleEl) titleEl.textContent = inFolder ? (items.find((i) => i.cat === activeCat)?.catLabel ?? 'Избранное') : 'Избранное';
    if (countEl) {
      countEl.textContent = `${n} ${plural(n, 'карточка', 'карточки', 'карточек')}`;
      countEl.hidden = n === 0;
    }
    if (backEl) backEl.hidden = !inFolder;
    if (boardsEl) boardsEl.hidden = inFolder;
    if (gridEl) gridEl.hidden = !inFolder;
  }

  function renderGrid() {
    if (!gridEl) return;
    const list = currentItems();

    gridEl.innerHTML = list
      .map((it) => `
        <article class="fcard" data-id="${escapeHtml(it.id)}">
          <div class="fcard__media">
            <a class="fcard__link" href="${escapeHtml(it.href)}">
              <img src="${escapeHtml(it.img)}" alt="${escapeHtml(it.name)}" loading="lazy" decoding="async" />
            </a>
            <span class="veil" aria-hidden="true"></span>
            <label class="fcard__check">
              <input type="checkbox" data-compare-check value="${escapeHtml(it.id)}" aria-label="Добавить «${escapeHtml(it.name)}» к сравнению" />
              <span class="fcard__check-mark" aria-hidden="true"></span>
            </label>
            <button class="fcard__remove" type="button" data-remove="${escapeHtml(it.id)}" aria-label="Убрать «${escapeHtml(it.name)}» из избранного">&times;</button>
          </div>
          <div class="fcard__body">
            <div class="fcard__top">
              <h2 class="fcard__name">${escapeHtml(it.name)}</h2>
              <span class="fcard__rate">★ ${it.rating.toFixed(1)}</span>
            </div>
            <p class="fcard__meta t-caption">${escapeHtml(it.meta)} · ${escapeHtml(it.price)}</p>
          </div>
        </article>
      `)
      .join('');

    gridEl.querySelectorAll<HTMLButtonElement>('[data-remove]').forEach((btn) => {
      btn.addEventListener('click', () => removeFavorite(btn.dataset.remove!));
    });

    gridEl.querySelectorAll<HTMLInputElement>('[data-compare-check]').forEach((input) => {
      input.addEventListener('change', () => {
        if (input.checked) selected.add(input.value);
        else selected.delete(input.value);
        updateCompareBar();
      });
    });

    gridEl.classList.toggle('is-compare', compareMode);
    updateCompareToggleVisibility();
  }

  function renderCompare() {
    if (!compareEl) return;
    const chosen = items.filter((i) => selected.has(i.id));

    const rows: { label: string; render: (i: FavoriteItem) => string }[] = [
      { label: 'Фото', render: (i) => `<img class="cmp__img" src="${escapeHtml(i.img)}" alt="${escapeHtml(i.name)}" loading="lazy" decoding="async" />` },
      { label: 'Название', render: (i) => `<a href="${escapeHtml(i.href)}">${escapeHtml(i.name)}</a>` },
      { label: 'Рейтинг', render: (i) => `★ ${i.rating.toFixed(1)}` },
      { label: 'Цена', render: (i) => escapeHtml(i.price) },
      { label: 'Детали', render: (i) => escapeHtml(i.meta) },
    ];

    compareEl.innerHTML = `
      <button class="pill pill--sm cmp__back" type="button" data-compare-back>← К списку</button>
      <div class="cmp__scroll">
        <div class="cmp__table" style="--cols:${chosen.length}">
          ${rows
            .map((row) => `
              <div class="cmp__row">
                <div class="cmp__label">${row.label}</div>
                ${chosen.map((i) => `<div class="cmp__cell">${row.render(i)}</div>`).join('')}
              </div>
            `)
            .join('')}
        </div>
      </div>
    `;

    compareEl.querySelector<HTMLButtonElement>('[data-compare-back]')?.addEventListener('click', showGrid);

    compareEl.hidden = false;
    if (gridEl) gridEl.hidden = true;
    compareBar?.setAttribute('hidden', '');
  }

  function showGrid() {
    if (compareEl) compareEl.hidden = true;
    if (gridEl) gridEl.hidden = false;
    exitCompareMode();
  }

  function render() {
    items = getFavorites();
    const empty = items.length === 0;

    emptyEl?.toggleAttribute('hidden', !empty);
    if (compareEl) compareEl.hidden = true;
    compareMode = false;
    selected.clear();
    compareBar?.setAttribute('hidden', '');

    // папка, которой больше нет (удалили последнюю карточку) — назад к папкам
    activeCat = catFromHash();
    if (activeCat && !items.some((i) => i.cat === activeCat)) {
      activeCat = null;
      history.replaceState(null, '', location.pathname);
    }

    if (empty) {
      if (boardsEl) { boardsEl.innerHTML = ''; boardsEl.hidden = true; }
      if (gridEl) gridEl.hidden = true;
      if (titleEl) titleEl.textContent = 'Избранное';
      if (countEl) countEl.hidden = true;
      if (backEl) backEl.hidden = true;
      compareToggleBtn && (compareToggleBtn.hidden = true);
      return;
    }

    renderBoards();
    renderGrid();
    applyLevel();
  }

  // «← Папки»: без перезагрузки, просто снимаем хэш
  backEl?.addEventListener('click', (e) => {
    e.preventDefault();
    history.pushState(null, '', location.pathname);
    render();
    window.scrollTo({ top: 0 });
  });

  window.addEventListener('hashchange', () => {
    render();
    window.scrollTo({ top: 0 });
  });

  compareToggleBtn?.addEventListener('click', () => {
    compareMode = true;
    selected.clear();
    gridEl?.classList.add('is-compare');
    compareToggleBtn.hidden = true;
    compareBar?.removeAttribute('hidden');
    updateCompareBar();
  });

  compareCancelBtn?.addEventListener('click', exitCompareMode);
  compareShowBtn?.addEventListener('click', renderCompare);

  window.addEventListener(CHANGE_EVENT, render);
  window.addEventListener('storage', (e) => { if (e.key === STORAGE_KEY) render(); });

  render();
</script>
