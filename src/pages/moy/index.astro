---
// КАБИНЕТ НЕВЕСТЫ → ЗАЯВКИ (14.11.2026): первый экран кабинета. Заявки,
// которые невеста оставила с карточек, пока была в учётке (хук createLead
// ставит leads.bride; правило коллекции даёт ей только свои). Отправленные
// без входа сюда не попадают — они не знают, чьи они.
// Оболочка — BrideShell (система кабинета подрядчика, своя нижняя полоса).
import BrideShell from '../../components/admin/BrideShell.astro';
---

<BrideShell title="Заявки" section="leads">
  <div class="cab-col">
    <div class="c-head">
      <h1 class="a-h1">Заявки</h1>
    </div>
    <div class="c-sheet-area" data-leads>
      <p class="c-empty">Загружаем…</p>
    </div>
  </div>
</BrideShell>

<style>
  .c-empty { margin-top: var(--s-4); max-width: 40ch; padding-inline: var(--s-4); }
  :global(.b-leads) { display: grid; gap: var(--cab-gap); }
  :global(.b-lead) { display: grid; gap: 12px; padding: 18px; border-radius: var(--cab-sheet-radius); background: var(--adm-card); color: inherit; text-decoration: none; }
  /* «кто и что» вплотную (4 px) — меньше, чем до сообщения (12 px) */
  :global(.b-lead__top) { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 4px 12px; }
  :global(.b-lead__card) { font-size: 18px; line-height: 24px; font-weight: 600; overflow-wrap: anywhere; }
  :global(.b-lead__when) { grid-column: 1 / -1; font-size: var(--adm-fs-sm); }
  :global(.b-lead__msg) { font-size: 16px; line-height: 22px; white-space: pre-line; overflow-wrap: anywhere; }
  :global(.b-empty) { display: grid; gap: 16px; justify-items: start; margin-top: var(--s-4); padding-inline: var(--s-4); }
  :global(.b-empty p) { max-width: 40ch; }
</style>

<script>
  import { api, esc, errText } from '../../lib/cabinet-api';
  import { requireBride, brideSession } from '../../lib/bride';

  const box = document.querySelector<HTMLElement>('[data-leads]')!;
  // статус заявки глазами пары; цвета — как LEAD_STATUS админки
  // (новая — синий, в работе — серый, закрыта — зелёный; спам паре не показываем)
  const STATE: Record<string, [string, string]> = {
    new: ['Отправлена', 'status--info'],
    'in-progress': ['В работе', ''],
    closed: ['Закрыта', 'status--ok'],
  };
  const fmt = (iso: string) => new Date(String(iso).replace(' ', 'T')).toLocaleDateString('ru-RU', { day: 'numeric', month: 'long' });

  async function load() {
    const me = brideSession()!;
    const filter = encodeURIComponent(`bride = "${me.record.id}" && status != "spam"`);
    const res = await api('bride', 'GET', `/api/collections/leads/records?perPage=100&sort=-created&expand=venue,specialist&filter=${filter}`);
    if (!res.items.length) {
      box.innerHTML = `
        <div class="b-empty">
          <p>Заявок пока нет. Оставьте телефон на странице площадки или специалиста — заявка появится здесь, и вы увидите, когда её взяли в работу</p>
          <a class="a-btn" href="/moskva/ploshchadki/">Выбрать площадку</a>
        </div>`;
      return;
    }
    box.innerHTML = `<div class="b-leads">${res.items.map((l: any) => {
      const v = l.expand?.venue;
      const s = l.expand?.specialist;
      const card = v ?? s;
      const href = v ? `/moskva/ploshchadki/${v.slug}/` : s ? `/moskva/podryadchiki/${s.categorySlug}/${s.slug}/` : '';
      const [label, tone] = STATE[l.status] ?? STATE.new;
      // служебные строки сообщения («Карточка: …», «Связаться: звонок») паре не нужны
      const msg = String(l.message || '').split('\n').filter((x: string) => !/^Карточка: |^Связаться: |^Из избранного, всем сразу/.test(x)).join('\n').trim();
      const name = card ? esc(card.name) : esc((String(l.message).match(/^Карточка: (.+)$/m) || [])[1] || 'Заявка');
      return `
        <${href ? `a href="${href}"` : 'div'} class="b-lead">
          <div class="b-lead__top">
            <span class="b-lead__card">${name}</span>
            <span class="status ${tone}">${label}</span>
            <span class="b-lead__when">${fmt(l.created)}</span>
          </div>
          ${msg ? `<p class="b-lead__msg">${esc(msg)}</p>` : ''}
        </${href ? 'a' : 'div'}>`;
    }).join('')}</div>`;
  }

  if (requireBride()) {
    load().catch((err) => {
      box.innerHTML = `<p class="c-empty">${esc(errText(err))} <button class="a-btn a-btn--sm" type="button" data-retry>Повторить</button></p>`;
      box.querySelector('[data-retry]')?.addEventListener('click', () => location.reload());
    });
  }
</script>
