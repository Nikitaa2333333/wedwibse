---
// КАБИНЕТ НЕВЕСТЫ — пока только «Мои отзывы» (12.11.2026, docs/cabinet/REVIEWS.md).
// Дальше сюда же — заявки, избранное на всех устройствах, данные свадьбы
// (docs/cabinet/CABINET.md §21). Данные рисует браузер по токену невесты.
import Layout from '../../layouts/Layout.astro';
import BottomDock from '../../components/BottomDock.astro';
---

<Layout title="Мои отзывы — WED Secrets" description="Отзывы, которые вы оставили на WED Secrets." noindex>
  <main class="container my" data-root>
    <header class="my__head">
      <h1 class="t-h1">Мои отзывы</h1>
      <p class="my__who" data-who></p>
    </header>
    <div class="my__list" data-list><p>Загружаем…</p></div>
    <button class="pill my__out" type="button" data-logout>Выйти</button>
  </main>
  <BottomDock />
</Layout>

<style>
  .my { display: grid; gap: var(--s-6); padding-block: var(--s-6) var(--s-8); max-width: 640px; }
  .my__head { display: grid; gap: var(--s-2); }
  .my__who { font-size: var(--fs-small); }
  .my__list { display: grid; gap: var(--s-3); }
  .my__out { justify-self: start; }
  .my :global(.my-r) { display: grid; gap: var(--s-2); padding: var(--s-5); background: var(--surface-dim); border-radius: var(--radius-card); }
  .my :global(.my-r__top) { display: flex; justify-content: space-between; gap: var(--s-3); align-items: baseline; }
  .my :global(.my-r__card) { font-weight: var(--w-medium); color: inherit; }
  .my :global(.my-r__state) { font-size: var(--fs-small); white-space: nowrap; }
  .my :global(.my-r__text) { overflow-wrap: anywhere; line-height: var(--lh-body); max-width: var(--measure-text); }
  .my :global(.my-r__note) { font-size: var(--fs-small); line-height: var(--lh-body); }
  .my :global(.my-r__del) { justify-self: start; background: none; border: 0; padding: 0; font: inherit; font-size: var(--fs-small); text-decoration: underline; color: inherit; cursor: pointer; }
</style>

<script>
  import { api, esc, errText } from '../../lib/cabinet-api';
  import { requireBride, brideSession, brideLogout } from '../../lib/bride';

  const list = document.querySelector<HTMLElement>('[data-list]')!;
  const STATE: Record<string, string> = { pending: 'На проверке', approved: 'Опубликован', rejected: 'Не опубликован' };

  async function load() {
    const me = brideSession()!;
    const who = me.record.email || me.record.name;
    if (who) document.querySelector('[data-who]')!.textContent = `Вы вошли как ${who}`;
    const res = await api('bride', 'GET', `/api/collections/reviews/records?perPage=100&sort=-created&expand=venue,specialist&filter=${encodeURIComponent(`bride = "${me.record.id}"`)}`);
    if (!res.items.length) {
      list.innerHTML = '<p>Отзывов пока нет. Откройте страницу площадки или подрядчика и нажмите «Оставить отзыв».</p>';
      return;
    }
    list.innerHTML = res.items.map((r: any) => {
      const v = r.expand?.venue;
      const s = r.expand?.specialist;
      const card = v ?? s;
      const href = v ? `/moskva/ploshchadki/${v.slug}/` : s ? `/moskva/podryadchiki/${s.categorySlug}/${s.slug}/` : '';
      return `
        <article class="my-r">
          <div class="my-r__top">
            ${card ? `<a class="my-r__card" href="${href}">${esc(card.name)}</a>` : '<span class="my-r__card">Карточка снята с сайта</span>'}
            <span class="my-r__state">${STATE[r.status] ?? ''}</span>
          </div>
          <p aria-label="Оценка ${r.rating} из 5">${'★'.repeat(r.rating)}${'☆'.repeat(5 - r.rating)}</p>
          <p class="my-r__text">${esc(r.text)}</p>
          ${r.status === 'rejected' && r.rejectReason ? `<p class="my-r__note">Причина: ${esc(r.rejectReason)}. Отзыв можно удалить и написать заново.</p>` : ''}
          <button class="my-r__del" type="button" data-del="${r.id}">Удалить отзыв</button>
        </article>`;
    }).join('');
  }

  list.addEventListener('click', async (ev) => {
    const btn = (ev.target as HTMLElement).closest<HTMLButtonElement>('[data-del]');
    if (!btn || !confirm('Удалить отзыв? Его нельзя будет вернуть.')) return;
    btn.disabled = true;
    try {
      await api('bride', 'DELETE', `/api/collections/reviews/records/${btn.dataset.del}`);
      await load();
    } catch (err) {
      alert(errText(err));
      btn.disabled = false;
    }
  });

  document.querySelector('[data-logout]')!.addEventListener('click', () => {
    brideLogout();
    location.href = '/';
  });

  if (requireBride()) load().catch((err) => { list.innerHTML = `<p>${esc(errText(err))}</p>`; });
</script>
