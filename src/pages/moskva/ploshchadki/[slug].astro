---
// ШАБЛОН КАРТОЧКИ ПОДРЯДЧИКА (площадки).
// URL зафиксирован SEO-фундаментом: /moskva/ploshchadki/nazvanie/
// Страница ничего не знает про конкретную площадку — только про тип Venue.
// Между первым экраном и контактами тело страницы — СПИСОК БЛОКОВ
// (lib/venue-blocks.ts): порядок и набор секций задают данные площадки,
// а не этот файл. Новая площадка = объект в src/data/venues.ts или JSON
// в src/data/venues/ (см. .claude/skills/venue-page).
import Layout from '../../../layouts/Layout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import VenueHero from '../../../components/VenueHero.astro';
import StatsStrip from '../../../components/StatsStrip.astro';
import ScrollyScenes from '../../../components/ScrollyScenes.astro';
import VenueStatement from '../../../components/VenueStatement.astro';
import VenueTerms from '../../../components/VenueTerms.astro';
import VenueRules from '../../../components/VenueRules.astro';
import VenueDocs from '../../../components/VenueDocs.astro';
import PhotoMasonry from '../../../components/PhotoMasonry.astro';
import FaqBlock from '../../../components/FaqBlock.astro';
import VenueContacts from '../../../components/VenueContacts.astro';
import Reviews from '../../../components/Reviews.astro';
import ReelsRow from '../../../components/ReelsRow.astro';
import BottomDock from '../../../components/BottomDock.astro';
import { VENUES, type Venue } from '../../../data/venues';
import { venueReviews } from '../../../data/venue-reviews';
import { reelsOfVenue } from '../../../data/reels';
import { venueBlocks } from '../../../lib/venue-blocks';
import { photoTiles } from '../../../lib/gallery';
import { IMG_WIDTHS } from '../../../lib/images';

export function getStaticPaths() {
  return VENUES.map((venue) => ({
    params: { slug: venue.slug },
    props: { venue },
  }));
}

interface Props {
  venue: Venue;
}

const { venue } = Astro.props;

// Отзывы есть не у каждой площадки — блок и строка фактов в первом
// экране появляются только там, где им есть что показать.
const reviews = venueReviews(venue.slug);

const blocks = venueBlocks(venue);
const reels = reelsOfVenue(venue.slug);
---

<Layout title={venue.seo.title} description={venue.seo.description} ogImage={venue.seo.ogImage}>
  {/* Шапка без телефона площадки: контактов партнёра на странице нет
      совсем (см. VenueContacts) — заявка идёт через нас. */}
  <SiteHeader />

  <main data-venue-slug={venue.slug}>
    <VenueHero venue={venue} />

    {
      blocks.map((block) => {
        switch (block.type) {
          case 'stats':
            return <StatsStrip items={block.items} />;

          case 'scenes':
            return (
              <ScrollyScenes kicker={block.kicker ?? 'Сцены'} title={block.title} scenes={block.scenes} />
            );

          case 'statement':
            return (
              <VenueStatement
                kicker={block.kicker}
                title={block.title}
                body={block.body}
                facts={block.facts}
                dark={block.dark}
              />
            );

          case 'terms':
            return (
              <VenueTerms
                kicker={block.kicker ?? 'Условия'}
                title={block.title ?? 'Сколько стоит и как забронировать'}
                terms={block.terms}
                included={block.included}
                extras={block.extras}
              />
            );

          case 'rules':
            return (
              <VenueRules
                kicker={block.kicker ?? 'Ограничения'}
                title={block.title ?? 'Что важно знать заранее'}
                rules={block.rules}
              />
            );

          case 'docs':
            return (
              <VenueDocs
                kicker={block.kicker ?? 'Документы'}
                title={block.title ?? 'Техническое сопровождение'}
                lead={
                  block.lead ??
                  'Спецификации площадки одним файлом: что за оборудование стоит в зале, какой свет и звук уже есть и что подрядчикам нужно привезти с собой. Пригодится ведущему, диджею и техдиректору при подготовке.'
                }
                docs={block.docs}
              />
            );

          // ГАЛЕРЕЯ: та же доска, что на главной и в визитке подрядчика
          // (PhotoMasonry) — колонки, каждый кадр в своей настоящей пропорции.
          // Все кадры сразу, без «показать ещё»: картинки ленивые, браузер
          // качает только те, что дошли до экрана. Ролики в доску не идут —
          // плитка их не играет, у них свой ряд (блок reels).
          case 'gallery': {
            const photos = (block.photos ?? venue.gallery).filter((g) => !g.src.endsWith('.mp4'));
            return (
              <section class="vgal section" id="foto">
                <div class="container container--wide">
                  <header class="vgal__head">
                    <p class="vgal__kicker t-caption">{block.kicker ?? 'Галерея'}</p>
                    <h2 class="vgal__title t-h2">{block.title ?? 'Зал и мероприятия'}</h2>
                  </header>

                  <PhotoMasonry
                    tiles={photoTiles(photos.map((g) => g.src), venue.name)}
                    sizes="(min-width: 1440px) 19vw, (min-width: 1024px) 24vw, (min-width: 640px) 32vw, 48vw"
                    widths={IMG_WIDTHS.tile}
                  />
                </div>
              </section>
            );
          }

          // ОТЗЫВЫ — блок тот же, что на карточке подрядчика; без отзывов
          // в venue-reviews.ts секция просто не рисуется.
          case 'reviews':
            return (
              reviews && (
                <Reviews
                  reviews={reviews.items}
                  rating={reviews.rating}
                  ratings={reviews.ratings}
                  total={reviews.total}
                />
              )
            );

          case 'reels':
            return <ReelsRow reels={reels} title={block.title} section />;

          case 'faq':
            return (
              <FaqBlock
                kicker={block.kicker ?? 'Вопросы'}
                title={block.title ?? 'Что спрашивают чаще всего'}
                items={block.items}
              />
            );
        }
      })
    }

    <VenueContacts venue={venue} />
  </main>

  <BottomDock active="venues" />
</Layout>

<style>
  /* ГАЛЕРЕЯ ПЛОЩАДКИ: заголовок на бумаге, доска под ним в край экрана */
  .vgal :global(.container) { max-width: none; padding-inline: 0; }
  .vgal__head { padding: 0 var(--gutter) var(--s-5); }
  .vgal__kicker { font-weight: var(--w-medium); }
</style>

<script>
  // ОТМЕТКА «УЖЕ СМОТРЕЛ» — открыли карточку, значит на карте её метка
  // дальше идёт погасшей (реф. ЦИАН, см. lib/seen и VenueMap).
  // Ставится на самой странице площадки, а не по клику на метке: клик
  // по метке на ПК только поднимает карточку-превью поверх карты —
  // это ещё не «смотрел».
  import { markSeen, seenId } from '../../../lib/seen';

  const slug = document.querySelector<HTMLElement>('[data-venue-slug]')?.dataset.venueSlug;
  if (slug) markSeen(seenId('venue', slug));
</script>
