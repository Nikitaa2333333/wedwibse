---
// ШАБЛОН КАРТОЧКИ ПЛОЩАДКИ. URL зафиксирован SEO-фундаментом: /moskva/ploshchadki/nazvanie/
// Сама страница — components/VenuePage.astro (её же рисует превью анкеты).
// Новая площадка конвейера = JSON в src/data/venues/ (см. .claude/skills/venue-page);
// площадка из кабинета приходит из базы (lib/live-data.ts → lib/cabinet-venue.mjs).
// САЙТ ИЗ БАЗЫ (этап 3, 05.11.2026): страницу рисует сервер из живых данных
// базы (lib/live-data.ts) — правка площадки видна через секунды, без пересборки.
export const prerender = false;
import VenuePage from '../../../components/VenuePage.astro';
import { VENUES, type Venue } from '../../../data/venues';
import { refreshLive, LIVE_CACHE } from '../../../lib/live-data';

await refreshLive();
const venue: Venue | undefined = VENUES.find((v) => v.slug === Astro.params.slug);
// нет площадки — честная 404, а не пустая 200
if (!venue) return new Response(null, { status: 404 });
Astro.response.headers.set('cache-control', LIVE_CACHE);
---

<VenuePage venue={venue} />
