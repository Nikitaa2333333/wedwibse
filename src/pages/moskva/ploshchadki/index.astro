---
// КАТАЛОГ ПЛОЩАДОК (раздел 2 основного меню).
// Тот же паттерн, что у «Специалистов» (podryadchiki/vedushchie): полоса
// чипов над каталогом (FilterBar) и шторка фильтров снизу (FilterSheet),
// мозаика карточек — нормальная (1 колонка), wide и duo (2 колонки), hero
// (во всю ширину, «растянутая» витринная карточка). Внутри карточки кадры
// листаются свайпом (scroll-snap) — мобильный способ смотреть несколько
// фото, duo показывает два кадра сразу без свайпа.
import { Image } from 'astro:assets';
import Layout from '../../../layouts/Layout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import BottomDock from '../../../components/BottomDock.astro';
import FilterBar from '../../../components/FilterBar.astro';
import FilterSheet from '../../../components/FilterSheet.astro';
import ScopePicker from '../../../components/ScopePicker.astro';
import PhotoRail from '../../../components/PhotoRail.astro';
import Icon from '../../../components/Icon.astro';
import { FEED, VENUE_FILTERS, type FeedVenue } from '../../../data/feed';
import { resolveImage, favoriteImage } from '../../../lib/images';
import { countOptions } from '../../../lib/filter-counts';

// Бакеты для диапазонных фильтров — считаются на сборке (см. тот же приём
// в podryadchiki/vedushchie/index.astro).
function capacityBucket(max: number): string {
  if (max <= 80) return '0-80';
  if (max <= 120) return '80-120';
  return '120+';
}

function checkBucket(from: number): string {
  if (from < 5000) return '0-5';
  if (from < 7000) return '5-7';
  if (from < 9000) return '7-9';
  return '9+';
}

// ============ МОЗАИКА БЕЗ ДЫР ============
// hero — во всю ширину (первая карточка, витрина); wide и duo — на две
// колонки (см. алгоритм подробно в podryadchiki/vedushchie/index.astro).
// Индекс считаем только по площадкам — рекламная карточка в мозаику
// вариантов не участвует и в фильтрации тоже (всегда видна).
type CardVariant = '' | 'vcard--wide' | 'vcard--duo' | 'vcard--hero';
function variant(i: number): CardVariant {
  if (i === 0) return 'vcard--hero';
  if (i % 5 === 2) return 'vcard--wide';
  if (i % 5 === 4) return 'vcard--duo';
  return '';
}

// Значения фильтра карточки — одним местом: и в data-filters, и в счётчики чипов
const filtersOf = (item: FeedVenue) => ({
  type: item.type,
  city: item.city,
  capacity: capacityBucket(item.capacityMax),
  avgCheck: checkBucket(item.checkFrom),
});

let venueIndex = 0;
const venues = FEED.filter((item): item is FeedVenue => item.kind === 'venue');
const venueCount = venues.length;
const counts = countOptions(VENUE_FILTERS, venues.map(filtersOf));

// Кадр для снимка в избранном — уже пережатый URL, не путь из данных
const favImg = new Map(
  await Promise.all(venues.map(async (v) => [v.name, await favoriteImage(v.media[0])] as const))
);
---

<Layout
  title="Свадебные площадки Москвы и Подмосковья — WED Secrets"
  description="Каталог свадебных площадок: залы, лофты, усадьбы и террасы Москвы и Московской области с рейтингом, отзывами и ценами."
>
  <SiteHeader />

  <ScopePicker
    title="Площадки"
    active="ploshchadki"
    count={`${venueCount} найдено`}
    cityGroup={VENUE_FILTERS.find((g) => g.key === 'city')}
  />

  <!-- ФИЛЬТРЫ: полоса чипов над каталогом; вся настройка — в шторке снизу -->
  <FilterBar groups={VENUE_FILTERS} counts={counts} />

  <div class="layout">
    <!-- ШТОРКА ФИЛЬТРОВ: на телефоне всплывает снизу, на ПК — эта же
         разметка стоит постоянной колонкой слева (.sheet--dock) -->
    <aside class="sidebar">
      <FilterSheet groups={VENUE_FILTERS} counts={counts} noun={['площадка', 'площадки', 'площадок']} sortable />
    </aside>

    <!-- СЕТКА: мозаика без дыр, фото — главное. Без анимации появления:
         каталог листается спокойно, карточки стоят на месте. -->
    <main class="wrap">
      <div class="vgrid" data-sort-grid>
        {FEED.map((item) => {
          if (item.kind === 'ad') {
            return (
              <article class="vcard vcard--ad theme-dark">
                <div class="vcard__ad">
                  <p class="t-caption vcard__ad-tag">Реклама</p>
                  <h2 class="vcard__ad-title">{item.title}</h2>
                  <p class="t-small">{item.note}</p>
                  <a class="pill" href={item.href}>Разместить площадку</a>
                </div>
              </article>
            );
          }

          const cardVariant = variant(venueIndex);
          venueIndex += 1;
          const filters = filtersOf(item);
          const sortKey = { price: item.checkFrom, rating: item.rating };

          const sizes =
            cardVariant === 'vcard--hero'
              ? '100vw'
              : cardVariant === 'vcard--wide' || cardVariant === 'vcard--duo'
                ? '(min-width: 1440px) 50vw, (min-width: 640px) 66vw, 100vw'
                : '(min-width: 1440px) 25vw, (min-width: 640px) 33vw, 50vw';

          const saveData = JSON.stringify({
            id: `venue:${item.name}`,
            cat: 'venue',
            catLabel: 'Площадки',
            name: item.name,
            meta: item.city,
            price: item.avgCheck,
            rating: item.rating,
            img: favImg.get(item.name),
            href: `/moskva/ploshchadki/${item.slug}/`,
          });

          return (
            <article
              class={`vcard${cardVariant ? ` ${cardVariant}` : ''}`}
              data-card
              data-filters={JSON.stringify(filters)}
              data-sort={JSON.stringify(sortKey)}
            >
              {cardVariant === 'vcard--duo' ? (
                <div class="vcard__media">
                  <div class="vcard__strip">
                    {item.media.slice(0, 2).map((src, n) => (
                      <div class="vcard__frame media">
                        <Image
                          src={resolveImage(src)}
                          alt={`${item.name} — фото ${n + 1}`}
                          widths={[360, 560, 800]}
                          sizes={sizes}
                          loading="lazy"
                          decoding="async"
                        />
                      </div>
                    ))}
                  </div>

                  <button class="save" type="button" data-save={saveData} aria-pressed="false" aria-label="В избранное">
                    <Icon name="heartOutline" />
                  </button>
                </div>
              ) : (
                <PhotoRail
                  photos={item.media}
                  alt={item.name}
                  href={`/moskva/ploshchadki/${item.slug}/`}
                  sizes={sizes}
                  widths={cardVariant === 'vcard--hero' ? [640, 1000, 1600, 2000] : [360, 560, 800, 1100]}
                >
                  <button class="save" type="button" data-save={saveData} aria-pressed="false" aria-label="В избранное">
                    <Icon name="heartOutline" />
                  </button>
                </PhotoRail>
              )}

              <!-- Подпись плотная, как у маркетплейса: цена, имя с рейтингом,
                   город. Только то, что решает при выборе площадки — тип
                   и вместимость из подписи убраны, фото без затемнения и
                   без цены поверх кадра: цена только здесь, одним местом. -->
              <div class="vcard__body">
                <p class="vcard__price">{item.avgCheck}</p>
                <div class="vcard__top">
                  <h2 class="vcard__name">
                    <a href={`/moskva/ploshchadki/${item.slug}/`}>{item.name}</a>
                  </h2>
                  <span class="vcard__rate" aria-label={`Рейтинг ${item.rating}`}>★ {item.rating.toFixed(1)}</span>
                </div>
                <p class="vcard__meta t-small">{item.city}</p>
              </div>
            </article>
          );
        })}
      </div>

      <p class="empty t-small" data-results-empty hidden>
        По заданным фильтрам площадок не нашлось — попробуйте снять часть условий.
      </p>
    </main>
  </div>

  <BottomDock active="venues" />
</Layout>

<style>
  /* ============ КАРКАС ============
     На ПК — колонка настроек слева, каталог справа; отбивка колонки от
     мозаики — вертикальная структурная линия. */
  .layout {
    padding-bottom: calc(var(--safe-b) + 120px);
  }

  @media (min-width: 1024px) {
    .layout {
      display: grid;
      grid-template-columns: var(--sidebar-w) minmax(0, 1fr);
      align-items: start;
    }

    .sidebar {
      padding: 0 var(--s-6) 0 var(--gutter);
      border-right: 1px solid var(--hairline);
    }
  }

  /* ============ СЕТКА-МОЗАИКА ============
     Поля, зазоры и пропорции кадра — ручки каталога из global.css
     (--catalog-*, --card-ratio*). На телефоне они дают ноль по краям:
     карточка встык с краем экрана, между колонками волосок. */
  .wrap {
    max-width: none;
    padding: 0 var(--catalog-edge) 0;
  }

  .vgrid {
    display: grid;
    grid-auto-flow: dense;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--catalog-gap-y) var(--catalog-gap-x);
  }

  @media (min-width: 640px) {
    .vgrid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  @media (min-width: 1440px) {
    .vgrid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }

  .vcard--duo,
  .vcard--wide { grid-column: span 2; }

  .vcard--hero { grid-column: 1 / -1; }

  /* Карточка подменяет себе пропорцию кадра — дальше её читают и рельс
     PhotoRail, и кадры дуо-карточки. Большой кадр на две колонки держит
     высоту ряда у соседей, витринная во всю ширину — витрина раздела. */
  .vcard--wide { --card-ratio: var(--card-ratio-wide); }
  .vcard--hero { --card-ratio: var(--card-ratio-hero); }

  .empty { padding: var(--s-7) var(--catalog-pad); }
  .empty[hidden] { display: none; }

  [data-card].is-hidden { display: none; }

  /* ============ КАРТОЧКА ============ */
  .vcard {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    min-width: 0;
  }

  .vcard__media { position: relative; }

  /* Без тёмного градиента снизу — цена ушла в подпись под кадром,
     на самом фото остаётся только сердце (у него своя тень, .veil
     ему не нужен). */
  .vcard :global(.veil) { display: none; }

  /* Дуо-карточка: два кадра видны сразу, без свайпа. Пропорция и зазор —
     те же ручки каталога, что у остальных карточек ряда */
  .vcard__strip {
    display: flex;
    gap: var(--catalog-gap-x);
  }

  .vcard__frame {
    flex: 1 1 0;
    aspect-ratio: var(--card-ratio);
    background: var(--surface-dim);
  }

  .vcard__frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ============ ПОДПИСЬ ПОД ФОТО ============
     Кадр идёт в край экрана, текст — нет: своё поле подписи держит
     --catalog-pad (на планшете и шире он ноль, поля даёт сама сетка).
     Строки подписи стоят плотно, как у маркетплейса: без воздуха между
     ценой, именем и характеристиками — карточка читается одним блоком. */
  .vcard__body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-inline: var(--catalog-pad);
  }

  .vcard__price {
    font-size: var(--fs-body);
    font-weight: var(--w-medium);
  }

  .vcard__top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-3);
  }

  /* На телефоне имя в кегле корпуса: h3 (21px) в колонке 190px ломал
     «Усадьба Дубровицы» на две строки и раздувал подпись. */
  .vcard__name {
    font-size: var(--fs-body);
    font-weight: var(--w-head);
    line-height: 1.2;
  }

  .vcard__name a { text-decoration: none; }

  .vcard__rate {
    font-size: var(--fs-caption);
    font-weight: var(--w-medium);
    flex-shrink: 0;
  }

  .vcard__meta { font-size: var(--fs-caption); }

  @media (min-width: 640px) {
    .vcard__name { font-size: var(--fs-h3); line-height: 1.15; }
    .vcard__rate { font-size: var(--fs-small); }
    .vcard__meta { font-size: var(--fs-small); }
  }

  /* Сердце на фото: без подложек и обводок, тень отделяет от кадра */
  .save {
    position: absolute;
    top: var(--s-3);
    right: var(--s-3);
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 0;
    background: none;
    color: var(--white);
    cursor: pointer;
    filter: drop-shadow(0 1px 8px rgb(0 0 0 / 0.45));
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .save :global(svg) { width: 24px; height: 24px; }
  .save:active { transform: scale(0.85); }
  /* Сердце Solar: контур — «не в избранном», заливка тем же цветом —
     «сохранено». Правило бьёт по внутреннему path (у него fill="none"). */
  .save[aria-pressed='true'] :global(svg > *) { fill: currentColor; }

  /* ============ РЕКЛАМНАЯ КАРТОЧКА: во всю ширину ============ */
  .vcard--ad {
    grid-column: 1 / -1;
    border-radius: var(--radius-tile);
    overflow: hidden;
  }

  .vcard__ad {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--s-3);
    padding: var(--s-5);
    min-height: 220px;
  }

  .vcard__ad-tag { opacity: 0.7; }

  .vcard__ad-title {
    font-size: var(--fs-h2);
    font-weight: var(--w-head);
    line-height: 1.08;
  }

  .vcard__ad .pill { align-self: flex-start; margin-top: var(--s-2); }
</style>

<script>
  import { toggleFavorite, isFavorited, type FavoriteItem } from '../../../lib/favorites';

  // Фильтрация и шторка — внутри FilterSheet.astro, сортировка — в
  // FilterBar.astro; точки-индикаторы и автолистание — в PhotoRail.astro.
  // Здесь только избранное.

  // Избранное: сохраняется в общее хранилище, читается разделом «Избранное»
  document.querySelectorAll<HTMLButtonElement>('[data-save]').forEach((btn) => {
    const item = JSON.parse(btn.dataset.save!) as FavoriteItem;
    btn.setAttribute('aria-pressed', String(isFavorited(item.id)));
    btn.addEventListener('click', () => {
      btn.setAttribute('aria-pressed', String(toggleFavorite(item)));
    });
  });
</script>
