---
// КАТАЛОГ ПЛОЩАДОК (раздел 2 основного меню).
// Тот же паттерн, что у «Специалистов» (podryadchiki/vedushchie): полоса
// чипов над каталогом (FilterBar) и шторка фильтров снизу (FilterSheet),
// мозаика карточек — нормальная (1 колонка) и wide (2 колонки, один
// большой кадр). Первые два ряда всегда обычные: крупные карточки идут
// дальше по ленте (см. PLAIN_HEAD ниже). Внутри карточки кадры листаются
// свайпом — мобильный способ смотреть несколько фото.
import Layout from '../../../layouts/Layout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import BottomDock from '../../../components/BottomDock.astro';
import FilterBar from '../../../components/FilterBar.astro';
import FilterSheet from '../../../components/FilterSheet.astro';
import ScopePicker from '../../../components/ScopePicker.astro';
import PhotoRail from '../../../components/PhotoRail.astro';
import VenueMap from '../../../components/VenueMap.astro';
import Icon from '../../../components/Icon.astro';
import { FEED, VENUE_FILTERS, type FeedVenue } from '../../../data/feed';
import { IMG_WIDTHS } from '../../../lib/images';
import { countOptions } from '../../../lib/filter-counts';
import { venueMapPoints } from '../../../lib/map-points';

// Бакеты для диапазонных фильтров — считаются на сборке (см. тот же приём
// в podryadchiki/vedushchie/index.astro).
function capacityBucket(max: number): string {
  if (max <= 80) return '0-80';
  if (max <= 120) return '80-120';
  return '120+';
}

function checkBucket(from: number): string {
  if (from < 5000) return '0-5';
  if (from < 7000) return '5-7';
  if (from < 9000) return '7-9';
  return '9+';
}

// ============ МОЗАИКА БЕЗ ДЫР ============
// wide и duo — на две колонки (см. алгоритм подробно в
// podryadchiki/vedushchie/index.astro). Индекс считаем только по площадкам —
// рекламная карточка в мозаику вариантов не участвует и в фильтрации тоже
// (всегда видна).
//
// ВИТРИННОЙ КАРТОЧКИ ВО ВСЮ ШИРИНУ БОЛЬШЕ НЕТ: на телефоне она занимала
// экран целиком, а название площадки и цена уходили за сгиб.
// РАЗГОН: первые два ряда — ровная сетка из обычных вертикальных карточек,
// крупные идут только дальше. Каталог должен с первого экрана показать,
// что это каталог: несколько площадок рядом, у каждой название и цена,
// их можно сравнивать глазами. Крупный кадр в самом верху занимал почти
// весь экран телефона и читался как случайная фотография, а не как выдача.
// Дальше по ленте широкая нужна — она и даёт мозаике ритм.
//
// «ДУО» (два кадра рядом в одной широкой карточке) СНЯТО (заказчик, 17.09):
// на телефоне это читалось как две карточки без подписей, и кадры дуо
// не были ссылками — нажатие на фото никуда не вело. Широкая карточка —
// всегда ОДИН большой кадр с рельсом и ссылкой, как у обычной. Одна на
// пять карточек: 1 широкая + 4 обычных = ровно три ряда без дыр.
const PLAIN_HEAD = 4;

type CardVariant = '' | 'vcard--wide';
function variant(i: number): CardVariant {
  if (i < PLAIN_HEAD) return '';
  return i % 5 === 2 ? 'vcard--wide' : '';
}

// Значения фильтра карточки — одним местом: и в data-filters, и в счётчики чипов
const filtersOf = (item: FeedVenue) => ({
  type: item.type,
  city: item.city,
  capacity: capacityBucket(item.capacityMax),
  // без открытого прайса карточка в бакеты чека не попадает
  avgCheck: item.checkFrom ? checkBucket(item.checkFrom) : '',
});

let venueIndex = 0;
const venues = FEED.filter((item): item is FeedVenue => item.kind === 'venue');
const counts = countOptions(VENUE_FILTERS, venues.map(filtersOf));

// Точки для карты: только площадки, которым проставлены координаты
const mapPoints = venueMapPoints();

---

<Layout
  title="Свадебные площадки Москвы и Подмосковья — WED Secrets"
  description="Каталог свадебных площадок: залы, лофты, усадьбы и террасы Москвы и Московской области с рейтингом, отзывами и ценами."
>
  <SiteHeader />

  <ScopePicker
    title="Площадки"
    active="ploshchadki"
    cityGroup={VENUE_FILTERS.find((g) => g.key === 'city')}
  >
    <!-- Переключатель вида: сетка ↔ карта. Действие, а не выбор, — поэтому
         .pill рядом с чипом локации. Ростом и кеглем — как соседний чип
         (.pill--icon), со знаком карты: мелкая .pill--sm без иконки в этом
         ряду читалась приступкой к чипу, а не кнопкой.
         Обе подписи стоят в разметке, видимую выбирает состояние
         aria-pressed — скрипту остаётся переключить один атрибут, и
         иконку не приходится каждый раз перерисовывать из JS. -->
    <button class="pill pill--icon vmap-btn" type="button" slot="actions" data-map-toggle aria-pressed="false">
      <span class="vmap-btn__off">
        <Icon name="map" />
        На карте
      </span>
      <span class="vmap-btn__on">
        <Icon name="list" />
        Списком
      </span>
    </button>
  </ScopePicker>

  <!-- ФИЛЬТРЫ: полоса чипов над каталогом; вся настройка — в шторке снизу -->
  <FilterBar groups={VENUE_FILTERS} counts={counts} />

  <div class="layout">
    <!-- ШТОРКА ФИЛЬТРОВ: на телефоне всплывает снизу, на ПК — эта же
         разметка стоит постоянной колонкой слева (.sheet--dock) -->
    <aside class="sidebar">
      <FilterSheet groups={VENUE_FILTERS} counts={counts} noun={['площадка', 'площадки', 'площадок']} sortable />
    </aside>

    <!-- СЕТКА: мозаика без дыр, фото — главное. Без анимации появления:
         каталог листается спокойно, карточки стоят на месте. -->
    <main class="wrap">
      <!-- КАРТА: тот же набор площадок, что и в сетке (фильтры карта
           повторяет). Скрыта до нажатия «На карте» — пока её не открыли,
           скрипт Яндекса не грузится вовсе.
           КАРТА ЗАНИМАЕТ ЭКРАН ЦЕЛИКОМ и подменяет выдачу. Пробовали
           иначе — карта сверху, карточки лентой под ней (реф. ЦИАН):
           на телефоне это дало половину карты и полоску обрезанных
           карточек снизу, то есть ни карты, ни выдачи. На узком экране
           выбирать по карте и листать карточки — два разных занятия,
           и делить между ними один экран нечем. -->
      <section class="mapview" data-map-view hidden>
        <VenueMap points={mapPoints} size="screen" />
      </section>

      <div class="vgrid" data-sort-grid>
        {FEED.map((item) => {
          if (item.kind === 'ad') {
            return (
              <article class="vcard vcard--ad theme-dark">
                <div class="vcard__ad">
                  <p class="t-caption vcard__ad-tag">Реклама</p>
                  <h2 class="vcard__ad-title">{item.title}</h2>
                  <p class="t-small">{item.note}</p>
                  <a class="pill" href={item.href}>Разместить площадку</a>
                </div>
              </article>
            );
          }

          const cardVariant = variant(venueIndex);
          // Первый ряд (2 колонки на телефоне) — LCP каталога: первый кадр
          // без lazy и с fetchpriority="high", как у доски главной.
          const firstRow = venueIndex < 2;
          venueIndex += 1;
          const filters = filtersOf(item);
          const sortKey = { price: item.checkFrom ?? Number.MAX_SAFE_INTEGER, rating: item.rating };

          const sizes =
            cardVariant === 'vcard--wide'
              ? '(min-width: 1440px) 50vw, (min-width: 640px) 66vw, 100vw'
              : '(min-width: 1440px) 25vw, (min-width: 640px) 33vw, 50vw';

          return (
            <article
              class={`vcard${cardVariant ? ` ${cardVariant}` : ''}`}
              data-card
              data-slug={item.slug}
              data-filters={JSON.stringify(filters)}
              data-sort={JSON.stringify(sortKey)}
            >
              <PhotoRail
                photos={item.media}
                alt={item.name}
                href={`/moskva/ploshchadki/${item.slug}/`}
                sizes={sizes}
                widths={IMG_WIDTHS.card}
                priority={firstRow}
              />

              <!-- Подпись по принципу близости: имя и город — одно целое
                   (город вплотную под именем), рейтинг справа на строке имени,
                   цена крупно под ними. Без воздуха между строками: карточка
                   читается одним блоком. Тип и вместимость убраны — при
                   выборе не решают; цена только здесь, поверх фото её нет. -->
              <div class="vcard__body">
                <div class="vcard__top">
                  <div class="vcard__title">
                    <h2 class="vcard__name">
                      <a href={`/moskva/ploshchadki/${item.slug}/`}>{item.name}</a>
                    </h2>
                    <p class="vcard__meta">{item.city}</p>
                  </div>
                  <span class="vcard__rate" aria-label={`Рейтинг ${item.rating}`}>★ {item.rating.toFixed(1)}</span>
                </div>
                <!-- Сердца в подписи НЕТ: лайк в каталоге снят (правило
                     проекта — знака «в избранное» на карточке выдачи не
                     держим, он есть только в самой карточке). -->
                {item.checkFrom ? (
                  <p class="vcard__price">{item.avgCheck}</p>
                ) : (
                  /* без прайса: не цифра — значит не кегль цены, а метка */
                  <p class="vcard__tag"><span class="chip chip--tag">{item.avgCheck}</span></p>
                )}
              </div>
            </article>
          );
        })}
      </div>

      <p class="empty t-small" data-results-empty hidden>
        По заданным фильтрам площадок не нашлось — попробуйте снять часть условий.
      </p>
    </main>
  </div>

  <BottomDock active="venues" />
</Layout>

<style>
  /* ============ КАРКАС ============
     На ПК — колонка настроек слева, каталог справа; отбивка колонки от
     мозаики — вертикальная структурная линия. */
  .layout {
    padding-bottom: var(--dock-space);
  }

  @media (min-width: 1024px) {
    .layout {
      display: grid;
      grid-template-columns: var(--sidebar-w) minmax(0, 1fr);
      align-items: start;
    }

    .sidebar {
      padding: 0 var(--s-6) 0 var(--gutter);
      border-right: 1px solid var(--hairline);
    }
  }

  /* ============ СЕТКА-МОЗАИКА ============
     Поля, зазоры и пропорции кадра — ручки каталога из global.css
     (--catalog-*, --card-ratio*). На телефоне они дают ноль по краям:
     карточка встык с краем экрана, между колонками волосок. */
  .wrap {
    max-width: none;
    padding: 0 var(--catalog-edge) 0;
  }

  .vgrid {
    display: grid;
    grid-auto-flow: dense;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--catalog-gap-y) var(--catalog-gap-x);
  }

  @media (min-width: 640px) {
    .vgrid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  @media (min-width: 1440px) {
    .vgrid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }

  .vcard--wide { grid-column: span 2; }

  /* Карточка подменяет себе пропорцию кадра — дальше её читает рельс
     PhotoRail. Большой кадр на две колонки держит высоту ряда у соседей. */
  .vcard--wide { --card-ratio: var(--card-ratio-wide); }

  .empty { padding: var(--s-7) var(--catalog-pad); }
  .empty[hidden] { display: none; }

  /* Подписи переключателя вида лежат обе, показывается одна — по
     aria-pressed (тот же приём, что у кнопки избранного). Внутренний
     span держит строку «иконка + слово» сам: у .pill--icon флекс
     на кнопке, а видимых детей у неё всегда ровно один. */
  /* Кнопка не сжимается: место в строке уступает чип локации (см. ScopePicker) */
  .vmap-btn { flex: none; }

  .vmap-btn__off,
  .vmap-btn__on {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
  }

  .vmap-btn__on { display: none; }
  .vmap-btn[aria-pressed='true'] .vmap-btn__on { display: inline-flex; }
  .vmap-btn[aria-pressed='true'] .vmap-btn__off { display: none; }

  /* Режим «На карте»: карта встаёт на место сетки и занимает экран.
     Липкая — чтобы при прокрутке полоса фильтров ушла наверх, а карта
     осталась на месте и добрала высоту до целого экрана. */
  .mapview[hidden] { display: none; }
  .vgrid[hidden] { display: none; }

  .mapview {
    position: sticky;
    top: 0;
    z-index: 2;
    background: var(--bg);
  }

  [data-card].is-hidden { display: none; }

  /* ============ КАРТОЧКА ============ */
  .vcard {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    min-width: 0;
  }

  .vcard__media { position: relative; }

  /* Без тёмного градиента снизу — цена ушла в подпись под кадром,
     на самом фото остаётся только сердце (у него своя тень, .veil
     ему не нужен). */
  .vcard :global(.veil) { display: none; }

  /* ============ ПОДПИСЬ ПОД ФОТО ============
     Кадр идёт в край экрана, текст — нет: своё поле подписи держит
     --catalog-pad (на планшете и шире он ноль, поля даёт сама сетка).
     Строки подписи стоят плотно, как у маркетплейса: без воздуха между
     ценой, именем и характеристиками — карточка читается одним блоком. */
  .vcard__body {
    display: flex;
    flex-direction: column;
    gap: 0;
    padding-inline: var(--catalog-pad);
  }

  /* Имя + город слева, рейтинг справа на строке имени. Рейтинг сидит
     по первой строке (flex-start), а не по нижней линии: при переносе
     имени на две строки он не уезжает вниз к городу. */
  .vcard__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--s-3);
  }

  .vcard__title { min-width: 0; }

  /* На телефоне имя в кегле корпуса: h3 (21px) в колонке 190px ломал
     «Усадьба Дубровицы» на две строки и раздувал подпись. */
  .vcard__name {
    font-size: var(--fs-body);
    font-weight: var(--w-head);
    line-height: 1.1;
  }

  .vcard__name a { text-decoration: none; }

  /* Город вплотную под именем — одна смысловая группа, зазор нулевой */
  .vcard__meta {
    font-size: var(--fs-caption);
    line-height: 1.15;
  }

  .vcard__rate {
    flex-shrink: 0;
    padding-top: 0.15em; /* оптически на строке имени, кегль у него меньше */
    font-size: var(--fs-caption);
    font-weight: var(--w-medium);
  }

  /* Цена — крупно, но с минимальным отрывом от группы «имя + город» */
  .vcard__price {
    margin-top: 2px;
    font-size: var(--fs-h3);
    font-weight: var(--w-head);
    line-height: 1;
    letter-spacing: -0.01em;
  }

  .vcard__tag { margin-top: 4px; }

  @media (min-width: 640px) {
    .vcard__name { font-size: var(--fs-h3); line-height: 1.05; }
    .vcard__meta { font-size: var(--fs-small); line-height: 1.1; }
    .vcard__rate { font-size: var(--fs-small); padding-top: 0.2em; }
    /* цена сразу под городом, без отрыва: крупный кегль сам даёт воздух */
    .vcard__price { font-size: var(--fs-h2); margin-top: 0; }
  }

  /* ============ РЕКЛАМНАЯ КАРТОЧКА: во всю ширину ============ */
  .vcard--ad {
    grid-column: 1 / -1;
    border-radius: var(--radius-tile);
    overflow: hidden;
  }

  .vcard__ad {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--s-3);
    padding: var(--s-5);
    min-height: 220px;
  }

  .vcard__ad-tag { opacity: 0.7; }

  .vcard__ad-title {
    font-size: var(--fs-h2);
    font-weight: var(--w-head);
    line-height: 1.08;
  }

  .vcard__ad .pill { align-self: flex-start; margin-top: var(--s-2); }
</style>

<script>
  // Фильтрация и шторка — внутри FilterSheet.astro, сортировка — в
  // FilterBar.astro; точки-индикаторы и автолистание — в PhotoRail.astro.

  // Вид «На карте»: карта подменяет мозаику, фильтры и сортировка остаются
  // на месте и продолжают работать — карта повторяет выдачу (см. VenueMap).
  const mapToggle = document.querySelector<HTMLButtonElement>('[data-map-toggle]');
  const mapView = document.querySelector<HTMLElement>('[data-map-view]');
  const grid = document.querySelector<HTMLElement>('[data-sort-grid]');

  if (mapToggle && mapView && grid) {
    mapToggle.addEventListener('click', () => {
      const showMap = mapView.hidden;
      mapView.hidden = !showMap;
      grid.hidden = showMap;
      // Подпись и знак меняет CSS по aria-pressed — обе строки уже в
      // разметке (см. .vmap-btn). Раньше здесь стоял textContent, и он
      // вместе с подписью вынес бы из кнопки иконку.
      mapToggle.setAttribute('aria-pressed', String(showMap));
      if (showMap) mapView.querySelector('[data-venue-map]')?.dispatchEvent(new Event('vmap:show'));
    });

    // Пришли кнопкой «На карте» со страницы площадки (?karta=<slug>):
    // сразу вид карты, наведённой на эту площадку (фокус читает VenueMap).
    const focus = new URLSearchParams(location.search).get('karta');
    const mapRoot = mapView.querySelector<HTMLElement>('[data-venue-map]');
    if (focus && mapRoot) {
      mapRoot.dataset.focus = focus;
      mapToggle.click();
    }
  }
</script>
