---
// ХАБ РАЗДЕЛА «СПЕЦИАЛИСТЫ» — корневая страница /moskva/podryadchiki/.
// До неё все 19 направлений жили только в горизонтальной полосе CategoryNav
// (в кадр попадает 3-4 пилюли из 19), а у самого раздела не было корневого
// URL: и док, и главная вели сразу в «Ведущих». Хаб решает два дела —
// показывает весь список направлений разом и становится SEO-узлом,
// который перелинковывает категории между собой.
//
// Направления сгруппированы (SPECIALIST_GROUPS): сплошной список из 19
// плиток не читается, а по группам человек сразу находит «кто снимает»
// или «кто оформляет». Плитки без фото сознательно: кадры есть только
// у ведущих, а смесь «часть с фото, часть без» рвёт ряд. Язык блока —
// типографика и инверсия на ховере, как в BottomDock и CategoryNav.
import Layout from '../../../layouts/Layout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import BottomDock from '../../../components/BottomDock.astro';
import {
  SPECIALIST_CATEGORIES,
  SPECIALIST_GROUPS,
  SPECIALISTS_BY_CATEGORY,
} from '../../../data/specialists';

function plural(n: number): string {
  const mod10 = n % 10;
  const mod100 = n % 100;
  if (mod10 === 1 && mod100 !== 11) return 'анкета';
  if (mod10 >= 2 && mod10 <= 4 && (mod100 < 12 || mod100 > 14)) return 'анкеты';
  return 'анкет';
}

const bySlug = new Map(SPECIALIST_CATEGORIES.map((c) => [c.slug, c]));

// Счётчик берётся из данных: как только в SPECIALISTS_BY_CATEGORY появится
// массив для категории, цифра встанет сама — разметку править не нужно.
function tile(slug: string) {
  const cat = bySlug.get(slug)!;
  const count = SPECIALISTS_BY_CATEGORY[slug]?.length ?? 0;
  return {
    ...cat,
    note: count ? `${count} ${plural(count)}` : 'Скоро',
    live: count > 0,
  };
}

const groups = SPECIALIST_GROUPS.map((g) => ({
  ...g,
  tiles: g.categories.filter((slug) => bySlug.has(slug)).map(tile),
})).filter((g) => g.tiles.length > 0);

// Страховка от потери: категория, забытая в SPECIALIST_GROUPS, всё равно
// попадает на страницу отдельным рядом, а не исчезает из навигации
const grouped = new Set(SPECIALIST_GROUPS.flatMap((g) => g.categories));
const rest = SPECIALIST_CATEGORIES.filter((c) => !grouped.has(c.slug)).map((c) => tile(c.slug));
if (rest.length) groups.push({ key: 'rest', label: 'Ещё направления', categories: [], tiles: rest });
---

<Layout
  title="Свадебные специалисты и подрядчики в Москве и области — WED Secrets"
  description={`${SPECIALIST_CATEGORIES.length} направлений подрядчиков на свадьбу: ведущие, диджеи, фотографы, декораторы, кейтеринг и другие. Выберите направление и подберите специалиста по своим параметрам.`}
>
  <SiteHeader />

  <header class="hub-head">
    <h1 class="t-h1">Специалисты</h1>
    <p class="t-lead hub-head__lead">
      {SPECIALIST_CATEGORIES.length}&nbsp;направлений — от&nbsp;ведущего и&nbsp;фотографа
      до&nbsp;кавер-группы и&nbsp;спецэффектов. Соберите команду свадьбы целиком.
    </p>
  </header>

  {groups.map((g) => (
    <section class="hub" aria-labelledby={`g-${g.key}`}>
      <header class="hub__head">
        <h2 class="hub__title" id={`g-${g.key}`}>{g.label}</h2>
        <p class="hub__count t-caption">{g.tiles.length}</p>
      </header>

      <div class="hub__grid" data-reveal-group>
        {g.tiles.map((it) => (
          <a
            class:list={['hub__cell', { 'theme-accent': it.live }]}
            href={`/moskva/podryadchiki/${it.slug}/`}
          >
            <span class="hub__name">{it.label}</span>
            <span class="hub__note t-caption">{it.note}</span>
          </a>
        ))}
      </div>
    </section>
  ))}

  <div class="hub__tail"></div>

  <BottomDock active="vendors" />
</Layout>

<style>
  .hub-head {
    padding: var(--s-6) var(--gutter) var(--s-6);
  }

  .hub-head__lead {
    margin-top: var(--s-4);
  }

  .hub {
    padding: 0 var(--gutter) var(--section-gap-tight);
  }

  /* Хвост под последней группой: место под плавающий док */
  .hub__tail {
    height: calc(var(--safe-b) + 80px);
  }

  /* Заголовок группы со счётчиком направлений: цифра — служебная метка,
     поэтому мелкая и рядом с названием, а не отдельной строкой */
  .hub__head {
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
    margin-bottom: var(--s-4);
  }

  .hub__title {
    font-size: var(--fs-h2);
    font-weight: var(--w-head);
    line-height: var(--lh-heading);
    letter-spacing: var(--ls-display);
  }

  .hub__count { font-weight: var(--w-medium); }

  /* Сетка плиток: тот же ритм зазоров, что у сетки карточек каталога */
  .hub__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(8px, 1vw, 12px);
  }

  @media (min-width: 640px) {
    .hub__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  @media (min-width: 1024px) {
    .hub__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }

  /* Плитка: название прижато к низу, статус под ним —
     ряд читается как указатель, а не как набор кнопок */
  .hub__cell {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--s-2);
    min-height: clamp(104px, 13vw, 132px);
    padding: var(--s-4);
    background: var(--surface);
    color: var(--ink);
    text-decoration: none;
    border-radius: var(--radius-tile);
    transition: background var(--dur-fast) var(--ease-out),
                color var(--dur-fast) var(--ease-out);
  }

  .hub__name {
    font-size: var(--fs-h3);
    font-weight: var(--w-head);
    line-height: 1.15;
    letter-spacing: var(--ls-display);
  }

  /* Ховер — та же инверсия в чернила, что у пилюль и дока:
     живая (алая) плитка ведёт себя так же, без отдельного правила */
  @media (hover: hover) {
    .hub__cell:hover {
      background: var(--ink);
      color: var(--surface);
    }
  }
</style>
