---
// ХАБ РАЗДЕЛА «СПЕЦИАЛИСТЫ»: экран с плитками разделов перед каталогом.
// Из нижнего дока человек попадает сюда, выбирает раздел («Фото и видео»,
// «Музыка и вокал») и проваливается в каталог его первого направления;
// дальше направления переключает полоса CategoryNav внутри каталога —
// второй уровень навигации здесь не дублируем. Раздел из одной категории
// («Ведущие», «Декораторы», «Авто и трансфер») ведёт сразу в каталог,
// вкладок там нет вовсе (CategoryNav сам не рисует второй ряд).
//
// Разделы — из данных (SPECIALIST_GROUPS, источник правды), числа считаются
// на сборке из SPECIALISTS_BY_CATEGORY: руками ничего не пишется.
import Layout from '../../../layouts/Layout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import BottomDock from '../../../components/BottomDock.astro';
import {
  SPECIALIST_CATEGORIES,
  SPECIALIST_GROUPS,
  SPECIALISTS_BY_CATEGORY,
} from '../../../data/specialists';
import { withCount, type PluralForms } from '../../../lib/plural';

// Одна строка «что внутри» — по ключу раздела, чтобы порядок и состав
// разделов менялись в данных, а текст не рассыпался.
const BLURBS: Record<string, string> = {
  organizacija: 'План дня и человек, который держит его на площадке',
  vedushchie: 'Тот, кто ведёт вечер и говорит с гостями за вас',
  dekor: 'Оформление зала, цветы и всё, что видно на фото',
  'foto-video': 'Фото, видео и рилсы — всё, что останется, когда торт съеден',
  kuhnya: 'Выездной кейтеринг и торт, ради которого ждут финала',
  obraz: 'Утро невесты: причёска, макияж и образ на весь день',
  muzyka: 'Диджей, кавер-группа, вокал и живые инструменты',
  oborudovanie: 'Звук, свет и спецэффекты, которых нет на площадке',
  shou: 'Танец, номера и всё, после чего гости не сядут',
  avto: 'Машина молодых и трансфер гостей между точками',
};

const VENDORS: PluralForms = ['подрядчик', 'подрядчика', 'подрядчиков'];

const labels = new Map(SPECIALIST_CATEGORIES.map((c) => [c.slug, c.label]));

const tiles = SPECIALIST_GROUPS.map((g) => {
  const cats = g.categories.filter((slug) => labels.has(slug));
  // Подрядчик в двух направлениях одного раздела — один человек, считаем по slug
  const vendors = new Set<string>();
  for (const slug of cats) for (const s of SPECIALISTS_BY_CATEGORY[slug] ?? []) vendors.add(s.slug);
  return {
    key: g.key,
    name: g.label,
    blurb: BLURBS[g.key] ?? '',
    href: `/moskva/podryadchiki/${cats[0]}/`,
    capsule: vendors.size === 0 ? 'скоро' : withCount(vendors.size, VENDORS),
  };
});
---

<Layout
  title="Свадебные специалисты Москвы и области — WED Secrets"
  description="Организаторы, ведущие, декораторы, фотографы, кейтеринг, музыка, шоу и трансфер на свадьбу в Москве и Московской области — по разделам, с ценами и портфолио."
>
  <SiteHeader />

  <main class="hub">
    <header class="hub__head">
      <h1 class="t-h1">Специалисты</h1>
      <p class="hub__lead">Команда свадьбы по разделам: выберите, кто нужен, — внутри направления и фильтры.</p>
    </header>

    <ul class="hub__grid" aria-label="Разделы специалистов">
      {tiles.map((t) => (
        <li>
          <a class="gtile" href={t.href} aria-label={`${t.name} — ${t.capsule}`}>
            <span class="gtile__top">
              <span class="gtile__go" aria-hidden="true">↗</span>
            </span>

            <span class="gtile__body">
              <span class="gtile__name">{t.name}</span>
              <span class="gtile__blurb">{t.blurb}</span>
              <span class="gtile__count" aria-hidden="true">{t.capsule}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </main>

  <BottomDock active="vendors" />
</Layout>

<style>
  /* Поля до края экрана держит сама сетка (--edge-gap), как у доски
     кадров: хаб — такая же плиточная поверхность. */
  .hub {
    padding-block: var(--s-6) var(--dock-space);
  }

  .hub__head {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    margin-bottom: var(--s-5);
    padding-inline: var(--gutter);
  }

  /* Мера в ch считается от кегля САМОГО элемента: --measure-lead подобран
     под крупный лид, а тут кегль мелкий — те же 52ch дали бы колонку
     заметно уже задуманной. Для текста этого кегля мера текстовая. */
  .hub__lead {
    margin: 0;
    max-width: var(--measure-text);
    font-size: var(--fs-small);
  }

  /* Сетка плиток: зазор и поле от края — те же, что у доски кадров
     (--pin-gap / --edge-gap), но БЕЗ пинтерестовской череды: колонки
     равные, ряды выровнены по одной линии. Высоту ряда задаёт самая
     высокая плитка в нём (grid-auto-rows: 1fr), плитки тянутся до неё —
     низ ряда всегда прямой, сколько бы строк ни занял заголовок. */
  .hub__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-rows: 1fr;
    gap: var(--pin-gap);
    padding-inline: var(--edge-gap);
    list-style: none;
    margin: 0;
  }

  @media (min-width: 640px) {
    .hub__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  @media (min-width: 1024px) {
    .hub__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }

  /* БЕЗ ЦВЕТА. Тона --tint-* сняты вслед за плашками главной: остаётся
     палитра проекта — светлая плашка (--surface), чернила, капсула
     на тон гуще. Заливка семантическая, поэтому в тёмной теме плитка
     темнеет сама, руками ничего не красим. */
  .gtile {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--s-5);
    /* Жёсткой пропорции нет намеренно: высоту ряда держит 1fr сетки,
       и aspect-ratio тут с ней спорил бы — плитка вылезала бы из ряда
       ровно настолько, насколько длиннее её заголовок. */
    height: 100%;
    padding: var(--s-4);
    background: var(--surface);
    color: var(--ink);
    border-radius: var(--radius-card);
    text-decoration: none;
  }

  .gtile__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    min-height: var(--entry-knob);
  }

  /* Стрелка-ссылка в кружке, как на плашках главной: приглушена opacity,
     не серым (правило проекта) */
  .gtile__go {
    margin-left: auto;
    width: var(--entry-knob);
    height: var(--entry-knob);
    flex: none;
    border-radius: var(--radius-pill);
    border: var(--entry-knob-line) solid currentColor;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: var(--fs-small);
    line-height: 1;
    opacity: var(--entry-knob-dim);
  }

  .gtile__body {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    min-width: 0;
    /* Набор прижат к низу плитки: ряды выровнены и по верхней линии
       (стрелка), и по нижней — заголовки соседей стоят на одной высоте. */
    margin-top: auto;
  }

  /* Кегль от ширины колонки, не экрана: колонок две уже на телефоне,
     и прежний потолок 30px рвал длинное имя раздела на четыре строки. */
  .gtile__name {
    font-size: clamp(18px, 4.2vw, 24px);
    font-weight: var(--w-head);
    line-height: 1.04;
    letter-spacing: -0.03em;
  }

  /* Меры тут нет намеренно: ширину описанию задаёт сама плитка, а внутри
     текстового модуля мера не дублируется (правило проекта). */
  .gtile__blurb {
    font-size: var(--fs-small);
    line-height: 1.3;
  }

  /* Капсула со счётчиком — плашка на тон гуще самой плитки. Прижата
     влево под текстом, а не растянута строкой. */
  .gtile__count {
    align-self: flex-start;
    margin-top: var(--s-2);
    padding: 6px 12px;
    border-radius: var(--radius-pill);
    background: var(--surface-dim);
    font-size: var(--fs-caption);
    font-weight: var(--w-medium);
    line-height: 1.2;
    white-space: nowrap;
  }

  @media (hover: hover) {
    .gtile__go {
      transition: transform var(--dur-fast) var(--ease-out), opacity var(--dur-fast) var(--ease-out);
    }
    .gtile:hover .gtile__go { transform: translate(3px, -3px); opacity: 1; }
  }
</style>
