---
// ХАБ РАЗДЕЛА «СПЕЦИАЛИСТЫ»: экран с плитками разделов перед каталогом.
// Из нижнего дока человек попадает сюда, выбирает раздел («Фото и видео»,
// «Музыка и вокал») и проваливается в каталог его первого направления;
// дальше направления переключает полоса CategoryNav внутри каталога —
// второй уровень навигации здесь не дублируем. Раздел из одной категории
// («Ведущие», «Декораторы», «Авто и трансфер») ведёт сразу в каталог,
// вкладок там нет вовсе (CategoryNav сам не рисует второй ряд).
//
// Разделы — из данных (SPECIALIST_GROUPS, источник правды), числа считаются
// на сборке из SPECIALISTS_BY_CATEGORY: руками ничего не пишется.
import Layout from '../../../layouts/Layout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import BottomDock from '../../../components/BottomDock.astro';
import {
  SPECIALIST_CATEGORIES,
  SPECIALIST_GROUPS,
  SPECIALISTS_BY_CATEGORY,
} from '../../../data/specialists';
import { withCount, type PluralForms } from '../../../lib/plural';
import CoverTile from '../../../components/CoverTile.astro';
import Icon from '../../../components/Icon.astro';
import { IMG_WIDTHS } from '../../../lib/images';

// Описания «что внутри» с плиток сняты (18.09.2026): плитка — имя раздела
// и счётчик, объяснять состав будет кадр, а не строка текста.
const VENDORS: PluralForms = ['подрядчик', 'подрядчика', 'подрядчиков'];

const labels = new Map(SPECIALIST_CATEGORIES.map((c) => [c.slug, c.label]));

const tiles = SPECIALIST_GROUPS.map((g) => {
  const cats = g.categories.filter((slug) => labels.has(slug));
  // Подрядчик в двух направлениях одного раздела — один человек, считаем по slug
  const vendors = new Set<string>();
  for (const slug of cats) for (const s of SPECIALISTS_BY_CATEGORY[slug] ?? []) vendors.add(s.slug);
  return {
    key: g.key,
    name: g.label,
    cover: g.cover ?? null,
    tone: g.tone ?? null,
    bg: g.bg,
    href: `/moskva/podryadchiki/${cats[0]}/`,
    capsule: vendors.size === 0 ? 'скоро' : withCount(vendors.size, VENDORS),
  };
});
---

<Layout
  title="Свадебные специалисты Москвы и области — WED Secrets"
  description="Организаторы, ведущие, декораторы, фотографы, кейтеринг, музыка, шоу и трансфер на свадьбу в Москве и Московской области — по разделам, с ценами и портфолио."
>
  <SiteHeader />

  <main class="hub">
    <header class="hub__head">
      <h1 class="t-h1">Специалисты</h1>
      <p class="hub__lead">Команда свадьбы по разделам: выберите, кто нужен, — внутри направления и фильтры.</p>
    </header>

    <ul class="hub__grid" aria-label="Разделы специалистов">
      {tiles.map((t, i) => (
        <li>
          {/* Плитка — общий модуль CoverTile: та же разметка, что у входов
              на главной. Обложка снята на однотонном фоне в тон плитки,
              поэтому кадр не лежит прямоугольником, а продолжает плашку. */}
          <CoverTile
            name={t.name}
            href={t.href}
            capsule={t.capsule}
            covers={t.cover ? [t.cover] : []}
            tone={t.tone ?? 'beige'}
            bg={t.bg}
            widths={IMG_WIDTHS.card}
            sizes="(min-width: 1024px) 25vw, (min-width: 640px) 33vw, 50vw"
            eager={i < 4}
          />
        </li>
      ))}
      {/* ПРИГЛАШЕНИЕ ПОДРЯДЧИКАМ (заказчик, 30.09.2026): кружок в общей
          сетке разделов, а не ещё одна большая плитка — он не раздел
          каталога и не должен с ними спорить. Серый круг (--surface, как
          у чипов) с плюсом и подписью, стоит в ячейке по центру.
          Открывает шторку «Вы специалист?» ниже. */}
      <li class="hub__join-cell">
        <button class="hub__join" type="button" data-sheet-open="join">
          <span class="hub__join-plus" aria-hidden="true"><Icon name="plus" /></span>
          <span class="hub__join-title">Вы специалист?</span>
          <span class="hub__join-note">Разместим у нас</span>
        </button>
      </li>
    </ul>
  </main>

  <!-- ШТОРКА «ВЫ СПЕЦИАЛИСТ?». Реестровая .sheet (bindSheet), не своя панель.
       ЗАГЛУШКА (фаза дизайна): заявки от подрядчиков пока никуда не уходят —
       кнопка просто закрывает шторку. TODO: форма/контакт, когда появится
       приём подрядчиков (личный кабинет или менеджер). -->
  <div class="sheet" data-sheet="join">
    <div class="sheet__backdrop" data-sheet-close></div>
    <section class="sheet__panel" role="dialog" aria-modal="true" aria-labelledby="join-title">
      <header class="sheet__head">
        <h2 class="sheet__title" id="join-title">Вы специалист?</h2>
        <button class="icon-btn" type="button" data-sheet-close aria-label="Закрыть">
          <Icon name="close" />
        </button>
      </header>
      <div class="sheet__body" data-lenis-prevent>
        <p class="t-lead">Ведущие, фотографы, декораторы, кейтеринг — если вы делаете свадьбы красиво, давайте к нам.</p>
        <p class="t-small hub__join-text">Разместим вашу карточку в каталоге WED Secrets: портфолио, цены и отзывы — там, где пары Москвы и области выбирают подрядчиков на свою свадьбу.</p>
      </div>
      <footer class="sheet__foot">
        <button class="pill" type="button" data-sheet-close>Оставить заявку</button>
      </footer>
    </section>
  </div>

  <BottomDock active="vendors" />
</Layout>

<style>
  /* Поля до края экрана держит сама сетка (--edge-gap), как у доски
     кадров: хаб — такая же плиточная поверхность. */
  .hub {
    padding-block: var(--s-6) var(--dock-space);
  }

  .hub__head {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    margin-bottom: var(--s-5);
    padding-inline: var(--gutter);
  }

  /* Мера в ch считается от кегля САМОГО элемента: --measure-lead подобран
     под крупный лид, а тут кегль мелкий — те же 52ch дали бы колонку
     заметно уже задуманной. Для текста этого кегля мера текстовая. */
  .hub__lead {
    margin: 0;
    max-width: var(--measure-text);
    font-size: var(--fs-small);
  }

  /* Сетка плиток: зазор и поле от края — те же, что у доски кадров
     (--pin-gap / --edge-gap), но БЕЗ пинтерестовской череды: колонки
     равные, ряды выровнены по одной линии. Высоту ряда задаёт самая
     высокая плитка в нём (align stretch), плитки тянутся до неё —
     низ ряда всегда прямой, сколько бы строк ни занял заголовок. */
  .hub__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    /* Ряды по содержимому, а не 1fr: иначе строка с кружком
       «Вы специалист?» вырастала до высоты плитки. Плитки в ряду всё
       равно тянутся до самой высокой (align stretch), а имя в CoverTile
       держит место под две строки — ряды выходят одной высоты и так. */
    grid-auto-rows: auto;
    gap: var(--pin-gap);
    padding-inline: var(--edge-gap);
    list-style: none;
    margin: 0;
  }

  @media (min-width: 640px) {
    .hub__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  @media (min-width: 1024px) {
    .hub__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }

  /* Ячейка с кружком — во всю строку сетки и своей высоты: при чётном
     числе разделов кружок встаёт один в ряд, и строка высотой с плитку
     оставляла под ним пустой экран. Поэтому строке — высота по кружку
     (grid-row auto, см. .hub__grid), а круг — по центру. */
  .hub__join-cell {
    grid-column: 1 / -1;
    display: grid;
    place-items: center;
    padding-block: var(--s-4);
  }

  .hub__join {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--s-1);
    width: 168px;
    aspect-ratio: 1;
    padding: var(--s-4);
    border: 0;
    border-radius: 50%;
    background: var(--surface);
    color: var(--ink);
    text-align: center;
    cursor: pointer;
    transition: transform var(--dur-fast) var(--ease-out),
                background var(--dur-fast) var(--ease-out);
  }

  .hub__join:active { transform: scale(0.96); }

  @media (hover: hover) {
    .hub__join:hover { background: var(--surface-dim); }
  }

  .hub__join-plus {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    margin-bottom: var(--s-1);
    border-radius: 50%;
    background: var(--ink);
    color: var(--paper);
  }

  .hub__join-plus :global(svg) { width: 20px; height: 20px; }

  .hub__join-title {
    font-size: var(--fs-small);
    font-weight: var(--w-head);
    line-height: 1.15;
  }

  .hub__join-note {
    font-size: var(--fs-caption);
    font-weight: var(--w-medium);
    opacity: 0.6;
  }

  .hub__join-text { margin-top: var(--s-3); }
</style>

<script>
  import { bindSheet } from '../../../lib/sheet';

  const joinSheet = document.querySelector<HTMLElement>('[data-sheet="join"]');
  if (joinSheet) bindSheet(joinSheet);
</script>
