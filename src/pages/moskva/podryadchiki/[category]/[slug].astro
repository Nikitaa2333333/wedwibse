---
// СТРАНИЦА-ВИЗИТКА СПЕЦИАЛИСТА. Сама визитка — компонент SpecialistProfile:
// тем же кодом рисуется превью анкеты до одобрения (/profi/prevyu/).
//
// САЙТ ИЗ БАЗЫ (этап 2, 05.11.2026): страницу рисует сервер в момент открытия
// из живых данных — наши карточки из git, правки владельцев и карточки из
// кабинета (lib/live-data.ts). Правка в кабинете видна через секунды, без
// пересборки сайта. nginx держит готовую страницу ~10 с.
//
// Открывается визитка у тех, у кого есть материал для неё (quote/offers/story),
// а не у всех карточек каталога: пустая страница-визитка хуже её отсутствия.
// Карточка в двух категориях (пара «фото + видео») имеет РОВНО ОДИН адрес —
// по родной categorySlug, дубля под тем же текстом нет.
export const prerender = false;

import SpecialistProfile from '../../../../components/SpecialistProfile.astro';
import { SPECIALISTS_BY_CATEGORY, hasProfile } from '../../../../data/specialists';
import { refreshLive, LIVE_CACHE } from '../../../../lib/live-data';

await refreshLive();
const { category = '', slug = '' } = Astro.params;
const s = (SPECIALISTS_BY_CATEGORY[category] ?? []).find((x) => x.slug === slug && x.categorySlug === category);
// нет карточки (или визитки у неё нет) — честная 404, а не пустая 200
if (!s || !hasProfile(s)) return new Response(null, { status: 404 });
Astro.response.headers.set('cache-control', LIVE_CACHE);
---

<SpecialistProfile s={s} />
