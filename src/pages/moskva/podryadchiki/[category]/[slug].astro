---
// СТРАНИЦА-ВИЗИТКА СПЕЦИАЛИСТА — одна на все 19 категорий (реф. Cineteca
// Milano): крупный кадр + контрастная инфо-плашка с ценой и заявкой.
// Раньше лежала отдельным роутом под ведущих; блоки те же, но всё, чего у
// подрядчика нет, просто не рендерится — цена, рейтинг, отзывы, видео.
//
// Открывается визитка у тех, у кого есть материал для неё (quote/offers),
// а не у всех карточек каталога: пустая страница-визитка хуже её отсутствия.
//
// Карточка, стоящая в двух категориях (пара «фото + видео» — и в
// «Фотографах», и в «Видеографах»), имеет РОВНО ОДИН адрес: путь строится
// по родной categorySlug, дубля страницы под тем же текстом нет.
import { Image } from 'astro:assets';
import Layout from '../../../../layouts/Layout.astro';
import SiteHeader from '../../../../components/SiteHeader.astro';
import BottomDock from '../../../../components/BottomDock.astro';
import PhotoMasonry from '../../../../components/PhotoMasonry.astro';
import Avatar from '../../../../components/Avatar.astro';
import Icon from '../../../../components/Icon.astro';
import HeroActions from '../../../../components/HeroActions.astro';
import HeroStage from '../../../../components/HeroStage.astro';
import { SPECIALISTS_BY_CATEGORY, FILTERS_BY_CATEGORY, type Specialist } from '../../../../data/specialists';
import { reelsOf } from '../../../../data/reels';
import { photoTiles } from '../../../../lib/gallery';
import { resolveImage, favoriteImage, IMG_WIDTHS } from '../../../../lib/images';
import { frameId, isPortrait, isVideo, photosOnly, posterOf } from '../../../../lib/media';

export function getStaticPaths() {
  const seen = new Set<string>();

  return Object.values(SPECIALISTS_BY_CATEGORY)
    .flat()
    // визитка есть у тех, кто дал материал: предложение или список причин
    .filter((s) => s.quote || s.offers)
    .filter((s) => !seen.has(s.slug) && seen.add(s.slug))
    .map((s) => ({ params: { category: s.categorySlug, slug: s.slug }, props: { s } }));
}

const { s } = Astro.props as { s: Specialist };

function labelsFor(groupKey: string, values: string[]): string[] {
  const group = FILTERS_BY_CATEGORY[s.categorySlug]?.find((g) => g.key === groupKey);
  if (!group) return values;
  const map = new Map(group.options.map((o) => [o.value, o.label]));
  return values.map((v) => map.get(v) ?? v);
}

const priceFmt = new Intl.NumberFormat('ru-RU');
const styleLabels = s.styles ? labelsFor('style', s.styles) : [];
const bioParagraphs = s.bio.split('\n\n');

// Строка под ценой собирается из того, что есть: пустых «· ·» не остаётся
const priceFacts = [
  s.priceFrom ? 'за 6 часов работы' : null,
  s.experienceYears ? `${s.experienceYears} лет опыта` : null,
  s.hasOwnDJ ? 'свой диджей' : null,
  s.gender === 'pair' ? 'фото и видео' : null,
].filter(Boolean);

// ПЕРВЫЙ ЭКРАН — общий компонент HeroStage, тот же, что у карточки
// площадки: работа подрядчика во весь экран телефона, на матовом стекле
// внизу портрет, имя, специальность и рейтинг, поверх кадра — кнопки
// «назад · в избранное · поделиться». Условия (цена, заявка) идут сразу
// под ним, при прокрутке.
//
// Кадры отдаём все: по адресу `#foto-<кадр>` из доски главной открывается
// именно тот снимок или ролик, по которому нажали (якорь разбирает сам
// HeroStage). Кадров ровно столько, сколько их уходит в доску главной
// (PER_SPECIALIST в lib/gallery): любой кадр, по которому там можно
// нажать, тут есть. Вся съёмка целиком — ниже, в блоке «Фотографии».
const HERO_PHOTOS = 12;
const reels = reelsOf(s.slug);
const frames = [
  ...new Set([s.photos[0], ...reels.map((r) => r.src), ...s.photos.slice(1, HERO_PHOTOS)]),
];

// sizes галереи — те же колонки, что у доски главной (PhotoMasonry)
const GALLERY_SIZES =
  '(min-width: 1440px) 19vw, (min-width: 1024px) 24vw, (min-width: 640px) 32vw, 48vw';

const priceLabel = s.priceFrom ? `от ${priceFmt.format(s.priceFrom)} ₽` : 'Цена по запросу';
const href = `/moskva/podryadchiki/${s.categorySlug}/${s.slug}/`;

// Лайк у КАЖДОГО ролика: ролик — такая же работа подрядчика, как кадр,
// и сохранять его человек хочет отдельно. Постер прогоняем через
// favoriteImage — в хранилище нужен пережатый URL, не путь из данных.
const reelSaves = new Map(
  await Promise.all(
    reels.map(async (r) => [r.src, JSON.stringify({
      id: `reel:${r.src}`,
      cat: s.categorySlug,
      catLabel: 'Видео',
      name: s.name,
      meta: r.alt,
      price: '',
      img: await favoriteImage(posterOf(r.src)),
      href: `/moskva/podryadchiki/${s.categorySlug}/${s.slug}/`,
    })] as const)
  )
);

const saveData = JSON.stringify({
  id: `${s.categorySlug}:${s.slug}`,
  cat: s.categorySlug,
  catLabel: s.category,
  name: s.name,
  meta: styleLabels[0] || s.tagline,
  price: priceLabel,
  rating: s.rating,
  img: await favoriteImage(s.photos[0]),
  href,
});
---

<Layout
  title={`${s.name} — ${s.category.toLowerCase()} на свадьбу в Москве и области — WED Secrets`}
  description={`${s.name} — ${s.tagline.toLowerCase()}. ${s.category} на свадьбу в Москве и Московской области.`}
>
  <SiteHeader />

  <div class="profile">
    <!-- ГЕРОЙ: инфо-плашка + крупный кадр встык (реф. Cineteca).
         Кнопка «назад» — на кадре, не текстовая крошка на плашке: тот же
         паттерн, что у карточки площадки (см. HeroActions.astro).

         Аватарка стоит над именем: на визитке фотографа весь экран занят
         его работами, и портрет автора — единственное место, где видно,
         с кем человек будет иметь дело. Нет портрета — кружок с
         инициалами, слот остаётся на месте. -->
    <!-- ПЕРВЫЙ ЭКРАН — тот же HeroStage, что у площадки: работа подрядчика
         во весь экран, на стекле внизу портрет, имя, специальность
         и рейтинг. Условия и заявка идут следом, при прокрутке. -->
    <HeroStage frames={frames} alt={s.name}>
      <HeroActions
        slot="actions"
        backHref={`/moskva/podryadchiki/${s.categorySlug}/`}
        backLabel={`К списку «${s.category}»`}
        save={saveData}
      />

      <div class="phero__id">
        <Avatar src={s.avatar} name={s.name} size={44} class="phero__avatar" />
        <div class="phero__title">
          <h1 class="phero__name">{s.name}</h1>
          <p class="phero__tagline">{s.tagline}</p>
        </div>
      </div>

      {s.rating && s.reviews && (
        <a class="phero__rate" href="#otzyvy">★ {s.rating.toFixed(1).replace('.', ',')} · {s.reviews}&nbsp;отзывов</a>
      )}
    </HeroStage>

    <section class="phero">
      <div class="phero__card theme-accent">
        <div class="phero__deal">
          <p class="phero__price">{priceLabel}</p>
          <p class="t-caption phero__price-note">
            {priceFacts.join(' · ')}
          </p>
          <a class="pill pill--lg" href="#zayavka">Оставить заявку</a>
        </div>
      </div>
    </section>

    <!-- О ПОДРЯДЧИКЕ: рассказ о себе и портрет автора целиком.
         В кружок-аватарку идёт кроп по головам и плечам — студийный кадр
         в полный рост на 30–64 px читается пятном; здесь тот же снимок
         показан как он снят. Нет портрета — секция просто текстовая,
         как была. -->
    <section class="pabout">
      <h2 class="t-h2">{s.aboutTitle ?? 'О подрядчике'}</h2>

      <div class="pabout__body">
        {s.portrait && (
          <figure class="pabout__portrait media">
            <Image
              src={resolveImage(s.portrait)}
              alt={`${s.name} — портрет`}
              widths={IMG_WIDTHS.card}
              sizes="(min-width: 900px) 320px, 100vw"
              loading="lazy"
              decoding="async"
            />
          </figure>
        )}

        <div class="pabout__story">
          {bioParagraphs.map((p) => <p class="pabout__text">{p}</p>)}
        </div>
      </div>
    </section>

    <!-- ПОЧЕМУ ВЫБИРАЮТ: причины формулирует сам подрядчик. Заголовок
         пункта — отдельной строкой h3, а не жирной фразой внутри абзаца. -->
    {s.offers && (
      <section class="pwhy">
        <h2 class="t-h2">Почему выбирают</h2>
        <div class="pwhy__grid">
          {s.offers.map((offer) => (
            <article class="pwhy__item">
              <h3 class="pwhy__title">{offer.title}</h3>
              <p class="pwhy__text">{offer.text}</p>
            </article>
          ))}
        </div>
      </section>
    )}

    <!-- ЧТО ВХОДИТ В ПАКЕТ -->
    {s.packageIncludes && (
      <section class="ppack">
        <h2 class="t-h2">Что входит</h2>
        <ul class="ppack__list list">
          {s.packageIncludes.map((item) => <li>{item}</li>)}
        </ul>
      </section>
    )}

    <!-- ГАЛЕРЕЯ: ТА ЖЕ ДОСКА, ЧТО НА ГЛАВНОЙ (PhotoMasonry) — колонки
         одной ширины, каждый кадр в своей настоящей пропорции. Раньше тут
         стояла своя сетка с жёстким aspect-ratio 3/4: каждый снимок
         кропился под чужую рамку, и портфолио подрядчика показывалось
         не так, как те же кадры в ленте главной. -->
    <section class="pgallery">
      <h2 class="t-h2">Фотографии</h2>
      <!-- ВСЯ съёмка сразу, без кнопки «показать ещё»: человек пришёл
           смотреть работы, и прятать половину портфолио незачем. Систему
           это не грузит — картинки ленивые, браузер качает только те, что
           дошли до экрана, в HTML лежит одна разметка. -->
      <PhotoMasonry tiles={photoTiles(photosOnly(s.photos), s.name)} sizes={GALLERY_SIZES} />
    </section>

    <!-- ВИДЕО отдельной секцией у подрядчика с реальными роликами нет:
         они лежат кадрами в первом экране, вперемешку с фотографиями.
         Ниже — старый демо-блок постеров (карточки-заглушки прототипа). -->
    <!-- ВИДЕО: свои ролики подрядчика отдельным рядом — рилсы это то, за
         чем к видеографу и приходят, и искать их вперемешку с фотографиями
         в первом экране человек не станет.
         РОЛИКИ ЗДЕСЬ НЕ АВТОЗАПУСКАЮТСЯ, в отличие от плиток доски: в ряду
         их сразу несколько в кадре, и одновременно играющие ролики
         перебивают друг друга — смотреть невозможно. Поэтому кадр стоит
         постером с кнопкой play, играет ровно тот, который запустили,
         а запуск соседнего останавливает предыдущий. -->
    {reels.length > 0 && (
      <section class="preels">
        <h2 class="t-h2">Видео</h2>
        <div class="preels__rail">
          {reels.map((reel) => (
            <div class="preels__cell">
              <button class="preels__item media" type="button" data-sound-scope data-reel={reel.src} aria-label={`Смотреть: ${reel.alt}`} aria-pressed="false">
                <Image
                  src={resolveImage(posterOf(reel.src))}
                  alt={reel.alt}
                  widths={IMG_WIDTHS.card}
                  sizes="(min-width: 1024px) 240px, 48vw"
                  loading="lazy"
                  decoding="async"
                />
                <video class="preels__video" data-reel-video muted loop playsinline preload="none" aria-hidden="true"></video>
                <span class="preels__play" aria-hidden="true">
                  <Icon name="play" class="preels__play-icon" />
                </span>
              </button>

              {/* Сердце ПОД роликом, а не на нём: кнопка «в избранное»
                  внутри кнопки запуска — недопустимая вложенность, да и
                  правило то же, что у фотографий: на кадре ничего нет. */}
              <div class="preels__foot">
                {reel.sound && (
                  <button class="sound-btn sound-btn--inline" type="button" data-sound={reel.src} aria-pressed="false" aria-label="Звук ролика">
                    <span class="sound-btn__off"><Icon name="soundOff" /></span>
                    <span class="sound-btn__on"><Icon name="sound" /></span>
                  </button>
                )}
                <button class="save save--inline" type="button" data-save={reelSaves.get(reel.src)} aria-pressed="false" aria-label="Ролик в избранное">
                  <Icon name="heartOutline" />
                </button>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    {!reels.length && s.reels && (
      <section class="preels">
        <h2 class="t-h2">Видео</h2>
        <div class="preels__rail">
          {s.reels.map((reel, n) => (
            <figure class="preels__item media">
              <Image
                src={resolveImage(reel.poster)}
                alt={`${s.name} — видео ${n + 1}`}
                widths={IMG_WIDTHS.thumb}
                sizes="(min-width: 1024px) 220px, 48vw"
                loading="lazy"
                decoding="async"
              />
            </figure>
          ))}
        </div>
      </section>
    )}

    <!-- ПРЕДЛОЖЕНИЕ ОТ ПОДРЯДЧИКА: формулирует сам, подаём цитатой -->
    {s.quote && (
      <section class="pquote">
        <p class="t-caption pquote__kicker">Предложение</p>
        <blockquote class="pquote__body">
          <p class="pquote__text">{s.quote}</p>
          <footer class="pquote__author t-small">{s.name} · {s.category.toLowerCase()}</footer>
        </blockquote>
      </section>
    )}

    <!-- ОТЗЫВЫ: вертикально, один в ряд, с автором и датой -->
    {s.reviewsList && (
      <section class="previews" id="otzyvy">
        <h2 class="t-h2">Отзывы</h2>
        <div class="previews__list">
          {s.reviewsList.map((r) => (
            <article class="preview">
              <header class="preview__head">
                <Avatar src={r.photo} name={r.author} size={48} />
                <div class="preview__who">
                  <p class="preview__author">{r.author}</p>
                  <p class="preview__date t-caption">{r.date}</p>
                </div>
                <p class="preview__rate" aria-label={`Оценка ${r.rating} из 5`}>{'★'.repeat(r.rating)}{'☆'.repeat(5 - r.rating)}</p>
              </header>
              <p class="preview__text">«{r.text}»</p>
            </article>
          ))}
        </div>
      </section>
    )}

    <!-- ЗАЯВКА -->
    <section class="pcta theme-accent" id="zayavka">
      <h2 class="t-h2">Забронировать на свою свадьбу</h2>
      <p class="t-small pcta__note">Оставьте заявку — менеджер свяжется и уточнит дату и детали.</p>
      <a class="pill pill--lg" href="#">Оставить заявку</a>
    </section>
  </div>

  <BottomDock active="vendors" />
</Layout>

<style>
  .profile {
    padding-bottom: var(--dock-space);
  }

  /* ============ ПОДПИСЬ НА СТЕКЛЕ ПЕРВОГО ЭКРАНА ============
     Разметка стоит в слоте HeroStage: портрет и имя одной строкой,
     под ними рейтинг. Кадровой вёрстки (сплит-полоса «плашка + карусель»)
     тут больше нет — первый экран у подрядчика и у площадки один и тот же
     компонент, а условия и заявка идут ниже, при прокрутке. */
  .phero__id {
    display: flex;
    align-items: center;
    gap: var(--s-3);
  }

  .phero__title { min-width: 0; }

  /* Имя — главный объект экрана, но кегль от прежних 64px опущен:
     на стеклянной полосе он занимал бы её целиком. */
  .phero__name {
    font-size: clamp(24px, 6vw, 36px);
    font-weight: var(--w-head);
    line-height: var(--lh-heading);
    letter-spacing: var(--ls-display);
  }

  .phero__tagline {
    font-size: var(--fs-small);
    line-height: 1.3;
  }

  /* Кружок на стекле: подложка от чернил, а не бумажная --surface-dim —
     та на размытом кадре читается заплаткой. */
  .phero__id :global(.avatar) {
    flex: none;
    background: color-mix(in srgb, var(--black) 14%, transparent);
    color: var(--black);
  }

  .phero__rate {
    display: inline-block;
    margin-top: var(--s-3);
    font-size: var(--fs-small);
    font-weight: var(--w-medium);
    color: inherit;
    text-decoration: none;
  }

  /* ============ УСЛОВИЯ И ЗАЯВКА (сразу под первым экраном) ============ */
  .phero { margin-bottom: var(--section-gap-tight); }

  .phero__card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-6);
    padding: var(--s-6) var(--gutter);
  }

  .phero__deal {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-2);
  }

  /* Цена — крупно, якорь плашки */
  .phero__price {
    font-size: var(--fs-h2);
    font-weight: var(--w-medium);
    line-height: var(--lh-heading);
    letter-spacing: var(--ls-display);
  }

  .phero__deal .pill { margin-top: var(--s-3); }

  /* ============ О ПОДРЯДЧИКЕ ============ */
  .pabout {
    padding: 0 var(--gutter) var(--section-gap-tight);
  }

  /* Портрет слева, рассказ справа — но только на ПК: на телефоне кадр
     идёт над текстом во всю ширину колонки. Колонка текста не шире меры
     чтения, поэтому портрет получает фиксированный столбец, а не долю. */
  .pabout__body {
    display: grid;
    gap: var(--s-5);
    margin-top: var(--s-5);
  }

  @media (min-width: 900px) {
    .pabout__body {
      grid-template-columns: minmax(0, 320px) minmax(0, 1fr);
      align-items: start;
      gap: var(--s-7);
    }
  }

  /* Пропорция кадра своя, из файла: портрет не кропим под общую рамку
     (то же правило, что на первом экране и в галерее). */
  .pabout__portrait :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .pabout__text { max-width: var(--measure-text); }

  /* Отбивка между абзацами, а не над первым: сверху расстояние уже
     задал сам блок (--s-5 от заголовка). */
  .pabout__text + .pabout__text { margin-top: var(--s-4); }

  /* ============ ПОЧЕМУ ВЫБИРАЮТ ============
     Две колонки на ПК, одна на телефоне. Ни рамок, ни линий между
     пунктами: их разделяет воздух, заголовок пункта — сам себе знак. */
  .pwhy {
    padding: 0 var(--gutter) var(--section-gap-tight);
  }

  .pwhy__grid {
    display: grid;
    gap: var(--s-6) var(--s-7);
    margin-top: var(--s-5);
  }

  @media (min-width: 720px) {
    .pwhy__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  .pwhy__title {
    font-size: var(--fs-h3);
    font-weight: var(--w-head);
    line-height: var(--lh-heading);
  }

  .pwhy__text {
    margin-top: var(--s-2);
    max-width: var(--measure-text);
  }

  /* ============ ЧТО ВХОДИТ ============ */
  .ppack {
    padding: 0 var(--gutter) var(--section-gap-tight);
  }

  .ppack__list { margin-top: var(--s-5); }

  /* ============ ГАЛЕРЕЯ ============
     Доска идёт в край экрана, как на главной: боковых полей у неё нет,
     в них остаётся только заголовок секции. */
  .pgallery {
    padding-bottom: var(--section-gap-tight);
  }

  .pgallery h2 { padding: 0 var(--gutter); }

  .pgallery :global(.masonry) { margin-top: var(--s-5); }

  /* ============ ВИДЕО-РОЛИКИ ============
     Вертикальные 2:3 карточки, листаются вбок (scroll-snap),
     как карусели карточек каталога. */
  .preels {
    padding: 0 0 var(--section-gap-tight) var(--gutter);
  }

  .preels__rail {
    display: flex;
    gap: var(--s-3);
    margin-top: var(--s-5);
    padding-right: var(--gutter);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    /* touch-action не ставим: ось жеста выбирает браузер (см. DESIGN.md) */
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .preels__rail::-webkit-scrollbar { display: none; }

  /* Ячейка ряда: кадр и подпись с сердцем под ним. Ширину держит она,
     а не сам ролик, — иначе строка с лайком вылезала бы за кадр. */
  .preels__cell {
    flex: 0 0 clamp(180px, 48vw, 240px);
    scroll-snap-align: start;
  }

  .preels__item {
    position: relative;
    width: 100%;
    aspect-ratio: 2 / 3;
    background: var(--surface-dim);
  }

  /* Строка под роликом: пока в ней только сердце — прижато вправо, как
     в подписи карточки каталога. */
  .preels__foot {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--s-2);
    padding-top: 2px;
  }

  /* Плитка ряда — кнопка: снимаем всё, что браузер рисует кнопке сам */
  .preels__item {
    padding: 0;
    border: 0;
    background: var(--surface-dim);
    cursor: pointer;
    color: inherit;
  }

  /* Ролик поверх своего постера — проявляется, когда реально пошёл:
     не запустился (энергосбережение на iPhone) — остаётся постер */
  .preels__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity var(--dur-base) var(--ease-out);
    pointer-events: none;
  }

  .preels__video.is-playing { opacity: 1; }

  /* Кнопка play — единственное, что лежит НА кадре: правило проекта
     разрешает поверх фотографии только иконки со своей тенью. */
  .preels__play {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-pill);
    background: var(--ink);
    color: var(--white);
    box-shadow: var(--shadow-float);
    transition: opacity var(--dur-fast) var(--ease-out);
  }

  :global(.preels__play-icon) {
    width: 20px;
    height: 20px;
    /* треугольник в круге смотрится центрированным, когда сдвинут вправо */
    margin-left: 2px;
  }

  /* Пошёл ролик — кнопка уходит, кадр остаётся чистым; вернуть паузу
     можно тапом по самой плитке */
  .preels__item[aria-pressed='true'] .preels__play { opacity: 0; }

  /* ============ ПРЕДЛОЖЕНИЕ-ЦИТАТА ============ */
  .pquote {
    padding: 0 var(--gutter) var(--section-gap-tight);
  }

  .pquote__kicker { font-weight: var(--w-medium); }

  .pquote__body { margin-top: var(--s-4); }

  .pquote__text {
    font-size: var(--fs-h2);
    font-weight: var(--w-head);
    line-height: var(--lh-heading);
    letter-spacing: var(--ls-display);
    max-width: var(--measure-lead);
  }

  .pquote__author {
    margin-top: var(--s-4);
    font-weight: var(--w-medium);
  }

  /* ============ ОТЗЫВЫ: вертикальный список ============ */
  .previews {
    padding: 0 var(--gutter) var(--section-gap-tight);
  }

  .previews__list {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    margin-top: var(--s-5);
  }

  .preview {
    max-width: var(--measure-prose);
    padding: var(--s-5);
    background: var(--surface-dim);
  }

  .preview__head {
    display: flex;
    align-items: center;
    gap: var(--s-3);
  }

  /* Кружок автора отзыва — общий Avatar; на бумажной карточке отзыва
     его подложка светлее фона самой карточки. */
  .preview :global(.avatar) { background: var(--bg); }

  .preview__who { flex: 1; min-width: 0; }

  .preview__author { font-weight: var(--w-medium); }

  .preview__rate {
    font-size: var(--fs-small);
    letter-spacing: 2px;
    flex-shrink: 0;
  }

  .preview__text {
    margin-top: var(--s-4);
    max-width: var(--measure-text);
  }

  /* ============ ЗАЯВКА ============ */
  .pcta {
    padding: var(--section-gap) var(--gutter);
  }

  .pcta h2 { max-width: var(--measure-head); }

  .pcta__note {
    margin-top: var(--s-3);
    max-width: var(--measure-lead);
  }

  .pcta .pill { margin-top: var(--s-5); }
</style>

<!-- Якорь разбираем ДО модульных скриптов (те отложены и выполняются после
     разбора документа): нужный кадр должен встать сразу, иначе человек,
     нажавший в доске на ролик, на мгновение увидит чужое фото.
     Тот же приём и тот же код, что в VenueHero. -->


<script>
  import { bindSaveButtons } from '../../../../lib/save';
  import { bindVideo } from '../../../../lib/video';

  bindSaveButtons();
  // Ролик первого экрана оживляет сам HeroStage — тут только ряд «Видео».

  // ============ РЯД «ВИДЕО»: ИГРАЕТ ТОЛЬКО ОДИН ============
  // Автозапуска тут нет намеренно (в отличие от плиток доски): в ряду
  // несколько роликов в кадре разом, и играющие одновременно перебивают
  // друг друга. Запуск соседнего останавливает предыдущий — как в любой
  // ленте роликов.
  const tiles = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-reel]'));

  function stopTile(tile: HTMLButtonElement) {
    const video = tile.querySelector<HTMLVideoElement>('[data-reel-video]');
    video?.pause();
    video?.classList.remove('is-playing');
    tile.setAttribute('aria-pressed', 'false');
  }

  tiles.forEach((tile) => {
    tile.addEventListener('click', () => {
      const video = tile.querySelector<HTMLVideoElement>('[data-reel-video]');
      if (!video) return;

      if (tile.getAttribute('aria-pressed') === 'true') {
        stopTile(tile);
        return;
      }

      tiles.forEach((other) => other !== tile && stopTile(other));

      // файл подставляем при первом запуске: до нажатия ролик не качается
      if (!video.src) video.src = tile.dataset.reel!;
      video
        .play()
        .then(() => {
          video.classList.add('is-playing');
          tile.setAttribute('aria-pressed', 'true');
        })
        .catch(() => {});
    });
  });

  // Ушёл ряд с экрана — ролик встаёт на паузу: звука у лупа нет, но
  // крутить видео за кадром незачем, это батарея телефона.
  const rail = document.querySelector('.preels__rail');
  if (rail) {
    new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) tiles.forEach(stopTile);
      },
      { threshold: 0 }
    ).observe(rail);
  }
</script>
