---
// СТРАНИЦА-ВИЗИТКА СПЕЦИАЛИСТА — одна на все 19 категорий (реф. Cineteca
// Milano): крупный кадр + контрастная инфо-плашка с ценой и заявкой.
// Раньше лежала отдельным роутом под ведущих; блоки те же, но всё, чего у
// подрядчика нет, просто не рендерится — цена, рейтинг, отзывы, видео.
//
// Открывается визитка у тех, у кого есть материал для неё (quote/offers),
// а не у всех карточек каталога: пустая страница-визитка хуже её отсутствия.
//
// Карточка, стоящая в двух категориях (пара «фото + видео» — и в
// «Фотографах», и в «Видеографах»), имеет РОВНО ОДИН адрес: путь строится
// по родной categorySlug, дубля страницы под тем же текстом нет.
import { Image } from 'astro:assets';
import Layout from '../../../../layouts/Layout.astro';
import SiteHeader from '../../../../components/SiteHeader.astro';
import BottomDock from '../../../../components/BottomDock.astro';
import PhotoMasonry from '../../../../components/PhotoMasonry.astro';
import Avatar from '../../../../components/Avatar.astro';
import Icon from '../../../../components/Icon.astro';
import BackButton from '../../../../components/BackButton.astro';
import { SPECIALISTS_BY_CATEGORY, FILTERS_BY_CATEGORY, type Specialist } from '../../../../data/specialists';
import { reelsOf } from '../../../../data/reels';
import { photoTiles } from '../../../../lib/gallery';
import { resolveImage, favoriteImage, IMG_WIDTHS } from '../../../../lib/images';
import { frameId, isPortrait, isVideo, photosOnly, posterOf } from '../../../../lib/media';

export function getStaticPaths() {
  const seen = new Set<string>();

  return Object.values(SPECIALISTS_BY_CATEGORY)
    .flat()
    // визитка есть у тех, кто дал материал: предложение или список причин
    .filter((s) => s.quote || s.offers)
    .filter((s) => !seen.has(s.slug) && seen.add(s.slug))
    .map((s) => ({ params: { category: s.categorySlug, slug: s.slug }, props: { s } }));
}

const { s } = Astro.props as { s: Specialist };

function labelsFor(groupKey: string, values: string[]): string[] {
  const group = FILTERS_BY_CATEGORY[s.categorySlug]?.find((g) => g.key === groupKey);
  if (!group) return values;
  const map = new Map(group.options.map((o) => [o.value, o.label]));
  return values.map((v) => map.get(v) ?? v);
}

const priceFmt = new Intl.NumberFormat('ru-RU');
const styleLabels = s.styles ? labelsFor('style', s.styles) : [];
const bioParagraphs = s.bio.split('\n\n');

// Строка под ценой собирается из того, что есть: пустых «· ·» не остаётся
const priceFacts = [
  s.priceFrom ? 'за 6 часов работы' : null,
  s.experienceYears ? `${s.experienceYears} лет опыта` : null,
  s.hasOwnDJ ? 'свой диджей' : null,
  s.gender === 'pair' ? 'фото и видео' : null,
].filter(Boolean);

// ПЕРВЫЙ ЭКРАН — ОДИН КАДР, БЕЗ КАРУСЕЛИ. Раньше тут стоял рельс
// PhotoRail: фиксированное окно 4:5, все кадры внутри кроются под одну
// пропорцию, под кадром строка из полутора десятков точек, а вуаль рельса
// (.veil — градиент на нижние 62% обёртки) ложилась НЕ ТОЛЬКО на фото, но
// и на эту строку, и под снимком висела серая полоса непонятного
// назначения. Карточка площадки от карусели в первом экране отказалась
// раньше (см. VenueHero) — визитка подрядчика идёт тем же правилом: кадр
// в СВОЕЙ пропорции на телефоне, ничем не закрытый.
//
// Кадры всё равно рендерятся все: по адресу `#foto-<кадр>` из доски
// главной открывается именно тот снимок или ролик, по которому нажали
// (якорь разбирает инлайновый скрипт внизу файла, как в карточке
// площадки). Лишние кадры скрыты обычным `hidden` — из потока выпадают
// полностью, высоту блока меряет ровно показанный.
// Порядок: обложка, ролики, остальные фото. Кадров ровно столько, сколько
// их уходит в доску главной (PER_SPECIALIST в lib/gallery): любой кадр,
// по которому там можно нажать, тут есть. Вся съёмка целиком — ниже,
// в блоке «Фотографии».
const HERO_PHOTOS = 12;
const reels = reelsOf(s.slug);
const frames = [
  ...new Set([s.photos[0], ...reels.map((r) => r.src), ...s.photos.slice(1, HERO_PHOTOS)]),
];

// Дежурный кадр — первый вертикальный: телефон главный сценарий, и
// вертикаль полнее заполняет экран. Граница вертикальности одна на весь
// проект (isPortrait в lib/media). Фолбэк — просто первый кадр.
const defaultFrame = frames.find(isPortrait) ?? frames[0];

// sizes галереи — те же колонки, что у доски главной (PhotoMasonry)
const GALLERY_SIZES =
  '(min-width: 1440px) 19vw, (min-width: 1024px) 24vw, (min-width: 640px) 32vw, 48vw';

const priceLabel = s.priceFrom ? `от ${priceFmt.format(s.priceFrom)} ₽` : 'Цена по запросу';
const href = `/moskva/podryadchiki/${s.categorySlug}/${s.slug}/`;

const saveData = JSON.stringify({
  id: `${s.categorySlug}:${s.slug}`,
  cat: s.categorySlug,
  catLabel: s.category,
  name: s.name,
  meta: styleLabels[0] || s.tagline,
  price: priceLabel,
  rating: s.rating,
  img: await favoriteImage(s.photos[0]),
  href,
});
---

<Layout
  title={`${s.name} — ${s.category.toLowerCase()} на свадьбу в Москве и области — WED Secrets`}
  description={`${s.name} — ${s.tagline.toLowerCase()}. ${s.category} на свадьбу в Москве и Московской области.`}
>
  <SiteHeader />

  <div class="profile">
    <!-- ГЕРОЙ: инфо-плашка + крупный кадр встык (реф. Cineteca).
         Кнопка «назад» — на кадре, не текстовая крошка на плашке: тот же
         паттерн, что у карточки площадки (см. BackButton.astro).

         Аватарка стоит над именем: на визитке фотографа весь экран занят
         его работами, и портрет автора — единственное место, где видно,
         с кем человек будет иметь дело. Нет портрета — кружок с
         инициалами, слот остаётся на месте. -->
    <section class="phero">
      <div class="phero__card theme-accent">
        <div class="phero__top">
          <Avatar src={s.avatar} name={s.name} size={64} class="phero__avatar" />
          <h1 class="phero__name">{s.name}</h1>
          <p class="t-lead phero__tagline">{s.tagline}</p>
          {s.rating && s.reviews && (
            <a class="pill pill--sm phero__rate" href="#otzyvy">★ {s.rating.toFixed(1)} · {s.reviews}&nbsp;отзывов</a>
          )}
        </div>

        <div class="phero__deal">
          <p class="phero__price">{priceLabel}</p>
          <p class="t-caption phero__price-note">
            {priceFacts.join(' · ')}
          </p>
          <a class="pill pill--lg" href="#zayavka">Оставить заявку</a>
        </div>
      </div>

      <div class="phero__media">
        <figure class="phero__shot" data-hero-shot>
          <BackButton href={`/moskva/podryadchiki/${s.categorySlug}/`} label={`К списку «${s.category}»`} />

          {frames.map((src, n) => {
            const video = isVideo(src);
            const eager = src === defaultFrame;

            return (
              <div class="phero__frame" data-frame={frameId(src)} hidden={src !== defaultFrame}>
                <Image
                  src={resolveImage(video ? posterOf(src) : src)}
                  alt={n === 0 ? s.name : `${s.name} — свадебная съёмка`}
                  widths={IMG_WIDTHS.hero}
                  sizes="(min-width: 1024px) 50vw, 100vw"
                  loading={eager ? 'eager' : 'lazy'}
                  fetchpriority={eager ? 'high' : undefined}
                  decoding="async"
                />
                {video && (
                  <video class="phero__video" data-video={src} muted loop playsinline preload="none" aria-hidden="true"></video>
                )}
              </div>
            );
          })}

          <button class="save" type="button" data-save={saveData} aria-pressed="false" aria-label="В избранное">
            <Icon name="heartOutline" />
          </button>
        </figure>
      </div>
    </section>

    <!-- О ПОДРЯДЧИКЕ -->
    <section class="pabout">
      <h2 class="t-h2">{s.aboutTitle ?? 'О подрядчике'}</h2>
      {bioParagraphs.map((p) => <p class="pabout__text">{p}</p>)}
    </section>

    <!-- ПОЧЕМУ ВЫБИРАЮТ: причины формулирует сам подрядчик. Заголовок
         пункта — отдельной строкой h3, а не жирной фразой внутри абзаца. -->
    {s.offers && (
      <section class="pwhy">
        <h2 class="t-h2">Почему выбирают</h2>
        <div class="pwhy__grid" data-reveal-group>
          {s.offers.map((offer) => (
            <article class="pwhy__item" data-reveal>
              <h3 class="pwhy__title">{offer.title}</h3>
              <p class="pwhy__text">{offer.text}</p>
            </article>
          ))}
        </div>
      </section>
    )}

    <!-- ЧТО ВХОДИТ В ПАКЕТ -->
    {s.packageIncludes && (
      <section class="ppack">
        <h2 class="t-h2">Что входит</h2>
        <ul class="ppack__list list">
          {s.packageIncludes.map((item) => <li>{item}</li>)}
        </ul>
      </section>
    )}

    <!-- ГАЛЕРЕЯ: ТА ЖЕ ДОСКА, ЧТО НА ГЛАВНОЙ (PhotoMasonry) — колонки
         одной ширины, каждый кадр в своей настоящей пропорции. Раньше тут
         стояла своя сетка с жёстким aspect-ratio 3/4: каждый снимок
         кропился под чужую рамку, и портфолио подрядчика показывалось
         не так, как те же кадры в ленте главной. -->
    <section class="pgallery">
      <h2 class="t-h2">Фотографии</h2>
      <PhotoMasonry tiles={photoTiles(photosOnly(s.photos), s.name)} sizes={GALLERY_SIZES} />
    </section>

    <!-- ВИДЕО отдельной секцией у подрядчика с реальными роликами нет:
         они лежат кадрами в первом экране, вперемешку с фотографиями.
         Ниже — старый демо-блок постеров (карточки-заглушки прототипа). -->
    {!reels.length && s.reels && (
      <section class="preels">
        <h2 class="t-h2">Видео</h2>
        <div class="preels__rail" data-reveal-group>
          {s.reels.map((reel, n) => (
            <figure class="preels__item media" data-reveal>
              <Image
                src={resolveImage(reel.poster)}
                alt={`${s.name} — видео ${n + 1}`}
                widths={IMG_WIDTHS.thumb}
                sizes="(min-width: 1024px) 220px, 48vw"
                loading="lazy"
                decoding="async"
              />
            </figure>
          ))}
        </div>
      </section>
    )}

    <!-- ПРЕДЛОЖЕНИЕ ОТ ПОДРЯДЧИКА: формулирует сам, подаём цитатой -->
    {s.quote && (
      <section class="pquote">
        <p class="t-caption pquote__kicker">Предложение</p>
        <blockquote class="pquote__body">
          <p class="pquote__text">{s.quote}</p>
          <footer class="pquote__author t-small">{s.name} · {s.category.toLowerCase()}</footer>
        </blockquote>
      </section>
    )}

    <!-- ОТЗЫВЫ: вертикально, один в ряд, с автором и датой -->
    {s.reviewsList && (
      <section class="previews" id="otzyvy">
        <h2 class="t-h2">Отзывы</h2>
        <div class="previews__list" data-reveal-group>
          {s.reviewsList.map((r) => (
            <article class="preview" data-reveal>
              <header class="preview__head">
                <Avatar src={r.photo} name={r.author} size={48} />
                <div class="preview__who">
                  <p class="preview__author">{r.author}</p>
                  <p class="preview__date t-caption">{r.date}</p>
                </div>
                <p class="preview__rate" aria-label={`Оценка ${r.rating} из 5`}>{'★'.repeat(r.rating)}{'☆'.repeat(5 - r.rating)}</p>
              </header>
              <p class="preview__text">«{r.text}»</p>
            </article>
          ))}
        </div>
      </section>
    )}

    <!-- ЗАЯВКА -->
    <section class="pcta theme-accent" id="zayavka">
      <h2 class="t-h2">Забронировать на свою свадьбу</h2>
      <p class="t-small pcta__note">Оставьте заявку — менеджер свяжется и уточнит дату и детали.</p>
      <a class="pill pill--lg" href="#">Оставить заявку</a>
    </section>
  </div>

  <BottomDock active="vendors" />
</Layout>

<style>
  .profile {
    padding-bottom: calc(var(--safe-b) + 120px);
  }

  /* ============ ГЕРОЙ: плашка + карусель встык ============
     Мобилка: фото сверху во всю ширину, плашка под ним.
     ПК: сплит-полоса в край экрана — плашка слева, карусель справа. */
  .phero {
    display: grid;
    grid-template-areas: 'media' 'card';
    margin-bottom: var(--section-gap-tight);
  }

  .phero__media { grid-area: media; }

  /* Кадр — единственное место в системе, где на фото лежит не текст,
     а иконка со своей тенью (сердце, кнопка «назад»); position: relative
     держит их прижатыми к кадру, а не к секции целиком. */
  .phero__shot {
    position: relative;
    background: var(--surface-dim);
  }

  /* Показанный кадр — блок во всю ширину, высоту диктует его СОБСТВЕННАЯ
     пропорция (width/height у Image расставлены Astro'ой из файла):
     никакого aspect-ratio/object-fit на телефоне тут нет и не должно быть,
     в этом весь смысл отказа от общего окна карусели. Скрытые кадры —
     display: none, из потока выпадают полностью. */
  .phero__frame img,
  .phero__frame video {
    display: block;
    width: 100%;
    height: auto;
  }

  .phero__frame[hidden] { display: none; }

  /* Ролик лежит поверх своего постера и проявляется, когда реально пошёл:
     заблокировали автозапуск — в кадре просто остаётся постер. */
  .phero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity var(--dur-fast) var(--ease-out);
  }

  .phero__video.is-playing { opacity: 1; }

  /* Якорная композиция: имя с теглайном тяготеют к верху плашки,
     цена с кнопкой — к низу, середина дышит (space-between). */
  .phero__card {
    grid-area: card;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--s-6);
    padding: var(--s-6) var(--gutter);
  }

  .phero__top {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-4);
  }

  /* Портрет прижат к имени теснее, чем имя к теглайну: правило
     внутреннего и внешнего — кружок принадлежит имени, а не блоку. */
  .phero__avatar { margin-bottom: calc(var(--s-4) * -1 + var(--s-3)); }

  /* В оранжевой плашке кружок с инициалами берёт цвета от неё же:
     бумажная подложка --surface-dim на акценте выглядит заплаткой. */
  .phero__card :global(.avatar) {
    background: color-mix(in srgb, var(--fg) 16%, transparent);
    color: var(--fg);
  }

  /* Имя — главный объект экрана, но без гигантизма: блок держим низким */
  .phero__name {
    font-size: clamp(40px, 5.5vw, 64px);
    font-weight: var(--w-head);
    line-height: var(--lh-display);
    letter-spacing: var(--ls-display);
    max-width: var(--measure-head);
  }

  .phero__tagline { max-width: var(--measure-lead); }

  .phero__rate { text-decoration: none; }

  .phero__deal {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-2);
  }

  /* Цена — крупно, второй якорь плашки */
  .phero__price {
    font-size: var(--fs-h2);
    font-weight: var(--w-medium);
    line-height: var(--lh-heading);
    letter-spacing: var(--ls-display);
  }

  .phero__deal .pill { margin-top: var(--s-3); }

  @media (min-width: 1024px) {
    .phero {
      grid-template-areas: 'card media';
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: stretch;
      /* Высоту задаёт контент карточки — герой остаётся компактной
         горизонтальной полосой и целиком влезает в экран с запасом. */
    }

    .phero__card {
      padding: var(--s-6) var(--s-7) var(--s-6) var(--gutter);
    }

    /* Сплит-полоса: высоту задаёт плашка слева, кадр справа растянут по
       ней абсолютом. Тут кроп неизбежен (два блока стоят полосой в край
       экрана и обязаны быть одной высоты) — держим верх кадра, чтобы не
       резать голову. На телефоне, где кадр стоит сам по себе, кропа нет. */
    .phero__media { position: relative; }

    .phero__shot {
      position: absolute;
      inset: 0;
      overflow: hidden;
    }

    .phero__frame { height: 100%; }

    .phero__frame img,
    .phero__frame video {
      height: 100%;
      object-fit: cover;
      object-position: center top;
    }
  }

  /* ============ О ПОДРЯДЧИКЕ ============ */
  .pabout {
    padding: 0 var(--gutter) var(--section-gap-tight);
  }

  .pabout__text {
    max-width: var(--measure-text);
    margin-top: var(--s-4);
  }

  /* ============ ПОЧЕМУ ВЫБИРАЮТ ============
     Две колонки на ПК, одна на телефоне. Ни рамок, ни линий между
     пунктами: их разделяет воздух, заголовок пункта — сам себе знак. */
  .pwhy {
    padding: 0 var(--gutter) var(--section-gap-tight);
  }

  .pwhy__grid {
    display: grid;
    gap: var(--s-6) var(--s-7);
    margin-top: var(--s-5);
  }

  @media (min-width: 720px) {
    .pwhy__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  .pwhy__title {
    font-size: var(--fs-h3);
    font-weight: var(--w-head);
    line-height: var(--lh-heading);
  }

  .pwhy__text {
    margin-top: var(--s-2);
    max-width: var(--measure-text);
  }

  /* ============ ЧТО ВХОДИТ ============ */
  .ppack {
    padding: 0 var(--gutter) var(--section-gap-tight);
  }

  .ppack__list { margin-top: var(--s-5); }

  /* ============ ГАЛЕРЕЯ ============
     Доска идёт в край экрана, как на главной: боковых полей у неё нет,
     в них остаётся только заголовок секции. */
  .pgallery {
    padding-bottom: var(--section-gap-tight);
  }

  .pgallery h2 { padding: 0 var(--gutter); }

  .pgallery :global(.masonry) { margin-top: var(--s-5); }

  /* ============ ВИДЕО-РОЛИКИ ============
     Вертикальные 2:3 карточки, листаются вбок (scroll-snap),
     как карусели карточек каталога. */
  .preels {
    padding: 0 0 var(--section-gap-tight) var(--gutter);
  }

  .preels__rail {
    display: flex;
    gap: var(--s-3);
    margin-top: var(--s-5);
    padding-right: var(--gutter);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    /* жест на рельсе — только по горизонтали, без косого свайпа (см. FilterBar) */
    touch-action: pan-x;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .preels__rail::-webkit-scrollbar { display: none; }

  .preels__item {
    position: relative;
    flex: 0 0 clamp(180px, 48vw, 240px);
    aspect-ratio: 2 / 3;
    scroll-snap-align: start;
    background: var(--surface-dim);
  }

  /* ============ ПРЕДЛОЖЕНИЕ-ЦИТАТА ============ */
  .pquote {
    padding: 0 var(--gutter) var(--section-gap-tight);
  }

  .pquote__kicker { font-weight: var(--w-medium); }

  .pquote__body { margin-top: var(--s-4); }

  .pquote__text {
