<!-- Якорь разбираем ДО модульных скриптов (те отложены и выполняются после
     разбора документа): нужный кадр должен встать сразу, иначе человек,
     нажавший в доске на ролик, на мгновение увидит чужое фото.
     Тот же приём и тот же код, что в VenueHero. -->
<script is:inline>
  (() => {
    const host = document.querySelector('[data-hero-shot]');
    const id = (location.hash.match(/^#foto-(.+)$/) || [])[1];
    if (!host || !id) return;

    const frame = host.querySelector(`[data-frame="${CSS.escape(decodeURIComponent(id))}"]`);
    if (!frame) return; // кадр не найден по ссылке — визитка открывается дежурным

    host.querySelectorAll('[data-frame]').forEach((f) => { f.hidden = f !== frame; });

    const img = frame.querySelector('img');
    if (img) {
      img.loading = 'eager';
      img.fetchPriority = 'high';
    }
  })();
</script>

<script>
  import { bindSaveButtons } from '../../../../lib/save';
  import { bindVideo } from '../../../../lib/video';

  bindSaveButtons();

  // Ролик в первом экране: играет, пока его кадр показан (а не скрыт
  // через [hidden]) и секция в поле зрения — как в герое площадки.
  document.querySelectorAll<HTMLElement>('[data-hero-shot]').forEach((host) => {
    host.querySelectorAll<HTMLVideoElement>('[data-video]').forEach((video) => {
      const frame = video.closest<HTMLElement>('[data-frame]');
      bindVideo(video, { root: host, active: () => !!frame && !frame.hidden });
    });
  });
</script>
