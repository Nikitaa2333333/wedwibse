---
// СТРАНИЦА-ВИЗИТКА СПЕЦИАЛИСТА — одна на все 19 категорий (реф. Cineteca
// Milano): крупный кадр + контрастная инфо-плашка с ценой и заявкой.
// Раньше лежала отдельным роутом под ведущих; блоки те же, но всё, чего у
// подрядчика нет, просто не рендерится — цена, рейтинг, отзывы, видео.
//
// Открывается визитка у тех, у кого есть материал для неё (quote/offers),
// а не у всех карточек каталога: пустая страница-визитка хуже её отсутствия.
//
// Карточка, стоящая в двух категориях (пара «фото + видео» — и в
// «Фотографах», и в «Видеографах»), имеет РОВНО ОДИН адрес: путь строится
// по родной categorySlug, дубля страницы под тем же текстом нет.
import { Image } from 'astro:assets';
import Layout from '../../../../layouts/Layout.astro';
import SiteHeader from '../../../../components/SiteHeader.astro';
import BottomDock from '../../../../components/BottomDock.astro';
import PhotoGallery from '../../../../components/PhotoGallery.astro';
import Avatar from '../../../../components/Avatar.astro';
import Reviews from '../../../../components/Reviews.astro';
import Icon from '../../../../components/Icon.astro';
import HeroActions from '../../../../components/HeroActions.astro';
import HeroCta from '../../../../components/HeroCta.astro';
import HeroStage from '../../../../components/HeroStage.astro';
import ReelsRow from '../../../../components/ReelsRow.astro';
import RelatedCards from '../../../../components/RelatedCards.astro';
import { similarSpecialists } from '../../../../lib/similar';
import { specialistCard } from '../../../../lib/similar-cards';
import { SPECIALISTS_BY_CATEGORY, FILTERS_BY_CATEGORY, specialistRole, hasProfile, type Specialist } from '../../../../data/specialists';
import { reelsOf } from '../../../../data/reels';
import { photoTiles } from '../../../../lib/gallery';
import { resolveImage, favoriteImage, IMG_WIDTHS } from '../../../../lib/images';
import { frameId, isPortrait, isVideo, photosOnly, posterOf } from '../../../../lib/media';

export function getStaticPaths() {
  const seen = new Set<string>();

  return Object.values(SPECIALISTS_BY_CATEGORY)
    .flat()
    // визитка есть у тех, кто дал материал: предложение или список причин
    .filter(hasProfile)
    .filter((s) => !seen.has(s.slug) && seen.add(s.slug))
    .map((s) => ({ params: { category: s.categorySlug, slug: s.slug }, props: { s } }));
}

const { s } = Astro.props as { s: Specialist };

function labelsFor(groupKey: string, values: string[]): string[] {
  const group = FILTERS_BY_CATEGORY[s.categorySlug]?.find((g) => g.key === groupKey);
  if (!group) return values;
  const map = new Map(group.options.map((o) => [o.value, o.label]));
  return values.map((v) => map.get(v) ?? v);
}

const priceFmt = new Intl.NumberFormat('ru-RU');
const styleLabels = s.styles ? labelsFor('style', s.styles) : [];
const bioParagraphs = s.bio.split('\n\n');

// Строка под ценой собирается из того, что есть: пустых «· ·» не остаётся
const priceFacts = [
  s.priceFrom ? 'за 6 часов работы' : null,
  s.experienceYears ? `${s.experienceYears} лет опыта` : null,
  s.hasOwnDJ ? 'свой диджей' : null,
  s.gender === 'pair' ? 'фото и видео' : null,
].filter(Boolean);

// ПЕРВЫЙ ЭКРАН — общий компонент HeroStage, тот же, что у карточки
// площадки: работа подрядчика во весь экран телефона, на матовом стекле
// внизу портрет, имя, специальность и рейтинг, поверх кадра — кнопки
// «назад · в избранное · поделиться». Условия (цена, заявка) идут сразу
// под ним, при прокрутке.
//
// Кадры отдаём все: по адресу `#foto-<кадр>` из доски главной открывается
// именно тот снимок или ролик, по которому нажали (якорь разбирает сам
// HeroStage). Кадров ровно столько, сколько их уходит в доску главной
// (PER_SPECIALIST в lib/gallery): любой кадр, по которому там можно
// нажать, тут есть. Вся съёмка целиком — ниже, в блоке «Фотографии».
const HERO_PHOTOS = 12;
const reels = reelsOf(s.slug);
const frames = [
  ...new Set([s.photos[0], ...reels.map((r) => r.src), ...s.photos.slice(1, HERO_PHOTOS)]),
];

const priceLabel = s.priceFrom ? `от ${priceFmt.format(s.priceFrom)} ₽` : 'Цена по запросу';
const href = `/moskva/podryadchiki/${s.categorySlug}/${s.slug}/`;

const saveData = JSON.stringify({
  id: `${s.categorySlug}:${s.slug}`,
  cat: s.categorySlug,
  catLabel: s.category,
  name: s.name,
  meta: styleLabels[0] || s.tagline,
  price: priceLabel,
  rating: s.rating,
  img: await favoriteImage(s.photos[0]),
  href,
});
---

<Layout
  title={`${s.name} — ${s.category.toLowerCase()} на свадьбу в Москве и области — WED Secrets`}
  description={`${s.name} — ${s.tagline.toLowerCase()}. ${s.category} на свадьбу в Москве и Московской области.`}
>
  <SiteHeader />

  <div class="profile">
    <!-- ГЕРОЙ: инфо-плашка + крупный кадр встык (реф. Cineteca).
         Кнопка «назад» — на кадре, не текстовая крошка на плашке: тот же
         паттерн, что у карточки площадки (см. HeroActions.astro).

         Аватарка стоит над именем: на визитке фотографа весь экран занят
         его работами, и портрет автора — единственное место, где видно,
         с кем человек будет иметь дело. Нет портрета — кружок с
         инициалами, слот остаётся на месте. -->
    <!-- ПЕРВЫЙ ЭКРАН — тот же HeroStage, что у площадки, и теперь не только
         кадром: подпись он собирает сам из пропов. Здесь карточка отдаёт
         имя, специальность, рейтинг и портрет — где у площадки стоит её
         знак, у подрядчика стоит он сам. Условия и заявка идут следом.
         Бирка начинается с профессии («Фотограф · …»): из ленты главной
         в карточку попадают без раздела, и один тэглайн не говорит,
         кто это — фотограф, видеограф или ведущий. Тот же приём, что
         у площадки: «Оранжерея · Быково». -->
    <HeroStage
      frames={frames}
      alt={s.name}
      title={s.name}
      kicker={`${specialistRole(s)} · ${s.tagline}`}
      rating={s.rating}
      reviews={s.reviews}
      avatar={s.avatar}
    >
      <HeroActions
        slot="actions"
        backHref={`/moskva/podryadchiki/${s.categorySlug}/`}
        backLabel={`К списку «${s.category}»`}
        save={saveData}
      />
      <!-- Заказ и избранное — сразу под именем, а не под ценой (см. HeroCta) -->
      <HeroCta slot="cta" orderLabel="Заказать" orderHref="#zayavka" save={saveData} />
    </HeroStage>

    <!-- УСЛОВИЯ — ровно та же логика, что у площадки (VenueHero): строка
         продолжает подпись первого экрана прямо на бумаге. Кнопка заказа
         переехала выше, в ряд действий под именем. -->
    <section class="phero">
      <p class="phero__price">{priceLabel}</p>
      <p class="t-caption phero__price-note">{priceFacts.join(' · ')}</p>
    </section>

    <!-- О ПОДРЯДЧИКЕ: рассказ о себе и портрет автора целиком.
         В кружок-аватарку идёт кроп по головам и плечам — студийный кадр
         в полный рост на 30–64 px читается пятном; здесь тот же снимок
         показан как он снят. Нет портрета — секция просто текстовая,
         как была. -->
    <section class="pabout">
      <h2 class="t-h2">{s.aboutTitle ?? 'О подрядчике'}</h2>

      <div class="pabout__body">
        {s.portrait && (
          <figure class="pabout__portrait media">
            <Image
              src={resolveImage(s.portrait)}
              alt={`${s.name} — портрет`}
              widths={IMG_WIDTHS.card}
              sizes="(min-width: 900px) 320px, 100vw"
              loading="lazy"
              decoding="async"
            />
          </figure>
        )}

        <div class="pabout__story">
          {bioParagraphs.map((p) => <p class="pabout__text">{p}</p>)}
        </div>
      </div>
    </section>

    <!-- ПОЧЕМУ ВЫБИРАЮТ: причины формулирует сам подрядчик. Заголовок
         пункта — отдельной строкой h3, а не жирной фразой внутри абзаца. -->
    {s.offers && (
      <section class="pwhy">
        <h2 class="t-h2">Почему выбирают</h2>
        <div class="pwhy__grid">
          {s.offers.map((offer) => (
            <article class="pwhy__item">
              <h3 class="pwhy__title">{offer.title}</h3>
              <p class="pwhy__text">{offer.text}</p>
            </article>
          ))}
        </div>
      </section>
    )}

    <!-- ЧТО ВХОДИТ В ПАКЕТ -->
    {s.packageIncludes && (
      <section class="ppack">
        <h2 class="t-h2">Что входит</h2>
        <ul class="ppack__list list">
          {s.packageIncludes.map((item) => <li>{item}</li>)}
        </ul>
      </section>
    )}

    <!-- ГАЛЕРЕЯ: ТА ЖЕ СЕКЦИЯ, ЧТО У ПЛОЩАДКИ (PhotoGallery поверх доски
         PhotoMasonry) — кикер, заголовок, колонки одной ширины, каждый
         кадр в своей настоящей пропорции. Раньше тут стоял голый h2 и
         доска без поля от края: та же доска у площадки и подрядчика
         выглядела по-разному.
         ВСЯ съёмка сразу, без кнопки «показать ещё»: человек пришёл
         смотреть работы, и прятать половину портфолио незачем. Систему
         это не грузит — картинки ленивые, браузер качает только те, что
         дошли до экрана, в HTML лежит одна разметка. -->
    <PhotoGallery
      kicker="Портфолио"
      title="Фотографии"
      tiles={photoTiles(photosOnly(s.photos), s.name)}
      tight
    />

    <!-- ВИДЕО: свои ролики подрядчика отдельным рядом (ReelsRow, тот же
         компонент, что у площадки): рилсы это то, за чем к видеографу и
         приходят, искать их вперемешку с фото в первом экране человек не станет. -->
    <ReelsRow reels={reels} />

    {!reels.length && s.reels && (
      <section class="preels">
        <h2 class="t-h2">Видео</h2>
        <div class="preels__rail">
          {s.reels.map((reel, n) => (
            <figure class="preels__item media">
              <Image
                src={resolveImage(reel.poster)}
                alt={`${s.name} — видео ${n + 1}`}
                widths={IMG_WIDTHS.thumb}
                sizes="(min-width: 1024px) 220px, 48vw"
                loading="lazy"
                decoding="async"
              />
            </figure>
          ))}
        </div>
      </section>
    )}

    <!-- ПРЕДЛОЖЕНИЕ ОТ ПОДРЯДЧИКА: формулирует сам, подаём цитатой -->
    {s.quote && (
      <section class="pquote">
        <p class="t-caption pquote__kicker">Предложение</p>
        <blockquote class="pquote__body">
          <p class="pquote__text">{s.quote}</p>
          <footer class="pquote__author t-small">{s.name} · {s.category.toLowerCase()}</footer>
        </blockquote>
      </section>
    )}

    <!-- ОТЗЫВЫ — общий компонент с карточкой площадки. Своя верстка тут
         была ровно такой же, и держать её второй копией значило дождаться,
         пока две копии разойдутся: так уже случилось с первым экраном. -->
    {s.reviewsList && (
      <Reviews reviews={s.reviewsList} rating={s.rating} total={s.reviews} />
    )}

    <!-- ЗАЯВКИ ВНИЗУ БОЛЬШЕ НЕТ (заказчик, 19.09.2026): «Заказать» и
         «В избранное» повторяли ряд действий первого экрана (HeroCta) и
         только удлиняли страницу — до них долистывают уже после того,
         как оба действия были в руках. Место под форму-анкету остаётся
         за якорем #zayavka: когда она появится, встанет сюда и снова
         станет целью кнопки «Заказать» из первого экрана. -->

    <!-- ПОХОЖИЕ ПОДРЯДЧИКИ — после заявки, в самом конце: та же категория,
         ближе всего по цене, городу и стилю (lib/similar.ts). Заголовок —
         по разделу («Похожие ведущие»), а не общее «подрядчики». -->
    <RelatedCards
      title={`Похожие ${s.category.toLowerCase()}`}
      cards={similarSpecialists(s).map(specialistCard)}
    />
  </div>

  <BottomDock active="vendors" />
</Layout>

<style>
  .profile {
    padding-bottom: var(--dock-space);
  }

  /* Подписи первого экрана здесь больше нет: имя, специальность, рейтинг
     и портрет собирает сам HeroStage из пропов. Своя верстка на этом
     месте и была причиной разнобоя — у площадки, у подрядчика и у
     третьей карточки один компонент выглядел по-разному. */

  /* ============ УСЛОВИЯ И ЗАЯВКА (сразу под первым экраном) ============
     ЗАЛИВКИ ЦВЕТОМ ЗДЕСЬ БОЛЬШЕ НЕТ, и плашки тоже. Была алая карточка
     (.theme-accent): на телефоне она шла сразу под подписью первого
     экрана и била в глаз раньше самой работы подрядчика — цветной
     прямоугольник в проекте, где всё остальное живёт на бумаге.
     Устройство теперь ровно как у площадки (VenueHero): текст-продолжение
     подписи по полям --gutter и одна пилюля под ним. Вес даёт кегль. */
  .phero {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: var(--s-4) var(--gutter) 0;
    margin-bottom: var(--section-gap-tight);
  }

  /* Цена — крупно: якорь блока условий */
  .phero__price {
    font-size: var(--fs-h2);
    font-weight: var(--w-medium);
    line-height: var(--lh-heading);
    letter-spacing: var(--ls-display);
  }

  /* Строка фактов — вплотную под ценой: одна группа (внутреннее меньше
     внешнего), воздух остаётся только перед пилюлей. */
  .phero__price-note { margin-top: var(--s-1); }

  /* ============ О ПОДРЯДЧИКЕ ============ */
  .pabout {
    padding: 0 var(--gutter) var(--section-gap-tight);
  }

  /* Портрет слева, рассказ справа — но только на ПК: на телефоне кадр
     идёт над текстом во всю ширину колонки. Колонка текста не шире меры
     чтения, поэтому портрет получает фиксированный столбец, а не долю. */
  .pabout__body {
    display: grid;
    gap: var(--s-5);
    margin-top: var(--s-5);
  }

  @media (min-width: 900px) {
    .pabout__body {
      grid-template-columns: minmax(0, 320px) minmax(0, 1fr);
      align-items: start;
      gap: var(--s-7);
    }
  }

  /* Пропорция кадра своя, из файла: портрет не кропим под общую рамку
     (то же правило, что на первом экране и в галерее). */
  .pabout__portrait :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .pabout__text { max-width: var(--measure-text); }

  /* Отбивка между абзацами, а не над первым: сверху расстояние уже
     задал сам блок (--s-5 от заголовка). */
  .pabout__text + .pabout__text { margin-top: var(--s-4); }

  /* ============ ПОЧЕМУ ВЫБИРАЮТ ============
     Две колонки на ПК, одна на телефоне. Ни рамок, ни линий между
     пунктами: их разделяет воздух, заголовок пункта — сам себе знак. */
  .pwhy {
    padding: 0 var(--gutter) var(--section-gap-tight);
  }

  .pwhy__grid {
    display: grid;
    gap: var(--s-6) var(--s-7);
    margin-top: var(--s-5);
  }

  @media (min-width: 720px) {
    .pwhy__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  .pwhy__title {
    font-size: var(--fs-h3);
    font-weight: var(--w-head);
    line-height: var(--lh-heading);
  }

  .pwhy__text {
    margin-top: var(--s-2);
    max-width: var(--measure-text);
  }

  /* ============ ЧТО ВХОДИТ ============ */
  .ppack {
    padding: 0 var(--gutter) var(--section-gap-tight);
  }

  .ppack__list { margin-top: var(--s-5); }

  /* Стили галереи уехали в PhotoGallery.astro — секция общая с площадкой. */

  /* Демо-ряд постеров-заглушек (s.reels) — только рамка, ролики не играют */
  .preels { padding: 0 0 var(--section-gap-tight) var(--gutter); }
  .preels__rail {
    display: flex;
    gap: var(--s-3);
    margin-top: var(--s-5);
    padding-right: var(--gutter);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .preels__rail::-webkit-scrollbar { display: none; }
  .preels__item {
    flex: 0 0 clamp(180px, 48vw, 240px);
    scroll-snap-align: start;
    aspect-ratio: 2 / 3;
    background: var(--surface-dim);
  }

  /* ============ ПРЕДЛОЖЕНИЕ-ЦИТАТА ============ */
  .pquote {
    padding: 0 var(--gutter) var(--section-gap-tight);
  }

  .pquote__kicker { font-weight: var(--w-medium); }

  .pquote__body { margin-top: var(--s-4); }

  .pquote__text {
    font-size: var(--fs-h2);
    font-weight: var(--w-head);
    line-height: var(--lh-heading);
    letter-spacing: var(--ls-display);
    max-width: var(--measure-lead);
  }

  .pquote__author {
    margin-top: var(--s-4);
    font-weight: var(--w-medium);
  }

  /* Стили отзывов уехали в Reviews.astro — блок общий с карточкой
     площадки, и вид у него должен быть один. */

</style>

<!-- Якорь разбираем ДО модульных скриптов (те отложены и выполняются после
     разбора документа): нужный кадр должен встать сразу, иначе человек,
     нажавший в доске на ролик, на мгновение увидит чужое фото.
     Тот же приём и тот же код, что в VenueHero. -->


<script>
  import { bindSaveButtons } from '../../../../lib/save';
  import { bindVideo } from '../../../../lib/video';

  bindSaveButtons();
  // Ролик первого экрана оживляет сам HeroStage — тут только ряд «Видео».

  // Ряд «Видео» оживляет ReelsRow сам.
</script>
