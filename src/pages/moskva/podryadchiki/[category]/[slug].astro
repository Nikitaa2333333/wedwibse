---
// СТРАНИЦА-ВИЗИТКА СПЕЦИАЛИСТА — одна на все 19 категорий (реф. Cineteca
// Milano): крупная фото-карусель + контрастная инфо-плашка с ценой и заявкой.
// Раньше лежала отдельным роутом под ведущих; блоки те же, но всё, чего у
// подрядчика нет, просто не рендерится — цена, рейтинг, отзывы, видео.
//
// Открывается визитка у тех, у кого есть материал для неё (quote/offers),
// а не у всех карточек каталога: пустая страница-визитка хуже её отсутствия.
//
// Карточка, стоящая в двух категориях (пара «фото + видео» — и в
// «Фотографах», и в «Видеографах»), имеет РОВНО ОДИН адрес: путь строится
// по родной categorySlug, дубля страницы под тем же текстом нет.
import { Image } from 'astro:assets';
import Layout from '../../../../layouts/Layout.astro';
import SiteHeader from '../../../../components/SiteHeader.astro';
import BottomDock from '../../../../components/BottomDock.astro';
import PhotoRail from '../../../../components/PhotoRail.astro';
import Icon from '../../../../components/Icon.astro';
import BackButton from '../../../../components/BackButton.astro';
import { SPECIALISTS_BY_CATEGORY, FILTERS_BY_CATEGORY, type Specialist } from '../../../../data/specialists';
import { reelsOf } from '../../../../data/reels';
import { resolveImage, favoriteImage } from '../../../../lib/images';
import { frameId, photosOnly } from '../../../../lib/media';

export function getStaticPaths() {
  const seen = new Set<string>();

  return Object.values(SPECIALISTS_BY_CATEGORY)
    .flat()
    // визитка есть у тех, кто дал материал: предложение или список причин
    .filter((s) => s.quote || s.offers)
    .filter((s) => !seen.has(s.slug) && seen.add(s.slug))
    .map((s) => ({ params: { category: s.categorySlug, slug: s.slug }, props: { s } }));
}

const { s } = Astro.props as { s: Specialist };

function labelsFor(groupKey: string, values: string[]): string[] {
  const group = FILTERS_BY_CATEGORY[s.categorySlug]?.find((g) => g.key === groupKey);
  if (!group) return values;
  const map = new Map(group.options.map((o) => [o.value, o.label]));
  return values.map((v) => map.get(v) ?? v);
}

const priceFmt = new Intl.NumberFormat('ru-RU');
const styleLabels = s.styles ? labelsFor('style', s.styles) : [];
const bioParagraphs = s.bio.split('\n\n');

// Строка под ценой собирается из того, что есть: пустых «· ·» не остаётся
const priceFacts = [
  s.priceFrom ? 'за 6 часов работы' : null,
  s.experienceYears ? `${s.experienceYears} лет опыта` : null,
  s.hasOwnDJ ? 'свой диджей' : null,
  s.gender === 'pair' ? 'фото и видео' : null,
].filter(Boolean);

// ПЕРВЫЙ ЭКРАН — РЕЛЬС ИЗ ВСЕХ КАДРОВ: фотографии и ролики вперемешку,
// как в доске главной. Отдельной страницы у ролика нет — нажали на видео
// в доске, попали сюда, и рельс уже стоит на нём (якорь `#foto-<кадр>`
// разбирает инлайновый скрипт внизу, как в карточке площадки).
// Порядок: обложка, ролики, остальные фото — видео видно сразу, но
// первым кадром (и LCP) остаётся снимок.
// Кадров в рельсе ровно столько, сколько их уходит в доску главной
// (PER_SPECIALIST в lib/gallery): любой кадр, по которому там можно нажать,
// в рельсе есть, а строка точек-индикаторов не превращается в пунктир.
// Вся съёмка целиком — ниже, в блоке «Фотографии».
const HERO_PHOTOS = 12;
const reels = reelsOf(s.slug);
const frames = [
  ...new Set([s.photos[0], ...reels.map((r) => r.src), ...s.photos.slice(1, HERO_PHOTOS)]),
];

// Инициалы автора отзыва — для кружка-аватара, пока нет реального фото
function initials(author: string): string {
  return author
    .split(/\s+и\s+|\s+/)
    .filter((w) => /^[А-ЯЁA-Z]/.test(w))
    .map((w) => w[0])
    .slice(0, 2)
    .join('');
}

const priceLabel = s.priceFrom ? `от ${priceFmt.format(s.priceFrom)} ₽` : 'Цена по запросу';
const href = `/moskva/podryadchiki/${s.categorySlug}/${s.slug}/`;

const saveData = JSON.stringify({
  id: `${s.categorySlug}:${s.slug}`,
  cat: s.categorySlug,
  catLabel: s.category,
  name: s.name,
  meta: styleLabels[0] || s.tagline,
  price: priceLabel,
  rating: s.rating,
  img: await favoriteImage(s.photos[0]),
  href,
});
---

<Layout
  title={`${s.name} — ${s.category.toLowerCase()} на свадьбу в Москве и области — WED Secrets`}
  description={`${s.name} — ${s.tagline.toLowerCase()}. ${s.category} на свадьбу в Москве и Московской области.`}
>
  <SiteHeader />

  <div class="profile">
    <!-- ГЕРОЙ: инфо-плашка + крупная фото-карусель встык (реф. Cineteca).
         Кнопка «назад» — на кадре, не текстовая крошка на плашке: тот же
         паттерн, что у карточки площадки (см. BackButton.astro). -->
    <section class="phero">
      <div class="phero__card theme-accent">
        <div class="phero__top">
          <h1 class="phero__name">{s.name}</h1>
          <p class="t-lead phero__tagline">{s.tagline}</p>
          {s.rating && s.reviews && (
            <a class="pill pill--sm phero__rate" href="#otzyvy">★ {s.rating.toFixed(1)} · {s.reviews}&nbsp;отзывов</a>
          )}
        </div>

        <div class="phero__deal">
          <p class="phero__price">{priceLabel}</p>
          <p class="t-caption phero__price-note">
            {priceFacts.join(' · ')}
          </p>
          <a class="pill pill--lg" href="#zayavka">Оставить заявку</a>
        </div>
      </div>

      <div class="phero__media" data-hero-rail data-frames={JSON.stringify(frames.map(frameId))}>
        <BackButton href={`/moskva/podryadchiki/${s.categorySlug}/`} label={`К списку «${s.category}»`} />

        <PhotoRail
          photos={frames}
          alt={s.name}
          sizes="(min-width: 1024px) 50vw, 100vw"
          {/* до 1800, как в геро-кадре площадки: на телефоне кадр идёт во
              всю ширину, и при DPR 2 ему нужно ~1600-1800 реальных пикселей —
              с потолком 1200 браузер растягивал кадр и тот заметно мылил */}
          widths={[480, 800, 1200, 1800]}
          priority
        >
          <button class="save" type="button" data-save={saveData} aria-pressed="false" aria-label="В избранное">
            <Icon name="heartOutline" />
          </button>
        </PhotoRail>
      </div>
    </section>

    <!-- О ПОДРЯДЧИКЕ -->
    <section class="pabout">
      <h2 class="t-h2">{s.aboutTitle ?? 'О подрядчике'}</h2>
      {bioParagraphs.map((p) => <p class="pabout__text">{p}</p>)}
    </section>

    <!-- ПОЧЕМУ ВЫБИРАЮТ: причины формулирует сам подрядчик. Заголовок
         пункта — отдельной строкой h3, а не жирной фразой внутри абзаца. -->
    {s.offers && (
      <section class="pwhy">
        <h2 class="t-h2">Почему выбирают</h2>
        <div class="pwhy__grid" data-reveal-group>
          {s.offers.map((offer) => (
            <article class="pwhy__item" data-reveal>
              <h3 class="pwhy__title">{offer.title}</h3>
              <p class="pwhy__text">{offer.text}</p>
            </article>
          ))}
        </div>
      </section>
    )}

    <!-- ЧТО ВХОДИТ В ПАКЕТ -->
    {s.packageIncludes && (
      <section class="ppack">
        <h2 class="t-h2">Что входит</h2>
        <ul class="ppack__list list">
          {s.packageIncludes.map((item) => <li>{item}</li>)}
        </ul>
      </section>
    )}

    <!-- ГАЛЕРЕЯ: компактная ровная сетка, без растянутых кадров -->
    <section class="pgallery">
      <h2 class="t-h2">Фотографии</h2>
      <div class="pgallery__grid" data-reveal-group>
        {photosOnly(s.photos).map((src, n) => (
          <figure class="pgallery__cell media" data-reveal>
            <Image
              src={resolveImage(src)}
              alt={`${s.name} — фото ${n + 1}`}
              widths={[360, 560, 800, 1100]}
              sizes="(min-width: 900px) 33vw, 50vw"
              loading="lazy"
              decoding="async"
            />
          </figure>
        ))}
      </div>
    </section>

    <!-- ВИДЕО отдельной секцией у подрядчика с реальными роликами нет:
         они лежат кадрами в первом экране, вперемешку с фотографиями.
         Ниже — старый демо-блок постеров (карточки-заглушки прототипа). -->
    {!reels.length && s.reels && (
      <section class="preels">
        <h2 class="t-h2">Видео</h2>
        <div class="preels__rail" data-reveal-group>
          {s.reels.map((reel, n) => (
            <figure class="preels__item media" data-reveal>
              <Image
                src={resolveImage(reel.poster)}
                alt={`${s.name} — видео ${n + 1}`}
                widths={[240, 360, 480]}
                sizes="(min-width: 1024px) 220px, 48vw"
                loading="lazy"
                decoding="async"
              />
            </figure>
          ))}
        </div>
      </section>
    )}

    <!-- ПРЕДЛОЖЕНИЕ ОТ ПОДРЯДЧИКА: формулирует сам, подаём цитатой -->
    {s.quote && (
      <section class="pquote">
        <p class="t-caption pquote__kicker">Предложение</p>
        <blockquote class="pquote__body">
          <p class="pquote__text">{s.quote}</p>
          <footer class="pquote__author t-small">{s.name} · {s.category.toLowerCase()}</footer>
        </blockquote>
      </section>
    )}

    <!-- ОТЗЫВЫ: вертикально, один в ряд, с автором и датой -->
    {s.reviewsList && (
      <section class="previews" id="otzyvy">
        <h2 class="t-h2">Отзывы</h2>
        <div class="previews__list" data-reveal-group>
          {s.reviewsList.map((r) => (
            <article class="preview" data-reveal>
              <header class="preview__head">
                {r.photo ? (
                  <span class="preview__avatar media">
                    <Image src={resolveImage(r.photo)} alt={r.author} widths={[96]} sizes="48px" loading="lazy" decoding="async" />
                  </span>
                ) : (
                  <span class="preview__avatar preview__avatar--initials" aria-hidden="true">{initials(r.author)}</span>
                )}
                <div class="preview__who">
                  <p class="preview__author">{r.author}</p>
                  <p class="preview__date t-caption">{r.date}</p>
                </div>
                <p class="preview__rate" aria-label={`Оценка ${r.rating} из 5`}>{'★'.repeat(r.rating)}{'☆'.repeat(5 - r.rating)}</p>
              </header>
              <p class="preview__text">«{r.text}»</p>
            </article>
          ))}
        </div>
      </section>
    )}

    <!-- ЗАЯВКА -->
    <section class="pcta theme-accent" id="zayavka">
      <h2 class="t-h2">Забронировать на свою свадьбу</h2>
      <p class="t-small pcta__note">Оставьте заявку — менеджер свяжется и уточнит дату и детали.</p>
      <a class="pill pill--lg" href="#">Оставить заявку</a>
    </section>
  </div>

  <BottomDock active="vendors" />
</Layout>

<style>
  .profile {
    padding-bottom: calc(var(--safe-b) + 120px);
  }

  /* ============ ГЕРОЙ: плашка + карусель встык ============
     Мобилка: фото сверху во всю ширину, плашка под ним.
     ПК: сплит-полоса в край экрана — плашка слева, карусель справа. */
  .phero {
    display: grid;
    grid-template-areas: 'media' 'card';
    margin-bottom: var(--section-gap-tight);
  }

  /* position: relative на всех ширинах — держит BackButton прижатым
     к кадру, а не к секции целиком; на десктопе низкий приоритет
     переопределяет ниже (там медиа и так растянута абсолютом). */
  .phero__media { grid-area: media; position: relative; }

  /* Якорная композиция: имя с теглайном тяготеют к верху плашки,
     цена с кнопкой — к низу, середина дышит (space-between). */
  .phero__card {
    grid-area: card;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--s-6);
    padding: var(--s-6) var(--gutter);
  }

  .phero__top {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-4);
  }

  /* Имя — главный объект экрана, но без гигантизма: блок держим низким */
  .phero__name {
    font-size: clamp(40px, 5.5vw, 64px);
    font-weight: var(--w-head);
    line-height: var(--lh-display);
    letter-spacing: var(--ls-display);
    max-width: var(--measure-head);
  }

  .phero__tagline { max-width: var(--measure-lead); }

  .phero__rate { text-decoration: none; }

  .phero__deal {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-2);
  }

  /* Цена — крупно, второй якорь плашки */
  .phero__price {
    font-size: var(--fs-h2);
    font-weight: var(--w-medium);
    line-height: var(--lh-heading);
    letter-spacing: var(--ls-display);
  }

  .phero__deal .pill { margin-top: var(--s-3); }

  @media (min-width: 1024px) {
    .phero {
      grid-template-areas: 'card media';
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: stretch;
      /* Высоту задаёт контент карточки — герой остаётся компактной
         горизонтальной полосой и целиком влезает в экран с запасом. */
    }

    .phero__card {
      padding: var(--s-6) var(--s-7) var(--s-6) var(--gutter);
    }

    /* Кадр НЕ диктует высоту блока: колонка фото — просто холст,
       карусель растянута абсолютом по высоте карточки */
    .phero__media { position: relative; }

    .phero__media :global(.prail-wrap) {
      position: absolute;
      inset: 0;
    }

    /* Кадр забирает всю свободную высоту, точки под ним — свою строку.
       С height: 100% точки выпадали за нижний край колонки. */
    .phero__media :global(.prail) {
      aspect-ratio: auto;
      flex: 1;
      min-height: 0;
    }

    /* Горизонтальный кроп портрета: держим верх кадра — не режем голову */
    .phero__media :global(.prail__item img) { object-position: center top; }
  }

  /* ============ О ПОДРЯДЧИКЕ ============ */
  .pabout {
    padding: 0 var(--gutter) var(--section-gap-tight);
  }

  .pabout__text {
    max-width: var(--measure-text);
    margin-top: var(--s-4);
  }

  /* ============ ПОЧЕМУ ВЫБИРАЮТ ============
     Две колонки на ПК, одна на телефоне. Ни рамок, ни линий между
     пунктами: их разделяет воздух, заголовок пункта — сам себе знак. */
  .pwhy {
    padding: 0 var(--gutter) var(--section-gap-tight);
  }

  .pwhy__grid {
    display: grid;
    gap: var(--s-6) var(--s-7);
    margin-top: var(--s-5);
  }

  @media (min-width: 720px) {
    .pwhy__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  .pwhy__title {
    font-size: var(--fs-h3);
    font-weight: var(--w-head);
    line-height: var(--lh-heading);
  }

  .pwhy__text {
    margin-top: var(--s-2);
    max-width: var(--measure-text);
  }

  /* ============ ЧТО ВХОДИТ ============ */
  .ppack {
    padding: 0 var(--gutter) var(--section-gap-tight);
  }

  .ppack__list { margin-top: var(--s-5); }

  /* ============ ГАЛЕРЕЯ ============ */
  .pgallery {
    padding: 0 var(--gutter) var(--section-gap-tight);
  }

  .pgallery__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-3);
    margin-top: var(--s-5);
  }

  .pgallery__cell { aspect-ratio: 3 / 4; }

  @media (min-width: 900px) {
    .pgallery__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  /* ============ ВИДЕО-РОЛИКИ ============
     Вертикальные 2:3 карточки, листаются вбок (scroll-snap),
     как карусели карточек каталога. */
  .preels {
    padding: 0 0 var(--section-gap-tight) var(--gutter);
  }

  .preels__rail {
    display: flex;
    gap: var(--s-3);
    margin-top: var(--s-5);
    padding-right: var(--gutter);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    /* жест на рельсе — только по горизонтали, без косого свайпа (см. FilterBar) */
    touch-action: pan-x;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .preels__rail::-webkit-scrollbar { display: none; }

  .preels__item {
    position: relative;
    flex: 0 0 clamp(180px, 48vw, 240px);
    aspect-ratio: 2 / 3;
    scroll-snap-align: start;
    background: var(--surface-dim);
  }

  /* ============ ПРЕДЛОЖЕНИЕ-ЦИТАТА ============ */
  .pquote {
    padding: 0 var(--gutter) var(--section-gap-tight);
  }

  .pquote__kicker { font-weight: var(--w-medium); }

  .pquote__body { margin-top: var(--s-4); }

  .pquote__text {
    font-size: var(--fs-h2);
    font-weight: var(--w-head);
    line-height: var(--lh-heading);
    letter-spacing: var(--ls-display);
    max-width: var(--measure-lead);
  }

  .pquote__author {
    margin-top: var(--s-4);
    font-weight: var(--w-medium);
  }

  /* ============ ОТЗЫВЫ: вертикальный список ============ */
  .previews {
    padding: 0 var(--gutter) var(--section-gap-tight);
  }

  .previews__list {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    margin-top: var(--s-5);
  }

  .preview {
    max-width: var(--measure-prose);
    padding: var(--s-5);
    background: var(--surface-dim);
  }

  .preview__head {
    display: flex;
    align-items: center;
    gap: var(--s-3);
  }

  .preview__avatar {
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    border-radius: 50%;
    overflow: hidden;
  }

  /* Пока нет реального фото автора — кружок с инициалами */
  .preview__avatar--initials {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg);
    font-size: var(--fs-small);
    font-weight: var(--w-medium);
  }

  .preview__who { flex: 1; min-width: 0; }

  .preview__author { font-weight: var(--w-medium); }

  .preview__rate {
    font-size: var(--fs-small);
    letter-spacing: 2px;
    flex-shrink: 0;
  }

  .preview__text {
    margin-top: var(--s-4);
    max-width: var(--measure-text);
  }

  /* ============ ЗАЯВКА ============ */
  .pcta {
    padding: var(--section-gap) var(--gutter);
  }

  .pcta h2 { max-width: var(--measure-head); }

  .pcta__note {
    margin-top: var(--s-3);
    max-width: var(--measure-lead);
  }

  .pcta .pill { margin-top: var(--s-5); }
</style>

<!-- Якорь разбираем ДО модульных скриптов (те отложены и выполняются после
     разбора документа): рельс должен сразу встать на нужный кадр, иначе
     человек, нажавший в доске на ролик, на мгновение увидит чужое фото.
     Тот же приём, что в VenueHero. -->
<script is:inline>
  (() => {
    const host = document.querySelector('[data-hero-rail]');
    const id = (location.hash.match(/^#foto-(.+)$/) || [])[1];
    if (!host || !id) return;

    const frames = JSON.parse(host.dataset.frames || '[]');
    const index = frames.indexOf(decodeURIComponent(id));
    if (index < 1) return; // 0 и «кадр не найден» — рельс и так стоит на первом

    host.querySelector('[data-prail-host]').dataset.start = String(index);
    host.querySelector('.prail__track').style.setProperty('--i', String(index));

    const img = host.querySelector(`img[data-frame="${CSS.escape(frames[index])}"]`);
    if (img) {
      img.loading = 'eager';
      img.fetchPriority = 'high';
    }
  })();
</script>

