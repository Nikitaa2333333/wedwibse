---
// ВХОД ПОДРЯДЧИКА И ПЛОЩАДКИ — по макету (Figma Никиты): почта и пароль,
// ниже «или» и плашки Telegram и MAX (docs/archive/CABINET-razbor.md §9, §22, §23). Плашки
// работают сами (TelegramButton, MaxButton): учётки нет — экран условий
// /profi/usloviya/, есть — «Мои карточки». ?invite=… — личная ссылка пилота,
// ?next=… — куда вернуть после входа; обе едут и на регистрацию и сброс.
// 27.10 экран переписывали в стиле админки — вернули макет (Никита, 31.10).
import ProfiShell from '../../components/profi/ProfiShell.astro';
import AuthMethods from '../../components/profi/AuthMethods.astro';
import '../../components/profi/auth.css';
---

<ProfiShell title="Вход" look="auth">
  <main class="container auth">
    <div class="auth__head">
      <h1 class="t-h1" data-title>Вход</h1>
    </div>

    <form class="auth__form auth__form--lg" data-mail-login data-login-only>
      <input class="input" type="email" name="email" placeholder="Почта" aria-label="Почта" autocomplete="username" inputmode="email" autocapitalize="off" spellcheck="false" required />
      <input class="input" type="password" name="password" placeholder="Пароль" aria-label="Пароль" autocomplete="current-password" required />
      <a class="auth__forgot" href="/profi/parol/" data-keep-query>Забыли пароль?</a>
      <p class="auth__error" role="alert" data-mail-error hidden></p>
      <button class="pill pill--lg pill--solid pill--block" type="submit">Войти</button>
    </form>

    <p class="auth__divider" data-login-only>или</p>

    <AuthMethods />

    <p class="auth__alt" data-link-only hidden><a href="/profi/moi/profil/">Вернуться в профиль</a></p>
    <p class="auth__alt" data-login-only>Нет учётки? <a href="/profi/registraciya/" data-keep-query>Зарегистрироваться</a></p>
  </main>
</ProfiShell>

<script>
  import { api, session } from '../../lib/cabinet-api';
  import { afterLogin, linkVia } from '../../lib/tg-login';
  import { loginWithPassword } from '../../lib/email-login';

  const q = new URLSearchParams(location.search);
  // «Подключить» из профиля (?via=telegram|max, учётка уже открыта): на экране
  // только кнопка этого мессенджера, она привязывает его к учётке (tg-login.ts)
  const via = linkVia();
  if (via) {
    document.querySelector('[data-title]')!.textContent = `Подключить ${via === 'max' ? 'MAX' : 'Telegram'}`;
    document.title = 'Подключить мессенджер';
    document.querySelectorAll<HTMLElement>('[data-login-only]').forEach((el) => { el.style.display = 'none'; });
    document.querySelectorAll<HTMLElement>('[data-link-only]').forEach((el) => { el.hidden = false; });
    const other = document.querySelector<HTMLElement>(via === 'max' ? '[data-tg-login]' : '[data-max-login]');
    if (other) other.style.display = 'none';
  }
  // вошли раньше и это не приглашение — сразу в кабинет
  else if (session('vendor') && !q.get('invite')) afterLogin(q.get('next') || undefined);
  // вошли раньше и открыли ссылку-приглашение — гасим ключ сразу, без
  // повторного входа (пилот 04.11: Никита открывал ссылку уже вошедшим,
  // страница показывала форму, и карточка не привязывалась)
  if (session('vendor') && q.get('invite')) {
    api('vendor', 'POST', '/api/wed/invite', { invite: q.get('invite') })
      .then(() => afterLogin(q.get('next') || undefined))
      .catch((err) => {
        const box = document.querySelector<HTMLElement>('[data-mail-error]')!;
        box.textContent = `${(err as Error).message} Можно войти другой учёткой ниже.`;
        box.hidden = false;
      });
  }

  document.querySelectorAll<HTMLAnchorElement>('[data-keep-query]').forEach((a) => { a.search = location.search; });

  const form = document.querySelector<HTMLFormElement>('[data-mail-login]')!;
  const error = form.querySelector<HTMLElement>('[data-mail-error]')!;
  form.addEventListener('submit', async (ev) => {
    ev.preventDefault();
    error.hidden = true;
    const btn = form.querySelector('button')!;
    btn.disabled = true;
    try {
      const f = new FormData(form);
      await loginWithPassword(String(f.get('email')).trim(), String(f.get('password')));
      // приглашение пилота: учётка уже есть — ключ гасится отдельным маршрутом
      const invite = q.get('invite');
      if (invite) await api('vendor', 'POST', '/api/wed/invite', { invite });
      afterLogin(q.get('next') || undefined);
    } catch (err) {
      error.textContent = (err as Error).message;
      error.hidden = false;
    } finally {
      btn.disabled = false;
    }
  });
</script>
