---
// ОЧЕРЕДЬ МОДЕРАТОРА — прототип (CABINET.md §12.5). Вид — как отчёт
// Яндекс Метрики (Никита, 24.10.2026): сверху период и ряд показателей,
// под ними таблица правок с вкладками полос (§12.2): «Ждут решения» — на
// сайте прежняя версия; «Проверить после» — уже на сайте, откат одной
// кнопкой; «Прошли сами» — для сведения. Сводка в строке — та же, что уйдёт
// уведомлением в Telegram. Данные — ЗАГЛУШКА moderation-demo.ts поверх
// настоящих карточек; вживую — `revisions`.
import { Image } from 'astro:assets';
import ModFrame from '../../../components/profi/ModFrame.astro';
import ProfiShell from '../../../components/profi/ProfiShell.astro';
import { resolveImage, IMG_WIDTHS } from '../../../lib/images';
import { buildReview, plural } from '../../../lib/moderation';
import { LANE, QUEUE, type Lane } from '../../../data/moderation-demo';

const reviews = QUEUE.map(buildReview);
const oldest = reviews.find((r) => r.rev.waiting);
const n = (lane: Lane) => reviews.filter((r) => r.rev.lane === lane).length;

// ЗАГЛУШКА показателей: вживую — из журнала решений модератора
const stats = [
  { dot: 'red', label: LANE.red.queue, num: n('red'), note: oldest ? `Дольше всех ждёт ${oldest.card.name} — ${oldest.rev.waiting}` : 'Очередь пуста' },
  { dot: 'yellow', label: LANE.yellow.queue, num: n('yellow'), note: 'Уже на сайте, проверить до конца дня' },
  { dot: 'green', label: LANE.green.queue, num: n('green'), note: 'Мелкие правки, опубликованы сразу' },
  { dot: '', label: 'Среднее время ответа', num: '1 ч 40 мин', note: 'Обещаем подрядчикам — до 24 часов' },
];
const tabs: { key: 'all' | Lane; label: string; n: number }[] = [
  { key: 'all', label: 'Все', n: reviews.length },
  ...(['red', 'yellow', 'green'] as Lane[]).map((l) => ({ key: l, label: LANE[l].queue, n: n(l) })),
];
---

<ProfiShell title="Модерация" look="mod">
  <ModFrame active="all">
    <header class="mhead">
      <h1 class="mhead__title">Модерация</h1>
      <div class="mseg" role="group" aria-label="Период">
        {['Сегодня', 'Вчера', 'Неделя', 'Месяц'].map((p, i) => (
          <button class:list={['mseg__btn', { 'is-active': i === 0 }]} type="button" data-period>{p}</button>
        ))}
      </div>
      <p class="mhead__sub">24 октября 2026 · правки из кабинета подрядчиков и площадок</p>
    </header>

    <section class="mstats" aria-label="Сводка">
      {stats.map((s) => (
        <div class="mcard mstat">
          <span class="mstat__label">{s.dot && <span class={`mdot mdot--${s.dot}`}></span>}{s.label}</span>
          <span class="mstat__num">{s.num}</span>
          <span class="mstat__note">{s.note}</span>
        </div>
      ))}
    </section>

    <section class="mcard mcard--flush">
      <div class="mtabs" role="tablist">
        {tabs.map((t, i) => (
          <button class:list={['mtabs__btn', { 'is-active': i === 0 }]} type="button" role="tab" data-tab={t.key}>
            {t.label} {t.n}
          </button>
        ))}
        <label class="q__search">
          <span class="visually-hidden">Поиск по имени</span>
          <input class="q__input" type="search" placeholder="Поиск по имени" data-search />
        </label>
      </div>
      <div class="q__bulk" data-bulk hidden>
        <span data-bulk-count></span>
        <button class="mbtn" type="button" data-bulk-ok>Отметить проверенными</button>
        <button class="mbtn mbtn--danger" type="button" data-bulk-clear>Снять выбор</button>
      </div>
      <table class="mtable">
        <thead>
          <tr>
            <th class="q__pick"><span class="visually-hidden">Выбрать</span></th>
            <th>Карточка</th>
            <th>Полоса</th>
            <th>Что поменялось</th>
            <th>Автопроверка</th>
            <th class="mtable__num">Ждёт / пришло</th>
          </tr>
        </thead>
        <tbody>
          {reviews.map((r) => (
            <tr data-lane={r.rev.lane} data-name={r.card.name.toLowerCase()} data-href={`/profi/moderaciya/${r.rev.id}/`}>
              <td class="q__pick">
                {r.rev.lane !== 'red' && <input class="q__box" type="checkbox" aria-label={`Выбрать: ${r.card.name}`} data-pick />}
              </td>
              <td>
                <a class="q__card" href={`/profi/moderaciya/${r.rev.id}/`}>
                  <span class="q__media">
                    {r.photos.after[0] && (
                      <Image src={resolveImage(r.photos.after[0])} alt="" widths={[...IMG_WIDTHS.thumb]} sizes="40px" class="q__img" />
                    )}
                  </span>
                  <span class="q__who">
                    <span class="q__name">{r.card.name}</span>
                    <span class="q__role">{r.role}{r.rev.first ? ' · первая публикация' : ''}</span>
                  </span>
                </a>
              </td>
              <td><span class={`status ${LANE[r.rev.lane].status}`}>{LANE[r.rev.lane].label}</span></td>
              <td class="q__sum">{r.summary}</td>
              <td>
                {r.rev.flags.length
                  ? <span class="q__flags">{r.rev.flags.length} {plural(r.rev.flags.length, 'флажок', 'флажка', 'флажков')}</span>
                  : 'чисто'}
              </td>
              <td class="mtable__num">{r.rev.waiting ? <span class="q__wait">ждёт {r.rev.waiting}</span> : r.rev.submitted.replace('Сегодня, ', '')}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  </ModFrame>
</ProfiShell>

<script>
  // ПРОТОТИП: вкладки полос и период фильтруют на клиенте; вживую — запрос к базе.
  const rows = [...document.querySelectorAll<HTMLElement>('tr[data-lane]')];
  const tabs = [...document.querySelectorAll<HTMLElement>('[data-tab]')];
  const links = [...document.querySelectorAll<HTMLElement>('[data-lane-link]')];
  const show = (key: string) => {
    tabs.forEach((t) => t.classList.toggle('is-active', t.dataset.tab === key));
    links.forEach((l) => l.classList.toggle('is-active', l.dataset.laneLink === key));
    lane = key;
    apply();
  };
  let lane = 'all';
  let query = '';
  const apply = () =>
    rows.forEach((r) => (r.hidden = (lane !== 'all' && r.dataset.lane !== lane) || !r.dataset.name!.includes(query)));
  document.querySelector<HTMLInputElement>('[data-search]')?.addEventListener('input', (e) => {
    query = (e.target as HTMLInputElement).value.trim().toLowerCase();
    apply();
  });

  // Массовое действие (Shopify): уже опубликованные правки отмечаются
  // проверенными пачкой. Ждущие решения — только по одной, через разбор.
  const bulk = document.querySelector<HTMLElement>('[data-bulk]');
  const picks = [...document.querySelectorAll<HTMLInputElement>('[data-pick]')];
  const syncBulk = () => {
    const n = picks.filter((p) => p.checked).length;
    if (!bulk) return;
    bulk.hidden = n === 0;
    bulk.querySelector('[data-bulk-count]')!.textContent = `Выбрано: ${n}`;
  };
  picks.forEach((p) => p.addEventListener('change', syncBulk));
  document.querySelector('[data-bulk-clear]')?.addEventListener('click', () => {
    picks.forEach((p) => (p.checked = false));
    syncBulk();
  });
  document.querySelector('[data-bulk-ok]')?.addEventListener('click', () => {
    picks.filter((p) => p.checked).forEach((p) => p.closest('tr')?.remove());
    syncBulk();
  });
  tabs.forEach((t) => t.addEventListener('click', () => {
    history.replaceState(null, '', t.dataset.tab === 'all' ? location.pathname : `#${t.dataset.tab}`);
    show(t.dataset.tab!);
  }));
  const fromHash = () => show(['red', 'yellow', 'green'].includes(location.hash.slice(1)) ? location.hash.slice(1) : 'all');
  window.addEventListener('hashchange', fromHash);
  fromHash();

  // Вся строка таблицы ведёт в разбор, ссылка в первой ячейке — для клавиатуры и без JS
  rows.forEach((r) => r.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a, input, .q__pick')) return;
    location.href = r.dataset.href!;
  }));

  document.querySelectorAll<HTMLElement>('[data-period]').forEach((b, _, all) =>
    b.addEventListener('click', () => all.forEach((x) => x.classList.toggle('is-active', x === b))),
  );
</script>

<style>
  .q__card { display: flex; align-items: center; gap: var(--s-3); color: inherit; text-decoration: none; min-width: 0; }
  .q__media { width: 40px; height: 50px; flex: none; border-radius: 6px; overflow: hidden; background: var(--surface-dim); }
  :global(.q__img) { width: 100%; height: 100%; object-fit: cover; }
  .q__who { display: grid; gap: 2px; min-width: 0; }
  .q__name { font-weight: var(--w-head); }
  .q__role { font-size: var(--mod-fs-sm); }
  .q__sum { max-width: 34ch; }
  .q__flags { color: var(--st-bad-text); font-weight: var(--w-medium); }
  .q__wait { font-weight: var(--w-medium); }

  .q__search { margin-left: auto; padding-block: 6px; flex: none; }
  .q__input {
    width: 200px;
    max-width: 100%;
    padding: 7px 12px;
    border: 1px solid var(--mod-line);
    border-radius: var(--mod-radius-btn);
    background: var(--mod-card);
    font: inherit;
    font-size: var(--mod-fs);
  }
  .q__input:focus-visible { outline: 2px solid var(--mod-link); outline-offset: -1px; }

  .q__bulk {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-2) var(--s-4);
    background: var(--mod-hover);
    border-bottom: 1px solid var(--mod-line);
    font-weight: var(--w-medium);
  }
  .q__bulk[hidden] { display: none; }

  .q__pick { width: 1%; padding-right: 0; }
  .q__box { width: 18px; height: 18px; accent-color: var(--fg); cursor: pointer; }
  @media (hover: hover) { tr:hover .q__name { color: var(--mod-link); } }
  @media (max-width: 1023px) {
    .q__card { margin-bottom: var(--s-2); }
    .q__sum { max-width: none; }
  }
</style>
