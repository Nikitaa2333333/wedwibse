---
// ПРЕВЬЮ АНКЕТЫ ДО ОДОБРЕНИЯ (STAGE2.md, 03.11): подрядчик видит страницу
// один в один с сайтом ещё до решения модератора. Единственная страница
// сайта, которую рисует сервер в момент открытия (`prerender = false`),
// остальные собираются заранее.
//
// Путь данных тот же, что у опубликованной карточки:
//   база: анкета → buildPage (как при одобрении) — /api/wed/preview?t=
//   здесь: cardFromPage (как в сборке, lib/cabinet-card.mjs) → SpecialistProfile;
//   площадка (08.11) — venueFromPage (как сайт из базы, lib/cabinet-venue.mjs) → VenuePage
// Ссылку ?t= выдаёт кабинет (/api/wed/preview-link) — подписана, 15 минут,
// только к своей анкете. В поиск страница не идёт (noindex).
export const prerender = false;

import { inferRemoteSize } from 'astro:assets';
import CabinetShell from '../../../components/admin/CabinetShell.astro';
import SpecialistProfile from '../../../components/SpecialistProfile.astro';
import VenuePage from '../../../components/VenuePage.astro';
import type { Venue } from '../../../data/venues';
import { venueFromPage } from '../../../lib/cabinet-venue.mjs';
import { SPECIALIST_CATEGORIES, type Specialist } from '../../../data/specialists';
import { cardFromPage, orderedPhotos } from '../../../lib/cabinet-card.mjs';
import { registerRemote } from '../../../lib/images';

// база — по внутреннему адресу на том же сервере; файлы — по публичному
// (их пережимает /_image, адрес разрешён в astro.config: image.remotePatterns)
const PB = (process.env.PB_INTERNAL_URL || 'http://127.0.0.1:8090').replace(/\/$/, '');
const FILES = (process.env.PREVIEW_FILES_URL || 'https://wed-secrets.ru').replace(/\/$/, '');

Astro.response.headers.set('cache-control', 'no-store');
Astro.response.headers.set('x-robots-tag', 'noindex, nofollow');

let card: Specialist | null = null;
let venue: Venue | null = null;
let problem = '';
const t = Astro.url.searchParams.get('t') || '';

try {
  if (!t) throw new Error('Откройте превью из кабинета — кнопкой «Посмотреть, как будет выглядеть».');
  const r = await fetch(`${PB}/api/wed/preview?t=${encodeURIComponent(t)}`, { signal: AbortSignal.timeout(15000) });
  const res = await r.json().catch(() => ({}));
  if (!r.ok) throw new Error(res.message || 'Превью не открылось — попробуйте ещё раз из кабинета.');
  const p = res.page ?? {};
  const names = orderedPhotos(p);
  if (!names.length) throw new Error('В анкете пока нет фото — добавьте их, и превью покажет страницу целиком.');

  const photos = await Promise.all(names.map(async (name: string) => {
    // кадр отдаёт база по той же 15-минутной ссылке и только кадры этой анкеты
    // (ключа подрядчика в адресах больше нет — аудит 05.11)
    const key = `${FILES}${res.files}${encodeURIComponent(name)}`;
    const size = await inferRemoteSize(key);
    registerRemote(key, { src: key, width: size.width, height: size.height, format: size.format } as ImageMetadata);
    return key;
  }));

  if (res.kind === 'venue') {
    const byName = new Map(names.map((n: string, i: number) => [n, photos[i]]));
    venue = venueFromPage(p, { slug: p.slug || 'prevyu', name: p.name, photos, fileOf: (n: string) => byName.get(n) }) as Venue;
  } else card = {
    ...cardFromPage(p, { slug: p.slug || 'prevyu', categorySlug: p.categorySlug, name: p.name, photos }),
    category: SPECIALIST_CATEGORIES.find((c) => c.slug === p.categorySlug)?.label ?? p.categorySlug,
  } as Specialist;
} catch (err) {
  problem = (err as Error).message;
  Astro.response.status = 400;
}
---

{venue ? (
  <VenuePage venue={venue} preview />
) : card ? (
  <SpecialistProfile s={card} preview />
) : (
  <CabinetShell title="Превью" bare>
    <section class="a-card a-login">
      <h1 class="a-h1">Превью не открылось</h1>
      <p class="a-lead">{problem}</p>
      <a class="c-link" href="/profi/moi/">Вернуться в кабинет</a>
    </section>
  </CabinetShell>
)}
