---
// ВХОД ПО ЛИЧНОЙ ССЫЛКЕ — пилот на 25 существующих карточках (решение
// 20.10.2026, CABINET.md §22). Никита сам отправляет владельцу ссылку;
// владелец видит СВОЮ карточку, принимает условия и входит через Telegram —
// учётка привязывается к карточке. Вживую ссылка одноразовая
// (/profi/priglashenie/<токен>/); в прототипе — пример на карточке Сухорады.
import { Image } from 'astro:assets';
import ProfiShell from '../../components/profi/ProfiShell.astro';
import TelegramButton from '../../components/profi/TelegramButton.astro';
import Icon from '../../components/Icon.astro';
import { resolveImage, IMG_WIDTHS } from '../../lib/images';
---

<ProfiShell title="Ваша карточка в каталоге">
  <main class="section container inv" data-consent>
    <h1 class="t-h1">Это ваша карточка</h1>
    <p class="inv__lead">Мы уже собрали её по вашим материалам. Войдите, чтобы править её сами: текст, цены, фото и видео.</p>

    <a class="inv__card" href="/moskva/podryadchiki/fotografy/suhorada/">
      <Image
        src={resolveImage('/specialists/fotografy/suhorada/gal/p09.webp')}
        alt="Алексей Сухорада"
        widths={[...IMG_WIDTHS.card]}
        sizes="(min-width: 720px) 280px, 45vw"
        class="inv__img"
      />
      <span class="inv__name">Алексей Сухорада</span>
      <span class="inv__role">Фотограф · от 40 000 ₽</span>
    </a>

    <div class="inv__checks">
      <label class="check">
        <input class="check__input" type="checkbox" data-consent-box />
        <span class="check__box"><Icon name="check" /></span>
        <span>Принимаю <a href="/profi/#usloviya">условия размещения (оферту)</a></span>
      </label>
      <label class="check">
        <input class="check__input" type="checkbox" data-consent-box />
        <span class="check__box"><Icon name="check" /></span>
        <span>Даю <a href="/profi/#usloviya">согласие на обработку персональных данных</a></span>
      </label>
    </div>

    <div class="inv__go" data-consent-gate aria-disabled="true">
      <TelegramButton label="Войти через Telegram" />
    </div>
    <p class="inv__note">Почту можно подключить потом в кабинете — чтобы входить и без Telegram.</p>
  </main>
</ProfiShell>

<script>
  const root = document.querySelector('[data-consent]');
  if (root) {
    const boxes = [...root.querySelectorAll<HTMLInputElement>('[data-consent-box]')];
    const gate = root.querySelector<HTMLElement>('[data-consent-gate]');
    const sync = () => gate?.setAttribute('aria-disabled', String(!boxes.every((b) => b.checked)));
    boxes.forEach((b) => b.addEventListener('change', sync));
    sync();
  }
</script>

<style>
  .inv { max-width: 520px; padding-top: var(--s-4); }
  .inv__lead { margin-top: var(--s-4); }

  .inv__card {
    display: grid;
    gap: var(--s-1);
    width: min(280px, 60%);
    margin-top: var(--s-6);
    color: inherit;
    text-decoration: none;
  }
  .inv__img { width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; border-radius: var(--radius-card); }
  .inv__name { margin-top: var(--s-2); font-weight: var(--w-head-lg); }
  .inv__role { font-size: var(--fs-small); }

  .inv__checks { display: grid; gap: var(--s-4); margin-top: var(--s-6); }
  .inv__go { margin-top: var(--s-6); transition: opacity var(--dur-fast) var(--ease-out); }
  .inv__go[aria-disabled='true'] { opacity: 0.35; pointer-events: none; }
  .inv__note { margin-top: var(--s-4); font-size: var(--fs-small); }
</style>
