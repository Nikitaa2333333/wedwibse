---
// НОВАЯ КАРТОЧКА — что заводим: площадку или подрядчика какой категории.
// Категория закрепляется при создании (решение 16.10): от неё зависят
// вопросы анкеты (фильтры каталога) и предложенная структура текста.
// Нажатие сразу заводит черновик в базе и открывает анкету.
import CabinetShell from '../../../components/admin/CabinetShell.astro';
import AdminIcon from '../../../components/admin/AdminIcon.astro';
import { SPECIALIST_CATEGORIES, SPECIALIST_GROUPS } from '../../../data/specialists';

const role = (slug: string) => SPECIALIST_CATEGORIES.find((c) => c.slug === slug)?.role ?? slug;
const listed = new Set(SPECIALIST_GROUPS.flatMap((g) => g.categories));
const rest = SPECIALIST_CATEGORIES.filter((c) => !listed.has(c.slug)).map((c) => c.slug);
const groups = [...SPECIALIST_GROUPS.map((g) => ({ label: g.label, categories: g.categories })), ...(rest.length ? [{ label: 'Другое', categories: rest }] : [])];
const go = '<svg class="c-row__go" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M9 5l6 7-6 7"/></svg>';
---

<CabinetShell title="Новая карточка" section="cards">
  <div class="cab-col" data-new>
    <div class="c-head">
      <a class="c-back" href="/profi/moi/"><AdminIcon name="back" /> Мои карточки</a>
      <h1 class="a-h1">Выберите категорию</h1>
    </div>
    <p class="c-error" data-error hidden></p>
    <div class="c-sheet-area">
    <section class="c-cat">
      <div class="c-rows">
        <button class="c-row c-row--big" type="button" data-kind="venue" data-cat="">
          <span class="c-row__ic"><AdminIcon name="venue" /></span>
          <span class="c-row__body"><span class="c-row__title">Площадка</span><span class="c-row__sub">Ресторан, усадьба, лофт, шатёр, загородный клуб</span></span>
          <span></span>
          <Fragment set:html={go} />
        </button>
      </div>
    </section>
    {/* Евгений, 31.10: подразделы сливались со строками — у каждой группы
        крупный заголовок над её строками, как разделы в настройках телефона */}
    {groups.map((g) => (
      <section class="c-cat">
        <h2 class="c-cat__h">{g.label}</h2>
        <div class="c-rows">
            {g.categories.map((slug) => (
              <button class="c-row" type="button" data-kind="specialist" data-cat={slug}>
                <span></span>
                <span class="c-row__body"><span class="c-row__title">{role(slug)}</span></span>
                <span></span>
                <Fragment set:html={go} />
              </button>
            ))}
        </div>
      </section>
    ))}
    </div>
  </div>
</CabinetShell>

<style>
  .c-row { width: 100%; text-align: left; }
</style>

<script>
  import { api, requireSession, errText } from '../../../lib/cabinet-api';

  const s = requireSession('vendor');
  const root = document.querySelector<HTMLElement>('[data-new]')!;
  const error = root.querySelector<HTMLElement>('[data-error]')!;
  root.querySelectorAll<HTMLButtonElement>('[data-kind]').forEach((b) =>
    b.addEventListener('click', async () => {
      if (!s) return;
      error.hidden = true;
      root.querySelectorAll<HTMLButtonElement>('[data-kind]').forEach((x) => (x.disabled = true));
      // отклик на нажатие сразу: на медленной сети строка молчала (правило 5)
      const title = b.querySelector<HTMLElement>('.c-row__title');
      const was = title?.textContent ?? '';
      if (title) title.textContent = 'Создаём…';
      try {
        const rev = await api('vendor', 'POST', '/api/collections/revisions/records', {
          owner: s.record.id, kind: b.dataset.kind, categorySlug: b.dataset.cat, status: 'draft', data: {},
        });
        location.href = `/profi/moi/kartochka/?id=${rev.id}`;
      } catch (err) {
        error.textContent = errText(err);
        error.hidden = false;
        if (title) title.textContent = was;
        root.querySelectorAll<HTMLButtonElement>('[data-kind]').forEach((x) => (x.disabled = false));
      }
    }),
  );
</script>
