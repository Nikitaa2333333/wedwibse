---
// ПРОФИЛЬ — раздел нижнего меню кабинета (Никита, 02.11). Учётка:
// телефон для заявок, способы входа (Telegram, MAX, почта), документы, выход.
// Телефон для заявок — поле vendors.phone (подрядчик меняет его сам,
// хук пускает name и phone): по нему мы связываемся, когда придёт заявка. Данные — своя запись
// vendors (viewRule: только сам). Подключить второй способ входа отсюда —
// следующий шаг (BACKLOG), сейчас только показываем, что подключено.
import CabinetShell from '../../../components/admin/CabinetShell.astro';
import AdminIcon from '../../../components/admin/AdminIcon.astro';
import { Image } from 'astro:assets';
import maxMark from '../../../assets/profi/max-mark.webp';

// способы входа — строки со значком, как разделы анкеты (Никита, 02.11:
// без значков экран читался мелким); состояние ставит скрипт
const WAYS = [
  { key: 'telegram', title: 'Telegram' },
  { key: 'max', title: 'MAX' },
  { key: 'email', title: 'Почта' },
];
---

<CabinetShell title="Профиль" section="profile">
  <div class="cab-col" data-profile>
    <div class="c-head">
      <h1 class="a-h1" data-name>Профиль</h1>
    </div>
    <div class="c-sheet-area">
      {/* Никита, 02.11: заявки не звонком — оповещением туда, где человек
          их увидит. Telegram и MAX — только при подключённом входе: бот
          пишет лишь тем, кто к нему приходил. Настройки — vendors.notify */}
      <section class="c-cat" data-notify>
        <h2 class="c-cat__h">Куда присылать заявки</h2>
        <div class="c-rows">
          <div class="c-row" data-ch="telegram">
            <span class="c-row__ic c-row__ic--tg"><AdminIcon name="tgLogo" /></span>
            <span class="c-row__body"><span class="c-row__title">Telegram</span><span class="c-row__sub" data-sub></span></span>
            <button class="c-switch" type="button" role="switch" aria-checked="false" aria-label="Присылать в Telegram"></button>
            <span></span>
          </div>
          <div class="c-row" data-ch="max">
            <span class="c-row__ic c-row__ic--ink"><Image src={maxMark} alt="" width={22} height={22} widths={[22, 44, 66]} sizes="22px" /></span>
            <span class="c-row__body"><span class="c-row__title">MAX</span><span class="c-row__sub" data-sub></span></span>
            <button class="c-switch" type="button" role="switch" aria-checked="false" aria-label="Присылать в MAX"></button>
            <span></span>
          </div>
          <div class="c-row" data-ch="email">
            <span class="c-row__ic"><AdminIcon name="mail" /></span>
            <span class="c-row__body"><span class="c-row__title">Почта</span><input class="c-inline-input" type="email" inputmode="email" autocomplete="email" placeholder="почта для заявок" aria-label="Почта для заявок" data-email-to /></span>
            <button class="c-switch" type="button" role="switch" aria-checked="false" aria-label="Присылать на почту"></button>
            <span></span>
          </div>
        </div>
        <p class="c-cat__note c-error" data-notify-error hidden></p>
      </section>
      <section class="c-cat">
        <h2 class="c-cat__h">Способы входа</h2>
        <div class="c-rows">
          {WAYS.map((w) => (
            <div class="c-row" data-way={w.key}>
              <span class={`c-row__ic${w.key === 'max' ? ' c-row__ic--ink' : w.key === 'telegram' ? ' c-row__ic--tg' : ''}`}>
                {w.key === 'telegram' && <AdminIcon name="tgLogo" />}
                {w.key === 'max' && <Image src={maxMark} alt="" width={22} height={22} widths={[22, 44, 66]} sizes="22px" />}
                {w.key === 'email' && <AdminIcon name="mail" />}
              </span>
              <span class="c-row__body"><span class="c-row__title">{w.title}</span><span class="c-row__sub" data-sub hidden></span></span>
              <span class="c-badge" data-badge></span>
              <span></span>
            </div>
          ))}
        </div>
      </section>
      <section class="c-cat">
        <h2 class="c-cat__h">Документы</h2>
        <div class="c-rows" data-docs></div>
      </section>
      <p class="c-error" data-error hidden></p>
      <a class="c-link c-link--danger" href="#" data-cab-logout>Выйти из кабинета</a>
    </div>
  </div>
</CabinetShell>



<script>
  import { api, esc, requireSession, saveSession } from '../../../lib/cabinet-api';
  import { ADMIN_ICONS } from '../../../lib/admin-icons';
  const docIcon = `<svg viewBox="0 0 24 24" aria-hidden="true">${ADMIN_ICONS.text}</svg>`;

  const root = document.querySelector<HTMLElement>('[data-profile]')!;
  const error = root.querySelector<HTMLElement>('[data-error]')!;
  const s = requireSession('vendor');
  if (s) {
    try {
      const me = await api('vendor', 'GET', `/api/collections/vendors/records/${s.record.id}`);
      saveSession('vendor', { ...s, record: me });
      if (me.name) root.querySelector('[data-name]')!.textContent = me.name;
      // куда присылать заявки: переключатели сохраняются сразу, почта — через секунду
      const box = root.querySelector<HTMLElement>('[data-notify]')!;
      const err = box.querySelector<HTMLElement>('[data-notify-error]')!;
      const emailTo = box.querySelector<HTMLInputElement>('[data-email-to]')!;
      const n = { telegram: false, max: false, email: false, emailTo: '', ...(me.notify ?? {}) };
      if (!n.emailTo) n.emailTo = String(me.email ?? '');
      emailTo.value = n.emailTo;
      const linked: Record<string, boolean> = { telegram: !!me.telegramId, max: !!me.maxId, email: true };
      const paint = () => box.querySelectorAll<HTMLElement>('[data-ch]').forEach((row) => {
        const ch = row.dataset.ch as 'telegram' | 'max' | 'email';
        const sw = row.querySelector<HTMLButtonElement>('.c-switch')!;
        sw.setAttribute('aria-checked', String(!!n[ch]));
        sw.disabled = !linked[ch] || (ch === 'email' && !n.emailTo);
        const sub = row.querySelector<HTMLElement>('[data-sub]');
        if (sub) sub.textContent = linked[ch] ? 'сообщением от бота WED Secrets' : `войдите через ${ch === 'max' ? 'MAX' : 'Telegram'}, чтобы получать сюда`;
      });
      const saveNotify = async () => {
        err.hidden = true;
        try {
          me.notify = (await api('vendor', 'PATCH', `/api/collections/vendors/records/${me.id}`, { notify: n })).notify;
          Object.assign(n, me.notify);
        } catch (x) { err.textContent = (x as Error).message; err.hidden = false; }
        paint();
      };
      box.addEventListener('click', (e) => {
        const sw = (e.target as HTMLElement).closest<HTMLButtonElement>('.c-switch');
        if (!sw || sw.disabled) return;
        const ch = sw.closest<HTMLElement>('[data-ch]')!.dataset.ch as 'telegram' | 'max' | 'email';
        n[ch] = !n[ch];
        paint();
        saveNotify();
      });
      let t = 0;
      emailTo.addEventListener('input', () => {
        n.emailTo = emailTo.value.trim();
        if (!n.emailTo) n.email = false;
        paint();
        clearTimeout(t);
        t = window.setTimeout(saveNotify, 900);
      });
      paint();
      // статус плашкой: подключено — зелёным, нет — серым «не подключён».
      // У учётки через мессенджер почты нет (messengerAuth её не ставит)
      const email = String(me.email ?? '');
      const state: Record<string, { on: boolean; sub?: string }> = {
        telegram: { on: !!me.telegramId },
        max: { on: !!me.maxId },
        email: { on: !!email && me.verified !== false, sub: email },
      };
      root.querySelectorAll<HTMLElement>('[data-way]').forEach((row) => {
        const st = state[row.dataset.way!];
        const badge = row.querySelector<HTMLElement>('[data-badge]')!;
        badge.textContent = st.on ? 'подключён' : 'не подключён';
        badge.classList.toggle('c-badge--ok', st.on);
        const sub = row.querySelector<HTMLElement>('[data-sub]')!;
        sub.textContent = st.sub ?? '';
        sub.hidden = !st.sub;
      });
      const docs = await api(null, 'GET', `/api/collections/legal_docs/records?sort=-created&perPage=50&filter=${encodeURIComponent('kind = "vendor-offer" || kind = "vendor-pdn"')}`);
      const latest = ['vendor-offer', 'vendor-pdn'].map((k) => docs.items.find((d: any) => d.kind === k)).filter(Boolean);
      // текст документа пишем мы сами в базе (редактор) — как HTML, как на экране условий
      root.querySelector<HTMLElement>('[data-docs]')!.innerHTML = latest.map((d: any) => `
        <details class="c-row">
          <summary><span class="c-row__ic">${docIcon}</span><span class="c-row__title c-row__grow">${esc(d.title)}</span><svg class="c-row__go" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M9 5l6 7-6 7"/></svg></summary>
          <div class="c-details__text">${d.text}</div>
        </details>`).join('') || '<p class="c-row c-row__sub">пусто</p>';
    } catch (err) {
      error.textContent = (err as Error).message;
      error.hidden = false;
    }
  }
</script>
