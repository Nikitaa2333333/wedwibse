---
// ПРОФИЛЬ — раздел нижнего меню кабинета (Никита, 02.11). Учётка:
// вход и уведомления о заявках одной группой, документы, удаление
// карточек (05.11: перенесено из анкеты, чтобы не нажать случайно), выход.
// Никита, 02.11: «Способы входа» и «Куда присылать заявки» дублировали друг
// друга. Теперь один ряд на канал: вошёл через Telegram или MAX — заявки
// туда и приходят (по умолчанию включено, выключается переключателем);
// не подключён — плашка «не подключён» и подсказка, что войти — и всё.
// Бот пишет лишь тем, кто к нему приходил, поэтому без входа канал не
// включить. Почта — любой адрес. Настройки — vendors.notify (хук).
import CabinetShell from '../../../components/admin/CabinetShell.astro';
import AdminIcon from '../../../components/admin/AdminIcon.astro';
import { Image } from 'astro:assets';
import maxMark from '../../../assets/profi/max-mark.webp';
---

<CabinetShell title="Профиль" section="profile">
  <div class="cab-col" data-profile>
    <div class="c-head">
      <h1 class="a-h1" data-name>Профиль</h1>
    </div>
    <div class="c-sheet-area">
      {/* Вход и уведомления — ОДНА группа (Никита 05.11): канал один и тот же —
          вошли через MAX, туда и приходят заявки (так включено по умолчанию,
          выключается тумблером). Колокольчик качнётся при открытии экрана. */}
      <section class="c-cat" data-notify>
        <h2 class="c-cat__h c-cat__h--ic"><span class="c-cat__ic c-bell"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5a6.5 6.5 0 0 0-6.5 6.5v4.6l-1.6 2.6a.9.9 0 0 0 .8 1.3h14.6a.9.9 0 0 0 .8-1.3l-1.6-2.6V9A6.5 6.5 0 0 0 12 2.5Zm-2.6 16.5a2.7 2.7 0 0 0 5.2 0Z"/></svg></span>Вход и уведомления</h2>
        <p class="c-cat__lead">Подключённый вход — это и канал для заявок. Переключателем решаете, присылать ли туда заявки</p>
        <div class="c-rows">
          <div class="c-row" data-ch="telegram">
            <span class="c-row__ic c-row__ic--tg"><AdminIcon name="tgLogo" /></span>
            <span class="c-row__body"><span class="c-row__title">Telegram</span><span class="c-row__sub" data-sub></span></span>
            <span class="c-ch-ctl" data-ctl></span>
            <span></span>
          </div>
          <div class="c-row" data-ch="max">
            <span class="c-row__ic c-row__ic--ink"><Image src={maxMark} alt="" width={22} height={22} widths={[22, 44, 66]} sizes="22px" /></span>
            <span class="c-row__body"><span class="c-row__title">MAX</span><span class="c-row__sub" data-sub></span></span>
            <span class="c-ch-ctl" data-ctl></span>
            <span></span>
          </div>
          <div class="c-row" data-ch="email">
            <span class="c-row__ic"><AdminIcon name="mail" /></span>
            <span class="c-row__body"><span class="c-row__title">Почта</span><input class="c-inline-input" type="email" inputmode="email" autocomplete="email" placeholder="почта для заявок" aria-label="Почта для заявок" data-email-to /></span>
            <span class="c-ch-ctl" data-ctl></span>
            <span></span>
          </div>
        </div>
        <p class="c-cat__note c-error" data-notify-error hidden></p>
      </section>
      <section class="c-cat">
        <h2 class="c-cat__h">Документы</h2>
        <div class="c-rows" data-docs><div class="sk-row" style="grid-template-columns:minmax(0,1fr)"><span class="sk sk--line"></span></div></div>
      </section>
      <section class="c-cat c-cat--far" data-del-box hidden>
        <h2 class="c-cat__h">Удалить карточку</h2>
        <p class="c-cat__lead">Только новую, ещё не опубликованную. Опубликованную снимает модератор</p>
        <div class="c-rows" data-del-list></div>
      </section>
      <p class="c-error" data-error hidden></p>
      <section class="c-cat c-cat--far"><a class="c-row c-row--action" href="#" data-cab-logout><span class="c-row__title">Выйти из кабинета</span></a></section>
    </div>
  </div>
</CabinetShell>



<script>
  import { api, esc, requireSession, saveSession, errText } from '../../../lib/cabinet-api';
  import { confirmDelete } from '../../../lib/cabinet-delete';
  import { toast } from '../../../lib/cab-ui';
  import { fieldError, clearFieldError } from '../../../lib/form-check';
  import { ADMIN_ICONS } from '../../../lib/admin-icons';
  const docIcon = `<svg viewBox="0 0 24 24" aria-hidden="true">${ADMIN_ICONS.text}</svg>`;

  const root = document.querySelector<HTMLElement>('[data-profile]')!;
  const error = root.querySelector<HTMLElement>('[data-error]')!;
  const s = requireSession('vendor');
  if (s) {
    try {
      const me = await api('vendor', 'GET', `/api/collections/vendors/records/${s.record.id}`);
      saveSession('vendor', { ...s, record: me });
      if (me.name) root.querySelector('[data-name]')!.textContent = me.name;
      // вход и уведомления: переключатели сохраняются сразу, почта — через секунду
      const box = root.querySelector<HTMLElement>('[data-notify]')!;
      const err = box.querySelector<HTMLElement>('[data-notify-error]')!;
      const emailTo = box.querySelector<HTMLInputElement>('[data-email-to]')!;
      type Ch = 'telegram' | 'max' | 'email';
      const linked: Record<Ch, boolean> = { telegram: !!me.telegramId, max: !!me.maxId, email: true };
      // по умолчанию (настройки ещё не трогали) — заявки идут в мессенджер входа
      const n = { telegram: linked.telegram, max: linked.max, email: false, emailTo: '', ...(me.notify ?? {}) };
      if (!n.emailTo) n.emailTo = String(me.email ?? '');
      emailTo.value = n.emailTo;
      const NAME: Record<Ch, string> = { telegram: 'Telegram', max: 'MAX', email: 'почту' };
      const paint = () => box.querySelectorAll<HTMLElement>('[data-ch]').forEach((row) => {
        const ch = row.dataset.ch as Ch;
        const ctl = row.querySelector<HTMLElement>('[data-ctl]')!;
        const sub = row.querySelector<HTMLElement>('[data-sub]');
        if (!linked[ch]) {
          // вход через этот мессенджер не подключён — капсула «Подключить»
          ctl.innerHTML = `<a class="c-chipbtn" href="/profi/vhod/?via=${ch}">Подключить</a>`;
          if (sub) sub.textContent = 'вход не подключён';
          return;
        }
        ctl.innerHTML = `<button class="c-switch" type="button" role="switch" aria-checked="${!!n[ch]}" aria-label="Присылать заявки в ${NAME[ch]}" ${ch === 'email' && !n.emailTo ? 'disabled' : ''}></button>`;
        // подпись постоянная — при переключении строка не меняет высоту (Никита 05.11);
        // присылать ли заявки, говорит сам тумблер
        if (sub) sub.textContent = 'вход подключён';
      });
      const saveNotify = async () => {
        err.hidden = true;
        try {
          me.notify = (await api('vendor', 'PATCH', `/api/collections/vendors/records/${me.id}`, { notify: n })).notify;
          Object.assign(n, me.notify);
        } catch (x) { err.textContent = errText(x); err.hidden = false; }
        paint();
      };
      box.addEventListener('click', (e) => {
        const sw = (e.target as HTMLElement).closest<HTMLButtonElement>('.c-switch');
        if (!sw || sw.disabled) return;
        const ch = sw.closest<HTMLElement>('[data-ch]')!.dataset.ch as Ch;
        n[ch] = !n[ch];
        paint();
        saveNotify();
      });
      let t = 0;
      // почта: формат проверяем при уходе из поля (правило 18), ошибка — облачком;
      // с ошибкой в адресе не сохраняем
      const emailOk = () => !emailTo.value.trim() || emailTo.checkValidity();
      emailTo.addEventListener('input', () => {
        clearFieldError(emailTo);
        n.emailTo = emailTo.value.trim();
        if (!n.emailTo) n.email = false;
        paint();
        clearTimeout(t);
        if (emailOk()) t = window.setTimeout(saveNotify, 900);
      });
      emailTo.addEventListener('blur', () => {
        if (!emailOk()) fieldError(emailTo, 'В адресе ошибка, пример: name@mail.ru', emailTo.closest<HTMLElement>('.c-row') ?? undefined);
      });
      paint();
      // вернулись после «Подключить» (tg-login → afterLogin, ?linked=…): сказать, что вышло
      const justLinked = new URLSearchParams(location.search).get('linked');
      if (justLinked === 'telegram' || justLinked === 'max') {
        const ok = linked[justLinked];
        toast(ok ? `${NAME[justLinked]} подключён — заявки придут и туда` : 'Не получилось подключить — попробуйте ещё раз', !ok);
        history.replaceState(null, '', location.pathname);
      }
      const docs = await api(null, 'GET', `/api/collections/legal_docs/records?sort=-created&perPage=50&filter=${encodeURIComponent('kind = "vendor-offer" || kind = "vendor-pdn"')}`);
      const latest = ['vendor-offer', 'vendor-pdn'].map((k) => docs.items.find((d: any) => d.kind === k)).filter(Boolean);
      // текст документа пишем мы сами в базе (редактор) — как HTML, как на экране условий
      root.querySelector<HTMLElement>('[data-docs]')!.innerHTML = latest.map((d: any) => `
        <details class="c-row">
          <summary><span class="c-row__ic">${docIcon}</span><span class="c-row__title c-row__grow">${esc(d.title)}</span><svg class="c-row__go" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M9 5l6 7-6 7"/></svg></summary>
          <div class="c-details__text">${d.text}</div>
        </details>`).join('') || '<p class="c-row c-row__sub">пусто</p>';
    } catch (err) {
      error.textContent = errText(err);
      error.hidden = false;
    }
    loadDeletable();
  }

  // карточки, которые можно удалить: свои новые, ещё не опубликованные
  async function loadDeletable() {
    const box = root.querySelector<HTMLElement>('[data-del-box]')!;
    const list = box.querySelector<HTMLElement>('[data-del-list]')!;
    try {
      const res = await api('vendor', 'GET', `/api/collections/revisions/records?perPage=50&sort=-updated&filter=${encodeURIComponent('venue = "" && specialist = "" && status != "approved"')}`);
      box.hidden = !res.items.length;
      list.innerHTML = res.items.map((r: any, i: number) => `
        <div class="c-row">
          <span class="c-row__body"><span class="c-row__title">${esc(r.data?.name || 'Без названия')}</span><span class="c-row__sub">${(r.photos ?? []).length} фото</span></span>
          <button class="c-chipbtn c-chipbtn--danger" type="button" data-del="${i}">Удалить</button>
        </div>`).join('');
      list.onclick = (e) => {
        const b = (e.target as HTMLElement).closest<HTMLElement>('[data-del]');
        if (b) confirmDelete(res.items[Number(b.dataset.del)], loadDeletable);
      };
    } catch {
      box.hidden = true;
    }
  }
</script>
