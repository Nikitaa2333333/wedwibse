---
// ЗАЯВКИ — раздел нижнего меню кабинета (Никита, 02.11). Заявка одного вида:
// пара оставила имя, телефон, дату и число гостей и увидела контакты
// подрядчика (CABINET.md §18, «Показать контакты»). Передача данных пары
// подрядчику во втором этапе НЕ входит (DECISIONS.md). ВРЕМЕННО (07.11, Никита:
// «чтобы видеть, как всё будет», потом уберём) раздел показывает настоящие
// заявки на карточки владельца — выключается в хуке (LEADS_TO_VENDORS).
// В демо-режиме дев-сервера (?demo) — макет на будущее (Никита, 05.11):
// главное подрядчику — быстро связаться, поэтому сверху имя, крупно дата
// и гости, сразу кнопки «Позвонить» / «Написать», внизу — когда пришла.
// Отступы по правилу внутреннего и внешнего (Бюро Горбунова): внутри
// группы меньше, чем между группами и между заявками.
import CabinetShell from '../../../components/admin/CabinetShell.astro';
---

<CabinetShell title="Заявки" section="leads">
  <div class="cab-col">
    <div class="c-head">
      <h1 class="a-h1">Заявки</h1>
    </div>
    <div class="c-sheet-area" data-leads>
      <p class="c-empty">Заявок пока нет. Когда пара оставит заявку на вашей карточке, она появится здесь с телефоном и датой свадьбы</p>
    </div>
  </div>
</CabinetShell>

<style>
  /* пустое состояние — по левому краю */
  .c-empty { margin-top: var(--s-4); max-width: 40ch; padding-inline: var(--s-4); }
  /* заявка — своя плашка; между заявками 8 px, внутри плашки поля 18 px */
  :global(.c-leads) { display: grid; gap: 8px; }
  :global(.c-lead) { display: grid; gap: 14px; padding: 18px; border-radius: var(--cab-sheet-radius); background: var(--adm-card); }
  /* группа «кто и когда»: строки вплотную (4 px) — меньше, чем до кнопок (14 px) */
  :global(.c-lead__who) { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 4px 12px; }
  :global(.c-lead__name) { font-size: 18px; line-height: 24px; font-weight: 600; }
  :global(.c-lead__date) { grid-column: 1 / -1; font-size: 16px; line-height: 22px; font-weight: 500; }
  :global(.c-lead__acts) { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  :global(.c-lead__acts .a-btn) { height: 48px; font-size: 16px; }
  :global(.c-lead__when) { font-size: var(--adm-fs-sm); }
  /* что написала пара — обычным текстом под датой, переносы как набрали */
  :global(.c-lead__msg) { grid-column: 1 / -1; margin-top: 6px; font-size: 16px; line-height: 22px; white-space: pre-line; overflow-wrap: anywhere; }
  /* Новая — точка у имени и зелёная плашка. Просмотренная — вся заявка приглушена,
     как у Профи.ру (Никита 05.11). Исключение из правила «текст только контрастный»:
     здесь приглушение несёт смысл «уже видели», цвет — токен --adm-text-seen. */
  :global(.c-lead__name) { display: inline-flex; align-items: center; gap: 8px; }
  :global(.c-lead:not(.c-lead--seen) .c-lead__name::before) { content: ''; width: 8px; height: 8px; border-radius: 50%; background: var(--st-ok-dot); flex: none; }
  :global(.c-lead--seen), :global(.c-lead--seen .c-lead__when) { color: var(--adm-text-seen); }
  :global(.c-lead--seen .a-btn) { background: var(--adm-bg); color: var(--adm-text-seen); }
  :global(.c-lead--seen .status) { color: var(--adm-text-seen); }
</style>

<script>
  import { api, esc, errText, requireSession } from '../../../lib/cabinet-api';
  const s = requireSession('vendor');

  // ВРЕМЕННО (Никита 07.11: «чтобы видеть, как всё будет», потом уберём):
  // настоящие заявки на мои карточки — GET /api/wed/my-leads (хук, LEADS_TO_VENDORS).
  // «Новая» / «Просмотрена» — по этому устройству (localStorage): журнал
  // просмотров на сервере — отдельный шаг («Показать контакты», ROADMAP).
  const SEEN = 'wed-cab-leads-seen';
  const readSeen = (): string[] => { try { return JSON.parse(localStorage.getItem(SEEN) ?? '[]'); } catch { return []; } };
  const when = (d: string) => {
    const t = new Date(String(d).replace(' ', 'T'));
    const time = t.toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit' });
    const day = new Date(); day.setHours(0, 0, 0, 0);
    const diff = Math.round((day.getTime() - new Date(t).setHours(0, 0, 0, 0)) / 864e5);
    return `${diff === 0 ? 'сегодня' : diff === 1 ? 'вчера' : t.toLocaleDateString('ru-RU', { day: 'numeric', month: 'short' })} в ${time}`;
  };
  const wedding = (d: string) => (d ? `Свадьба ${new Date(`${d}T12:00:00`).toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' })}` : 'Дата свадьбы не указана');

  async function loadLeads() {
    const box = document.querySelector<HTMLElement>('[data-leads]')!;
    let items: any[] = [];
    try {
      items = (await api('vendor', 'GET', '/api/wed/my-leads')).items ?? [];
    } catch (x) {
      box.innerHTML = `<p class="c-empty c-error">Заявки не загрузились. ${esc(errText(x))}</p>`;
      return;
    }
    if (!items.length) return; // остаётся «Заявок пока нет»
    const seen = new Set(readSeen());
    const many = new Set(items.map((l) => l.card)).size > 1;
    box.innerHTML = `<div class="c-leads">${items.map((l) => {
      const old = seen.has(l.id);
      // цифры номера: 8… и 10 цифр → 7… (для tel:, t.me/+, wa.me/)
      const d0 = String(l.phone).replace(/\D/g, '');
      const digits = d0.length === 11 && d0[0] === '8' ? '7' + d0.slice(1) : d0.length === 10 ? '7' + d0 : d0;
      // способ связи пара выбирает в форме: «Связаться: Telegram / WhatsApp / звонок» (BookingSheet)
      const way = /^Связаться:\s*(.+)$/m.exec(String(l.message || ''))?.[1]?.trim().toLowerCase() ?? '';
      const text = String(l.message || '').split('\n').filter((s) => !/^Связаться:/.test(s)).join('\n').trim();
      // «Написать» — туда, где пара ждёт ответа; при звонке кнопки нет (Никита 09.11: СМС — странно)
      // выбранный парой мессенджер — главной кнопкой, звонок — второй
      const write = way === 'telegram' ? `<a class="a-btn a-btn--primary" href="https://t.me/+${esc(digits)}" target="_blank" rel="noopener" data-seen="${esc(l.id)}">Написать в Telegram</a>`
        : way === 'whatsapp' ? `<a class="a-btn a-btn--primary" href="https://wa.me/${esc(digits)}" target="_blank" rel="noopener" data-seen="${esc(l.id)}">Написать в WhatsApp</a>` : '';
      const wayLabel = way === 'telegram' ? 'Telegram' : way === 'whatsapp' ? 'WhatsApp' : way ? 'звонок' : '';
      return `
      <article class="c-lead${old ? ' c-lead--seen' : ''}" data-lead="${esc(l.id)}">
        <div class="c-lead__who">
          <span class="c-lead__name">${esc(l.name)}</span>
          <span class="status ${old ? '' : 'status--ok'}">${old ? 'Просмотрена' : 'Новая'}</span>
          <span class="c-lead__date">${esc(wedding(l.eventDate))}</span>
          ${wayLabel ? `<span class="c-lead__msg">Удобнее: ${wayLabel}</span>` : ''}
          ${text ? `<span class="c-lead__msg">${esc(text)}</span>` : ''}
        </div>
        <div class="c-lead__acts">
          ${write}
          <a class="a-btn${write ? '' : ' a-btn--primary'}" href="tel:+${esc(digits)}" data-seen="${esc(l.id)}">Позвонить</a>
        </div>
        <span class="c-lead__when">Заявка пришла ${when(l.created)}${many ? ` · ${esc(l.card)}` : ''}</span>
      </article>`;
    }).join('')}</div>`;
    // «Просмотрена» — только та заявка, по которой связались (Никита 09.11: открыл раздел — и серыми
    // стали все). Отмечаем по нажатию «Позвонить» / «Написать», не по показу списка
    box.addEventListener('click', (e) => {
      const id = (e.target as HTMLElement).closest<HTMLElement>('[data-seen]')?.dataset.seen;
      if (!id) return;
      const cur = new Set(readSeen());
      cur.add(id);
      try { localStorage.setItem(SEEN, JSON.stringify([...cur].slice(-500))); } catch {}
      const card = box.querySelector<HTMLElement>(`[data-lead="${CSS.escape(id)}"]`);
      card?.classList.add('c-lead--seen');
      const st = card?.querySelector('.status');
      if (st) { st.classList.remove('status--ok'); st.textContent = 'Просмотрена'; }
    });
  }

  // демо (только дев): макет будущих заявок
  if (import.meta.env.DEV && sessionStorage.getItem('wed-cab-demo') === '1') {
    const box = document.querySelector<HTMLElement>('[data-leads]')!;
    const leads = [
      { name: 'Мария', date: '14 июня 2027, 80 гостей', phone: '+79001234567', tg: 'maria_w', when: 'сегодня в 14:20', st: 'status--ok', label: 'Новая', seen: false },
      { name: 'Ольга', date: '2 августа 2027, 40 гостей', phone: '+79007654321', tg: '', when: '3 нояб. в 19:05', st: '', label: 'Просмотрена', seen: true },
    ];
    box.innerHTML = `<div class="c-leads">${leads.map((l) => `
      <article class="c-lead${l.seen ? ' c-lead--seen' : ''}">
        <div class="c-lead__who">
          <span class="c-lead__name">${l.name}</span>
          <span class="status ${l.st}">${l.label}</span>
          <span class="c-lead__date">${l.date}</span>
        </div>
        <div class="c-lead__acts">
          <a class="a-btn a-btn--primary" href="tel:${l.phone}">Позвонить</a>
          ${l.tg ? `<a class="a-btn" href="https://t.me/${l.tg}" target="_blank" rel="noopener">Написать</a>` : `<a class="a-btn" href="sms:${l.phone}">Написать</a>`}
        </div>
        <span class="c-lead__when">Заявка пришла ${l.when}</span>
      </article>`).join('')}</div>
      <p class="c-empty">Макет для демо: заявки придут, когда запустим форму невесты</p>`;
  } else if (s) loadLeads();
</script>
