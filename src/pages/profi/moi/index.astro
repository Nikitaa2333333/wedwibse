---
// МОИ КАРТОЧКИ — живой экран на базе. Опубликованные карточки учётки
// (/api/wed/my-cards, с открытой правкой, если она есть) и новые, ещё не
// одобренные (свои ревизии без карточки). До 3 карточек на учётку.
// Вид — система админки (CabinetShell, cabinet.css): строками, статус
// одним словом и цветом, действие — на экране карточки.
import CabinetShell from '../../../components/admin/CabinetShell.astro';
import AdminIcon from '../../../components/admin/AdminIcon.astro';
import { SPECIALIST_CATEGORIES } from '../../../data/specialists';

const ROLES = Object.fromEntries(SPECIALIST_CATEGORIES.map((c) => [c.slug, c.role]));
---

<CabinetShell title="Мои карточки" section="cards">
  <div class="cab-col" data-mine data-roles={JSON.stringify(ROLES)}>
    <div class="a-title">
      <h1 class="a-h1">Мои карточки</h1>
      <div class="a-title__actions">
        <a class="a-btn a-btn--primary" href="/profi/moi/novaya/" data-add hidden><AdminIcon name="plus" /> Новая карточка</a>
      </div>
    </div>
    <section class="a-card a-card--flush">
      <div class="c-rows" data-list><p class="c-row c-row__sub">Загружаем…</p></div>
    </section>
    <p class="c-error" data-error hidden></p>
    <p class="a-login__note">На одной учётке — до трёх карточек. Карточка появляется на сайте после проверки модератором, обычно в течение суток.</p>
  </div>
</CabinetShell>

<script>
  import { api, esc, fileToken, fileUrl, requireSession } from '../../../lib/cabinet-api';
  import { cardState } from '../../../lib/cabinet-form';

  const MAX_CARDS = 3;
  const root = document.querySelector<HTMLElement>('[data-mine]')!;
  const roles: Record<string, string> = JSON.parse(root.dataset.roles!);
  const list = root.querySelector<HTMLElement>('[data-list]')!;
  const error = root.querySelector<HTMLElement>('[data-error]')!;
  const go = '<svg class="c-row__go" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M9 5l6 7-6 7"/></svg>';

  const s = requireSession('vendor');
  if (s) {
    try {
      const [cards, revs] = await Promise.all([
        api('vendor', 'GET', '/api/wed/my-cards'),
        api('vendor', 'GET', `/api/collections/revisions/records?perPage=50&sort=-updated&filter=${encodeURIComponent('venue = "" && specialist = "" && status != "approved"')}`),
      ]);
      const token = revs.items.some((r: any) => r.photos?.length) ? await fileToken('vendor') : '';
      const role = (kind: string, cat: string) => (kind === 'venue' ? 'Площадка' : roles[cat] ?? cat);
      const row = (href: string, thumb: string, title: string, sub: string, st: { label: string; cls: string }, bad = false) => `
        <a class="c-row" href="${href}">
          ${thumb ? `<img class="c-row__thumb" src="${thumb}" alt="" loading="lazy" />` : '<span class="c-row__thumb"></span>'}
          <span class="c-row__body">
            <span class="c-row__title">${esc(title)}</span>
            <span class="c-row__sub${bad ? ' c-row__sub--bad' : ''}">${sub}</span>
          </span>
          <span class="c-badge ${st.cls}">${st.label}</span>
          ${go}
        </a>`;
      const rows: string[] = [];
      for (const c of cards.items) {
        const r = c.revision;
        const st = cardState(r?.status, c.status === 'published');
        const sub = r?.status === 'rejected' ? `Вернули: ${esc(r.rejectReason)}` : `${role(c.kind, c.categorySlug)} · ${st.note}`;
        const href = r ? `/profi/moi/kartochka/?id=${r.id}` : `/profi/moi/kartochka/?card=${c.id}&kind=${c.kind}`;
        rows.push(row(href, '', c.name, sub, st, r?.status === 'rejected'));
      }
      for (const r of revs.items) {
        const st = cardState(r.status, false);
        const sub = r.status === 'rejected' ? `Вернули: ${esc(r.rejectReason)}` : `${role(r.kind, r.categorySlug)} · ${st.note}`;
        const thumb = r.photos?.[0] ? fileUrl(r, r.photos[0], { thumb: '400x0', token }) : '';
        rows.push(row(`/profi/moi/kartochka/?id=${r.id}`, thumb, r.data?.name || 'Без названия', sub, st, r.status === 'rejected'));
      }
      list.innerHTML = rows.join('') || '<p class="c-row c-row__sub">Карточек пока нет. Нажмите «Новая карточка» — площадка или подрядчик.</p>';
      root.querySelector<HTMLElement>('[data-add]')!.hidden = cards.items.length + revs.items.length >= MAX_CARDS;
    } catch (err) {
      list.innerHTML = '';
      error.textContent = (err as Error).message;
      error.hidden = false;
    }
  }
</script>
