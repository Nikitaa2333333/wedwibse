---
// МОИ КАРТОЧКИ — живой экран на базе. Опубликованные карточки учётки
// (/api/wed/my-cards, с открытой правкой, если она есть) и новые, ещё не
// одобренные (свои ревизии без карточки). До 3 карточек на учётку.
// Вид — система админки (CabinetShell, cabinet.css): строками, статус
// одним словом и цветом, действие — на экране карточки.
import CabinetShell from '../../../components/admin/CabinetShell.astro';
import { SPECIALIST_CATEGORIES } from '../../../data/specialists';

const ROLES = Object.fromEntries(SPECIALIST_CATEGORIES.map((c) => [c.slug, c.role]));
---

<CabinetShell title="Мои карточки" section="cards">
  <div class="cab-col" data-mine data-roles={JSON.stringify(ROLES)}>
    <div class="a-title">
      <h1 class="a-h1">Мои карточки</h1>
    </div>
    <div class="c-sheet-area">
      <div class="c-rows" data-list><div class="sk-card" aria-busy="true" aria-label="Загружаем"><div class="sk-row"><span class="sk sk--thumb"></span><span class="sk-row__body"><span class="sk sk--line"></span><span class="sk sk--line sk--short"></span></span><span class="sk sk--pill"></span></div><div class="sk-row"><span class="sk sk--thumb"></span><span class="sk-row__body"><span class="sk sk--line"></span><span class="sk sk--line sk--short"></span></span><span class="sk sk--pill"></span></div><div class="sk-row"><span class="sk sk--thumb"></span><span class="sk-row__body"><span class="sk sk--line"></span><span class="sk sk--line sk--short"></span></span><span class="sk sk--pill"></span></div></div></div>
      <a class="c-add" href="/profi/moi/novaya/" data-add hidden><span class="c-add__ic" aria-hidden="true"><svg viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="2.4" d="M12 5v14M5 12h14"/></svg></span>Добавить ещё карточку</a>
      <div class="c-fail" data-error hidden><p data-error-text></p><button class="c-chipbtn" type="button" data-retry>Повторить</button></div>
    </div>
  </div>
</CabinetShell>

<script>
  import { api, esc, fileToken, fileUrl, requireSession, errText } from '../../../lib/cabinet-api';
  import { cardState, MAX_CARDS } from '../../../lib/cabinet-form';

  const root = document.querySelector<HTMLElement>('[data-mine]')!;
  const roles: Record<string, string> = JSON.parse(root.dataset.roles!);
  const list = root.querySelector<HTMLElement>('[data-list]')!;
  const error = root.querySelector<HTMLElement>('[data-error]')!;
  const go = '<svg class="c-row__go" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M9 5l6 7-6 7"/></svg>';

  // ошибка загрузки — что случилось и «Повторить» (правило 4 скилла)
  error.querySelector('[data-retry]')!.addEventListener('click', () => { error.hidden = true; list.innerHTML = '<div class="sk-card" aria-busy="true" aria-label="Загружаем"><div class="sk-row"><span class="sk sk--thumb"></span><span class="sk-row__body"><span class="sk sk--line"></span><span class="sk sk--line sk--short"></span></span><span class="sk sk--pill"></span></div><div class="sk-row"><span class="sk sk--thumb"></span><span class="sk-row__body"><span class="sk sk--line"></span><span class="sk sk--line sk--short"></span></span><span class="sk sk--pill"></span></div><div class="sk-row"><span class="sk sk--thumb"></span><span class="sk-row__body"><span class="sk sk--line"></span><span class="sk sk--line sk--short"></span></span><span class="sk sk--pill"></span></div></div>'; load(); });

  async function load() {
    try {
      const [cards, revs] = await Promise.all([
        api('vendor', 'GET', '/api/wed/my-cards'),
        api('vendor', 'GET', `/api/collections/revisions/records?perPage=50&sort=-updated&filter=${encodeURIComponent('venue = "" && specialist = "" && status != "approved"')}`),
      ]);
      const token = revs.items.some((r: any) => r.photos?.length) ? await fileToken('vendor') : '';
      const role = (kind: string, cat: string) => (kind === 'venue' ? 'Площадка' : roles[cat] ?? cat);
      const row = (href: string, thumb: string, title: string, sub: string, st: { label: string; cls: string }, bad = false) => `
        <a class="c-row c-row--card" href="${href}">
          ${thumb ? `<img class="c-row__thumb" src="${thumb}" alt="" loading="lazy" />` : '<span class="c-row__thumb"></span>'}
          <span class="c-row__body">
            <span class="c-row__title">${esc(title)}</span>
            <span class="c-row__sub${bad ? ' c-row__sub--bad' : ''}">${sub}</span>
          </span>
          <span class="status ${st.cls}">${st.label}</span>
          ${go}
        </a>`;
      const rows: string[] = [];
      for (const c of cards.items) {
        const r = c.revision;
        const st = cardState(r?.status, c.status === 'published');
        const sub = role(c.kind, c.categorySlug);
        const href = r ? `/profi/moi/kartochka/?id=${r.id}` : `/profi/moi/kartochka/?card=${c.id}&kind=${c.kind}`;
        rows.push(row(href, '', c.name, sub, st, r?.status === 'rejected'));
      }
      for (const r of revs.items) {
        const st = cardState(r.status, false);
        const sub = role(r.kind, r.categorySlug);
        const thumb = r.photos?.[0] ? fileUrl(r, r.photos[0], { thumb: '400x0', token }) : '';
        rows.push(row(`/profi/moi/kartochka/?id=${r.id}`, thumb, r.data?.name || 'Без названия', sub, st, r.status === 'rejected'));
      }
      // пусто — текст без плашки и кнопка по центру (Никита 06.11); есть карточки —
      // «Добавить ещё карточку» под списком, пока не упёрлись в MAX_CARDS
      list.innerHTML = rows.join('') || '<div class="c-empty-center"><p>Карточек пока нет. Заведите первую — площадки или подрядчика</p><a class="a-btn a-btn--primary a-btn--lg" href="/profi/moi/novaya/">Завести карточку</a></div>';
      root.querySelector<HTMLElement>('[data-add]')!.hidden = !rows.length || rows.length >= MAX_CARDS;
    } catch (err) {
      list.innerHTML = '';
      error.querySelector('[data-error-text]')!.textContent = `Карточки не загрузились. ${errText(err)}`;
      error.hidden = false;
    }
  }

  if (requireSession('vendor')) load();
</script>
