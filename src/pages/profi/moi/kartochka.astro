---
// АНКЕТА КАРТОЧКИ — полный ход заполнения на живой базе (27.10.2026).
//   ?id=<ревизия>          — список разделов с состоянием и «Отправить на проверку»
//   ?id=<ревизия>&s=<раздел> — раздел своим экраном (CABINET-UX.md §2 п.4)
//   ?card=<id>&kind=…      — правка опубликованной: /api/wed/edit даёт черновик-копию
// Разделы и их заполненность — lib/cabinet-form.ts; что можно отправить,
// решает хук базы (submitProblems). Всё сохраняется само, через секунду
// после правки; фото — сразу. Вид — система админки (CabinetShell).
// Данные рисует браузер: экран за входом, в поиск не идёт (noindex).
import CabinetShell from '../../../components/admin/CabinetShell.astro';
import { SPECIALIST_CATEGORIES, FILTERS_BY_CATEGORY } from '../../../data/specialists';
import { STRUCTURES, DEFAULT_STRUCTURE, VENUE_STRUCTURE } from '../../../data/profi-structures';

const roles = Object.fromEntries(SPECIALIST_CATEGORIES.map((c) => [c.slug, c.role]));
// вопросы подрядчика — фильтры его категории (specialist-filters.ts):
// по этим ответам пары находят карточку в каталоге
const questions = Object.fromEntries(
  Object.entries(FILTERS_BY_CATEGORY).map(([k, groups]) => [
    k,
    groups.map((g) => ({ key: g.key, label: g.label, type: g.type, options: g.options.map((o) => ({ value: o.value, label: o.label })) })),
  ]),
);
const structures = { ...STRUCTURES, _default: DEFAULT_STRUCTURE, _venue: VENUE_STRUCTURE };
---

<CabinetShell title="Анкета" section="cards">
  <div class="cab-col" data-anketa>
    <p class="a-lead" data-view>Загружаем…</p>
  </div>
  <script type="application/json" id="anketa-config" set:html={JSON.stringify({ roles, questions, structures })} />
</CabinetShell>

<script>
  import { api, esc, fileToken, fileUrl, requireSession } from '../../../lib/cabinet-api';
  import { ADMIN_ICONS } from '../../../lib/admin-icons';
  import { PHONE_COUNTRIES, DEFAULT_PHONE_COUNTRY, findCountry, flagSrc, nationalDigits, isComplete, fullE164, attachPhoneField } from '../../../lib/phone';
  import {
    SECTIONS, VENUE_QUESTIONS, VENUE_TERMS, MAX_PHOTOS, MIN_PHOTOS, MIN_TEXT,
    sectionState, cardState, priceFrom, rub, textLength, shrinkPhoto,
    type Kind, type SectionKey, type Question,
  } from '../../../lib/cabinet-form';

  const cfg = JSON.parse(document.getElementById('anketa-config')!.textContent!);
  const view = document.querySelector<HTMLElement>('[data-view]')!.parentElement!;
  const icon = (n: string, cls = '') => `<svg class="${cls}" viewBox="0 0 24 24" aria-hidden="true">${(ADMIN_ICONS as Record<string, string>)[n] ?? ''}</svg>`;
  const go = '<svg class="c-row__go" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M9 5l6 7-6 7"/></svg>';
  const tick = '<svg class="c-row__state" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M5 12.5l4.5 4.5L19 7.5"/></svg>';
  const q = new URLSearchParams(location.search);
  const s = requireSession('vendor');

  let rev: any = null;
  let data: any = {};
  let kind: Kind = 'specialist';
  let questions: Question[] = [];
  let token = '';
  let timer = 0;
  let saving: Promise<void> | null = null;
  let savedAt = '';
  let saveError = '';

  const locked = () => rev?.status === 'review' || rev?.status === 'approved';
  const isNew = () => !rev.venue && !rev.specialist;
  const role = () => (kind === 'venue' ? 'Площадка' : cfg.roles[rev.categorySlug] ?? rev.categorySlug);
  const section = () => q.get('s') as SectionKey | null;
  const url = (sec?: string) => `/profi/moi/kartochka/?id=${rev.id}${sec ? `&s=${sec}` : ''}`;
  const time = () => new Date().toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit' });

  // ---------- сохранение ----------
  function savedLabel() {
    const el = view.querySelector<HTMLElement>('[data-saved]');
    if (!el) return;
    el.classList.toggle('c-saved--bad', !!saveError);
    el.textContent = saveError ? `Не сохранилось: ${saveError}` : saving ? 'Сохраняем…' : savedAt ? `Сохранено · ${savedAt}` : '';
  }

  /** производные поля — то, что человек не вводит руками */
  function derive() {
    if (kind === 'venue') {
      const halls = (data.halls ?? []).filter((h: any) => h?.name);
      const max = (k: string) => Math.max(0, ...halls.map((h: any) => Number(h?.[k]) || 0)) || '';
      data.capacityBanquet = max('banquet');
      data.capacityBuffet = max('buffet');
    } else {
      const p = priceFrom({ tariffs: data.tariffs });
      data.priceFrom = p ?? '';
      // имя в каталоге — «Имя Фамилия»; у студии фамилии нет
      data.name = [data.firstName, data.lastName].map((x) => String(x ?? '').trim()).filter(Boolean).join(' ');
    }
  }

  async function save() {
    clearTimeout(timer);
    if (saving) await saving;
    if (locked()) return;
    derive();
    saving = (async () => {
      savedLabel();
      try {
        const body: any = { data };
        // адрес страницы новой карточки — по названию, один раз
        if (isNew() && !rev.slug && String(data.name ?? '').trim().length >= 2) {
          const sl = await api('vendor', 'GET', `/api/wed/slug?kind=${kind}&category=${rev.categorySlug}&name=${encodeURIComponent(data.name)}`);
          if (sl.suggestion) body.slug = sl.suggestion;
        }
        rev = await api('vendor', 'PATCH', `/api/collections/revisions/records/${rev.id}`, body);
        savedAt = time();
        saveError = '';
      } catch (err) {
        saveError = (err as Error).message;
      }
    })();
    await saving;
    saving = null;
    savedLabel();
  }
  const later = () => { clearTimeout(timer); saveError = ''; timer = window.setTimeout(save, 900); const el = view.querySelector('[data-saved]'); if (el) el.textContent = 'Изменено…'; };

  // ---------- обзор: список разделов ----------
  function renderOverview() {
    const st = cardState(rev.status, !isNew());
    const secs = SECTIONS[kind];
    const states = secs.map((x) => ({ ...x, ...sectionState(x.key, rev, questions) }));
    const done = states.filter((x) => x.done).length;
    const title = data.name || (kind === 'venue' ? 'Новая площадка' : 'Новая карточка');
    const siteUrl = kind === 'venue' ? `/moskva/ploshchadki/${rev.slug}/` : `/moskva/podryadchiki/${rev.categorySlug}/${rev.slug}/`;
    view.innerHTML = `
      <div class="c-head">
        <a class="c-back" href="/profi/moi/">${icon('back')} Мои карточки</a>
        <div class="c-head__row"><h1 class="a-h1">${esc(title)}</h1><span class="c-badge ${st.cls}">${st.label}</span></div>
        <p class="a-lead">${esc(role())}${rev.slug ? ` · адрес страницы ${esc(siteUrl)}` : ''}</p>
      </div>
      ${rev.status === 'rejected' && rev.rejectReason ? `<p class="c-reason"><b>Вернули с причиной:</b> ${esc(rev.rejectReason)}<br>Исправьте и отправьте снова.</p>` : ''}
      ${rev.status === 'review' ? '<p class="c-reason c-reason--info">Карточка на проверке — ответим в течение суток. Пока она на проверке, менять её нельзя; можно отозвать.</p>' : ''}
      <div class="c-progress">
        <div class="c-progress__bar"><i style="width:${Math.round((done / secs.length) * 100)}%"></i></div>
        <span class="c-progress__label">Заполнено ${done} из ${secs.length} разделов</span>
      </div>
      <section class="a-card a-card--flush"><div class="c-rows">
        ${states.map((x) => `
          <a class="c-row" href="${url(x.key)}">
            <span class="c-row__ic">${icon(x.icon)}</span>
            <span class="c-row__body"><span class="c-row__title">${x.title}</span><span class="c-row__sub${x.empty ? ' c-row__sub--bad' : ''}">${esc(x.sub)}</span></span>
            ${x.done ? tick : '<span></span>'}
            ${go}
          </a>`).join('')}
      </div></section>
      <div class="c-bar">
        ${rev.status === 'review'
          ? '<button class="a-btn a-btn--lg" type="button" data-withdraw>Отозвать с проверки</button>'
          : rev.status === 'approved'
            ? `<a class="a-btn a-btn--lg" href="${siteUrl}" target="_blank" rel="noopener">Открыть на сайте</a>`
            : '<button class="a-btn a-btn--primary a-btn--lg" type="button" data-submit>Отправить на проверку</button>'}
        <span class="c-error" data-error hidden></span>
        <span class="c-ok" data-ok hidden></span>
      </div>`;
    const err = view.querySelector<HTMLElement>('[data-error]')!;
    const ok = view.querySelector<HTMLElement>('[data-ok]')!;
    view.querySelector<HTMLButtonElement>('[data-submit]')?.addEventListener('click', async (e) => {
      const b = e.currentTarget as HTMLButtonElement;
      b.disabled = true;
      err.hidden = true;
      try {
        await save();
        rev = await api('vendor', 'PATCH', `/api/collections/revisions/records/${rev.id}`, { status: 'review' });
        renderOverview();
        view.querySelector<HTMLElement>('[data-ok]')!.textContent = 'Отправили на проверку. Ответим в течение суток.';
        view.querySelector<HTMLElement>('[data-ok]')!.hidden = false;
      } catch (x) {
        // хук перечисляет, чего не хватает, через «; » — по строке на пункт
        err.textContent = (x as Error).message.replace(/^Не получилось отправить на проверку: /, 'Чтобы отправить, осталось:\n— ').replace(/; /g, '\n— ');
        err.hidden = false;
        b.disabled = false;
      }
    });
    view.querySelector<HTMLButtonElement>('[data-withdraw]')?.addEventListener('click', async () => {
      try {
        rev = await api('vendor', 'PATCH', `/api/collections/revisions/records/${rev.id}`, { status: 'draft' });
        renderOverview();
      } catch (x) { err.textContent = (x as Error).message; err.hidden = false; }
    });
    void ok;
  }

  // ---------- экраны разделов ----------
  // пример в пустом поле текста: абзацы и список, чтобы было видно, как писать
  const TEXT_EXAMPLE = [
    'Например:',
    'Снимаю свадьбы с 2015 года. Работаю в репортажном стиле — без долгих постановок.',
    '',
    'Что входит в день съёмки:',
    '— сборы невесты',
    '— регистрация и прогулка',
    '— банкет до первого танца',
  ].join('\n');

  // телефон с кодом страны — механика сайта клиники (lib/phone.ts)
  const phoneField = (value: unknown, code: unknown) => {
    const c = findCountry(String(code || DEFAULT_PHONE_COUNTRY));
    return `
    <div class="a-field">
      <span class="a-field__label" id="c-phone-label">Телефон</span>
      <div class="c-phone">
        <div class="cc-picker">
          <button type="button" class="cc-toggle" aria-haspopup="menu" aria-expanded="false">
            <img class="cc-flag" src="${flagSrc(c)}" alt="" width="22" height="16" />
            <span class="cc-code">+${c.dial}</span>
            <svg class="cc-chevron" viewBox="0 0 24 24" aria-hidden="true">${(ADMIN_ICONS as Record<string, string>).down}</svg>
          </button>
          <div class="cc-list" role="menu" hidden>${PHONE_COUNTRIES.map((x) => `
            <button type="button" class="cc-option" role="menuitemradio" aria-checked="${x.code === c.code}" data-code="${x.code}">
              <img class="cc-opt-flag" src="${flagSrc(x)}" alt="" width="20" height="14" />
              <span class="cc-opt-name">${x.name}</span><span class="cc-opt-dial">+${x.dial}</span>
            </button>`).join('')}
          </div>
          <input type="hidden" name="phoneCountry" value="${c.code}" />
        </div>
        <input class="c-phone__input" type="tel" name="phone" autocomplete="tel" aria-labelledby="c-phone-label" value="${esc(value)}" data-phone />
      </div>
      <span class="a-field__note c-error" data-phone-error hidden></span>
    </div>`;
  };

  /** телефон → data: полный номер в E.164, страна отдельно; неполный не теряем */
  function bindPhone() {
    const picker = view.querySelector<HTMLElement>('.cc-picker');
    const input = view.querySelector<HTMLInputElement>('[data-phone]');
    if (!picker || !input) return;
    attachPhoneField(picker, input);
    const hidden = picker.querySelector<HTMLInputElement>('input[name="phoneCountry"]')!;
    const err = view.querySelector<HTMLElement>('[data-phone-error]')!;
    const sync = () => {
      const c = findCountry(hidden.value);
      const digits = nationalDigits(input.value, c);
      data.contacts ??= {};
      data.contacts.phone = digits ? fullE164(digits, c) : '';
      data.contacts.phoneCountry = c.code;
      return { c, digits };
    };
    input.addEventListener('input', () => { sync(); err.hidden = true; later(); });
    picker.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('.cc-option')) { sync(); later(); } });
    input.addEventListener('blur', () => {
      const { c, digits } = sync();
      err.textContent = digits && !isComplete(digits, c) ? `Номер неполный: +${c.dial} и ${c.len} цифр.` : '';
      err.hidden = !err.textContent;
    });
  }
  const field = (label: string, bind: string, value: unknown, opts: { type?: string; note?: string; area?: boolean; placeholder?: string; mode?: string; max?: number } = {}) => `
    <label class="a-field">
      <span class="a-field__label">${label}</span>
      ${opts.area
        ? `<textarea class="a-field__input" data-bind="${bind}" placeholder="${esc(opts.placeholder ?? '')}">${esc(value)}</textarea>`
        : `<input class="a-field__input" data-bind="${bind}" type="${opts.type ?? 'text'}" ${opts.mode ? `inputmode="${opts.mode}"` : ''} ${opts.max ? `maxlength="${opts.max}"` : ''} value="${esc(value)}" placeholder="${esc(opts.placeholder ?? '')}" />`}
      ${opts.note ? `<span class="a-field__note">${opts.note}</span>` : ''}
    </label>`;

  const choices = (qs: Question[], scope: 'filters' | 'terms') => qs.map((g) => {
    const cur = data[scope]?.[g.key];
    const on = (v: string) => (Array.isArray(cur) ? cur.includes(v) : cur === v);
    return `
      <div class="c-q">
        <span class="c-q__label">${esc(g.label)}${g.type === 'multi' ? '<span class="c-q__hint">· можно несколько</span>' : ''}</span>
        <div class="c-opts">${g.options.map((o) => `<button class="c-opt" type="button" aria-pressed="${on(o.value)}" data-scope="${scope}" data-q="${g.key}" data-v="${esc(o.value)}" data-multi="${g.type === 'multi'}">${esc(o.label)}</button>`).join('')}</div>
      </div>`;
  }).join('');

  const tools = (list: string, i: number, n: number) => `
    <div class="c-item__tools">
      <button class="c-tool c-tool--up" type="button" data-move="${list}" data-i="${i}" data-d="-1" aria-label="Выше" ${i === 0 ? 'disabled' : ''}>${icon('back')}</button>
      <button class="c-tool c-tool--down" type="button" data-move="${list}" data-i="${i}" data-d="1" aria-label="Ниже" ${i === n - 1 ? 'disabled' : ''}>${icon('back')}</button>
      <button class="c-tool" type="button" data-remove="${list}" data-i="${i}" aria-label="Удалить"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.6" d="M6 6l12 12M18 6L6 18"/></svg></button>
    </div>`;

  function sectionBody(key: SectionKey): { title: string; lead: string; html: string } {
    switch (key) {
      case 'osnovnoe':
        return kind === 'venue'
          ? { title: 'Основное', lead: '', html: `
              ${field('Название площадки', 'name', data.name)}
              ${field('Адрес', 'address', data.address, { placeholder: 'Москва, улица, дом — или посёлок и шоссе' })}
              <div class="c-grid2">
                ${field('Аренда от, ₽', 'rentFrom', data.rentFrom, { mode: 'numeric', note: 'За день; нет аренды — оставьте пустым' })}
                ${field('Средний чек от, ₽ на гостя', 'checkFrom', data.checkFrom, { mode: 'numeric' })}
              </div>` }
          : { title: 'Основное', lead: '', html: `
              <div class="c-grid2">
                ${field('Имя', 'firstName', data.firstName, { placeholder: 'Елена' })}
                ${field('Фамилия', 'lastName', data.lastName, { placeholder: 'Каморина' })}
              </div>
              <p class="a-field__note">Студия или команда — название в поле «Имя», фамилию оставьте пустой.</p>
              ${field('Строка под именем', 'tagline', data.tagline, { placeholder: 'Репортаж без постановки, плёнка по желанию', note: 'Видна в каталоге под вашим именем. Одна фраза, до 80 знаков.', max: 80 })}` };
      case 'foto':
        return { title: 'Фото', lead: `От ${MIN_PHOTOS} до ${MAX_PHOTOS} кадров. Первый — обложка в каталоге. Лучше вертикальные: каталог смотрят с телефона.`, html: '<div class="c-photos" data-photos></div><p class="c-ok" data-upload hidden></p><p class="c-error" data-photo-error hidden></p>' };
      case 'tekst': {
        const st = kind === 'venue' ? cfg.structures._venue : cfg.structures[rev.categorySlug] ?? cfg.structures._default;
        const secs = data.sections ?? [];
        return { title: 'Текст', lead: '', html: `
          ${secs.length ? '' : `<p class="a-field__note">Не знаете, с чего начать? <button class="c-link" type="button" data-template>Взять за основу: ${esc(st.label.toLowerCase())}</button></p>`}
          <div class="c-items">${secs.map((x: any, i: number) => `
            <div class="c-item">
              ${field('Заголовок раздела', `sections.${i}.title`, x.title, { placeholder: 'Как я работаю' })}
              ${field('Текст', `sections.${i}.body`, x.body, { area: true, placeholder: x.hint ? `${x.hint}\n\n${TEXT_EXAMPLE}` : TEXT_EXAMPLE })}
              ${tools('sections', i, secs.length)}
            </div>`).join('')}</div>
          <button class="c-add" type="button" data-add="sections">${icon('plus')} Раздел</button>
          <p class="a-field__note" data-count>${textLength(data)} знаков</p>` };
      }
      case 'voprosy':
        return { title: 'Вопросы', lead: questions.length ? 'По этим ответам вас найдут в фильтрах каталога.' : 'Для этой категории фильтров в каталоге пока нет — раздел можно пропустить.', html: choices(questions, 'filters') };
      case 'prays': {
        const ts = data.tariffs ?? [];
        const p = priceFrom({ tariffs: ts });
        return { title: 'Прайс', lead: 'Каждый пакет — отдельная карточка с ценой на вашей странице. В каталоге рядом с именем покажем самую низкую цену.', html: `
          <p class="c-preview">В каталоге: <b>${p ? `от ${rub(p)}` : 'добавьте пакет с ценой'}</b></p>
          <div class="c-items">${ts.map((t: any, i: number) => `
            <div class="c-item">
              <div class="c-grid2">
                ${field('Название пакета', `tariffs.${i}.name`, t.name, { placeholder: 'Полный день' })}
                ${field('Цена, ₽', `tariffs.${i}.price`, t.price, { mode: 'numeric', placeholder: '40000' })}
              </div>
              ${field('Что входит', `tariffs.${i}.includes`, t.includes, { area: true, placeholder: '— 10 часов съёмки\n— 500 кадров в обработке\n— онлайн-галерея' })}
              ${tools('tariffs', i, ts.length)}
            </div>`).join('')}</div>
          <button class="c-add" type="button" data-add="tariffs">${icon('plus')} Пакет</button>
          ${field('Что ещё важно про цену', 'priceNote', data.priceNote, { placeholder: 'Выезд за МКАД — 3 000 ₽, предоплата 30 %', note: 'Необязательно. Встанет под пакетами на вашей странице.' })}` };
      }
      case 'zaly': {
        const hs = data.halls ?? [];
        return { title: 'Залы', lead: 'Каждый зал — своя секция на странице площадки: вместимость и цена.', html: `
          <div class="c-items">${hs.map((h: any, i: number) => `
            <div class="c-item">
              ${field('Название зала', `halls.${i}.name`, h.name, { placeholder: 'Стеклянный зал' })}
              <div class="c-grid2">
                ${field('Банкет, гостей до', `halls.${i}.banquet`, h.banquet, { mode: 'numeric' })}
                ${field('Фуршет, гостей до', `halls.${i}.buffet`, h.buffet, { mode: 'numeric' })}
                ${field('Площадь, м²', `halls.${i}.area`, h.area, { mode: 'numeric' })}
                ${field('Аренда или депозит от, ₽', `halls.${i}.priceFrom`, h.priceFrom, { mode: 'numeric' })}
              </div>
              ${field('Коротко о зале', `halls.${i}.note`, h.note, { area: true, placeholder: 'Панорамные окна, выход на веранду' })}
              ${tools('halls', i, hs.length)}
            </div>`).join('')}</div>
          <button class="c-add" type="button" data-add="halls">${icon('plus')} Зал</button>` };
      }
      case 'usloviya':
        return { title: 'Условия', lead: 'Что пара спросит первым. Ответы уйдут в блок условий на странице.', html: `
          ${choices(VENUE_TERMS, 'terms')}
          ${field('До скольки можно гулять', 'terms.until', data.terms?.until, { placeholder: 'До 23:00 в зале, на веранде до 22:00' })}
          ${field('Парковка', 'terms.parking', data.terms?.parking, { placeholder: 'Своя, бесплатная, 30 мест' })}
          ${field('Что ещё важно знать', 'terms.more', data.terms?.more, { area: true, placeholder: 'Депозит, пробковый сбор, декор, ночёвка' })}` };
      case 'kontakty':
        return { title: 'Контакты', lead: 'Пара видит их по кнопке «Показать контакты».', html: `
          ${phoneField(data.contacts?.phone, data.contacts?.phoneCountry)}
          ${field('Telegram', 'contacts.telegram', data.contacts?.telegram, { placeholder: '@ник' })}
          ${field('MAX', 'contacts.max', data.contacts?.max, { placeholder: 'Номер или ник' })}
          ${field('Сайт или соцсеть', 'contacts.site', data.contacts?.site, { placeholder: 'site.ru' })}
          ${field('Почта', 'contacts.email', data.contacts?.email, { type: 'email' })}` };
    }
  }

  function renderSection(key: SectionKey) {
    const b = sectionBody(key);
    view.innerHTML = `
      <div class="c-head">
        <a class="c-back" href="${url()}">${icon('back')} ${esc(data.name || 'Анкета')}</a>
        <div class="c-head__row"><h1 class="a-h1">${b.title}</h1><span class="c-saved" data-saved></span></div>
        ${b.lead ? `<p class="a-lead">${b.lead}</p>` : ''}
        ${locked() ? '<p class="c-reason c-reason--info">Карточка на проверке — менять её сейчас нельзя.</p>' : ''}
      </div>
      <section class="a-card"><div class="c-form" data-form>${b.html}</div></section>
      <div class="c-bar"><a class="a-btn a-btn--primary a-btn--lg" href="${url()}" data-done>Готово</a></div>`;
    savedLabel();
    if (locked()) view.querySelectorAll<HTMLInputElement>('input, textarea, button.c-opt, button.c-add, button.c-tool, button.c-link').forEach((x) => (x.disabled = true));
    if (key === 'foto') renderPhotos();
    if (key === 'kontakty') bindPhone();
  }

  // ---------- фото ----------
  function renderPhotos() {
    const box = view.querySelector<HTMLElement>('[data-photos]');
    if (!box) return;
    const names: string[] = rev.photos ?? [];
    const lock = locked();
    box.innerHTML = names.map((n, i) => `
      <div class="c-photo">
        <img src="${fileUrl(rev, n, { thumb: '400x0', token })}" alt="" loading="lazy" />
        ${i === 0 ? '<span class="c-badge c-photo__tag">Обложка</span>' : ''}
        ${lock ? '' : `<div class="c-photo__tools">
          <button type="button" data-pmove="${i}" data-d="-1" aria-label="Левее" ${i === 0 ? 'disabled' : ''}>${icon('back')}</button>
          <button type="button" data-premove="${i}" aria-label="Убрать"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.6" d="M6 6l12 12M18 6L6 18"/></svg></button>
          <button type="button" data-pmove="${i}" data-d="1" aria-label="Правее" ${i === names.length - 1 ? 'disabled' : ''}>${icon('next')}</button>
        </div>`}
      </div>`).join('') + (lock || names.length >= MAX_PHOTOS ? '' : `
      <label class="c-photo c-photo--add">${icon('plus')}<span>Добавить фото</span>
        <input type="file" accept="image/jpeg,image/png,image/webp" multiple hidden data-pfiles />
      </label>`);
  }

  async function photoPatch(body: any) {
    const err = view.querySelector<HTMLElement>('[data-photo-error]')!;
    err.hidden = true;
    try {
      rev = await api('vendor', 'PATCH', `/api/collections/revisions/records/${rev.id}`, body);
      if (rev.photos?.length && !token) token = await fileToken('vendor');
      savedAt = time();
    } catch (x) {
      err.textContent = (x as Error).message;
      err.hidden = false;
    }
    renderPhotos();
    savedLabel();
  }

  async function upload(files: File[]) {
    const room = MAX_PHOTOS - (rev.photos ?? []).length;
    const status = view.querySelector<HTMLElement>('[data-upload]')!;
    const err = view.querySelector<HTMLElement>('[data-photo-error]')!;
    if (files.length > room) { err.textContent = `Можно добавить ещё ${room} — лишние не загружены.`; err.hidden = false; files = files.slice(0, room); }
    // порциями до 15 МБ: одним запросом 8+ кадров упираются в лимит (прогон 26.10)
    const PART = 15 * 1024 * 1024;
    let left = files.length;
    let queue: File[] = [];
    let size = 0;
    const flush = async () => {
      if (!queue.length) return;
      const fd = new FormData();
      queue.forEach((f) => fd.append('photos+', f, f.name));
      status.textContent = `Загружаем фото… осталось ${left}`;
      status.hidden = false;
      await photoPatch(fd);
      left -= queue.length;
      queue = [];
      size = 0;
    };
    for (const f of files) {
      status.textContent = `Готовим фото… осталось ${left}`;
      status.hidden = false;
      const small = await shrinkPhoto(f);
      if (size + small.size > PART) await flush();
      queue.push(small);
      size += small.size;
    }
    await flush();
    status.hidden = true;
  }

  // ---------- правка полей ----------
  function setPath(path: string, value: unknown) {
    const keys = path.split('.');
    let o = data;
    keys.slice(0, -1).forEach((k, i) => {
      const next = keys[i + 1];
      if (o[k] == null) o[k] = /^\d+$/.test(next) ? [] : {};
      o = o[k];
    });
    o[keys[keys.length - 1]] = value;
  }

  view.addEventListener('input', (e) => {
    const t = e.target as HTMLInputElement;
    if (!t.dataset.bind) return;
    setPath(t.dataset.bind, t.value);
    const count = view.querySelector('[data-count]');
    if (count) count.textContent = `${textLength(data)} знаков`;
    later();
  });

  view.addEventListener('change', async (e) => {
    const t = e.target as HTMLInputElement;
    if (t.matches('[data-pfiles]') && t.files?.length) await upload([...t.files]);
  });

  view.addEventListener('click', async (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('button, a[data-done]');
    if (!b || (b as HTMLButtonElement).disabled) return;
    // вопросы и условия: один вариант или несколько
    if (b.dataset.q) {
      const scope = b.dataset.scope!;
      data[scope] ??= {};
      const cur = data[scope][b.dataset.q];
      const v = b.dataset.v!;
      if (b.dataset.multi === 'true') {
        const list: string[] = Array.isArray(cur) ? cur : [];
        data[scope][b.dataset.q] = list.includes(v) ? list.filter((x) => x !== v) : [...list, v];
      } else {
        data[scope][b.dataset.q] = cur === v ? '' : v;
      }
      const group = b.closest('.c-q')!;
      group.querySelectorAll<HTMLElement>('.c-opt').forEach((o) => {
        const val = data[scope][b.dataset.q!];
        o.setAttribute('aria-pressed', String(Array.isArray(val) ? val.includes(o.dataset.v!) : val === o.dataset.v));
      });
      const val = data[scope][b.dataset.q];
      const empty = group.querySelector('.c-q__empty');
      if ((Array.isArray(val) ? val.length : val) && empty) empty.remove();
      later();
      return;
    }
    // списки: разделы текста, пакеты, залы
    if (b.dataset.add || b.dataset.move || b.dataset.remove || b.hasAttribute('data-template')) {
      if (b.hasAttribute('data-template')) {
        const st = kind === 'venue' ? cfg.structures._venue : cfg.structures[rev.categorySlug] ?? cfg.structures._default;
        data.sections = st.sections.map((x: any) => ({ title: x.title, body: '', hint: x.hint }));
      } else if (b.dataset.add) {
        (data[b.dataset.add] ??= []).push({});
      } else if (b.dataset.move) {
        const list = data[b.dataset.move];
        const i = Number(b.dataset.i), j = i + Number(b.dataset.d);
        [list[i], list[j]] = [list[j], list[i]];
      } else if (b.dataset.remove) {
        data[b.dataset.remove].splice(Number(b.dataset.i), 1);
      }
      renderSection(section()!);
      later();
      return;
    }
    // фото
    if (b.dataset.pmove) {
      const names = [...rev.photos];
      const i = Number(b.dataset.pmove), j = i + Number(b.dataset.d);
      [names[i], names[j]] = [names[j], names[i]];
      await photoPatch({ photos: names });
      return;
    }
    if (b.dataset.premove) {
      await photoPatch({ 'photos-': [rev.photos[Number(b.dataset.premove)]] });
      return;
    }
    if (b.hasAttribute('data-done')) {
      e.preventDefault();
      await save();
      if (!saveError) navigate();
    }
  });

  // переходы внутри анкеты — без перезагрузки, данные уже в памяти
  view.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a.c-row, a.c-back');
    if (!a || !a.href.includes('/profi/moi/kartochka/') || e.metaKey || e.ctrlKey) return;
    e.preventDefault();
    save();
    navigate(a.href);
  });
  function navigate(href = url()) {
    history.pushState(null, '', href);
    route();
  }
  addEventListener('popstate', route);
  // ушли со страницы или свернули браузер — дописываем несохранённое (без «Вы уверены?»)
  document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'hidden' && timer) save(); });

  function route() {
    const p = new URLSearchParams(location.search);
    q.set('s', p.get('s') ?? '');
    if (!p.get('s')) q.delete('s');
    const sec = section();
    if (sec && SECTIONS[kind].some((x) => x.key === sec)) renderSection(sec);
    else renderOverview();
    scrollTo(0, 0);
  }

  async function load() {
    try {
      if (q.get('card')) {
        const r = await api('vendor', 'POST', '/api/wed/edit', { kind: q.get('kind'), card: q.get('card') });
        location.replace(`/profi/moi/kartochka/?id=${r.id}`);
        return;
      }
      rev = await api('vendor', 'GET', `/api/collections/revisions/records/${encodeURIComponent(q.get('id') ?? '')}`);
      kind = rev.kind;
      data = rev.data && typeof rev.data === 'object' ? rev.data : {};
      // карточки до 27.10: имя одним полем — в «Имя», фамилию человек допишет
      if (kind === 'specialist' && data.firstName == null && data.name) data.firstName = data.name;
      // правка старой карточки с «О себе» одним полем — первым разделом текста
      if (!data.sections?.length && data.about) data.sections = [{ title: '', body: data.about }];
      questions = kind === 'venue' ? VENUE_QUESTIONS : cfg.questions[rev.categorySlug] ?? [];
      if (rev.photos?.length) token = await fileToken('vendor');
      route();
    } catch (err) {
      view.innerHTML = `<p class="c-error">${esc((err as Error).message)}</p><a class="c-link" href="/profi/moi/">К моим карточкам</a>`;
    }
  }

  if (s) load();
</script>
