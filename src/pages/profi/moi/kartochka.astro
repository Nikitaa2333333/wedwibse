  };

  /** телефон → data: полный номер в E.164, страна отдельно; неполный не теряем */
  function bindPhone() {
    const picker = view.querySelector<HTMLElement>('.cc-picker');
    const input = view.querySelector<HTMLInputElement>('[data-phone]');
    if (!picker || !input) return;
    attachPhoneField(picker, input);
    const hidden = picker.querySelector<HTMLInputElement>('input[name="phoneCountry"]')!;
    const sync = () => {
      const c = findCountry(hidden.value);
      const digits = nationalDigits(input.value, c);
      data.contacts ??= {};
      data.contacts.phone = digits ? fullE164(digits, c) : '';
      data.contacts.phoneCountry = c.code;
      return { c, digits };
    };
    // ошибка — облачком над строкой телефона (как у Apple), форма не прыгает
    const row = input.closest<HTMLElement>('.c-phone') ?? undefined;
    input.addEventListener('input', () => { sync(); clearFieldError(input); later(); });
    picker.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('.cc-option')) { sync(); later(); } });
    input.addEventListener('blur', () => {
      const { c, digits } = sync();
      if (digits && !isComplete(digits, c)) fieldError(input, `Номер неполный: +${c.dial} и ${c.len} цифр`, row);
      else clearFieldError(input);
    });
  }
  /** сумма в рублях с разрядами для показа в поле: «40000» → «40 000» */
  const MONEY = /(^|\.)(price|priceFrom|rentFrom|checkFrom)$/;
  const money = (v: unknown) => { const d = String(v ?? '').replace(/\D/g, ''); return d ? num(Number(d)) : ''; };
  // grow: поле растёт по тексту — 'line' (одна фраза, переносится, Enter не ставит
  // новую строку) или 'area' (несколько абзацев); без прокрутки внутри (07.11)
  const field = (label: string, bind: string, value0: unknown, opts: { type?: string; note?: string; area?: boolean; placeholder?: string; mode?: string; max?: number; grow?: 'line' | 'area' } = {}, value = MONEY.test(bind) ? money(value0) : value0) => `
    <label class="a-field">
      <span class="a-field__label">${label}</span>
      ${opts.grow
        ? `<textarea class="a-field__input" data-bind="${bind}" data-grow="${opts.grow}" rows="1" ${opts.max ? `maxlength="${opts.max}"` : ''} placeholder="${esc(opts.placeholder ?? '')}">${esc(value)}</textarea>`
        : opts.area
        ? `<textarea class="a-field__input" data-bind="${bind}" ${opts.max ? `maxlength="${opts.max}"` : ''} placeholder="${esc(opts.placeholder ?? '')}">${esc(value)}</textarea>`
        : `<input class="a-field__input" data-bind="${bind}" type="${opts.type ?? 'text'}" ${opts.mode ? `inputmode="${opts.mode}"` : ''} ${opts.max ? `maxlength="${opts.max}"` : ''} value="${esc(value)}" placeholder="${esc(opts.placeholder ?? '')}" />`}
      ${opts.note ? `<span class="a-field__note">${opts.note}</span>` : ''}
    </label>`;

  /** высота поля data-grow — по тексту */
  function grow(t: HTMLTextAreaElement) {
    t.style.height = 'auto';
    t.style.height = `${t.scrollHeight}px`;
  }

  const choices = (qs: Question[], scope: 'filters' | 'terms') => qs.map((g) => {
    const cur = data[scope]?.[g.key];
    const on = (v: string) => (Array.isArray(cur) ? cur.includes(v) : cur === v);
    return `
      <div class="c-q">
        <span class="c-q__label">${esc(g.label)}${g.type === 'multi' ? '<span class="c-q__hint">можно выбрать несколько</span>' : ''}</span>
        <div class="c-opts">${g.options.map((o) => `<button class="c-opt" type="button" aria-pressed="${on(o.value)}" data-scope="${scope}" data-q="${g.key}" data-v="${esc(o.value)}" data-multi="${g.type === 'multi'}">${esc(o.label)}</button>`).join('')}</div>
      </div>`;
  }).join('');

  // ФОТО ЗАЛА (08.11): кадры выбираются из уже загруженных в «Фото» — отдельной
  // загрузки и своего потолка у зала нет. На сайте зал с фото — секция с рядом
  // кадров (как у площадок конвейера), без фото — пунктом списка (lib/cabinet-venue.mjs)
  const hallNames = (h: any): string[] => (Array.isArray(h?.photos) ? h.photos : []).filter((n: string) => (rev.photos ?? []).includes(n));
  const hallPhotos = (h: any, i: number) => {
    const names = hallNames(h);
    return `
      <div class="a-field">
        <span class="a-field__label">Фото зала</span>
        ${names.length ? `<div class="c-photos c-photos--mini">${names.slice(0, 1).map((n) => `<span class="c-photo"><img src="${fileUrl(rev, n, { thumb: '200x0', token })}" alt="" loading="lazy" /></span>`).join('')}</div>` : ''}
        ${locked() ? '' : (rev.photos ?? []).length
          ? names.length
            ? `<button class="c-link" type="button" data-hall-photos="${i}">Заменить кадр</button>`
            // ничего не выбрано — мелкий ряд загруженных кадров, чтобы было понятно, из чего выбирать (Никита 09.11)
            : `<button class="c-hall-pick" type="button" data-hall-photos="${i}">
                <span class="c-hall-pick__row">${(rev.photos ?? []).slice(0, 6).map((n: string) => `<img src="${fileUrl(rev, n, { thumb: '200x0', token })}" alt="" loading="lazy" />`).join('')}</span>
                <span class="c-link">Выбрать кадр из загруженных</span>
              </button>`
          : '<span class="a-field__note">Сначала загрузите фото в разделе «Фото» — здесь выберете кадры этого зала</span>'}
      </div>`;
  };

  /** окно выбора кадров зала: отметка нажатием, номер — порядок на странице */
  function openHallPhotos(i: number) {
    const hall = data.halls?.[i];
    if (!hall) return;
    const all: string[] = rev.photos ?? [];
    const picked = hallNames(hall).slice(0, 1);
    const { dlg, close } = openDialog({
      html: `<div class="c-dialog__body">
      <button class="c-dialog__x" type="button" data-close aria-label="Закрыть">${X_ICON}</button>
      <h2 class="a-h2">Фото зала${hall.name ? ` «${esc(hall.name)}»` : ''}</h2>
      <p class="a-lead">Выберите один кадр — он встанет у зала на странице</p>
      <div class="c-photos c-yd-grid">${all.map((n) => `
        <button class="c-photo c-yd-pick" type="button" aria-pressed="false" data-hp="${esc(n)}">
          <img src="${fileUrl(rev, n, { thumb: '400x0', token })}" alt="" loading="lazy" />
          <span class="c-yd-pick__n" aria-hidden="true"></span>
        </button>`).join('')}</div>
      <div class="c-yd-bar"><button class="a-btn a-btn--primary a-btn--lg a-btn--block" type="button" data-hp-done>Готово</button></div>
    </div>`,
    });
    const sync = () => dlg.querySelectorAll<HTMLElement>('[data-hp]').forEach((b) => {
      const k = picked.indexOf(b.dataset.hp!);
      b.setAttribute('aria-pressed', String(k !== -1));
      b.querySelector('.c-yd-pick__n')!.textContent = k === -1 ? '' : String(k + 1);
    });
    dlg.addEventListener('click', (e) => {
      const t = (e.target as HTMLElement).closest<HTMLElement>('[data-hp], [data-hp-done]');
      if (!t) return;
      if (t.dataset.hp) {
        // один кадр на зал (Никита 09.11): сайт показывает у зала один кадр — нажатие заменяет выбор
        const k = picked.indexOf(t.dataset.hp);
        picked.splice(0, picked.length, ...(k === -1 ? [t.dataset.hp] : []));
        sync();
        return;
      }
      hall.photos = [...picked];
      close();
      renderSection('zaly');
      later();
    });
    sync();
  }

  const tools = (list: string, i: number, n: number) => `
    <div class="c-item__tools">
      <button class="c-tool c-tool--up" type="button" data-move="${list}" data-i="${i}" data-d="-1" aria-label="Выше" ${i === 0 ? 'disabled' : ''}>${icon('back')}</button>
      <button class="c-tool c-tool--down" type="button" data-move="${list}" data-i="${i}" data-d="1" aria-label="Ниже" ${i === n - 1 ? 'disabled' : ''}>${icon('back')}</button>
      <button class="c-tool" type="button" data-remove="${list}" data-i="${i}" aria-label="Удалить">${X_ICON}</button>
    </div>`;

  /** первый абзац нашего текста — с него начинается «Коротко о себе» (07.11) */
  const firstParagraph = () => {
    const body = String((data.sections ?? []).find((x: any) => String(x?.body ?? '').trim())?.body ?? '');
    return body.split(/\n\s*\n/)[0].replace(/^\s*>\s*/, '').trim();
  };

  /** портрет: тот же выбор файла с кадрированием, что в обычной анкете */
  // «Подровнять» (Никита 09.11): тот же круг кадрирования, но с уже стоящим портретом —
  // сдвинуть и приблизить без новой загрузки
  const avatarField = () => `
    <div class="a-field">
      <span class="a-field__label">Портрет</span>
      <div class="c-ava-row">
        <label class="c-ava" for="c-ava-file">
          <span class="c-ava__img" data-ava>${rev.avatar ? `<img src="${fileUrl(rev, rev.avatar, { thumb: '200x200', token })}" alt="" />` : icon('profile')}</span>
        </label>
