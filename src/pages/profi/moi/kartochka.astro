          <label class="c-chipbtn" for="c-ava-file">${rev.avatar ? 'Заменить фото' : 'Загрузить фото'}</label>
          ${rev.avatar && !locked() ? '<button class="c-chipbtn" type="button" data-ava-recrop>Подровнять</button>' : ''}
        </div>
        <input id="c-ava-file" type="file" accept="image/jpeg,image/png,image/webp" hidden data-avatar />
      </div>
    </div>`;

  /** карточка «ведём мы»: имя и основной текст — просьбой; портрет, строку
   *  под именем, «Коротко о себе» и фото владелец меняет сам (07.11).
   *  Фото — обычный раздел анкеты (sectionBody), здесь его нет. */
  function managedBody(key: SectionKey): { title: string; lead: string; html: string } | null {
    if (!managed()) return null;
    if (ourVenue()) return ourVenueBody(key);
    if (key === 'osnovnoe') return { title: role(), lead: '', html: `
      <dl class="c-card c-ro">
        <div class="c-ro__row"><dt class="c-ro__label">Имя</dt><dd class="c-ro__value">${esc(data.name)}</dd></div>
      </dl>
      ${field('Строка под именем', 'tagline', data.tagline, { grow: 'line', placeholder: 'Репортаж без постановки, плёнка по желанию', note: kind === 'venue' ? 'Одна фраза, до 80 знаков — её видно в каталоге' : 'Одна фраза, до 80 знаков. Профессию не пишите — она стоит перед фразой сама', max: 80 })}
      ${avatarField()}
      ${writeBtn()}` };
    if (key === 'tekst') {
      // текст «ведём мы» правим только мы (Никита 09.11): поле «Коротко о себе»
      // (первый абзац) убрано — оторванный от продолжения абзац правили невпопад,
      // а у WhyNot в нём стоял список и дублировался. Здесь — ссылка и просьба
      const page = `/moskva/podryadchiki/${rev.categorySlug}/${rev.slug}/`;
      return { title: 'Описание', lead: `<a href="${page}" target="_blank" rel="noopener">Текст на странице</a>`, html: writeBtn() };
    }
    // цена «ведём мы» при тарифах в тексте страницы (Никита 09.11): «одна цена»
    // разошлась бы с тарифами на странице — цены меняем мы, по просьбе
    // 09.11 (Никита): цифры в своих тарифах владелец меняет сам; название, «за что»
    // и состав тарифа — наши (просьбой). «Цена от» и «за что» — для каталога
    if (key === 'prays' && textTariffs > 0) {
      const tp: any[] = data.tariffPrices ?? [];
      return { title: 'Цена', lead: 'Поменяйте цены тарифов — на странице обновятся после проверки', html: `
        <div class="c-items">
          ${pageTariffs.map((t, i) => field(`${esc(t.name)}${t.unit ? `, ${esc(t.unit)}` : ''}`, `tariffPrices.${i}.price`, tp[i]?.price, { mode: 'numeric', placeholder: String(t.price) })).join('')}
        </div>
        <div class="c-grid2">
          ${field('Цена от, ₽ (в каталоге)', 'priceFrom', data.priceFrom, { mode: 'numeric', placeholder: '40 000' })}
          ${field('За что', 'priceNote', data.priceNote, { grow: 'line', max: 300, placeholder: 'за 8 часов съёмки' })}
        </div>
        ${writeBtn()}` };
    }
    return null;
  }

  /** экраны площадки «ведём мы»; null — обычный экран (контакты) */
  function ourVenueBody(key: SectionKey): { title: string; lead: string; html: string } | null {
    const page = `/moskva/ploshchadki/${rev.slug}/`;
    if (key === 'osnovnoe') {
      const opts = VENUE_QUESTIONS.find((q) => q.key === 'type')?.options ?? [];
      return { title: role(), lead: '', html: `
        ${/* название и адрес — крупным текстом без плашки (Никита 09.11): это не поле, его не правят */ ''}
        <dl class="c-ro c-ro--bare">
          <div class="c-ro__row"><dt class="c-ro__label">Название</dt><dd class="c-ro__value">${esc(data.name)}</dd></div>
          ${data.address ? `<div class="c-ro__row"><dt class="c-ro__label">Адрес</dt><dd class="c-ro__value">${esc(data.address)}</dd></div>` : ''}
        </dl>
        <div class="c-q">
          <span class="c-q__label">Тип площадки</span>
          <div class="c-opts">${opts.map((o) => `<button class="c-opt" type="button" aria-pressed="${data.type === o.value}" data-vtype="${esc(o.value)}">${esc(o.label)}</button>`).join('')}</div>
        </div>
        <div class="c-grid2">
          ${field('Гостей на банкете, до', 'capacityBanquet', data.capacityBanquet, { mode: 'numeric', placeholder: '120', note: 'По нему пары фильтруют каталог' })}
          ${field('Средний чек от, ₽ на гостя', 'checkFrom', data.checkFrom, { mode: 'numeric', placeholder: '5 000', note: 'Сколько в среднем стоит банкет на одного гостя' })}
        </div>
        ${writeBtn()}` };
    }
    if (key === 'usloviya') {
      const rows: any[] = data.rows ?? [];
      const groups = [...new Set(rows.map((r) => r.group))];
      // группа строк — плашкой, как зал в «Тарифах залов» (одна плашка на объект)
      return { title: 'Цены и условия', lead: `Поменяйте цены и условия — на <a href="${page}" target="_blank" rel="noopener">странице</a> обновятся после проверки`, html: rows.length ? `
        <div class="c-items">${groups.map((g) => `
          <div class="c-item">
            <p class="c-q__label">${esc(g)}</p>
            ${rows.map((r, i) => (r.group === g ? field(esc(r.label), `rows.${i}.value`, r.value, { grow: 'line', max: 300 }) : '')).join('')}
          </div>`).join('')}</div>` : writeBtn() };
    }
    if (key === 'zaly') {
      const halls: any[] = data.hallTariffs ?? [];
      return { title: 'Тарифы залов', lead: 'Аренда и минимальный заказ по меню — по дням недели, как на странице', html: `
        <div class="c-items">${halls.map((h, i) => `
          <div class="c-item">
            <p class="c-q__label">${esc(h.name)}</p>
            ${(h.tariff ?? []).map((t: any, j: number) => `
              <div class="c-grid2">
                ${field(`${esc(t.day)}: аренда`, `hallTariffs.${i}.tariff.${j}.rent`, t.rent, { placeholder: '100 000 ₽' })}
                ${field(`${esc(t.day)}: заказ от`, `hallTariffs.${i}.tariff.${j}.deposit`, t.deposit, { placeholder: '250 000 ₽' })}
              </div>`).join('')}
          </div>`).join('')}</div>` };
    }
    if (key === 'foto') {
      // фото площадки «ведём мы» владелец будет убирать сам, как подрядчик (Никита 09.11) — отдельным шагом с хуками
      return { title: 'Фото', lead: `<a href="${page}" target="_blank" rel="noopener">Фото на странице</a>`, html: writeBtn() };
    }
    if (key === 'tekst') {
      return { title: 'Описание', lead: `<a href="${page}" target="_blank" rel="noopener">Текст на странице</a>`, html: writeBtn() };
    }
    return null;
  }

  function sectionBody(key: SectionKey): { title: string; lead: string; html: string } {
    const m = managedBody(key);
    if (m) return m;
    switch (key) {
      case 'osnovnoe':
        return kind === 'venue'
          ? { title: role(), lead: '', html: `
              ${field('Название площадки', 'name', data.name, { placeholder: 'Лофт «Причал»' })}
              ${field('Адрес', 'address', data.address, { placeholder: 'Начните вводить: город, улица, дом' })}
