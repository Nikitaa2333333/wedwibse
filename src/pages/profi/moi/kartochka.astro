---
// АНКЕТА КАРТОЧКИ — полный ход заполнения на живой базе (27.10.2026).
//   ?id=<ревизия>          — список разделов с состоянием и «Отправить на проверку»
//   ?id=<ревизия>&s=<раздел> — раздел своим экраном (docs/cabinet/CABINET-UX.md §2 п.4)
//   ?card=<id>&kind=…      — правка опубликованной: /api/wed/edit даёт черновик-копию
// Разделы и их заполненность — lib/cabinet-form.ts; что можно отправить,
// решает хук базы (submitProblems). Всё сохраняется само, через секунду
// после правки; фото — сразу. Вид — система админки (CabinetShell).
// Данные рисует браузер: экран за входом, в поиск не идёт (noindex).
import CabinetShell from '../../../components/admin/CabinetShell.astro';
// значок Яндекс Диска (Wikimedia Commons, общественное достояние) — у кнопки и окна Диска (Никита 05.11)
import ydIcon from '../../../assets/profi/yandex-disk.png';
import { SPECIALIST_CATEGORIES, FILTERS_BY_CATEGORY } from '../../../data/specialists';
import { STRUCTURES, DEFAULT_STRUCTURE, VENUE_STRUCTURE } from '../../../data/profi-structures';

const roles = Object.fromEntries(SPECIALIST_CATEGORIES.map((c) => [c.slug, c.role]));
// бирка под именем в предпросмотре — тем же правилом, что на сайте (lib/kicker.ts)
const kickerRoles = Object.fromEntries(SPECIALIST_CATEGORIES.map((c) => [c.slug, { role: c.role, roleF: c.roleF ?? c.role, label: c.label }]));
// вопросы подрядчика — фильтры его категории (specialist-filters.ts):
// по этим ответам пары находят карточку в каталоге
const questions = Object.fromEntries(
  Object.entries(FILTERS_BY_CATEGORY).map(([k, groups]) => [
    k,
    groups.map((g) => ({ key: g.key, label: g.label, type: g.type, options: g.options.map((o) => ({ value: o.value, label: o.label })) })),
  ]),
);
const structures = { ...STRUCTURES, _default: DEFAULT_STRUCTURE, _venue: VENUE_STRUCTURE };
// ключ JS API Карт — тот же публичный браузерный ключ, что у карты каталога
// (VenueMap): защищён списком доменов в кабинете Яндекса, читается из секрета на сборке
const mapsKey = import.meta.env.YANDEX_MAPS_API_KEY ?? '';
---

<CabinetShell title="Анкета" section="cards">
  <div class="cab-col" data-anketa>
    <div data-view aria-busy="true" aria-label="Загружаем"><div class="sk-head"><span class="sk sk--line sk--short"></span><span class="sk sk--title"></span><span class="sk sk--bar"></span></div><div class="sk-tiles"><div class="sk-tile"><span class="sk sk--ic"></span><span class="sk sk--line" style="width:55%;height:18px;margin-top:12px"></span><span class="sk sk--line"></span></div><div class="sk-tile"><span class="sk sk--ic"></span><span class="sk sk--line" style="width:55%;height:18px;margin-top:12px"></span><span class="sk sk--line"></span></div><div class="sk-tile"><span class="sk sk--ic"></span><span class="sk sk--line" style="width:55%;height:18px;margin-top:12px"></span><span class="sk sk--line"></span></div><div class="sk-tile"><span class="sk sk--ic"></span><span class="sk sk--line" style="width:55%;height:18px;margin-top:12px"></span><span class="sk sk--line"></span></div><div class="sk-tile"><span class="sk sk--ic"></span><span class="sk sk--line" style="width:55%;height:18px;margin-top:12px"></span><span class="sk sk--line"></span></div><div class="sk-tile"><span class="sk sk--ic"></span><span class="sk sk--line" style="width:55%;height:18px;margin-top:12px"></span><span class="sk sk--line"></span></div></div></div>
  </div>
  <script type="application/json" id="anketa-config" set:html={JSON.stringify({ roles, kickerRoles, questions, structures, ydIcon: ydIcon.src, mapsKey })} />
</CabinetShell>

<script>
  import { api, apiUpload, esc, fileToken, fileUrl, requireSession, errText } from '../../../lib/cabinet-api';
  import { ADMIN_ICONS } from '../../../lib/admin-icons';
  import { joinKicker } from '../../../lib/kicker';
  import { openDialog, toast, X_ICON, later as undoable, progress, alertBox } from '../../../lib/cab-ui';
  import { mountNotes, blocksHtml } from '../../../lib/notes-editor';
  import { sectionsToBlocks, blocksToSections, plural } from '../../../lib/notes-model';
  import { fieldError, clearFieldError } from '../../../lib/form-check';
  import { mountGeoPick } from '../../../lib/geo-pick';
  import { PHONE_COUNTRIES, DEFAULT_PHONE_COUNTRY, findCountry, flagSrc, nationalDigits, isComplete, fullE164, attachPhoneField } from '../../../lib/phone';
  import {
    SECTIONS, VENUE_QUESTIONS, VENUE_TERMS, MAX_PHOTOS, MAX_VIDEOS, MIN_PHOTOS, MIN_TEXT,
    sectionState, sectionTodo, priceUnits, MAX_TARIFFS, HALL_NOTE_MAX, cardState, priceFrom, rub, num, textLength, shrinkPhoto, NBSP,
    type Kind, type SectionKey, type Question,
  } from '../../../lib/cabinet-form';

  const cfg = JSON.parse(document.getElementById('anketa-config')!.textContent!);
  const view = document.querySelector<HTMLElement>('[data-view]')!.parentElement!;
  const icon = (n: string, cls = '') => `<svg class="${cls}" viewBox="0 0 24 24" aria-hidden="true">${(ADMIN_ICONS as Record<string, string>)[n] ?? ''}</svg>`;
  const go = '<svg class="c-row__go" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M9 5l6 7-6 7"/></svg>';
  // «Добавить …»: один круг и толстый плюс (Никита 05.11: был круг в круге и мелкий плюс)
  const ADD_IC = '<span class="c-add__ic" aria-hidden="true"><svg viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="2.4" d="M12 5v14M5 12h14"/></svg></span>';
  // значок подсказки в плитке: что сделать — не данными, а подсказкой (Никита 05.11)
  const TODO_IC = '<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M12 7.5v5.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><circle cx="12" cy="16.3" r="1.1" fill="currentColor"/></svg>';
  const tick = '<svg class="c-row__state" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M5 12.5l4.5 4.5L19 7.5"/></svg>';
  const q = new URLSearchParams(location.search);
  const s = requireSession('vendor');

  let rev: any = null;
  /** «ведём мы»: сколько тарифов стоит в тексте страницы (page.story) — тогда цену правим мы */
  let textTariffs = 0;
  /** тарифы из текста визитки (имя, цена строкой) — подписи полей цен (09.11) */
  let pageTariffs: { name: string; price: string; unit?: string }[] = [];
  // СЛЕПОК КАРТОЧКИ НА САЙТЕ (Никита 08.11): у одобренной карточки сразу горела
  // «Отправить изменения на проверку» — нажал, и ушла правка без изменений.
  // base — анкета и фото черновика в момент, когда правку начали (база кладёт
  // в него ровно то, что на сайте; сама анкета карточки подрядчику закрыта —
  // в ней контакты). Пока черновик с ним совпадает — «Карточка на сайте», кнопки нет.
  // Слепок живёт в браузере (localStorage); нет его — кнопка видна, как раньше.
  type Snap = { form: any; photos: string[]; avatar: string; cover: string };
  let base: Snap | null = null;
  const snapKey = () => `wed-cab-base-${rev.id}`;
  const snapNow = (): Snap => ({ form: norm(data) ?? {}, photos: [...(rev.photos ?? [])], avatar: rev.avatar || '', cover: rev.cover || rev.photos?.[0] || '' });
  /** пустое не считается: автосохранение пустого поля — не правка */
  const norm = (v: any): any => {
    if (v == null || v === '') return undefined;
    if (Array.isArray(v)) { const a = v.map(norm).filter((x) => x !== undefined); return a.length ? a : undefined; }
    if (typeof v === 'object') {
      const o: any = {};
      for (const k of Object.keys(v).sort()) { const x = norm(v[k]); if (x !== undefined) o[k] = x; }
      return Object.keys(o).length ? o : undefined;
    }
    return typeof v === 'number' ? String(v) : v;
  };
  const sameAsSite = () => {
    if (!base || isNew()) return false;
    const photos: string[] = rev.photos ?? [];
    return JSON.stringify(norm(data) ?? {}) === JSON.stringify(base.form)
      && photos.join('|') === base.photos.join('|')
      && (rev.avatar || '') === base.avatar
      && (rev.cover || photos[0] || '') === base.cover;
  };
  let data: any = {};
  let kind: Kind = 'specialist';
  let questions: Question[] = [];
  let token = '';
  let timer = 0;
  let saving: Promise<void> | null = null;
  let savedAt = '';
  let saveError = '';

  // Пустой раздел краснеет только после попытки отправить или возврата
  // модератором (Никита, 02.11: «ещё ничего не заполнил, а уже как ошибка»).
  // Попытку помним до закрытия вкладки.
  const triedKey = () => `wed-cab-tried-${rev?.id}`;
  const tried = () => rev?.status === 'rejected' || (() => { try { return sessionStorage.getItem(triedKey()) === '1'; } catch { return false; } })();
  const markTried = () => {
    try { sessionStorage.setItem(triedKey(), '1'); } catch {}
    view.querySelectorAll('.c-row__sub--empty').forEach((el) => el.classList.replace('c-row__sub--empty', 'c-row__sub--bad'));
  };
  const locked = () => rev?.status === 'review' || rev?.status === 'approved';
  const isNew = () => !rev.venue && !rev.specialist;
  // «Карточку ведём мы» (пилот, 03.11, docs/cabinet/CABINET.md §24): визитку оформили мы,
  // владелец сам меняет цену, вопросы, контакты, видео, а с 07.11 ещё портрет,
  // строку под именем и «Коротко о себе»; основной текст, фото и имя — просьбой
  // «что поправить» (data.requests). Хук всё равно пропускает только это —
  // экран просто не предлагает лишнего.
  const managed = () => data?.managed === true && !isNew();
  // текст — без «оформили мы» (Никита 07.11: «как будто мы самые главные»); плашку можно закрыть
  const MANAGED_NOTE = 'Карточка уже заведена администраторами. Вы можете поправить портрет, строку под именем, фото, цену, ответы на вопросы, контакты и добавить видео. Что поменять в тексте, напишите нам — мы быстро поправим.';
  const mnoteKey = () => `wed-cab-mnote-${rev?.venue || rev?.specialist}`;
  // ПЛОЩАДКА «ВЕДЁМ МЫ» (Никита 09.11): страницу держим мы, владелец меняет тип,
  // вместимость, чек, значения строк «Характеристик» и «Условий», тарифы залов,
  // контакты; текст и фото — просьбой. Хук пропускает только это (lockManagedVenue)
  const ourVenue = () => managed() && kind === 'venue';
  const MANAGED_VENUE_NOTE = 'Страницу площадки заводили мы. Вы можете поменять тип, вместимость, средний чек, цены и условия, тарифы залов и контакты. Что поменять в тексте и фото, напишите нам — поправим сами.';
  /** разделы площадки «ведём мы»: те же экраны анкеты, свой набор и свои подписи */
  const ourVenueTiles = () => {
    const rows: any[] = data.rows ?? [];
    const halls: any[] = data.hallTariffs ?? [];
    const c = data.contacts ?? {};
    return [
      { key: 'osnovnoe', title: 'Основное', icon: 'profile', done: true, sub: [TYPE_LABELS[data.type], data.capacityBanquet && `до ${num(Number(data.capacityBanquet))} гостей`, data.checkFrom && `чек от ${rub(Number(data.checkFrom))}`].filter(Boolean).join(', ') || 'тип, гости, чек' },
      { key: 'usloviya', title: 'Цены и условия', icon: 'notes', done: true, sub: `${rows.length} ${plural(rows.length, 'строка', 'строки', 'строк')}` },
      ...(halls.length ? [{ key: 'zaly', title: 'Тарифы залов', icon: 'catalog', done: true, sub: `${halls.length} ${plural(halls.length, 'зал', 'зала', 'залов')}` }] : []),
      { key: 'foto', title: 'Фото', icon: 'photo', done: true, optional: true, sub: data.requests?.photos ? 'есть просьба' : 'меняем по просьбе' },
      { key: 'tekst', title: 'Описание', icon: 'text', done: true, optional: true, sub: data.requests?.text ? 'есть просьба' : 'меняем по просьбе' },
      { key: 'kontakty', title: 'Контакты', icon: 'phone', done: !!String(c.phone ?? '').trim(), sub: [c.phone && 'телефон', c.telegram && 'Telegram', c.site && 'сайт', c.email && 'почта'].filter(Boolean).join(', ') || 'пусто, нужен телефон' },
    ];
  };
  const TYPE_LABELS: Record<string, string> = Object.fromEntries((VENUE_QUESTIONS.find((q) => q.key === 'type')?.options ?? []).map((o) => [o.value, o.label]));
  const mnoteHidden = () => { try { return localStorage.getItem(mnoteKey()) === '1'; } catch { return false; } };
  /** «Написать об изменениях» (Никита 09.11): вместо полей-просьб в каждом экране — одна кнопка.
   *  Окно с одним полем, текст — в requests.text ревизии, уходит модератору с отправкой на проверку */
  const requestsText = () => {
    const r = data.requests ?? {};
    return [r.text, r.price, r.photos].map((x: unknown) => String(x ?? '').trim()).filter(Boolean).join('\n\n');
  };
  const writeBtn = () => {
    const t = requestsText();
    return `<button class="c-write" type="button" data-write-changes>
      <span class="c-write__t">Написать об изменениях</span>
      <span class="c-write__s">${t ? `Ваше сообщение: ${esc(t.length > 90 ? `${t.slice(0, 90)}…` : t)}` : 'Текст, фото, название — что поменять, напишите. Поправим после проверки'}</span>
      ${icon('next')}
    </button>`;
  };
  function openWriteChanges(onDone: () => void) {
    const { dlg, close } = openDialog({
      html: `<div class="c-dialog__body">
      <button class="c-dialog__x" type="button" data-close aria-label="Закрыть">${X_ICON}</button>
      <h2 class="a-h2">Написать об изменениях</h2>
      <p class="a-lead">Что поменять в тексте, фото или названии. Модератор получит это вместе с отправкой на проверку</p>
      <textarea class="a-field__input c-write__area" rows="6" placeholder="Например: добавьте, что у нас новое меню" data-write-area>${esc(requestsText())}</textarea>
      <button class="a-btn a-btn--primary a-btn--lg a-btn--block" type="button" data-write-done>Готово</button>
    </div>`,
    });
    const area = dlg.querySelector<HTMLTextAreaElement>('[data-write-area]')!;
    dlg.querySelector('[data-write-done]')!.addEventListener('click', () => {
      const v = area.value.trim();
      data.requests = v ? { text: v.slice(0, 3000) } : {};
      close();
      later();
      onDone();
    });
  }
  const role = () => (kind === 'venue' ? 'Площадка' : cfg.roles[rev.categorySlug] ?? rev.categorySlug);
  /** строка под именем так, как её покажет сайт: «Профессия · строка» без повтора профессии */
  const kickerLine = (): string => {
    const t = String(data.tagline ?? '').trim();
    if (kind === 'venue') return t;
    const k = cfg.kickerRoles?.[rev.categorySlug];
    if (!k) return t;
    const g = data.filters?.gender;
    const female = (Array.isArray(g) ? g[0] : g) === 'ж';
    const pair = (Array.isArray(g) ? g[0] : g) === 'pair';
    return joinKicker(pair ? k.label : female ? k.roleF : k.role, t, [k.role, k.roleF, k.label]);
  };
  const section = () => q.get('s') as SectionKey | null;
  const url = (sec?: string) => `/profi/moi/kartochka/?id=${rev.id}${sec ? `&s=${sec}` : ''}`;
  const time = () => new Date().toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit' });

  // ---------- сохранение ----------
  /** плашка в углу: статус карточки и время сохранения — одним местом */
  // Никита, 02.11: пилюля «Черновик · сохранено 12:00» висела постоянно
  // и дёргалась на каждой правке — статус карточки только на обзоре.
  // 05.11 (вариант «Б»): тост «Сохранено» на каждую правку убран — он
  // выскакивал раз в секунду и закрывал низ экрана. Вместо него в шапке
  // раздела тихая, но заметная метка «✓ Сохранено в 14:32». Ошибка — и
  // в метке красным, и тостом, пока следующее сохранение не пройдёт.
  let justSaved = false;
  function savedLabel() {
    const el = view.querySelector<HTMLElement>('[data-saved]');
    if (el) {
      const st = cardState(rev.status, !isNew());
      el.className = `status c-state ${st.cls}`;
      el.textContent = st.label;
    }
    const mark = view.querySelector<HTMLElement>('[data-savemark]');
    if (mark) {
      mark.classList.toggle('c-saved--bad', !!saveError);
      mark.innerHTML = saveError ? 'Не сохранилось' : savedAt ? `${tick}Сохранено в ${savedAt}` : '';
    }
    if (saveError) toast(`Не сохранилось. ${saveError}`, true, undefined, { label: 'Повторить', fn: () => { save(); } });
    else document.querySelector('.c-toast--bad')?.classList.remove('is-on');
    justSaved = false;
  }

  /** производные поля — то, что человек не вводит руками */
  function derive() {
    if (kind === 'venue' && data.managed) {
      // «ведём мы»: залов в анкете нет, гостей владелец вводит сам — пересчёт по залам
      // затирал вместимость пустым при первом автосохранении (LED, Довиль, Барвиха, 09.11)
    } else if (kind === 'venue') {
      const halls = (data.halls ?? []).filter((h: any) => h?.name);
      const max = (k: string) => Math.max(0, ...halls.map((h: any) => Number(h?.[k]) || 0)) || '';
      data.capacityBanquet = max('banquet');
      data.capacityBuffet = max('buffet');
    } else {
      // цена по способу. Тарифы, ушедшие при смене способа, лежат в
      // tariffsDraft — вернулся к тарифам, они на месте. В базу и на сайт
      // идут только priceFrom / priceNote / tariffs (хук, pb-pull-cabinet).
      const mode = priceMode();
      if (mode !== 'tariffs' && data.tariffs?.length) { data.tariffsDraft = data.tariffs; data.tariffs = []; }
      if (mode === 'tariffs' && !data.tariffs?.length && data.tariffsDraft?.length) { data.tariffs = data.tariffsDraft; delete data.tariffsDraft; }
      if (mode === 'tariffs') {
        const ts = (data.tariffs ?? []).filter((t: any) => Number(String(t?.price ?? '').replace(/\s/g, '')) > 0);
        const cheapest = ts.sort((a: any, b: any) => Number(a.price) - Number(b.price))[0];
        data.priceFrom = cheapest ? Number(String(cheapest.price).replace(/\s/g, '')) : '';
        // «за что» у цены «от» — единица самого дешёвого тарифа, иначе
        // визитка подставит общее «за 6 часов работы»
        data.priceNote = cheapest?.unit ?? '';
      }
      if (mode === 'request') { data.priceFrom = ''; data.priceNote = ''; }
      if (data.contacts?.maxSame) data.contacts.max = data.contacts.phone ?? '';
      // имя в каталоге — «Имя Фамилия»; у студии фамилии нет
      data.name = [data.firstName, data.lastName].map((x) => String(x ?? '').trim()).filter(Boolean).join(' ');
    }
  }

  async function save() {
    clearTimeout(timer);
    timer = 0;
    if (saving) await saving;
    if (locked()) return;
    derive();
    saving = (async () => {
      savedLabel();
      try {
        const body: any = { data };
        // адрес страницы новой карточки — по названию, один раз
        if (isNew() && !rev.slug && String(data.name ?? '').trim().length >= 2) {
          const sl = await api('vendor', 'GET', `/api/wed/slug?kind=${kind}&category=${rev.categorySlug}&name=${encodeURIComponent(data.name)}`);
          if (sl.suggestion) body.slug = sl.suggestion;
        }
        rev = await api('vendor', 'PATCH', `/api/collections/revisions/records/${rev.id}`, body);
        savedAt = time();
        saveError = '';
        justSaved = true;
      } catch (err) {
        saveError = errText(err);
      }
    })();
    await saving;
    saving = null;
    savedLabel();
  }
  const later = () => { clearTimeout(timer); saveError = ''; timer = window.setTimeout(save, 900); };

  // ---------- обзор: список разделов ----------
  // Никита, 02.11: плитка показывает уже сделанное — портрет вместо значка
  // «Основного», первые кадры вместо значка «Фото». Заполнено —
  // тонкая галочка в углу (зелёные и красные плитки — «светофор», сняты 02.11).
  function tileVisual(key: SectionKey, ic: string): string {
    if (key === 'osnovnoe' && rev.avatar && token) {
      return `<span class="c-tile__ava"><img src="${fileUrl(rev, rev.avatar, { thumb: '200x200', token })}" alt="" /></span>`;
    }
    const photos: string[] = rev.photos ?? [];
    // у площадки портрета нет — в «Основном» её обложка (Никита 08.11)
    if (key === 'osnovnoe' && kind === 'venue' && photos.length && token) {
      return `<span class="c-tile__ava"><img src="${fileUrl(rev, photos[0], { thumb: '200x200', token })}" alt="" /></span>`;
    }
    if (key === 'foto' && photos.length && token) {
      return `<span class="c-tile__stack">${photos.slice(0, 3).map((n) => `<img src="${fileUrl(rev, n, { thumb: '200x0', token })}" alt="" loading="lazy" />`).join('')}</span>`;
    }
    return `<span class="c-tile__ic">${icon(ic)}</span>`;
  }

  /**
   * Плашка возврата (Никита 05.11, «прокачать»): значок и заголовок, причина
   * словами модератора отдельным абзацем, капсула-переход в раздел, который
   * исправлять. Раздел угадываем по словам причины — до замечаний модератора
   * с привязкой к разделу и кадрам (поле remarks, задача серверной части).
   */
  function rejectKey(): SectionKey | undefined {
    if (rev.status !== 'rejected' || !rev.rejectReason) return undefined;
    const r = String(rev.rejectReason ?? '').toLowerCase();
    const guess: [RegExp, SectionKey][] = [
      [/фото|кадр|снимк|обложк|портрет/, 'foto'], [/текст|описани|о себе|раздел/, 'tekst'],
      [/цен|тариф|стоимост|прайс|₽/, 'prays'], [/телефон|контакт|почт|telegram|max|сайт/, 'kontakty'],
      [/зал|вместим/, 'zaly'], [/кухн|алкогол|услови|парковк/, 'usloviya'], [/вопрос|фильтр/, 'voprosy'],
      [/имя|назван|адрес/, 'osnovnoe'], [/видео|ролик/, 'video'],
    ];
    return guess.find(([re, k]) => re.test(r) && SECTIONS[kind].some((x) => x.key === k))?.[1];
  }
  /** раздел ещё не начат — плитка серая (Никита 06.11); начат, но не дотянут — чёрная с подсказкой */
  const isFresh = (x: { key: string; done: boolean; optional?: boolean; sub: string }) =>
    (x.key === 'video' && !x.done) || !x.done && !x.optional && (/^пусто/.test(x.sub) || (x.key === 'voprosy' && /^0 из/.test(x.sub)) || (x.key === 'prays' && x.sub === 'нет тарифа с ценой' && !(data.tariffs ?? []).some((t: any) => t?.name || t?.price)));

  function renderOverview() {
    const st = cardState(rev.status, !isNew());
    const secs = SECTIONS[kind];
    const states: any[] = ourVenue() ? ourVenueTiles() : secs.map((x) => ({ ...x, ...sectionState(x.key, rev, questions) }));
    const must = states.filter((x) => !x.optional);
    // Никита, 02.11: пока обязательное не заполнено — кнопка серая, на замке;
    // нажатие — дрожит, пустые плитки краснеют, внизу подсказка, чего нет
    const missing = must.filter((x) => !x.done);
    const done = must.filter((x) => x.done).length;
    // «Удалить карточку» отсюда убрана (Никита, 05.11): стояла под «Отправить
    // на проверку» — рядом с главным действием её легко нажать случайно.
    // Теперь она в «Профиле», внизу (profil.astro, lib/cabinet-delete.ts).
    const title = data.name || role();
    const siteUrl = kind === 'venue' ? `/moskva/ploshchadki/${rev.slug}/` : `/moskva/podryadchiki/${rev.categorySlug}/${rev.slug}/`;
    // СОСТОЯНИЕ КАРТОЧКИ — заливкой всей шапки (Никита 09.11): на сайте — зелёная,
    // на проверке — синяя, вернули — красная. Отдельных плашек под шапкой больше нет
    const CLOCK = '<span class="c-clock" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.6"/><path class="c-clock__h" d="M12 12 9.2 10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path class="c-clock__m" d="M12 12V6.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></span>';
    const tone = rev.status === 'review'
      ? { cls: 'info', h: 'Карточка на проверке', t: 'Ответим в течение 24 часов. Пока она на проверке, менять её нельзя; можно отозвать', ic: CLOCK }
      : rev.status === 'rejected' && rev.rejectReason
      ? { cls: 'bad', h: 'Вернули на исправление', t: esc(rev.rejectReason), ic: TODO_IC }
      : rev.status === 'approved'
      ? { cls: 'ok', h: 'Карточка одобрена', t: 'Она уже на сайте', ic: '' }
      : rev.status === 'draft' && sameAsSite()
      ? { cls: 'ok', h: 'Карточка на сайте', t: 'Здесь то, что сейчас видят пары. Изменений пока нет', ic: '' }
      : null;
    view.innerHTML = `
      <div class="c-head${tone ? ` c-head--tone c-head--${tone.cls}` : ''}">
        <div class="c-head__top"><a class="c-back" href="/profi/moi/">${icon('back')} Мои карточки</a><span class="c-head__right">${rev.status !== 'approved' && !ourVenue() ? `<button class="c-chipbtn c-head__act" type="button" data-preview><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12Z"/><circle cx="12" cy="12" r="3" fill="none" stroke="currentColor" stroke-width="1.6"/></svg><span>Как на сайте</span></button>` : ''}</span></div>
        <h1 class="a-h1">${esc(title)}</h1>
        ${tone ? `<div class="c-head__state" role="note">${tone.ic}<div><span class="c-head__state-h">${tone.h}</span><span>${tone.t}</span></div></div>` : ''}
        ${/* полосы и «Заполнено N из 6» нет (Никита 06.11): что не начато — видно по самим плиткам (серые), что готово — галочка */''}
      </div>
      <div class="c-sheet-area">
      ${/* возврат — плашкой во всю ширину, как плитки (Никита 05.11) */''}
      ${managed() && rev.status !== 'review' && !mnoteHidden() ? `<div class="c-note-wide c-note-wide--info c-note-wide--x" role="note" data-mnote><p>${ourVenue() ? MANAGED_VENUE_NOTE : MANAGED_NOTE}</p><button class="c-note-x" type="button" aria-label="Скрыть" data-mnote-x>${X_ICON}</button></div>` : ''}
      <div class="c-tiles">
        ${states.map((x) => `
          <a class="c-row c-tile${isFresh(x) ? ' c-tile--fresh' : ''}" href="${url(x.key)}" data-tile="${x.key}">
            ${tileVisual(x.key, x.icon)}
            ${x.done && x.key !== rejectKey() ? `<span class="c-tile__done" aria-label="заполнено">${tick}</span>` : ''}
            <span class="c-tile__title">${x.title}</span>
            ${x.key === rejectKey()
              ? `<span class="c-tile__todo c-tile__todo--remark">${TODO_IC}<span>есть замечание модератора</span></span>`
              : !x.done && !x.optional
              ? `<span class="c-tile__todo"><span>${esc(sectionTodo(x.key, rev, questions))}</span></span>`
              : `<span class="c-tile__sub c-row__sub">${esc(x.sub)}</span>`}
          </a>`).join('')}
      </div>
      ${managed() && rev.status !== 'review' ? writeBtn() : ''}
      ${/* Панель прибита к низу: «Отправить на проверку» и под ней превью.
           Полосы «Осталось» нет (Никита 05.11): что сделать — в самих плитках,
           отдельным начертанием подсказки (c-tile__todo), не как данные. */''}
      <div class="c-bar">

        ${rev.status === 'review'
          ? '<button class="a-btn a-btn--lg" type="button" data-withdraw>Отозвать с проверки</button>'
          : rev.status === 'approved'
            ? `<a class="a-btn a-btn--lg" href="${siteUrl}" target="_blank" rel="noopener" data-site-link hidden>Открыть на сайте</a><p class="c-reason c-reason--info" data-site-wait>Карточка одобрена и выходит на сайт — обычно это несколько минут.</p>`
            : sameAsSite()
            // правок нет — отправлять нечего: кнопки нет, есть ссылка на саму карточку (08.11)
            ? `<a class="a-btn a-btn--lg" href="${siteUrl}" target="_blank" rel="noopener">Открыть на сайте</a>
               <p class="c-bar__hint">Чтобы что-то поменять, откройте раздел и поправьте. Тогда появится кнопка «Отправить изменения на проверку»</p>`
            // «Отправить на проверку» — а что отправит, непонятно (Никита 07.11):
            // у опубликованной — «изменения», и строкой ниже, что будет дальше
            : `<button class="a-btn a-btn--primary a-btn--lg${missing.length ? ' c-btn-locked' : ''}" type="button" data-submit ${missing.length ? 'aria-disabled="true"' : ''}>${missing.length ? icon('lock') : ''}${isNew() ? 'Отправить на проверку' : 'Отправить изменения на проверку'}</button>
               <p class="c-bar__hint">${missing.length ? 'Сначала заполните то, что отмечено на плитках' : isNew() ? 'Модератор проверит карточку и опубликует её на сайте — обычно за день' : 'Всё, что вы поправили, вместе с просьбами нам. Модератор проверит и опубликует — обычно за день'}</p>`}

        <span class="c-error" data-error hidden></span>
      </div>
      </div>`;
    savedLabel();
    // «Открыть на сайте» — только когда страница уже есть: сайт пересобирается
    // после одобрения несколько минут, а кнопка вела на пустую страницу (03.11)
    const siteLink = view.querySelector<HTMLAnchorElement>('[data-site-link]');
    if (siteLink) {
      fetch(siteUrl, { method: 'HEAD', cache: 'no-store' }).then((r) => {
        if (!r.ok) return;
        siteLink.hidden = false;
        view.querySelector('[data-site-wait]')?.remove();
      }).catch(() => {});
    }
    const err = view.querySelector<HTMLElement>('[data-error]')!;
    view.querySelector('[data-mnote-x]')?.addEventListener('click', () => {
      try { localStorage.setItem(mnoteKey(), '1'); } catch {}
      view.querySelector('[data-mnote]')?.remove();
    });
    // превью до одобрения (/profi/prevyu/): сначала сохраняем набранное,
    // потом ссылку у базы; в той же вкладке — айфон не открывает окно,
    // открытое после ответа сервера (как с MAX, 31.10)
    view.querySelector<HTMLButtonElement>('[data-preview]')?.addEventListener('click', async (e) => {
      const b = e.currentTarget as HTMLButtonElement;
      b.disabled = true;
      err.hidden = true;
      try {
        if (rev.status !== 'review') await save();
        const res = await api('vendor', 'POST', '/api/wed/preview-link', { revision: rev.id });
        location.href = res.url;
      } catch (x) {
        // ошибка — тостом, не строкой между кнопками (Никита 05.11)
        // ошибка действия — окном по центру, как предупреждение у Apple (HIG: Alerts);
        // полоска поверх прибитой кнопки её закрывала (Никита 05.11)
        alertBox('Превью не открылось', errText(x), { label: 'Повторить', fn: () => b.click() });
        b.disabled = false;
      }
    });
    view.querySelector<HTMLButtonElement>('[data-submit]')?.addEventListener('click', async (e) => {
      const b = e.currentTarget as HTMLButtonElement;
      if (missing.length) {
        markTried();
        b.classList.remove('c-shake');
        void b.offsetWidth; // перезапуск анимации на повторное нажатие
        b.classList.add('c-shake');
        navigator.vibrate?.([30, 40, 30]);
        // причина уже написана под кнопкой — подсвечиваем её и показываем
        view.querySelectorAll<HTMLElement>('.c-tile__todo').forEach((t) => {
          t.classList.remove('c-todo--spring');
          void t.offsetWidth;
          t.classList.add('c-todo--spring');
        });
        view.querySelector('.c-tile__todo')?.closest('.c-tile')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }
      b.disabled = true;
      err.hidden = true;
      try {
        await save();
        rev = await api('vendor', 'PATCH', `/api/collections/revisions/records/${rev.id}`, { status: 'review' });
        renderOverview();
        // результат — баннером сверху (HIG: Feedback), не строкой под кнопкой (Никита 06.11)
        toast('Отправили на проверку, ответим за 24\u00a0часа', false, 3500);
      } catch (x) {
        // хук перечисляет, чего не хватает, через «; » — по строке на пункт
        markTried();
        err.textContent = errText(x).replace(/^Не получилось отправить на проверку: /, 'Чтобы отправить, осталось:\n— ').replace(/; /g, '\n— ');
        err.hidden = false;
        b.disabled = false;
      }
    });
    view.querySelector<HTMLButtonElement>('[data-withdraw]')?.addEventListener('click', async () => {
      try {
        rev = await api('vendor', 'PATCH', `/api/collections/revisions/records/${rev.id}`, { status: 'draft' });
        renderOverview();
      } catch (x) { toast(`Не отозвали. ${errText(x)}`, true, undefined, { label: 'Повторить', fn: () => view.querySelector<HTMLButtonElement>('[data-withdraw]')?.click() }); }
    });
  }

  // ---------- «как это выглядит на сайте» ----------
  // Мини-копии того, что пара увидит: карточка каталога, разделы текста
  // визитки (StoryText), пакеты прайса. Шрифты и токены — сайта (cabinet.css, .c-pv).
  const lines = (t: unknown) => String(t ?? '').split('\n').map((x) => x.trim());
  /** текст раздела как на визитке: пустая строка — абзац, «— » — пункт списка */
  function storyHtml(body: unknown): string {
    return String(body ?? '').split(/\n\s*\n/).map((block) => {
      // крупная фраза («> » в начале абзаца) — как lead раздела на визитке
      if (/^\s*>/.test(block)) return `<p class="c-pv-lead">${esc(block.replace(/^\s*>\s*/, '').replace(/\s+/g, ' ').trim())}</p>`;
      const ls = lines(block).filter(Boolean);
      const items = ls.filter((l) => /^[—–-]\s*/.test(l));
      const text = ls.filter((l) => !/^[—–-]\s*/.test(l));
      return (text.length ? `<p>${esc(text.join(' '))}</p>` : '') +
        (items.length ? `<ul>${items.map((l) => `<li>${esc(l.replace(/^[—–-]\s*/, ''))}</li>`).join('')}</ul>` : '');
    }).join('');
  }
  /** способ цены; у старых черновиков без него — по тому, что заполнено */
  function priceMode(): 'one' | 'tariffs' | 'request' {
    if (data.priceMode) return data.priceMode;
    return data.tariffs?.length ? 'tariffs' : 'one';
  }

  /** цена так, как её пишет визитка: «от N ₽» и под ней «за что» */
  function priceLine(): { label: string; note: string } {
    const p = priceFrom(data);
    const mode = priceMode();
    if (mode === 'request' || !p) return { label: 'Цена по запросу', note: mode === 'request' ? String(data.priceNote ?? '') : '' };
    const note = mode === 'tariffs' ? '' : String(data.priceNote ?? '');
    return { label: `от ${rub(p)}`, note };
  }
  // Превью — кусок самой визитки, без подписей «так будет»: имя и цена
  // первого экрана, разделы текста, тарифы. Открывается одинаково для всех
  // разделов — значком «?» у заголовка раздела.
  function previewHtml(key: SectionKey): string {
    const price = priceLine();
    const head = `<div class="c-pv-head">
        <h2>${esc(data.name || 'Имя Фамилия')}</h2>
        ${kickerLine() ? `<p class="c-pv-head__tag">${esc(kickerLine())}</p>` : ''}
        <p class="c-pv-head__price">${price.label}</p>
        ${price.note ? `<p class="c-pv-head__note">${esc(price.note)}</p>` : ''}
      </div>`;
    if (key === 'tekst') {
      const secs = (data.sections ?? []).filter((x: any) => String(x?.title ?? '').trim() || String(x?.body ?? '').trim());
      return `<div class="c-pv c-pv-story">${secs.map((x: any) => `<section>${x.title ? `<h3>${esc(x.title)}</h3>` : ''}${storyHtml(x.body)}</section>`).join('') || '<p>Текста пока нет.</p>'}</div>`;
    }
    if (key === 'prays') {
      const ts = priceMode() === 'tariffs' ? (data.tariffs ?? []).filter((t: any) => String(t?.name ?? '').trim() && Number(t?.price) > 0) : [];
      const cards = ts.map((t: any) => {
        const inc = lines(t.includes).filter(Boolean).map((l) => l.replace(/^[—–-]\s*/, ''));
        return `<article class="c-pv-tariff">
          <header><h4>${esc(t.name)}</h4><b>${rub(Number(String(t.price).replace(/\s/g, '')))}${t.unit ? `<small>${esc(t.unit)}</small>` : ''}</b></header>
          ${inc.length ? `<ul>${inc.map((x) => `<li>${esc(x)}</li>`).join('')}</ul>` : ''}
        </article>`;
      }).join('');
      return `<div class="c-pv">${head}${cards ? `<section class="c-pv-story"><h3>Тарифы</h3><div class="c-pv-tariffs">${cards}</div></section>` : ''}</div>`;
    }
    // основное: карточка в каталоге — обложка, имя, строка под именем, цена
    const cover = rev.photos?.[0] ? `<img src="${fileUrl(rev, rev.photos[0], { thumb: '400x0', token })}" alt="" />` : '';
    return `<div class="c-pv c-pv-card">
        <div class="c-pv-card__img">${cover}</div>
        <p class="c-pv-card__name">${esc(data.name || 'Имя Фамилия')}</p>
        ${kickerLine() ? `<p class="c-pv-card__tag">${esc(kickerLine())}</p>` : ''}
        <p class="c-pv-card__price">${price.label}${price.note ? ` · ${esc(price.note)}` : ''}</p>
      </div>`;
  }
  /** разделы, у которых есть «как это выглядит на сайте» — значок «?» у заголовка */
  const PREVIEWABLE: SectionKey[] = ['osnovnoe', 'tekst', 'prays'];
  function openPreview(key: SectionKey) {
    // превью — единственное окно в оформлении сайта: показывает, как будет на витрине
    openDialog({ site: true, cls: 'c-sheet--pv', html: `<div class="c-sheet__body"><button class="c-sheet__x" type="button" data-close aria-label="Закрыть">${X_ICON}</button>${previewHtml(key)}</div>` });
  }

  // ---------- портрет ----------
  /**
   * Кадрирование портрета: круглая рамка, фото двигают пальцем или мышью,
   * масштаб — ползунком. На выходе квадрат 800×800 (Avatar сайта — кружок).
   * Без библиотек: <img> с transform и canvas при сохранении.
   */
  function cropAvatar(file: File): Promise<File | null> {
    const SIDE = 800;
    return new Promise((done) => {
      const src = URL.createObjectURL(file);
      let result: File | null = null;
      const { dlg, close } = openDialog({
        closeOnBackdrop: false, // жест кадрирования может закончиться на подложке
        html: `<div class="c-dialog__body">
          <p class="c-pv__cap">Двигайте фото, приближайте двумя пальцами</p>
          <div class="c-crop"><img src="${src}" alt="" draggable="false" /><span class="c-crop__ring"></span></div>
          <div class="c-actions"><button class="a-btn a-btn--primary a-btn--lg" type="button" data-ok>Сохранить портрет</button><button class="a-btn a-btn--lg c-add-btn" type="button" data-close>Закрыть</button></div>
        </div>`,
        onClose: () => { URL.revokeObjectURL(src); done(result); },
      });
      const box = dlg.querySelector<HTMLElement>('.c-crop')!;
      const img = box.querySelector('img')!;
      let x = 0, y = 0, k = 1, base = 1;
      const view = () => box.clientWidth;
      // не даём увести фото так, чтобы в круге осталась пустота
      const clamp = () => {
        const w = img.naturalWidth * base * k, h = img.naturalHeight * base * k, v = view();
        x = Math.min(0, Math.max(v - w, x));
        y = Math.min(0, Math.max(v - h, y));
      };
      const draw = () => { clamp(); img.style.transform = `translate(${x}px, ${y}px) scale(${base * k})`; };
      img.onload = () => {
        base = view() / Math.min(img.naturalWidth, img.naturalHeight);
        x = (view() - img.naturalWidth * base) / 2;
        y = (view() - img.naturalHeight * base) / 2;
        draw();
      };
      // масштаб вокруг точки (между пальцами / под курсором), от 1 до 4
      const zoomAt = (next: number, cx: number, cy: number) => {
        next = Math.min(4, Math.max(1, next));
        x = cx - ((cx - x) * next) / k;
        y = cy - ((cy - y) * next) / k;
        k = next;
        draw();
      };
      // один палец — двигаем, два — приближаем (как в Telegram и на айфоне)
      const pts = new Map<number, { x: number; y: number }>();
      let last: { x: number; y: number; dist: number } | null = null;
      const local = (p: { x: number; y: number }) => { const r = box.getBoundingClientRect(); return { x: p.x - r.left, y: p.y - r.top }; };
      const gesture = () => {
        const [a, b] = [...pts.values()];
        if (!b) return { x: a.x, y: a.y, dist: 0 };
        return { x: (a.x + b.x) / 2, y: (a.y + b.y) / 2, dist: Math.hypot(a.x - b.x, a.y - b.y) };
      };
      box.addEventListener('pointerdown', (e) => { box.setPointerCapture(e.pointerId); pts.set(e.pointerId, { x: e.clientX, y: e.clientY }); last = gesture(); });
      box.addEventListener('pointermove', (e) => {
        if (!pts.has(e.pointerId) || !last) return;
        pts.set(e.pointerId, { x: e.clientX, y: e.clientY });
        const g = gesture();
        x += g.x - last.x;
        y += g.y - last.y;
        if (g.dist && last.dist) { const c = local(g); zoomAt((k * g.dist) / last.dist, c.x, c.y); } else draw();
        last = g;
      });
      const up = (e: PointerEvent) => { pts.delete(e.pointerId); last = pts.size ? gesture() : null; };
      box.addEventListener('pointerup', up);
      box.addEventListener('pointercancel', up);
      box.addEventListener('wheel', (e) => { e.preventDefault(); const c = local({ x: e.clientX, y: e.clientY }); zoomAt(k * Math.exp(-e.deltaY / 400), c.x, c.y); }, { passive: false });
      const finish = (out: File | null) => { result = out; close(); };
      dlg.querySelector('[data-ok]')!.addEventListener('click', () => {
        const scale = base * k, v = view();
        const canvas = document.createElement('canvas');
        canvas.width = canvas.height = SIDE;
        canvas.getContext('2d')!.drawImage(img, -x / scale, -y / scale, v / scale, v / scale, 0, 0, SIDE, SIDE);
        canvas.toBlob((b) => finish(b ? new File([b], 'avatar.jpg', { type: 'image/jpeg' }) : null), 'image/jpeg', 0.9);
      });
    });
  }

  async function uploadAvatar(picked: File) {
    const file = await cropAvatar(picked);
    if (!file) return;
    const fd = new FormData();
    fd.append('avatar', file);
    try {
      rev = await api('vendor', 'PATCH', `/api/collections/revisions/records/${rev.id}`, fd);
      if (!token) token = await fileToken('vendor');
      savedAt = time();
      renderSection('osnovnoe');
    } catch (x) {
      saveError = errText(x);
      savedLabel();
    }
  }

  /** Telegram: принимаем @ник, ник и ссылку t.me/… — храним «@ник» */
  function normalizeTelegram(v: string): { value: string; ok: boolean } {
    const nick = v.trim().replace(/^https?:\/\//, '').replace(/^(t\.me|telegram\.me)\//i, '').replace(/^@/, '').replace(/\/.*$/, '');
    if (!nick) return { value: '', ok: true };
    return { value: '@' + nick, ok: /^[A-Za-z0-9_]{5,32}$/.test(nick) };
  }

  // ---------- экраны разделов ----------
  /** счётчик знаков «Описания»: сколько есть и сколько нужно */
  function countText(): string {
    const n = textLength(data);
    const w = `${num(n)} ${plural(n, 'знак', 'знака', 'знаков')}`;
    if (n < MIN_TEXT) return `${w}, нужно от ${num(MIN_TEXT)}`;
    // длинный текст без единого заголовка — «простыня» (Никита 08.11): подсказываем
    // разбить на разделы; совет, не запрет — отправке не мешает
    const titled = (data.sections ?? []).some((x: any) => String(x?.title ?? '').trim());
    return n > 600 && !titled ? `${w}. Разбейте текст на разделы с заголовками, так его дочитают: поставьте курсор в строку и выберите «Заголовок» в «Aa»` : w;
  }

