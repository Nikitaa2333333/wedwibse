          </button>
          <div class="cc-list" role="menu" hidden>${PHONE_COUNTRIES.map((x) => `
            <button type="button" class="cc-option" role="menuitemradio" aria-checked="${x.code === c.code}" data-code="${x.code}">
              <img class="cc-opt-flag" src="${flagSrc(x)}" alt="" width="20" height="14" />
