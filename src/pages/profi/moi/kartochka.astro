---
// АНКЕТА КАРТОЧКИ — полный ход заполнения на живой базе (27.10.2026).
//   ?id=<ревизия>          — список разделов с состоянием и «Отправить на проверку»
//   ?id=<ревизия>&s=<раздел> — раздел своим экраном (CABINET-UX.md §2 п.4)
//   ?card=<id>&kind=…      — правка опубликованной: /api/wed/edit даёт черновик-копию
// Разделы и их заполненность — lib/cabinet-form.ts; что можно отправить,
// решает хук базы (submitProblems). Всё сохраняется само, через секунду
// после правки; фото — сразу. Вид — система админки (CabinetShell).
// Данные рисует браузер: экран за входом, в поиск не идёт (noindex).
import CabinetShell from '../../../components/admin/CabinetShell.astro';
import { SPECIALIST_CATEGORIES, FILTERS_BY_CATEGORY } from '../../../data/specialists';
import { STRUCTURES, DEFAULT_STRUCTURE, VENUE_STRUCTURE } from '../../../data/profi-structures';

const roles = Object.fromEntries(SPECIALIST_CATEGORIES.map((c) => [c.slug, c.role]));
// вопросы подрядчика — фильтры его категории (specialist-filters.ts):
// по этим ответам пары находят карточку в каталоге
const questions = Object.fromEntries(
  Object.entries(FILTERS_BY_CATEGORY).map(([k, groups]) => [
    k,
    groups.map((g) => ({ key: g.key, label: g.label, type: g.type, options: g.options.map((o) => ({ value: o.value, label: o.label })) })),
  ]),
);
const structures = { ...STRUCTURES, _default: DEFAULT_STRUCTURE, _venue: VENUE_STRUCTURE };
---

<CabinetShell title="Анкета" section="cards">
  <div class="cab-col" data-anketa>
    <p class="a-lead" data-view>Загружаем…</p>
  </div>
  <script type="application/json" id="anketa-config" set:html={JSON.stringify({ roles, questions, structures })} />
</CabinetShell>

<script>
  import { api, esc, fileToken, fileUrl, requireSession } from '../../../lib/cabinet-api';
  import { ADMIN_ICONS } from '../../../lib/admin-icons';
  import { PHONE_COUNTRIES, DEFAULT_PHONE_COUNTRY, findCountry, flagSrc, nationalDigits, isComplete, fullE164, attachPhoneField } from '../../../lib/phone';
  import {
    SECTIONS, VENUE_QUESTIONS, VENUE_TERMS, MAX_PHOTOS, MIN_PHOTOS, MIN_TEXT,
    sectionState, cardState, priceFrom, rub, textLength, shrinkPhoto,
    type Kind, type SectionKey, type Question,
  } from '../../../lib/cabinet-form';

  const cfg = JSON.parse(document.getElementById('anketa-config')!.textContent!);
  const view = document.querySelector<HTMLElement>('[data-view]')!.parentElement!;
  const icon = (n: string, cls = '') => `<svg class="${cls}" viewBox="0 0 24 24" aria-hidden="true">${(ADMIN_ICONS as Record<string, string>)[n] ?? ''}</svg>`;
  const go = '<svg class="c-row__go" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M9 5l6 7-6 7"/></svg>';
  const tick = '<svg class="c-row__state" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M5 12.5l4.5 4.5L19 7.5"/></svg>';
  const q = new URLSearchParams(location.search);
  const s = requireSession('vendor');

  let rev: any = null;
  let data: any = {};
  let kind: Kind = 'specialist';
  let questions: Question[] = [];
  let token = '';
  let timer = 0;
  let saving: Promise<void> | null = null;
  let savedAt = '';
  let saveError = '';

  const locked = () => rev?.status === 'review' || rev?.status === 'approved';
  const isNew = () => !rev.venue && !rev.specialist;
  const role = () => (kind === 'venue' ? 'Площадка' : cfg.roles[rev.categorySlug] ?? rev.categorySlug);
  const section = () => q.get('s') as SectionKey | null;
  const url = (sec?: string) => `/profi/moi/kartochka/?id=${rev.id}${sec ? `&s=${sec}` : ''}`;
  const time = () => new Date().toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit' });

  // ---------- сохранение ----------
  /** плашка в углу: статус карточки и время сохранения — одним местом */
  function savedLabel() {
    const el = view.querySelector<HTMLElement>('[data-saved]');
    if (!el) return;
    const st = cardState(rev.status, !isNew());
    el.className = `c-state ${st.cls}`;
    el.classList.toggle('c-state--bad', !!saveError);
    const when = saveError ? `не сохранилось: ${saveError}` : saving ? 'сохраняем…' : savedAt ? `сохранено ${savedAt}` : '';
    el.textContent = [st.label, when].filter(Boolean).join(' · ');
  }

  /** производные поля — то, что человек не вводит руками */
  function derive() {
    if (kind === 'venue') {
      const halls = (data.halls ?? []).filter((h: any) => h?.name);
      const max = (k: string) => Math.max(0, ...halls.map((h: any) => Number(h?.[k]) || 0)) || '';
      data.capacityBanquet = max('banquet');
      data.capacityBuffet = max('buffet');
    } else {
      // цена по способу. Тарифы, ушедшие при смене способа, лежат в
      // tariffsDraft — вернулся к тарифам, они на месте. В базу и на сайт
      // идут только priceFrom / priceNote / tariffs (хук, pb-pull-cabinet).
      const mode = priceMode();
      if (mode !== 'tariffs' && data.tariffs?.length) { data.tariffsDraft = data.tariffs; data.tariffs = []; }
      if (mode === 'tariffs' && !data.tariffs?.length && data.tariffsDraft?.length) { data.tariffs = data.tariffsDraft; delete data.tariffsDraft; }
      if (mode === 'tariffs') {
        const ts = (data.tariffs ?? []).filter((t: any) => Number(String(t?.price ?? '').replace(/\s/g, '')) > 0);
        const cheapest = ts.sort((a: any, b: any) => Number(a.price) - Number(b.price))[0];
        data.priceFrom = cheapest ? Number(String(cheapest.price).replace(/\s/g, '')) : '';
        // «за что» у цены «от» — единица самого дешёвого тарифа, иначе
        // визитка подставит общее «за 6 часов работы»
        data.priceNote = cheapest?.unit ?? '';
      }
      if (mode === 'request') data.priceFrom = '';
      if (data.contacts?.maxSame) data.contacts.max = data.contacts.phone ?? '';
      // имя в каталоге — «Имя Фамилия»; у студии фамилии нет
      data.name = [data.firstName, data.lastName].map((x) => String(x ?? '').trim()).filter(Boolean).join(' ');
    }
  }

  async function save() {
    clearTimeout(timer);
    if (saving) await saving;
    if (locked()) return;
    derive();
    saving = (async () => {
      savedLabel();
      try {
        const body: any = { data };
        // адрес страницы новой карточки — по названию, один раз
        if (isNew() && !rev.slug && String(data.name ?? '').trim().length >= 2) {
          const sl = await api('vendor', 'GET', `/api/wed/slug?kind=${kind}&category=${rev.categorySlug}&name=${encodeURIComponent(data.name)}`);
          if (sl.suggestion) body.slug = sl.suggestion;
        }
        rev = await api('vendor', 'PATCH', `/api/collections/revisions/records/${rev.id}`, body);
        savedAt = time();
        saveError = '';
      } catch (err) {
        saveError = (err as Error).message;
      }
    })();
    await saving;
    saving = null;
    savedLabel();
  }
  const later = () => { clearTimeout(timer); saveError = ''; timer = window.setTimeout(save, 900); const el = view.querySelector('[data-saved]'); if (el) el.textContent = `${cardState(rev.status, !isNew()).label} · изменено`; };

  // ---------- обзор: список разделов ----------
  function renderOverview() {
    const st = cardState(rev.status, !isNew());
    const secs = SECTIONS[kind];
    const states = secs.map((x) => ({ ...x, ...sectionState(x.key, rev, questions) }));
    const done = states.filter((x) => x.done).length;
    const canDelete = isNew() && rev.status === 'draft';
    const title = data.name || (kind === 'venue' ? 'Новая площадка' : 'Новая карточка');
    const siteUrl = kind === 'venue' ? `/moskva/ploshchadki/${rev.slug}/` : `/moskva/podryadchiki/${rev.categorySlug}/${rev.slug}/`;
    view.innerHTML = `
      <div class="c-head">
        <div class="c-head__top"><a class="c-back" href="/profi/moi/">${icon('back')} Мои карточки</a><span data-saved></span></div>
        <h1 class="a-h1">${esc(title)}</h1>
        ${rev.slug ? `<p class="c-url" title="wed-secrets.ru${esc(siteUrl)}">Ваша ссылка: wed-secrets.ru/…/${esc(rev.slug)}/</p>` : ''}
      </div>
      ${rev.status === 'rejected' && rev.rejectReason ? `<p class="c-reason"><b>Вернули с причиной:</b> ${esc(rev.rejectReason)}<br>Исправьте и отправьте снова.</p>` : ''}
      ${rev.status === 'review' ? '<p class="c-reason c-reason--info">Карточка на проверке — ответим в течение суток. Пока она на проверке, менять её нельзя; можно отозвать.</p>' : ''}
      <div class="c-progress" role="progressbar" aria-label="Заполнено разделов" aria-valuemin="0" aria-valuemax="${secs.length}" aria-valuenow="${done}">
        <div class="c-progress__bar"><i style="width:${Math.round((done / secs.length) * 100)}%"></i></div>
      </div>
      <section class="a-card a-card--flush"><div class="c-rows">
        ${states.map((x) => `
          <a class="c-row" href="${url(x.key)}">
            <span class="c-row__ic">${icon(x.icon)}</span>
            <span class="c-row__body"><span class="c-row__title">${x.title}</span><span class="c-row__sub${x.empty ? ' c-row__sub--bad' : ''}">${esc(x.sub)}</span></span>
            ${x.done ? tick : '<span></span>'}
            ${go}
          </a>`).join('')}
      </div></section>
      <div class="c-bar">
        ${rev.status === 'review'
          ? '<button class="a-btn a-btn--lg" type="button" data-withdraw>Отозвать с проверки</button>'
          : rev.status === 'approved'
            ? `<a class="a-btn a-btn--lg" href="${siteUrl}" target="_blank" rel="noopener">Открыть на сайте</a>`
            : '<button class="a-btn a-btn--primary a-btn--lg" type="button" data-submit>Отправить на проверку</button>'}
        <span class="c-error" data-error hidden></span>
        <span class="c-ok" data-ok hidden></span>
      </div>
      ${canDelete ? '<button class="c-link c-link--danger" type="button" data-delete>Удалить карточку</button>' : ''}`;
    savedLabel();
    const err = view.querySelector<HTMLElement>('[data-error]')!;
    const ok = view.querySelector<HTMLElement>('[data-ok]')!;
    view.querySelector<HTMLButtonElement>('[data-submit]')?.addEventListener('click', async (e) => {
      const b = e.currentTarget as HTMLButtonElement;
      b.disabled = true;
      err.hidden = true;
      try {
        await save();
        rev = await api('vendor', 'PATCH', `/api/collections/revisions/records/${rev.id}`, { status: 'review' });
        renderOverview();
        view.querySelector<HTMLElement>('[data-ok]')!.textContent = 'Отправили на проверку. Ответим в течение суток.';
        view.querySelector<HTMLElement>('[data-ok]')!.hidden = false;
      } catch (x) {
        // хук перечисляет, чего не хватает, через «; » — по строке на пункт
        err.textContent = (x as Error).message.replace(/^Не получилось отправить на проверку: /, 'Чтобы отправить, осталось:\n— ').replace(/; /g, '\n— ');
        err.hidden = false;
        b.disabled = false;
      }
    });
    view.querySelector<HTMLButtonElement>('[data-withdraw]')?.addEventListener('click', async () => {
      try {
        rev = await api('vendor', 'PATCH', `/api/collections/revisions/records/${rev.id}`, { status: 'draft' });
        renderOverview();
      } catch (x) { err.textContent = (x as Error).message; err.hidden = false; }
    });
    // удаление — без системного «Вы уверены?»: первое нажатие спрашивает, второе удаляет
    view.querySelector<HTMLButtonElement>('[data-delete]')?.addEventListener('click', async (e) => {
      const b = e.currentTarget as HTMLButtonElement;
      if (!b.dataset.sure) { b.dataset.sure = '1'; b.textContent = 'Удалить насовсем? Нажмите ещё раз'; return; }
      try {
        await api('vendor', 'DELETE', `/api/collections/revisions/records/${rev.id}`);
        location.href = '/profi/moi/';
      } catch (x) { err.textContent = (x as Error).message; err.hidden = false; }
    });
    void ok;
  }

  // ---------- «как это выглядит на сайте» ----------
  // Мини-копии того, что пара увидит: карточка каталога, разделы текста
  // визитки (StoryText), пакеты прайса. Шрифты и токены — сайта (cabinet.css, .c-pv).
  const lines = (t: unknown) => String(t ?? '').split('\n').map((x) => x.trim());
  /** текст раздела как на визитке: пустая строка — абзац, «— » — пункт списка */
  function storyHtml(body: unknown): string {
    return String(body ?? '').split(/\n\s*\n/).map((block) => {
      const ls = lines(block).filter(Boolean);
      const items = ls.filter((l) => /^[—–-]\s*/.test(l));
      const text = ls.filter((l) => !/^[—–-]\s*/.test(l));
      return (text.length ? `<p>${esc(text.join(' '))}</p>` : '') +
        (items.length ? `<ul>${items.map((l) => `<li>${esc(l.replace(/^[—–-]\s*/, ''))}</li>`).join('')}</ul>` : '');
    }).join('');
  }
  /** способ цены; у старых черновиков без него — по тому, что заполнено */
  const PRICE_UNITS = ['за час', 'за 6 часов', 'за день', 'за кг', 'за гостя', 'за проект'];
  function priceMode(): 'one' | 'tariffs' | 'request' {
    if (data.priceMode) return data.priceMode;
    return data.tariffs?.length ? 'tariffs' : 'one';
  }

  /** цена так, как её пишет визитка: «от N ₽» и под ней «за что» */
  function priceLine(): { label: string; note: string } {
    const p = priceFrom(data);
    const mode = priceMode();
    if (mode === 'request' || !p) return { label: 'Цена по запросу', note: mode === 'request' ? String(data.priceNote ?? '') : '' };
    const note = mode === 'tariffs' ? '' : String(data.priceNote ?? '');
    return { label: `от ${rub(p)}`, note };
  }
  // Превью — кусок самой визитки, без подписей «так будет»: имя и цена
  // первого экрана, разделы текста, тарифы. Открывается одинаково для всех
  // разделов — значком «?» у заголовка раздела.
  function previewHtml(key: SectionKey): string {
    const price = priceLine();
    const head = `<div class="c-pv-head">
        <h2>${esc(data.name || 'Имя Фамилия')}</h2>
        ${data.tagline ? `<p class="c-pv-head__tag">${esc(data.tagline)}</p>` : ''}
        <p class="c-pv-head__price">${price.label}</p>
        ${price.note ? `<p class="c-pv-head__note">${esc(price.note)}</p>` : ''}
      </div>`;
    if (key === 'tekst') {
      const secs = (data.sections ?? []).filter((x: any) => String(x?.title ?? '').trim() || String(x?.body ?? '').trim());
      return `<div class="c-pv c-pv-story">${secs.map((x: any) => `<section>${x.title ? `<h3>${esc(x.title)}</h3>` : ''}${storyHtml(x.body)}</section>`).join('') || '<p>Текста пока нет.</p>'}</div>`;
    }
    if (key === 'prays') {
      const ts = priceMode() === 'tariffs' ? (data.tariffs ?? []).filter((t: any) => String(t?.name ?? '').trim() && Number(t?.price) > 0) : [];
      const cards = ts.map((t: any) => {
        const inc = lines(t.includes).filter(Boolean).map((l) => l.replace(/^[—–-]\s*/, ''));
        return `<article class="c-pv-tariff">
          <header><h4>${esc(t.name)}</h4><b>${rub(Number(String(t.price).replace(/\s/g, '')))}${t.unit ? `<small>${esc(t.unit)}</small>` : ''}</b></header>
          ${inc.length ? `<ul>${inc.map((x) => `<li>${esc(x)}</li>`).join('')}</ul>` : ''}
        </article>`;
      }).join('');
      return `<div class="c-pv">${head}${cards ? `<section class="c-pv-story"><h3>Тарифы</h3><div class="c-pv-tariffs">${cards}</div></section>` : ''}</div>`;
    }
    // основное: карточка в каталоге — обложка, имя, строка под именем, цена
    const cover = rev.photos?.[0] ? `<img src="${fileUrl(rev, rev.photos[0], { thumb: '400x0', token })}" alt="" />` : '';
    return `<div class="c-pv c-pv-card">
        <div class="c-pv-card__img">${cover}</div>
        <p class="c-pv-card__name">${esc(data.name || 'Имя Фамилия')}</p>
        ${data.tagline ? `<p class="c-pv-card__tag">${esc(data.tagline)}</p>` : ''}
        <p class="c-pv-card__price">${price.label}${price.note ? ` · ${esc(price.note)}` : ''}</p>
      </div>`;
  }
  /** разделы, у которых есть «как это выглядит на сайте» — значок «?» у заголовка */
  const PREVIEWABLE: SectionKey[] = ['osnovnoe', 'tekst', 'prays'];
  function openPreview(key: SectionKey) {
    let dlg = document.querySelector<HTMLDialogElement>('dialog.c-sheet--pv');
    if (!dlg) {
      dlg = document.createElement('dialog');
      dlg.className = 'c-sheet c-sheet--pv';
      dlg.addEventListener('click', (e) => { if (e.target === dlg || (e.target as HTMLElement).closest('[data-close]')) dlg!.close(); });
      document.body.append(dlg);
    }
    dlg.innerHTML = `<div class="c-sheet__body"><button class="c-sheet__x" type="button" data-close aria-label="Закрыть"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.6" d="M6 6l12 12M18 6L6 18"/></svg></button>${previewHtml(key)}</div>`;
    dlg.showModal();
  }

  // ---------- портрет ----------
  /**
   * Кадрирование портрета: круглая рамка, фото двигают пальцем или мышью,
   * масштаб — ползунком. На выходе квадрат 800×800 (Avatar сайта — кружок).
   * Без библиотек: <img> с transform и canvas при сохранении.
   */
  function cropAvatar(file: File): Promise<File | null> {
    const SIDE = 800;
    return new Promise((done) => {
      const src = URL.createObjectURL(file);
      const dlg = document.createElement('dialog');
      dlg.className = 'c-sheet';
      dlg.innerHTML = `<div class="c-sheet__body">
        <p class="c-pv__cap">Двигайте фото, приближайте двумя пальцами</p>
        <div class="c-crop"><img src="${src}" alt="" draggable="false" /><span class="c-crop__ring"></span></div>
        <div class="c-actions"><button class="a-btn a-btn--lg c-sheet__close" type="button" data-ok>Готово</button><button class="a-btn a-btn--lg c-add-btn" type="button" data-cancel>Отмена</button></div>
      </div>`;
      document.body.append(dlg);
      const box = dlg.querySelector<HTMLElement>('.c-crop')!;
      const img = box.querySelector('img')!;
      let x = 0, y = 0, k = 1, base = 1;
      const view = () => box.clientWidth;
      // не даём увести фото так, чтобы в круге осталась пустота
      const clamp = () => {
        const w = img.naturalWidth * base * k, h = img.naturalHeight * base * k, v = view();
        x = Math.min(0, Math.max(v - w, x));
        y = Math.min(0, Math.max(v - h, y));
      };
      const draw = () => { clamp(); img.style.transform = `translate(${x}px, ${y}px) scale(${base * k})`; };
      img.onload = () => {
        base = view() / Math.min(img.naturalWidth, img.naturalHeight);
        x = (view() - img.naturalWidth * base) / 2;
        y = (view() - img.naturalHeight * base) / 2;
        draw();
      };
      // масштаб вокруг точки (между пальцами / под курсором), от 1 до 4
      const zoomAt = (next: number, cx: number, cy: number) => {
        next = Math.min(4, Math.max(1, next));
        x = cx - ((cx - x) * next) / k;
        y = cy - ((cy - y) * next) / k;
        k = next;
        draw();
      };
      // один палец — двигаем, два — приближаем (как в Telegram и на айфоне)
      const pts = new Map<number, { x: number; y: number }>();
      let last: { x: number; y: number; dist: number } | null = null;
      const local = (p: { x: number; y: number }) => { const r = box.getBoundingClientRect(); return { x: p.x - r.left, y: p.y - r.top }; };
      const gesture = () => {
        const [a, b] = [...pts.values()];
        if (!b) return { x: a.x, y: a.y, dist: 0 };
        return { x: (a.x + b.x) / 2, y: (a.y + b.y) / 2, dist: Math.hypot(a.x - b.x, a.y - b.y) };
      };
      box.addEventListener('pointerdown', (e) => { box.setPointerCapture(e.pointerId); pts.set(e.pointerId, { x: e.clientX, y: e.clientY }); last = gesture(); });
      box.addEventListener('pointermove', (e) => {
        if (!pts.has(e.pointerId) || !last) return;
        pts.set(e.pointerId, { x: e.clientX, y: e.clientY });
        const g = gesture();
        x += g.x - last.x;
        y += g.y - last.y;
        if (g.dist && last.dist) { const c = local(g); zoomAt((k * g.dist) / last.dist, c.x, c.y); } else draw();
        last = g;
      });
      const up = (e: PointerEvent) => { pts.delete(e.pointerId); last = pts.size ? gesture() : null; };
      box.addEventListener('pointerup', up);
      box.addEventListener('pointercancel', up);
      box.addEventListener('wheel', (e) => { e.preventDefault(); const c = local({ x: e.clientX, y: e.clientY }); zoomAt(k * Math.exp(-e.deltaY / 400), c.x, c.y); }, { passive: false });
      const finish = (out: File | null) => { URL.revokeObjectURL(src); dlg.close(); dlg.remove(); done(out); };
      dlg.querySelector('[data-cancel]')!.addEventListener('click', () => finish(null));
      dlg.addEventListener('cancel', () => finish(null));
      dlg.querySelector('[data-ok]')!.addEventListener('click', () => {
        const scale = base * k, v = view();
        const canvas = document.createElement('canvas');
        canvas.width = canvas.height = SIDE;
        canvas.getContext('2d')!.drawImage(img, -x / scale, -y / scale, v / scale, v / scale, 0, 0, SIDE, SIDE);
        canvas.toBlob((b) => finish(b ? new File([b], 'avatar.jpg', { type: 'image/jpeg' }) : null), 'image/jpeg', 0.9);
      });
      dlg.showModal();
    });
  }

  async function uploadAvatar(picked: File) {
    const file = await cropAvatar(picked);
    if (!file) return;
    const fd = new FormData();
    fd.append('avatar', file);
    try {
      rev = await api('vendor', 'PATCH', `/api/collections/revisions/records/${rev.id}`, fd);
      if (!token) token = await fileToken('vendor');
      savedAt = time();
      renderSection('osnovnoe');
    } catch (x) {
      saveError = (x as Error).message;
      savedLabel();
    }
  }

  /** Telegram: принимаем @ник, ник и ссылку t.me/… — храним «@ник» */
  function normalizeTelegram(v: string): { value: string; ok: boolean } {
    const nick = v.trim().replace(/^https?:\/\//, '').replace(/^(t\.me|telegram\.me)\//i, '').replace(/^@/, '').replace(/\/.*$/, '');
    if (!nick) return { value: '', ok: true };
    return { value: '@' + nick, ok: /^[A-Za-z0-9_]{5,32}$/.test(nick) };
  }

