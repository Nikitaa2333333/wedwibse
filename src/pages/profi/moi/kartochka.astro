  /** поле по точной ширине набранного (или подсказки): меряем тем же шрифтом скрытым span */
  function fitWidth(el: HTMLInputElement) {
    const m = document.createElement('span');
    const cs = getComputedStyle(el);
    m.style.cssText = `position:absolute;visibility:hidden;white-space:pre;font:${cs.font};font-variant-numeric:tabular-nums;letter-spacing:${cs.letterSpacing}`;
    m.textContent = el.value || el.placeholder;
    document.body.append(m);
    el.style.width = `${Math.ceil(m.getBoundingClientRect().width) + 2}px`;
    m.remove();
  }

  function renderSection(key: SectionKey) {
    const b = sectionBody(key);
    // строка «‹ Назад … ✓ Сохранено» прибита к верху (Никита 07.11): статус виден
    // всегда, но не всплывает на каждое нажатие. Вне .c-head — иначе ей некуда липнуть
    view.innerHTML = `
      <div class="c-head__top c-head__top--sticky"><a class="c-back" href="${url()}">${icon('back')} ${esc(data.name || 'Анкета')}</a><span class="c-saved" data-savemark aria-live="polite"></span></div>
      <div class="c-head">
        ${/* «?» — только там, где есть подсказка (Никита 07.11): фото и тарифы; нажатие возвращает закрытую
             подсказку-баннер (как подсказки TipKit у Apple). Превью раздела — кнопкой «Как на сайте» на обзоре */''}
        <h1 class="a-h1 c-title">${b.title}${key === 'foto' || key === 'zaly' || (key === 'prays' && priceMode() === 'tariffs') ? ` <button class="c-help" type="button" data-hint-again="${key}" aria-label="Показать подсказку">?</button>` : ''}</h1>
        ${b.lead ? `<p class="a-lead">${b.lead}</p>` : ''}
      </div>
      <div class="c-sheet-area">
        ${/* во всю ширину, как плашки обзора (Никита 09.11: узкая плашка в полях заголовка) */ locked() ? `<div class="c-note-wide c-note-wide--info" role="note"><p><span class="c-note-wide__h">Карточка на проверке</span>Пока она на проверке, менять её нельзя</p></div>` : ''}
        <div class="c-form" data-form>${b.html}</div>
      </div>`;
    savedLabel();
    view.querySelectorAll<HTMLTextAreaElement>('textarea[data-grow]').forEach(grow);
    if (locked()) view.querySelectorAll<HTMLInputElement>('input, textarea, button.c-opt, button.c-add, button.c-tool, button.c-link').forEach((x) => (x.disabled = true));
    if (key === 'foto') renderPhotos();
    if (key === 'kontakty') bindPhone();
    if (key === 'tekst') bindNotes();
    if (key === 'osnovnoe' && kind === 'venue') bindGeo();
    view.querySelectorAll<HTMLInputElement>('.c-tcard__sum input').forEach(fitWidth);
  }

  /** точка площадки: адрес из подсказок → метка → подрядчик подтверждает или двигает (lib/geo-pick) */
  function bindGeo() {
    const root = view.querySelector<HTMLElement>('[data-geo]');
    const input = view.querySelector<HTMLInputElement>('[data-bind="address"]');
    if (root && input && cfg.mapsKey) {
      mountGeoPick({
        root,
        input,
        apiKey: cfg.mapsKey,
        value: data.contacts?.geo ?? null,
        readOnly: locked(),
        onChange: (g) => { setPath('contacts.geo', g); later(); },
      });
    } else root?.remove();
    // «Поделиться» в Картах копирует «Название, адрес https://…» — оставляем только ссылку
    // (проба 09.11: в поле лежал текст «Технопарк Обнинск Университетская ул., …»)
    const maps = view.querySelector<HTMLInputElement>('[data-bind="contacts.maps"]');
    maps?.addEventListener('change', () => {
      const url = maps.value.match(/https?:\/\/\S+/)?.[0];
      if (url && url !== maps.value.trim()) {
        maps.value = url;
        maps.dispatchEvent(new Event('input', { bubbles: true }));
      }
    });
  }

  /** поле «Описания» как Заметки: строки ↔ разделы базы */
  function bindNotes() {
    const ed = view.querySelector<HTMLElement>('[data-notes]');
    const bar = view.querySelector<HTMLElement>('[data-notes-bar]');
    if (!ed) return;
    const blocks = sectionsToBlocks(data.sections?.length ? data.sections : data.about ? [{ title: '', body: data.about }] : []);
    // на проверке — только чтение, без капсулы
    if (!bar) { ed.innerHTML = blocksHtml(blocks); ed.classList.toggle('is-empty', !blocks.length); return; }
    mountNotes({
      ed, bar, blocks,
      onChange: (bs) => {
        data.sections = blocksToSections(bs);
        const count = view.querySelector('[data-count]');
        if (count) count.textContent = countText();
        later();
      },
    });
  }

  // ---------- фото ----------
  function renderPhotos() {
    const box = view.querySelector<HTMLElement>('[data-photos]');
    if (!box) return;
    const names: string[] = rev.photos ?? [];
    // с 07.11 и у «ведём мы»: убрать, добавить до потолка, переставить (Никита)
    const lock = locked();
    // Евгений, 31.10: стрелки «левее/правее» — как на калькуляторе. Порядок —
    // перетаскиванием (bindPhotoDrag). Обложка — первый кадр, обычного размера
    // с плашкой «Обложка» (Никита, 02.11: крупная 2×2 — вернули обычную);
    // сменить её — перетащить другой кадр на первое место
    box.innerHTML = names.map((n, i) => `
      <div class="c-photo" data-pi="${i}">
        <img src="${fileUrl(rev, n, { thumb: '400x0', token })}" alt="" loading="lazy" draggable="false" />
        ${i === 0 ? '<span class="status c-photo__tag">Обложка</span>' : ''}
        ${lock ? '' : `<div class="c-photo__tools">
          <button type="button" data-premove="${i}" aria-label="Убрать">${X_ICON}</button>
        </div>`}
      </div>`).join('') + (lock || names.length >= MAX_PHOTOS ? '' : `
      <label class="c-photo c-photo--add">${icon('plus')}<span>Добавить фото</span>
        <input type="file" accept="image/jpeg,image/png,image/webp" multiple hidden data-pfiles />
      </label>`);
    if (!lock) bindPhotoDrag(box);
    dragHint(lock ? [] : names);
  }

  /**
   * Кадр во весь экран (Никита, 02.11): лента кадров со свайпом, в полный
   * размер файла. Закрыть — крестиком, Esc или жестом «назад» (своя запись
   * в истории: иначе «назад» уводит из анкеты).
   */
  function openViewer(start: number) {
    const names: string[] = rev.photos ?? [];
    if (!names.length) return;
    const dlg = document.createElement('dialog');
    dlg.className = 'c-viewer';
    dlg.innerHTML = `
      <div class="c-viewer__track">${names.map((n, i) => `<figure class="c-viewer__slide"><img src="${fileUrl(rev, n, { token })}" alt="" ${Math.abs(i - start) > 1 ? 'loading="lazy"' : ''} draggable="false" /></figure>`).join('')}</div>
      <p class="c-viewer__count" aria-live="polite"></p>
      <button class="c-viewer__close" type="button" aria-label="Закрыть">${X_ICON}</button>`;
    document.body.append(dlg);
    const track = dlg.querySelector<HTMLElement>('.c-viewer__track')!;
    const count = dlg.querySelector<HTMLElement>('.c-viewer__count')!;
    const at = () => Math.round(track.scrollLeft / Math.max(1, track.clientWidth));
    const label = () => { count.textContent = `${at() + 1} из ${names.length}${at() === 0 ? ' · обложка' : ''}`; };
    track.addEventListener('scroll', label, { passive: true });
    let closed = false;
    const close = () => { if (closed) return; closed = true; dlg.close(); dlg.remove(); removeEventListener('popstate', onPop); };
    const onPop = () => close();
    dlg.querySelector('.c-viewer__close')!.addEventListener('click', () => history.back());
    dlg.addEventListener('cancel', (e) => { e.preventDefault(); history.back(); });
    dlg.showModal();
    track.scrollLeft = start * track.clientWidth;
    label();
    history.pushState({ viewer: true }, '');
    addEventListener('popstate', onPop);
  }

  /**
   * Подсказка «зажмите и перетащите» (Никита, 02.11): плашка над кадрами
   * с мини-анимацией на своих же первых трёх фото — третий кадр уезжает на
   * место обложки. Работе не мешает (не всплывает поверх), уходит навсегда
   * после крестика или первого настоящего перетаскивания.
   */
  const HINT_KEY = 'wed-cab-hint-drag';
  function hintSeen() { try { return localStorage.getItem(HINT_KEY) === '1'; } catch { return false; } }
  function hideDragHint() {
    try { localStorage.setItem(HINT_KEY, '1'); } catch {}
    const el = view.querySelector<HTMLElement>('[data-drag-hint]');
    if (el) el.hidden = true;
  }
  /**
   * Подсказка к тарифам (Никита 05.11, как подсказка перетаскивания фото):
   * три мини-тарифа выезжают по очереди — «так пара увидит и сравнит».
   * Закрыли — больше не показываем (localStorage).
   */
  const TARIFF_HINT_KEY = 'wed-cab-hint-tariffs';
  function tariffHint(): string {
    try { if (localStorage.getItem(TARIFF_HINT_KEY)) return ''; } catch {}
    return `<div class="c-hint c-hint--tariffs" data-tariff-hint>
      <span class="c-thint" aria-hidden="true">
        <span class="c-thint__card c-thint__card--1"><i></i><b></b></span>
        <span class="c-thint__card c-thint__card--2"><i></i><b></b></span>
        <span class="c-thint__card c-thint__card--3"><i></i><b></b></span>
      </span>
      <span class="c-hint__text"><b>Тарифы на выбор</b><span>До ${MAX_TARIFFS}: название, цена и что входит. В каталоге покажем цену самого недорогого</span></span>
      <button class="c-hint__close" type="button" aria-label="Понятно" data-tariff-hint-close>${X_ICON}</button>
    </div>`;
  }
  /** Подсказка к залам (Никита 09.11): что считать залом. Баннер закрывается, «?» у заголовка возвращает */
  const HALLS_HINT_KEY = 'wed-cab-hint-halls';
  function hallsHint(): string {
    try { if (localStorage.getItem(HALLS_HINT_KEY)) return ''; } catch {}
    return `<div class="c-hint" data-halls-hint>
      <span class="c-hhint" aria-hidden="true">
        <span class="c-hhint__row c-hhint__row--1"><s></s><i></i><b></b></span>
        <span class="c-hhint__row c-hhint__row--2"><s></s><i></i><b></b></span>
        <span class="c-hhint__row c-hhint__row--3"><s></s><i></i><b></b></span>
      </span>
      <span class="c-hint__text"><b>Что считать залом</b><span>Любое место, где проходит банкет или церемония: отдельный зал, веранда, шатёр, терраса, площадка у воды. У каждого — свои гости, площадь, цена и кадр</span></span>
      <button class="c-hint__close" type="button" aria-label="Понятно" data-halls-hint-close>${X_ICON}</button>
    </div>`;
  }
  view.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('[data-write-changes]')) {
      if (locked()) return;
      openWriteChanges(() => route());
      return;
    }
    if ((e.target as HTMLElement).closest('[data-halls-hint-close]')) {
      try { localStorage.setItem(HALLS_HINT_KEY, '1'); } catch {}
      view.querySelector('[data-halls-hint]')?.remove();
      return;
    }
    const again = (e.target as HTMLElement).closest<HTMLElement>('[data-hint-again]');
    if (again) {
      const k = again.dataset.hintAgain;
      try { localStorage.removeItem(k === 'foto' ? HINT_KEY : k === 'zaly' ? HALLS_HINT_KEY : TARIFF_HINT_KEY); } catch {}
      renderSection(again.dataset.hintAgain as SectionKey);
      view.querySelector('.c-hint:not([hidden])')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      return;
    }
    if (!(e.target as HTMLElement).closest('[data-tariff-hint-close]')) return;
    try { localStorage.setItem(TARIFF_HINT_KEY, '1'); } catch {}
    view.querySelector('[data-tariff-hint]')?.remove();
  });

  function dragHint(names: string[]) {
    const el = view.querySelector<HTMLElement>('[data-drag-hint]');
    if (!el) return;
    if (names.length < 2 || hintSeen()) { el.hidden = true; return; }
    if (el.dataset.ready) { el.hidden = false; return; }
    el.dataset.ready = '1';
    const pic = (i: number) => names[i] ? `style="background-image:url('${fileUrl(rev, names[i], { thumb: '100x0', token })}')"` : '';
    el.innerHTML = `
      <span class="c-hint__demo" aria-hidden="true">
        <span class="c-hint__tile c-hint__tile--1" ${pic(0)}></span>
        <span class="c-hint__tile c-hint__tile--2" ${pic(1)}></span>
        <span class="c-hint__tile c-hint__tile--3" ${pic(2) || pic(1)}></span>
        <span class="c-hint__touch"></span>
      </span>
      <span class="c-hint__text"><b>Зажмите фото и перетащите</b><span>Так меняется порядок. Первое фото — обложка в каталоге.</span></span>
      <button class="c-hint__close" type="button" aria-label="Понятно">${X_ICON}</button>`;
    el.querySelector('.c-hint__close')!.addEventListener('click', hideDragHint);
    el.hidden = false;
  }

  /**
   * Порядок фото перетаскиванием. Мышь — сразу по сдвигу; палец — после
   * удержания (~0,3 с): обычное движение пальцем остаётся прокруткой
   * страницы. Пока тащим, touchmove гасится, иначе браузер начнёт листать.
   * Плитки переставляются в DOM на лету, в базу уходит один запрос на отпускании.
   */
  function bindPhotoDrag(box: HTMLElement) {
    if (box.dataset.drag) return;
    box.dataset.drag = '1';
    type Drag = { el: HTMLElement; id: number; x0: number; y0: number; gx: number; gy: number; x: number; y: number; on: boolean; timer: number; raf: number };
    let d: Drag | null = null;
    const tiles = () => [...box.querySelectorAll<HTMLElement>('.c-photo[data-pi]')];
    const place = () => {
      if (!d) return;
      d.el.style.transform = '';
      const r = d.el.getBoundingClientRect();
      d.el.style.transform = `translate(${d.x - d.gx - r.left}px, ${d.y - d.gy - r.top}px)`;
    };
    // у края экрана — подкручиваем страницу, чтобы дотащить до дальнего ряда
    const edge = () => {
      if (!d?.on) return;
      const zone = 72;
      const v = d.y < zone ? -(zone - d.y) / 6 : d.y > innerHeight - zone ? (d.y - innerHeight + zone) / 6 : 0;
      if (v) { scrollBy(0, v); place(); }
      d.raf = requestAnimationFrame(edge);
    };
    const start = () => {
      if (!d) return;
      d.on = true;
      const r = d.el.getBoundingClientRect();
      d.gx = d.x0 - r.left;
      d.gy = d.y0 - r.top;
      d.el.classList.add('is-drag');
      box.classList.add('is-sorting');
      navigator.vibrate?.(10);
      d.raf = requestAnimationFrame(edge);
    };
    box.addEventListener('pointerdown', (e) => {
      const t = e.target as HTMLElement;
      const el = t.closest<HTMLElement>('.c-photo[data-pi]');
      if (!el || t.closest('button') || locked() || (e.pointerType === 'mouse' && e.button !== 0)) return;
      d = { el, id: e.pointerId, x0: e.clientX, y0: e.clientY, gx: 0, gy: 0, x: e.clientX, y: e.clientY, on: false, timer: 0, raf: 0 };
      if (e.pointerType !== 'mouse') d.timer = window.setTimeout(start, 300);
    });
    addEventListener('pointermove', (e) => {
      if (!d || e.pointerId !== d.id) return;
      d.x = e.clientX;
      d.y = e.clientY;
      if (!d.on) {
        if (Math.hypot(d.x - d.x0, d.y - d.y0) < 8) return;
        // палец сдвинулся раньше удержания — это прокрутка, не перетаскивание
        if (e.pointerType !== 'mouse') { clearTimeout(d.timer); d = null; return; }
        start();
      }
      d.el.style.visibility = 'hidden';
      const over = document.elementFromPoint(d.x, d.y)?.closest<HTMLElement>('.c-photo[data-pi]');
      d.el.style.visibility = '';
      if (over && over !== d.el && box.contains(over)) {
        const all = tiles();
        over[all.indexOf(d.el) < all.indexOf(over) ? 'after' : 'before'](d.el);
      }
      place();
    });
    box.addEventListener('touchmove', (e) => { if (d?.on) e.preventDefault(); }, { passive: false });
    box.addEventListener('contextmenu', (e) => { if ((e.target as HTMLElement).closest('.c-photo')) e.preventDefault(); });
    const end = async (e: PointerEvent) => {
      if (!d || e.pointerId !== d.id) return;
      const cur = d;
      d = null;
      clearTimeout(cur.timer);
      cancelAnimationFrame(cur.raf);
      // короткое нажатие без сдвига — открыть кадр во весь экран
      if (!cur.on) {
        if (e.type === 'pointerup' && Math.hypot(e.clientX - cur.x0, e.clientY - cur.y0) < 8) openViewer(Number(cur.el.dataset.pi));
        return;
      }
      cur.el.classList.remove('is-drag');
      cur.el.style.transform = '';
      box.classList.remove('is-sorting');
      const names: string[] = rev.photos ?? [];
      const order = tiles().map((el) => names[Number(el.dataset.pi)]);
      if (order.some((n, i) => n !== names[i])) { hideDragHint(); await photoPatch({ photos: order }); }
    };
    addEventListener('pointerup', end);
    addEventListener('pointercancel', end);
  }

  /**
   * Фото с Яндекс Диска (docs/cabinet/CABINET.md §13): ссылка на папку → превью кадров →
   * отмечаем нажатием (номер — порядок) → сервер забирает выбранные пачками
   * по 5 (lib/yadisk.js). Ход — капсулой внизу с процентом и «Прервать»
   * (cab-ui → progress, 05.11): окно можно закрыть, забор идёт дальше.
   * Вкладку закрыли — догрузка встала, уже забранное остаётся в карточке.
   */
  function openYadisk() {
    let busy = false;
    const { dlg, close } = openDialog({
      // закрыть можно и во время забора — он идёт дальше, ход виден внизу
      onClose: () => { if (!busy) { renderPhotos(); savedLabel(); } },
      html: `<div class="c-dialog__body">
      <button class="c-dialog__x" type="button" data-close aria-label="Закрыть">${X_ICON}</button>
      <h2 class="a-h2 c-yd-title"><img src="${cfg.ydIcon}" alt="" width="28" height="28" />Фото с Яндекс Диска</h2>
      ${/* текст короче (Никита 06.11): без названия папки, счёта фото и видео, без «можно добавить до 50» —
           про предел скажем, только когда в него упёрлись */''}
      <p class="a-lead">Вставьте ссылку на папку. Доступ к ней должен быть открыт всем, у кого есть ссылка</p>
      <input class="a-field__input c-yd-url" type="url" inputmode="url" placeholder="https://disk.yandex.ru/d/…" aria-label="Ссылка на папку" data-yd-url />
      <p class="c-error" data-yd-error hidden></p>
      <p class="a-field__note" data-yd-info hidden></p>
      <div class="c-yd-head" data-yd-tools hidden><button class="c-chipbtn" type="button" data-yd-all>Отметить все</button></div>
      <div class="c-photos c-yd-grid" data-yd-grid></div>
      ${/* кнопка прибита к низу окна и появляется с первой отметкой — раньше она пряталась
           под сеткой кадров, и было непонятно, добавились фото или нет (Никита 06.11) */''}
      ${/* ход забора — у прибитой кнопки, всегда перед глазами (Никита 07.11) */''}
      <div class="c-yd-bar" data-yd-bar hidden><p class="c-yd-status" data-yd-status role="status" hidden></p><button class="a-btn a-btn--primary a-btn--lg a-btn--block" type="button" data-yd-go>Добавить</button></div>
    </div>`,
    });
    const $ = <T extends HTMLElement>(s: string) => dlg.querySelector<T>(s)!;
    const err = $('[data-yd-error]'), info = $('[data-yd-info]'), grid = $('[data-yd-grid]'), tools = $('[data-yd-tools]'), go = $<HTMLButtonElement>('[data-yd-go]'), status = $('[data-yd-status]');
    let link = '';
    let items: { path: string; name: string; preview: string }[] = [];
    const picked: string[] = [];
    // уже забранное в этом окне: после обрыва связи отметки с них снимаем,
    // плитки помечаем «уже в карточке» и повторно не предлагаем (задача 05.11)
    const imported = new Set<string>();
    const room = () => MAX_PHOTOS - (rev.photos ?? []).length;
    const limitText = () => `На карточке до ${MAX_PHOTOS}${NBSP}фото — ${(rev.photos ?? []).length ? `поместится ещё ${room()}` : `отметили первые ${MAX_PHOTOS}`}`;
    // как у Apple: короткий текст под полем; красным — только сбой (fail),
    // подсказка вроде «не та ссылка», «только ролики» — спокойным тёмным текстом (note)
    const fail = (m: string) => { err.classList.remove('c-yd-note'); err.textContent = m; err.hidden = !m; };
    const note = (m: string) => { err.classList.add('c-yd-note'); err.textContent = m; err.hidden = !m; };
    const bar = $('[data-yd-bar]');
    const sync = () => {
      grid.querySelectorAll<HTMLElement>('[data-yd-path]').forEach((b) => {
        const done = imported.has(b.dataset.ydPath!);
        b.classList.toggle('c-yd-pick--done', done);
        b.toggleAttribute('disabled', done);
        const i = picked.indexOf(b.dataset.ydPath!);
        b.setAttribute('aria-pressed', String(i !== -1));
        b.querySelector('.c-yd-pick__n')!.textContent = i === -1 ? '' : String(i + 1);
      });
      if (!busy) go.textContent = `Добавить ${picked.length}${NBSP}фото`;
      go.disabled = busy;
      bar.hidden = !picked.length && !busy;
    };

    // кнопки «Показать» нет (Никита 05.11: непонятно, что она покажет) —
    // кадры подгружаются сами, когда в поле похожая на Диск ссылка
    const urlIn = $<HTMLInputElement>('[data-yd-url]');
    let ydTimer = 0;
    const isDisk = (v: string) => /^(https?:\/\/)?(disk\.yandex\.[a-z]+|yadi\.sk|disk\.360\.yandex\.[a-z]+)\//i.test(v.trim());
    urlIn.addEventListener('input', () => {
      clearTimeout(ydTimer);
      const v = urlIn.value.trim();
      if (!v) return;
      if (!isDisk(v)) { if (v.length > 12) note('Нужна ссылка на папку Яндекс Диска — disk.yandex.ru/d/…'); return; }
      fail('');
      ydTimer = window.setTimeout(showFolder, 500);
    });
    async function showFolder() {
      if (urlIn.value.trim() === link && items.length) return;
      link = urlIn.value.trim();
      fail('');
      grid.innerHTML = '';
      tools.hidden = true;
      picked.length = 0;
      info.textContent = 'Открываем папку…';
      info.hidden = false;
      try {
        const r = await api('vendor', 'GET', `/api/wed/yadisk/list?url=${encodeURIComponent(link)}`);
        items = r.items ?? [];
        if (!items.length) {
          info.hidden = true;
          // папка только с роликами — отдельно: ролики идут ссылкой в разделе «Видео»
          note(r.videos ? 'В папке только видео — их добавьте в разделе «Видео»' : 'В папке нет фотографий — проверьте ссылку');
          return;
        }
        info.hidden = true;
        grid.innerHTML = items.map((it) => `
          <button class="c-photo c-yd-pick" type="button" aria-pressed="false" data-yd-path="${esc(it.path)}" title="${esc(it.name)}">
            ${it.preview ? `<img src="${esc(it.preview)}" alt="" loading="lazy" referrerpolicy="no-referrer" />` : ''}
            <span class="c-yd-pick__n" aria-hidden="true"></span><span class="c-yd-pick__done">в карточке</span>
          </button>`).join('');
        tools.hidden = false;
        sync();
      } catch (x) {
        info.hidden = true;
        fail(errText(x));
      }
    }

    grid.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('[data-yd-path]');
      if (!b || busy) return;
      const p = b.dataset.ydPath!;
      const i = picked.indexOf(p);
      if (i !== -1) picked.splice(i, 1);
      else if (picked.length < room()) { picked.push(p); note(''); }
      else note(limitText());
      sync();
    });
    $('[data-yd-all]').addEventListener('click', () => {
      const free = items.filter((it) => !picked.includes(it.path) && !imported.has(it.path));
      for (const it of free) if (picked.length < room()) picked.push(it.path);
      // отметили не всё — упёрлись в предел карточки: говорим только сейчас
      note(free.length > 0 && picked.length >= room() && items.length - imported.size > picked.length ? limitText() : '');
      sync();
    });

    go.addEventListener('click', async () => {
      if (!picked.length) return;
      busy = true;
      fail('');
      sync();
      const todo = [...picked];
      const skipped: string[] = [];
      const skippedPaths: string[] = [];
      let done = 0;
      let had = 0; // уже были в карточке (сервер: already) — например, после перезагрузки отметили те же кадры
      let stop = false;
      const bar = progress('Забираем с Диска', () => { stop = true; });
      // ход — в самом окне, над кадрами: пока окно открыто, оно лежит поверх капсулы внизу
      const say = () => { status.textContent = `Забрали ${done} из ${todo.length}. Окно можно закрыть — загрузка продолжится`; status.hidden = false; };
      say();
      go.textContent = 'Забираем…';
      // в анкете виден свежий набор кадров, даже если окно уже закрыли
      const refresh = () => { if (new URLSearchParams(location.search).get('s') === 'foto' && !dlg.open && view.querySelector('[data-photos]')) renderPhotos(); };
      try {
        // по два кадра за запрос (09.11): по пять ход на маленьких пачках стоял на нуле до конца
        for (let i = 0; i < todo.length && !stop; i += 2) {
          bar.update(`Забираем с Диска: ${done} из ${todo.length},`, done, todo.length);
          const part = todo.slice(i, i + 2);
          const r = await api('vendor', 'POST', '/api/wed/yadisk/import', { revision: rev.id, url: link, paths: part });
          rev = r.record;
          done += r.added;
          had += r.already ?? 0;
          const bad = new Set((r.skipped ?? []).map((x: any) => x.path));
          for (const p of part) if (!bad.has(p)) imported.add(p);
          say();
          sync();
          go.textContent = 'Забираем…';
          for (const s of r.skipped ?? []) { skipped.push(items.find((it) => it.path === s.path)?.name ?? s.path); skippedPaths.push(s.path); }
          refresh();
        }
        bar.done();
        if (rev.photos?.length && !token) token = await fileToken('vendor');
        justSaved = true;
        busy = false;
        if (skipped.length) {
          status.hidden = true;
          // по-человечески, без имён файлов (Никита 07.11): сколько забрали, сколько нет и что делать;
          // незабранные остаются отмеченными — «Добавить» пробует их ещё раз
          if (!dlg.open) toast(`Добавлено ${done} из ${todo.length}. ${skipped.length} фото не забрались — откройте окно Диска и попробуйте ещё раз`, true);
          fail(`Добавлено ${done} из ${todo.length}. ${skipped.length}${NBSP}фото не забрались — они остались отмечены, нажмите «Добавить» ещё раз. Не выйдет — загрузите их с телефона`);
          picked.length = 0;
          picked.push(...skippedPaths.filter((p) => !imported.has(p)));
          sync();
          return;
        }
        close();
        if (!dlg.open) { refresh(); savedLabel(); }
        const sum = `Добавлено ${done}${had ? `, уже были в карточке ${had}` : ''}`;
        toast(stop ? `Остановили. ${sum}` : sum);
      } catch (x) {
        bar.done();
        busy = false;
        status.hidden = true;
        // обрыв: забранное уже в карточке — отметки с него снимаем, остальное остаётся отмеченным
        for (const p of imported) { const k = picked.indexOf(p); if (k !== -1) picked.splice(k, 1); }
        refresh();
        fail(`${done ? `Добавлено ${done}. ` : ''}${errText(x)}${picked.length ? ` Осталось отмечено ${picked.length} — нажмите «Добавить», чтобы дозабрать` : ''}`);
        if (!dlg.open) toast(`${done ? `Добавлено ${done}. ` : ''}${errText(x)}`, true);
        sync();
      }
    });
    $<HTMLInputElement>('[data-yd-url]').focus();
  }

  async function photoPatch(body: any, onPart?: (part: number) => void) {
    const err = view.querySelector<HTMLElement>('[data-photo-error]')!;
    err.hidden = true;
    try {
      rev = onPart && body instanceof FormData
        ? await apiUpload('vendor', `/api/collections/revisions/records/${rev.id}`, body, onPart)
        : await api('vendor', 'PATCH', `/api/collections/revisions/records/${rev.id}`, body);
      if (rev.photos?.length && !token) token = await fileToken('vendor');
      savedAt = time();
      justSaved = true;
    } catch (x) {
      err.textContent = errText(x);
      err.hidden = false;
    }
    renderPhotos();
    savedLabel();
  }

  async function upload(files: File[]) {
    const room = MAX_PHOTOS - (rev.photos ?? []).length;
    const status = view.querySelector<HTMLElement>('[data-upload]')!;
    const err = view.querySelector<HTMLElement>('[data-photo-error]')!;
    if (files.length > room) { err.textContent = `Можно добавить ещё ${room} — лишние не загружены.`; err.hidden = false; files = files.slice(0, room); }
    // порциями до 15 МБ: одним запросом 8+ кадров упираются в лимит (прогон 26.10)
    const PART = 15 * 1024 * 1024;
    // ход — капсулой внизу с процентом и «Прервать» (cab-ui → progress, 05.11)
    const total = files.length;
    let sent = 0;
    let stop = false;
    const bar = progress('Загружаем фото', () => { stop = true; });
    let queue: File[] = [];
    let size = 0;
    const flush = async () => {
      if (!queue.length) return;
      const fd = new FormData();
      queue.forEach((f) => fd.append('photos+', f, f.name));
      // ход по байтам (09.11): раньше процент двигался только после всей пачки
      // до 15 МБ — на нескольких кадрах с телефона всё время стояло «0 %»
      const n = queue.length;
      await photoPatch(fd, (part) => bar.update('Загружаем фото', sent + part * n, total));
      sent += n;
      bar.update('Загружаем фото', sent, total);
      queue = [];
      size = 0;
    };
    try {
      for (const f of files) {
        if (stop) break;
        const small = await shrinkPhoto(f);
        if (size + small.size > PART) await flush();
        queue.push(small);
        size += small.size;
      }
      if (!stop) await flush();
    } finally {
      bar.done();
      status.hidden = true;
      if (stop) toast(`Остановили. Загружено фото: ${sent}`);
    }
  }

  // ---------- правка полей ----------
  function setPath(path: string, value: unknown) {
    const keys = path.split('.');
    let o = data;
    keys.slice(0, -1).forEach((k, i) => {
      const next = keys[i + 1];
      if (o[k] == null) o[k] = /^\d+$/.test(next) ? [] : {};
      o = o[k];
    });
    o[keys[keys.length - 1]] = value;
  }

  view.addEventListener('input', (e) => {
    const t = e.target as HTMLInputElement;
    if (!t.dataset.bind) return;
    if (t.getAttribute('aria-invalid')) clearFieldError(t); // начал исправлять — облачко уходит
    if (t.matches('textarea[data-grow]')) {
      // одна фраза: перенос строки (в том числе вставленный) не храним
      if (t.dataset.grow === 'line' && /\n/.test(t.value)) t.value = t.value.replace(/\s*\n+\s*/g, ' ');
      grow(t as unknown as HTMLTextAreaElement);
    }
    // суммы в рублях — разряды видны уже при наборе («40 000», правило 24);
    // в данные уходят только цифры
    if (/(^|\.)(price|priceFrom|rentFrom|checkFrom)$/.test(t.dataset.bind)) {
      const digits = t.value.replace(/\D/g, '');
      t.value = digits ? num(Number(digits)) : '';
      setPath(t.dataset.bind, digits);
      // цена тарифа: поле по ширине числа — «₽» стоит вплотную (Никита 07.11)
      if (t.closest('.c-tcard__sum')) fitWidth(t);
    } else setPath(t.dataset.bind, t.value);
    const count = view.querySelector('[data-count]');
    if (count) count.textContent = countText();
    // «за что» набрали руками — подсветка готовых вариантов следует за текстом
    view.querySelectorAll<HTMLElement>(`[data-unit="${t.dataset.bind}"]`).forEach((o) => o.setAttribute('aria-pressed', String(o.dataset.v === t.value)));
    // ссылка на ролик похожа на ссылку — галочка у поля и строка «что дальше»
    if (t.dataset.bind.startsWith('videos.')) {
      const okUrl = (v: string) => /^https?:\/\/\S+\.\S+/.test(v.trim());
      const ok = view.querySelector<HTMLElement>(`[data-vok="${t.dataset.bind.split('.')[1]}"]`);
      if (ok) ok.hidden = !okUrl(t.value);
    }
    later();
  });

  view.addEventListener('focusout', (e) => {
    const t = e.target as HTMLInputElement;
    if (t.dataset.bind?.startsWith('videos.')) {
      const v = t.value.trim();
      if (v && !/^https?:\/\/\S+\.\S+/.test(v)) fieldError(t, 'Ссылка начинается с https:// — скопируйте её кнопкой «Поделиться»', t.closest<HTMLElement>('.c-vrow') ?? undefined);
      else clearFieldError(t);
      return;
    }
    if (t.dataset.bind !== 'contacts.telegram') return;
    const { value, ok } = normalizeTelegram(t.value);
    t.value = value;
    setPath('contacts.telegram', value);
    if (ok) clearFieldError(t);
    else fieldError(t, 'Ник в Telegram — латиница, цифры и «_», от 5 знаков');
    later();
  });

  view.addEventListener('change', async (e) => {
    const t = e.target as HTMLInputElement;
    if (t.matches('[data-pfiles]') && t.files?.length) await upload([...t.files]);
    if (t.matches('[data-avatar]') && t.files?.[0]) await uploadAvatar(t.files[0]);
  });

  // «Подровнять»: берём текущий портрет файлом и открываем тот же круг кадрирования
  view.addEventListener('click', async (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-ava-recrop]');
    if (!b || !rev.avatar) return;
    b.disabled = true;
    try {
      if (!token) token = await fileToken('vendor');
      const r = await fetch(fileUrl(rev, rev.avatar, { token }));
      if (!r.ok) throw new Error(`портрет не загрузился (${r.status})`);
      const blob = await r.blob();
      await uploadAvatar(new File([blob], 'avatar.jpg', { type: blob.type || 'image/jpeg' }));
    } catch (x) {
      toast(`Не открылось. ${errText(x)}`, true);
    } finally {
      b.disabled = false;
    }
  });

  view.addEventListener('click', async (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('button');
    if (!b || (b as HTMLButtonElement).disabled) return;
    if (b.dataset.preview) { e.preventDefault(); openPreview(b.dataset.preview as SectionKey); return; }
    if (b.hasAttribute('data-yadisk')) { openYadisk(); return; }
    // цена: способ и готовые «за что»
    if (b.dataset.team) {
      data.team = b.dataset.team === 'team';
      if (data.team) data.lastName = '';
      derive();
      renderSection('osnovnoe');
      later();
      return;
    }
    if (b.dataset.vtype) {
      data.type = b.dataset.vtype;
      view.querySelectorAll<HTMLElement>('[data-vtype]').forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
      later();
      return;
    }
    if (b.dataset.hallPhotos) {
      openHallPhotos(Number(b.dataset.hallPhotos));
      return;
    }
    if (b.dataset.pmode) {
      // «Одна цена» не теряется при переходе на тарифы или «по запросу» и обратно
      // (Никита 06.11: ввёл цену, открыл «Тарифы» — цена затёрлась). Как tariffsDraft:
      // черновик в ревизии, на сайт идут только поля выбранного способа.
      if (priceMode() === 'one' && b.dataset.pmode !== 'one') data.priceOneDraft = { from: data.priceFrom ?? '', note: data.priceNote ?? '' };
      data.priceMode = b.dataset.pmode;
      if (data.priceMode === 'one' && data.priceOneDraft) { data.priceFrom = data.priceOneDraft.from; data.priceNote = data.priceOneDraft.note; delete data.priceOneDraft; }
      if (data.priceMode === 'tariffs' && !data.tariffs?.length && !data.tariffsDraft?.length) data.tariffs = [{}];
      derive();
      renderSection('prays');
      later();
      return;
    }
    if (b.dataset.unit) {
      setPath(b.dataset.unit, b.dataset.v);
      const inp = view.querySelector<HTMLInputElement>(`[data-bind="${b.dataset.unit}"]`);
      if (inp) {
        inp.value = b.dataset.v!;
        if (inp.matches('textarea[data-grow]')) grow(inp as unknown as HTMLTextAreaElement);
      }
      view.querySelectorAll<HTMLElement>(`[data-unit="${b.dataset.unit}"]`).forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
      later();
      return;
    }
    if (b.hasAttribute('data-maxsame')) {
      data.contacts ??= {};
      data.contacts.maxSame = !data.contacts.maxSame;
      if (!data.contacts.maxSame) data.contacts.max = '';
      b.setAttribute('aria-checked', String(data.contacts.maxSame));
      later();
      return;
    }
    // вопросы и условия: один вариант или несколько
    if (b.dataset.q) {
      const scope = b.dataset.scope!;
      data[scope] ??= {};
      const cur = data[scope][b.dataset.q];
      const v = b.dataset.v!;
      if (b.dataset.multi === 'true') {
        const list: string[] = Array.isArray(cur) ? cur : [];
        data[scope][b.dataset.q] = list.includes(v) ? list.filter((x) => x !== v) : [...list, v];
      } else {
        data[scope][b.dataset.q] = cur === v ? '' : v;
      }
      const group = b.closest('.c-q')!;
      group.querySelectorAll<HTMLElement>('.c-opt').forEach((o) => {
        const val = data[scope][b.dataset.q!];
        o.setAttribute('aria-pressed', String(Array.isArray(val) ? val.includes(o.dataset.v!) : val === o.dataset.v));
      });
      const val = data[scope][b.dataset.q];
      const empty = group.querySelector('.c-q__empty');
      if ((Array.isArray(val) ? val.length : val) && empty) empty.remove();
      later();
      return;
    }
    // списки: разделы текста, пакеты, залы
    if (b.dataset.add || b.dataset.move || b.dataset.remove) {
      if (b.dataset.add) {
        // видео: первое поле нарисовано без записи в данных
        if (b.dataset.add === 'videos' && !data.videos?.length) data.videos = [{}];
        (data[b.dataset.add] ??= []).push({});
      } else if (b.dataset.move) {
        const list = data[b.dataset.move];
        const i = Number(b.dataset.i), j = i + Number(b.dataset.d);
        [list[i], list[j]] = [list[j], list[i]];
      } else if (b.dataset.remove) {
        // убранный раздел, тариф или зал можно вернуть — «Отменить» в тосте
        const key = b.dataset.remove, i = Number(b.dataset.i);
        const [gone] = data[key]?.splice(i, 1) ?? [];
        const what: Record<string, string> = { sections: 'Раздел убран', tariffs: 'Тариф убран', halls: 'Зал убран', videos: 'Ссылка убрана' };
        if (gone && Object.values(gone).some((v) => String(v ?? '').trim())) {
          undoable({
            text: what[key] ?? 'Убрано',
            undo: () => { data[key].splice(i, 0, gone); renderSection(section()!); later(); },
            run: () => {},
          });
        }
      }
      renderSection(section()!);
      later();
      return;
    }
    // фото
    // убрать фото: с экрана сразу, с сервера — через 6 секунд, если не отменили
    // (05.11.2026: раньше кадр удалялся навсегда одним касанием крестика)
    if (b.dataset.premove) {
      const name = rev.photos[Number(b.dataset.premove)];
      const tile = b.closest<HTMLElement>('.c-photo');
      if (tile) tile.hidden = true;
      undoable({
        text: 'Фото убрано',
        undo: () => { if (tile) tile.hidden = false; },
        run: () => photoPatch({ 'photos-': [name] }),
      });
      return;
    }
  });

  // карточка на проверке: поля выключены — касание по ним объясняет, почему
  // и что сделать (правило 8: выключенное объясняет причину)
  view.addEventListener('click', (e) => {
    if (!locked() || rev.status !== 'review') return;
    const hit = (e.target as HTMLElement).closest('.c-form .a-field, .c-form .c-opt, .c-form .c-photo, .c-form .c-add');
    if (hit) toast('Карточка на проверке — менять пока нельзя. Чтобы исправить, отзовите её с проверки', false, 3500);
  });

  // переходы внутри анкеты — без перезагрузки, данные уже в памяти
  view.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a.c-row, a.c-back, a.c-chipbtn');
    if (!a || !a.href.includes('/profi/moi/kartochka/') || e.metaKey || e.ctrlKey) return;
    e.preventDefault();
    save();
    navigate(a.href);
  });
  function navigate(href = url()) {
    history.pushState(null, '', href);
    route();
  }
  addEventListener('popstate', route);
  // Заполняют с телефона: поле, в которое перешли, подкручиваем к середине
  // экрана (над клавиатурой), Enter в однострочном поле — к следующему
  // (Никита, 02.11: «по ходу, как человек заполняет, само проскролливалось»)
  const coarse = matchMedia('(pointer: coarse)').matches;
  view.addEventListener('focusin', (e) => {
    const t = e.target as HTMLElement;
    if (!coarse || !t.matches('input:not([type=file]), textarea')) return;
    setTimeout(() => (t.closest('.a-field, .c-card, .c-q') ?? t).scrollIntoView({ block: 'center', behavior: 'smooth' }), 300);
  });
  view.addEventListener('keydown', (e) => {
    const t = e.target as HTMLInputElement;
    // строка под именем — textarea ради переноса, но Enter в ней ведёт к следующему полю, как в input
    const line = t.tagName === 'TEXTAREA' && t.dataset.grow === 'line';
    if (e.key !== 'Enter' || (t.tagName !== 'INPUT' && !line) || !t.closest('[data-form]')) return;
    if (line) e.preventDefault();
    const all = [...view.querySelectorAll<HTMLElement>('[data-form] input:not([type=hidden]):not([type=file]), [data-form] textarea')];
    const next = all[all.indexOf(t) + 1];
    if (next) { e.preventDefault(); next.focus(); }
  });

  // Кнопки «Готово» в разделах нет (Никита, 02.11: всё сохраняется само,
  // подтверждать нечего). Уход по нижнему меню — полная загрузка страницы:
  // дописываем несохранённое ДО перехода, иначе правка последней секунды
  // уйдёт вместе со страницей. Не сохранилось — остаёмся, плашка скажет почему.
  document.addEventListener('click', async (e) => {
    const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a.c-tab');
    if (!a || e.metaKey || e.ctrlKey || (!timer && !saving)) return;
    e.preventDefault();
    await save();
    if (!saveError) location.href = a.href;
  });
  // ушли со страницы или свернули браузер — дописываем несохранённое (без «Вы уверены?»)
  document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'hidden' && timer) save(); });

  function route() {
    // «назад» закрывает открытый кадр (openViewer) — анкету не перерисовываем
    if (document.querySelector('.c-viewer')) return;
    const p = new URLSearchParams(location.search);
    q.set('s', p.get('s') ?? '');
    if (!p.get('s')) q.delete('s');
    const sec = section();
    if (sec && SECTIONS[kind].some((x) => x.key === sec)) renderSection(sec);
    else renderOverview();
    scrollTo(0, 0);
  }

  async function load() {
    try {
      if (q.get('card')) {
        const r = await api('vendor', 'POST', '/api/wed/edit', { kind: q.get('kind'), card: q.get('card') });
        location.replace(`/profi/moi/kartochka/?id=${r.id}`);
        return;
      }
      rev = await api('vendor', 'GET', `/api/collections/revisions/records/${encodeURIComponent(q.get('id') ?? '')}`);
      kind = rev.kind;
      if (rev.updated) savedAt = new Date(rev.updated.replace(' ', 'T')).toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit' });
      data = rev.data && typeof rev.data === 'object' ? rev.data : {};
      // карточки до 27.10: имя одним полем — в «Имя», фамилию человек допишет
      if (kind === 'specialist' && data.firstName == null && data.name) data.firstName = data.name;
      // правка старой карточки с «О себе» одним полем — первым разделом текста
      if (!data.sections?.length && data.about) data.sections = [{ title: '', body: data.about }];
      questions = kind === 'venue' ? VENUE_QUESTIONS : cfg.questions[rev.categorySlug] ?? [];
      if (rev.photos?.length || rev.avatar) token = await fileToken('vendor');
      if (managed() && rev.specialist) {
        try {
          const card = await api('vendor', 'GET', `/api/collections/specialists/records/${rev.specialist}?fields=page`);
          pageTariffs = (card.page?.story ?? []).flatMap((x: any) => x?.tariffs ?? []).filter((t: any) => t?.name);
          textTariffs = pageTariffs.length;
          // цены тарифов в анкете — по названию тарифа; до слепка «на сайте», чтобы
          // сам этот список правкой не считался
          if (textTariffs && !Array.isArray(data.tariffPrices)) {
            data.tariffPrices = pageTariffs.map((t) => ({ name: t.name, price: Number(String(t.price).replace(/\D/g, '')) || '' }));
          }
        } catch { textTariffs = 0; }
      }
      if (!isNew() && rev.status === 'draft') {
        try { base = JSON.parse(localStorage.getItem(snapKey()) || 'null'); } catch { base = null; }
        // черновик правки не трогали (сохранён в те же секунды, что создан базой
        // из карточки) — значит, в нём ровно то, что на сайте: это и есть слепок.
        // Открытый черновик с правками база отдаёт тот же — его время уже другое
        const t = (v: string) => new Date(String(v).replace(' ', 'T')).getTime();
        const untouched = rev.created && rev.updated && t(rev.updated) - t(rev.created) < 20000;
        if (!base && untouched) {
          base = snapNow();
          try { localStorage.setItem(snapKey(), JSON.stringify(base)); } catch {}
        }
      }
      route();
    } catch (err) {
      view.innerHTML = `<p class="c-error">${esc(errText(err))}</p><a class="c-link" href="/profi/moi/">К моим карточкам</a>`;
    }
  }

  if (s) load();
</script>
