---
// ПРОМО-СТРАНИЦА ДЛЯ ПОДРЯДЧИКОВ И ПЛОЩАДОК — прототип (STAGE2.md §0.1).
// Ссылку на неё мы рассылаем подрядчикам и площадкам: что это, как работает,
// условия, видеоинструкция, вопросы и регистрация. Вживую — profi.wed-secrets.ru,
// тогда же откроем её поиску (сейчас noindex через ProfiShell).
//
// Условия — из решений 16.10 и 20.10 (CABINET.md §21–22): бесплатно на старте,
// до 50 фото, до 10 роликов по минуте, до 3 карточек, модерация до 24 часов.
// Тарифы третьего этапа здесь не обещаем — «объявим заранее».
import ProfiShell from '../../components/profi/ProfiShell.astro';
import FaqBlock from '../../components/FaqBlock.astro';
import Icon from '../../components/Icon.astro';

const steps = [
  { t: 'Заведите карточку', d: 'Войдите через Telegram или по почте и заполните анкету: текст о себе, ответы на вопросы вашей категории, прайс и фото. Всё сохраняется само.' },
  { t: 'Мы проверим за 24 часа', d: 'Модератор смотрит карточку до публикации. Если что-то не так, вернём с понятной причиной.' },
  { t: 'Пары находят вас', d: 'Карточка встаёт в каталог и фильтры, попадает в поиск Яндекса и Google и в подборки блога.' },
  { t: 'Обновляйте, когда нужно', d: 'Новые фото, цены, видео — правки проходят ту же проверку, а на сайте всё это время висит прежняя версия.' },
];

const gets = [
  'Своя страница с адресом',
  'Место в каталоге с фильтрами',
  'Попадание в поиск',
  'Видео в ленте главной',
  'Подборки в блоге',
  'Заявки от пар',
];

const terms = [
  ['Размещение', 'Бесплатно на старте'],
  ['Фото', 'До 50 на карточку'],
  ['Видео', 'До 10 роликов, каждый до минуты'],
  ['Карточек на одну учётку', 'До 3'],
  ['Проверка', 'До 24 часов'],
];

const faq = [
  { q: 'Сколько это стоит?', a: ['На старте размещение бесплатное. Если появятся тарифы, мы объявим их заранее, и вы решите сами.'] },
  { q: 'Кто может разместиться?', a: ['Площадки и подрядчики свадеб в Москве и области: фотографы, видеографы, ведущие, декораторы, флористы, стилисты и другие.'] },
  { q: 'Можно ли указать телефон в описании?', a: ['Нет. Контакты живут в отдельном поле и открываются паре по кнопке «Показать контакты». Так мы видим, сколько пар вами заинтересовались.'] },
  { q: 'У меня две профессии', a: ['Заведите до трёх карточек с одной учётки: например, фотограф и видеограф. Имя и контакты подставятся сами, работы — свои для каждой.'] },
  { q: 'Как загрузить много фото?', a: ['С телефона или ссылкой на папку Яндекс.Диска: сервер сам заберёт превью, вы отметите нужные кадры.'] },
];
---

<ProfiShell title="Разместиться в каталоге" action={{ href: '/profi/vhod/', label: 'Войти' }}>
  <main>
    <section class="section container hero">
      <h1 class="t-display">Вас найдут пары, которые уже выбирают</h1>
      <p class="t-lead hero__lead">
        WED Secrets — свадебный каталог площадок и подрядчиков Москвы и области.
        Заведите карточку за десять минут: мы проверим её и поставим в каталог, фильтры и поиск.
      </p>
      <div class="hero__cta">
        <a class="pill pill--lg pill--solid" href="/profi/registraciya/">Зарегистрироваться</a>
        <a class="pill pill--lg" href="/profi/vhod/">У меня есть учётка</a>
      </div>
    </section>

    <section class="section container">
      <h2 class="t-h1">Как это работает</h2>
      <ul class="how">
        {steps.map((s) => (
          <li class="how__item">
            <h3 class="how__t">{s.t}</h3>
            <p class="how__d">{s.d}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="section container">
      <h2 class="t-h1">Видеоинструкция</h2>
      <!-- ЗАГЛУШКА: ролик снимаем с готового кабинета (STAGE2.md, неделя 6). -->
      <div class="video" role="img" aria-label="Здесь будет видеоинструкция">
        <span class="video__play"><Icon name="play" /></span>
        <p class="video__cap">Как завести карточку за 10 минут</p>
      </div>
    </section>

    <section class="section container">
      <h2 class="t-h1">Что вы получаете</h2>
      <ul class="plates gets">
        {gets.map((g) => <li>{g}</li>)}
      </ul>
    </section>

    <section class="section container" id="usloviya">
      <h2 class="t-h1">Условия</h2>
      <dl class="rows terms">
        {terms.map(([k, v]) => (
          <div class="rows__row">
            <dt class="rows__label">{k}</dt>
            <dd class="rows__value">{v}</dd>
          </div>
        ))}
      </dl>
    </section>

    <FaqBlock title="Частые вопросы" items={faq} />

    <section class="section theme-dark final">
      <div class="container">
        <h2 class="t-h1">Начните с карточки</h2>
        <p class="t-lead final__lead">Регистрация через Telegram занимает минуту.</p>
        <a class="pill pill--lg final__btn" href="/profi/registraciya/">Зарегистрироваться</a>
      </div>
    </section>
  </main>
</ProfiShell>

<style>
  .hero { padding-top: var(--s-4); }
  .hero__lead { margin-top: var(--s-5); }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-6);
  }

  .how {
    list-style: none;
    display: grid;
    gap: var(--s-6);
    margin-top: var(--section-gap-tight);
  }
  .how__t {
    font-size: var(--fs-h3);
    font-weight: var(--w-head);
    line-height: var(--lh-heading);
  }
  .how__d {
    margin-top: var(--s-2);
    max-width: var(--measure-text);
  }

  .video {
    position: relative;
    margin-top: var(--section-gap-tight);
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-card);
    background: var(--surface);
    display: grid;
    place-items: center;
    align-content: center;
    gap: var(--s-3);
  }
  .video__play {
    width: 64px;
    height: 64px;
    border-radius: var(--radius-pill);
    background: var(--fg);
    color: var(--bg);
    display: grid;
    place-items: center;
  }
  .video__cap { font-size: var(--fs-small); font-weight: var(--w-medium); }

  .gets, .terms { margin-top: var(--section-gap-tight); }

  .final__lead { margin-top: var(--s-4); }
  .final__btn { margin-top: var(--s-6); border-color: var(--fg); }

  @media (min-width: 1024px) {
    .how { grid-template-columns: repeat(2, 1fr); gap: var(--s-7) var(--s-8); }
  }
</style>
