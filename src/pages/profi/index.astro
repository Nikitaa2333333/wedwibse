---
// ПРОМО-СТРАНИЦА ДЛЯ ПОДРЯДЧИКОВ И ПЛОЩАДОК — прототип (STAGE2.md §0.1).
// Ссылку на неё мы рассылаем подрядчикам и площадкам: что это, как работает,
// условия, видеоинструкция, вопросы и регистрация. Вживую — profi.wed-secrets.ru,
// тогда же откроем её поиску (сейчас noindex через ProfiShell).
//
// ВИТРИНА, А НЕ ПРИЛОЖЕНИЕ (решение Никиты 20.10.2026): здесь сознательно
// нарушаем правила каталога из CLAUDE.md — текст лежит на кадре под
// затемнением, есть появления при прокрутке, бегущая лента и стопка шагов.
// Ограничения скорости остаются: без новых библиотек, анимируем только
// transform/opacity, весь текст — в HTML, без JS страница читается целиком
// (появления включает скрипт классом .fx на <html>), prefers-reduced-motion
// выключает всё движение.
//
// Условия — из решений 16.10 и 20.10 (CABINET.md §21–22): бесплатно на старте,
// до 50 фото, до 10 роликов по минуте, до 3 карточек, модерация до 24 часов.
// Тарифы третьего этапа здесь не обещаем — «объявим заранее».
//
// Фото и ролики — настоящие карточки каталога. Ролики лежат на VPS
// (CLAUDE.md, «Видео»): локально их нет, и в первом экране стоит постер.
import { Image, getImage } from 'astro:assets';
import ProfiShell from '../../components/profi/ProfiShell.astro';
import Icon from '../../components/Icon.astro';
import { resolveImage, IMG_WIDTHS } from '../../lib/images';

// Первый экран: кадры сменяют друг друга с медленным наездом. Первый слой —
// ролик (постер тем же путём), остальные — фото.
const heroLayers = [
  { photo: '/reels/kosareva-courtyard.webp', video: '/reels/kosareva-courtyard.mp4' },
  { photo: '/venues/forest-dew/s4-evening.webp' },
  { photo: '/specialists/fotografy/suhorada/gal/p24.webp' },
  { photo: '/venues/led/s4-ceremony.webp' },
];
const heroPoster = await getImage({ src: resolveImage(heroLayers[0].photo), width: 1080, format: 'webp' });

// Бегущая лента: настоящие карточки каталога, два ряда навстречу.
const P = '/moskva/podryadchiki';
const rowA = [
  { photo: '/specialists/fotografy/suhorada/gal/p09.webp', name: 'Алексей Сухорада', role: 'Фотограф', href: `${P}/fotografy/suhorada/` },
  { photo: '/venues/forest-dew/s2-hall.webp', name: 'Лесная Роса', role: 'Площадка', href: '/moskva/ploshchadki/forest-dew/' },
  { photo: '/reels/kosareva-sun.webp', name: 'Екатерина Косарева', role: 'Reels-мейкер', href: `${P}/rils-meikery/kosareva/` },
  { photo: '/reels/lirein-pink.webp', name: 'Студия Лирейн', role: 'Декор', href: `${P}/dekoratory/lirein/` },
  { photo: '/specialists/vedushchie/balashova/gal/p05.webp', name: 'Любовь Балашова', role: 'Ведущая', href: `${P}/vedushchie/balashova/` },
  { photo: '/venues/led/gal/g9.webp', name: 'Оранжерея LЁD', role: 'Площадка', href: '/moskva/ploshchadki/led/' },
];
const rowB = [
  { photo: '/reels/zinoveev-couple.webp', name: 'Илья Зиновеев', role: 'Видеограф', href: `${P}/videografy/zinoveev/` },
  { photo: '/specialists/fotografy/suhorada/gal/p33.webp', name: 'Алексей Сухорада', role: 'Фотограф', href: `${P}/fotografy/suhorada/` },
  { photo: '/reels/nazarova-bouquet.webp', name: 'Анна Назарова', role: 'Стилист', href: `${P}/stilisty/nazarova/` },
  { photo: '/venues/forest-dew/s3-ceremony.webp', name: 'Лесная Роса', role: 'Площадка', href: '/moskva/ploshchadki/forest-dew/' },
  { photo: '/reels/goleva-day.webp', name: 'Дарья Голева', role: 'Ведущая', href: `${P}/vedushchie/goleva/` },
  { photo: '/reels/lirein-tent.webp', name: 'Студия Лирейн', role: 'Декор', href: `${P}/dekoratory/lirein/` },
];

const steps = [
  { photo: '/specialists/fotografy/suhorada/gal/p13.webp', t: 'Заведите карточку', d: 'Войдите через Telegram или по почте и заполните анкету: текст о себе, ответы на вопросы вашей категории, прайс и фото. Всё сохраняется само.' },
  { photo: '/venues/led/gal/g15.webp', t: 'Мы проверим за сутки', d: 'Модератор смотрит карточку до публикации. Если что-то не так — вернём с понятной причиной.' },
  { photo: '/reels/kosareva-veil.webp', t: 'Пары находят вас', d: 'Карточка встаёт в каталог и фильтры, в поиск Яндекса и Google, в подборки блога и ленту главной.' },
  { photo: '/specialists/fotografy/suhorada/gal/p36.webp', t: 'Обновляйте, когда нужно', d: 'Новые фото, цены, видео. Правка проходит ту же проверку, а на сайте всё это время висит прежняя версия.' },
];

const gets = [
  'Своя страница с адресом',
  'Место в каталоге с фильтрами',
  'Поиск Яндекса и Google',
  'Ролики в ленте главной',
  'Подборки в блоге',
  'Заявки от пар',
];

const terms = [
  ['0 ₽', 'размещение на старте'],
  ['50', 'фото в карточке'],
  ['10', 'роликов до минуты'],
  ['3', 'карточки на одну учётку'],
  ['24 ч', 'на проверку'],
];

const faq = [
  { q: 'Сколько это стоит?', a: 'На старте размещение бесплатное. Если появятся тарифы, мы объявим их заранее, и вы решите сами.' },
  { q: 'Кто может разместиться?', a: 'Площадки и подрядчики свадеб в Москве и области: фотографы, видеографы, ведущие, декораторы, флористы, стилисты и другие.' },
  { q: 'Можно ли указать телефон в описании?', a: 'Нет. Контакты живут в отдельном поле и открываются паре по кнопке «Показать контакты». Так мы видим, сколько пар вами заинтересовались.' },
  { q: 'У меня две профессии', a: 'Заведите до трёх карточек с одной учётки: например, фотограф и видеограф. Имя и контакты подставятся сами, работы — свои для каждой.' },
  { q: 'Как загрузить много фото?', a: 'С телефона или ссылкой на папку Яндекс.Диска: сервер сам заберёт превью, вы отметите нужные кадры.' },
];

const statement = 'Пары приходят сюда выбирать, а не листать. Поэтому каждая карточка — как страница журнала: ваши лучшие кадры, ваш текст, ваши цены.';
---

<ProfiShell title="Разместиться в каталоге" look="promo" action={{ href: '/profi/vhod/', label: 'Войти' }}>
  <main class="promo">
    <!-- 1. Первый экран: живые кадры во весь экран, текст поверх -->
    <section class="hero">
      <div class="hero__stage" aria-hidden="true">
        {heroLayers.map((l, i) => (
          <div class="hero__layer" style={`--i:${i}`}>
            {l.video ? (
              <video class="hero__media" src={l.video} poster={heroPoster.src} autoplay muted loop playsinline preload="metadata" />
            ) : (
              <Image src={resolveImage(l.photo)} alt="" widths={[...IMG_WIDTHS.hero]} sizes="100vw" class="hero__media" loading={i === 1 ? 'eager' : 'lazy'} />
            )}
          </div>
        ))}
      </div>
      <div class="hero__shade" aria-hidden="true"></div>
      <div class="hero__body container">
        <p class="hero__kicker">Для площадок и подрядчиков</p>
        <h1 class="hero__title">
          <span class="line"><span>Красивая витрина</span></span>
          <span class="line"><span>для вашей работы</span></span>
        </h1>
        <p class="hero__lead">Свадебный каталог Москвы и области, где пары выбирают глазами: фото, видео, честные цены.</p>
        <div class="hero__cta">
          <a class="btn btn--light" href="/profi/registraciya/">Разместиться бесплатно</a>
          <a class="btn btn--ghost" href="#kak">Как это работает</a>
        </div>
      </div>
      <span class="hero__cue" aria-hidden="true"></span>
    </section>

    <!-- 2. Фраза, которая проявляется по словам при прокрутке -->
    <section class="say container" data-say>
      <p class="say__text">
        {statement.split(' ').map((w, i) => <span class="say__w" style={`--k:${i}`}>{w} </span>)}
      </p>
    </section>

    <!-- 3. Бегущая лента карточек -->
    <section class="run" aria-labelledby="run-t">
      <div class="container">
        <h2 class="sec-title" id="run-t" data-fx>Вы окажетесь рядом с ними</h2>
      </div>
      {[rowA, rowB].map((row, r) => (
        <div class={`run__row run__row--${r ? 'back' : 'fwd'}`}>
          <ul class="run__track">
            {[...row, ...row].map((c, i) => (
              <li class="run__item" aria-hidden={i >= row.length ? 'true' : undefined}>
                <a class="run__card" href={c.href} tabindex={i >= row.length ? -1 : undefined}>
                  <Image src={resolveImage(c.photo)} alt={i >= row.length ? '' : c.name} widths={[...IMG_WIDTHS.card]} sizes="(min-width: 1024px) 240px, 42vw" class="run__img" />
                  <span class="run__name">{c.name}</span>
                  <span class="run__role">{c.role}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>

    <!-- 4. Как это работает: карточки шагов ложатся стопкой -->
    <section class="how container" id="kak">
      <h2 class="sec-title" data-fx>Как это работает</h2>
      <ol class="how__stack">
        {steps.map((s, i) => (
          <li class={`how__card how__card--${i % 2 ? 'dark' : 'light'}`} style={`--i:${i}`}>
            <div class="how__text">
              <span class="how__num">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="how__t">{s.t}</h3>
              <p class="how__d">{s.d}</p>
            </div>
            <Image src={resolveImage(s.photo)} alt="" widths={[...IMG_WIDTHS.card]} sizes="(min-width: 1024px) 420px, 80vw" class="how__img" />
          </li>
        ))}
      </ol>
    </section>

    <!-- 5. Что вы получаете: телефон с вашей карточкой -->
    <section class="gets">
      <div class="container gets__in">
        <div class="gets__copy">
          <h2 class="sec-title" data-fx>Ваша страница — как журнал</h2>
          <p class="gets__lead" data-fx>Мы собираем карточку так же бережно, как редакция собирает разворот. А дальше она работает на вас сама.</p>
          <ul class="gets__list">
            {gets.map((g, i) => (
              <li class="gets__item" data-fx style={`--d:${i}`}><Icon name="check" />{g}</li>
            ))}
          </ul>
        </div>
        <div class="phone" data-fx aria-hidden="true">
          <div class="phone__screen">
            <Image src={resolveImage('/specialists/fotografy/suhorada/gal/p03.webp')} alt="" widths={[...IMG_WIDTHS.card]} sizes="260px" class="phone__img" />
            <div class="phone__info">
              <span class="phone__name">Алексей Сухорада</span>
              <span class="phone__role">Фотограф · от 40 000 ₽</span>
              <span class="phone__chips"><span>Репортаж</span><span>Плёнка</span><span>Выезд</span></span>
            </div>
          </div>
          <span class="phone__heart"><Icon name="heart" /></span>
        </div>
      </div>
    </section>

    <!-- 6. Условия крупными цифрами -->
    <section class="terms" id="usloviya">
      <div class="container">
        <h2 class="sec-title" data-fx>Условия</h2>
        <dl class="terms__grid">
          {terms.map(([k, v], i) => (
            <div class="terms__item" data-fx style={`--d:${i}`}>
              <dt class="terms__num">{k}</dt>
              <dd class="terms__label">{v}</dd>
            </div>
          ))}
        </dl>
        <p class="terms__note" data-fx>Если появятся тарифы, объявим заранее. Всё, что вы разместили бесплатно, останется на сайте.</p>
      </div>
    </section>

    <!-- 7. Видеоинструкция. ЗАГЛУШКА: ролик снимаем с готового кабинета (STAGE2.md, неделя 6) -->
    <section class="vid container" id="video">
      <h2 class="sec-title" data-fx>Десять минут — и карточка готова</h2>
      <div class="vid__frame" data-fx>
        <Image src={resolveImage('/venues/forest-dew/s5-table.webp')} alt="" widths={[...IMG_WIDTHS.wide]} sizes="(min-width: 1024px) 900px, 100vw" class="vid__img" />
        <span class="vid__shade" aria-hidden="true"></span>
        <span class="vid__play" aria-hidden="true"><Icon name="play" /></span>
        <p class="vid__cap">Видеоинструкция появится к запуску</p>
      </div>
    </section>

    <!-- 8. Частые вопросы -->
    <section class="faq container">
      <h2 class="sec-title" data-fx>Частые вопросы</h2>
      <div class="faq__list">
        {faq.map((f) => (
          <details class="faq__item" data-fx>
            <summary class="faq__q">{f.q}<span class="faq__plus" aria-hidden="true"></span></summary>
            <p class="faq__a">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- 9. Финальный экран на кадре -->
    <section class="end">
      <Image src={resolveImage('/venues/led/s4-ceremony.webp')} alt="" widths={[...IMG_WIDTHS.hero]} sizes="100vw" class="end__img" />
      <span class="end__shade" aria-hidden="true"></span>
      <div class="end__body container">
        <h2 class="end__title" data-fx>Начните с карточки</h2>
        <p class="end__lead" data-fx>Регистрация занимает минуту: через Telegram или по почте.</p>
        <div class="hero__cta" data-fx>
          <a class="btn btn--light" href="/profi/registraciya/">Зарегистрироваться</a>
          <a class="btn btn--ghost" href="/profi/vhod/">У меня есть учётка</a>
        </div>
      </div>
    </section>
  </main>
</ProfiShell>

<script>
  // Появления и проявление фразы. Всё движение — только когда его можно:
  // без JS и с prefers-reduced-motion страница стоит целиком сразу.
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!calm) {
    document.documentElement.classList.add('fx');
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
      }),
      { rootMargin: '0px 0px -12% 0px' },
    );
    document.querySelectorAll('[data-fx]').forEach((el) => io.observe(el));

    // Фраза: слова набирают цвет по мере того, как блок проходит экран.
    const say = document.querySelector<HTMLElement>('[data-say]');
    const words = say ? [...say.querySelectorAll<HTMLElement>('.say__w')] : [];
    let ticking = false;
    const paint = () => {
      ticking = false;
      if (!say) return;
      const r = say.getBoundingClientRect();
      const vh = window.innerHeight;
      const p = Math.min(1, Math.max(0, (vh * 0.85 - r.top) / (r.height + vh * 0.35)));
      const lit = Math.round(p * words.length);
      words.forEach((w, i) => w.classList.toggle('is-lit', i < lit));
    };
    window.addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(paint); } }, { passive: true });
    paint();
  }
</script>

<style>
  /* Свои размеры и цвета витрины собраны здесь, из токенов сайта. */
  .promo {
    --hero-cycle: 24s;
    --run-speed: 60s;
    --shade: color-mix(in srgb, var(--black) 72%, transparent);
    --shade-soft: color-mix(in srgb, var(--black) 18%, transparent);
    overflow-x: clip;
  }

  .sec-title {
    font-size: clamp(42px, 11.5vw, 104px);
    line-height: 1;
    max-width: 12ch;
  }

  /* ---------- кнопки витрины ---------- */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 56px;
    padding: 0 var(--s-6);
    border-radius: var(--radius-pill);
    font-size: var(--fs-body);
    font-weight: var(--w-medium);
    text-decoration: none;
    transition: transform var(--dur-fast) var(--ease-out), background-color var(--dur-fast) var(--ease-out);
  }
  .btn--light { background: var(--white); color: var(--black); }
  .btn--ghost { color: var(--white); border: 1px solid color-mix(in srgb, var(--white) 60%, transparent); }
  .btn:active { transform: scale(0.97); }
  @media (hover: hover) {
    .btn--light:hover { transform: translateY(-2px); }
    .btn--ghost:hover { background: color-mix(in srgb, var(--white) 12%, transparent); }
  }

  /* ---------- 1. первый экран ---------- */
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: end;
    color: var(--white);
    background: var(--black);
    overflow: hidden;
  }
  .hero__stage, .hero__layer, .hero__shade { position: absolute; inset: 0; }
  .hero__layer {
    opacity: 0;
    animation: heroFade var(--hero-cycle) linear infinite;
    animation-delay: calc(var(--i) * var(--hero-cycle) / 4 - 0.01s);
  }
  .hero__layer:first-child { opacity: 1; }
  .hero__media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: heroZoom var(--hero-cycle) linear infinite;
    animation-delay: inherit;
  }
  /* Каждый кадр: 1/4 цикла на экране, мягкая смена через опасити. */
  @keyframes heroFade {
    0% { opacity: 0; }
    4% { opacity: 1; }
    25% { opacity: 1; }
    29% { opacity: 0; }
    100% { opacity: 0; }
  }
  @keyframes heroZoom {
    0% { transform: scale(1.12); }
    30% { transform: scale(1); }
    100% { transform: scale(1); }
  }
  .hero__shade {
    background: linear-gradient(to bottom, var(--shade-soft) 0%, transparent 30%, transparent 40%, var(--shade) 100%);
  }
  .hero__body {
    position: relative;
    z-index: 2;
    padding-bottom: calc(var(--s-8) + var(--s-4));
  }
  .hero__kicker {
    font-size: var(--fs-small);
    font-weight: var(--w-medium);
  }
  .hero__title {
    margin-top: var(--s-3);
    font-size: clamp(48px, 13vw, 128px);
    line-height: 0.98;
    font-weight: var(--w-head);
  }
  .line { display: block; overflow: hidden; padding-bottom: 0.06em; }
  .line > span { display: inline-block; }
  .hero__lead {
    margin-top: var(--s-5);
    max-width: 34ch;
    font-size: var(--fs-lead);
    line-height: var(--lh-snug);
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-6);
  }
  .hero__cue {
    position: absolute;
    left: 50%;
    bottom: var(--s-5);
    width: 1px;
    height: var(--s-7);
    background: var(--white);
    transform-origin: top;
    animation: cue 2.4s var(--ease-inout) infinite;
  }
  @keyframes cue {
    0% { transform: scaleY(0); opacity: 1; }
    60% { transform: scaleY(1); opacity: 1; }
    100% { transform: scaleY(1); opacity: 0; }
  }

  /* Заголовок первого экрана выезжает строками при загрузке. */
  :global(html.fx) .line > span { animation: lineUp 1.1s var(--ease-out) both; }
  :global(html.fx) .line:nth-child(2) > span { animation-delay: 0.12s; }
  :global(html.fx) .hero__kicker,
  :global(html.fx) .hero__lead,
  :global(html.fx) .hero__body .hero__cta { animation: rise 1s var(--ease-out) both; }
  :global(html.fx) .hero__lead { animation-delay: 0.35s; }
  :global(html.fx) .hero__body .hero__cta { animation-delay: 0.5s; }
  @keyframes lineUp { from { transform: translateY(105%); } to { transform: none; } }
  @keyframes rise { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: none; } }

  /* Общие появления блоков при прокрутке. */
  :global(html.fx) [data-fx] {
    opacity: 0;
    transform: translateY(32px);
    transition: opacity 0.9s var(--ease-out), transform 0.9s var(--ease-out);
    transition-delay: calc(var(--d, 0) * 70ms);
  }
