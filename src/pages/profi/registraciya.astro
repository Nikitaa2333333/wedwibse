---
// РЕГИСТРАЦИЯ ПОДРЯДЧИКА — прототип. Оферта и согласие на ПДн подписываются
// ЗДЕСЬ, до входа в кабинет (решение 16.10.2026, CABINET.md §16, §21): две
// отдельные галочки со ссылками на тексты, без обеих кнопки неактивны.
// Тексты пишет юрист — ссылки пока ведут на заглушку. Отправки нет.
import ProfiShell from '../../components/profi/ProfiShell.astro';
import TelegramButton from '../../components/profi/TelegramButton.astro';
import Icon from '../../components/Icon.astro';
---

<ProfiShell title="Регистрация" action={{ href: '/profi/vhod/', label: 'Войти' }}>
  <main class="section container auth" data-consent>
    <h1 class="t-h1">Регистрация</h1>
    <p class="auth__lead">Сначала условия — потом кабинет. Две отметки, и можно заводить карточку.</p>

    <div class="auth__checks">
      <label class="check">
        <input class="check__input" type="checkbox" data-consent-box />
        <span class="check__box"><Icon name="check" /></span>
        <span>Принимаю <a href="/profi/#usloviya">условия размещения (оферту)</a></span>
      </label>
      <label class="check">
        <input class="check__input" type="checkbox" data-consent-box />
        <span class="check__box"><Icon name="check" /></span>
        <span>Даю <a href="/profi/#usloviya">согласие на обработку персональных данных</a></span>
      </label>
    </div>

    <div class="auth__main" data-consent-gate aria-disabled="true">
      <TelegramButton label="Через Telegram" />
    </div>

    <p class="auth__or">или по почте</p>

    <form class="auth__form" action="/profi/kabinet/" method="get">
      <label class="field">
        <span class="field__label">Почта</span>
        <input class="input" type="email" name="email" autocomplete="email" placeholder="name@example.ru" />
        <span class="field__note">Пришлём код, чтобы подтвердить почту</span>
      </label>
      <label class="field">
        <span class="field__label">Пароль</span>
        <input class="input" type="password" name="password" autocomplete="new-password" />
        <span class="field__note">Не короче 8 знаков</span>
      </label>
      <button class="pill pill--lg pill--block" type="submit" data-consent-btn disabled>Зарегистрироваться</button>
    </form>

    <p class="auth__foot">Подпись фиксируется при регистрации: дата, время и устройство — так договор доказуем.</p>
  </main>
</ProfiShell>

<script>
  // Кнопки живут, только когда отмечены обе галочки. Без JS форма остаётся
  // заблокированной — это прототип, отправки всё равно нет.
  const root = document.querySelector('[data-consent]');
  if (root) {
    const boxes = [...root.querySelectorAll<HTMLInputElement>('[data-consent-box]')];
    const gate = root.querySelector<HTMLElement>('[data-consent-gate]');
    const btn = root.querySelector<HTMLButtonElement>('[data-consent-btn]');
    const sync = () => {
      const ok = boxes.every((b) => b.checked);
      if (btn) btn.disabled = !ok;
      gate?.setAttribute('aria-disabled', String(!ok));
    };
    boxes.forEach((b) => b.addEventListener('change', sync));
    sync();
  }
</script>

<style>
  .auth { max-width: 520px; padding-top: var(--s-4); }
  .auth__lead { margin-top: var(--s-4); }
  .auth__checks { display: grid; gap: var(--s-4); margin-top: var(--s-6); }
  .auth__main { margin-top: var(--s-6); transition: opacity var(--dur-fast) var(--ease-out); }
  .auth__main[aria-disabled='true'] { opacity: 0.35; pointer-events: none; }
  .auth__or { margin-top: var(--s-6); text-align: center; font-size: var(--fs-small); }
  .auth__form { display: grid; gap: var(--s-4); margin-top: var(--s-4); }
  .auth__foot { margin-top: var(--s-7); font-size: var(--fs-small); }
</style>
