---
// СВЕРКА С ТАБЛИЦЕЙ — утренний отчёт registry-nightly (таблица модератора
// «реестр каталога» ↔ карточки на сайте) прямо в админке, а не в логах
// GitHub. Данные — отчёт за 24.10.2026 (SYNC_REPORT); вживую — последний
// прогон, сохранённый сверкой в базу.
import AdminShell from '../../../components/admin/AdminShell.astro';
import AdminIcon from '../../../components/admin/AdminIcon.astro';
import { SYNC_REPORT } from '../../../data/admin-demo';

const SHEET = 'https://docs.google.com/spreadsheets/d/1J8U7oLfBSenFn7VKWL7gp1EfNfH8lFCV3THmpH8eiA8';
---

<AdminShell title="Сверка с таблицей" section="sync">
  <div class="a-title">
    <h1 class="a-h1">Сверка с таблицей реестра</h1>
    <div class="a-title__actions">
      <a class="a-btn" href={SHEET} target="_blank" rel="noopener"><AdminIcon name="external" /> Открыть таблицу</a>
      <button class="a-btn a-btn--primary" type="button"><AdminIcon name="sync" /> Сверить сейчас</button>
    </div>
    <p class="a-lead sv__lead">Каждое утро в 07:00 сверяем таблицу модератора с сайтом. Последняя сверка — {SYNC_REPORT.at}.</p>
  </div>

  <section class="a-card">
    <div class="a-stats" style="--cols: 3">
      <div class="a-stat"><span class="a-stat__label"><span class="a-dot a-dot--info"></span>Новые в таблице</span><span class="a-stat__num">{SYNC_REPORT.newInSheet.length}</span></div>
      <div class="a-stat"><span class="a-stat__label"><span class="a-dot a-dot--warn"></span>Разошлось с сайтом</span><span class="a-stat__num">{SYNC_REPORT.diffs.length}</span></div>
      <div class="a-stat"><span class="a-stat__label"><span class="a-dot a-dot--bad"></span>Проблемы со ссылками</span><span class="a-stat__num">{SYNC_REPORT.links.length}</span></div>
    </div>
  </section>

  <section class="a-card a-card--flush">
    <div class="a-card__head"><h2 class="a-h2">Новые в таблице</h2></div>
    <table class="a-table a-table--cards">
      <thead><tr><th>Название</th><th>Категория</th><th>Что с ней</th></tr></thead>
      <tbody>
        {SYNC_REPORT.newInSheet.map((r) => (
          <tr><td class="a-name">{r.name}</td><td data-l="Категория">{r.cat}</td><td>{r.state}</td></tr>
        ))}
      </tbody>
    </table>
  </section>

  <section class="a-card a-card--flush">
    <div class="a-card__head"><h2 class="a-h2">Разошлось с сайтом</h2><span class="a-lead">решить, что верно — таблица или страница</span></div>
    <table class="a-table a-table--cards">
      <thead><tr><th>Карточка</th><th>Поле</th><th>В таблице</th><th>На сайте</th></tr></thead>
      <tbody>
        {SYNC_REPORT.diffs.map((r) => (
          <tr><td class="a-name">{r.name}</td><td data-l="Поле">{r.field}</td><td data-l="В таблице">{r.sheet}</td><td data-l="На сайте">{r.site}</td></tr>
        ))}
      </tbody>
    </table>
  </section>

  <section class="a-card a-card--flush">
    <div class="a-card__head"><h2 class="a-h2">Ссылки</h2></div>
    <table class="a-table a-table--cards">
      <thead><tr><th>Карточка</th><th>Проблема</th></tr></thead>
      <tbody>
        {SYNC_REPORT.links.map((r) => (
          <tr><td class="a-name">{r.name}</td><td><span class="a-dot a-dot--bad">{r.problem}</span></td></tr>
        ))}
      </tbody>
    </table>
  </section>
</AdminShell>

<style>
  .sv__lead { width: 100%; }
</style>
