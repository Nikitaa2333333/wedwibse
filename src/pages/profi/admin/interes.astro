---
// ИНТЕРЕС — журнал второго этапа без денег (STAGE2.md §1): просмотры,
// сохранения и открытия контактов по каждой карточке. Открытия считает наш
// сервер, не Метрика (CABINET.md §18) — это будущая база для оплаты.
// Карточки НАСТОЯЩИЕ, числа — ЗАГЛУШКА (INTEREST в lib/admin-catalog.ts).
import AdminShell from '../../../components/admin/AdminShell.astro';
import AdminIcon from '../../../components/admin/AdminIcon.astro';
import { CATALOG, INTEREST } from '../../../lib/admin-catalog';

const rows = INTEREST.map((i) => ({ ...i, c: CATALOG.find((c) => c.key === i.key)! }))
  .sort((a, b) => b.opens - a.opens);
const sum = (k: 'views' | 'saves' | 'opens' | 'prevOpens') => rows.reduce((s, r) => s + r[k], 0);
const conv = (o: number, v: number) => (v ? ((o / v) * 100).toFixed(1).replace('.', ',') : '0');
const delta = (r: { opens: number; prevOpens: number }) => r.opens - r.prevOpens;
---

<AdminShell title="Интерес" section="interest">
  <div class="a-bar">
    <div class="a-seg" data-seg>
      {['Сегодня', 'Вчера', 'Неделя', 'Месяц', 'Квартал'].map((p) => (
        <button class:list={['a-seg__btn', { 'is-active': p === 'Неделя' }]} type="button">{p}</button>
      ))}
    </div>
    <span class="a-btn a-btn--soft">18 — 24 окт <AdminIcon name="down" /></span>
  </div>

  <div class="a-title">
    <h1 class="a-h1">Интерес к карточкам</h1>
    <p class="a-lead">Сколько раз карточку открыли, сохранили и открыли контакты. Подрядчик видит то же про себя в кабинете.</p>
  </div>

  <section class="a-card">
    <div class="a-stats">
      <div class="a-stat"><span class="a-stat__label">Просмотры</span><span class="a-stat__num">{sum('views').toLocaleString('ru-RU')}</span><span class="a-stat__delta a-up">+12 %</span></div>
      <div class="a-stat"><span class="a-stat__label">В избранном</span><span class="a-stat__num">{sum('saves')}</span><span class="a-stat__delta a-up">+8 %</span></div>
      <div class="a-stat"><span class="a-stat__label">Открытия контактов</span><span class="a-stat__num">{sum('opens')}</span><span class:list={['a-stat__delta', sum('opens') >= sum('prevOpens') ? 'a-up' : 'a-down']}>{sum('opens') - sum('prevOpens') >= 0 ? '+' : ''}{sum('opens') - sum('prevOpens')} к прошлой неделе</span></div>
      <div class="a-stat"><span class="a-stat__label">Конверсия в контакт</span><span class="a-stat__num">{conv(sum('opens'), sum('views'))} %</span></div>
    </div>
  </section>

  <nav class="a-tabs" aria-label="Вид карточек">
    <a class="a-tabs__item is-active" href="#" data-filter-tab="in" data-value="all">Все</a>
    <a class="a-tabs__item" href="#" data-filter-tab="in" data-value="venue">Площадки</a>
    <a class="a-tabs__item" href="#" data-filter-tab="in" data-value="specialist">Подрядчики</a>
  </nav>

  <section class="a-card a-card--flush">
    <div class="a-table-wrap">
      <table class="a-table a-table--cards" id="in" data-atable>
        <thead>
          <tr>
            <th data-sort="asc">Карточка</th>
            <th class="a-num" data-sort="desc">Просмотры</th>
            <th class="a-num" data-sort="desc">В избранном</th>
            <th class="a-num is-sorted" data-sort="desc">Контакты</th>
            <th class="a-num" data-sort="desc">Конверсия</th>
          </tr>
        </thead>
        <tbody>
          <tr class="a-total">
            <td>Итого и средние</td>
            <td class="a-num">{sum('views').toLocaleString('ru-RU')}</td>
            <td class="a-num">{sum('saves')}</td>
            <td class="a-num">{sum('opens')}</td>
            <td class="a-num">{conv(sum('opens'), sum('views'))} %</td>
          </tr>
          {rows.map((r) => (
            <tr data-tab={r.c.kind} data-text={r.c.name.toLowerCase()}>
              <td data-v={r.c.name}><a class="a-name" href={r.c.url} target="_blank" rel="noopener">{r.c.name}</a><span class="a-sub">{r.c.category}</span></td>
              <td class="a-num" data-v={r.views} data-l="Просмотры">{r.views.toLocaleString('ru-RU')}</td>
              <td class="a-num" data-v={r.saves} data-l="В избранном">{r.saves}</td>
              <td class="a-num" data-v={r.opens} data-l="Контакты">
                {r.opens}
                <span class:list={['a-sub', delta(r) >= 0 ? 'a-up' : 'a-down']}>{delta(r) >= 0 ? '+' : ''}{delta(r)}</span>
              </td>
              <td class="a-num" data-v={r.views ? r.opens / r.views : 0} data-l="Конверсия">{conv(r.opens, r.views)} %</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</AdminShell>
