---
// ПИЛОТ — существующие карточки владельцам по личной ссылке (CABINET.md
// §19, §22; решение 20.10: ссылки отправляем сами, почты владельцев не
// собираем). Сверху — воронка шагов (как ряд показателей Метрики), ниже —
// таблица карточек с шагом и кнопкой «Скопировать ссылку». Карточки
// НАСТОЯЩИЕ, шаги — заглушка PILOT; вживую ссылка — одноразовый токен
// в базе, привязка учётки к карточке — при входе по нему.
import { Image } from 'astro:assets';
import AdminShell from '../../../components/admin/AdminShell.astro';
import AdminIcon from '../../../components/admin/AdminIcon.astro';
import { resolveImage, IMG_WIDTHS } from '../../../lib/images';
import { CATALOG } from '../../../lib/admin-catalog';
import { PILOT, PILOT_STEP, type PilotStep } from '../../../data/admin-demo';

const rows = CATALOG.map((c) => ({ ...c, p: PILOT[c.key] ?? { step: 'none' as PilotStep } }));
const steps: PilotStep[] = ['none', 'sent', 'entered', 'filling', 'sent_review', 'published'];
const count = (s: PilotStep) => rows.filter((r) => r.p.step === s).length;
const DOT: Record<PilotStep, string> = { none: '', sent: 'info', entered: 'info', filling: 'warn', sent_review: 'warn', published: 'ok' };
// ЗАГЛУШКА токена: вживую — одноразовый, из базы
const token = (key: string) => [...key].reduce((h, ch) => (h * 33 + ch.charCodeAt(0)) >>> 0, 5381).toString(36);
---

<AdminShell title="Пилот" section="pilot">
  <div class="a-title">
    <h1 class="a-h1">Пилот: карточки владельцам</h1>
    <p class="a-lead">Ссылку копируем и отправляем владельцу сами — в Telegram, MAX или как удобно. По ней он входит, и карточка привязывается к его учётке.</p>
  </div>

  <section class="a-card">
    <div class="a-stats" style="--cols: 6">
      {steps.map((s) => (
        <div class="a-stat">
          <span class="a-stat__label">{DOT[s] ? <span class={`a-dot a-dot--${DOT[s]}`}></span> : <span class="a-dot"></span>}{PILOT_STEP[s].label}</span>
          <span class="a-stat__num">{count(s)}</span>
        </div>
      ))}
    </div>
  </section>

  <nav class="a-tabs" aria-label="Шаги">
    <a class="a-tabs__item is-active" href="#" data-filter-tab="pl" data-value="all">Все <span class="a-tabs__n">{rows.length}</span></a>
    <a class="a-tabs__item" href="#" data-filter-tab="pl" data-value="none">Не выдана <span class="a-tabs__n">{count('none')}</span></a>
    <a class="a-tabs__item" href="#" data-filter-tab="pl" data-value="active">В процессе <span class="a-tabs__n">{rows.length - count('none') - count('published')}</span></a>
    <a class="a-tabs__item" href="#" data-filter-tab="pl" data-value="published">Ведут сами <span class="a-tabs__n">{count('published')}</span></a>
  </nav>

  <section class="a-card a-card--flush">
    <div class="a-card__head">
      <label class="a-search">
        <span class="visually-hidden">Поиск</span>
        <input class="a-input" type="search" placeholder="Название" data-filter-search="pl" />
        <AdminIcon name="search" />
      </label>
    </div>
    <div class="a-table-wrap">
      <table class="a-table a-table--cards" id="pl" data-atable>
        <thead>
          <tr>
            <th data-sort="asc">Карточка</th>
            <th>Шаг</th>
            <th>Вход</th>
            <th>Личная ссылка</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => {
            const link = `https://profi.wed-secrets.ru/v/${token(r.key)}`;
            const tab = r.p.step === 'none' ? 'none' : r.p.step === 'published' ? 'published' : 'active';
            return (
              <tr data-tab={tab} data-text={r.name.toLowerCase()}>
                <td data-v={r.name}>
                  <div class="a-who">
                    {r.cover && <Image src={resolveImage(r.cover)} alt="" widths={[...IMG_WIDTHS.thumb]} sizes="40px" class="a-thumb" />}
                    <div>
                      <a class="a-name" href={r.url} target="_blank" rel="noopener">{r.name}</a>
                      <span class="a-sub">{r.category}</span>
                    </div>
                  </div>
                </td>
                <td>
                  <span class={`a-dot ${DOT[r.p.step] ? `a-dot--${DOT[r.p.step]}` : ''}`}>{PILOT_STEP[r.p.step].label}</span>
                  {r.p.at && <span class="a-sub">с {r.p.at}</span>}
                </td>
                <td data-l="Вход">{r.p.via ?? '—'}</td>
                <td>
                  {r.p.step === 'none' ? (
                    <button class="a-btn" type="button" data-issue={link}><AdminIcon name="link" /> Выдать ссылку</button>
                  ) : (
                    <button class="a-btn a-btn--soft" type="button" data-copy={link}><AdminIcon name="link" /> Скопировать</button>
                  )}
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
      <div class="a-empty" data-empty="pl" hidden><p>Ничего не нашлось</p></div>
    </div>
  </section>

  <div class="a-toast" data-toast hidden role="status"><span data-toast-text></span></div>
</AdminShell>

<script>
  // ПРОТОТИП: «Выдать» создаёт ссылку (вживую — токен в базе) и копирует её;
  // отправляет владельцу сам модератор, сайт ничего никому не шлёт.
  const toast = document.querySelector<HTMLElement>('[data-toast]');
  let t = 0;
  const say = (msg: string) => {
    if (!toast) return;
    toast.querySelector('[data-toast-text]')!.textContent = msg;
    toast.hidden = false;
    clearTimeout(t);
    t = window.setTimeout(() => (toast.hidden = true), 3500);
  };
  const copy = async (link: string) => {
    try { await navigator.clipboard.writeText(link); say(`Ссылка скопирована: ${link}`); }
    catch { say(link); }
  };
  document.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-copy], [data-issue]');
    if (!b) return;
    const link = (b.dataset.copy ?? b.dataset.issue)!;
    if (b.dataset.issue) {
      const row = b.closest('tr')!;
      const cell = row.cells[1];
      cell.innerHTML = '<span class="a-dot a-dot--info">Ссылка выдана</span><span class="a-sub">сегодня</span>';
      b.removeAttribute('data-issue');
      b.dataset.copy = link;
      b.classList.add('a-btn--soft');
      b.lastChild!.textContent = ' Скопировать';
    }
    copy(link);
  });
</script>
