---
// СТАТИСТИКА ПЛАТФОРМЫ — раздел админки (14.11.2026, задание Евгения 09.11,
// docs/cabinet/STATS.md): «понимать результативность платформы и её
// востребованность у партнёров». Сверху — те же строки, что у подрядчика,
// по всем опубликованным карточкам; ниже — категории: переходы, избранное,
// заявки за период; нажатие раскрывает карточки категории (спрос на подрядчиков).
// Данные — /api/wed/mod/stats (lib/stats.js).
import AdminShell from '../../../../components/admin/AdminShell.astro';
import { SPECIALIST_CATEGORIES } from '../../../../data/specialists';

const CATS = [{ slug: 'ploshchadki', label: 'Площадки' }, ...SPECIALIST_CATEGORIES.map((c) => ({ slug: c.slug, label: c.label }))];
---

<AdminShell title="Статистика" section="stats">
  <div class="a-title"><h1 class="a-h1">Статистика</h1></div>
  <div class="a-seg" role="group" aria-label="Период" data-period>
    <button class="a-seg__btn" type="button" data-days="7" aria-pressed="false">7 дней</button>
    <button class="a-seg__btn" type="button" data-days="30" aria-pressed="true">30 дней</button>
    <button class="a-seg__btn" type="button" data-days="90" aria-pressed="false">90 дней</button>
  </div>
  <div class="st-admin" data-box data-cats={JSON.stringify(CATS)} aria-busy="true">
    <p>Загружаем…</p>
  </div>
</AdminShell>

<style>
  .st-admin { display: grid; gap: var(--s-5); margin-top: var(--s-4); max-width: 820px; }
  /* категории: строка — название и три числа; раскрывается до карточек */
  :global(.st-cats) { background: var(--adm-card); border-radius: var(--cab-sheet-radius); overflow: hidden; }
  :global(.st-cats__head),
  :global(.st-cat > summary),
  :global(.st-cat__card) { display: grid; grid-template-columns: minmax(0, 1fr) repeat(3, 76px); align-items: center; gap: 8px; padding: 12px 18px; }
  :global(.st-cats__head) { font-size: var(--adm-fs-sm); border-bottom: 1px solid var(--adm-line); }
  :global(.st-cats__head span:not(:first-child)),
  :global(.st-n) { text-align: right; font-variant-numeric: tabular-nums; }
  :global(.st-cat) { border-bottom: 1px solid var(--adm-line); }
  :global(.st-cat:last-child) { border-bottom: 0; }
  :global(.st-cat > summary) { list-style: none; cursor: pointer; font-weight: 600; }
  :global(.st-cat > summary::-webkit-details-marker) { display: none; }
  @media (hover: hover) { :global(.st-cat > summary:hover) { background: var(--adm-hover); } }
  :global(.st-cat__card) { font-size: var(--adm-fs); padding-left: 32px; }
  :global(.st-cat__card a) { color: inherit; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  :global(.st-cat__list) { padding-bottom: 8px; }
  @media (max-width: 520px) {
    :global(.st-cats__head),
    :global(.st-cat > summary),
    :global(.st-cat__card) { grid-template-columns: minmax(0, 1fr) repeat(3, 52px); padding-inline: 14px; }
    :global(.st-cat__card) { padding-left: 24px; }
  }
</style>

<script>
  import { api, esc, errText, requireSession } from '../../../../lib/cabinet-api';
  import { statRow, sumSeries, visitorsTotal, sources, sourcesBlock, bindRows, type StatsData, type CardSeries } from '../../../../lib/stats-ui';
  import { plural } from '../../../../lib/plural';

  document.addEventListener('astro:page-load', () => {
  const box = document.querySelector<HTMLElement>('[data-box]');
  if (!box || box.dataset.live || !requireSession('moderator')) return;
  box.dataset.live = '1';
  const period = document.querySelector<HTMLElement>('[data-period]')!;
  const CATS: { slug: string; label: string }[] = JSON.parse(box.dataset.cats!);
  const label = (slug: string) => CATS.find((c) => c.slug === slug)?.label ?? slug;
  const NF = new Intl.NumberFormat('ru-RU');
  const total = (a: (number | null)[]) => a.reduce<number>((s, v) => s + (v ?? 0), 0);
  let days = 30;

  function catTable(data: StatsData): string {
    const groups = new Map<string, CardSeries[]>();
    for (const c of data.cards) groups.set(c.categorySlug, [...(groups.get(c.categorySlug) ?? []), c]);
    const rows = [...groups.entries()].map(([slug, cards]) => {
      const t = (c: CardSeries) => ({ v: total(c.views), f: total(c.favs), l: total(c.leads) });
      const sum = cards.map(t).reduce((a, b) => ({ v: a.v + b.v, f: a.f + b.f, l: a.l + b.l }), { v: 0, f: 0, l: 0 });
      return { slug, cards: cards.map((c) => ({ c, ...t(c) })).sort((a, b) => b.v - a.v || b.l - a.l), ...sum };
    }).sort((a, b) => b.v - a.v || b.l - a.l);
    return `
      <section class="st-cats">
        <div class="st-cats__head"><span>Категория</span><span>Переходы</span><span>Избранное</span><span>Заявки</span></div>
        ${rows.map((g) => `
          <details class="st-cat">
            <summary><span>${esc(label(g.slug))} <span class="st-cat__k">(${g.cards.length})</span></span><span class="st-n">${NF.format(g.v)}</span><span class="st-n">${NF.format(g.f)}</span><span class="st-n">${NF.format(g.l)}</span></summary>
            <div class="st-cat__list">
              ${g.cards.map((x) => `<div class="st-cat__card"><a href="${x.c.url}" target="_blank" rel="noopener">${esc(x.c.name)}</a><span class="st-n">${NF.format(x.v)}</span><span class="st-n">${NF.format(x.f)}</span><span class="st-n">${NF.format(x.l)}</span></div>`).join('')}
            </div>
          </details>`).join('')}
      </section>`;
  }

  async function load() {
    const data = await api<StatsData>('moderator', 'GET', `/api/wed/mod/stats?days=${days}`);
    const v = visitorsTotal(data, data.cards);
    box.innerHTML = `
      <div class="st-card">
        ${statRow('views', sumSeries(data, data.cards, 'views'), data, v ? `${NF.format(v)} ${plural(v, ['посетитель', 'посетителя', 'посетителей'])} карточек` : '')}
        ${statRow('favs', sumSeries(data, data.cards, 'favs'), data)}
        ${statRow('leads', sumSeries(data, data.cards, 'leads'), data)}
      </div>
      <h2 class="st-h">По категориям</h2>
      ${catTable(data)}
      ${sourcesBlock(sources(data.cards))}`;
    box.removeAttribute('aria-busy');
    bindRows(box);
  }

  period.addEventListener('click', (ev) => {
    const b = (ev.target as HTMLElement).closest<HTMLButtonElement>('[data-days]');
    if (!b) return;
    days = Number(b.dataset.days);
    period.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    box.setAttribute('aria-busy', 'true');
    load().catch(fail);
  });

  function fail(err: unknown) {
    box.innerHTML = `<p>${esc(errText(err))} <button class="a-btn a-btn--sm" type="button" data-retry>Повторить</button></p>`;
    box.querySelector('[data-retry]')?.addEventListener('click', () => load().catch(fail));
  }

  load().catch(fail);
  });
</script>
