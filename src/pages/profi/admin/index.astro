---
// СВОДКА — первый экран админки: что сделать (действия со сроком), под
// ними новые заявки задачами, внизу строкой — сколько карточек на сайте.
// Всё настоящее (05.11.2026): действия и заявки — из базы (lib/admin-live.ts),
// цифры по карточкам — по каталогу сайта. Демо-примеров нет: пусто — так
// и пишем «Задач нет».
import AdminShell from '../../../components/admin/AdminShell.astro';
---

<AdminShell title="Сводка" section="overview">
  {/* учётка — кружком справа в шапке (телефон), выход — внутри окна учётки,
      как у Apple; кнопки «Выйти» на главном экране нет (Никита 05.11) */}
  <div class="a-title a-title--acc"><h1 class="a-h1">Сводка</h1><button class="a-acc" type="button" data-adm-account aria-label="Учётка" hidden></button></div>

  <section class="a-acts" aria-label="Что сделать" data-ov-acts>
    <div class="sk-card a-card a-card--flush" aria-busy="true" aria-label="Загружаем"><div class="sk-row"><span class="sk sk--thumb"></span><span class="sk-row__body"><span class="sk sk--line"></span><span class="sk sk--line sk--short"></span></span><span class="sk sk--pill"></span></div><div class="sk-row"><span class="sk sk--thumb"></span><span class="sk-row__body"><span class="sk sk--line"></span><span class="sk sk--line sk--short"></span></span><span class="sk sk--pill"></span></div><div class="sk-row"><span class="sk sk--thumb"></span><span class="sk-row__body"><span class="sk sk--line"></span><span class="sk sk--line sk--short"></span></span><span class="sk sk--pill"></span></div></div>
  </section>

  {/* Два списка по смыслу (Никита 07.11): что ждёт модератора (срок проверки) и кому написать
      (давно не трогали). Тех, кто заполняет прямо сейчас, в сводке нет — они в «Заявках». */}
  <section class="a-card a-card--flush">
    <div class="a-card__head">
      <h2 class="a-h2">Ждут проверки</h2>
    </div>
    <div class="a-tasks" data-ov-fresh></div>
  </section>
  <section class="a-card a-card--flush" data-ov-stale-box hidden>
    <div class="a-card__head">
      <h2 class="a-h2">Можно написать</h2>
      <a class="a-more" href="/profi/admin/zayavki/#draft">Все</a>
    </div>
    <div class="a-tasks" data-ov-stale></div>
  </section>

</AdminShell>

<script>
  import { requireSession, errText, esc, saveSession } from '../../../lib/cabinet-api';
  import { openDialog } from '../../../lib/cab-ui';
  import { loadRevisions, counts, leftMin, leftText, taskRow, failBox, URGENT_MIN, DEADLINE_MIN, idleDays, STALE_DAYS } from '../../../lib/admin-live';
  import { ADMIN_ICONS } from '../../../lib/admin-icons';
  import { loadLeads, newCount, sendCount, at } from '../../../lib/admin-leads';

  const ic = (name: keyof typeof ADMIN_ICONS, cls: string) => `<svg class="${cls}" viewBox="0 0 24 24" aria-hidden="true">${ADMIN_ICONS[name]}</svg>`;

  // Сводка: плитки «что ждёт» с числом и ближайшим сроком (мало времени — красным), ниже новые заявки
  async function render(force = false) {
    const acts = document.querySelector<HTMLElement>('[data-ov-acts]');
    const fresh = document.querySelector<HTMLElement>('[data-ov-fresh]');
    if (!acts || !fresh) return;
    try {
      // заявки пар — отдельным запросом; не загрузились — плитка «нет данных», сводка не падает
      const [revs, leads] = await Promise.all([loadRevisions(force), loadLeads(force).catch(() => null)]);
      const c = counts(revs);
      const soon = (rs: any[]) => {
        const xs = rs.map(leftMin).filter((x): x is number => x !== undefined);
        return xs.length ? Math.min(...xs) : undefined;
      };
      const nNew = c.newReview.length, nEdit = c.editReview.length, nDraft = c.drafts.length;
      const stale = c.drafts.filter((r: any) => idleDays(r) >= STALE_DAYS).sort((a: any, b: any) => idleDays(b) - idleDays(a));
      // плитки 2×2 как в Напоминаниях Apple: значок, крупное число, подпись (Никита 05.11)
      const tiles = [
        // цвет значка — смысл, как у статусов (Никита 06.11, 07.11): проверить — синий, не закончены — серый,
        // жалобы — красный; пусто (0) — серый, чтобы цвет звал только туда, где есть дело
        { n: nNew, label: 'Новые карточки', left: soon(c.newReview), href: '/profi/admin/zayavki/#review', icon: 'partners', tone: 'info' },
        { n: nEdit, label: 'Правки', left: soon(c.editReview), href: '/profi/admin/moderaciya/', icon: 'moderation', tone: 'info' },
        // кому написать: незаконченные, которые давно не трогали (07.11); заполняющих сейчас не считаем
        { n: stale.length, label: 'Можно написать', href: '/profi/admin/zayavki/#draft', icon: 'catalog', tone: 'none', note: nDraft > stale.length ? `ещё ${nDraft - stale.length} ${nDraft - stale.length === 1 ? 'заполняет' : 'заполняют'}` : '' },
        { n: 0, label: 'Жалобы', href: '/profi/admin/zhaloby/', icon: 'complaints', tone: 'bad' },
      ] as { n: number | null; label: string; left?: number; href: string; icon: keyof typeof ADMIN_ICONS; tone: string; note?: string; wide?: boolean }[];
      // заявки пар (07.11, docs/cabinet/LEADS-ADMIN.md): сколько новых, ниже — сколько пришло сегодня
      const day0 = new Date(); day0.setHours(0, 0, 0, 0);
      const today = leads ? sendCount(leads.filter((l) => l.status !== 'spam' && at(l.created) >= day0.getTime())) : 0;
      tiles.unshift({ n: leads ? newCount(leads) : null, label: 'Заявки пар', href: '/profi/admin/zayavki-par/#new', icon: 'leads', tone: 'info', wide: true,
        note: !leads ? 'нет данных' : today ? `${today} сегодня` : 'сегодня не было' });
      // плитки стоят всегда (ноль — тоже ответ), как смарт-списки в Напоминаниях
      acts.innerHTML = `<div class="a-tiles">${tiles.map((t) => {
            const urgent = (t.left ?? DEADLINE_MIN) < URGENT_MIN;
            const note = t.left !== undefined ? leftText(t.left) : t.note ?? '';
            return `<a class="a-tile${t.n ? ` a-tile--${t.tone}` : ''}${t.wide ? ' a-tile--wide' : ''}" href="${t.href}"><span class="a-tile__ic">${ic(t.icon, '')}</span><b class="a-tile__n">${t.n ?? '—'}</b><span class="a-tile__label">${t.label}</span>${note ? `<span class="a-tile__note${urgent ? ' a-tile__note--urgent' : ''}">${note}</span>` : ''}</a>`;
          }).join('')}</div>`;
      // ждут проверки: новые карточки и правки вместе, по сроку — у всех «осталось N ч»
      const review = [...c.newReview, ...c.editReview].sort((a, b) => (leftMin(a) ?? 0) - (leftMin(b) ?? 0));
      fresh.innerHTML = review.map((r) => taskRow(r, { task: 'Проверить', tone: 'check' })).join('') || '<p class="a-empty">Проверять нечего. Карточки и правки появятся здесь, когда подрядчик отправит их на проверку</p>';
      // можно написать: давно не трогали — у всех «N дней без правок»
      const staleBox = document.querySelector<HTMLElement>('[data-ov-stale-box]');
      const staleList = document.querySelector<HTMLElement>('[data-ov-stale]');
      if (staleBox && staleList) {
        staleBox.hidden = !stale.length;
        staleList.innerHTML = stale.map((r) => taskRow(r, { task: 'Не закончена', tone: 'wait', fill: true })).join('');
      }
    } catch (err) {
      acts.innerHTML = failBox(`Не загрузилось. ${errText(err)}`);
      fresh.innerHTML = '';
    }
  }

  document.addEventListener('astro:page-load', () => {
    const acts = document.querySelector<HTMLElement>('[data-ov-acts]');
    const s = acts ? requireSession('moderator') : null;
    if (!acts || !s) return;
    // кружок учётки → окно: имя, почта, «Выйти из админки»
    const acc = document.querySelector<HTMLButtonElement>('[data-adm-account]');
    if (acc) {
      const name = String(s.record.name || s.record.email || 'Модератор');
      acc.textContent = name.slice(0, 1).toUpperCase();
      acc.hidden = false;
      acc.onclick = () => {
        const { dlg } = openDialog({ cls: 'c-alert', html: `<div class="c-dialog__body">
          <span class="a-acc a-acc--lg" aria-hidden="true">${esc(name.slice(0, 1).toUpperCase())}</span>
          <h2 class="a-h2">${esc(name)}</h2>
          ${s.record.email ? `<p>${esc(s.record.email)}</p>` : ''}
          <div class="c-alert__acts"><button class="a-btn a-btn--lg a-btn--logout" type="button" data-out>Выйти из админки</button><button class="a-btn a-btn--lg" type="button" data-close>Закрыть</button></div>
        </div>` });
        dlg.querySelector('[data-out]')!.addEventListener('click', () => { saveSession('moderator', null); location.href = '/profi/admin/vhod/'; });
      };
    }
    acts.onclick = (e) => { if ((e.target as HTMLElement).closest('[data-retry]')) render(true); };
    render();
  });
</script>
