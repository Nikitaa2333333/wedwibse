---
// СВОДКА — первый экран админки. Сверху — виджеты: узкие высокие плитки со
// значком и крупной цифрой, каждая ведёт в свой раздел. Под ними главное
// (Никита, 24.10.2026) — новые заявки партнёров: чью анкету проверить и кто
// бросил анкету на середине (им звоним или пишем).
// Только то, что будет настоящим: заявки, правки и жалобы придут из базы
// (сейчас — примеры), цифры по карточкам — по настоящему каталогу.
import AdminShell from '../../../components/admin/AdminShell.astro';
import AdminIcon from '../../../components/admin/AdminIcon.astro';
import type { AdminIconName } from '../../../lib/admin-icons';
import { CATALOG, GAPS } from '../../../lib/admin-catalog';
import { plural } from '../../../lib/moderation';
import { DEMO_REVISIONS } from '../../../data/moderation-demo';
import { COMPLAINTS } from '../../../data/admin-demo';
import { APP_STATUS, PARTNER_APPS } from '../../../data/partner-demo';

const review = PARTNER_APPS.filter((a) => a.status === 'review');
const drafts = PARTNER_APPS.filter((a) => a.status === 'draft');
const fresh = [...review, ...drafts];
const edits = DEMO_REVISIONS.filter((r) => r.state === 'review').length;
const complaints = COMPLAINTS.filter((c) => c.status === 'new').length;

const widgets: { n: number; label: string; note: string; href: string; icon: AdminIconName; tone: string }[] = [
  { n: review.length, label: plural(review.length, 'анкету проверить', 'анкеты проверить', 'анкет проверить'), note: 'новые партнёры, срок 24 ч', href: '/profi/admin/zayavki/#review', icon: 'partners', tone: 'blue' },
  { n: drafts.length, label: 'не закончили анкету', note: 'позвонить или написать', href: '/profi/admin/zayavki/#draft', icon: 'clock', tone: 'orange' },
  { n: edits, label: plural(edits, 'правка карточки', 'правки карточек', 'правок карточек'), note: plural(edits, 'ждёт проверки', 'ждут проверки', 'ждут проверки'), href: '/profi/admin/moderaciya/', icon: 'moderation', tone: 'violet' },
  { n: complaints, label: plural(complaints, 'новая жалоба', 'новые жалобы', 'новых жалоб'), note: 'на карточки', href: '/profi/admin/zhaloby/', icon: 'complaints', tone: 'red' },
  { n: CATALOG.length, label: 'карточек на сайте', note: `${CATALOG.filter((c) => c.kind === 'venue').length} площадок, ${CATALOG.filter((c) => c.kind === 'specialist').length} подрядчиков`, href: '/profi/admin/katalog/', icon: 'cards', tone: 'green' },
  { n: GAPS.noContacts.length, label: 'карточек без контактов', note: 'паре нечего показать', href: '/profi/admin/katalog/#nocontacts', icon: 'noContacts', tone: 'red' },
];
---

<AdminShell title="Сводка" section="overview">
  <div class="a-title"><h1 class="a-h1">Сводка</h1></div>

  <section class="a-widgets" aria-label="Коротко">
    {widgets.map((w) => (
      <a class={`a-widget a-widget--${w.tone}`} href={w.href}>
        <span class="a-widget__ic"><AdminIcon name={w.icon} /></span>
        <span class="a-widget__n">{w.n}</span>
        <span class="a-widget__label">{w.label}</span>
        <span class="a-widget__note">{w.note}</span>
      </a>
    ))}
  </section>

  <section class="a-card a-card--flush ov-new">
    <div class="a-card__head">
      <div>
        <h2 class="ov-new__title">Новые заявки</h2>
        <p class="a-lead">Подрядчики и площадки, которые хотят на сайт: чью анкету проверить и кто не закончил.</p>
      </div>
      <a class="a-more" href="/profi/admin/zayavki/">Все заявки</a>
    </div>
    <table class="a-table a-table--cards">
      <tbody>
        {fresh.map((a) => {
          const href = `/profi/admin/zayavki/${a.id}/`;
          const st = APP_STATUS[a.status];
          const missing = a.sections.filter((s) => !s.done);
          return (
            <tr data-href={href}>
              <td>
                <a class="a-name ov-new__name" href={href}>{a.name}</a>
                <span class="a-sub">{a.category} · {a.lastEdit}</span>
              </td>
              <td><span class={`a-dot a-dot--${st.dot}`}>{st.label}</span></td>
              <td>
                {missing.length
                  ? <div class="a-chips">{missing.map((s) => <span class="a-chip a-chip--bad"><b>{s.label}:</b> {s.state}</span>)}</div>
                  : <span class="a-chip a-chip--ok">Всё заполнено</span>}
              </td>
              <td class="a-num">
                {a.status === 'review'
                  ? <span class:list={['a-time', { 'a-time--late': (a.waitingHours ?? 0) >= 20 }]}><AdminIcon name="clock" />{a.waitingHours} ч из 24</span>
                  : <a class="a-more" href={href}>Связаться</a>}
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </section>
</AdminShell>

<style>
  .ov-new__title { font-size: 22px; line-height: 30px; font-weight: 600; letter-spacing: -0.015em; }
  .ov-new__name { font-size: 16px; }
  .ov-new :global(td) { vertical-align: middle; padding-block: 14px; }
</style>
