---
// СВОДКА — первый экран админки: что сделать (действия со сроком), под
// ними новые заявки задачами, внизу строкой — сколько карточек на сайте.
// Только то, что будет настоящим: заявки, правки и жалобы придут из базы
// (сейчас — примеры), цифры по карточкам — по настоящему каталогу.
import AdminShell from '../../../components/admin/AdminShell.astro';
import AdminIcon from '../../../components/admin/AdminIcon.astro';
import { CATALOG } from '../../../lib/admin-catalog';
import { plural } from '../../../lib/moderation';
import { DEMO_REVISIONS } from '../../../data/moderation-demo';
import { COMPLAINTS } from '../../../data/admin-demo';
import { APP_STATUS, PARTNER_APPS } from '../../../data/partner-demo';

const review = PARTNER_APPS.filter((a) => a.status === 'review');
const drafts = PARTNER_APPS.filter((a) => a.status === 'draft');
const fresh = [...review, ...drafts];
const edits = DEMO_REVISIONS.filter((r) => r.state === 'review').length;
const complaints = COMPLAINTS.filter((c) => c.status === 'new').length;

// Сводка — список ДЕЙСТВИЙ (Никита, 27.10): что сделать и сколько, срок
// рядом. Число внутри фразы, а не отдельной цифрой над подписью — строки
// одной высоты и не прыгают. Пустое действие не показываем.
const actions = [
  { n: review.length, text: `Проверить ${review.length} ${plural(review.length, 'анкету', 'анкеты', 'анкет')}`, note: 'срок 24 ч', href: '/profi/admin/zayavki/#review', bad: true },
  { n: drafts.length, text: `Связаться: ${drafts.length} не ${plural(drafts.length, 'закончил', 'закончили', 'закончили')} анкету`, note: 'перезвонить или написать', href: '/profi/admin/zayavki/#draft' },
  { n: edits, text: `Проверить ${edits} ${plural(edits, 'правку', 'правки', 'правок')} карточек`, note: 'срок 24 ч', href: '/profi/admin/moderaciya/' },
  { n: complaints, text: `Разобрать ${complaints} ${plural(complaints, 'жалобу', 'жалобы', 'жалоб')}`, note: 'на карточки', href: '/profi/admin/zhaloby/' },
].filter((a) => a.n > 0);
const venues = CATALOG.filter((c) => c.kind === 'venue').length;
const percent = (a: (typeof fresh)[number]) => Math.round((a.sections.filter((x) => x.done).length / a.sections.length) * 100);
---

<AdminShell title="Сводка" section="overview">
  <div class="a-title"><h1 class="a-h1">Сводка</h1></div>

  <section class="a-acts" aria-label="Что сделать">
    {actions.map((a) => (
      <a class:list={['a-act', { 'a-act--bad': a.bad }]} href={a.href}>
        <span class="a-act__text">{a.text}</span>
        <span class="a-act__note">{a.note}</span>
        <AdminIcon name="next" class="a-act__go" />
      </a>
    ))}
  </section>

  <section class="a-card a-card--flush">
    <div class="a-card__head">
      <h2 class="a-h2">Новые заявки</h2>
      <a class="a-more" href="/profi/admin/zayavki/">Все</a>
    </div>
    <div class="a-tasks">
      {fresh.map((a) => {
        const href = `/profi/admin/zayavki/${a.id}/`;
        const late = a.status === 'review' && (a.waitingHours ?? 0) >= 20;
        return (
          <a class="a-task" href={href}>
            <span class="a-task__body">
              <span class="a-task__title">{a.status === 'review' ? 'Проверить анкету' : 'Связаться'}</span>
              <span class="a-task__sub">{a.name} · {a.category} · заполнено {percent(a)} %</span>
            </span>
            <span class:list={['a-task__when', { 'a-task__when--late': late }]}>
              {a.status === 'review' ? `${a.waitingHours} ч из 24` : a.lastEdit}
            </span>
          </a>
        );
      })}
    </div>
  </section>

  <p class="a-total">На сайте {CATALOG.length} {plural(CATALOG.length, 'карточка', 'карточки', 'карточек')}: {venues} {plural(venues, 'площадка', 'площадки', 'площадок')}, {CATALOG.length - venues} {plural(CATALOG.length - venues, 'подрядчик', 'подрядчика', 'подрядчиков')}. <a class="a-more" href="/profi/admin/katalog/">Все карточки</a></p>
</AdminShell>
