---
// СВОДКА — первый экран админки: что сделать (действия со сроком), под
// ними новые заявки задачами, внизу строкой — сколько карточек на сайте.
// Всё настоящее (05.11.2026): действия и заявки — из базы (lib/admin-live.ts),
// цифры по карточкам — по каталогу сайта. Демо-примеров нет: пусто — так
// и пишем «Задач нет».
import AdminShell from '../../../components/admin/AdminShell.astro';
---

<AdminShell title="Сводка" section="overview">
  {/* учётка — кружком справа в шапке (телефон), выход — внутри окна учётки,
      как у Apple; кнопки «Выйти» на главном экране нет (Никита 05.11) */}
  <div class="a-title a-title--acc"><h1 class="a-h1">Сводка</h1><button class="a-acc" type="button" data-adm-account aria-label="Учётка" hidden></button></div>

  <section class="a-acts" aria-label="Что сделать" data-ov-acts>
    <div class="sk-card a-card a-card--flush" aria-busy="true" aria-label="Загружаем"><div class="sk-row"><span class="sk sk--thumb"></span><span class="sk-row__body"><span class="sk sk--line"></span><span class="sk sk--line sk--short"></span></span><span class="sk sk--pill"></span></div><div class="sk-row"><span class="sk sk--thumb"></span><span class="sk-row__body"><span class="sk sk--line"></span><span class="sk sk--line sk--short"></span></span><span class="sk sk--pill"></span></div><div class="sk-row"><span class="sk sk--thumb"></span><span class="sk-row__body"><span class="sk sk--line"></span><span class="sk sk--line sk--short"></span></span><span class="sk sk--pill"></span></div></div>
  </section>

  <section class="a-card a-card--flush">
    <div class="a-card__head">
      <h2 class="a-h2">Новые заявки</h2>
      <a class="a-more" href="/profi/admin/zayavki/">Все</a>
    </div>
    <div class="a-tasks" data-ov-fresh></div>
  </section>

</AdminShell>

<script>
  import { requireSession, errText, esc, saveSession } from '../../../lib/cabinet-api';
  import { openDialog } from '../../../lib/cab-ui';
  import { loadRevisions, counts, leftMin, leftText, taskRow, failBox, URGENT_MIN, DEADLINE_MIN } from '../../../lib/admin-live';
  import { ADMIN_ICONS } from '../../../lib/admin-icons';

  const ic = (name: keyof typeof ADMIN_ICONS, cls: string) => `<svg class="${cls}" viewBox="0 0 24 24" aria-hidden="true">${ADMIN_ICONS[name]}</svg>`;

  // Сводка: плитки «что ждёт» с числом и ближайшим сроком (мало времени — красным), ниже новые заявки
  async function render(force = false) {
    const acts = document.querySelector<HTMLElement>('[data-ov-acts]');
    const fresh = document.querySelector<HTMLElement>('[data-ov-fresh]');
    if (!acts || !fresh) return;
    try {
      const c = counts(await loadRevisions(force));
      const soon = (rs: any[]) => {
        const xs = rs.map(leftMin).filter((x): x is number => x !== undefined);
        return xs.length ? Math.min(...xs) : undefined;
      };
      const nNew = c.newReview.length, nEdit = c.editReview.length, nDraft = c.drafts.length;
      // плитки 2×2 как в Напоминаниях Apple: значок в круге, крупное число, подпись (Никита 05.11)
      const tiles = [
        { n: nNew, label: 'Новые карточки', left: soon(c.newReview), href: '/profi/admin/zayavki/#review', icon: 'partners' },
        { n: nEdit, label: 'Правки', left: soon(c.editReview), href: '/profi/admin/moderaciya/', icon: 'moderation' },
        { n: nDraft, label: 'Не закончены', href: '/profi/admin/zayavki/#draft', icon: 'catalog' },
        { n: 0, label: 'Жалобы', href: '/profi/admin/zhaloby/', icon: 'complaints' },
      ] as { n: number; label: string; left?: number; href: string; icon: keyof typeof ADMIN_ICONS }[];
      // плитки стоят всегда (ноль — тоже ответ), как смарт-списки в Напоминаниях
      acts.innerHTML = `<div class="a-tiles">${tiles.map((t) => {
            const urgent = (t.left ?? DEADLINE_MIN) < URGENT_MIN;
            const note = t.left !== undefined ? leftText(t.left) : '';
            return `<a class="a-tile" href="${t.href}"><span class="a-tile__ic">${ic(t.icon, '')}</span><b class="a-tile__n">${t.n}</b><span class="a-tile__label">${t.label}</span>${note ? `<span class="a-tile__note${urgent ? ' a-tile__note--urgent' : ''}">${note}</span>` : ''}</a>`;
          }).join('')}</div>`;
      const rows = [
        ...c.newReview.sort((a, b) => (leftMin(a) ?? 0) - (leftMin(b) ?? 0)).map((r) => taskRow(r, { task: 'Проверить', tone: 'check' })),
        ...c.drafts.map((r) => taskRow(r, { task: 'Не закончена', tone: 'wait', fill: true })),
      ];
      fresh.innerHTML = rows.join('') || '<p class="a-empty">Новых заявок нет. Они появятся, когда подрядчик заведёт карточку в кабинете</p>';
    } catch (err) {
      acts.innerHTML = failBox(`Не загрузилось. ${errText(err)}`);
      fresh.innerHTML = '';
    }
  }

  document.addEventListener('astro:page-load', () => {
    const acts = document.querySelector<HTMLElement>('[data-ov-acts]');
    const s = acts ? requireSession('moderator') : null;
    if (!acts || !s) return;
    // кружок учётки → окно: имя, почта, «Выйти из админки»
    const acc = document.querySelector<HTMLButtonElement>('[data-adm-account]');
    if (acc) {
      const name = String(s.record.name || s.record.email || 'Модератор');
      acc.textContent = name.slice(0, 1).toUpperCase();
      acc.hidden = false;
      acc.onclick = () => {
        const { dlg } = openDialog({ cls: 'c-alert', html: `<div class="c-dialog__body">
          <span class="a-acc a-acc--lg" aria-hidden="true">${esc(name.slice(0, 1).toUpperCase())}</span>
          <h2 class="a-h2">${esc(name)}</h2>
          ${s.record.email ? `<p>${esc(s.record.email)}</p>` : ''}
          <div class="c-alert__acts"><button class="a-btn a-btn--lg a-btn--logout" type="button" data-out>Выйти из админки</button><button class="a-btn a-btn--lg" type="button" data-close>Закрыть</button></div>
        </div>` });
        dlg.querySelector('[data-out]')!.addEventListener('click', () => { saveSession('moderator', null); location.href = '/profi/admin/vhod/'; });
      };
    }
    acts.onclick = (e) => { if ((e.target as HTMLElement).closest('[data-retry]')) render(true); };
    render();
  });
</script>
