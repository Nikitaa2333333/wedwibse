---
// СВОДКА — первый экран админки: что сделать (действия со сроком), под
// ними новые заявки задачами, внизу строкой — сколько карточек на сайте.
// Только то, что будет настоящим: заявки, правки и жалобы придут из базы
// (сейчас — примеры), цифры по карточкам — по настоящему каталогу.
import AdminShell from '../../../components/admin/AdminShell.astro';
import AdminIcon from '../../../components/admin/AdminIcon.astro';
import { CATALOG } from '../../../lib/admin-catalog';
import { plural } from '../../../lib/moderation';
import { DEMO_REVISIONS } from '../../../data/moderation-demo';
import { COMPLAINTS } from '../../../data/admin-demo';
import { PARTNER_APPS } from '../../../data/partner-demo';
import AdminTask from '../../../components/admin/AdminTask.astro';
import type { AdminIconName } from '../../../lib/admin-icons';
import { appCover, appFill, appLeft, waitedMin, soonest, leftLabel, DEADLINE_MIN } from '../../../lib/admin-tasks';

// горящий срок — первым
const review = PARTNER_APPS.filter((a) => a.status === 'review').sort((a, b) => (appLeft(a) ?? 0) - (appLeft(b) ?? 0));
const drafts = PARTNER_APPS.filter((a) => a.status === 'draft');
const fresh = [...review, ...drafts];
const editsList = DEMO_REVISIONS.filter((r) => r.state === 'review');
const edits = editsList.length;
const complaints = COMPLAINTS.filter((c) => c.status === 'new').length;

// Сводка — список ДЕЙСТВИЙ (Никита, 27.10): что сделать и сколько. Срок —
// не общее «24 ч», а ближайший по этому действию; мало времени — красным.
const URGENT = 4 * 60;
const nextApp = soonest(review.map(appLeft));
const nextEdit = soonest(editsList.map((r) => DEADLINE_MIN - waitedMin(r.waiting)));
const due = (m?: number) => (m === undefined ? '' : m <= 0 ? 'срок вышел' : `ближайший срок через ${leftLabel(m)}`);
const actions: { n: number; text: string; note: string; urgent?: boolean; href: string; icon: AdminIconName; tone: string }[] = [
  { n: review.length, text: `Проверить ${review.length} ${plural(review.length, 'анкету', 'анкеты', 'анкет')}`, note: due(nextApp), urgent: (nextApp ?? DEADLINE_MIN) < URGENT, href: '/profi/admin/zayavki/#review', icon: 'partners', tone: 'info' },
  { n: drafts.length, text: `Связаться: ${drafts.length} не ${plural(drafts.length, 'закончил', 'закончили', 'закончили')} анкету`, note: 'перезвонить или написать', href: '/profi/admin/zayavki/#draft', icon: 'phone', tone: 'warn' },
  { n: edits, text: `Проверить ${edits} ${plural(edits, 'правку', 'правки', 'правок')}`, note: due(nextEdit), urgent: (nextEdit ?? DEADLINE_MIN) < URGENT, href: '/profi/admin/moderaciya/', icon: 'moderation', tone: 'info' },
  { n: complaints, text: `Разобрать ${complaints} ${plural(complaints, 'жалобу', 'жалобы', 'жалоб')}`, note: '', href: '/profi/admin/zhaloby/', icon: 'complaints', tone: 'bad' },
].filter((a) => a.n > 0);
const venues = CATALOG.filter((c) => c.kind === 'venue').length;
---

<AdminShell title="Сводка" section="overview">
  <div class="a-title"><h1 class="a-h1">Сводка</h1></div>

  <section class="a-acts" aria-label="Что сделать">
    {actions.map((a) => (
      <a class={`a-act a-act--${a.tone}`} href={a.href}>
        <span class="a-act__ic"><AdminIcon name={a.icon} /></span>
        <span class="a-act__text">{a.text}</span>
        {a.note && <span class:list={['a-act__note', { 'a-pill a-pill--bad': a.urgent }]}>{a.note}</span>}
        <AdminIcon name="next" class="a-act__go" />
      </a>
    ))}
  </section>

  <section class="a-card a-card--flush">
    <div class="a-card__head">
      <h2 class="a-h2">Новые заявки</h2>
      <a class="a-more" href="/profi/admin/zayavki/">Все</a>
    </div>
    <div class="a-tasks">
      {fresh.map((a) => (
        <AdminTask
          href={`/profi/admin/zayavki/${a.id}/`}
          name={a.name}
          cover={appCover(a)}
          task={a.status === 'review' ? 'Проверить анкету' : 'Не закончил анкету'}
          tone={a.status === 'review' ? 'check' : 'wait'}
          fill={a.status === 'draft' ? appFill(a) : undefined}
          left={appLeft(a)}
          when={a.lastEdit}
        />
      ))}
    </div>
  </section>

  <p class="a-total">На сайте {CATALOG.length} {plural(CATALOG.length, 'карточка', 'карточки', 'карточек')}: {venues} {plural(venues, 'площадка', 'площадки', 'площадок')}, {CATALOG.length - venues} {plural(CATALOG.length - venues, 'подрядчик', 'подрядчика', 'подрядчиков')}. <a class="a-more" href="/profi/admin/katalog/">Все карточки</a></p>
</AdminShell>
