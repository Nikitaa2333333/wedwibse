---
// МОДЕРАЦИЯ — правки ОПУБЛИКОВАННЫХ карточек, присланные из кабинета
// (docs/cabinet/CABINET.md §12). Вкладки: «На проверке» — на сайте прежняя
// версия, пока не одобрим; «Проверено» — решения за 30 дней. Порядок — по
// сроку (ответ до 24 ч, дольше ждущий выше). Новые карточки — в «Заявках».
// Данные — коллекция `revisions` (lib/admin-live.ts). Демо-примеры поверх
// настоящих карточек сняты 05.11.2026: модератор не отличал их от живых.
import AdminShell from '../../../../components/admin/AdminShell.astro';
import AdminIcon from '../../../../components/admin/AdminIcon.astro';
---

<AdminShell title="Модерация" section="moderation">
  <div class="a-title">
    <h1 class="a-h1">Модерация</h1>
  </div>

  <section class="a-card a-card--flush">
    <nav class="a-tabs" aria-label="Состояние правки">
      <a class="a-tabs__item is-active" href="#review" data-filter-tab="mq" data-value="review">На проверке <span class="a-tabs__n" data-mq-n="review"></span></a>
      <a class="a-tabs__item" href="#done" data-filter-tab="mq" data-value="done">Проверено <span class="a-tabs__n" data-mq-n="done"></span></a>
      <a class="a-tabs__item" href="#all" data-filter-tab="mq" data-value="all">Все <span class="a-tabs__n" data-mq-n="all"></span></a>
    </nav>
    <div class="a-tools">
      <label class="a-search">
        <span class="visually-hidden">Поиск</span>
        <input class="a-input" type="search" placeholder="Имя подрядчика или площадки" data-filter-search="mq" />
        <AdminIcon name="search" />
      </label>
    </div>
    <div class="a-table-wrap">
      <table class="a-table a-table--cards" id="mq" data-atable data-pending data-tab-default="review">
        <tbody data-mq-rows></tbody>
      </table>
      <div class="a-empty" data-empty="mq" hidden>Правок здесь нет. Они появятся, когда владелец опубликованной карточки отправит изменения</div>
      <div data-mq-state><div class="sk-row"><span class="sk sk--thumb"></span><span class="sk-row__body"><span class="sk sk--line"></span><span class="sk sk--line sk--short"></span></span><span class="sk sk--pill"></span></div><div class="sk-row"><span class="sk sk--thumb"></span><span class="sk-row__body"><span class="sk sk--line"></span><span class="sk sk--line sk--short"></span></span><span class="sk sk--pill"></span></div><div class="sk-row"><span class="sk sk--thumb"></span><span class="sk-row__body"><span class="sk sk--line"></span><span class="sk sk--line sk--short"></span></span><span class="sk sk--pill"></span></div></div>
    </div>
  </section>
</AdminShell>

<script>
  import { requireSession, errText, esc } from '../../../../lib/cabinet-api';
  import { loadRevisions, isNew, leftMin, taskRow, failBox } from '../../../../lib/admin-live';

  async function render(force = false) {
    const body = document.querySelector<HTMLElement>('[data-mq-rows]');
    const state = document.querySelector<HTMLElement>('[data-mq-state]');
    if (!body || !state) return;
    try {
      const revs = (await loadRevisions(force)).filter((r) => !isNew(r) && r.status !== 'draft');
      revs.sort((a, b) => (leftMin(a) ?? Infinity) - (leftMin(b) ?? Infinity));
      body.innerHTML = revs.map((r) => {
        const done = r.status !== 'review';
        const task = r.status === 'review' ? 'Проверить' : r.status === 'approved' ? 'Одобрили' : 'Вернули';
        const text = `${r.data?.name ?? ''} ${r.expand?.owner?.name ?? ''}`.toLowerCase();
        return `<tr data-tab="${done ? 'done' : 'review'}" data-text="${esc(text)}"><td class="a-task-cell">${taskRow(r, { task, tone: r.status === 'review' ? 'check' : r.status === 'approved' ? 'ok' : 'bad' })}</td></tr>`;
      }).join('');
      const n = { review: revs.filter((r) => r.status === 'review').length, all: revs.length } as Record<string, number>;
      n.done = n.all - n.review;
      for (const k of Object.keys(n)) {
        const el = document.querySelector<HTMLElement>(`[data-mq-n="${k}"]`);
        if (el) el.textContent = String(n[k]);
      }
      state.innerHTML = '';
      const table = document.querySelector('#mq')!;
      table.removeAttribute('data-pending');
      table.dispatchEvent(new Event('atable:refresh'));
    } catch (err) {
      body.innerHTML = '';
      state.innerHTML = failBox(`Правки не загрузились. ${errText(err)}`);
    }
  }

  document.addEventListener('astro:page-load', () => {
    const state = document.querySelector<HTMLElement>('[data-mq-state]');
    if (!state || !requireSession('moderator')) return;
    state.onclick = (e) => { if ((e.target as HTMLElement).closest('[data-retry]')) render(true); };
    render();
  });
</script>
