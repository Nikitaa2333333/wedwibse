---
// МОДЕРАЦИЯ — правки, которые подрядчики и площадки прислали из кабинета
// (CABINET.md §12). Вкладки: «На проверке» — на сайте прежняя версия, пока
// не одобрим; «Проверено» — история решений. Порядок — по сроку (ответ до
// 24 ч, дольше ждущий выше). Вживую — коллекция `revisions` в PocketBase;
// сейчас — примеры поверх настоящих карточек (moderation-demo.ts).
import { Image } from 'astro:assets';
import AdminShell from '../../../../components/admin/AdminShell.astro';
import AdminIcon from '../../../../components/admin/AdminIcon.astro';
import { resolveImage, IMG_WIDTHS } from '../../../../lib/images';
import { buildReview, plural } from '../../../../lib/moderation';
import { QUEUE, STATE } from '../../../../data/moderation-demo';

const reviews = QUEUE.map(buildReview);
const onReview = reviews.filter((r) => r.rev.state === 'review').length;
const minutes = (s?: string) => {
  const m = s?.match(/(\d+)\s*ч\s*(\d+)/);
  return m ? Number(m[1]) * 60 + Number(m[2]) : 0;
};
---

<AdminShell title="Модерация" section="moderation">
  <div class="a-title">
    <h1 class="a-h1">Модерация</h1>
    <p class="a-lead">Правки, которые подрядчики и площадки прислали из кабинета. Пока правка на проверке, на сайте прежняя версия.</p>
  </div>

  <!-- Живая очередь из базы (revisions, status = review) — сквозная проверка
       STAGE2.md. Ниже — примеры на заглушках, по ним отрабатывался вид. -->
  <section class="a-card a-card--flush" data-live-queue>
    <div class="a-card__head mq__live-head">
      <h2 class="a-h2">Из базы</h2>
      <a class="a-btn a-btn--soft a-btn--sm" href="/profi/admin/vhod/" data-live-login>Войти модератором</a>
    </div>
    <div class="a-table-wrap">
      <table class="a-table a-table--cards">
        <thead><tr><th>Кто прислал</th><th>Что</th><th class="a-num">Прислали</th></tr></thead>
        <tbody data-live-rows><tr><td colspan="3" class="a-sub">Очередь из базы видна после входа модератора.</td></tr></tbody>
      </table>
    </div>
  </section>

  <section class="a-card a-card--flush">
    <nav class="a-tabs" aria-label="Состояние правки">
      <a class="a-tabs__item is-active" href="#" data-filter-tab="mq" data-value="review">На проверке <span class="a-tabs__n">{onReview}</span></a>
      <a class="a-tabs__item" href="#" data-filter-tab="mq" data-value="done">Проверено <span class="a-tabs__n">{reviews.length - onReview}</span></a>
      <a class="a-tabs__item" href="#" data-filter-tab="mq" data-value="all">Все <span class="a-tabs__n">{reviews.length}</span></a>
    </nav>
    <div class="a-tools">
      <label class="a-search">
        <span class="visually-hidden">Поиск</span>
        <input class="a-input" type="search" placeholder="Имя подрядчика или площадки" data-filter-search="mq" />
        <AdminIcon name="search" />
      </label>
    </div>
    <div class="a-table-wrap">
      <table class="a-table a-table--cards" id="mq" data-atable data-tab-default="review">
        <thead>
          <tr>
            <th data-sort="asc">Кто прислал</th>
            <th class="mq__changes">Что поменялось</th>
            <th>Автопроверка</th>
            <th class="a-num is-sorted" data-sort="desc">Ждёт</th>
          </tr>
        </thead>
        <tbody>
          {reviews.map((r) => {
            const href = `/profi/admin/moderaciya/${r.rev.id}/`;
            const done = r.rev.state !== 'review';
            return (
              <tr data-href={href} data-tab={done ? 'done' : 'review'} data-text={r.card.name.toLowerCase()}>
                <td data-v={r.card.name}>
                  <div class="a-who">
                    {r.photos.after[0] && <Image src={resolveImage(r.photos.after[0])} alt="" widths={[...IMG_WIDTHS.thumb]} sizes="32px" class="a-thumb" />}
                    <div>
                      <a class="a-name" href={href}>{r.card.name}</a>
                      <span class="a-sub">{r.role} · {r.rev.first ? 'новая карточка' : 'правка'} · {r.rev.submitted.toLowerCase()}</span>
                    </div>
                  </div>
                </td>
                <td>
                  <div class="a-chips">
                    {r.changes.map((c) => <span class="a-chip"><b>{c.label}:</b> {c.value}</span>)}
                  </div>
                </td>
                <td data-l="Автопроверка">
                  {r.rev.flags.length
                    ? <span class="a-dot a-dot--bad">{r.rev.flags.length} {plural(r.rev.flags.length, 'флажок', 'флажка', 'флажков')}</span>
                    : <span class="a-dot a-dot--ok">чисто</span>}
                </td>
                <td class="a-num" data-v={minutes(r.rev.waiting)}>
                  {done
                    ? <span class={`a-dot a-dot--${STATE[r.rev.state].dot}`}>{STATE[r.rev.state].label}</span>
                    : <span class:list={['a-time', { 'a-time--late': minutes(r.rev.waiting) >= 20 * 60 }]}><AdminIcon name="clock" />{r.rev.waiting}</span>}
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
      <div class="a-empty" data-empty="mq" hidden>Ничего не нашлось</div>
    </div>
  </section>
</AdminShell>

<style>
  .mq__changes { min-width: 320px; }
  .mq__live-head { display: flex; justify-content: space-between; align-items: center; gap: var(--s-3); }
</style>

<script>
  import { api, esc, session } from '../../../../lib/cabinet-api';

  const KIND: Record<string, string> = { venue: 'площадка' };
  const fmt = (d: string) => (d ? new Date(d.replace(' ', 'T')).toLocaleString('ru-RU', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) : '');

  document.addEventListener('astro:page-load', async () => {
    const rows = document.querySelector<HTMLElement>('[data-live-rows]');
    if (!rows) return;
    const s = session('moderator');
    if (!s) return;
    document.querySelector<HTMLElement>('[data-live-login]')!.textContent = s.record.name || s.record.email;
    try {
      const res = await api('moderator', 'GET', `/api/collections/revisions/records?perPage=100&sort=submittedAt&expand=owner&filter=${encodeURIComponent('status = "review"')}`);
      rows.innerHTML = res.items.length
        ? res.items.map((r: any) => {
            const href = `/profi/admin/moderaciya/pravka/?id=${r.id}`;
            const who = r.expand?.owner?.name || 'без имени';
            const what = `${KIND[r.kind] ?? r.categorySlug} · ${r.venue || r.specialist ? 'правка' : 'новая карточка'} · ${(r.photos ?? []).length} фото`;
            return `<tr data-href="${href}"><td><a class="a-name" href="${href}">${esc(r.data?.name || 'Без названия')}</a><span class="a-sub">${esc(who)}</span></td><td>${esc(what)}</td><td class="a-num">${esc(fmt(r.submittedAt))}</td></tr>`;
          }).join('')
        : '<tr><td colspan="3" class="a-sub">На проверке ничего нет.</td></tr>';
    } catch (err) {
      rows.innerHTML = `<tr><td colspan="3" class="a-sub">${esc((err as Error).message)}</td></tr>`;
    }
  });
</script>
