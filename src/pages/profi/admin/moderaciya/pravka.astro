---
// РАЗБОР ПРАВКИ ИЗ БАЗЫ — ?id=<ревизия> (сквозная проверка, STAGE2.md).
// Поля «было → стало», фото черновика (закрыты, открываются токеном
// модератора), одобрить / вернуть с причиной. Одобрение переносит
// правку в карточку одной транзакцией (хук moderateRevision); на сайт
// карточка выходит со следующей выкладкой. Решение — с «Отменить» на
// 6 секунд (lib/cab-ui.ts → later): экран меняется сразу, запрос уходит потом.
// Сюда ведут и «Заявки» (новая карточка), и «Модерация» (правка).
import AdminShell from '../../../../components/admin/AdminShell.astro';
import AdminIcon from '../../../../components/admin/AdminIcon.astro';
import { SPECIALIST_CATEGORIES, FILTERS_BY_CATEGORY } from '../../../../data/specialists';

const ROLES = Object.fromEntries(SPECIALIST_CATEGORIES.map((c) => [c.slug, c.role]));
// подписи ответов анкеты: в данных — значения фильтров, модератору — слова
const QUESTIONS = Object.fromEntries(
  Object.entries(FILTERS_BY_CATEGORY).map(([k, groups]) => [k, groups.map((g) => ({ key: g.key, label: g.label, options: g.options.map((o) => ({ value: o.value, label: o.label })) }))]),
);
---

<AdminShell title="Разбор правки" section="moderation">
  <a class="a-back" href="/profi/admin/moderaciya/" data-pr-back><AdminIcon name="back" /><span data-pr-back-label>Модерация</span></a>
  <div class="a-title">
    <h1 class="a-h1" data-pr-title>Правка</h1>
    <p class="a-lead" data-pr-lead></p>
  </div>

  <div class="a-grid a-grid--main" data-pr data-roles={JSON.stringify(ROLES)} data-questions={JSON.stringify(QUESTIONS)}>
    <div class="pr__main">
      <section class="a-card">
        <h2 class="a-h2">Что прислали</h2>
        <dl class="pr__fields" data-pr-fields aria-busy="true"><dd class="sk-head"><span class="sk sk--line sk--short"></span><span class="sk sk--line"></span><span class="sk sk--line sk--short"></span><span class="sk sk--line"></span><span class="sk sk--line" style="width:80%"></span></dd></dl>
      </section>
      <section class="a-card">
        <h2 class="a-h2">Фото <span class="pr__n" data-pr-photo-n></span></h2>
        <ul class="pr__photos" data-pr-photos></ul>
      </section>
    </div>
    <aside class="a-card pr__side">
      <p class="pr__state" data-pr-state></p>
      <div class="pr__acts" data-pr-acts hidden>
        <button class="a-btn a-btn--primary a-btn--lg a-btn--block" type="button" data-pr-approve>Одобрить</button>
        <div class="pr__why" data-pr-why hidden>
          <label class="pr__label" for="pr-reason">Что исправить</label>
          <textarea class="a-input pr__reason" id="pr-reason" rows="4" placeholder="Своими словами: что не так и что сделать" data-pr-reason></textarea>
        </div>
        <button class="a-btn a-btn--lg a-btn--block" type="button" data-pr-reject>Вернуть с причиной</button>
      </div>
      <p class="pr__error" data-pr-error hidden></p>
    </aside>
  </div>
</AdminShell>

<style>
  .pr__main { display: grid; gap: var(--s-4); min-width: 0; }
  .pr__fields { display: grid; gap: var(--s-1); margin-top: var(--s-3); }
  /* строки приходят из базы через innerHTML — без scope-атрибута, поэтому :global */
  /* акцент — на присланном, не на подписях (Никита 05.11): подпись мелкая, значение крупнее;
     между полями отступ больше, чем между подписью и значением (внутреннее < внешнего) */
  .pr__fields :global(dt) { font-size: var(--adm-fs-sm); font-weight: 500; margin-top: var(--s-4); }
  .pr__fields :global(dt:first-child) { margin-top: 0; }
  .pr__fields :global(dd) { margin-top: 2px; font-size: 16px; font-weight: 500; white-space: pre-line; overflow-wrap: anywhere; line-height: 1.4; }
  .pr__fields :global(.pr__tariff) { display: block; margin-top: 6px; }
  .pr__fields :global(.pr__tariff b) { font-weight: 600; }
  :global(.pr__was) { display: block; text-decoration: line-through; background: var(--diff-del); }
  :global(.pr__now) { background: var(--diff-add); }
  .pr__photos { margin-top: var(--s-3); list-style: none; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px; } /* три колонки, как у подрядчика: модератору хватит, быстрее пролистать */
  :global(.pr__photos img) { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; border-radius: var(--radius-card); display: block; }
  .pr__side { display: grid; gap: var(--s-3); align-content: start; }
  .pr__acts { display: grid; gap: var(--s-3); }
  .pr__acts[hidden], .pr__error[hidden], .pr__why[hidden] { display: none; }
  .pr__why { display: grid; gap: var(--s-2); }
  .pr__label { font-weight: 500; margin-bottom: calc(-1 * var(--s-2)); }
  .pr__n { font-weight: var(--w-body); }
  .pr__reason { width: 100%; resize: vertical; min-height: 96px; height: auto; padding-block: var(--s-2); }
  .pr__error { color: var(--st-bad-text); font-size: var(--fs-small); white-space: pre-line; }
</style>

<script>
  import { api, esc, fileToken, fileUrl, requireSession, REV_STATUS, errText } from '../../../../lib/cabinet-api';
  import { VENUE_QUESTIONS, VENUE_TERMS, priceFrom, rub } from '../../../../lib/cabinet-form';
  import { later } from '../../../../lib/cab-ui';
  import { fieldError, clearFieldError } from '../../../../lib/form-check';

  const LABELS: [string, string][] = [
    ['name', 'Название'], ['tagline', 'Коротко о себе'], ['address', 'Адрес'], ['rentFrom', 'Аренда от'],
    ['checkFrom', 'Средний чек от'], ['capacityBanquet', 'Гостей до'], ['about', 'О себе'], ['priceFrom', 'Цена от'], ['priceNote', 'Цена указана за'],
  ];
  /** ответ на вопрос словами: значения фильтра → подписи вариантов */
  const MONEY_KEYS = ['rentFrom', 'checkFrom', 'priceFrom'];
  const answer = (qs: any[], key: string, v: unknown) => {
    const q = qs.find((x) => x.key === key);
    const vals = ([] as unknown[]).concat(v ?? []).map(String).filter(Boolean);
    return vals.map((x) => q?.options.find((o: any) => o.value === x)?.label ?? x).join(', ');
  };

  document.addEventListener('astro:page-load', async () => {
    const root = document.querySelector<HTMLElement>('[data-pr]');
    if (!root) return;
    const s = requireSession('moderator');
    if (!s) return;
    const roles = JSON.parse(root.dataset.roles!);
    const $ = <T extends HTMLElement>(sel: string) => document.querySelector<T>(sel)!;
    const error = $('[data-pr-error]');
    const fail = (m: string) => { error.textContent = m; error.hidden = false; };
    const id = new URLSearchParams(location.search).get('id') || '';

    let rev: any;
    async function render() {
      rev = await api('moderator', 'GET', `/api/collections/revisions/records/${encodeURIComponent(id)}?expand=owner`);
      const cardId = rev.venue || rev.specialist;
      let was: any = null;
      if (cardId) {
        const card = await api('moderator', 'GET', `/api/collections/${rev.kind === 'venue' ? 'venues' : 'specialists'}/records/${cardId}`);
        // у карточки из кабинета прежние ответы лежат в page; у карточек
        // конвейера — только плоские поля
        was = card.page?.source === 'cabinet' ? card.page : card;
      }
      const d = rev.data ?? {};
      const role = rev.kind === 'venue' ? 'Площадка' : roles[rev.categorySlug] ?? rev.categorySlug;
      $('[data-pr-title]').textContent = d.name || 'Без названия';
      if (!cardId) {
        $<HTMLAnchorElement>('[data-pr-back]').href = '/profi/admin/zayavki/';
        $('[data-pr-back-label]').textContent = 'Заявки';
      }
      // без точек-разделителей (Никита 05.11): что это — первой строкой, кто прислал — второй
      $('[data-pr-lead]').innerHTML = `${esc(role)}, ${cardId ? 'правка опубликованной карточки' : 'новая карточка'}<br>Прислал(а): ${esc(rev.expand?.owner?.name || rev.expand?.owner?.email || 'без имени')}`;

      const rows = LABELS.filter(([k]) => (d[k] ?? '') !== '' || (was && (was[k] ?? '') !== '')).map(([k, label]) => {
        const now = String(d[k] ?? '');
        const before = was ? String(was[k] ?? '') : null;
        const changed = before !== null && before !== now;
        // суммы — с разрядами и ₽ (правило 24)
        const fmt = (v: string) => (MONEY_KEYS.includes(k) && Number(v) > 0 ? rub(Number(v)) : esc(v));
        return `<dt>${label}</dt><dd>${changed ? `<span class="pr__was">${fmt(before!) || 'пусто'}</span><span class="pr__now">${fmt(now) || 'пусто'}</span>` : fmt(now) || 'пусто'}</dd>`;
      });
      // текст разделами — как написал подрядчик
      for (const sec of d.sections ?? []) {
        if (!String(sec?.body ?? '').trim()) continue;
        rows.push(`<dt>Текст: ${esc(sec.title || 'без заголовка')}</dt><dd>${esc(sec.body) || 'пусто'}</dd>`);
      }
      const qs = rev.kind === 'venue' ? VENUE_QUESTIONS : JSON.parse(root.dataset.questions!)[rev.categorySlug] ?? [];
      const answered = qs.filter((q: any) => answer(qs, q.key, d.filters?.[q.key]));
      if (qs.length) rows.push(`<dt>Вопросы: ${answered.length} из ${qs.length}</dt><dd>${answered.map((q: any) => `${esc(q.label)}: <b>${esc(answer(qs, q.key, d.filters[q.key]))}</b>`).join('<br>') || 'пусто'}</dd>`);
      const tariffs = (d.tariffs ?? []).filter((t: any) => t?.name || t?.price);
      if (tariffs.length) {
        const p = priceFrom(d);
        rows.push(`<dt>Тарифы${p ? `, в каталоге от ${rub(p)}` : ''}</dt><dd>${tariffs.map((t: any) => `<span class="pr__tariff"><b>${esc(t.name)}</b> — ${t.price ? rub(Number(t.price)) : 'без цены'}${t.includes ? `\n${esc(t.includes)}` : ''}</span>`).join('')}</dd>`);
      }
      const halls = (d.halls ?? []).filter((h: any) => h?.name);
      if (halls.length) rows.push(`<dt>Залы</dt><dd>${halls.map((h: any) => `<b>${esc(h.name)}</b> — банкет до ${esc(h.banquet || '—')}, фуршет до ${esc(h.buffet || '—')}${h.area ? `, ${esc(h.area)} м²` : ''}${h.priceFrom ? `, от ${rub(Number(h.priceFrom))}` : ''}${h.note ? `\n${esc(h.note)}` : ''}`).join('\n\n')}</dd>`);
      if (rev.kind === 'venue') {
        const t = d.terms ?? {};
        const lines = [
          ...VENUE_TERMS.map((q) => `${q.label}: ${answer(VENUE_TERMS, q.key, t[q.key]) || 'пусто'}`),
          t.until && `До скольки: ${t.until}`, t.parking && `Парковка: ${t.parking}`, t.more,
        ].filter(Boolean);
        rows.push(`<dt>Условия</dt><dd>${esc(lines.join('\n'))}</dd>`);
      }
      // ссылки на ролики: ролик готовим и ставим сами (docs/VIDEO.md), на сайт ссылка не идёт
      const videos = (d.videos ?? []).map((v: any) => String(v?.url ?? '').trim()).filter((u: string) => /^https?:\/\//.test(u));
      if (videos.length) rows.push(`<dt>Видео — подготовить по docs/VIDEO.md</dt><dd>${videos.map((u: string) => `<a href="${esc(u)}" target="_blank" rel="noopener noreferrer">${esc(u)}</a>`).join('\n')}</dd>`);
      const c = d.contacts ?? {};
      rows.push(`<dt>Контакты (скрыты, за кнопкой)</dt><dd>${esc([c.phone, c.telegram && `Telegram ${c.telegram}`, c.max && `MAX ${c.max}`, c.site, c.email].filter(Boolean).join(' · ')) || 'пусто'}</dd>`);
      // карточка «ведём мы» (пилот, 03.11): одобрение меняет только цену,
      // вопросы, контакты и видео; текст и фото — просьбы, делаем руками в JSON
      if (d.managed) {
        const r = d.requests ?? {};
        const asks = [r.text && `Текст: ${r.text}`, r.photos && `Фото: ${r.photos}`].filter(Boolean);
        rows.unshift(`<dt>Ведём мы — текст и фото владелец не меняет</dt><dd>${asks.length ? `Просит поправить — сделать руками в src/data/specialists/${esc(rev.categorySlug)}/${esc(rev.slug)}.json:\n${esc(asks.join('\n'))}` : 'Просьб по тексту и фото нет.'}</dd>`);
      }
      $('[data-pr-fields]').innerHTML = rows.join('');

      const token = rev.photos?.length ? await fileToken('moderator') : '';
      $('[data-pr-photo-n]').textContent = String(rev.photos?.length ?? 0);
      $('[data-pr-photos]').innerHTML = (rev.photos ?? []).map((n: string) =>
        `<li><a href="${fileUrl(rev, n, { token })}" target="_blank" rel="noopener"><img src="${fileUrl(rev, n, { thumb: '400x0', token })}" alt="" loading="lazy" /></a></li>`).join('');

      const st = REV_STATUS[rev.status];
      $('[data-pr-state]').innerHTML = rev.status === 'review' ? '' : `<span class="status ${st.cls}">${st.label}</span>${rev.status === 'rejected' && rev.rejectReason ? `<br><span class="a-sub">Причина: ${esc(rev.rejectReason)}</span>` : ''}${rev.status === 'approved' ? '<br><span class="a-sub">Карточка опубликована в базе. На сайте появится со следующей выкладкой.</span>' : ''}`;
      $('[data-pr-acts]').hidden = rev.status !== 'review';
    }

    // Решение видно сразу, в базу уходит через 6 секунд — успеваете «Отменить»
    // (как отмена отправки в почте). Подрядчику уведомление уходит из хука
    // только после записи — отменённое решение до него не доходит.
    function act(body: Record<string, string>, text: string) {
      error.hidden = true;
      const acts = $('[data-pr-acts]');
      const state = $('[data-pr-state]');
      const before = state.innerHTML;
      const st = REV_STATUS[body.status];
      acts.hidden = true;
      state.innerHTML = `<span class="status ${st.cls}">${st.label}</span>`;
      later({
        text,
        undo: () => { state.innerHTML = before; acts.hidden = false; },
        run: async () => {
          try {
            await api('moderator', 'PATCH', `/api/collections/revisions/records/${rev.id}`, body, { keepalive: true });
          } catch (err) {
            fail(errText(err));
          }
          try { await render(); } catch {}
        },
      });
    }

    $('[data-pr-reason]').addEventListener('input', (e) => clearFieldError(e.target as HTMLInputElement));
    $('[data-pr-approve]').addEventListener('click', () => act({ status: 'approved' }, 'Одобрено'));
    $('[data-pr-reject]').addEventListener('click', () => {
      // первое нажатие — раскрыть поле «Что исправить» и прокрутить к нему; второе — вернуть
      const why = $('[data-pr-why]');
      if (why.hidden) {
        why.hidden = false;
        why.scrollIntoView({ behavior: 'smooth', block: 'center' });
        $<HTMLTextAreaElement>('[data-pr-reason]').focus({ preventScroll: true });
        return;
      }
      const reason = $<HTMLTextAreaElement>('[data-pr-reason]').value.trim();
      // ошибка поля — облачком у поля, не строкой под кнопкой (правило «где какая ошибка»)
      if (!reason) return fieldError($<HTMLTextAreaElement>('[data-pr-reason]') as unknown as HTMLInputElement, 'Напишите, что исправить — без этого подрядчик не поймёт, что делать');
      act({ status: 'rejected', rejectReason: reason }, 'Вернули с причиной');
    });

    try { await render(); } catch (err) { fail(errText(err)); }
  });
</script>
