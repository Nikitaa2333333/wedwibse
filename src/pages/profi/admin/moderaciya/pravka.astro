---
// РАЗБОР ПРАВКИ ИЗ БАЗЫ — ?id=<ревизия> (сквозная проверка, STAGE2.md).
// Поля «было → стало», фото черновика (закрыты, открываются токеном
// модератора), одобрить / вернуть с причиной. Одобрение переносит
// правку в карточку одной транзакцией (хук moderateRevision); сайт рисует
// карточку из базы — она видна через секунды (сайт из базы, 05.11). Решение — с «Отменить» на
// 6 секунд (lib/cab-ui.ts → later): экран меняется сразу, запрос уходит потом.
// Сюда ведут и «Заявки» (новая карточка), и «Модерация» (правка).
import AdminShell from '../../../../components/admin/AdminShell.astro';
import AdminIcon from '../../../../components/admin/AdminIcon.astro';
import { SPECIALIST_CATEGORIES, FILTERS_BY_CATEGORY } from '../../../../data/specialists';

const ROLES = Object.fromEntries(SPECIALIST_CATEGORIES.map((c) => [c.slug, c.role]));
// подписи ответов анкеты: в данных — значения фильтров, модератору — слова
const QUESTIONS = Object.fromEntries(
  Object.entries(FILTERS_BY_CATEGORY).map(([k, groups]) => [k, groups.map((g) => ({ key: g.key, label: g.label, options: g.options.map((o) => ({ value: o.value, label: o.label })) }))]),
);
---

<AdminShell title="Разбор правки" section="moderation">
  <a class="a-back" href="/profi/admin/moderaciya/" data-pr-back><AdminIcon name="back" /><span data-pr-back-label>Модерация</span></a>
  <div class="a-title">
    <h1 class="a-h1" data-pr-title>Правка</h1>
    <p class="a-lead" data-pr-lead></p>
  </div>

  <div class="a-grid a-grid--main" data-pr data-roles={JSON.stringify(ROLES)} data-questions={JSON.stringify(QUESTIONS)}>
    <div class="pr__main">
      <section class="a-card">
        <h2 class="a-h2">Что прислали</h2>
        <dl class="pr__fields" data-pr-fields aria-busy="true"><dd class="sk-head"><span class="sk sk--line sk--short"></span><span class="sk sk--line"></span><span class="sk sk--line sk--short"></span><span class="sk sk--line"></span><span class="sk sk--line" style="width:80%"></span></dd></dl>
      </section>
      <section class="a-card">
        <h2 class="a-h2">Фото <span class="pr__n" data-pr-photo-n></span></h2>
        <ul class="pr__photos" data-pr-photos></ul>
      </section>
    </div>
    <aside class="a-card pr__side" data-toast-top>
      <p class="pr__state" data-pr-state></p>
      <div class="pr__acts" data-pr-acts hidden>
        <!-- две кнопки решения парой; причина — в отдельном окне (HIG: Sheets), а не полем между кнопками (Никита 06.11) -->
        <button class="a-btn a-btn--primary a-btn--lg a-btn--block" type="button" data-pr-approve>Одобрить</button>
        <button class="a-btn a-btn--lg a-btn--block" type="button" data-pr-reject>Вернуть с причиной</button>
      </div>
      <p class="pr__error" data-pr-error hidden></p>
    </aside>
  </div>
</AdminShell>

<style>
  .pr__main { display: grid; gap: var(--s-4); min-width: 0; }
  .pr__fields { display: grid; margin-top: var(--s-3); }
  /* строки приходят из базы через innerHTML — без scope-атрибута, поэтому :global */
  /* акцент — на присланном, не на подписях (Никита 05.11): подпись мелкая, значение крупнее;
     между полями отступ больше, чем между подписью и значением (внутреннее < внешнего) */
  /* «Что прислали» как карточка контакта в iOS (Никита 06.11: подпись и присланное сливались):
     каждое поле — строка, между строками тонкая линия; подпись мелкая сверху, присланное крупнее
     и плотнее под ней. Внутри строки 2 px, строка 12 сверху и снизу — внутреннее меньше внешнего */
  .pr__fields :global(dt) { padding-top: var(--s-3); border-top: 1px solid var(--adm-line); font-size: 13px; line-height: 16px; font-weight: 500; }
  .pr__fields :global(dt:first-child) { padding-top: 0; border-top: 0; }
  .pr__fields :global(dd) { margin: 2px 0 0; padding-bottom: var(--s-3); font-size: 17px; font-weight: 600; white-space: pre-line; overflow-wrap: anywhere; line-height: 1.35; }
  .pr__fields :global(dd:last-child) { padding-bottom: 0; }
  /* длинный текст подрядчика читают — обычным весом; заголовки его разделов — 600 */
  .pr__fields :global(dd:has(.pr__sec)), .pr__fields :global(dd:has(.pr__tariff)), .pr__fields :global(dd:has(.pr__tn)) { font-weight: 400; }
  .pr__fields :global(.pr__tariff) { display: block; margin-top: 6px; }
  /* внутри dd жирное <b> гасит глобальное правило сайта (dd b … !important) — имя тарифа и зала span'ом */
  .pr__fields :global(.pr__tn) { font-weight: 600; }
  .pr__fields :global(.pr__empty) { font-weight: 400; }
  .pr__fields :global(dd:has(.pr__qt)) { font-weight: 400; }
  .pr__fields :global(.pr__qt) { display: grid; margin-top: var(--s-1); }
  .pr__fields :global(.pr__q) { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--s-3); padding-block: 10px; border-top: 1px solid var(--adm-line); font-size: 15px; line-height: 20px; }
  .pr__fields :global(.pr__q:first-child) { border-top: 0; padding-top: var(--s-1); }
  .pr__fields :global(.pr__q-v) { display: grid; gap: 2px; font-weight: 600; }
  .pr__fields :global(.pr__line) { display: block; }
  /* портрет в разборе — кружком, как он стоит на визитке (07.11) */
  .pr__fields :global(.pr__ava) { display: block; width: 72px; height: 72px; border-radius: 50%; object-fit: cover; }
  .pr__fields :global(.pr__line + .pr__line) { margin-top: var(--s-1); } /* 8 — «дыра», 0 — «слиплось» (06.11) */
  :global(.pr__was) { display: block; text-decoration: line-through; background: var(--diff-del); }
  :global(.pr__now) { background: var(--diff-add); }
  .pr__photos { margin-top: var(--s-3); list-style: none; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px; } /* три колонки, как у подрядчика: модератору хватит, быстрее пролистать */
  :global(.pr__photos img) { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; border-radius: var(--radius-card); display: block; }
  .pr__side { display: grid; gap: var(--s-3); align-content: start; }
  .pr__acts { display: grid; gap: var(--s-2); }
  .pr__acts[hidden], .pr__error[hidden] { display: none; }
  .pr__n { font-weight: var(--w-body); }
  /* статус и под ним текст модератора: внутри группы 8 px, без подписи «Причина:» (Никита 06.11) */
  .pr__state { display: grid; gap: var(--s-2); justify-items: start; margin: 0; }
  /* решение модератора — своей цветной плашкой, а не частью интерфейса (Никита 06.11): видно, что это
     наш комментарий, который может меняться. Вернули — красная подложка, одобрили — зелёная */
  /* для модератора решение — уже история, не тревога (Никита 06.11): плашка белая, как остальные,
     цветной только заголовок «Вернули / Одобрили» */
  .pr__state :global(.pr__state-h) { font-weight: 600; }
  .pr__state :global(.pr__state-h--plain) { font-size: 17px; }
  /* у незаконченной карточки «Связаться» — первым экраном: ради него модератор сюда и пришёл */
  .a-grid:has(.pr__state[data-st="draft"]) .pr__side { order: -1; }
  .pr__state :global(.pr__contacts) { display: grid; gap: var(--s-1); font-size: 16px; font-weight: 600; }
  .pr__state :global(.pr__contact-acts) { display: grid; gap: var(--s-2); justify-self: stretch; margin-top: var(--s-2); }
  .pr__state[data-st="rejected"] :global(.pr__state-h) { color: var(--st-bad-strong); }
  .pr__state[data-st="approved"] :global(.pr__state-h) { color: var(--st-ok-strong); }
  .pr__state:empty { display: none; }
  .pr__state :global(.pr__state-text) { margin: 0; font-size: 16px; line-height: 1.4; white-space: pre-line; overflow-wrap: anywhere; }
  /* текст модератора — облачком комментария с хвостиком к заголовку (Никита 06.11: «всё же выделять»):
     сразу видно, что это написанное человеком, а не часть интерфейса */
  .pr__state[data-st="rejected"] :global(.pr__state-text) { position: relative; justify-self: stretch; margin-top: 6px; padding: 12px 14px; border-radius: 16px; background: var(--adm-bg); }
  .pr__state[data-st="rejected"] :global(.pr__state-text)::before { content: ''; position: absolute; left: 18px; top: -7px; width: 14px; height: 8px; background: inherit; clip-path: polygon(0 100%, 50% 0, 100% 100%); }
  /* текст подрядчика разделами: заголовок раздела — как он написал, абзацы с воздухом */
  .pr__fields :global(.pr__sec + .pr__sec) { margin-top: var(--s-4); }
  .pr__fields :global(.pr__sec-t) { display: block; margin-bottom: var(--s-1); font-size: 17px; font-weight: 600; }
  .pr__fields :global(.pr__sec p) { margin: 0; white-space: pre-line; }
  .pr__fields :global(.pr__sec p + p) { margin-top: var(--s-2); }
  /* окно «Вернуть на доработку»: подпись, поле, кнопки — внутренние 8, до кнопок 16 */
  :global(.c-dialog__body.pr-why) { gap: var(--s-2); }
  :global(.pr-why .a-input) { width: 100%; resize: vertical; min-height: 120px; height: auto; padding: var(--s-3); font-size: 16px; line-height: 1.4; }
  :global(.pr-why .a-field__label) { margin-top: var(--s-2); }
  :global(.pr-why__acts) { display: grid; gap: var(--s-2); margin-top: var(--s-2); }
  .pr__error { color: var(--st-bad-text); font-size: var(--fs-small); white-space: pre-line; }
</style>

<script>
  import { api, esc, fileToken, fileUrl, requireSession, REV_STATUS, errText } from '../../../../lib/cabinet-api';
  import { VENUE_QUESTIONS, VENUE_TERMS, priceFrom, rub } from '../../../../lib/cabinet-form';
  import { later, openDialog, X_ICON } from '../../../../lib/cab-ui';
  import { markSeen } from '../../../../lib/admin-live';
  import { fieldError, clearFieldError } from '../../../../lib/form-check';

  const LABELS: [string, string][] = [
    ['name', 'Название'], ['tagline', 'Строка под именем'], ['intro', 'Коротко о себе (первый абзац)'], ['address', 'Адрес'], ['mapsUrl', 'Яндекс Карты'], ['rentFrom', 'Аренда от'],
    ['checkFrom', 'Средний чек от'], ['capacityBanquet', 'Гостей до'], ['about', 'О себе'], ['priceFrom', 'Цена от'], ['priceNote', 'Цена указана за'],
  ];
  /** ответ на вопрос словами: значения фильтра → подписи вариантов */
  const MONEY_KEYS = ['rentFrom', 'checkFrom', 'priceFrom'];
  // «пусто» — обычным весом, чтобы не читалось присланным текстом (06.11)
  const EMPTY = '<span class="pr__empty">пусто</span>';
  const answers = (qs: any[], key: string, v: unknown): string[] => {
    const q = qs.find((x) => x.key === key);
    const vals = ([] as unknown[]).concat(v ?? []).map(String).filter(Boolean);
    return vals.map((x) => q?.options.find((o: any) => o.value === x)?.label ?? x);
  };
  const answer = (qs: any[], key: string, v: unknown) => answers(qs, key, v).join(', ');

  document.addEventListener('astro:page-load', async () => {
    const root = document.querySelector<HTMLElement>('[data-pr]');
    if (!root) return;
    const s = requireSession('moderator');
    if (!s) return;
    const roles = JSON.parse(root.dataset.roles!);
    const $ = <T extends HTMLElement>(sel: string) => document.querySelector<T>(sel)!;
    const error = $('[data-pr-error]');
    const fail = (m: string) => { error.textContent = m; error.hidden = false; };
    const id = new URLSearchParams(location.search).get('id') || '';

    // когда решили: «сегодня в 17:04», «вчера в 9:30», «5 нояб. в 14:20» — со временем всегда
    const when = (d: string) => {
      const t = new Date(String(d).replace(' ', 'T'));
      const time = t.toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit' });
      const day = new Date(); day.setHours(0, 0, 0, 0);
      const diff = Math.round((day.getTime() - new Date(t).setHours(0, 0, 0, 0)) / 864e5);
      return `${diff === 0 ? 'сегодня' : diff === 1 ? 'вчера' : t.toLocaleDateString('ru-RU', { day: 'numeric', month: 'short' })} в\u00a0${time}`;
    };
    // плашка решения: без плашки-статуса внутри — цвет плашки уже говорит «вернули / одобрили»
    // (Никита 06.11: «пилюля в плашке»); заголовком — что и когда, ниже текст модератора
    const decision = (status: string, at: string, reason?: string) => {
      const what = status === 'rejected' ? 'Вернули' : status === 'approved' ? 'Одобрили' : REV_STATUS[status]?.label ?? '';
      const text = status === 'rejected' ? esc(reason || '') : status === 'approved' ? 'Карточка опубликована — на сайте видна сразу' : '';
      return `<span class="pr__state-h">${what} ${when(at)}</span>${text ? `<span class="pr__state-text">${text}</span>` : ''}`;
    };

    // НЕ ЗАКОНЧЕНА → «Связаться» (Никита 07.11): из «Можно написать» модератор приходит сюда, чтобы напомнить
    // подрядчику. Контакты — из учётки (почта регистрации, телефон, привязанный Telegram) и из раздела
    // «Контакты» анкеты, если уже вписаны. Что есть — кнопками, по одной на способ
    const contactBox = (r: any) => {
      const o = r.expand?.owner ?? {};
      const c = r.data?.contacts ?? {};
      const days = Math.max(0, Math.round((Date.now() - new Date(String(r.updated).replace(' ', 'T')).getTime()) / 864e5));
      const digits = (v: string) => String(v || '').replace(/[^\d+]/g, '');
      const phone = digits(c.phone || o.phone || '');
      const tgUser = String(c.telegram || '').replace(/^@|^https?:\/\/t\.me\//, '').trim();
      const acts = [
        phone && `<a class="a-btn a-btn--lg a-btn--block" href="tel:${esc(phone)}">Позвонить</a>`,
        tgUser ? `<a class="a-btn a-btn--lg a-btn--block" href="https://t.me/${esc(tgUser)}" target="_blank" rel="noopener">Написать в Telegram</a>`
          : o.telegramId ? `<a class="a-btn a-btn--lg a-btn--block" href="tg://user?id=${esc(o.telegramId)}">Написать в Telegram</a>` : '',
        o.email && `<a class="a-btn a-btn--lg a-btn--block" href="mailto:${esc(o.email)}">Написать на почту</a>`,
      ].filter(Boolean);
      const pretty = (v: string) => { const m = v.replace(/\D/g, '').match(/^[78](\d{3})(\d{3})(\d{2})(\d{2})$/); return m ? `+7\u00a0${m[1]}\u00a0${m[2]}-${m[3]}-${m[4]}` : v; };
      const lines = [phone && esc(pretty(phone)), tgUser && `Telegram @${esc(tgUser)}`, !tgUser && o.telegramId && 'Telegram подключён', o.maxId && 'MAX подключён', o.email && esc(o.email)].filter(Boolean);
      return `<span class="pr__state-h pr__state-h--plain">Связаться</span>
        <span class="pr__state-text">${days ? `${days} ${days % 10 === 1 && days % 100 !== 11 ? 'день' : days % 10 >= 2 && days % 10 <= 4 && (days % 100 < 12 || days % 100 > 14) ? 'дня' : 'дней'} без правок` : 'Карточку заполняют сейчас'}. ${esc(o.name || 'Подрядчик')} ещё не отправил её на проверку</span>
        ${lines.length ? `<span class="pr__contacts">${lines.map((x) => `<span>${x}</span>`).join('')}</span>` : '<span class="pr__state-text">Контактов пока нет — подрядчик их ещё не вписал</span>'}
        ${acts.length ? `<span class="pr__contact-acts">${acts.join('')}</span>` : ''}`;
    };

    let rev: any;
    async function render() {
      rev = await api('moderator', 'GET', `/api/collections/revisions/records/${encodeURIComponent(id)}?expand=owner`);
      const cardId = rev.venue || rev.specialist;
      let was: any = null;
      if (cardId) {
        const card = await api('moderator', 'GET', `/api/collections/${rev.kind === 'venue' ? 'venues' : 'specialists'}/records/${cardId}`);
        // у карточки из кабинета прежние ответы лежат в page; у карточек
        // конвейера — только плоские поля
        was = card.page?.source === 'cabinet' ? card.page : card;
        // «ведём мы»: прежнее «Коротко о себе» лежит в анкете карточки (07.11)
        if (card.form?.managed) was = { ...was, intro: card.form.intro ?? '' };
      }
      markSeen(rev.id, rev.updated);
      const d = rev.data ?? {};
      const role = rev.kind === 'venue' ? 'Площадка' : roles[rev.categorySlug] ?? rev.categorySlug;
      $('[data-pr-title]').textContent = d.name || 'Без названия';
      if (!cardId) {
        $<HTMLAnchorElement>('[data-pr-back]').href = '/profi/admin/zayavki/';
        $('[data-pr-back-label]').textContent = 'Заявки';
      }
      // без точек-разделителей (Никита 05.11): что это — первой строкой, кто прислал — второй
      $('[data-pr-lead]').innerHTML = `${esc(role)}, ${cardId ? 'правка опубликованной карточки' : 'новая карточка'}<br>Прислал(а): ${esc(rev.expand?.owner?.name || rev.expand?.owner?.email || 'без имени')}`;

      // Яндекс Карты лежат в контактах (contacts.maps, 08.11) — показываем строкой рядом с адресом
      const val = (o: any, k: string) => (k === 'mapsUrl' ? o?.contacts?.maps : o?.[k]) ?? '';
      const rows = LABELS.filter(([k]) => val(d, k) !== '' || (was && val(was, k) !== '')).map(([k, label]) => {
        const now = String(val(d, k));
        const before = was ? String(val(was, k)) : null;
        const changed = before !== null && before !== now;
        // суммы — с разрядами и ₽ (правило 24)
        // ссылка на Яндекс Карты — открывается: по ней модератор ставит точку и берёт отзывы (08.11)
        const fmt = (v: string) => (MONEY_KEYS.includes(k) && Number(v) > 0 ? rub(Number(v))
          : k === 'mapsUrl' && /^https:\/\//.test(v) ? `<a class="c-link" href="${esc(v)}" target="_blank" rel="noopener noreferrer">${esc(v)}</a>` : esc(v));
        return `<dt>${label}</dt><dd>${changed ? `<span class="pr__was">${fmt(before!) || EMPTY}</span><span class="pr__now">${fmt(now) || EMPTY}</span>` : fmt(now) || EMPTY}</dd>`;
      });
      // текст разделами — как написал подрядчик
      // одной строкой «Описание»: заголовки разделов — как написал подрядчик, абзацы отдельно
      // (было «Текст: Что беру на себя» — непонятная метка, Никита 06.11)
      const secs = (d.sections ?? []).filter((x: any) => String(x?.body ?? '').trim());
      if (secs.length) rows.push(`<dt>Описание</dt><dd>${secs.map((x: any) => `<div class="pr__sec">${x.title ? `<span class="pr__sec-t">${esc(x.title)}</span>` : ''}${String(x.body).split(/\n\s*\n/).map((p: string) => `<p>${esc(p.replace(/^\s*>\s*/, '').trim())}</p>`).join('')}</div>`).join('')}</dd>`);
      const qs = rev.kind === 'venue' ? VENUE_QUESTIONS : JSON.parse(root.dataset.questions!)[rev.categorySlug] ?? [];
      const answered = qs.filter((q: any) => answer(qs, q.key, d.filters?.[q.key]));
      // ответы таблицей (Никита 06.11): вопрос слева, ответ справа, строки через тонкую линию;
      // несколько вариантов — каждый своей строкой в правой колонке
      const vals = (q: any) => answers(qs, q.key, d.filters[q.key]).map((x: string) => `<span>${esc(x)}</span>`).join('');
      if (qs.length) rows.push(`<dt>Вопросы: ${answered.length} из ${qs.length}</dt><dd>${answered.length ? `<span class="pr__qt">${answered.map((q: any) => `<span class="pr__q"><span class="pr__q-l">${esc(q.label)}</span><span class="pr__q-v">${vals(q)}</span></span>`).join('')}</span>` : EMPTY}</dd>`);
      const tariffs = (d.tariffs ?? []).filter((t: any) => t?.name || t?.price);
      if (tariffs.length) {
        const p = priceFrom(d);
        rows.push(`<dt>Тарифы${p ? `, в каталоге от ${rub(p)}` : ''}</dt><dd>${tariffs.map((t: any) => `<span class="pr__tariff"><span class="pr__tn">${esc(t.name)}</span> — ${t.price ? rub(Number(t.price)) : 'без цены'}${t.includes ? `\n${esc(t.includes)}` : ''}</span>`).join('')}</dd>`);
      }
      const halls = (d.halls ?? []).filter((h: any) => h?.name);
      if (halls.length) rows.push(`<dt>Залы</dt><dd>${halls.map((h: any) => `<span class="pr__tn">${esc(h.name)}</span> — банкет до ${esc(h.banquet || '—')}, фуршет до ${esc(h.buffet || '—')}${h.area ? `, ${esc(h.area)} м²` : ''}${h.priceFrom ? `, от ${rub(Number(h.priceFrom))}` : ''}${h.note ? `\n${esc(h.note)}` : ''}`).join('\n\n')}</dd>`);
      if (rev.kind === 'venue') {
        const t = d.terms ?? {};
        const lines = [
          ...VENUE_TERMS.map((q) => `${q.label}: ${answer(VENUE_TERMS, q.key, t[q.key]) || 'пусто'}`),
          t.until && `До скольки: ${t.until}`, t.parking && `Парковка: ${t.parking}`, t.more,
        ].filter(Boolean);
        rows.push(`<dt>Условия</dt><dd>${esc(lines.join('\n'))}</dd>`);
      }
      // ссылки на ролики: ролик готовим и ставим сами (docs/VIDEO.md), на сайт ссылка не идёт
      const videos = (d.videos ?? []).map((v: any) => String(v?.url ?? '').trim()).filter((u: string) => /^https?:\/\//.test(u));
      if (videos.length) rows.push(`<dt>Видео — подготовить по docs/VIDEO.md</dt><dd>${videos.map((u: string) => `<a href="${esc(u)}" target="_blank" rel="noopener noreferrer">${esc(u)}</a>`).join('\n')}</dd>`);
      const c = d.contacts ?? {};
      // контакты — каждый своей строкой с воздухом между ними (Никита 06.11: «слиплось»), телефон с пробелами
      const tel = (v: string) => { const m = String(v).replace(/\D/g, '').match(/^7(\d{3})(\d{3})(\d{2})(\d{2})$/); return m ? `+7\u00a0${m[1]}\u00a0${m[2]}-${m[3]}-${m[4]}` : v; };
      const cs = [c.phone && tel(c.phone), c.telegram && `Telegram ${c.telegram}`, c.max && `MAX ${tel(c.max)}`, c.site, c.email].filter(Boolean) as string[];
      rows.push(`<dt>Контакты (скрыты, за кнопкой)</dt><dd>${cs.map((x) => `<span class="pr__line">${esc(x)}</span>`).join('') || EMPTY}</dd>`);
      // карточка «ведём мы» (пилот, 03.11): одобрение меняет только цену,
      // вопросы, контакты и видео; текст и фото — просьбы, делаем руками в JSON
      if (d.managed) {
        const r = d.requests ?? {};
        const asks = [r.text && `Текст: ${r.text}`, r.photos && `Фото: ${r.photos}`].filter(Boolean);
        rows.unshift(`<dt>Ведём мы — основной текст правим мы</dt><dd>${asks.length ? `Просит поправить — сделать руками в src/data/specialists/${esc(rev.categorySlug)}/${esc(rev.slug)}.json:\n${esc(asks.join('\n'))}` : 'Просьб нет.'}</dd>`);
      }
      // портрет владелец ставит сам (07.11, и «ведём мы», и обычная анкета)
      if (rev.avatar) {
        const at = await fileToken('moderator');
        rows.push(`<dt>Портрет</dt><dd><a href="${fileUrl(rev, rev.avatar, { token: at })}" target="_blank" rel="noopener"><img class="pr__ava" src="${fileUrl(rev, rev.avatar, { thumb: '200x200', token: at })}" alt="" /></a></dd>`);
      }
      $('[data-pr-fields]').innerHTML = rows.join('');

      const token = rev.photos?.length ? await fileToken('moderator') : '';
      $('[data-pr-photo-n]').textContent = String(rev.photos?.length ?? 0);
      $('[data-pr-photos]').innerHTML = (rev.photos ?? []).map((n: string) =>
        `<li><a href="${fileUrl(rev, n, { token })}" target="_blank" rel="noopener"><img src="${fileUrl(rev, n, { thumb: '400x0', token })}" alt="" loading="lazy" /></a></li>`).join('');

      $('[data-pr-state]').dataset.st = rev.status;
      $('[data-pr-state]').innerHTML = rev.status === 'review' ? '' : rev.status === 'draft' ? contactBox(rev) : decision(rev.status, rev.reviewedAt || rev.updated, rev.rejectReason);
      $('[data-pr-acts]').hidden = rev.status !== 'review';
    }

    // Решение видно сразу, в базу уходит через 6 секунд — успеваете «Отменить»
    // (как отмена отправки в почте). Подрядчику уведомление уходит из хука
    // только после записи — отменённое решение до него не доходит.
    function act(body: Record<string, string>, text: string) {
      error.hidden = true;
      const acts = $('[data-pr-acts]');
      const state = $('[data-pr-state]');
      const before = state.innerHTML;
      const beforeSt = state.dataset.st ?? '';
      acts.hidden = true;
      state.dataset.st = body.status;
      state.innerHTML = decision(body.status, new Date().toISOString(), body.rejectReason);
      // плашка решения — к середине экрана: тост «Отменить» внизу её не закрывает (Никита 06.11)
      state.scrollIntoView({ behavior: 'smooth', block: 'center' });
      later({
        text,
        undo: () => { state.innerHTML = before; state.dataset.st = beforeSt; acts.hidden = false; },
        run: async () => {
          try {
            await api('moderator', 'PATCH', `/api/collections/revisions/records/${rev.id}`, body, { keepalive: true });
          } catch (err) {
            fail(errText(err));
          }
          try { await render(); } catch {}
        },
      });
    }

    $('[data-pr-approve]').addEventListener('click', () => act({ status: 'approved' }, 'Одобрено'));
    // причина — в окне (HIG: Sheets): подпись, поле и две кнопки одной ширины столбиком
    $('[data-pr-reject]').addEventListener('click', () => {
      const { dlg, close } = openDialog({ html: `
        <div class="c-dialog__body pr-why">
          <button class="c-dialog__x" type="button" data-close aria-label="Закрыть">${X_ICON}</button>
          <h2 class="a-h2">Вернуть с причиной</h2>
          <label class="a-field__label" for="pr-reason">Напишите, что исправить</label>
          <textarea class="a-input" id="pr-reason" rows="5" placeholder="Например: на двух кадрах чужой логотип — уберите их" data-pr-reason></textarea>
          <div class="pr-why__acts">
            <button class="a-btn a-btn--primary a-btn--lg a-btn--block" type="button" data-pr-send>Отправить</button>
            <button class="a-btn a-btn--lg a-btn--block" type="button" data-close>Отмена</button>
          </div>
        </div>` });
      const ta = dlg.querySelector<HTMLTextAreaElement>('[data-pr-reason]')!;
      ta.addEventListener('input', () => clearFieldError(ta as unknown as HTMLInputElement));
      ta.focus();
      dlg.querySelector('[data-pr-send]')!.addEventListener('click', () => {
        const reason = ta.value.trim();
        // ошибка поля — облачком у поля (правило «где какая ошибка»)
        if (!reason) return fieldError(ta as unknown as HTMLInputElement, 'Напишите, что исправить — без этого подрядчик не поймёт, что делать');
        close();
        act({ status: 'rejected', rejectReason: reason }, 'Вернули с причиной');
      });
    });

    try { await render(); } catch (err) { fail(errText(err)); }
  });
</script>
