---
// НАСТРОЙКИ — четыре раздела одной страницей, вкладки ведут к якорям:
// модераторы и права, правила автопроверки (CABINET.md §12.3), письма
// подрядчику (§21), журнал действий. ЗАГЛУШКИ admin-demo.ts.
import AdminShell from '../../../components/admin/AdminShell.astro';
import AdminIcon from '../../../components/admin/AdminIcon.astro';
import { AUDIT, LETTERS, MODERATORS, RULES } from '../../../data/admin-demo';
---

<AdminShell title="Настройки" section="settings">
  <nav class="a-tabs" aria-label="Разделы настроек">
    <a class="a-tabs__item is-active" href="#moderators">Модераторы</a>
    <a class="a-tabs__item" href="#rules">Автопроверка</a>
    <a class="a-tabs__item" href="#letters">Письма</a>
    <a class="a-tabs__item" href="#audit">Журнал действий</a>
  </nav>

  <h1 class="a-h1">Настройки</h1>

  <section class="a-card a-card--flush" id="moderators">
    <div class="a-card__head">
      <h2 class="a-h2">Модераторы и права</h2>
      <button class="a-btn a-btn--primary" type="button"><AdminIcon name="plus" /> Добавить</button>
    </div>
    <table class="a-table a-table--cards">
      <thead><tr><th>Имя</th><th>Роль</th><th>Что может</th><th>Был</th></tr></thead>
      <tbody>
        {MODERATORS.map((m) => (
          <tr><td class="a-name">{m.name}</td><td data-l="Роль">{m.role}</td><td>{m.rights}</td><td data-l="Был">{m.last}</td></tr>
        ))}
      </tbody>
    </table>
  </section>

  <section class="a-card a-card--flush" id="rules">
    <div class="a-card__head">
      <h2 class="a-h2">Правила автопроверки</h2>
      <span class="a-lead">скрипт не режет текст — только не пускает или ставит в «Ждут решения»</span>
    </div>
    <table class="a-table a-table--cards">
      <thead><tr><th>Включено</th><th>Правило</th><th>Что делает</th><th class="a-num">Сработало за неделю</th></tr></thead>
      <tbody>
        {RULES.map((r) => (
          <tr>
            <td><label class="sw"><input type="checkbox" checked={r.on} aria-label={r.name} /><span></span></label></td>
            <td>{r.name}</td>
            <td data-l="Что делает">{r.action}</td>
            <td class="a-num" data-l="Сработало">{r.hits}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <section class="a-card a-card--flush" id="letters">
    <div class="a-card__head">
      <h2 class="a-h2">Письма подрядчику</h2>
      <span class="a-lead">системные — уходят сами; маркетинговые — только с согласия</span>
    </div>
    <table class="a-table a-table--cards">
      <thead><tr><th>Письмо</th><th>Когда уходит</th><th class="a-num">Отправлено за неделю</th><th></th></tr></thead>
      <tbody>
        {LETTERS.map((l) => (
          <tr><td class="a-name">{l.name}</td><td data-l="Когда">{l.when}</td><td class="a-num" data-l="Отправлено">{l.sent}</td><td><span class="a-btn a-btn--soft">Изменить текст</span></td></tr>
        ))}
      </tbody>
    </table>
  </section>

  <section class="a-card a-card--flush" id="audit">
    <div class="a-card__head">
      <h2 class="a-h2">Журнал действий</h2>
      <span class="a-lead">кто что одобрил, вернул, скрыл — для разбора споров и отката</span>
    </div>
    <table class="a-table a-table--cards">
      <thead><tr><th>Когда</th><th>Кто</th><th>Что сделал</th><th>С чем</th></tr></thead>
      <tbody>
        {AUDIT.map((a) => (
          <tr><td>{a.at}</td><td class="a-name">{a.who}</td><td>{a.what}</td><td data-l="С чем">{a.target}</td></tr>
        ))}
      </tbody>
    </table>
  </section>
</AdminShell>

<script>
  // Вкладки-якоря: подсвечиваем ту, что нажали (прокрутка — браузером)
  const tabs = [...document.querySelectorAll<HTMLElement>('.a-tabs__item')];
  tabs.forEach((t) => t.addEventListener('click', () => tabs.forEach((x) => x.classList.toggle('is-active', x === t))));
</script>

<style>
  [id] { scroll-margin-top: calc(var(--adm-head-h) + 8px); }
  /* Переключатель (Директ) */
  .sw { position: relative; display: inline-block; width: 36px; height: 20px; cursor: pointer; }
  .sw input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .sw span { position: absolute; inset: 0; border-radius: 10px; background: #c9ced6; transition: background 0.15s; }
  .sw span::after { content: ''; position: absolute; top: 2px; left: 2px; width: 16px; height: 16px; border-radius: 50%; background: #fff; transition: transform 0.15s var(--ease-out); }
  .sw input:checked + span { background: var(--adm-primary); }
  .sw input:checked + span::after { transform: translateX(16px); }
  .sw input:focus-visible + span { outline: 2px solid var(--adm-primary); outline-offset: 2px; }
</style>
