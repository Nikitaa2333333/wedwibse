---
// ВХОД В АДМИНКУ — почта и пароль учётки `moderators` (заводит
// суперпользователь: node scripts/pb-cabinet-setup.mjs). Отдельный экран
// без меню разделов: до входа их нечего показывать. Уже вошли — сразу
// в модерацию; выйти — ссылкой в шапке админки (AdminShell).
import AdminShell from '../../../components/admin/AdminShell.astro';
---

<AdminShell title="Вход" bare>
  <section class="a-card a-login">
    <div class="a-login__head">
      <h1 class="a-h1">Вход в админку</h1>
      <p class="a-lead">Для модераторов Wed Secrets</p>
    </div>
    <form class="a-login__form" data-mod-login novalidate>
      <label class="a-field">
        <span class="a-field__label">Почта</span>
        <input class="a-field__input" type="email" name="email" autocomplete="username" inputmode="email" autocapitalize="off" spellcheck="false" required />
      </label>
      <label class="a-field">
        <span class="a-field__label">Пароль</span>
        <input class="a-field__input" type="password" name="password" autocomplete="current-password" required />
      </label>
      <p class="a-login__error" role="alert" data-mod-error hidden></p>
      <button class="a-btn a-btn--primary a-btn--lg a-btn--block" type="submit">Войти</button>
    </form>
    <p class="a-login__note">Нет доступа или забыли пароль — напишите Никите.</p>
  </section>
</AdminShell>

<script>
  import { api, session, saveSession, type ApiError } from '../../../lib/cabinet-api';

  const target = () => {
    const next = new URLSearchParams(location.search).get('next');
    return next && next.startsWith('/profi/admin/') ? next : '/profi/admin/moderaciya/';
  };

  document.addEventListener('astro:page-load', () => {
    const form = document.querySelector<HTMLFormElement>('[data-mod-login]');
    if (!form) return;
    if (session('moderator')) { location.replace(target()); return; }
    const error = form.querySelector<HTMLElement>('[data-mod-error]')!;
    const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const fields = [...form.querySelectorAll<HTMLInputElement>('input')];
    const fail = (msg: string) => {
      error.textContent = msg;
      error.hidden = false;
      fields.forEach((f) => f.setAttribute('aria-invalid', 'true'));
    };
    fields.forEach((f) => f.addEventListener('input', () => { error.hidden = true; f.removeAttribute('aria-invalid'); }));

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const email = String(fd.get('email') || '').trim();
      const password = String(fd.get('password') || '');
      if (!email || !password) return fail('Введите почту и пароль.');
      btn.disabled = true;
      btn.textContent = 'Входим…';
      try {
        const r = await api(null, 'POST', '/api/collections/moderators/auth-with-password', { identity: email, password });
        saveSession('moderator', { token: r.token, record: r.record });
        location.href = target();
      } catch (err) {
        const st = (err as ApiError).status;
        fail(st === 400 ? 'Неверная почта или пароль.' : st === 429 ? 'Слишком много попыток — подождите пару минут.' : 'Не получилось войти: ' + (err as Error).message);
        btn.disabled = false;
        btn.textContent = 'Войти';
      }
    });
  });
</script>
