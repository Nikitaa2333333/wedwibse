---
// ЗАЯВКИ ПАРТНЁРОВ — подрядчики и площадки, которые хотят на сайт: завели
// учётку и заполняют анкету новой карточки. Вкладки: «Проверить» —
// отправили, ждут решения (срок 24 ч); «Не закончили» — звоним или пишем;
// «Вернули», «Опубликованы», «Отклонены». В строке — кто, сколько
// заполнено и срок справа; что именно пусто — на экране заявки (27.10). Сейчас — примеры (partner-demo.ts);
// вживую — `vendors` + `revisions` первой публикации.
import AdminShell from '../../../../components/admin/AdminShell.astro';
import AdminIcon from '../../../../components/admin/AdminIcon.astro';
import { APP_STATUS, PARTNER_APPS, type AppStatus } from '../../../../data/partner-demo';

const tabs: AppStatus[] = ['review', 'draft', 'returned', 'approved', 'rejected'];
const count = (s: AppStatus) => PARTNER_APPS.filter((a) => a.status === s).length;
---

<AdminShell title="Заявки" section="partners">
  <div class="a-title">
    <h1 class="a-h1">Заявки</h1>
  </div>

  <section class="a-card a-card--flush">
    <nav class="a-tabs" aria-label="Статус заявки">
      {tabs.map((t) => (
        <a class:list={['a-tabs__item', { 'is-active': t === 'review' }]} href={`#${t}`} data-filter-tab="ap" data-value={t}>
          {APP_STATUS[t].tab} <span class:list={['a-tabs__n', { 'a-tabs__n--bad': t === 'review' && count(t) > 0 }]}>{count(t)}</span>
        </a>
      ))}
      <a class="a-tabs__item" href="#all" data-filter-tab="ap" data-value="all">Все <span class="a-tabs__n">{PARTNER_APPS.length}</span></a>
    </nav>
    <div class="a-tools">
      <label class="a-search">
        <span class="visually-hidden">Поиск</span>
        <input class="a-input" type="search" placeholder="Имя или категория" data-filter-search="ap" />
        <AdminIcon name="search" />
      </label>
    </div>
    <div class="a-table-wrap">
      <table class="a-table a-table--cards" id="ap" data-atable data-tab-default="review">
        <tbody>
          {PARTNER_APPS.map((a) => {
            const href = `/profi/admin/zayavki/${a.id}/`;
            const st = APP_STATUS[a.status];
            const pct = Math.round((a.sections.filter((x) => x.done).length / a.sections.length) * 100);
            const late = a.status === 'review' && (a.waitingHours ?? 0) >= 20;
            return (
              <tr data-href={href} data-tab={a.status} data-text={`${a.name} ${a.category}`.toLowerCase()}>
                <td data-v={a.name}>
                  <a class="a-name a-task__title" href={href}>{a.name}</a>
                  <span class="a-sub"><span class={`a-dot ${st.dot ? `a-dot--${st.dot}` : ''}`}>{st.label}</span> · {a.category} · заполнено {pct} %</span>
                </td>
                <td class="a-num">
                  <span class:list={['ap__when', { 'ap__when--late': late }]}>
                    {a.status === 'review' && a.waitingHours !== undefined ? `${a.waitingHours} ч из 24` : a.lastEdit}
                  </span>
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
      <div class="a-empty" data-empty="ap" hidden>В этой вкладке пусто</div>
    </div>
  </section>
</AdminShell>

<style>
  #ap :global(td) { padding-block: 14px; vertical-align: middle; }
  .ap__when { font-weight: 500; white-space: nowrap; }
  .ap__when--late { color: var(--st-bad-text); }
</style>
