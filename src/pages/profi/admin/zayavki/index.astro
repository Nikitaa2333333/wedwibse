---
// ЗАЯВКИ — НОВЫЕ карточки из кабинета: подрядчик или площадка завели учётку
// и заполняют анкету (ревизия без venue/specialist). Вкладки: «На проверке» —
// отправили, ждут решения (срок 24 ч); «Не закончили» — звоним или пишем;
// «Вернули» — ждём исправления. Правки уже опубликованных — в «Модерации».
// Данные из базы (lib/admin-live.ts, 05.11.2026); демо-примеров больше нет.
// Строка ведёт на разбор /moderaciya/pravka/?id= — экран один на оба случая.
import AdminShell from '../../../../components/admin/AdminShell.astro';
import AdminIcon from '../../../../components/admin/AdminIcon.astro';

const tabs = [
  { v: 'review', label: 'На проверке' },
  { v: 'draft', label: 'Не закончили' },
  { v: 'rejected', label: 'Вернули' },
  { v: 'all', label: 'Все' },
];
---

<AdminShell title="Заявки" section="partners">
  <div class="a-title">
    <h1 class="a-h1">Заявки</h1>
  </div>

  <section class="a-card a-card--flush">
    <nav class="a-tabs" aria-label="Статус заявки">
      {tabs.map((t) => (
        <a class:list={['a-tabs__item', { 'is-active': t.v === 'review' }]} href={`#${t.v}`} data-filter-tab="ap" data-value={t.v}>
          {t.label} <span class="a-tabs__n" data-ap-n={t.v}></span>
        </a>
      ))}
    </nav>
    <div class="a-tools">
      <label class="a-search">
        <span class="visually-hidden">Поиск</span>
        <input class="a-input" type="search" placeholder="Название или имя" data-filter-search="ap" />
        <AdminIcon name="search" />
      </label>
    </div>
    <div class="a-table-wrap">
      <table class="a-table a-table--cards" id="ap" data-atable data-pending data-tab-default="review">
        <tbody data-ap-rows></tbody>
      </table>
      <div class="a-empty" data-empty="ap" hidden>В этой вкладке пусто. Новые карточки появятся здесь, когда подрядчик заведёт их в кабинете</div>
      <div data-ap-state><div class="sk-row"><span class="sk sk--thumb"></span><span class="sk-row__body"><span class="sk sk--line"></span><span class="sk sk--line sk--short"></span></span><span class="sk sk--pill"></span></div><div class="sk-row"><span class="sk sk--thumb"></span><span class="sk-row__body"><span class="sk sk--line"></span><span class="sk sk--line sk--short"></span></span><span class="sk sk--pill"></span></div><div class="sk-row"><span class="sk sk--thumb"></span><span class="sk-row__body"><span class="sk sk--line"></span><span class="sk sk--line sk--short"></span></span><span class="sk sk--pill"></span></div></div>
    </div>
  </section>
</AdminShell>

<script>
  import { requireSession, errText, esc } from '../../../../lib/cabinet-api';
  import { loadRevisions, isNew, leftMin, taskRow, failBox } from '../../../../lib/admin-live';

  const TASK: Record<string, { task: string; tone: 'check' | 'wait' | 'bad' }> = {
    review: { task: 'Проверить', tone: 'check' },
    draft: { task: 'Не закончена', tone: 'wait' },
    rejected: { task: 'Вернули', tone: 'bad' },
  };

  async function render(force = false) {
    const body = document.querySelector<HTMLElement>('[data-ap-rows]');
    const state = document.querySelector<HTMLElement>('[data-ap-state]');
    if (!body || !state) return;
    try {
      const revs = (await loadRevisions(force)).filter((r) => isNew(r) && TASK[r.status]);
      // горящий срок — первым, черновики — по свежести
      revs.sort((a, b) => (leftMin(a) ?? Infinity) - (leftMin(b) ?? Infinity));
      body.innerHTML = revs.map((r) => {
        const t = TASK[r.status];
        const text = `${r.data?.name ?? ''} ${r.expand?.owner?.name ?? ''} ${r.expand?.owner?.email ?? ''}`.toLowerCase();
        return `<tr data-tab="${r.status}" data-text="${esc(text)}"><td class="a-task-cell">${taskRow(r, { ...t, fill: r.status === 'draft' })}</td></tr>`;
      }).join('');
      for (const v of ['review', 'draft', 'rejected', 'all']) {
        const n = v === 'all' ? revs.length : revs.filter((r) => r.status === v).length;
        const el = document.querySelector<HTMLElement>(`[data-ap-n="${v}"]`);
        if (el) { el.textContent = String(n); el.classList.toggle('a-tabs__n--bad', v === 'review' && n > 0); }
      }
      state.innerHTML = '';
      const table = document.querySelector('#ap')!;
      table.removeAttribute('data-pending');
      table.dispatchEvent(new Event('atable:refresh'));
    } catch (err) {
      body.innerHTML = '';
      state.innerHTML = failBox(`Не загрузилось. ${errText(err)}`);
    }
  }

  document.addEventListener('astro:page-load', () => {
    const state = document.querySelector<HTMLElement>('[data-ap-state]');
    if (!state || !requireSession('moderator')) return;
    state.onclick = (e) => { if ((e.target as HTMLElement).closest('[data-retry]')) render(true); };
    render();
  });
</script>
