---
// КАРТОЧКИ (Евгений, 10.11.2026): первым экраном три плитки — «На сайте»,
// «Заявки скрыты», «Архив». Под плитками — карточки выбранной плитки:
// вкладки по всем разделам (Площадки, Организаторы, Ведущие, Декораторы…),
// без вкладки «Все» («очень длинная портянка»), и поиск по названию или
// категории (ищет по всем разделам плитки сразу).
// Данные — из базы, она единственный источник сайта (lib/live-data.ts):
//   «На сайте» — status = published; «Архив» — status = archived.
//   «Заявки скрыты» — карточка в порядке, но баланса не хватает на заявки.
//   Баланса пока нет (третий этап, docs/DECISIONS.md «Деньги»), поэтому
//   плитка честно показывает «нет данных», а не ноль.
// Действия те же, что были (Никита, 02.11: «нужно удалять»): опубликованную —
// «Снять с сайта» (в архив), из архива — «Удалить совсем»; новую, ещё не
// одобренную — «Удалить». Сразу, с «Отменить» на 6 секунд (lib/cab-ui.ts →
// later), запрос уходит потом. Маршрут — POST /api/wed/mod/remove.
import AdminShell from '../../../components/admin/AdminShell.astro';
import AdminIcon from '../../../components/admin/AdminIcon.astro';
import { SPECIALIST_CATEGORIES } from '../../../data/specialists';

// вкладки — все разделы сайта в порядке каталога; площадки первыми
const CATS = [
  { slug: 'venue', label: 'Площадки', role: 'Площадка' },
  ...SPECIALIST_CATEGORIES.map((c) => ({ slug: c.slug, label: c.label, role: c.role })),
];
const skRow = '<div class="sk-row"><span class="sk sk--thumb"></span><span class="sk-row__body"><span class="sk sk--line"></span><span class="sk sk--line sk--short"></span></span><span class="sk sk--pill"></span></div>';
---

<AdminShell title="Карточки" section="catalog">
  <div class="a-title">
    <h1 class="a-h1">Карточки</h1>
  </div>

  <div data-cards data-cats={JSON.stringify(CATS)}>
    <div class="a-tiles a-tiles--3" data-cards-tiles role="group" aria-label="Состояние карточек">
      <div class="sk-card a-card a-card--flush" aria-busy="true" aria-label="Загружаем" set:html={skRow} />
    </div>

    <section class="a-card a-card--flush a-card--far" data-cards-box hidden>
      {/* обёртка без своего display: у .a-tabs и .a-tools он flex и перебивает hidden */}
      <div data-cards-filters>
        <nav class="a-tabs" aria-label="Разделы" data-cards-tabs></nav>
        <div class="a-tools">
          <label class="a-search">
            <span class="visually-hidden">Поиск</span>
            <input class="a-input" type="search" placeholder="Название или категория" data-cards-q />
            <AdminIcon name="search" />
          </label>
        </div>
      </div>
      <div class="a-tasks" data-cards-list></div>
    </section>

    {/* новые из кабинета, ещё не одобренные: их можно только удалить */}
    <section class="a-card a-card--flush a-card--far" data-cards-new-box hidden>
      <div class="a-card__head"><h2 class="a-h2">Ещё не на сайте</h2></div>
      <p class="a-sub a-card__note">Подрядчик завёл карточку в кабинете, модератор её ещё не одобрил</p>
      <div class="a-tasks" data-cards-new></div>
    </section>
  </div>
</AdminShell>

<style>
  /* три плитки в ряд и на телефоне: подписи короткие, число крупно */
  .a-tiles--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .a-tiles--3 :global(.a-tile) { min-height: 96px; padding: 12px; font: inherit; text-align: left; border: 0; cursor: pointer; }
  .a-tiles--3 :global(.a-tile__label) { font-size: 14px; }
  @media (min-width: 768px) {
    .a-tiles--3 :global(.a-tile) { padding: 14px 16px; }
    .a-tiles--3 :global(.a-tile__label) { font-size: 15px; }
  }
  .a-tiles--3 > :global(.sk-card), .a-tiles--3 > :global(.a-cards-fail) { grid-column: 1 / -1; }
  /* выбранная плитка — чернилами, как выбранный сегмент (.a-seg): видно, чей список ниже */
  .a-tiles--3 :global(.a-tile[aria-pressed='true']),
  .a-tiles--3 :global(.a-tile[aria-pressed='true'] .a-tile__ic),
  .a-tiles--3 :global(.a-tile[aria-pressed='true'] .a-tile__n) { background: var(--adm-text); color: var(--adm-card); }
  .a-tiles--3 :global(.a-tile[aria-pressed='true'] .a-tile__ic) { background: none; }
  :global(.a-cabrow a.a-task__name) { color: inherit; text-decoration: none; }
  @media (hover: hover) { :global(.a-cabrow a.a-task__name:hover) { text-decoration: underline; } }
  :global(.a-cards-empty) { padding: var(--s-5) var(--adm-pad); }
</style>

<script>
  import { api, esc, requireSession, errText } from '../../../lib/cabinet-api';
  import { later, toast } from '../../../lib/cab-ui';
  import { failBox, coverHtml, coverToken } from '../../../lib/admin-live';
  import { ADMIN_ICONS } from '../../../lib/admin-icons';

  type Seg = 'site' | 'hidden' | 'archive';
  interface Cat { slug: string; label: string; role: string }
  interface Card { rec: any; kind: 'venue' | 'specialist'; name: string; cats: string[]; owned: boolean; text: string }

  const SEGS: { v: Seg; label: string; icon: keyof typeof ADMIN_ICONS; tone: string }[] = [
    { v: 'site', label: 'На сайте', icon: 'check', tone: 'ok' },
    { v: 'hidden', label: 'Заявки скрыты', icon: 'lock', tone: 'none' },
    { v: 'archive', label: 'Архив', icon: 'catalog', tone: 'none' },
  ];
  const REV: Record<string, string> = { draft: 'черновик', review: 'на проверке', rejected: 'вернули' };
  // список без тяжёлого page (до 2 МБ на карточку): обложка — первый кадр
  const FIELDS = 'id,collectionId,collectionName,slug,name,categorySlug,alsoCategories,status,owner,photos,updated';

  const ic = (name: keyof typeof ADMIN_ICONS) => `<svg viewBox="0 0 24 24" aria-hidden="true">${ADMIN_ICONS[name]}</svg>`;
  const url = (c: Card) => (c.kind === 'venue' ? `/moskva/ploshchadki/${c.rec.slug}/` : `/moskva/podryadchiki/${c.rec.categorySlug}/${c.rec.slug}/`);
  const btn = (label: string, what: string, id: string, mode = '') =>
    `<button type="button" class="c-chipbtn c-chipbtn--danger" data-rm="${what}" data-id="${id}" data-mode="${mode}">${label}</button>`;

  document.addEventListener('astro:page-load', () => {
    const root = document.querySelector<HTMLElement>('[data-cards]');
    if (!root || root.dataset.live || !requireSession('moderator')) return;
    root.dataset.live = '1';
    const CATS: Cat[] = JSON.parse(root.dataset.cats!);
    const catBy = new Map(CATS.map((c) => [c.slug, c]));
    const tilesEl = root.querySelector<HTMLElement>('[data-cards-tiles]')!;
    const box = root.querySelector<HTMLElement>('[data-cards-box]')!;
    const tabsEl = root.querySelector<HTMLElement>('[data-cards-tabs]')!;
    const listEl = root.querySelector<HTMLElement>('[data-cards-list]')!;
    const qEl = root.querySelector<HTMLInputElement>('[data-cards-q]')!;
    const filters = root.querySelector<HTMLElement>('[data-cards-filters]')!;
    const newBox = root.querySelector<HTMLElement>('[data-cards-new-box]')!;
    const newEl = root.querySelector<HTMLElement>('[data-cards-new]')!;

    const fromHash = location.hash.slice(1) as Seg;
    let seg: Seg = SEGS.some((s) => s.v === fromHash) ? fromHash : 'site';
    let tab = '';
    let query = '';
    let bySeg: Record<Seg, Card[]> = { site: [], hidden: [], archive: [] };

    const roleOf = (c: Card) => c.cats.map((s, i) => { const r = catBy.get(s)?.role ?? s; return i ? r.toLowerCase() : r; }).join(' и ');
    const row = (c: Card) => {
      const on = c.rec.status === 'published';
      const name = on ? `<a class="a-task__name" href="${url(c)}" target="_blank" rel="noopener">${esc(c.name)}</a>` : `<span class="a-task__name">${esc(c.name)}</span>`;
      const act = on ? btn('Снять с сайта', c.kind, c.rec.id, 'archive') : btn('Удалить совсем', c.kind, c.rec.id, 'delete');
      return `<div class="a-task a-cabrow">${coverHtml(c.rec, c.name)}`
        + `<span class="a-task__body">${name}<span class="a-task__fill">${esc(roleOf(c))}, ${c.owned ? 'ведёт владелец' : 'ведём мы'}</span></span>`
        + `<span class="a-cabrow__act">${act}</span></div>`;
    };

    const drawTiles = () => {
      const n: Record<Seg, number | null> = { site: bySeg.site.length, hidden: null, archive: bySeg.archive.length };
      const owned = bySeg.site.filter((c) => c.owned).length;
      const note: Record<Seg, string> = { site: owned ? `${owned} ведёт владелец` : '', hidden: 'нет данных', archive: '' };
      tilesEl.innerHTML = SEGS.map((s) => `<button type="button" class="a-tile${n[s.v] ? ` a-tile--${s.tone}` : ''}" data-seg="${s.v}" aria-pressed="${s.v === seg}">`
        + `<span class="a-tile__ic">${ic(s.icon)}</span><b class="a-tile__n">${n[s.v] ?? '—'}</b><span class="a-tile__label">${s.label}</span>`
        + `${note[s.v] ? `<span class="a-tile__note">${note[s.v]}</span>` : ''}</button>`).join('');
    };

    const drawList = () => {
      box.hidden = false;
      if (seg === 'hidden') {
        // баланса нет — показываем, что здесь будет, а не пустые вкладки
        filters.hidden = true;
        listEl.innerHTML = '<p class="a-empty a-cards-empty">Здесь будут карточки, у которых не хватает баланса на заявки: на сайте они есть, а заявки подрядчик не видит. Баланс появится вместе с оплатой</p>';
        return;
      }
      filters.hidden = false;
      const cards = bySeg[seg];
      const count = (slug: string) => cards.filter((c) => c.cats.includes(slug)).length;
      // по умолчанию — первый раздел, где есть карточки
      if (!tab || !catBy.has(tab)) tab = CATS.find((c) => count(c.slug))?.slug ?? CATS[0].slug;
      tabsEl.innerHTML = CATS.map((c) => {
        const k = count(c.slug);
        return `<a class="a-tabs__item${!query && c.slug === tab ? ' is-active' : ''}" href="#${seg}" data-tab="${c.slug}">${esc(c.label)} <span class="a-tabs__n">${k}</span></a>`;
      }).join('');
      // выбранная вкладка в полосе видна (в архиве первая непустая может стоять далеко справа)
      const act = tabsEl.querySelector<HTMLElement>('.is-active');
      tabsEl.scrollLeft = act ? Math.max(0, act.offsetLeft - tabsEl.offsetLeft - 16) : 0;
      // поиск — по всем разделам плитки: «декоратор» находит раздел целиком
      const shown = query ? cards.filter((c) => c.text.includes(query)) : cards.filter((c) => c.cats.includes(tab));
      listEl.innerHTML = shown.map(row).join('')
        || `<p class="a-empty a-cards-empty">${query ? 'Ничего не нашлось' : seg === 'archive' ? 'В архиве этого раздела пусто' : 'В этом разделе на сайте пока никого'}</p>`;
    };

    const load = async () => {
      try {
        const q = (coll: string, filter: string) =>
          api('moderator', 'GET', `/api/collections/${coll}/records?perPage=500&sort=name&fields=${FIELDS}&filter=${encodeURIComponent(filter)}`);
        const [specs, vens, revs] = await Promise.all([
          q('specialists', 'status = "published" || status = "archived"'),
          q('venues', 'status = "published" || status = "archived"'),
          api('moderator', 'GET', `/api/collections/revisions/records?perPage=200&sort=-updated&filter=${encodeURIComponent('venue = "" && specialist = "" && status != "approved"')}`),
        ]);
        // токен и для архива: файлы снятой карточки без него закрыты
        await coverToken([...specs.items, ...vens.items, ...revs.items]);
        const all: Card[] = [
          ...vens.items.map((r: any) => ({ rec: r, kind: 'venue' as const, cats: ['venue'] })),
          ...specs.items.map((r: any) => ({ rec: r, kind: 'specialist' as const, cats: [r.categorySlug, ...(Array.isArray(r.alsoCategories) ? r.alsoCategories : [])].filter((s: string) => catBy.has(s)) })),
        ].map((c) => {
          const name = String(c.rec.name || '').trim() || 'Без названия';
          const labels = c.cats.flatMap((s) => [catBy.get(s)!.label, catBy.get(s)!.role]).join(' ');
          return { ...c, name, owned: Boolean(c.rec.owner), text: `${name} ${labels}`.toLowerCase() };
        });
        bySeg = {
          site: all.filter((c) => c.rec.status === 'published'),
          hidden: [],
          archive: all.filter((c) => c.rec.status === 'archived'),
        };
        drawTiles();
        drawList();
        // новые из кабинета, ещё не одобренные
        newBox.hidden = !revs.items.length;
        newEl.innerHTML = revs.items.map((r: any) => {
          const name = String(r.data?.name || '').trim() || 'Без названия';
          const role = r.kind === 'venue' ? 'Площадка' : catBy.get(r.categorySlug)?.role ?? r.categorySlug ?? '';
          return `<div class="a-task a-cabrow">${coverHtml(r, name)}<span class="a-task__body"><span class="a-task__name">${esc(name)}</span>`
            + `<span class="a-task__fill">${esc(role)}, ${REV[r.status] ?? esc(r.status)}</span></span><span class="a-cabrow__act">${btn('Удалить', 'revision', r.id)}</span></div>`;
        }).join('');
      } catch (err) {
        tilesEl.innerHTML = `<div class="a-card a-card--flush a-cards-fail">${failBox(`Не загрузилось. ${errText(err)}`)}</div>`;
        box.hidden = true;
      }
    };

    tilesEl.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('[data-retry]')) { load(); return; }
      const t = (e.target as HTMLElement).closest<HTMLElement>('[data-seg]');
      if (!t) return;
      seg = t.dataset.seg as Seg;
      tab = '';
      history.replaceState(null, '', `#${seg}`);
      tilesEl.querySelectorAll('[data-seg]').forEach((x) => x.setAttribute('aria-pressed', String(x === t)));
      drawList();
    });
    tabsEl.addEventListener('click', (e) => {
      const t = (e.target as HTMLElement).closest<HTMLElement>('[data-tab]');
      if (!t) return;
      e.preventDefault();
      tab = t.dataset.tab!;
      query = '';
      qEl.value = '';
      drawList();
    });
    qEl.addEventListener('input', () => { query = qEl.value.trim().toLowerCase(); drawList(); });

    // удаление и снятие: строка уходит сразу, запрос — через 6 секунд, если не отменили
    const DONE: Record<string, string> = { archive: 'Карточка снята с сайта', delete: 'Карточка удалена', '': 'Черновик удалён' };
    root.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-rm]');
      if (!b) return;
      const rowEl = b.closest<HTMLElement>('.a-cabrow')!;
      rowEl.hidden = true;
      later({
        text: DONE[b.dataset.mode ?? ''] ?? 'Готово',
        undo: () => { rowEl.hidden = false; },
        run: async () => {
          try {
            await api('moderator', 'POST', '/api/wed/mod/remove', { what: b.dataset.rm, id: b.dataset.id, mode: b.dataset.mode }, { keepalive: true });
          } catch (err) {
            toast(`Не получилось. ${errText(err)}`, true);
          }
          load();
        },
      });
    });
    load();
  });
</script>
