---
// КАРТОЧКИ — весь каталог одной таблицей, как «Кампании» Директа. Данные
// НАСТОЯЩИЕ (lib/admin-catalog.ts): фото из 50, есть ли текст, цена,
// контакты — без выдуманных процентов и просмотров (просмотры — в Яндекс
// Метрике). Колонка «Владелец» — из базы: есть ли у карточки `owner`
// (вход владельца). Демо-статусы «ссылка выдана / вошёл» и кнопка «Выдать
// ссылку» с ненастоящим токеном сняты 05.11.2026 — ссылки-приглашения
// выдаются конвейером пилота (card-to-form), не отсюда.
import { Image } from 'astro:assets';
import AdminShell from '../../../components/admin/AdminShell.astro';
import AdminIcon from '../../../components/admin/AdminIcon.astro';
import { resolveImage, IMG_WIDTHS } from '../../../lib/images';
import { CATALOG, GAPS, PHOTOS_LOW, PHOTOS_MAX } from '../../../lib/admin-catalog';
import { SPECIALIST_CATEGORIES } from '../../../data/specialists';

const ROLES = Object.fromEntries(SPECIALIST_CATEGORIES.map((c) => [c.slug, c.role]));

const rows = CATALOG;
const venues = rows.filter((r) => r.kind === 'venue').length;
const tabs = [
  { v: 'all', label: 'Все', n: rows.length },
  { v: 'venue', label: 'Площадки', n: venues },
  { v: 'specialist', label: 'Подрядчики', n: rows.length - venues },
  { v: 'noprice', label: 'Без цены', n: GAPS.noPrice.length, bad: true },
];
// чего не хватает — одной строкой; всё есть — так и пишем
const gaps = (r: (typeof rows)[number]) => [
  !r.hasText && 'нет текста',
  !r.hasPrice && 'нет цены',
].filter(Boolean).join(' · ');
---

<AdminShell title="Карточки" section="catalog">
  <div class="a-title">
    <h1 class="a-h1">Карточки</h1>
  </div>

  {/* ИЗ КАБИНЕТА — живые карточки из базы (Никита, 02.11: «нужно удалять»).
      Новая (ещё не на сайте) — «Удалить»; опубликованная — «Снять с сайта»
      (archived, сайт пересоберётся сам); снятая — «Удалить совсем».
      Действие сразу, с «Отменить» на 6 секунд (lib/cab-ui.ts → later), запрос
      уходит потом. Маршрут — POST /api/wed/mod/remove. */}
  <section class="a-card a-card--flush" data-cab-cards data-roles={JSON.stringify(ROLES)} hidden>
    <div class="a-card__head"><h2 class="a-h2">Завели подрядчики сами</h2></div>
    <p class="a-sub a-card__note">Карточки, которые подрядчики создали в своём кабинете. Ниже — весь каталог сайта</p>
    <div class="a-tasks" data-cab-list></div>
  </section>

  <section class="a-card a-card--flush">
    <nav class="a-tabs" aria-label="Отбор карточек">
      {tabs.map((t) => (
        <a class:list={['a-tabs__item', { 'is-active': t.v === 'all' }]} href={`#${t.v}`} data-filter-tab="cat" data-value={t.v}>
          {t.label} <span class:list={['a-tabs__n', { 'a-tabs__n--bad': t.bad && t.n > 0 }]}>{t.n}</span>
        </a>
      ))}
    </nav>
    <div class="a-tools">
      <label class="a-search">
        <span class="visually-hidden">Поиск</span>
        <input class="a-input" type="search" placeholder="Название или категория" data-filter-search="cat" />
        <AdminIcon name="search" />
      </label>
    </div>
    <div class="a-table-wrap">
      <table class="a-table cat" id="cat" data-atable>
        <tbody>
          {rows.map((r) => {
            const tab = [r.kind, !r.hasPrice && 'noprice'].filter(Boolean).join(' ');
            const miss = gaps(r);
            return (
              <tr data-tab={tab} data-key={r.key} data-text={`${r.name} ${r.category}`.toLowerCase()}>
                <td class="cat__card" data-v={r.name}>
                  {r.cover ? <Image src={resolveImage(r.cover)} alt="" widths={[...IMG_WIDTHS.thumb]} sizes="56px" class="cat__img" /> : <span class="cat__img"></span>}
                  <span class="cat__body">
                    <a class="cat__name" href={r.url} target="_blank" rel="noopener">{r.name}</a>
                    <span class="a-sub">{r.category}</span>
                    <span class:list={['cat__gaps', { 'cat__gaps--ok': !miss }]}>{miss || 'всё на месте'}</span>
                  </span>
                </td>
                {/* владелец — из базы скриптом ниже; до загрузки и без входа — «ведём мы» */}
                <td class="cat__owner"><span class="status" data-owner>Ведём мы</span></td>
              </tr>
            );
          })}
        </tbody>
      </table>
      <div class="a-empty" data-empty="cat" hidden>Ничего не нашлось</div>
    </div>
  </section>

</AdminShell>


<style>
  /* Строка карточки — как «Мои карточки» кабинета (Никита, 27.10: таблица
     на телефоне разваливалась в стопку «Фото / Текст / Цена / Контакты»):
     кадр, имя, категория, красным — только чего не хватает. Справа
     владелец и действие текстом; на телефоне — под карточкой. */
  .cat :global(tr) { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s-2); padding: 14px var(--adm-pad); border-top: 1px solid var(--adm-line); }
  @media (min-width: 768px) { .cat :global(tr) { grid-template-columns: minmax(0, 1fr) 220px; align-items: center; } }
  .cat :global(td) { padding: 0; border: 0; }
  .cat__card { display: grid !important; grid-template-columns: 56px minmax(0, 1fr); gap: var(--s-3); align-items: center; }
  .cat__img, .cat :global(.cat__img) { width: 56px; height: 70px; border-radius: 10px; object-fit: cover; background: var(--adm-bg); display: block; }
  .cat__body { display: grid; gap: 2px; min-width: 0; }
  .cat__name { font-size: 16px; line-height: 22px; font-weight: 600; color: inherit; text-decoration: none; overflow-wrap: anywhere; }
  .cat__gaps { font-size: var(--adm-fs); color: var(--st-bad-text); }
  .cat__gaps--ok { color: var(--st-ok-text); }
  /* владелец — плашкой справа в строке (на телефоне — под названием, слева), а не голой строкой под карточкой */
  .cat__owner { display: flex; align-items: center; }
  @media (min-width: 768px) { .cat__owner { justify-content: flex-end; } }
  .cat :global(tr) { grid-template-columns: minmax(0, 1fr) auto; align-items: center; }
</style>

<script>
  import { api, esc, session, errText } from '../../../lib/cabinet-api';
  import { later, toast } from '../../../lib/cab-ui';
  import { failBox } from '../../../lib/admin-live';

  const REV: Record<string, string> = { draft: 'черновик', review: 'на проверке', rejected: 'вернули' };
  document.addEventListener('astro:page-load', async () => {
    const box = document.querySelector<HTMLElement>('[data-cab-cards]');
    if (!box || box.dataset.live || !session('moderator')) return;
    box.dataset.live = '1';
    box.hidden = false;
    const list = box.querySelector<HTMLElement>('[data-cab-list]')!;
    const roles: Record<string, string> = JSON.parse(box.dataset.roles!);
    const role = (kind: string, cat: string) => (kind === 'venue' ? 'Площадка' : roles[cat] ?? cat);
    const row = (name: string, sub: string, actions: string) => `
      <div class="a-task a-cabrow">
        <span class="a-task__cover a-task__cover--empty" aria-hidden="true">${esc(name.slice(0, 1))}</span>
        <span class="a-task__body"><span class="a-task__name">${esc(name)}</span><span class="a-task__fill">${sub}</span></span>
        <span class="a-cabrow__act">${actions}</span>
      </div>`;
    const btn = (label: string, what: string, id: string, mode = '', danger = true) =>
      `<button type="button" class="c-chipbtn${danger ? ' c-chipbtn--danger' : ''}" data-rm="${what}" data-id="${id}" data-mode="${mode}">${label}</button>`;
    const load = async () => {
      try {
        const [revs, specs, vens] = await Promise.all([
          api('moderator', 'GET', `/api/collections/revisions/records?perPage=200&sort=-updated&expand=owner&filter=${encodeURIComponent('venue = "" && specialist = "" && status != "approved"')}`),
          api('moderator', 'GET', `/api/collections/specialists/records?perPage=200&sort=-updated&filter=${encodeURIComponent('owner != ""')}`),
          api('moderator', 'GET', `/api/collections/venues/records?perPage=200&sort=-updated&filter=${encodeURIComponent('owner != ""')}`),
        ]);
        // колонка «Владелец» в общей таблице: у карточки есть вход владельца
        const owned = new Set([...specs.items.map((x: any) => `specialist:${x.slug}`), ...vens.items.map((x: any) => `venue:${x.slug}`)]);
        document.querySelectorAll<HTMLElement>('#cat tr[data-key]').forEach((tr) => {
          if (owned.has(tr.dataset.key!)) { const o = tr.querySelector<HTMLElement>('[data-owner]')!; o.textContent = 'Ведёт владелец'; o.className = 'status status--info'; }
        });
        const rows: string[] = [];
        for (const c of [...specs.items.map((x: any) => ({ ...x, kind: 'specialist' })), ...vens.items.map((x: any) => ({ ...x, kind: 'venue' }))]) {
          const on = c.status === 'published';
          rows.push(row(c.name || 'Без названия', `${esc(role(c.kind, c.categorySlug))}, ${on ? 'на сайте' : c.status === 'archived' ? 'снята с сайта' : esc(c.status)}`,
            on ? btn('Снять с сайта', c.kind, c.id, 'archive') : c.status === 'archived' ? btn('Удалить совсем', c.kind, c.id, 'delete') : ''));
        }
        for (const r of revs.items) {
          const who = r.expand?.owner?.name || r.expand?.owner?.email || '';
          rows.push(row(r.data?.name || 'Без названия', `${esc(role(r.kind, r.categorySlug))}, новая, ${REV[r.status] ?? esc(r.status)}`, btn('Удалить', 'revision', r.id)));
        }
        list.innerHTML = rows.join('') || '<p class="a-empty">Карточек из кабинета пока нет. Они появятся, когда подрядчик заведёт карточку сам</p>';
      } catch (err) {
        list.innerHTML = failBox(`Не загрузилось. ${errText(err)}`);
      }
    };
    const DONE: Record<string, string> = { archive: 'Карточка снята с сайта', delete: 'Карточка удалена', '': 'Черновик удалён' };
    list.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('[data-retry]')) { load(); return; }
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-rm]');
      if (!b) return;
      // убираем строку сразу, запрос — через 6 секунд, если не отменили
      const rowEl = b.closest<HTMLElement>('.a-cabrow')!;
      rowEl.hidden = true;
      later({
        text: DONE[b.dataset.mode ?? ''] ?? 'Готово',
        undo: () => { rowEl.hidden = false; },
        run: async () => {
          try {
            await api('moderator', 'POST', '/api/wed/mod/remove', { what: b.dataset.rm, id: b.dataset.id, mode: b.dataset.mode }, { keepalive: true });
          } catch (err) {
            toast(`Не получилось. ${errText(err)}`, true);
          }
          load();
        },
      });
    });
    load();
  });
</script>
