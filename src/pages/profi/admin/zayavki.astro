---
// ЗАЯВКИ — что пары оставили через сайт (заявки идут через нас,
// подрядчику не уходят — STAGE2.md §2). Вкладки по статусу, таблица,
// выбор строк: «В работу», «Закрыть», «Спам». ЗАГЛУШКА LEADS; вживую —
// коллекция `leads` (форма BookingSheet → база, согласие 152-ФЗ, капча).
import AdminShell from '../../../components/admin/AdminShell.astro';
import AdminIcon from '../../../components/admin/AdminIcon.astro';
import { cardByKey } from '../../../lib/admin-catalog';
import { LEADS, LEAD_STATUS, type LeadStatus } from '../../../data/admin-demo';

const DOT: Record<LeadStatus, string> = { new: 'info', work: 'warn', done: 'ok', spam: '' };
const count = (s: LeadStatus) => LEADS.filter((l) => l.status === s).length;
const tabs: (LeadStatus | 'all')[] = ['all', 'new', 'work', 'done', 'spam'];
---

<AdminShell title="Заявки" section="leads">
  <nav class="a-tabs" aria-label="Статус заявки">
    {tabs.map((t, i) => (
      <a class:list={['a-tabs__item', { 'is-active': i === 0 }]} href="#" data-filter-tab="ld" data-value={t}>
        {t === 'all' ? 'Все' : LEAD_STATUS[t].label} <span class="a-tabs__n">{t === 'all' ? LEADS.length : count(t)}</span>
      </a>
    ))}
  </nav>

  <div class="a-title">
    <h1 class="a-h1">Заявки от пар</h1>
    <p class="a-lead">Отвечаем паре в тот же день. Подрядчику заявка не уходит — связываемся сами.</p>
  </div>

  <section class="a-card">
    <div class="a-stats">
      <div class="a-stat"><span class="a-stat__label">Новые</span><span class="a-stat__num">{count('new')}</span><span class="a-stat__delta a-up">+3 за сегодня</span></div>
      <div class="a-stat"><span class="a-stat__label">В работе</span><span class="a-stat__num">{count('work')}</span></div>
      <div class="a-stat"><span class="a-stat__label">Закрыты за неделю</span><span class="a-stat__num">{count('done')}</span></div>
      <div class="a-stat"><span class="a-stat__label">Средний ответ паре</span><span class="a-stat__num">2 ч 15 мин</span></div>
    </div>
  </section>

  <section class="a-card a-card--flush">
    <div class="a-card__head">
      <div class="a-tools">
        <label class="a-search">
          <span class="visually-hidden">Поиск</span>
          <input class="a-input" type="search" placeholder="Имя, карточка, номер" data-filter-search="ld" />
          <AdminIcon name="search" />
        </label>
        <span class="a-btn a-btn--soft">Последние 7 дней <AdminIcon name="down" /></span>
      </div>
      <span class="a-btn"><AdminIcon name="external" /> Выгрузить</span>
    </div>
    <div class="a-table-wrap">
      <table class="a-table a-table--cards" id="ld" data-atable>
        <thead>
          <tr>
            <th><input class="a-check" type="checkbox" aria-label="Выбрать все" /></th>
            <th data-sort="desc">№</th>
            <th>Пара</th>
            <th>Свадьба</th>
            <th>Кому</th>
            <th>Статус</th>
            <th>Заметка</th>
          </tr>
        </thead>
        <tbody>
          {LEADS.map((l) => {
            const c = cardByKey(l.card);
            return (
              <tr data-tab={l.status} data-text={`${l.id} ${l.bride} ${c?.name ?? ''}`.toLowerCase()}>
                <td><input class="a-check" type="checkbox" aria-label={`Выбрать заявку ${l.id}`} /></td>
                <td data-v={l.id}><span class="a-name">№ {l.id}</span><span class="a-sub">{l.at}</span></td>
                <td>{l.bride}<span class="a-sub">ответить: {l.contact}</span></td>
                <td data-l="Свадьба">{l.date}{l.guests > 0 && <span class="a-sub">{l.guests} гостей</span>}</td>
                <td>{c ? <a class="a-name" href={c.url} target="_blank" rel="noopener">{c.name}</a> : '—'}<span class="a-sub">{c?.category}</span></td>
                <td data-bulk-cell><span class={`a-dot ${DOT[l.status] ? `a-dot--${DOT[l.status]}` : ''}`}>{LEAD_STATUS[l.status].label}</span></td>
                <td class="ld__note">{l.note ?? <span class="adm-2">—</span>}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
      <div class="a-empty" data-empty="ld" hidden><p>Заявок нет</p><p>Смените вкладку или запрос</p></div>
    </div>
  </section>

  <div class="a-bulk" data-bulk="ld" hidden>
    <span class="a-bulk__count">Выбрано: <span data-bulk-n>0</span></span>
    <button class="a-bulk__btn" type="button" data-bulk-act="mark" data-bulk-label='<span class="a-dot a-dot--warn">В работе</span>'>В работу</button>
    <button class="a-bulk__btn" type="button" data-bulk-act="mark" data-bulk-label='<span class="a-dot a-dot--ok">Закрыта</span>'>Закрыть</button>
    <button class="a-bulk__btn" type="button" data-bulk-act="mark" data-bulk-label='<span class="a-dot">Спам</span>'>Спам</button>
    <button class="a-bulk__btn" type="button" data-bulk-clear>Снять выбор</button>
  </div>
</AdminShell>

<style>
  .ld__note { max-width: 28ch; }
</style>
