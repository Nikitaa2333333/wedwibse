---
// СТАТУС ПРОВЕРКИ — прототип (STAGE2.md §0.1). Два состояния карточки после
// «Отправить»: «На проверке» (черновик заблокирован, отзыва нет — решение
// 16.10) и «Вернули с причиной». В прототипе оба на одной странице, чтобы
// показать заказчику. Вживую состояние придёт из базы (`revisions.status`).
import ProfiShell from '../../../components/profi/ProfiShell.astro';
---

<ProfiShell title="Проверка карточки" section="cards">
  <main class="section container st">
    <section class="st__state">
      <span class="status status--info">Отправлено модератору · на проверке</span>
      <h1 class="t-h1">Проверим до 24 часов</h1>
      <p>Напишем в мессенджер и на почту. Пока карточка на проверке, править её нельзя. Версия на сайте остаётся прежней до решения.</p>
      <a class="st__link" href="/profi/kabinet/">К карточкам</a>
    </section>

    <section class="st__state st__state--back">
      <span class="status status--bad">Вернули с причиной</span>
      <h2 class="t-h2">Модератор вернул карточку</h2>
      <p class="st__why">«В разделе „Как я снимаю“ указан телефон. Контакты — только в разделе „Контакты“, там их увидит пара по кнопке».</p>
      <p>Исправьте и отправьте ещё раз — проверка снова до 24 часов.</p>
      <a class="pill pill--lg pill--solid" href="/profi/kabinet/anketa/tekst/">Исправить</a>
    </section>
  </main>
</ProfiShell>

<style>
  .st { max-width: 720px; padding-top: var(--s-4); display: grid; gap: var(--section-gap); }
  .st__state { display: grid; gap: var(--s-4); justify-items: start; }
  .st__state p { max-width: var(--measure-text); }
  .st__state--back { padding-top: var(--section-gap); border-top: 1px solid var(--hairline); }
  .st__why { font-weight: var(--w-medium); }
  .st__link { color: inherit; font-weight: var(--w-medium); text-decoration: underline; text-underline-offset: 3px; }
</style>
