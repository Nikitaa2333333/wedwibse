---
// ГЛАВНАЯ КАБИНЕТА ПОДРЯДЧИКА — прототип (STAGE2.md §0.1, правила —
// CABINET-UX.md). Мои карточки (до 3 на учётку) строками: фото, статус
// одним словом, имя, строка «что происходит». Одна плашка — одна карточка,
// внутри ничего не обрамляется (правило 20.10). Действия — на экране
// карточки, здесь только переход. Данные — ЗАГЛУШКА из profi-demo.ts.
import { Image } from 'astro:assets';
import Glyph from '../../../components/profi/Glyph.astro';
import ProfiShell from '../../../components/profi/ProfiShell.astro';
import { resolveImage, IMG_WIDTHS } from '../../../lib/images';
import { DEMO_ACCOUNT, DEMO_CARDS, STATUS_LABEL } from '../../../data/profi-demo';

const left = DEMO_ACCOUNT.cardsMax - DEMO_CARDS.length;
const STATUS_CLASS = { published: 'status--ok', review: 'status--info', returned: 'status--bad', draft: '' } as const;
---

<ProfiShell title="Кабинет" section="cards">
  <main class="section container cab">
    <h1 class="t-h1">Карточки</h1>

    <ul class="cards">
      {DEMO_CARDS.map((c) => (
        <li>
          <a class="card" href="/profi/kabinet/anketa/">
            <span class="card__media">
              {c.photo ? (
                <Image src={resolveImage(c.photo)} alt="" widths={[...IMG_WIDTHS.thumb]} sizes="72px" class="card__img" />
              ) : (
                <span class="card__empty">Нет фото</span>
              )}
            </span>
            <span class="card__body">
              <span class={`status ${STATUS_CLASS[c.status]}`}>{STATUS_LABEL[c.status]}</span>
              <span class="card__name">{c.role}</span>
              <span class="card__note">{c.note}</span>
            </span>
            <Glyph name="chevronRight" class="card__go" />
          </a>
        </li>
      ))}
    </ul>

    {left > 0 && <a class="cab__add" href="/profi/kabinet/novaya/">+ Добавить карточку</a>}
  </main>
</ProfiShell>

<style>
  .cab { max-width: 720px; padding-top: var(--s-4); }

  .cards { list-style: none; display: grid; gap: var(--s-3); margin-top: var(--s-5); }

  .card {
    display: grid;
    grid-template-columns: 72px 1fr auto;
    align-items: center;
    gap: var(--s-4);
    padding: var(--s-4);
    background: var(--surface);
    border-radius: var(--radius-card);
    color: inherit;
    text-decoration: none;
  }
  .card__media {
    width: 72px;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--surface-dim);
    display: grid;
    place-items: center;
  }
  .card__img { width: 100%; height: 100%; object-fit: cover; }
  .card__empty { font-size: var(--fs-caption); text-align: center; }

  .card__body { display: grid; gap: var(--s-1); min-width: 0; justify-items: start; }
  .card__name { font-size: var(--fs-h3); font-weight: var(--w-head-lg); line-height: var(--lh-caption); }
  .card__note { font-size: var(--fs-small); line-height: var(--lh-snug); }
  :global(.card__go) { width: 22px; height: 22px; color: var(--text-2); }

  /* «Добавить карточку» — просто текст по центру, без подчёркивания и рамки. */
  .cab__add {
    display: block;
    margin-top: var(--s-5);
    text-align: center;
    font-size: var(--fs-body);
    font-weight: var(--w-head-lg);
    color: inherit;
    text-decoration: none;
  }
</style>
