---
// ВОПРОСЫ ДЛЯ ФИЛЬТРОВ ПЛОЩАДКИ — числовые группы из VENUE_FILTERS
// (data/feed.ts), тот же источник, что у каталога площадок. Локация и тип —
// в «Основном». ЗАГЛУШКА.
import SectionShell from '../../../../components/profi/SectionShell.astro';
import { VENUE_FILTERS } from '../../../../data/feed';
const back = '/profi/kabinet/anketa-ploshchadki/';

const groups = VENUE_FILTERS.filter((g) => g.key === 'capacity' || g.key === 'avgCheck');
const picked = new Set(['capacity:0-80', 'avgCheck:9+']);
---

<SectionShell title="Вопросы" lead={`По этим ответам пары находят площадку в каталоге. Отвечено ${groups.length} из ${groups.length}.`} back={back}>
  {groups.map((g) => (
    <fieldset class="q">
      <legend class="q__t">{g.label}</legend>
      <div class="q__opts">
        {g.options.map((o) => (
          <label class="chip-opt">
            <input class="chip-opt__input" type={g.type === 'single' ? 'radio' : 'checkbox'} name={g.key} checked={picked.has(`${g.key}:${o.value}`)} />
            <span class="chip">{o.label}</span>
          </label>
        ))}
      </div>
    </fieldset>
  ))}
</SectionShell>

<style>
  .q { border: 0; padding: 0; margin: 0; display: grid; gap: var(--s-3); }
  .q__t { font-weight: var(--w-head-lg); line-height: var(--lh-caption); }
  .q__opts { display: flex; flex-wrap: wrap; gap: var(--s-2); }
</style>
