---
// НОВАЯ КАРТОЧКА — прототип: первый шаг после «+ Добавить карточку».
// Выбор «площадка или подрядчик» и категория. Категория закрепляется при
// создании (CABINET.md §21): от неё зависят вопросы фильтров в анкете.
// Список категорий — тот же реестр, что у каталога (SPECIALIST_GROUPS /
// SPECIALIST_CATEGORIES): новая категория сама появится и здесь.
// В прототипе любая категория подрядчика ведёт на анкету фотографа.
import ProfiShell from '../../../components/profi/ProfiShell.astro';
import BackButton from '../../../components/BackButton.astro';
import Glyph from '../../../components/profi/Glyph.astro';
import { SPECIALIST_CATEGORIES, SPECIALIST_GROUPS } from '../../../data/specialists';

const bySlug = new Map(SPECIALIST_CATEGORIES.map((c) => [c.slug, c]));
const grouped = new Set(SPECIALIST_GROUPS.flatMap((g) => g.categories));
const groups = [
  ...SPECIALIST_GROUPS.map((g) => ({
    label: g.label,
    cats: g.categories.map((s) => bySlug.get(s)).filter((c) => c !== undefined),
  })),
  { label: 'Другое', cats: SPECIALIST_CATEGORIES.filter((c) => !grouped.has(c.slug)) },
].filter((g) => g.cats.length > 0);

---

<ProfiShell title="Новая карточка" section="cards">
  <main class="container nw">
    <BackButton plain href="/profi/kabinet/" label="К карточкам" />
    <h1 class="t-h1">Новая карточка</h1>

    <a class="nw__row nw__row--lead" href="/profi/kabinet/anketa-ploshchadki/">
      <span>Площадка</span>
      <Glyph name="chevronRight" class="nw__go" />
    </a>

    <h2 class="nw__h">Подрядчик</h2>

    {groups.map((g) => (
      <section class="nw__group">
        <h3 class="nw__gt">{g.label}</h3>
        <ul class="nw__cats">
          {g.cats.map((c) => (
            <li>
              <a class="nw__row" href="/profi/kabinet/anketa/">
                <span>{c.role}</span>
                <Glyph name="chevronRight" class="nw__go" />
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </main>
</ProfiShell>

<style>
  .nw { max-width: 720px; padding-top: var(--s-1); padding-bottom: var(--s-7); }
  .nw h1 { margin-top: var(--s-1); }

  /* Пункты выбора — строки с линией между ними, справа тонкая стрелка. */
  .nw__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    padding: var(--s-3) 0;
    color: inherit;
    text-decoration: none;
    border-top: 1px solid var(--hairline);
  }
  .nw__row--lead { margin-top: var(--s-5); border-bottom: 1px solid var(--hairline); font-weight: var(--w-head-lg); font-size: var(--fs-body); }
  :global(.nw__go) { color: var(--text-2); }

  .nw__h { margin-top: var(--s-6); font-family: var(--font-sans); font-size: var(--fs-h3); font-weight: var(--w-head-lg); }

  .nw__group { margin-top: var(--s-5); }
  .nw__gt {
    font-family: var(--font-sans);
    font-size: var(--fs-caption);
    font-weight: var(--w-medium);
    color: var(--text-2);
    padding-bottom: var(--s-2);
  }
  .nw__cats { list-style: none; }
  .nw__cats li:last-child .nw__row { border-bottom: 1px solid var(--hairline); }
</style>
