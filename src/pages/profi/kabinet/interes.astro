---
// «ИНТЕРЕС» — раздел меню кабинета. Что пары делают с карточкой: просмотры,
// избранное, открытия контактов (журнал второго этапа, без денег — STAGE2.md
// §1). Только честные цифры с источником: пока подсчёт не подключён,
// строка говорит «нет данных», выдуманных чисел и графиков нет (Никита,
// 24.10.2026). Вживую значения придут из базы и API Метрики.
import ProfiShell from '../../../components/profi/ProfiShell.astro';
import { INTEREST_METRICS } from '../../../data/profi-demo';
---

<ProfiShell title="Интерес" section="interest">
  <main class="container ir">
    <h1 class="t-h1">Интерес</h1>
    <p class="ir__sub">Что пары делают с вашими карточками. Считаем с момента, когда карточка опубликована через кабинет.</p>

    <ul class="ir__list">
      {INTEREST_METRICS.map((m) => (
        <li class="ir__row">
          <span class="ir__label">{m.label}</span>
          <span class="ir__source">{m.source}</span>
          {m.value === null
            ? <span class="status ir__value">нет данных</span>
            : <span class="ir__num ir__value">{m.value.toLocaleString('ru-RU')}</span>}
        </li>
      ))}
    </ul>

    <h2 class="t-h2 ir__h">События</h2>
    <p class="ir__empty">Пока событий нет. Когда пара сохранит карточку или откроет контакты, это появится здесь — с датой и карточкой.</p>
  </main>
</ProfiShell>

<style>
  .ir { max-width: 720px; padding-top: var(--s-4); }
  .ir__sub { margin-top: var(--s-2); font-size: var(--fs-small); max-width: var(--measure-text); }

  /* Строки с линиями — в кабинете можно (CLAUDE.md, «Кабинет — это не сайт») */
  .ir__list { list-style: none; margin-top: var(--s-5); border-top: 1px solid var(--hairline); }
  .ir__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--s-1) var(--s-4);
    align-items: center;
    padding-block: var(--s-4);
    border-bottom: 1px solid var(--hairline);
  }
  .ir__label { font-weight: var(--w-head); }
  .ir__source { grid-column: 1; font-size: var(--fs-caption); line-height: var(--lh-snug); color: var(--text-2); }
  .ir__value { grid-column: 2; grid-row: 1 / span 2; }
  .ir__num { font-size: var(--fs-h3); font-weight: var(--w-head-lg); }

  .ir__h { margin-top: var(--s-6); }
  .ir__empty { margin-top: var(--s-3); font-size: var(--fs-small); max-width: var(--measure-text); }
</style>
