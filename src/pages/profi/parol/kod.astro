---
// СБРОС ПАРОЛЯ, шаг 2 — код из письма и новый пароль (/api/wed/password-reset).
// Верный код сразу открывает кабинет и заодно подтверждает почту.
import ProfiShell from '../../../components/profi/ProfiShell.astro';
import '../../../components/profi/auth.css';
import CodeInput from '../../../components/profi/CodeInput.astro';
---

<ProfiShell title="Код из письма" look="auth">
  <main class="container auth">
    <div class="auth__head">
      <h1 class="t-h1">Код из письма</h1>
      <p class="auth__sub" data-sent>Если учётка с этой почтой есть, код уже в пути</p>
    </div>

    <form class="auth__form" data-code-form>
      <div class="field">
        <span class="field__label">Код</span>
        <CodeInput />
      </div>
      <label class="field">
        <span class="field__label">Новый пароль</span>
        <input class="input" type="password" name="password" autocomplete="new-password" minlength="8" placeholder="Не короче 8 знаков" required />
      </label>
      <p class="auth__error" role="alert" data-error hidden></p>
      <button class="pill pill--lg pill--solid pill--block" type="submit">Сохранить и войти</button>
    </form>

    <p class="auth__alt">Письма нет? Загляните в спам или <a href="#" data-resend>пришлите ещё раз</a></p>
  </main>
</ProfiShell>

<script>
  import { checkForm } from '../../../lib/form-check';
  import { api, errText } from '../../../lib/cabinet-api';
  import { codeStep, saveCodeStep, sendCode, keep } from '../../../lib/email-login';
  import { afterLogin } from '../../../lib/tg-login';

  const step = codeStep();
  const form = document.querySelector<HTMLFormElement>('[data-code-form]')!;
  checkForm(form);
  const error = form.querySelector<HTMLElement>('[data-error]')!;
  const resend = document.querySelector<HTMLAnchorElement>('[data-resend]')!;
  const fail = (m: string) => { error.textContent = m; error.hidden = false; };

  if (!step) {
    location.replace('/profi/parol/');
  } else {
    document.querySelector('[data-sent]')!.textContent = `Если учётка с почтой ${step.email} есть, код уже в пути`;

    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      error.hidden = true;
      const btn = form.querySelector('button')!;
      btn.disabled = true;
      try {
        const f = new FormData(form);
        keep(await api(null, 'POST', '/api/wed/password-reset', {
          otpId: step.otpId, code: String(f.get('code')).replace(/\D/g, ''), password: String(f.get('password')),
        }));
        afterLogin(step.next);
      } catch (err) {
        fail(errText(err));
        btn.disabled = false;
      }
    });

    resend.addEventListener('click', async (ev) => {
      ev.preventDefault();
      error.hidden = true;
      try {
        step.otpId = await sendCode(step.email);
        saveCodeStep(step);
        resend.replaceWith(document.createTextNode('отправили ещё раз'));
      } catch (err) {
        fail(errText(err));
      }
    });
  }
</script>
