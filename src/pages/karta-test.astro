---
// ВРЕМЕННО: тестовая страница карты. Сама карта живёт в компоненте
// VenueMap.astro и стоит в каталоге площадок (кнопка «На карте») — здесь она
// просто открыта сразу, чтобы проверять метки без фильтров и переключателя.
// Удалить, когда карта в каталоге отработает.
import Layout from '../layouts/Layout.astro';
import VenueMap from '../components/VenueMap.astro';
import { venueMapPoints } from '../lib/map-points';

const points = venueMapPoints();
---

<Layout title="Тест карты — WED Secrets">
  <main class="wrap">
    <h1 class="t-h1">Тест: метки площадок на карте</h1>
    <VenueMap points={points} />
  </main>
</Layout>

<style>
  .wrap {
    padding: var(--s-6) var(--gutter);
  }

  .wrap :global(.vmap) {
    margin-top: var(--s-5);
  }
</style>
