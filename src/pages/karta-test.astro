---
// ВРЕМЕННО: тестовая страница, проверяем встраивание Яндекс Карт (см. SEO.md,
// находка про карту конкурента). Не часть каталога, отдельная страница —
// удалить или перенести логику в каталог площадок, когда появятся реальные
// координаты подрядчиков.
import Layout from '../layouts/Layout.astro';
import { riverLoft, forestDew } from '../data/venues';

// Ключ пакета «JavaScript API и HTTP Геокодер» — сам по себе публичный
// браузерный ключ (защищается привязкой к домену в кабинете Яндекса, не
// секретностью), но в гит-репозиторий текстом всё равно не кладём — читаем
// из секрета GitHub Actions (YANDEX_MAPS_API_KEY), подставляется на сборке.
const YANDEX_MAPS_API_KEY = import.meta.env.YANDEX_MAPS_API_KEY;

// Координат в данных площадок пока нет — берём адрес из карточки и просим
// геокодер Яндекса найти точку. Когда в схеме появится поле с координатами,
// геокодирование на клиенте уйдёт: метка будет ставиться сразу по цифрам.
const POINTS = [riverLoft, forestDew].map((v) => ({
  name: v.name,
  address: v.contacts.address,
  href: `/moskva/ploshchadki/${v.slug}/`,
}));
---

<Layout title="Тест карты — WED Secrets">
  <main class="wrap">
    <h1 class="t-h1">Тест: метки площадок на карте</h1>
    <div id="map" class="map" data-points={JSON.stringify(POINTS)}></div>
  </main>
</Layout>

<style>
  .wrap {
    padding: var(--s-6) var(--gutter);
  }

  .map {
    margin-top: var(--s-5);
    width: 100%;
    height: 480px;
    border-radius: var(--radius-media);
    background: var(--surface-dim);
    overflow: hidden;
  }
</style>

<script define:vars={{ apiKey: YANDEX_MAPS_API_KEY }}>
  const script = document.createElement('script');
  script.src = `https://api-maps.yandex.ru/2.1/?apikey=${apiKey}&lang=ru_RU`;
  script.onload = () => {
    window.ymaps.ready(async () => {
      const el = document.getElementById('map');
      const points = JSON.parse(el.dataset.points);

      const map = new window.ymaps.Map('map', {
        center: [55.55, 37.5],
        zoom: 10,
      });

      const located = await Promise.all(
        points.map(async (point) => {
          const res = await window.ymaps.geocode(point.address, { results: 1 });
          const found = res.geoObjects.get(0);
          return found ? { ...point, coords: found.geometry.getCoordinates() } : null;
        })
      );

      // Своя метка (.map-pin в global.css) вместо яндексовской капли: капсула
      // с названием — и сразу ссылка на карточку, поэтому балун не нужен.
      const PinLayout = window.ymaps.templateLayoutFactory.createClass(
        '<a class="map-pin" href="$[properties.pinHref]" title="$[properties.pinAddress]">' +
          '<span class="map-pin__dot"></span>$[properties.pinName]' +
          '</a>'
      );

      located.filter(Boolean).forEach((point) => {
        map.geoObjects.add(
          new window.ymaps.Placemark(
            point.coords,
            {
              pinName: point.name,
              pinHref: point.href,
              pinAddress: point.address,
            },
            {
              iconLayout: PinLayout,
              // активная область метки: капсула стоит над точкой, ширина
              // зависит от названия — берём с запасом
              iconShape: {
                type: 'Rectangle',
                coordinates: [
                  [-110, -46],
                  [110, 2],
                ],
              },
              hasBalloon: false,
            }
          )
        );
      });

      if (map.geoObjects.getLength() > 0) {
        map.setBounds(map.geoObjects.getBounds(), {
          checkZoomRange: true,
          zoomMargin: 48,
        });
      }
    });
  };
  document.head.appendChild(script);
</script>
