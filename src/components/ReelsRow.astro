---
// РЯД «ВИДЕО» — ролики карточки отдельной лентой, один компонент на
// визитку подрядчика и карточку площадки. Вертикальные 2:3 плитки,
// листаются вбок (scroll-snap), как карусели карточек каталога.
//
// РОЛИКИ ЗДЕСЬ НЕ АВТОЗАПУСКАЮТСЯ, в отличие от плиток доски и первого
// экрана: в ряду их сразу несколько в кадре, и одновременно играющие
// перебивают друг друга. Кадр стоит постером с кнопкой play, играет
// ровно тот, который запустили, запуск соседнего останавливает предыдущий.
// Файл ролика не качается до нажатия (src подставляет скрипт).
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import type { Reel } from '../data/reels';
import { resolveImage, IMG_WIDTHS } from '../lib/images';
import { posterOf } from '../lib/media';

interface Props {
  reels: Reel[];
  title?: string;
  /** оформление секцией страницы (.section) — у площадки; у подрядчика
   *  ряд стоит в своём потоке блоков без общей секции */
  section?: boolean;
}

const { reels, title = 'Видео', section = false } = Astro.props;
---

{reels.length > 0 && (
  <section class:list={['preels', { section }]}>
    <h2 class="t-h2 preels__title">{title}</h2>
    <div class="preels__rail" data-reels-rail>
      {reels.map((reel) => (
        <div class="preels__cell">
          <button class="preels__item media" type="button" data-sound-scope data-reel={reel.src} aria-label={`Смотреть: ${reel.alt}`} aria-pressed="false">
            <Image
              src={resolveImage(posterOf(reel.src))}
              alt={reel.alt}
              widths={IMG_WIDTHS.card}
              sizes="(min-width: 1024px) 240px, 48vw"
              loading="lazy"
              decoding="async"
            />
            <video class="preels__video" data-reel-video data-video={reel.src} muted loop playsinline preload="none" aria-hidden="true"></video>
            <span class="preels__play" aria-hidden="true">
              <Icon name="play" class="preels__play-icon" />
            </span>
          </button>

          {/* ЗВУК — НА САМОМ КАДРЕ, в углу (заказчик, 23.09.2026): кнопка под
               роликом читалась отдельным элементом, будто не от этого видео.
               Лежит соседом плитки, а не внутри неё: кнопка в кнопке
               недопустима. Нажатие звука ЗАПУСКАЕТ именно этот ролик со
               звуком и останавливает остальные (см. скрипт). */}
          {reel.sound && (
            <button class="sound-btn preels__sound" type="button" data-reel-sound aria-pressed="false" aria-label="Смотреть со звуком">
              <span class="sound-btn__off"><Icon name="soundOff" /></span>
              <span class="sound-btn__on"><Icon name="sound" /></span>
            </button>
          )}
        </div>
      ))}
    </div>
  </section>
)}

<style>
  .preels {
    padding: 0 0 var(--section-gap-tight) var(--gutter);
  }

  /* у площадки ряд — обычная секция страницы: вертикальный ритм общий */
  .preels.section {
    padding-block: var(--section-gap);
    padding-inline: var(--gutter) 0;
  }

  .preels__rail {
    display: flex;
    gap: var(--s-3);
    margin-top: var(--s-5);
    padding-right: var(--gutter);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    /* touch-action не ставим: ось жеста выбирает браузер (см. DESIGN.md) */
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .preels__rail::-webkit-scrollbar { display: none; }

  /* Ячейка ряда: кадр и строка звука под ним. Ширину держит она,
     а не сам ролик, — иначе строка вылезала бы за кадр. */
  .preels__cell {
    position: relative;
    flex: 0 0 clamp(180px, 48vw, 240px);
    scroll-snap-align: start;
  }

  /* Плитка ряда — кнопка: снимаем всё, что браузер рисует кнопке сам */
  .preels__item {
    position: relative;
    width: 100%;
    aspect-ratio: 2 / 3;
    padding: 0;
    border: 0;
    background: var(--surface-dim);
    cursor: pointer;
    color: inherit;
  }

  /* Ролик поверх своего постера — проявляется, когда реально пошёл:
     не запустился (энергосбережение на iPhone) — остаётся постер */
  .preels__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity var(--dur-base) var(--ease-out);
    pointer-events: none;
  }

  .preels__video.is-playing { opacity: 1; }

  /* Кнопка play — единственное, что лежит НА кадре: правило проекта
     разрешает поверх фотографии только иконки со своей тенью. */
  .preels__play {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-pill);
    background: var(--ink);
    color: var(--white);
    box-shadow: var(--shadow-float);
    transition: opacity var(--dur-fast) var(--ease-out);
  }

  :global(.preels__play-icon) {
    width: 20px;
    height: 20px;
    /* треугольник в круге смотрится центрированным, когда сдвинут вправо */
    margin-left: 2px;
  }

  /* Пошёл ролик — кнопка уходит, кадр остаётся чистым; вернуть паузу
     можно тапом по самой плитке */
  .preels__item[aria-pressed='true'] .preels__play { opacity: 0; }
</style>

<script>
  // ============ РЯД «ВИДЕО»: ИГРАЕТ ТОЛЬКО ОДИН ============
  // Одна точка правды на весь ряд: и тап по кадру, и кнопка звука идут
  // через play()/stop(). Раньше звук жил в общем bindSoundButtons и о ряде
  // ничего не знал — включённый звук запускал ролик, но соседний, начатый
  // тапом, продолжал играть, а плитка не считала себя запущенной.
  const cells = Array.from(document.querySelectorAll<HTMLElement>('.preels__cell'));

  const parts = (cell: HTMLElement) => ({
    tile: cell.querySelector<HTMLButtonElement>('[data-reel]')!,
    video: cell.querySelector<HTMLVideoElement>('[data-reel-video]')!,
    sound: cell.querySelector<HTMLButtonElement>('[data-reel-sound]'),
  });

  function stop(cell: HTMLElement) {
    const { tile, video, sound } = parts(cell);
    video.pause();
    video.muted = true;
    video.classList.remove('is-playing');
    tile.setAttribute('aria-pressed', 'false');
    sound?.setAttribute('aria-pressed', 'false');
  }

  function play(cell: HTMLElement, withSound: boolean) {
    const { tile, video, sound } = parts(cell);
    cells.forEach((other) => other !== cell && stop(other));

    // файл подставляем при первом запуске: до нажатия ролик не качается
    if (!video.src) video.src = tile.dataset.reel!;
    // звук ставим до play(): это жест человека, и браузер его разрешает
    video.muted = !withSound;
    tile.setAttribute('aria-pressed', 'true');
    sound?.setAttribute('aria-pressed', String(withSound));
    video
      .play()
      .then(() => video.classList.add('is-playing'))
      .catch(() => stop(cell));
  }

  cells.forEach((cell) => {
    const { tile, video, sound } = parts(cell);
    if (!tile || !video) return;

    tile.addEventListener('click', () => {
      if (tile.getAttribute('aria-pressed') === 'true') stop(cell);
      else play(cell, false);
    });

    sound?.addEventListener('click', () => {
      const playing = tile.getAttribute('aria-pressed') === 'true';
      if (!playing) return play(cell, true);
      // ролик уже идёт — кнопка только переключает звук у него же
      video.muted = !video.muted;
      sound.setAttribute('aria-pressed', String(!video.muted));
    });
  });

  // Ушёл ряд с экрана — ролик встаёт на паузу: крутить видео за кадром
  // незачем, это батарея телефона, и звук из невидимого кадра не нужен.
  document.querySelectorAll('[data-reels-rail]').forEach((rail) => {
    new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) cells.forEach(stop);
      },
      { threshold: 0 }
    ).observe(rail);
  });
</script>
