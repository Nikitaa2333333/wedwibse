---
// РЯД «ВИДЕО» — ролики карточки отдельной лентой, один компонент на
// визитку подрядчика и карточку площадки. Вертикальные 2:3 плитки,
// листаются вбок (scroll-snap), как карусели карточек каталога.
//
// РОЛИКИ ЗДЕСЬ НЕ АВТОЗАПУСКАЮТСЯ, в отличие от плиток доски и первого
// экрана: в ряду их сразу несколько в кадре, и одновременно играющие
// перебивают друг друга. Кадр стоит постером с кнопкой play, играет
// ровно тот, который запустили, запуск соседнего останавливает предыдущий.
// Файл ролика не качается до нажатия (src подставляет скрипт).
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import type { Reel } from '../data/reels';
import { resolveImage, IMG_WIDTHS } from '../lib/images';
import { posterOf } from '../lib/media';

interface Props {
  reels: Reel[];
  title?: string;
  /** оформление секцией страницы (.section) — у площадки; у подрядчика
   *  ряд стоит в своём потоке блоков без общей секции */
  section?: boolean;
}

const { reels, title = 'Видео', section = false } = Astro.props;
---

{reels.length > 0 && (
  <section class:list={['preels', { section }]}>
    <h2 class="t-h2 preels__title">{title}</h2>
    <div class="preels__rail" data-reels-rail>
      {reels.map((reel) => (
        <div class="preels__cell">
          <button class="preels__item media" type="button" data-sound-scope data-reel={reel.src} aria-label={`Смотреть: ${reel.alt}`} aria-pressed="false">
            <Image
              src={resolveImage(posterOf(reel.src))}
              alt={reel.alt}
              widths={IMG_WIDTHS.card}
              sizes="(min-width: 1024px) 240px, 48vw"
              loading="lazy"
              decoding="async"
            />
            <video class="preels__video" data-reel-video data-video={reel.src} muted loop playsinline preload="none" aria-hidden="true"></video>
            <span class="preels__play" aria-hidden="true">
              <Icon name="play" class="preels__play-icon" />
            </span>
          </button>

          {/* Под роликом — только звук: знака «в избранное» у ролика нет */}
          {reel.sound && (
            <div class="preels__foot">
              <button class="sound-btn sound-btn--inline" type="button" data-sound={reel.src} aria-pressed="false" aria-label="Звук ролика">
                <span class="sound-btn__off"><Icon name="soundOff" /></span>
                <span class="sound-btn__on"><Icon name="sound" /></span>
              </button>
            </div>
          )}
        </div>
      ))}
    </div>
  </section>
)}

<style>
  .preels {
    padding: 0 0 var(--section-gap-tight) var(--gutter);
  }

  /* у площадки ряд — обычная секция страницы: вертикальный ритм общий */
  .preels.section {
    padding-block: var(--section-gap);
    padding-inline: var(--gutter) 0;
  }

  .preels__rail {
    display: flex;
    gap: var(--s-3);
    margin-top: var(--s-5);
    padding-right: var(--gutter);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    /* touch-action не ставим: ось жеста выбирает браузер (см. DESIGN.md) */
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .preels__rail::-webkit-scrollbar { display: none; }

  /* Ячейка ряда: кадр и строка звука под ним. Ширину держит она,
     а не сам ролик, — иначе строка вылезала бы за кадр. */
  .preels__cell {
    flex: 0 0 clamp(180px, 48vw, 240px);
    scroll-snap-align: start;
  }

  /* Плитка ряда — кнопка: снимаем всё, что браузер рисует кнопке сам */
  .preels__item {
    position: relative;
    width: 100%;
    aspect-ratio: 2 / 3;
    padding: 0;
    border: 0;
    background: var(--surface-dim);
    cursor: pointer;
    color: inherit;
  }

  .preels__foot {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--s-2);
    padding-top: 2px;
  }

  /* Ролик поверх своего постера — проявляется, когда реально пошёл:
     не запустился (энергосбережение на iPhone) — остаётся постер */
  .preels__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity var(--dur-base) var(--ease-out);
    pointer-events: none;
  }

  .preels__video.is-playing { opacity: 1; }

  /* Кнопка play — единственное, что лежит НА кадре: правило проекта
     разрешает поверх фотографии только иконки со своей тенью. */
  .preels__play {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-pill);
    background: var(--ink);
    color: var(--white);
    box-shadow: var(--shadow-float);
    transition: opacity var(--dur-fast) var(--ease-out);
  }

  :global(.preels__play-icon) {
    width: 20px;
    height: 20px;
    /* треугольник в круге смотрится центрированным, когда сдвинут вправо */
    margin-left: 2px;
  }

  /* Пошёл ролик — кнопка уходит, кадр остаётся чистым; вернуть паузу
     можно тапом по самой плитке */
  .preels__item[aria-pressed='true'] .preels__play { opacity: 0; }
</style>

<script>
  import { bindSoundButtons } from '../lib/video';

  bindSoundButtons();

  // ============ РЯД «ВИДЕО»: ИГРАЕТ ТОЛЬКО ОДИН ============
  const tiles = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-reel]'));

  function stopTile(tile: HTMLButtonElement) {
    const video = tile.querySelector<HTMLVideoElement>('[data-reel-video]');
    video?.pause();
    video?.classList.remove('is-playing');
    tile.setAttribute('aria-pressed', 'false');
  }

  tiles.forEach((tile) => {
    tile.addEventListener('click', () => {
      const video = tile.querySelector<HTMLVideoElement>('[data-reel-video]');
      if (!video) return;

      if (tile.getAttribute('aria-pressed') === 'true') {
        stopTile(tile);
        return;
      }

      tiles.forEach((other) => other !== tile && stopTile(other));

      // файл подставляем при первом запуске: до нажатия ролик не качается
      if (!video.src) video.src = tile.dataset.reel!;
      video
        .play()
        .then(() => {
          video.classList.add('is-playing');
          tile.setAttribute('aria-pressed', 'true');
        })
        .catch(() => {});
    });
  });

  // Ушёл ряд с экрана — ролик встаёт на паузу: крутить видео за кадром
  // незачем, это батарея телефона.
  document.querySelectorAll('[data-reels-rail]').forEach((rail) => {
    new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) tiles.forEach(stopTile);
      },
      { threshold: 0 }
    ).observe(rail);
  });
</script>
