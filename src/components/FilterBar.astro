---
// ПОЛОСА НАД КАТАЛОГОМ (реф. Яндекс Путешествия): один ряд чипов с
// горизонтальным скроллом. Слева направо:
//   1. чип «Фильтры» — открывает шторку FilterSheet целиком (там же
//      живут все категории — полоса их не повторяет);
//   2. сортировка — чип с кареткой, открывает свою шторку со списком.
// Любая настройка открывается шторкой снизу — никаких выпадающих списков.
// На ПК (от 1024px) полосы нет вовсе: все настройки, включая сортировку,
// живут в левой колонке (FilterSheet в режиме .sheet--dock).
// Сама фильтрация и синхронизация состояния чипов — в FilterSheet.astro:
// полоса только отдаёт клики. Здесь — только сортировка.
import type { FilterGroup } from '../data/specialists';
import type { FilterCounts } from '../lib/filter-counts';
import { SORTS } from '../lib/sort';
import Icon from './Icon.astro';

interface Props {
  /** оставлен для совместимости вызовов страниц каталога, полосой не используется */
  groups?: FilterGroup[];
  counts?: FilterCounts;
  /** есть ли что сортировать — у категорий-заглушек карточек нет */
  sortable?: boolean;
}

const { sortable = true } = Astro.props;
---

<div class="fbar">
  <div class="fbar__scroll">
    <!-- Словом, не иконкой-«тюнингом»: слайдеры без подписи не читались -->
    <button class="chip" type="button" data-sheet-open="filters">
      Фильтры
      <span class="chip__badge" data-filters-badge hidden>0</span>
    </button>

    {sortable && (
      <button class="chip" type="button" data-sheet-open="sort" data-sort-toggle>
        <span data-sort-label>{SORTS[0].label}</span>
        <Icon name="caretDown" class="chip__caret" />
      </button>
    )}
  </div>

  {sortable && (
    <div class="sheet" data-sheet="sort">
      <div class="sheet__backdrop" data-sheet-close></div>
      <section class="sheet__panel" role="dialog" aria-modal="true" aria-labelledby="sort-title">
        <header class="sheet__head">
          <h2 class="sheet__title" id="sort-title">Сортировка</h2>
          <button class="icon-btn" type="button" data-sheet-close aria-label="Закрыть">
            <Icon name="close" />
          </button>
        </header>
        <div class="sheet__body" data-lenis-prevent>
          <div class="radio-list">
            {SORTS.map((s, i) => (
              <label class="radio-row">
                <input class="radio-row__input" type="radio" name="sort" value={s.value} checked={i === 0} data-sort-by />
                <span class="radio-row__mark" aria-hidden="true"></span>
                <span class="radio-row__label">{s.label}</span>
              </label>
            ))}
          </div>
        </div>
      </section>
    </div>
  )}
</div>

<style>
  /* Ряд уходит за край экрана и листается пальцем; сами чипы не сжимаются.
     touch-action: pan-x — жест на ленте живёт только по горизонтали:
     без него браузер разрешает косой свайп, и лента едет вбок, пока
     страница уезжает вверх (та же болезнь, что была у галереи — там
     решена в PhotoRail зеркально, pan-y). Цена: вертикальный скролл
     страницы нельзя начать с самой ленты — она 44px высотой, не жалко. */
  .fbar__scroll {
    display: flex;
    gap: var(--s-2);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    touch-action: pan-x;
    scrollbar-width: none;
    padding: 0 var(--gutter) var(--s-4);
    /* чтобы бейдж на иконке не резался краем скролл-контейнера */
    padding-top: var(--s-1);
  }

  .fbar__scroll::-webkit-scrollbar { display: none; }

  .fbar__scroll > * { flex: none; }

  /* ПК: настройки в левой колонке, полоса не нужна */
  @media (min-width: 1024px) {
    .fbar { display: none; }
  }
</style>

<script>
  import { bindSheet } from '../lib/sheet';

  // ============ СОРТИРОВКА ============
  // Карточки уже в разметке; сортируем через CSS order — DOM не двигаем,
  // порядок для поисковика остаётся исходным. Рекламная карточка (без
  // data-sort) остаётся на своём месте в ряду.
  // ЗАГЛУШКА: с бэкендом сортировка уходит в запрос, полоса не меняется.
  const sheet = document.querySelector<HTMLElement>('[data-sheet="sort"]');
  const grid = document.querySelector<HTMLElement>('[data-sort-grid]');

  if (sheet && grid) {
    const handle = bindSheet(sheet);
    const toggle = document.querySelector<HTMLButtonElement>('[data-sort-toggle]')!;
    const label = toggle.querySelector<HTMLElement>('[data-sort-label]')!;
    // Радио два комплекта: в шторке (телефон) и в колонке FilterSheet (ПК) —
    // слушаем все, при выборе выравниваем остальные под то же значение.
    const radios = Array.from(document.querySelectorAll<HTMLInputElement>('[data-sort-by]'));

    type SortKey = { price: number; rating: number };
    const keyOf = (el: Element): SortKey | null => {
      const raw = (el as HTMLElement).dataset.sort;
      return raw ? (JSON.parse(raw) as SortKey) : null;
    };

    function applySort(by: string) {
      const kids = Array.from(grid!.children) as HTMLElement[];
      if (!by) {
        kids.forEach((el) => el.style.removeProperty('order'));
        return;
      }
      const cmp: Record<string, (a: SortKey, b: SortKey) => number> = {
        'price-asc': (a, b) => a.price - b.price,
        'price-desc': (a, b) => b.price - a.price,
        rating: (a, b) => b.rating - a.rating,
      };
      const sorted = kids.filter(keyOf).sort((a, b) => cmp[by](keyOf(a)!, keyOf(b)!));
      let ci = 0;
      kids.forEach((el, i) => {
        const target = keyOf(el) ? sorted[ci++] : el;
        target.style.order = String(i);
      });
    }

    radios.forEach((radio) =>
      radio.addEventListener('change', () => {
        if (!radio.checked) return;
        radios.forEach((r) => { r.checked = r.value === radio.value; });
        label.textContent = radio.closest('.radio-row')!.querySelector('.radio-row__label')!.textContent!.trim();
        // Чип сортировки подсвечен, пока порядок не «Популярные»
        toggle.classList.toggle('is-active', radio.value !== '');
        applySort(radio.value);
        handle.close();
      })
    );
  }
</script>
