---
// Первый экран карточки площадки: кадр во весь экран, текст прижат
// к его низу. Слева — знак и название, справа — лид и действие.
// Телефона тут нет: он живёт в шапке и в блоке контактов.
// Характеристики идут отдельной полосой уже под фотографией.
//
// ПЕРВЫЙ ЭКРАН — ЭТО РЕЛЬС, А НЕ ОДИН КАДР. Доска на главной листается
// как Pinterest, и нажатие должно открывать ИМЕННО тот кадр, по которому
// нажали, а не дежурное фото площадки: иначе человек тапает по свечам,
// а попадает на чужой зал и не понимает, туда ли он пришёл. Кадр из
// адреса (`#foto-<имя файла>`) выбирает инлайновый скрипт внизу файла:
// сборка статическая, на сервере про якорь знать неоткуда.
// Заодно первый экран стал листаемым — вся галерея площадки под пальцем
// сразу, без прокрутки до блока «Галерея».
import type { Venue } from '../data/venues';
import PhotoRail from './PhotoRail.astro';
import Icon from './Icon.astro';
import { frameId } from '../lib/media';
import { venueFavorite } from '../lib/favorite-snapshot';

interface Props {
  venue: Venue;
}

const { venue } = Astro.props;

// Первым идёт дежурный кадр площадки (он же LCP и открытка для тех, кто
// пришёл без якоря), дальше вся галерея. Повторы убираем: кадр героя
// нередко лежит и в галерее, и рельс бы дважды показал одно и то же.
const frames = [...new Set([venue.hero.image, ...venue.gallery.map((shot) => shot.src)])];

// Снимок для «Избранного» — общий с каталогом (см. lib/favorite-snapshot):
// сердце на карточке площадки и сердце на карточке каталога должны
// класть в хранилище одну и ту же запись, иначе площадка задвоится.
const favorite = await venueFavorite(venue);
---

<section class="vhero">
  <!-- Кадр во всю ширину экрана, но НЕ во всю высоту: высоту держим так,
       чтобы под кадром на том же экране помещалось название площадки.
       Фотография и заголовок — одно сообщение, разносить их прокруткой
       нельзя. -->
  <figure class="vhero__shot" data-hero-rail data-frames={JSON.stringify(frames.map(frameId))}>
    <PhotoRail photos={frames} alt={venue.hero.alt} sizes="100vw" widths={[720, 1400, 2000]} priority>
      <button
        class="save"
        type="button"
        data-save={JSON.stringify(favorite)}
        aria-pressed="false"
        aria-label="В избранное"
      >
        <Icon name="heartOutline" />
      </button>

    </PhotoRail>
  </figure>

  <!-- Текст живёт НА БУМАГЕ, под кадром, а не поверх него. Подпись поверх
       фотографии — всегда компромисс: она затемняет кадр вуалью, зависит
       от того, что именно на снимке, и на светлом фото читается плохо.
       Здесь фотография остаётся фотографией, текст — текстом. -->
  <div class="container container--wide vhero__inner">
    <!-- Крошки — ПОД кадром. Наверху они отжимали обложку от края экрана
         ради строки мелкого служебного текста: первое, что видел человек,
         была не площадка, а «Главная / Площадки / …». Из разметки их не
         убираем — это внутренняя перелинковка и хлебная крошка в выдаче. -->
    <nav class="crumbs vhero__crumbs t-caption" aria-label="Хлебные крошки">
      <a href="/">Главная</a>
      <span aria-hidden="true">/</span>
      <a href={`/${venue.citySlug}/${venue.categorySlug}/`}>{venue.category}</a>
      <span aria-hidden="true">/</span>
      <span>{venue.name}</span>
    </nav>

    <div class="vhero__bottom" data-reveal-group>
      <div class="vhero__id">
        {
          venue.logo && (
            <span
              class="vhero__logo"
              role="img"
              aria-label={`Логотип площадки «${venue.logo.label}»`}
              style={`--logo: url('${venue.logo.src}'); --logo-ratio: ${venue.logo.ratio};`}
            />
          )
        }

        <p class="vhero__kicker t-caption">{venue.kicker}</p>
        <h1 class="vhero__title">{venue.title}</h1>
      </div>

      <div class="vhero__pitch">
        <p class="vhero__lead t-lead">{venue.lead}</p>
        <a class="pill pill--lg" href="#zayavka">Забронировать дату</a>
      </div>
    </div>
  </div>
</section>

<!-- Характеристики: уже на бумаге, в общей сетке страницы.
     Не таблица «метка — значение», а крупные факты: это первое, что
     ищут глазами, и мелкой строкой оно теряется. -->
<section class="specs section section--tight">
  <div class="container container--wide">
    <dl class="specs__grid" data-reveal-group>
      {
        venue.meta.map((row) => (
          <div class="spec">
            <dt class="spec__label t-caption">{row.label}</dt>
            <dd class="spec__value">{row.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  /* ============ ПЕРВЫЙ ЭКРАН ============
     Кадр и текст стоят друг под другом, а не слоями. Раньше текст лежал
     поверх фотографии: приходилось гасить кадр вуалью, читаемость зависела
     от того, что попало в правый нижний угол снимка, а на светлых кадрах
     подпись тонула. Теперь фотография ничем не закрыта, текст — на бумаге.

     Высота кадра — не весь экран: под ним на том же экране должно
     помещаться название. Ручка одна, --vhero-shot; хочется кадр крупнее
     или мельче — крутится здесь, а не по медиазапросам вразнобой. */
  .vhero {
    --vhero-shot: 54svh;
    display: flex;
    flex-direction: column;
    gap: var(--s-5);
    padding-bottom: var(--section-gap-tight);
  }

  @media (min-width: 1024px) {
    .vhero { --vhero-shot: 62svh; }
  }

  .vhero__crumbs { opacity: 0.6; }

  /* Обложка начинается от самого верха экрана: ни крошек, ни отступа над
     ней. Кадр — первое, что человек видит на карточке площадки. */
  .vhero__shot {
    height: var(--vhero-shot);
    overflow: hidden;
    background: var(--surface-dim);
  }

  /* Рельс внутри первого экрана тянется на всю секцию: своя пропорция
     (--card-ratio) тут не нужна, высоту диктует экран. Кадры внутри
     рельс кроет сам (object-fit: cover в PhotoRail). */
  .vhero__shot :global(.prail-wrap),
  .vhero__shot :global(.prail) {
    height: 100%;
    aspect-ratio: auto;
  }

  /* Ни точек, ни счётчика: первый экран — ОДНА фотография, та, по которой
     нажали в доске, а не вторая галерея поверх настоящей (она ниже, своим
     блоком). Рельс здесь работает механизмом подмены кадра, а не листалкой:
     показывать его органы управления — значит звать листать там, где
     листать не нужно. Свайп при этом остаётся: он ничего не обещает
     на глаз и не мешает. */
  .vhero__shot :global(.prail__dots) { display: none; }

  /* Вуаль в первом экране больше не нужна: гасить кадр было нужно только
     ради текста поверх него, а текст уехал на бумагу. Кадр показываем
     как есть. */
  .vhero__shot :global(.veil) { display: none; }

  /* max-width снимаем намеренно — тот же приём, что в ScrollyScenes:
     на первом экране текст живёт по полям экрана, а не в центрированной
     колонке. С --page-max-wide на широком мониторе слева набегало
     240px центрирующего поля поверх --gutter, и герой стоял заметно
     глубже, чем секции ниже. Отступ до края теперь ровно --gutter. */
  .vhero__inner {
    max-width: none;
    display: flex;
    flex-direction: column;
    gap: var(--s-6);
  }

  /* ============ ХАРАКТЕРИСТИКИ КРУПНО ============
     Колонки заданы явно, а не auto-fit: характеристик четыре, и при
     автонаборе они складывались в 3 + 1 — одинокая ячейка во втором
     ряду. Две колонки дают ровный квадрат на любой ширине.
     Линия сверху здесь структурная (граница ячейки), а не декоративная. */
  .specs :global(.container) { max-width: none; }

  .specs__grid {
    display: grid;
    gap: var(--s-6) var(--s-8);
  }

  @media (min-width: 720px) {
    .specs__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  .spec {
    padding-top: var(--s-4);
    border-top: 1px solid var(--hairline);
  }

  .spec__label {
    font-weight: var(--w-medium);
    margin-bottom: var(--s-3);
  }

  .spec__value {
    font-size: clamp(24px, 2.2vw, 32px);
    font-weight: var(--w-head);
    line-height: var(--lh-heading);
    letter-spacing: var(--ls-display);
    text-wrap: balance;
  }

  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }

  .crumbs a { text-decoration: none; }

  @media (hover: hover) {
    .crumbs a:hover { text-decoration: underline; }
  }

  /* ============ НИЖНИЙ ЯРУС: имя слева, лид и действие справа ============ */
  .vhero__bottom {
    display: grid;
    gap: var(--s-6);
    align-items: end;
  }

  /* Знак площадки. Файл белый — красим маской: форма из PNG, заливка
     из --fg. Пропорции приходят из данных, чтобы кадр не плющило. */
  .vhero__logo {
    display: block;
    height: clamp(22px, 2.4vw, 32px);
    aspect-ratio: var(--logo-ratio);
    margin-bottom: var(--s-4);
    background: var(--fg);
    -webkit-mask: var(--logo) no-repeat left center / contain;
    mask: var(--logo) no-repeat left center / contain;
  }

  .vhero__kicker {
    font-weight: var(--w-medium);
    margin-bottom: var(--s-3);
  }

  /* Меры тут нет намеренно: ширину задаёт сама колонка нижнего яруса.
     С --measure-head имя ломалось на четыре строки — 26ch при кегле под
     сотню пикселей шире колонки, и ограничивала не мера, а колонка. */
  .vhero__title {
    font-size: clamp(38px, 5vw, 76px);
    font-weight: var(--w-head);
    line-height: var(--lh-display);
    letter-spacing: var(--ls-display);
    text-wrap: balance;
  }

  .vhero__pitch {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-5);
  }

  .vhero__lead { max-width: var(--measure-lead); }

  /* ============ ТЕЛЕФОН ============
     Лид на 20px занимал весь экран целиком и читался простынёй — опускаем
     до корпуса. Отбивка низа под плавающий док осталась: кнопка
     «Забронировать дату» иначе уезжает под нижнее меню. */
  @media (max-width: 767px) {
    .vhero__lead { font-size: var(--fs-body); }

    .vhero { padding-bottom: calc(var(--safe-b) + 96px); }
  }

  /* ============ ПК: имя к левому краю, лид к правому ============
     Колонки по содержимому и space-between: блоки прижимаются к полям
     экрана. С двумя равными 1fr правый блок начинался ровно в середине
     и читался как «поставлен по центру», а не по правому краю. */
  @media (min-width: 900px) {
    .vhero__bottom {
      grid-template-columns: auto minmax(0, 46ch);
      justify-content: space-between;
      gap: var(--s-8);
    }

    .vhero__pitch { padding-bottom: var(--s-2); }
  }
</style>

<!-- Якорь разбираем ДО модульных скриптов (те отложены и выполняются после
     разбора документа): рельс должен сразу встать на нужный кадр, иначе
     человек на мгновение увидит чужое фото и только потом своё.
     Здесь же снимаем с целевого кадра ленивую загрузку: он приехал по
     ссылке, значит нужен сейчас, а не когда до него доскроллят. -->
<script is:inline>
  (() => {
    const host = document.querySelector('[data-hero-rail]');
    const id = (location.hash.match(/^#foto-(.+)$/) || [])[1];
    if (!host || !id) return;

    const frames = JSON.parse(host.dataset.frames || '[]');
    const index = frames.indexOf(decodeURIComponent(id));
    if (index < 1) return; // 0 и «кадр не найден» — рельс и так стоит на первом

    host.querySelector('[data-prail-host]').dataset.start = String(index);
    host.querySelector('.prail__track').style.setProperty('--i', String(index));

    const img = host.querySelector(`img[data-frame="${CSS.escape(frames[index])}"]`);
    if (img) {
      img.loading = 'eager';
      img.fetchPriority = 'high';
    }
  })();
</script>

<script>
  import { bindSaveButtons } from '../lib/save';

  bindSaveButtons();
</script>
