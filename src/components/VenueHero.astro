---
// Первый экран карточки площадки: ОДНА фотография в своей настоящей
// пропорции, текст под ней на бумаге. Слева — знак и название, справа —
// лид и действие. Телефона тут нет: он живёт в шапке и в блоке контактов.
// Характеристики идут отдельной полосой уже под фотографией.
//
// БЕЗ КАРУСЕЛИ. Раньше первый экран был рельсом PhotoRail: фиксированное
// окно, все кадры площадки внутри кроются object-fit: cover под одну и ту
// же пропорцию. На практике это ломало сюжет конкретных фото — площадка
// с длинным текстом (лого + двухстрочное имя + длинный лид) сжимала окно
// в узкую полосу, и широкий студийный кадр («Лесная Роса», см. её
// hero.image) резался не по бокам, а сверху и снизу: с фото пропадала
// половина картинки. Реф. Pinterest: там карточка ленты и открытая
// фотография показывают кадр в ЕГО пропорции, а не в чужой рамке.
// Здесь то же самое — раз кадры площадки все разного формата, единого
// окна для них просто не заводим.
//
// Кадр из адреса (`#foto-<имя файла>`) выбирает инлайновый скрипт внизу
// файла: нажали в доске на свечи — открылась именно эта фотография,
// в её собственной пропорции, а не дежурный кадр площадки в чужой рамке.
// Сборка статическая, про якорь на сервере знать неоткуда, поэтому все
// кадры рендерятся сразу, лишние скрыты обычным `hidden` (а не абсолютным
// стеком, как в PhotoRail) — тогда контейнер меряет ровно то фото, что
// показано, никакого вычисления высоты не нужно вообще.
//
// Без якоря (обычный вход из каталога) — берём первую вертикальную
// фотографию площадки: мобилка — главный сценарий, а вертикальный кадр
// на телефоне полнее заполняет экран, чем горизонтальный. Фолбэк —
// дежурный hero.image, если вертикальных фото у площадки не нашлось.
// «Вертикальный» — ОДНА граница на весь проект (isPortrait в lib/media),
// та же самая, что решает, каким кадрам вообще место в доске главной:
// система не должна с ростом каталога держать своё число под каждым
// экраном, который спрашивает «это вертикальное фото или нет».
import type { Venue } from '../data/venues';
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import HeroActions from './HeroActions.astro';
import { frameId, isPortrait, isVideo, posterOf } from '../lib/media';
import { resolveImage, IMG_WIDTHS } from '../lib/images';
import { venueFavorite } from '../lib/favorite-snapshot';

interface Props {
  venue: Venue;
}

const { venue } = Astro.props;

// Повторы убираем: кадр героя нередко лежит и в галерее, показывать его
// дважды незачем.
const frames = [...new Set([venue.hero.image, ...venue.gallery.map((shot) => shot.src)])];

const defaultFrame = frames.find(isPortrait) ?? frames[0];

// Снимок для «Избранного» — общий с каталогом (см. lib/favorite-snapshot):
// сердце на карточке площадки и сердце на карточке каталога должны
// класть в хранилище одну и ту же запись, иначе площадка задвоится.
const favorite = await venueFavorite(venue);
---

<section class="vhero">
  <figure class="vhero__shot" data-hero-shot data-frames={JSON.stringify(frames.map(frameId))}>
    <HeroActions
      backHref={`/${venue.citySlug}/${venue.categorySlug}/`}
      backLabel="К списку площадок"
      save={JSON.stringify(favorite)}
    />

    {frames.map((src, n) => {
      const video = isVideo(src);
      const eager = src === defaultFrame;
      return (
        <div class="vhero__frame" data-frame={frameId(src)} hidden={src !== defaultFrame}>
          <Image
            src={resolveImage(video ? posterOf(src) : src)}
            alt={n === 0 ? venue.hero.alt : `${venue.name} — фото`}
            widths={IMG_WIDTHS.hero}
            sizes="100vw"
            loading={eager ? 'eager' : 'lazy'}
            fetchpriority={eager ? 'high' : undefined}
            decoding="async"
          />
          {video && (
            <video class="vhero__video" data-video={src} muted loop playsinline preload="none" aria-hidden="true"></video>
          )}
        </div>
      );
    })}

  </figure>

  <!-- Текст живёт НА БУМАГЕ, под кадром, а не поверх него. Подпись поверх
       фотографии — всегда компромисс: она затемняет кадр вуалью, зависит
       от того, что именно на снимке, и на светлом фото читается плохо.
       Здесь фотография остаётся фотографией, текст — текстом. -->
  <div class="container container--wide vhero__inner">
    <div class="vhero__bottom">
      <div class="vhero__id">
        <h1 class="vhero__title">{venue.title}</h1>

        <div class="vhero__meta">
          {
            venue.logo && (
              <span
                class="vhero__logo"
                role="img"
                aria-label={`Логотип площадки «${venue.logo.label}»`}
                style={`--logo: url('${venue.logo.src}'); --logo-ratio: ${venue.logo.ratio};`}
              />
            )
          }

          <p class="vhero__kicker t-caption">{venue.kicker}</p>
        </div>
      </div>

      <div class="vhero__pitch">
        <p class="vhero__lead t-lead">{venue.lead}</p>
        <a class="pill pill--lg" href="#zayavka">Забронировать дату</a>
      </div>
    </div>
  </div>
</section>

<!-- Характеристики: уже на бумаге, в общей сетке страницы.
     Не таблица «метка — значение», а крупные факты: это первое, что
     ищут глазами, и мелкой строкой оно теряется. -->
<section class="specs section section--tight">
  <div class="container container--wide">
    <dl class="specs__grid">
      {
        venue.meta.map((row) => (
          <div class="spec">
            <dt class="spec__label t-caption">{row.label}</dt>
            <dd class="spec__value">{row.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  /* ============ ПЕРВЫЙ ЭКРАН ============
     Кадр и текст стоят друг под другом, а не слоями. Раньше текст лежал
     поверх фотографии: приходилось гасить кадр вуалью, читаемость зависела
     от того, что попало в правый нижний угол снимка, а на светлых кадрах
     подпись тонула. Теперь фотография ничем не закрыта, текст — на бумаге. */
  .vhero {
    display: flex;
    flex-direction: column;
    /* Нижний док — position:fixed на любой ширине; без отступа он
       перекрывает низ текста, когда фото у площадки короткое (широкий
       кадр во всю ширину экрана — невысокий сам по себе). */
    padding-bottom: calc(var(--safe-b) + 96px);
  }

  /* Кадр — единственное место в системе, где на фото лежит не текст,
     а иконка со своей тенью (сердце, кнопка «назад») — родня меткам
     на карте, правило «текст не на фото» это не нарушает. */
  .vhero__shot {
    position: relative;
    background: var(--surface-dim);
  }

  /* Показанный кадр — блок во всю ширину, высоту диктует его СОБСТВЕННАЯ
     пропорция (width/height у Image расставлены Astro'ой из файла) —
     никакого aspect-ratio/object-fit тут нет и не должно быть: это и есть
     весь смысл отказа от общего окна. Скрытые кадры — display:none, из
     потока выпадают полностью, contain не мешает их дожидаться. */
  .vhero__frame img,
  .vhero__frame video {
    display: block;
    width: 100%;
    height: auto;
  }

  .vhero__frame[hidden] { display: none; }

  .vhero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity var(--dur-fast) var(--ease-out);
  }

  .vhero__video.is-playing { opacity: 1; }

  /* max-width снимаем намеренно — тот же приём, что в ScrollyScenes:
     на первом экране текст живёт по полям экрана, а не в центрированной
     колонке. С --page-max-wide на широком мониторе слева набегало
     240px центрирующего поля поверх --gutter, и герой стоял заметно
     глубже, чем секции ниже. Отступ до края теперь ровно --gutter. */
  .vhero__inner {
    max-width: none;
    display: flex;
    flex-direction: column;
    gap: var(--s-6);
    /* Единственная ручка отступа фото → текст — раньше тут же добавлял
       свои var(--s-5) флекс-gap контейнера .vhero, вместе выходило 56px,
       заметно на глаз. Текст должен читаться продолжением кадра, не
       отдельным блоком через воздух. */
    padding-top: var(--s-4);
  }

  /* ============ ХАРАКТЕРИСТИКИ КРУПНО ============
     Колонки заданы явно, а не auto-fit: характеристик четыре, и при
     автонаборе они складывались в 3 + 1 — одинокая ячейка во втором
     ряду. Две колонки дают ровный квадрат на любой ширине.
     Линия сверху здесь структурная (граница ячейки), а не декоративная. */
  .specs :global(.container) { max-width: none; }

  .specs__grid {
    display: grid;
    gap: var(--s-6) var(--s-8);
  }

  @media (min-width: 720px) {
    .specs__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  .spec {
    padding-top: var(--s-4);
    border-top: 1px solid var(--hairline);
  }

  .spec__label {
    font-weight: var(--w-medium);
    margin-bottom: var(--s-3);
  }

  .spec__value {
    font-size: clamp(24px, 2.2vw, 32px);
    font-weight: var(--w-head);
    line-height: var(--lh-heading);
    letter-spacing: var(--ls-display);
    text-wrap: balance;
  }

  /* ============ НИЖНИЙ ЯРУС: имя слева, лид и действие справа ============ */
  .vhero__bottom {
    display: grid;
    gap: var(--s-6);
    align-items: end;
  }

  /* Меры тут нет намеренно: ширину задаёт сама колонка нижнего яруса.
     С --measure-head имя ломалось на четыре строки — 26ch при кегле под
     сотню пикселей шире колонки, и ограничивала не мера, а колонка.
     Заголовок — первое, что читают после фото; бирка (лого + категория/
     город) идёт под ним меньше и тише, а не текстовой шапкой перед ним. */
  .vhero__title {
    font-size: clamp(38px, 5vw, 76px);
    font-weight: var(--w-head);
    line-height: var(--lh-display);
    letter-spacing: var(--ls-display);
    text-wrap: balance;
  }

  .vhero__meta {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    margin-top: var(--s-3);
  }

  /* Знак площадки. Файл белый — красим маской: форма из PNG, заливка
     из --fg. Пропорции приходят из данных, чтобы кадр не плющило. */
  .vhero__logo {
    display: block;
    height: 18px;
    aspect-ratio: var(--logo-ratio);
    flex: none;
    background: var(--fg);
    -webkit-mask: var(--logo) no-repeat left center / contain;
    mask: var(--logo) no-repeat left center / contain;
  }

  .vhero__kicker { font-weight: var(--w-medium); }

  .vhero__pitch {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-5);
  }

  .vhero__lead { max-width: var(--measure-lead); }

  /* ============ ТЕЛЕФОН ============
     Лид на 20px занимал весь экран целиком и читался простынёй — опускаем
     до корпуса. */
  @media (max-width: 767px) {
    .vhero__lead { font-size: var(--fs-body); }
  }

  /* ============ ПК: имя к левому краю, лид к правому ============
     Колонки по содержимому и space-between: блоки прижимаются к полям
     экрана. С двумя равными 1fr правый блок начинался ровно в середине
     и читался как «поставлен по центру», а не по правому краю.

     Кадр на широком экране ограничен по высоте: та же фотография в её
     собственной пропорции на всю ширину 1440px+ монитора у вертикального
     кадра превращается в отвесную полосу на два экрана. Центрируем и
     ограничиваем высоту, обрезки нет — по бокам просто остаётся бумага,
     как в открытой карточке Pinterest на широком экране. Компромисс,
     не окончательное решение: две фотографии рядом (коллаж) на ПК —
     отдельная задача, не в этом заходе. */
  @media (min-width: 1024px) {
    .vhero__shot {
      max-height: 82svh;
      display: flex;
      justify-content: center;
      overflow: hidden;
    }

    .vhero__frame { height: 100%; }

    .vhero__frame img,
    .vhero__frame video {
      width: auto;
      height: 100%;
      max-width: 100%;
      object-fit: contain;
    }

    .vhero__bottom {
      grid-template-columns: auto minmax(0, 46ch);
      justify-content: space-between;
      gap: var(--s-8);
    }

    .vhero__pitch { padding-bottom: var(--s-2); }
  }
</style>

<!-- Якорь разбираем ДО модульных скриптов (те отложены и выполняются после
     разбора документа): нужный кадр должен встать сразу, иначе человек на
     мгновение увидит чужое фото и только потом своё. -->
<script is:inline>
  (() => {
    const host = document.querySelector('[data-hero-shot]');
    const id = (location.hash.match(/^#foto-(.+)$/) || [])[1];
    if (!host || !id) return;

    const target = decodeURIComponent(id);
    const frame = host.querySelector(`[data-frame="${CSS.escape(target)}"]`);
    if (!frame) return; // кадр не найден по ссылке — площадка открывается дежурным

    host.querySelectorAll('[data-frame]').forEach((f) => { f.hidden = f !== frame; });

    const img = frame.querySelector('img');
    if (img) {
      img.loading = 'eager';
      img.fetchPriority = 'high';
    }
  })();
</script>

<script>
  import { bindSaveButtons } from '../lib/save';
  import { bindVideo } from '../lib/video';

  bindSaveButtons();

  // Ролик в герое: тот же принцип, что в PhotoRail — играет, пока его
  // кадр показан (а не скрыт через [hidden]) и секция в поле зрения.
  document.querySelectorAll<HTMLElement>('[data-hero-shot]').forEach((host) => {
    host.querySelectorAll<HTMLVideoElement>('[data-video]').forEach((video) => {
      const frame = video.closest<HTMLElement>('[data-frame]');
      bindVideo(video, { root: host, active: () => !!frame && !frame.hidden });
    });
  });
</script>
