---
// Единая полоса навигации сайта: одна и та же на главной и в каталогах.
// Четыре раздела; «Чат» убран до появления самого чата.
//
// ДВЕ РОЛИ ОДНОЙ ПОЛОСЫ, а не два компонента:
//   телефон — фиксированный таб-бар снизу во всю ширину, иконка с подписью;
//   ПК      — вертикальный рельс слева, одни иконки (реф. Pinterest).
// Разводим по существу, а не «сжимаем то же самое»: на широком экране
// горизонтальная полоса снизу тратит целую строку экрана ради четырёх
// ссылок и уводит руку от мыши, а слева она стоит там, где курсор.
// Место под рельс держит body (--rail-w в global.css) — страницы про
// полосу не знают, они читают только --dock-space.
import Icon from './Icon.astro';

interface Props {
  active?: 'feed' | 'venues' | 'vendors' | 'saved';
}

const { active } = Astro.props;

// icon — ключ из реестра src/lib/icons.ts (Solar Linear, контурные).
const items = [
  {
    key: 'feed',
    href: '/',
    label: 'Главная',
    icon: 'home',
  },
  {
    key: 'venues',
    href: '/moskva/ploshchadki/',
    label: 'Площадки',
    icon: 'venue',
  },
  // Раздел «Специалисты» ведёт сразу в каталог первого направления:
  // хаба с плитками направлений больше нет, направления переключаются
  // двухуровневой полосой CategoryNav внутри самого каталога.
  {
    key: 'vendors',
    href: '/moskva/podryadchiki/vedushchie/',
    label: 'Специалисты',
    icon: 'vendors',
  },
  {
    key: 'saved',
    href: '/izbrannoe/',
    label: 'Избранное',
    icon: 'heart',
  },
] as const;
---

<nav class="dock" aria-label="Основная навигация">
  {items.map((it) => (
    <a
      class:list={['dock__item', { 'is-active': it.key === active }]}
      href={it.href}
      title={it.label}
      aria-current={it.key === active ? 'page' : undefined}
    >
      <span class="dock__icon-wrap">
        <Icon name={it.icon} class="dock__icon" />
        {it.key === 'saved' && (
          <span class="dock__badge" data-fav-badge aria-hidden="true" hidden>0</span>
        )}
      </span>
      <span class="dock__label">{it.label}</span>
    </a>
  ))}
</nav>

<style>
  /* ============ ТАБ-БАР ============
     Во всю ширину, прибит к низу, отделён от страницы волосяной линией —
     зеркально шапке. Фон — бумага (--bg), не плашка: бар часть страницы,
     а не парящий элемент. Четыре равные ячейки: иконка, под ней подпись.
     Активный раздел — чернила, остальные приглушены прозрачностью
     (правило проекта: гасим opacity, не отдельным цветом). */
  .dock {
    position: fixed;
    inset: auto 0 0 0;
    z-index: var(--z-nav);
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    padding: 6px 0 calc(6px + var(--safe-b));
    background: var(--bg);
    border-top: 1px solid var(--hairline);
  }

  .dock__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    min-width: 0;
    padding: 4px 2px 2px;
    font-size: var(--fs-micro);
    font-weight: var(--w-medium);
    line-height: 1;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
    opacity: 0.45;
    transition: opacity var(--dur-fast) var(--ease-out);
  }

  .dock__item.is-active { opacity: 1; }

  .dock__icon-wrap {
    position: relative;
    display: block;
  }

  /* :global — иконку рисует Icon.astro, scoped-селектор этого файла
     до неё не достаёт (см. комментарий в Icon.astro). */
  :global(.dock__icon) {
    display: block;
    width: 24px;
    height: 24px;
  }

  /* Подпись под иконкой: «Специалисты» в ячейке ~90px влезает в микро-кегле */
  .dock__label {
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Счётчик избранного на плече иконки. Внутри приглушённой ячейки
     он гаснет вместе с ней — иначе кричит громче активного раздела. */
  .dock__badge {
    position: absolute;
    top: -5px;
    left: calc(100% - 8px);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 17px;
    height: 17px;
    padding: 0 4px;
    border: 1px solid currentColor;
    border-radius: var(--radius-pill);
    background: var(--bg);
    color: var(--ink);
    font-size: var(--fs-caption);
    font-weight: var(--w-medium);
    line-height: 1;
  }

  .dock__badge[hidden] { display: none; }

  /* ============ ОТ ПЛАНШЕТА ============
     Та же полоса, ячейки собираются к центру: иконка и подпись в строку. */
  @media (min-width: 640px) {
    .dock {
      display: flex;
      justify-content: center;
      gap: var(--s-6);
      padding: 10px 0 calc(10px + var(--safe-b));
    }

    .dock__item {
      flex-direction: row;
      gap: 8px;
      padding: 4px 6px;
      font-size: var(--fs-small);
      line-height: var(--lh-body);
    }

    :global(.dock__icon) { width: 20px; height: 20px; }

    .dock__label { overflow: visible; }
  }

  /* ============ ПК: ПОЛОСА СЛЕВА ============
     Реф. Pinterest: узкий вертикальный рельс у края экрана, только иконки,
     без подписей. Это не «сжатый таб-бар»: на широком экране горизонтальная
     полоса снизу занимает целую строку ради четырёх ссылок, а слева она
     стоит там, где рука мыши, и не отъедает высоту у каталога.
     Место под рельс страница не считает сама — его держит padding-left
     на body (--rail-w в global.css).
     Подписи скрыты, а не удалены: они остаются доступными для скринридера
     через сам текст ссылки, а на ховере всплывают в тултипе (title). */
  @media (min-width: 1024px) {
    .dock {
      inset: 0 auto 0 0;
      width: var(--rail-w);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
      gap: var(--s-2);
      padding: var(--s-5) 0;
      border-top: none;
      border-right: 1px solid var(--hairline);
    }

    /* Ячейка — кружок 48px: на ховере под иконкой проявляется тихая
       подложка (--surface), активная стоит на ней постоянно. Кружок, а не
       скруглённый квадрат референса: скругления в проекте запрещены всюду,
       кроме пилюль и кружков, и круглая кнопка-иконка тут уже есть
       (.icon-btn) — рельс говорит на её языке. */
    .dock__item {
      flex-direction: column;
      gap: 0;
      width: 48px;
      height: 48px;
      padding: 0;
      align-items: center;
      justify-content: center;
      border-radius: var(--radius-pill);
      transition: opacity var(--dur-fast) var(--ease-out),
                  background var(--dur-fast) var(--ease-out);
    }

    .dock__item.is-active { background: var(--surface); }

    .dock__label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    :global(.dock__icon) { width: 24px; height: 24px; }

    /* Счётчик избранного: в квадратной ячейке без подписи ему просторнее
       у верхнего правого угла иконки, а не «на плече» строки. */
    .dock__badge { top: -6px; left: calc(100% - 6px); }
  }

  @media (hover: hover) {
    .dock__item:not(.is-active):hover { opacity: 0.8; }
  }

  @media (min-width: 1024px) and (hover: hover) {
    .dock__item:hover { background: var(--surface); }
  }
</style>

<script>
  import { getFavorites, CHANGE_EVENT, STORAGE_KEY } from '../lib/favorites';

  const badge = document.querySelector<HTMLElement>('[data-fav-badge]');

  function updateBadge() {
    if (!badge) return;
    const count = getFavorites().length;
    badge.textContent = String(count);
    badge.hidden = count === 0;
  }

  updateBadge();
  window.addEventListener(CHANGE_EVENT, updateBadge);
  window.addEventListener('storage', (e) => { if (e.key === STORAGE_KEY) updateBadge(); });
</script>
