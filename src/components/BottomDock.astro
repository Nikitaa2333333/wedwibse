---
// Единое нижнее меню сайта: одно и то же на главной и на страницах площадок.
// Только типографика — никаких иконок: язык сайта строится на шрифте.
interface Props {
  active?: 'feed' | 'venues' | 'vendors' | 'saved' | 'chat';
}

const { active } = Astro.props;

const items = [
  { key: 'feed', href: '/', label: 'Главная' },
  { key: 'venues', href: '/moskva/ploshchadki/', label: 'Площадки' },
  // Раздел «Специалисты» ведёт сразу в каталог первого направления:
  // хаба с плитками направлений больше нет, направления переключаются
  // двухуровневой полосой CategoryNav внутри самого каталога.
  { key: 'vendors', href: '/moskva/podryadchiki/vedushchie/', label: 'Специалисты' },
  { key: 'saved', href: '/izbrannoe/', label: 'Избранное' },
  { key: 'chat', href: '#', label: 'Чат' },
] as const;
---

<nav class="dock" aria-label="Основная навигация">
  {items.map((it) => (
    <a
      class:list={['dock__item', { 'is-active': it.key === active }]}
      href={it.href}
      aria-current={it.key === active ? 'page' : undefined}
    >
      {it.label}
      {it.key === 'saved' && (
        <span class="dock__badge" data-fav-badge aria-hidden="true" hidden>0</span>
      )}
    </a>
  ))}
</nav>

<style>
  .dock {
    position: fixed;
    bottom: calc(var(--safe-b) + var(--s-5));
    left: 50%;
    transform: translateX(-50%);
    z-index: var(--z-nav);
    display: flex;
    align-items: center;
    padding: 5px;
    border-radius: var(--radius-pill);
    max-width: calc(100vw - var(--s-5) * 2);
    /* База — непрозрачная капсула. Стекло ниже, и только там, где оно
       по карману: backdrop-filter пересчитывается каждый кадр скролла. */
    background: var(--surface);
    border: 1px solid color-mix(in srgb, var(--ink) 8%, transparent);
    box-shadow: var(--shadow-float);
  }

  /* Стекла тут нет намеренно. Док висит поверх страницы всё время, и
     backdrop-filter на нём пересчитывается каждый кадр скролла — на
     длинной главной с коллажом это заметно тормозит. Стеклянными
     оставлены только панели, которые всплывают по клику (ScopePicker). */

  .dock__item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px clamp(14px, 2vw, 22px);
    font-size: var(--fs-small);
    font-weight: var(--w-medium);
    color: var(--ink);
    text-decoration: none;
    border-radius: var(--radius-pill);
    white-space: nowrap;
    transition: background var(--dur-fast) var(--ease-out),
                color var(--dur-fast) var(--ease-out);
  }

  .dock__item.is-active {
    background: var(--ink);
    color: var(--surface);
  }

  /* Счётчик избранного: обводка текущим цветом — читается и в активном,
     и в обычном состоянии пилюли без отдельной палитры */
  .dock__badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 17px;
    height: 17px;
    padding: 0 4px;
    border: 1px solid currentColor;
    border-radius: var(--radius-pill);
    font-size: var(--fs-caption);
    font-weight: var(--w-medium);
    line-height: 1;
  }

  .dock__badge[hidden] { display: none; }

  @media (hover: hover) {
    .dock__item:not(.is-active):hover { background: color-mix(in srgb, var(--ink) 6%, transparent); }
  }

  /* На узком экране все пять разделов обязаны поместиться в строку.
     Считали по факту: на 390px пять подписей при 16px не влезали —
     «Избранное» обрезалось краем капсулы, «Чат» уходил за экран целиком.
     Отсюда ступенька кегля и полей ниже. */
  @media (max-width: 640px) {
    .dock {
      padding: 4px;
      max-width: calc(100vw - var(--s-4));
      /* Аварийный клапан: на экранах уже 360px строка всё равно не влезет —
         пусть лучше листается вбок, чем режется краем капсулы */
      overflow-x: auto;
      scrollbar-width: none;
    }

    .dock::-webkit-scrollbar { display: none; }

    .dock__item {
      flex: none;
      padding: 9px 8px;
      font-size: var(--fs-caption);
    }
  }

  @media (max-width: 400px) {
    .dock__item { padding: 9px 6px; }
  }
</style>

<script>
  import { getFavorites, CHANGE_EVENT, STORAGE_KEY } from '../lib/favorites';

  const badge = document.querySelector<HTMLElement>('[data-fav-badge]');

  function updateBadge() {
    if (!badge) return;
    const count = getFavorites().length;
    badge.textContent = String(count);
    badge.hidden = count === 0;
  }

  updateBadge();
  window.addEventListener(CHANGE_EVENT, updateBadge);
  window.addEventListener('storage', (e) => { if (e.key === STORAGE_KEY) updateBadge(); });
</script>
