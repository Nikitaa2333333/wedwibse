---
// КНОПКА ЗАКАЗА ПОД ИМЕНЕМ КАРТОЧКИ — первое, что стоит на бумаге после
// кадра, у площадки и у подрядчика.
//
// Заказчик (16.09.2026): заказ — в самый верх страницы, до него не
// долистывают. Ряд ставится в слот `cta` HeroStage — сразу под именем
// и рейтингом, до лида.
//
// Заказчик (09.11.2026): кнопку «В избранное» из ряда убрали — избранное
// уже есть сердцем на кадре (HeroActions) и в финальном экране, а пара
// «контур + заливка» спорила за внимание. Осталось одно действие —
// большая залитая пилюля во всю ширину на телефоне.
interface Props {
  /** подпись действия: «Забронировать» у площадки, «Заказать» у подрядчика */
  orderLabel: string;
  orderHref: string;
}

const { orderLabel, orderHref } = Astro.props;
---

<div class="hero-cta">
  <!-- Ссылка настоящая (href на блок заявки) — без JS она работает, как
       работала. Скрипт BookingSheet перехватывает клик по data-booking-open
       и поднимает шторку с формой; тот же приём, что у BackButton. -->
  <a class="pill pill--lg pill--solid pill--block" href={orderHref} data-booking-open>{orderLabel}</a>
</div>

<style>
  @media (min-width: 640px) {
    .hero-cta .pill { display: inline-flex; width: auto; }
  }
</style>
