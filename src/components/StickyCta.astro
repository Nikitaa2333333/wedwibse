---
// ПЛАВАЮЩАЯ КНОПКА ЗАЯВКИ — всплывает над нижней полосой, когда ряд
// действий первого экрана уходит за верх экрана, и прячется обратно,
// когда человек возвращается к началу карточки.
//
// ЗАЧЕМ. Кнопки в конце страницы (финальный блок площадки) заказчик снял:
// до них долистывают уже после того, как решение принято, а страницу они
// удлиняли. Но и первый экран остаётся позади через полтора пролистывания
// — дальше человек читает зал, цены и отзывы без единой кнопки заказа.
// Плавающая капсула закрывает этот разрыв: наверху её нет (там настоящая
// кнопка под именем), ниже она всегда под большим пальцем.
//
// ЛАЙКА ЗДЕСЬ НЕТ. Сердце стоит ровно в одном месте — в ряду действий
// поверх первого кадра (HeroActions). Вторая кнопка избранного рядом с
// заявкой только делит внимание: правило «знак избранного один на
// страницу» тут действует так же, как в каталоге.
//
// КОМПАКТНАЯ И С СЕРЕДИНЫ (заказчик, 23.09.2026): капсула обычного
// кегля .pill, не --lg, — она не должна перетягивать взгляд с самой
// площадки; и всплывает не сразу за первым экраном, а когда человек
// прошёл примерно половину карточки (MID_PROGRESS): к этому моменту он
// уже прочитал зал и цены, и кнопка приходит к решению, а не до него.
//
// Появление — реакция на прокрутку, а не reveal контента: снятый из
// проекта механизм появлений (data-reveal) сюда не возвращается, блоки
// страницы как стояли на месте, так и стоят.
interface Props {
  /** подпись: «Забронировать» у площадки, «Заказать» у подрядчика */
  label: string;
  /** якорь блока заявки — работает без JS, как у кнопки первого экрана */
  href?: string;
}

const { label, href = '#zayavka' } = Astro.props;
---

<div class="scta" data-sticky-cta hidden>
  <a class="pill scta__btn" href={href} data-booking-open>{label}</a>
</div>

<style>
  /* ПОЛОСА СТОИТ НА РАСТВОРЕНИИ, А НЕ НА СТЕКЛЕ. Приём взят с сайта
     клиники (ctmedspb, page-booking.css, прибитая кнопка шага), где блюр
     как раз отвергли: он резал контраст текста под баром. Здесь то же —
     контент ПОД полосой растворяется в цвет бумаги снизу вверх, и кнопка
     стоит уже на сплошном фоне. Ни обводки, ни backdrop-filter: правило
     проекта прямо запрещает стекло на постоянно висящем элементе
     (--glass-* существует только для панелей, всплывающих по нажатию),
     а градиент браузеру ничего не стоит.

     Считается от вьюпорта, поэтому место вертикальной полосы на ПК
     вычитается руками (--rail-w) — так же, как у панели сравнения
     в «Избранном». Снизу — над нижней полосой телефона (--dock-h). */
  .scta {
    position: fixed;
    left: var(--rail-w);
    right: 0;
    bottom: var(--dock-h);
    z-index: var(--z-nav);
    display: flex;
    justify-content: center;
    padding: 88px var(--gutter) var(--s-4);
    /* РАСТВОРЕНИЕ ПО КРИВОЙ, А НЕ ПРЯМОЙ (заказчик, 23.09.2026: градиент
       шёл «ступеньками»). Прямая от прозрачного к бумаге на коротких 56px
       даёт резкий перелом на обоих концах — глаз видит края полосы
       (эффект полос Маха), а на тёмной секции под ней переход от чернил
       к бумаге ещё и распадается на заметные ступени яркости. Кривая
       ease-in-out (scrim) с частыми опорными точками и ramp подлиннее
       убирает оба перелома: начало и конец входят мягко. */
    background: linear-gradient(
      to bottom,
      transparent 0,
      color-mix(in srgb, var(--bg) 1.3%, transparent) 7.1px,
      color-mix(in srgb, var(--bg) 4.9%, transparent) 13.6px,
      color-mix(in srgb, var(--bg) 10.4%, transparent) 19.8px,
      color-mix(in srgb, var(--bg) 17.5%, transparent) 25.5px,
      color-mix(in srgb, var(--bg) 25.9%, transparent) 31.0px,
      color-mix(in srgb, var(--bg) 35.2%, transparent) 36.2px,
      color-mix(in srgb, var(--bg) 45.0%, transparent) 41.4px,
      color-mix(in srgb, var(--bg) 55.0%, transparent) 46.6px,
      color-mix(in srgb, var(--bg) 64.8%, transparent) 51.8px,
      color-mix(in srgb, var(--bg) 74.1%, transparent) 57.0px,
      color-mix(in srgb, var(--bg) 82.5%, transparent) 62.5px,
      color-mix(in srgb, var(--bg) 89.6%, transparent) 68.2px,
      color-mix(in srgb, var(--bg) 95.1%, transparent) 74.4px,
      color-mix(in srgb, var(--bg) 98.7%, transparent) 80.9px,
      var(--bg) 88px
    );
    pointer-events: none;
    /* Появляется полоса целиком — вместе с растворением: один только
       градиент внизу экрана без кнопки читался бы грязью на бумаге.
       Только opacity и transform, моушн-бюджет телефона. */
    opacity: 0;
    /* ПЛАВНО И ПО ОЧЕРЕДИ (заказчик, 23.09.2026: кнопка «выпрыгивала»).
       Появление: сначала медленно проступает растворение, и только на нём
       всплывает капсула. Уход — в обратном порядке: капсула опускается
       первой, растворение гаснет следом (задержка на время её ухода). */
    transform: translateY(16px);
    transition: opacity var(--dur-slow) var(--ease-inout) var(--dur-fast),
                transform var(--dur-slow) var(--ease-out) var(--dur-fast);
  }

  /* hidden снимается скриптом сразу: без JS кнопка не всплывает вовсе,
     и полоса не висит поверх страницы мёртвым грузом. */
  .scta[hidden] { display: none; }

  .scta.is-shown {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0s;
  }

  .scta__btn {
    pointer-events: auto;
    /* Кнопка по своему слову, а не во всю ширину полосы (заказчик,
       21.09.2026): растворение уже отделило её от страницы, и тянуть
       капсулу от края до края незачем — она начинала спорить с нижней
       полосой навигации, такой же широкой и прямо под ней. */
    text-align: center;
    background: var(--fg);
    color: var(--bg);
    border-color: var(--fg);
    opacity: 0;
    transform: translateY(24px);
    transition: opacity var(--dur-fast) var(--ease-out),
                transform var(--dur-fast) var(--ease-out);
  }

  /* капсула всплывает, когда растворение уже почти проступило */
  .scta.is-shown .scta__btn {
    opacity: 1;
    transform: translateY(0);
    transition: opacity var(--dur-base) var(--ease-out) calc(var(--dur-slow) * 0.45),
                transform var(--dur-base) var(--ease-out) calc(var(--dur-slow) * 0.45);
  }

  /* Пока капсула не показана, невидимая кнопка не должна ловить тап */
  .scta:not(.is-shown) .scta__btn { pointer-events: none; }

  /* Ховер-инверсия .pill здесь не нужна: капсула уже чернильная */
  @media (hover: hover) {
    .scta__btn:hover {
      background: var(--fg);
      color: var(--bg);
    }
  }
</style>

<script>
  // Кнопка показывается, когда настоящая кнопка первого экрана (.hero-cta)
  // ушла за верх экрана. Наблюдаем именно за ней, а не за пройденными
  // пикселями: у площадки и у подрядчика первый экран разной высоты, и
  // число «через 600px» разъехалось бы между страницами.
  const bar = document.querySelector<HTMLElement>('[data-sticky-cta]');
  const anchor = document.querySelector<HTMLElement>('.hero-cta');

  if (bar && anchor) {
    bar.hidden = false;
    // Запас снизу под капсулу держит body (см. --float-cta-space): капсула
    // фиксированная и места в потоке не занимает, а накрывать последний
    // блок страницы ей нельзя.
    document.body.classList.add('has-sticky-cta');

    // Доля пройденной страницы, после которой капсула всплывает
    const MID_PROGRESS = 0.4;
    // Прячем чуть раньше порога, а не ровно на нём: иначе у самой границы
    // лёгкое движение пальцем туда-обратно дёргало капсулу вверх-вниз.
    const HIDE_PROGRESS = 0.34;
    let heroGone = false;
    let pastMid = false;
    const sync = () => bar.classList.toggle('is-shown', heroGone && pastMid);

    new IntersectionObserver(([entry]) => {
      heroGone = !entry.isIntersecting;
      sync();
    }).observe(anchor);

    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        const max = document.documentElement.scrollHeight - window.innerHeight;
        const progress = max > 0 ? window.scrollY / max : 0;
        pastMid = progress >= (pastMid ? HIDE_PROGRESS : MID_PROGRESS);
        sync();
      });
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
</script>
