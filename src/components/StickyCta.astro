---
// ПЛАВАЮЩАЯ КНОПКА ЗАЯВКИ — всплывает над нижней полосой, когда ряд
// действий первого экрана уходит за верх экрана, и прячется обратно,
// когда человек возвращается к началу карточки.
//
// ЗАЧЕМ. Кнопки в конце страницы (финальный блок площадки) заказчик снял:
// до них долистывают уже после того, как решение принято, а страницу они
// удлиняли. Но и первый экран остаётся позади через полтора пролистывания
// — дальше человек читает зал, цены и отзывы без единой кнопки заказа.
// Плавающая капсула закрывает этот разрыв: наверху её нет (там настоящая
// кнопка под именем), ниже она всегда под большим пальцем.
//
// ЛАЙКА ЗДЕСЬ НЕТ. Сердце стоит ровно в одном месте — в ряду действий
// поверх первого кадра (HeroActions). Вторая кнопка избранного рядом с
// заявкой только делит внимание: правило «знак избранного один на
// страницу» тут действует так же, как в каталоге.
//
// Появление — реакция на прокрутку, а не reveal контента: снятый из
// проекта механизм появлений (data-reveal) сюда не возвращается, блоки
// страницы как стояли на месте, так и стоят.
interface Props {
  /** подпись: «Забронировать» у площадки, «Заказать» у подрядчика */
  label: string;
  /** якорь блока заявки — работает без JS, как у кнопки первого экрана */
  href?: string;
}

const { label, href = '#zayavka' } = Astro.props;
---

<div class="scta" data-sticky-cta hidden>
  <a class="pill pill--lg scta__btn" href={href} data-booking-open>{label}</a>
</div>

<style>
  /* ПОЛОСА СТОИТ НА РАСТВОРЕНИИ, А НЕ НА СТЕКЛЕ. Приём взят с сайта
     клиники (ctmedspb, page-booking.css, прибитая кнопка шага), где блюр
     как раз отвергли: он резал контраст текста под баром. Здесь то же —
     контент ПОД полосой растворяется в цвет бумаги снизу вверх, и кнопка
     стоит уже на сплошном фоне. Ни обводки, ни backdrop-filter: правило
     проекта прямо запрещает стекло на постоянно висящем элементе
     (--glass-* существует только для панелей, всплывающих по нажатию),
     а градиент браузеру ничего не стоит.

     Считается от вьюпорта, поэтому место вертикальной полосы на ПК
     вычитается руками (--rail-w) — так же, как у панели сравнения
     в «Избранном». Снизу — над нижней полосой телефона (--dock-h). */
  .scta {
    position: fixed;
    left: var(--rail-w);
    right: 0;
    bottom: var(--dock-h);
    z-index: var(--z-nav);
    display: flex;
    justify-content: center;
    padding: 56px var(--gutter) var(--s-4);
    background: linear-gradient(to bottom, transparent, var(--bg) 56px, var(--bg) 100%);
    pointer-events: none;
    /* Появляется полоса целиком — вместе с растворением: один только
       градиент внизу экрана без кнопки читался бы грязью на бумаге.
       Только opacity и transform, моушн-бюджет телефона. */
    opacity: 0;
    transition: opacity var(--dur-fast) var(--ease-out);
  }

  /* hidden снимается скриптом сразу: без JS кнопка не всплывает вовсе,
     и полоса не висит поверх страницы мёртвым грузом. */
  .scta[hidden] { display: none; }

  .scta.is-shown { opacity: 1; }

  .scta__btn {
    pointer-events: auto;
    /* Кнопка во всю ширину полосы — как на сайте клиники: на телефоне
       это главное действие экрана, и капсула по центру в половину ширины
       читалась бы одной из нескольких. */
    width: 100%;
    text-align: center;
    background: var(--fg);
    color: var(--bg);
    border-color: var(--fg);
    transform: translateY(10px);
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .scta.is-shown .scta__btn { transform: translateY(0); }

  /* На широком экране кнопка во всю ширину — это полоса через весь
     монитор; держим её в меру строки и по центру. */
  @media (min-width: 640px) {
    .scta__btn { width: auto; min-width: 320px; }
  }

  /* Ховер-инверсия .pill здесь не нужна: капсула уже чернильная */
  @media (hover: hover) {
    .scta__btn:hover {
      background: var(--fg);
      color: var(--bg);
    }
  }
</style>

<script>
  // Кнопка показывается, когда настоящая кнопка первого экрана (.hero-cta)
  // ушла за верх экрана. Наблюдаем именно за ней, а не за пройденными
  // пикселями: у площадки и у подрядчика первый экран разной высоты, и
  // число «через 600px» разъехалось бы между страницами.
  const bar = document.querySelector<HTMLElement>('[data-sticky-cta]');
  const anchor = document.querySelector<HTMLElement>('.hero-cta');

  if (bar && anchor) {
    bar.hidden = false;
    // Запас снизу под капсулу держит body (см. --float-cta-space): капсула
    // фиксированная и места в потоке не занимает, а накрывать последний
    // блок страницы ей нельзя.
    document.body.classList.add('has-sticky-cta');

    const io = new IntersectionObserver(
      ([entry]) => bar.classList.toggle('is-shown', !entry.isIntersecting),
      { rootMargin: '0px' }
    );

    io.observe(anchor);
  }
</script>
