---
// ПЕРВЫЙ ЭКРАН КАРТОЧКИ — фотография во весь экран телефона, под ней
// продолжается страница. Один компонент на площадку и на подрядчика:
// кадр открывается одинаково, чья это карточка — решает подпись в слоте.
//
// Отсюда начинается сценарий «пришёл из доски»: нажал кадр на главной —
// попал на страницу этой площадки, кадром вперёд; листнул вниз — описание,
// условия, бронь. Раньше то же самое показывал оверлей поверх доски
// (lib/viewer, снят): вид был тот же, но из него некуда было идти дальше.
//
// ДВА СЛОЯ, чтобы кадр любой пропорции заполнял экран целиком и при этом
// не кроился:
//   1) подложка — тот же кадр, растянутый cover и размытый: горизонтальный
//      снимок стоит в своём формате, а поле вокруг него того же цвета;
//   2) сам кадр — прижат к верху, в своей настоящей пропорции.
// Низ кадра гасится маской на высоте --viewer-fade и растворяется в эту
// подложку, а поверх растворённого лежит матовое стекло с подписью —
// границы у полосы нет (реф. плитка альбома в iOS).
//
// Сознательное исключение из правила «текст не лежит на фото»: подпись
// лежит на матовом стекле поверх РАЗМЫТОГО, а не на самом кадре — стекло
// ровняет любой сюжет под собой, и чернила на нём читаются на любом снимке.
//
// Кадр выбирает якорь `#foto-<имя файла>` (см. скрипт внизу): нажали
// в доске на свечи — открылась именно эта фотография. Без якоря берётся
// первый вертикальный кадр: мобилка — главный сценарий, вертикаль полнее
// заполняет экран телефона.
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { frameId, isPortrait, isVideo, posterOf } from '../lib/media';
import { resolveImage, IMG_WIDTHS } from '../lib/images';
import { hasSound } from '../data/reels';

interface Props {
  /** кадры карточки: первый показанный выбирается якорем или вертикальностью */
  frames: string[];
  alt: string;
  /** класс на секцию — чтобы страница могла добавить своё (редко) */
  class?: string;
}

const { frames, alt, class: extra } = Astro.props;

const defaultFrame = frames.find(isPortrait) ?? frames[0];
---

<section class:list={['stage', extra]} data-hero-shot data-sound-scope data-frames={JSON.stringify(frames.map(frameId))}>
  <!-- Подложка: тот же кадр под блюром. Своего <img> у неё нет — это
       копия показанного кадра, поэтому браузер берёт файл из кэша. -->
  {frames.map((src) => {
    const video = isVideo(src);
    return (
      <div class="stage__bg" data-bg={frameId(src)} hidden={src !== defaultFrame} aria-hidden="true">
        <Image
          src={resolveImage(video ? posterOf(src) : src)}
          alt=""
          widths={IMG_WIDTHS.blur}
          sizes="100vw"
          loading={src === defaultFrame ? 'eager' : 'lazy'}
          fetchpriority={src === defaultFrame ? 'high' : undefined}
          decoding="async"
        />
      </div>
    );
  })}

  <div class="stage__frames">
    {frames.map((src, n) => {
      const video = isVideo(src);
      const eager = src === defaultFrame;
      return (
        <div class="stage__frame" data-frame={frameId(src)} hidden={src !== defaultFrame}>
          {/* Маска низа — на самой медиа, не на кадре целиком: иначе она
              гасит вместе с фотографией и кнопку звука, та уходила
              в градиент полупрозрачным пятном. */}
          <div class="stage__media">
            <Image
              src={resolveImage(video ? posterOf(src) : src)}
              alt={n === 0 ? alt : `${alt} — фото`}
              widths={IMG_WIDTHS.hero}
              sizes="100vw"
              loading={eager ? 'eager' : 'lazy'}
              fetchpriority={eager ? 'high' : undefined}
              decoding="async"
            />
            {video && (
              <video class="stage__video" data-video={src} muted loop playsinline preload="none" aria-hidden="true"></video>
            )}
          </div>

          {/* Кнопка звука — у своего кадра: скрытый кадр уносит её с собой,
              и на экране всегда ровно одна, от показанного ролика. */}
          {video && hasSound(src) && (
            <button class="sound-btn" type="button" data-sound={src} aria-pressed="false" aria-label="Звук ролика">
              <span class="sound-btn__off"><Icon name="soundOff" /></span>
              <span class="sound-btn__on"><Icon name="sound" /></span>
            </button>
          )}
        </div>
      );
    })}
  </div>

  <!-- Кнопки поверх кадра (назад · избранное · поделиться) -->
  <slot name="actions" />

  <!-- Подпись на матовом стекле: имя, место, рейтинг — что именно, решает
       страница. Стекло рисует .stage__glass, содержимое приходит слотом.
       Счётчик кадров — над подписью: он один на любую карточку и говорит,
       что кадр не один и их можно листать. -->
  <div class="stage__glass">
    {frames.length > 1 && (
      <span class="stage__count t-caption" data-stage-count>1 / {frames.length}</span>
    )}
    <slot />
  </div>
</section>

<style>
  /* Высота — весь экран телефона (svh, а не vh: с vh низ уезжает под
     адресную строку Safari). Ниже сразу продолжается страница. */
  .stage {
    position: relative;
    height: 100svh;
    overflow: hidden;
    /* Бумажная подложка, а не чёрное: пока крупный кадр летит по сети,
       на весь экран стоит именно этот фон — чёрный давал провал в дыру,
       из которой не понять, грузится страница или сломалась. Тот же
       --surface-dim, что под всеми фото проекта. */
    background: var(--surface-dim);
    isolation: isolate;
  }

  .stage__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .stage__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Масштаб чуть больше единицы прячет светлую кромку блюра по краям */
    filter: blur(var(--viewer-bg-blur));
    transform: scale(1.2);
  }

  .stage__frames {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    align-items: flex-start;
    justify-content: center;
  }

  .stage__frame {
    position: relative;
    max-height: 100%;
  }

  /* Низ кадра растворяется в размытую подложку. Маска висит здесь, на
     слое с медиа, — всё, что должно остаться видимым поверх (кнопка
     звука), лежит рядом, а не внутри. */
  .stage__media {
    -webkit-mask-image: linear-gradient(to bottom, black calc(100% - var(--viewer-fade)), transparent);
    mask-image: linear-gradient(to bottom, black calc(100% - var(--viewer-fade)), transparent);
  }

  .stage__frame[hidden],
  .stage__bg[hidden] { display: none; }

  /* Кнопка звука — над стеклом и вне маски: полная непрозрачность,
     чернильный кружок читается на любом кадре. */
  .stage__frame .sound-btn {
    bottom: calc(var(--viewer-fade) + var(--s-5));
    z-index: 3;
  }

  /* Кадр в своей настоящей пропорции: ширина по экрану, высота от неё.
     Ограничение по высоте экрана — чтобы отвесная вертикаль не уезжала
     за первый экран целиком. */
  .stage__media img,
  .stage__media video {
    display: block;
    width: 100%;
    height: auto;
    max-height: 100svh;
    object-fit: cover;
  }

  .stage__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity var(--dur-fast) var(--ease-out);
  }

  .stage__video.is-playing { opacity: 1; }

  /* МАТОВОЕ СТЕКЛО — настоящее, с размытием того, что под полосой
     (backdrop-filter), а не одной заливкой: без него это был просто
     градиент в белое, стеклом там и не пахло. Шва на кромке нет,
     потому что кадр НАД полосой уже растворён маской в размытую
     подложку — блюр стекла попадает на размытое, а не на резкий край.
     Заливка не темнит, а светлеет: --viewer-frost поверх блюра.
     Затемнение в чёрный давало грязь на тёмном кадре. */
  .stage__glass {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    /* Снизу — место под нижний док: он фиксированный и перекрывал бирку
       под именем (город, знак площадки), от подписи оставалась одна
       строка. Страница читает только --dock-space и не знает, таб-бар
       там сейчас или боковой рельс. */
    padding: calc(var(--viewer-fade) + var(--s-3)) var(--gutter) calc(var(--dock-space) - var(--s-3));
    background: linear-gradient(
      to bottom,
      transparent,
      color-mix(in srgb, var(--white) var(--viewer-frost), transparent) var(--viewer-fade),
      color-mix(in srgb, var(--white) var(--viewer-frost), transparent)
    );
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    -webkit-mask-image: linear-gradient(to bottom, transparent, black var(--viewer-fade));
    mask-image: linear-gradient(to bottom, transparent, black var(--viewer-fade));
    color: var(--black);
  }

  /* Счётчик кадров: тихая строка над именем, не кнопка. Приглушение —
     opacity, а не серый краской (правило проекта). */
  .stage__count {
    display: block;
    margin-bottom: var(--s-2);
    font-weight: var(--w-medium);
    opacity: 0.6;
  }

  /* На широком экране кадр не растягивается на весь монитор (вертикаль
     превратилась бы в отвесную полосу): держим его колонкой по центру,
     подложка вокруг остаётся размытой — как открытая карточка Pinterest. */
  @media (min-width: 1024px) {
    .stage__frame { max-width: var(--stage-max-w); }

    .stage__glass {
      padding-inline: max(var(--gutter), calc((100% - var(--stage-max-w)) / 2 + var(--s-4)));
    }
  }
</style>

<!-- Якорь разбираем ДО модульных скриптов (те отложены и выполняются после
     разбора документа): нужный кадр должен встать сразу, иначе человек на
     мгновение увидит чужое фото и только потом своё. -->
<script is:inline>
  (() => {
    const host = document.querySelector('[data-hero-shot]');
    const id = (location.hash.match(/^#foto-(.+)$/) || [])[1];
    if (!host || !id) return;

    const target = decodeURIComponent(id);
    const frame = host.querySelector(`[data-frame="${CSS.escape(target)}"]`);
    if (!frame) return; // кадр не найден по ссылке — карточка открывается дежурным

    host.querySelectorAll('[data-frame]').forEach((f) => { f.hidden = f !== frame; });
    host.querySelectorAll('[data-bg]').forEach((b) => { b.hidden = b.dataset.bg !== target; });

    host.querySelectorAll(`[data-frame="${CSS.escape(target)}"] img, [data-bg="${CSS.escape(target)}"] img`)
      .forEach((img) => {
        img.loading = 'eager';
        img.fetchPriority = 'high';
      });
  })();
</script>

<script>
  import { bindVideo, bindSoundButtons } from '../lib/video';

  bindSoundButtons();

  // ============ ЛИСТАНИЕ КАДРОВ ПРЯМО НА ПЕРВОМ ЭКРАНЕ ============
  // Вся съёмка карточки листается свайпом вбок, не уходя со страницы:
  // человек пришёл из доски на конкретный кадр и дальше смотрит остальные
  // тут же. Кадры уже все в HTML (их печатает разметка выше), меняется
  // только видимость — ни перезагрузки, ни перерисовки.
  //
  // Арифметика жеста — та же, что в PhotoRail: порог 36px, косой жест
  // (больше вниз, чем вбок) не считается, чтобы не мешать прокрутке
  // страницы вниз, к описанию и брони.
  document.querySelectorAll<HTMLElement>('[data-hero-shot]').forEach((stage) => {
    const shots = Array.from(stage.querySelectorAll<HTMLElement>('[data-frame]'));
    const bgs = Array.from(stage.querySelectorAll<HTMLElement>('[data-bg]'));
    const count = stage.querySelector<HTMLElement>('[data-stage-count]');
    if (shots.length < 2) return;

    let index = Math.max(0, shots.findIndex((f) => !f.hidden));

    const show = (n: number) => {
      index = (n + shots.length) % shots.length;
      const id = shots[index].dataset.frame;

      shots.forEach((f, k) => { f.hidden = k !== index; });
      bgs.forEach((b) => { b.hidden = b.dataset.bg !== id; });
      if (count) count.textContent = `${index + 1} / ${shots.length}`;

      // соседний кадр подтягиваем заранее — листание не показывает пустоту
      [index + 1, index - 1].forEach((k) => {
        const near = shots[(k + shots.length) % shots.length];
        near?.querySelectorAll('img').forEach((img) => { img.loading = 'eager'; });
      });
    };

    show(index);

    let x0 = 0;
    let y0 = 0;

    stage.addEventListener('touchstart', (e) => {
      const t = e.changedTouches[0];
      x0 = t.clientX;
      y0 = t.clientY;
    }, { passive: true });

    stage.addEventListener('touchend', (e) => {
      const t = e.changedTouches[0];
      const dx = t.clientX - x0;
      const dy = t.clientY - y0;
      if (Math.abs(dx) < 36 || Math.abs(dx) <= Math.abs(dy)) return;
      show(index + (dx < 0 ? 1 : -1));
    }, { passive: true });

    // ПК: стрелки клавиатуры, когда первый экран в поле зрения
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
      const box = stage.getBoundingClientRect();
      if (box.bottom < 120 || box.top > window.innerHeight) return;
      show(index + (e.key === 'ArrowRight' ? 1 : -1));
    });

    // ============ РОЛИК ПО НАЖАТИЮ ============
    // Автозапуск может не сработать (энергосбережение на iPhone, отказ
    // браузера) — тогда в кадре висит постер и нажатие ничего не делало.
    // Тап по самому ролику запускает его руками, повторный — ставит паузу.
    stage.querySelectorAll<HTMLVideoElement>('[data-video]').forEach((video) => {
      video.parentElement?.addEventListener('click', () => {
        if (video.paused) {
          if (!video.src) video.src = video.dataset.video!;
          video.play().then(() => video.classList.add('is-playing')).catch(() => {});
        } else {
          video.pause();
        }
      });
    });
  });

  // Ролик в первом экране: тот же принцип, что в PhotoRail — играет,
  // пока его кадр показан (а не скрыт через [hidden]).
  document.querySelectorAll<HTMLElement>('[data-hero-shot]').forEach((host) => {
    host.querySelectorAll<HTMLVideoElement>('[data-video]').forEach((video) => {
      const frame = video.closest<HTMLElement>('[data-frame]');
      bindVideo(video, { root: host, active: () => !!frame && !frame.hidden });
    });
  });
</script>
