---
// ПЛИТКА С ОБЛОЖКОЙ — один модуль на хаб подрядчиков и ряд входов
// на главной. Кадр сверху, под ним имя раздела и капсула со счётчиком.
//
// Выросла из плиток хаба (.gtile--cover): заказчик попросил такие же
// на главной. Вёрстка вынесена сюда, а не скопирована во второе место —
// на этом проект уже обжигался (первый экран карточки и блок отзывов
// разъезжались ровно так: одна разметка, две копии).
//
// КАДР ЛЕЖИТ БЕЗ ПОЛЕЙ и растворяется в плашку по нижней кромке: обложки
// сняты на однотонном фоне в тон плитки (бежевый/чернила), поэтому шва
// между кадром и подписью быть не должно. Текста на фото нет — имя и
// счётчик стоят на бумаге под ним (правило проекта).
//
// НЕСКОЛЬКО ОБЛОЖЕК — переключаются сами (заказчик, 21.09.2026): плитка
// раздела, за которым стоят десятки людей, одной фотографией говорит
// про одного. Смена — кроссфейд по таймеру, без свайпа и точек: это
// вход в раздел, а не карусель для разглядывания. Только opacity —
// моушн-бюджет телефона; при prefers-reduced-motion смены нет вовсе.
//
// ЦВЕТ ПЛАШКИ — С САМОГО КАДРА (заказчик, 25.09.2026): градиент по нижней
// кромке растворяет обложку в плашку, и плашка обязана быть цвета низа
// кадра, иначе вместо растворения полоса. Цвет каждой обложки меряет на
// сборке lib/cover-tone, подпись сама становится белой на тёмном фоне.
// Обложки сменились — плашка плавно перетекает в цвет новой.
import { Image } from 'astro:assets';
import { resolveImage } from '../lib/images';
import { coverTone } from '../lib/cover-tone';

interface Props {
  name: string;
  href: string;
  /** готовая подпись счётчика: «7 подрядчиков», «скоро» */
  capsule: string;
  /** кадры обложки — пути как в данных (/specialists/groups/x.webp):
      один — статичная плитка, несколько — переключаются сами */
  covers: string[];
  /** тон плашки, когда обложки нет: бежевая или чернильная */
  tone?: 'beige' | 'dark';
  /** цвет плашки руками — перебивает цвет, снятый с кадра. Нужен, только
      если автоматический промахнулся (кадр с пёстрым низом) */
  bg?: string;
  /** доля экрана, которую плитка занимает на брейкпоинтах (для srcset) */
  sizes: string;
  /** первый экран — грузим сразу */
  eager?: boolean;
  /** ширины srcset: роль из IMG_WIDTHS */
  widths: number[];
  /** форма бирки (главная, 25.09.2026): срезанные верхние углы и люверс —
      тот же знак, что бирка «wed secrets» в логотипе. Режим включается
      пропом, а не переопределением .ctile снаружи (см. AGENTS.md) */
  tag?: boolean;
}

const { name, href, capsule, covers, tone = 'beige', bg, sizes, eager = false, widths, tag = false } = Astro.props;

// Цвет с кадра на каждую обложку; руками заданный bg — только первой,
// а смена кадров его не трогает (ручной цвет — осознанное решение).
const tones = await Promise.all(covers.map((c) => coverTone(c)));
const first = bg ? { bg, dark: tones[0]?.dark ?? tone === 'dark' } : tones[0];
const dark = first ? first.dark : tone === 'dark';
---

<a
  class:list={['ctile', dark && 'theme-dark', tag && 'ctile--tag']}
  href={href}
  aria-label={`${name} — ${capsule}`}
  style={first ? `--tile-bg: ${first.bg}` : undefined}
>
  {/* Кадры — декорация к имени раздела: без alt, ссылка подписана целиком */}
  {/* КАДР = СЛОЙ НА ВСЮ ПЛИТКУ: фото, его растворение и плашка под
      подписью — одного цвета (--frame-bg), одним слоем. Подпись лежит
      поверх слоёв. Так стык фото и плашки всегда внутри одного слоя и
      при смене обложки не расходится: раньше плашка перекрашивалась
      отдельно от кадра, и на стыке мелькала линия (25.09.2026).
      Высоту фото в потоке держит распорка .ctile__spacer. */}
  <span class="ctile__spacer" aria-hidden="true"></span>
  <span class="ctile__media" data-cover-swap={covers.length > 1 ? '' : undefined}>
    {covers.map((cover, n) => (
      <span
        class:list={['ctile__frame', n === 0 && 'is-on']}
        style={`--frame-bg: ${bg ?? tones[n].bg}`}
        data-dark={String(tones[n].dark)}
      >
        <span class="ctile__shot">
          <Image
            class="ctile__cover"
            src={resolveImage(cover)}
            alt=""
            widths={widths}
            sizes={sizes}
            loading={eager && n === 0 ? 'eager' : 'lazy'}
            decoding="async"
          />
        </span>
      </span>
    ))}
  </span>

  <span class="ctile__body">
    <span class="ctile__name">{name}</span>
    <span class="ctile__count" aria-hidden="true">{capsule}</span>
  </span>
</a>

<style>
  .ctile {
    --tile-bg: var(--cover-beige);
    position: relative;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    /* ширина явно: кадр лежит абсолютным слоем и своей ширины не даёт,
       и во flex-ячейке плитка сжималась до ширины подписи */
    width: 100%;
    height: 100%;
    /* фон плитки — только подложка до загрузки кадра; цвет плашки
       под подписью даёт слой кадра (см. .ctile__frame) */
    background: var(--tile-bg);
    color: var(--ink);
    border-radius: var(--radius-card);
    overflow: hidden;
    text-decoration: none;
    transition: color var(--dur-slow) var(--ease-inout);
  }

  /* БИРКА. Верхние углы срезаны (скос постоянной величины, не процент —
     плитки разной высоты должны резаться одинаково), нижние остаются
     скруглёнными от border-radius. Люверс — сквозная дырка маской:
     в неё виден фон страницы, как точка на бирке логотипа. Дырка —
     не текст на фото, это форма самой плитки. */
  .ctile--tag {
    /* размеры — токены --tag-* в global.css */
    clip-path: polygon(
      var(--tag-cut) 0, calc(100% - var(--tag-cut)) 0,
      100% var(--tag-cut), 100% 100%,
      0 100%, 0 var(--tag-cut)
    );
    -webkit-mask: radial-gradient(circle at 50% var(--tag-hole-y), transparent var(--tag-hole), #000 calc(var(--tag-hole) + 0.5px));
    mask: radial-gradient(circle at 50% var(--tag-hole-y), transparent var(--tag-hole), #000 calc(var(--tag-hole) + 0.5px));
  }

  /* Тёмная плитка: scoped-селектор .ctile сильнее глобального .theme-dark,
     поэтому тон читаем из его ручек здесь явно. */
  .ctile.theme-dark {
    --tile-bg: var(--bg);
    background: var(--tile-bg);
    color: var(--fg);
  }

  /* Распорка держит в потоке высоту фото (окно 4:5) — сами слои кадров
     лежат под всей плиткой абсолютно и высоты не дают. */
  .ctile__spacer {
    display: block;
    aspect-ratio: 4 / 5;
  }

  /* Стопка слоёв на всю плитку, под подписью */
  .ctile__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  /* СЛОЙ КАДРА: фото сверху, ниже — плашка цвета низа этого фото
     (--frame-bg снят на сборке, lib/cover-tone). Смена без просвета:
     новый слой (.is-on) проявляется ПОВЕРХ старого, а старый (.is-prev)
     стоит непрозрачным, пока новый не проявится, и гаснет мгновенно
     уже под ним. При перекрёстном затухании оба слоя были полупрозрачны,
     сквозь них светил фон, и на стыке фото и плашки мелькала линия.
     Без JS .is-on стоит на первом и не меняется. */
  .ctile__frame {
    position: absolute;
    inset: 0;
    display: block;
    background: var(--frame-bg, var(--tile-bg));
    opacity: 0;
  }

  .ctile__frame.is-prev {
    opacity: 1;
    z-index: 1;
  }

  .ctile__frame.is-on {
    opacity: 1;
    z-index: 2;
    transition: opacity var(--dur-slow) var(--ease-inout);
  }

  /* Фото и растворение его нижней кромки в цвет своей плашки.
     30 %: у пёстрого низа (цветы у декора) короткое растворение
     не успевало свести кромку к ровному цвету. */
  .ctile__shot {
    position: relative;
    display: block;
  }

  .ctile__shot::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 30%;
    background: linear-gradient(to bottom, transparent, var(--frame-bg, var(--tile-bg)));
    pointer-events: none;
  }

  .ctile__cover {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  /* Подпись под кадром: имя сверху с местом под две строки (у соседей
     «Площадки» и «Организация и координация» капсула должна стоять на
     одной высоте), капсула — у нижней границы плитки. */
  .ctile__body {
    position: relative;
    z-index: 3;   /* поверх слоёв кадров */
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    padding: var(--s-3) var(--s-4) var(--s-4);
  }

  /* Кегль от ширины колонки, не экрана: колонок две уже на телефоне,
     и потолок в 30px рвал длинное имя раздела на четыре строки. */
  .ctile__name {
    font-size: clamp(18px, 4.2vw, 24px);
    font-weight: var(--w-head);
    line-height: 1.04;
    letter-spacing: -0.03em;
    /* место под две строки: у соседей по ряду капсула должна стоять
       на одной высоте, сколько бы строк ни занял заголовок */
    min-height: calc(2 * 1.04em);
  }

  /* Капсула-счётчик от цвета текста, а не --surface-dim: бежевая плитка
     сама этого цвета и капсула в ней растворялась, а на чернилах тот же
     серый читался бы светлым пятном. */
  .ctile__count {
    align-self: flex-start;
    margin-top: auto;
    padding: 6px 12px;
    font-size: var(--fs-caption);
    font-weight: var(--w-medium);
    line-height: 1.2;
    white-space: nowrap;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, currentColor 12%, transparent);
  }
</style>

<script>
  // СМЕНА ОБЛОЖЕК. Кроссфейд по таймеру; плитки, у которых кадр один,
  // скрипт не трогает вовсе (у них нет data-cover-swap).
  // Уважаем prefers-reduced-motion: там смены нет — остаётся первый кадр.
  const SWAP_MS = 4000;

  const calm = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (!calm.matches) {
    document.querySelectorAll<HTMLElement>('[data-cover-swap]').forEach((stack) => {
      const frames = Array.from(stack.querySelectorAll<HTMLElement>('.ctile__frame'));
      if (frames.length < 2) return;

      let i = 0;
      // Разводим плитки по фазе: иначе все обложки на экране мигают разом,
      // и страница выглядит моргающей, а не живой.
      const phase = Math.random() * SWAP_MS;

      // Цвет плашки несёт сам слой кадра; здесь только цвет подписи:
      // белая на тёмном кадре, чернильная на светлом.
      const tile = stack.closest<HTMLElement>('.ctile');
      // длительность проявления — из токена, чтобы старый слой гас ровно
      // тогда, когда новый уже непрозрачен
      const fadeMs = () => {
        const v = getComputedStyle(stack).getPropertyValue('--dur-slow').trim();
        return v.endsWith('ms') ? parseFloat(v) : parseFloat(v) * 1000 || 600;
      };

      window.setTimeout(() => {
        window.setInterval(() => {
          const prev = frames[i];
          i = (i + 1) % frames.length;
          const next = frames[i];
          // старый — непрозрачной подложкой, новый проявляется поверх
          prev.classList.remove('is-on');
          prev.classList.add('is-prev');
          next.classList.add('is-on');
          tile?.classList.toggle('theme-dark', next.dataset.dark === 'true');
          window.setTimeout(() => prev.classList.remove('is-prev'), fadeMs());
        }, SWAP_MS);
      }, phase);
    });
  }
</script>
