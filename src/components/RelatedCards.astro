---
// РЯД СВЯЗАННЫХ КАРТОЧЕК — лента карточек под заголовком, листается вбок.
// Один модуль на три места: «Площадки из этой статьи» (блог),
// «Похожие площадки» (конец карточки площадки) и «Похожие подрядчики»
// (конец визитки). Раньше сетка жила внутри ArticleVenues; вынесена,
// чтобы конец карточки не держал вторую копию той же вёрстки.
//
// Компонент про площадки и подрядчиков ничего не знает: получает уже
// собранные строки подписи (цена, тип, имя, метка). Кто из кого это
// собирает — решает вызывающая страница (см. lib/similar.ts).
// Слот — что угодно после сетки внутри той же секции (ряд подборок в блоге).
import PhotoRail from './PhotoRail.astro';
import { IMG_WIDTHS } from '../lib/images';
import type { RelatedCard } from '../lib/similar-cards';

interface Props {
  title: string;
  cards: RelatedCard[];
  /** id заголовка — для aria-labelledby, когда блоков на странице два */
  id?: string;
}

const { title, cards, id = 'related-title' } = Astro.props;

// ЛЕНТА ВБОК, а не сетка в два столбца (заказчик, 21.09.2026). Сетка из
// трёх карточек в конце страницы занимала два экрана в высоту, стояла в
// полях текста и от самой страницы ничем не отличалась — читалась её
// продолжением, а не соседней выдачей. Лента идёт от края до края,
// карточка крупная и вертикальная, следующая видна кромкой: это сразу
// другой блок, и смотрят его тем же жестом, что кадры выше.
// Карточек до шести: в ленте лишние ничего не занимают, пока их не
// пролистали, а выбирать из трёх соседей было не из чего.
const items = cards.slice(0, 6);
---

{items.length > 0 && (
  <section class="related section section--tight" aria-labelledby={id}>
    <div class="container">
      <h2 class="related__title t-h2" id={id}>{title}</h2>

      <div class="related__rail">
        {items.map((card) => (
          <article class="vmini">
            {/* ОДИН КАДР, без карусели внутри (заказчик, 23.09.2026): лента
                 сама листается вбок, и второй горизонтальный жест внутри
                 карточки перехватывал палец — вместо соседней площадки
                 ехали кадры этой. Смотреть съёмку — на самой карточке. */}
            <PhotoRail
              photos={card.media.slice(0, 1)}
              alt={card.alt}
              href={card.href}
              sizes="(min-width: 900px) 33vw, (min-width: 640px) 50vw, 100vw"
              widths={IMG_WIDTHS.card}
            />

            <!-- Цена и тип — в подписи под кадром, а не плашками на фото:
                 одно правило на весь сайт, текст не кладём на фотографию. -->
            <div class="vmini__body">
              <p class="vmini__price">
                {card.price}
                {card.type && <span class="vmini__type">{card.type}</span>}
              </p>
              <h3 class="vmini__name">
                <a href={card.href}>{card.name}</a>
              </h3>
              {card.meta && <p class="vmini__meta t-small">{card.meta}</p>}
            </div>
          </article>
        ))}
      </div>

      <slot />
    </div>
  </section>
)}

<style>
  .related__title {
    max-width: var(--measure-head);
    margin-bottom: var(--s-5);
  }

  /* Лента от края до края экрана: поля контейнера снимаются отрицательным
     полем и возвращаются внутренним отступом — первая карточка стоит по
     сетке заголовка, последняя докручивается до правого поля.
     touch-action не ставим (см. DESIGN.md, «Жест на лентах»). */
  .related__rail {
    display: flex;
    gap: var(--s-3);
    margin-inline: calc(-1 * var(--gutter));
    padding-inline: var(--gutter);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    scroll-padding-inline-start: var(--gutter);
    scrollbar-width: none;
  }

  .related__rail::-webkit-scrollbar { display: none; }

  /* Карточка во всю высоту столбца: кадр крупный, вертикальный, подпись
     под ним — та же карточка, что в каталоге, только шире. Следующая
     видна кромкой — подсказка, что ленту крутят. */
  .vmini {
    flex: none;
    width: min(74vw, 300px);
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    /* пропорцию кадра PhotoRail читает сам (--card-ratio), а не получает
       переопределением .prail снаружи — см. правило в CLAUDE.md */
    --card-ratio: 3 / 4;
  }

  @media (min-width: 1024px) {
    .vmini { width: 320px; }
  }

  /* Цена крупно, тип вторым планом рядом — та же подпись, что в каталоге
     площадок. Вуаль не нужна: на кадре больше нет текста. */
  .vmini__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 var(--s-2);
    font-size: var(--fs-body);
    font-weight: var(--w-medium);
  }

  /* тип — тем же цветом, вторым планом только кеглем: приглушённого
     текста в проекте нет */
  .vmini__type { font-size: var(--fs-small); }

  .vmini :global(.veil) { display: none; }

  .vmini__name {
    font-size: var(--fs-h3);
    font-weight: var(--w-head);
    line-height: 1.15;
  }

  .vmini__name a { text-decoration: none; }

  .vmini__meta { margin-top: -2px; }
</style>
