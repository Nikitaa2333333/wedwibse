---
// РЯД ДЕЙСТВИЙ НА СТЕКЛЕ ПЕРВОГО ЭКРАНА — лайк, рейтинг, отзывы,
// «поделиться». Стоит под именем карточки, внутри стеклянной полосы
// HeroStage: всё, что человек может сделать с этой площадкой или
// подрядчиком, собрано в одном месте, а не разложено по странице.
//
// Форма — колонка «иконка сверху, подпись снизу», как в нижнем доке:
// четыре пилюли с текстом в ряд не влезают в 375 px, а иконка с мелкой
// подписью читается и занимает свою четверть.
//
// РИСУЕМ ТОЛЬКО ТО, ПОД ЧТО ЕСТЬ ДАННЫЕ. Нет рейтинга — нет кнопки
// (демо-звёзды рисовать нельзя, правило проекта); нет секции отзывов на
// странице — нет и кнопки «Отзывы»: кнопка, ведущая в никуда, хуже её
// отсутствия. Поэтому у площадки сейчас три действия, у подрядчика —
// четыре: у него есть блок отзывов (#otzyvy), у площадок отзывы в данных
// пока только числом.
import Icon from './Icon.astro';

interface Props {
  /** снимок карточки для избранного (lib/favorite-snapshot) — уже в JSON */
  save: string;
  /** рейтинг карточки; нет собранных отзывов — нет и звезды */
  rating?: number | null;
  /** сколько отзывов за рейтингом */
  reviews?: number | null;
  /** якорь блока отзывов на этой же странице; нет блока — нет кнопки */
  reviewsHref?: string | null;
}

const { save, rating = null, reviews = null, reviewsHref = null } = Astro.props;
---

<div class="hbar">
  <button class="hbar__btn save" type="button" data-save={save} aria-pressed="false" aria-label="В избранное">
    <Icon name="heartOutline" />
    <span class="hbar__label">Нравится</span>
  </button>

  {rating !== null && (
    <a class="hbar__btn" href={reviewsHref ?? '#'} aria-label={`Рейтинг ${rating}`}>
      <Icon name="star" />
      <span class="hbar__label">{rating.toFixed(1).replace('.', ',')}</span>
    </a>
  )}

  {reviewsHref && reviews !== null && (
    <a class="hbar__btn" href={reviewsHref}>
      <Icon name="chat" />
      <span class="hbar__label">{reviews}</span>
    </a>
  )}

  <button class="hbar__btn hbar__btn--share" type="button" data-share aria-label="Поделиться">
    <span class="hbar__icon hbar__icon--idle"><Icon name="share" /></span>
    <span class="hbar__icon hbar__icon--done"><Icon name="check" /></span>
    <span class="hbar__label">Поделиться</span>
  </button>
</div>

<style>
  /* Ряд равных долей: сколько бы действий ни осталось после проверок
     выше, они делят строку поровну и не прыгают по ширине от длины
     подписи (у «Поделиться» она вдвое длиннее числа). */
  .hbar {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    align-items: start;
    gap: var(--s-2);
    margin-top: var(--s-4);
  }

  /* Кнопка на стекле: без подложки и обводки — чернила поверх матового,
     как остальной набор полосы. Подложка тут читалась бы заплаткой:
     стекло само по себе уже слой. */
  .hbar__btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: var(--s-2) 0;
    border: 0;
    background: none;
    color: var(--black);
    text-decoration: none;
    cursor: pointer;
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .hbar__btn:active { transform: scale(0.94); }

  .hbar__btn :global(svg) {
    width: 22px;
    height: 22px;
  }

  .hbar__label {
    font-size: var(--fs-micro);
    font-weight: var(--w-medium);
    line-height: 1.2;
  }

  /* Сохранённая карточка — сердце заливается, как везде в проекте
     (правило бьёт по внутреннему path у контурной иконки). */
  .hbar__btn[aria-pressed='true'] :global(svg > *) { fill: currentColor; }

  /* «Поделиться»: на десктопе кнопка кладёт адрес в буфер и на пару
     секунд превращается в галочку (lib/share.ts ставит data-share-done). */
  .hbar__icon--done { display: none; }
  .hbar__btn--share[data-share-done] .hbar__icon--idle { display: none; }
  .hbar__btn--share[data-share-done] .hbar__icon--done { display: inline-flex; }
</style>

<script>
  import { bindSaveButtons } from '../lib/save';
  import { bindShareButtons } from '../lib/share';

  bindSaveButtons();
  bindShareButtons();
</script>
