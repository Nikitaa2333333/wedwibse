---
// АВАТАР АВТОРА — круглый портрет ЧЕЛОВЕКА, а не его работы.
// Один компонент на все места, где рядом с именем нужно лицо: визитка
// подрядчика, карточка каталога, автор отзыва.
//
// ЗАЧЕМ ОТДЕЛЬНОЕ ПОЛЕ, А НЕ «ПЕРВЫЙ КАДР ГАЛЕРЕИ». У ведущего кадры
// каталога — он сам, лицо видно и без аватарки. У фотографа, видеографа,
// декоратора в карточке лежат ЕГО РАБОТЫ, автора на них нет вовсе —
// и аватарка остаётся единственным местом, где видно, с кем человек
// будет иметь дело. Вырезать её из портфолио нельзя: свадебный кадр
// это ростовой план, квадратный кроп даёт грудь, а не лицо. Портрет
// подрядчик присылает отдельным файлом (см. AGENTS.md).
//
// Нет портрета — кружок с инициалами: слот остаётся на месте, вёрстка
// не скачет, и пустое место не читается как сломанная картинка. Тот же
// кружок был у авторов отзывов своей вёрсткой — теперь он один на всех.
//
// Кружок декоративный (aria-hidden): имя всегда стоит рядом, и читать
// его дважды экранному диктору незачем.
import { Image } from 'astro:assets';
import { resolveImage } from '../lib/images';

interface Props {
  /** портрет автора; нет — рендерятся инициалы */
  src?: string;
  /** имя нужно всегда: из него берутся инициалы */
  name: string;
  /** диаметр кружка, px */
  size?: number;
  class?: string;
}

const { src, name, size = 48, class: className } = Astro.props;

// «Юлия и Леонид Лешаковы» → ЮЛ: союз выкидываем, берём первые две
// заглавные. Фамилия третьей буквой в кружок не влезает.
const initials = name
  .split(/\s+и\s+|\s+/)
  .filter((word) => /^[А-ЯЁA-Z]/.test(word))
  .map((word) => word[0])
  .slice(0, 2)
  .join('');
---

<span class:list={['avatar', className]} style={`--avatar-size:${size}px`} aria-hidden="true">
  {src ? (
    <Image
      src={resolveImage(src)}
      alt=""
      widths={[size, size * 2]}
      sizes={`${size}px`}
      loading="lazy"
      decoding="async"
    />
  ) : (
    <span class="avatar__initials">{initials}</span>
  )}
</span>

<style>
  .avatar {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--avatar-size);
    height: var(--avatar-size);
    flex: none;
    border-radius: 50%;
    overflow: hidden;
    /* Подложка от места, а не свой серый: в оранжевой плашке визитки
       кружок с инициалами обязан оставаться читаемым. */
    background: var(--surface-dim);
    color: var(--ink);
  }

  .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Кегль от диаметра: один компонент стоит и на 28px в каталоге,
     и на 64px в визитке, своих чисел под каждый размер не заводим. */
  .avatar__initials {
    font-size: calc(var(--avatar-size) * 0.36);
    font-weight: var(--w-medium);
    line-height: 1;
    letter-spacing: 0.02em;
  }
</style>
