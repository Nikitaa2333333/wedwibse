---
// ГАЛЕРЕЯ КАРТОЧКИ — единый принцип для любого каталога (площадки,
// специалисты, дальше — любая новая категория подрядчиков): кадры
// перекладываются свайпом на тач и сами листаются при наведении мышью,
// точки-индикаторы кружками сверху слева (справа — место под сердечко
// «в избранное», снизу — под пилюли-теги).
// Один источник правды: меняем логику/тайминг листания здесь, а не в
// каждой странице каталога отдельно.
//
// ПОЧЕМУ НЕ НАТИВНАЯ ПРОКРУТКА. Раньше рельс был overflow-x: auto со
// scroll-snap. Кадр при этом ходит за пальцем: его можно взять и возить
// по фрейму, вытянуть за край в резинку, бросить на полпути — и ни snap,
// ни доворот в JS этого не убирают, потому что само перетаскивание и есть
// нативное поведение скролл-контейнера. Здесь прокрутки нет вовсе:
// жест только принимает решение «влево/вправо», кадр перекладывается
// целиком, по своей оси, одним движением.
//
// Компонент отвечает только за сам просмотр фото — цену/тип/сердечко
// кладёт вызывающая страница через слот, поверх .veil.
import { Image } from 'astro:assets';
import { resolveImage } from '../lib/images';
import { frameId, isVideo, posterOf } from '../lib/media';

interface Props {
  /** кадры карточки: фото и — по желанию — короткие немые лупы (.mp4) */
  photos: string[];
  alt: string;
  /** есть — кадры оборачиваются в ссылку (площадки); нет — просто фото (специалисты) */
  href?: string;
  sizes: string;
  widths?: number[];
  /** рельс держит первый экран: первый кадр грузится сразу и в приоритете
   *  (он же LCP страницы), остальные по-прежнему лениво */
  priority?: boolean;
  /** true — рельс не диктует свою пропорцию, а заполняет высоту родителя
   *  (родитель сам должен быть определённой высоты: flex-элемент на весь
   *  экран и т.п.). Нужно на первом экране площадки — там кадр держит
   *  доступную высоту секции, а не свои card-ratio.
   *
   *  Ручка живёт ЗДЕСЬ, а не переопределением снаружи через :global():
   *  такое переопределение однажды тихо перебилось другим :global(.prail)
   *  с другой страницы того же бандла — Astro и минификатор CSS скопом
   *  внешних :global()-правил друг с другом не считаются. Своя пропорция
   *  внутри компонента такого конфликта не ловит в принципе. */
  fill?: boolean;
}

const {
  photos,
  alt,
  href,
  sizes,
  widths = [360, 560, 800, 1100],
  priority = false,
  fill = false,
} = Astro.props;
---

<div class:list={['prail-wrap', fill && 'prail-wrap--fill']} data-prail-host>
  <div class:list={['prail', fill && 'prail--fill']}>
    <div class="prail__track" data-rail>
      {photos.map((src, n) => {
        const video = isVideo(src);
        const frameAlt = photos.length > 1 ? `${alt} — ${video ? 'видео' : 'фото'} ${n + 1}` : alt;

        // Первый кадр рельса, который держит первый экран страницы, грузится
        // сразу и в приоритете (он же LCP), остальные — лениво.
        const eager = priority && n === 0;

        // У ролика видимый кадр — тот же <Image>, что и у фото: постер грузится
        // лениво и с srcset, а сам файл скрипт подставляет, только когда кадр
        // реально виден (см. блок «видео» в скрипте ниже).
        const frame = (
          <Fragment>
            <Image
              src={resolveImage(video ? posterOf(src) : src)}
              alt={frameAlt}
              widths={widths}
              sizes={sizes}
              loading={eager ? 'eager' : 'lazy'}
              fetchpriority={eager ? 'high' : undefined}
              decoding="async"
              data-frame={frameId(src)}
            />
            {video && (
              <video class="prail__video" data-video={src} muted loop playsinline preload="none" aria-hidden="true"></video>
            )}
          </Fragment>
        );

        return href ? (
          <a class="prail__item" href={href} aria-label={alt}>
            {frame}
          </a>
        ) : (
          <div class="prail__item">{frame}</div>
        );
      })}
    </div>
  </div>

  <div class="veil" aria-hidden="true"></div>

  {photos.length > 1 && (
    <div class="prail__dots">
      {photos.map(() => (
        <span class="prail__dot"></span>
      ))}
    </div>
  )}

  <slot />
</div>

<style>
  /* Колонка: кадр, под ним точки. Точки раньше лежали НА фотографии
     (белые, сверху слева) — то же самое правило, что и с подписями:
     на кадр ничего не кладём. Флекс-колонка нужна там, где рельсу задают
     фиксированную высоту: кадр тянется, точки забирают свою строку,
     а не выпадают за край. */
  .prail-wrap {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  /* Окно кадра. Прокрутки нет: overflow: hidden — единственная причина,
     по которой фото больше нельзя взять пальцем и возить по фрейму.
     touch-action: pan-y отдаёт вертикальный скролл страницы браузеру —
     он остаётся нативным, а горизонтальный жест разбирает скрипт. */
  .prail {
    position: relative;
    aspect-ratio: var(--card-ratio, 4 / 5);
    overflow: hidden;
    background: var(--surface-dim);
    touch-action: pan-y;
  }

  /* fill: пропорцию задаёт не card-ratio, а высота родителя (см. проп
     выше) — родитель обязан быть определённой высоты сам. */
  .prail-wrap--fill { height: 100%; }
  .prail--fill { aspect-ratio: auto; height: 100%; }

  /* Лента кадров. Ширина ленты равна окну, кадры из неё вываливаются
     вправо и обрезаются — поэтому сдвиг ровно на --i окон и есть
     переход к кадру номер --i. Без JS виден первый кадр. */
  .prail__track {
    display: flex;
    width: 100%;
    height: 100%;
    transform: translateX(calc(var(--i, 0) * -100%));
    transition: transform var(--dur-base) var(--ease-out);
  }

  .prail__item {
    position: relative;
    flex: 0 0 100%;
    height: 100%;
  }

  /* Ролик лежит поверх своего постера и проявляется, когда реально пошёл:
     если автозапуск заблокирован (энергосбережение на iPhone) — в кадре
     просто остаётся постер, и карточка выглядит как обычное фото. */
  .prail__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity var(--dur-base) var(--ease-out);
    pointer-events: none;
  }

  .prail__video.is-playing { opacity: 1; }

  .prail__item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* кадр не должен «отрываться» от карточки при долгом нажатии */
    -webkit-user-drag: none;
    user-select: none;
  }

  /* Точки-индикаторы — строкой ПОД кадром, по центру и мелко (реф.
     Яндекс.Маркет). На фотографии им было тесно: белые точки тонули на
     светлых кадрах, а на тёмных спорили с сердечком в соседнем углу.
     Цвет берут от места (--fg), поэтому в тёмной секции светлеют сами. */
  .prail__dots {
    flex: none;
    display: flex;
    justify-content: center;
    gap: 4px;
    padding-top: var(--s-2);
  }

  /* Обе точки серые: активная — плотнее, соседние — светлее. Активная
     чернилами в полную силу выглядела точкой в конце предложения и тянула
     взгляд сильнее подписи под кадром. Серый даёт тот же смысл тише.
     Приглушаем прозрачностью от --fg, а не своим серым цветом: в тёмной
     секции точки светлеют сами. */
  .prail__dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--fg);
    opacity: 0.18;
    transition: opacity var(--dur-fast) var(--ease-out);
  }

  .prail__dot.is-on { opacity: 0.5; }
</style>

<script>
  // Кадр меняется целиком: жест решает только направление, промежуточных
  // положений нет. Автолистание по наведению — там, где есть настоящий
  // ховер (мышь, не тач).
  import { bindVideo } from '../lib/video';

  const hoverCapable = window.matchMedia('(hover: hover)').matches;

  document.querySelectorAll<HTMLElement>('[data-prail-host]').forEach((host) => {
    const track = host.querySelector<HTMLElement>('[data-rail]');
    const dots = Array.from(host.querySelectorAll<HTMLElement>('.prail__dot'));
    if (!track) return;

    const frames = track.children.length;
    let index = 0;

    const show = (n: number) => {
      index = Math.max(0, Math.min(frames - 1, n));
      track.style.setProperty('--i', String(index));
      dots.forEach((d, k) => d.classList.toggle('is-on', k === index));
      syncVideo();
    };

    // ============ ВИДЕО В КАДРЕ ============
    // Немой луп играет, пока карточка видна И его кадр — текущий в карусели
    // (механика целиком — в lib/video.ts). Слушатель видимости висит на всей
    // карточке: кадры лежат друг за другом внутри одного окна.
    const handles = Array.from(track.querySelectorAll<HTMLVideoElement>('.prail__video')).map((video) => {
      const frame = video.closest('.prail__item');
      return bindVideo(video, {
        root: host,
        active: () => !!frame && Array.prototype.indexOf.call(track!.children, frame) === index,
      });
    });

    function syncVideo() {
      handles.forEach((handle) => handle.sync());
    }

    // Стартовый кадр может задать страница: карточка площадки открывается
    // на том кадре, по которому нажали в доске (data-start ставит её
    // инлайновый скрипт ДО этого модуля, чтобы не мигнуть чужим кадром).
    // Ставим ПОСЛЕ handles: show() сразу дёргает syncVideo().
    show(Number(host.dataset.start) || 0);

    if (frames < 2) return;

    // ============ СВАЙП ============
    // Считаем только начало и конец жеста. Порог в 36px отсекает дрожание
    // пальца при вертикальной прокрутке, сравнение с dy — косые жесты:
    // если палец шёл больше вниз, чем вбок, это скролл страницы, не свайп.
    let x0 = 0;
    let y0 = 0;
    let tracking = false;
    let swiped = false;

    host.addEventListener('touchstart', (e) => {
      const t = e.changedTouches[0];
      x0 = t.clientX;
      y0 = t.clientY;
      tracking = true;
      swiped = false;
    }, { passive: true });

    host.addEventListener('touchend', (e) => {
      if (!tracking) return;
      tracking = false;

      const t = e.changedTouches[0];
      const dx = t.clientX - x0;
      const dy = t.clientY - y0;
      if (Math.abs(dx) < 36 || Math.abs(dx) <= Math.abs(dy)) return;

      swiped = true;
      show(index + (dx < 0 ? 1 : -1));
    }, { passive: true });

    host.addEventListener('touchcancel', () => { tracking = false; }, { passive: true });

    // Свайп не должен открывать карточку и не должен жать сердечко:
    // ловим клик на перехвате, до того как он дойдёт до ссылки и кнопки.
    host.addEventListener('click', (e) => {
      if (!swiped) return;
      swiped = false;
      e.preventDefault();
      e.stopPropagation();
    }, true);

    if (!hoverCapable) return;

    let timer: ReturnType<typeof setInterval> | null = null;

    host.addEventListener('pointerenter', (e) => {
      if (e.pointerType !== 'mouse' || timer) return;
      show((index + 1) % frames); // первый кадр сразу — видно, что галерея живая
      timer = setInterval(() => show((index + 1) % frames), 1800);
    });

    host.addEventListener('pointerleave', (e) => {
      if (e.pointerType !== 'mouse') return;
      if (timer) { clearInterval(timer); timer = null; }
    });
  });
</script>
