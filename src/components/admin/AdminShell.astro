---
// Оболочка админки WED Secrets (/profi/admin/) — устройство Яндекс Директа
// и Метрики: шапка, левое меню текстом (значков нет, как в Директе) со
// счётчиками того, что ждёт действия, рабочая область на сером поле.
// Значки — AdminIcon. Всё — настоящее: карточки из каталога, заявки и правки
// из базы (lib/admin-live.ts), счётчики меню считает браузер после входа.
// Демо-данных нет (05.11.2026): выдуманные цифры в меню сняты.
// Переходы между разделами без перезагрузки — ClientRouter Astro: страница
// не мигает, ссылки меню подгружаются заранее. Поэтому скрипты страниц
// вешаются на `astro:page-load`, а не выполняются один раз.
// На телефоне (02.11, вид кабинета подрядчика) шапки и полосы разделов нет —
// нижнее меню из пяти разделов со счётчиками, «Выйти» — внизу «Сводки».
// noindex всегда: индексация сайта открыта, админка в выдачу не должна.
import { ClientRouter } from 'astro:transitions';
import Layout from '../../layouts/Layout.astro';
import AdminIcon from './AdminIcon.astro';
import './base.css';
import './admin.css';

export type AdminSection = 'overview' | 'partners' | 'moderation' | 'catalog' | 'complaints';

interface Props {
  title: string;
  section?: AdminSection;
  /** экран входа: только знак, без меню и учётки — до входа им нечего показывать */
  bare?: boolean;
}
const { title, section, bare = false } = Astro.props;

// счётчик (`count`) — сколько ждёт действия; число ставит скрипт из базы
const items: { key: AdminSection; href: string; label: string; count?: boolean; tone?: 'info' | 'ok' | 'bad'; gap?: boolean }[] = [
  { key: 'overview', href: '/profi/admin/', label: 'Сводка' },
  { key: 'partners', href: '/profi/admin/zayavki/', label: 'Заявки', count: true, tone: 'bad' },
  { key: 'moderation', href: '/profi/admin/moderaciya/', label: 'Модерация', count: true, tone: 'info' },
  { key: 'catalog', href: '/profi/admin/katalog/', label: 'Карточки' },
  // Жалобы важны меньше — отдельно, внизу меню; в базе их пока нет — без счётчика
  { key: 'complaints', href: '/profi/admin/zhaloby/', label: 'Жалобы', gap: true },
];
---

<Layout title={`${title} — Админка Wed Secrets`} description="Админка Wed Secrets: заявки партнёров, модерация, карточки, жалобы.">
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preload" href="/fonts/inter-cyrillic.woff2" as="font" type="font/woff2" crossorigin />
    <ClientRouter />
    <script is:inline>document.querySelector('meta[name="theme-color"]')?.setAttribute('content', getComputedStyle(document.documentElement).getPropertyValue('--adm-bg').trim());</script>
  </Fragment>

  <div class="adm">
    <header class="adm-head">
      <a class="adm-logo" href="/profi/admin/">
        <span class="adm-logo__name">Wed Secrets</span>
        <span class="adm-logo__tag">админка</span>
      </a>
      {!bare && (
        <div class="adm-head__right">
          <a class="adm-head__link" href="/" target="_blank" rel="noopener">Сайт</a>
          <a class="adm-head__link" href="/profi/" target="_blank" rel="noopener">Кабинет подрядчика</a>
          {/* учётка — из входа модератора (lib/cabinet-api.ts); без входа — ссылка «Войти» */}
          <a class="adm-user" href="/profi/admin/vhod/" data-adm-user data-astro-reload>
            <span class="adm-user__ava" aria-hidden="true" data-adm-ava hidden></span>
            <span class="adm-user__name" data-adm-name>Войти</span>
          </a>
          <a class="adm-head__link adm-head__out" href="#" data-adm-logout hidden>Выйти</a>
        </div>
      )}
    </header>

    {bare ? <main class="adm-bare"><slot /></main> : <div class="adm-body">
      <nav class="adm-nav" aria-label="Разделы админки">
        {items.map((it) => (
          <a class:list={['adm-nav__item', { 'is-active': it.key === section, 'adm-nav__item--gap': it.gap }]} href={it.href} aria-current={it.key === section ? 'page' : undefined}>
            <AdminIcon name={it.key} class="adm-nav__ic" />
            <span class="adm-nav__label">{it.label}</span>
            {it.count && <span class={`adm-nav__n adm-nav__n--${it.tone}`} data-nav-n={it.key} hidden></span>}
          </a>
        ))}
      </nav>

      <main class="adm-main">
        <slot />
      </main>
    </div>}
    {!bare && (
      <nav class="c-tabs" aria-label="Разделы админки">
        {items.map((it) => (
          <a class="c-tab" href={it.href} aria-current={it.key === section ? 'page' : undefined}>
            <span class="c-tab__ic"><AdminIcon name={it.key} />{it.count && <span class={`c-tab__n${it.tone === 'info' ? ' c-tab__n--info' : ''}`} data-nav-n={it.key} hidden></span>}</span>
            <span>{it.label}</span>
          </a>
        ))}
      </nav>
    )}
  </div>
</Layout>

<script>
  import { bindAdminTables } from '../../lib/admin-table';
  // ClientRouter меняет страницу без перезагрузки — привязки заново на каждой
  import { session, saveSession } from '../../lib/cabinet-api';
  import { loadRevisions, counts, setNavCount } from '../../lib/admin-live';
  document.addEventListener('astro:page-load', () => {
    if (document.querySelector('.adm')) bindAdminTables();
    const s = session('moderator');
    // счётчики меню — из базы; не загрузилось — просто без чисел
    if (s) loadRevisions().then((revs) => {
      const c = counts(revs);
      setNavCount('partners', c.newReview.length);
      setNavCount('moderation', c.editReview.length);
    }).catch(() => {});
    const user = document.querySelector<HTMLAnchorElement>('[data-adm-user]');
    if (!user || !s) return;
    const name = s.record.name || s.record.email || 'Модератор';
    user.querySelector('[data-adm-name]')!.textContent = name;
    const ava = user.querySelector<HTMLElement>('[data-adm-ava]')!;
    ava.textContent = name.slice(0, 1).toUpperCase();
    ava.hidden = false;
    user.removeAttribute('href');
    // «Выйти» — в шапке (ПК) и внизу «Сводки» (телефон)
    document.querySelectorAll<HTMLAnchorElement>('[data-adm-logout]').forEach((out) => {
      out.hidden = false;
      out.onclick = (e) => {
        e.preventDefault();
        saveSession('moderator', null);
        location.href = '/profi/admin/vhod/';
      };
    });
  });
</script>
