---
// Оболочка кабинета подрядчика и площадки — та же система, что у админки
// (Никита, 27.10.2026: «применить стили и принципы админки»): Inter, поле
// #eff2f7, белые карточки, синяя кнопка, меню текстом — токены --adm-*,
// классы admin.css. Отличия от AdminShell: свой знак («кабинет»), своя
// учётка (подрядчик, вход через Telegram) и свои разделы. Без ClientRouter:
// экраны кабинета — живые формы, каждый переход — полная загрузка.
// Нижнее меню разделов — на всех экранах кабинета, кроме входа и условий
// (Никита, 02.11, реф. Яндекс Директ): Карточки · Заявки · Помощь · Профиль.
// Раньше меню не было, пока раздел был один (27.10).
// noindex всегда: индексация сайта открыта, кабинет в выдачу не должен.
import Layout from '../../layouts/Layout.astro';
import './admin.css';
import './cabinet.css';
import { ADMIN_ICONS, type AdminIconName } from '../../lib/admin-icons';

interface Props {
  title: string;
  /** экран входа и условий: только знак, без меню и учётки */
  bare?: boolean;
  section?: Tab;
}
type Tab = 'cards' | 'leads' | 'help' | 'profile';
const { title, bare = false, section = 'cards' } = Astro.props;
const TABS: { key: Tab; href: string; label: string; icon: AdminIconName }[] = [
  { key: 'cards', href: '/profi/moi/', label: 'Карточки', icon: 'cards' },
  { key: 'leads', href: '/profi/moi/zayavki/', label: 'Заявки', icon: 'mail' },
  { key: 'help', href: '/profi/moi/pomoshch/', label: 'Помощь', icon: 'help' },
  { key: 'profile', href: '/profi/moi/profil/', label: 'Профиль', icon: 'profile' },
];
---

<Layout title={`${title} — Кабинет Wed Secrets`} description="Кабинет подрядчика и площадки Wed Secrets.">
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preload" href="/fonts/inter-cyrillic.woff2" as="font" type="font/woff2" crossorigin />
    {/* рамка браузера (адресная строка, края на айфоне) — цветом фона
        кабинета; у сайта там крем #f6efe5 */}
    <script is:inline>document.querySelector('meta[name="theme-color"]')?.setAttribute('content', '#eff2f7');</script>
  </Fragment>

  <div class="adm cab">
    {/* шапки в кабинете нет (Никита, 27.10: минимализм) — знак только
        на экранах входа и условий; «Выйти» — внизу «Моих карточек» */}
    {bare && (
      <header class="adm-head">
        <a class="adm-logo" href="/profi/moi/">
          <span class="adm-logo__name">Wed Secrets</span>
          <span class="adm-logo__tag">кабинет</span>
        </a>
      </header>
    )}

    {bare ? (
      <main class="adm-bare"><slot /></main>
    ) : (
      <div class="adm-body cab-body">
        <main class="adm-main cab-main"><slot /></main>
      </div>
    )}
    {!bare && (
      <nav class="c-tabs" aria-label="Разделы кабинета">
        {TABS.map((t) => (
          <a class="c-tab" href={t.href} aria-current={t.key === section ? 'page' : undefined}>
            <svg viewBox="0 0 24 24" aria-hidden="true" set:html={ADMIN_ICONS[t.icon]} />
            <span>{t.label}</span>
          </a>
        ))}
      </nav>
    )}
  </div>
</Layout>

<script>
  import { saveSession } from '../../lib/cabinet-api';
  document.querySelector('[data-cab-logout]')?.addEventListener('click', (e) => {
    e.preventDefault();
    saveSession('vendor', null);
    location.href = '/profi/vhod/';
  });
</script>
