---
// КАБИНЕТ НЕВЕСТЫ — «приложение внутри сайта» (Никита 14.11.2026, как Банк
// в Озоне или раздел суперприложения Яндекса): вошла с иконки человечка
// на главной — нижняя полоса сайта сменяется полосой кабинета, сверху
// крестик, который возвращает на главную с обычной полосой.
// База — система кабинета подрядчика и админки: те же base.css / admin.css /
// cabinet.css, токены --adm-* / --cab-*, строки, плашки, нижнее меню .c-tabs.
// Разделы — заготовка; структуру Никита дорисует сам.
// noindex всегда: личное пространство в выдачу не идёт.
import Layout from '../../layouts/Layout.astro';
import './base.css';
import './admin.css';
import './cabinet.css';
import { ADMIN_ICONS, type AdminIconName } from '../../lib/admin-icons';
import CabTransition from '../CabTransition.astro';

interface Props {
  title: string;
  section?: Tab;
}
type Tab = 'leads' | 'reviews' | 'profile';
const { title, section = 'leads' } = Astro.props;
const TABS: { key: Tab; href: string; label: string; icon: AdminIconName }[] = [
  { key: 'leads', href: '/moy/', label: 'Заявки', icon: 'mail' },
  { key: 'reviews', href: '/moy/otzyvy/', label: 'Отзывы', icon: 'reviews' },
  { key: 'profile', href: '/moy/profil/', label: 'Профиль', icon: 'profile' },
];
---

<Layout title={`${title} — Wed Secrets`} description="Личный кабинет Wed Secrets." noindex>
  <Fragment slot="head">
    <link rel="preload" href="/fonts/inter-cyrillic.woff2" as="font" type="font/woff2" crossorigin />
    <CabTransition />
    <script is:inline>document.querySelector('meta[name="theme-color"]')?.setAttribute('content', getComputedStyle(document.documentElement).getPropertyValue('--adm-bg').trim());</script>
  </Fragment>

  <div class="adm cab bride">
    {/* выход из «приложения» — крестиком, на главную сайта (не «выйти из учётки») */}
    <a class="bride__close" href="/" aria-label="Закрыть кабинет и вернуться на главную">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
    </a>
    <div class="adm-body cab-body">
      <main class="adm-main cab-main"><slot /></main>
    </div>
    <nav class="c-tabs" aria-label="Разделы кабинета">
      {TABS.map((t) => (
        <a class="c-tab" href={t.href} aria-current={t.key === section ? 'page' : undefined}>
          <svg viewBox="0 0 24 24" aria-hidden="true" set:html={ADMIN_ICONS[t.icon]} />
          <span>{t.label}</span>
        </a>
      ))}
    </nav>
  </div>
</Layout>

<style>
  /* Крестик — круг на сером, как закрытие раздела в суперприложениях;
     стоит над заголовком экрана справа, зона нажатия 44 px (HIG: Layout). */
  .bride__close {
    position: fixed;
    top: calc(env(safe-area-inset-top, 0px) + 12px);
    right: 12px;
    z-index: 30;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--adm-card);
    color: var(--adm-text);
    box-shadow: var(--adm-shadow-sm);
  }
  .bride__close svg { width: 20px; height: 20px; }
  @media (hover: hover) { .bride__close:hover { background: var(--adm-bg); } }
  /* заголовок экрана не залезает под крестик */
  .bride :global(.c-head) { padding-right: 56px; }
</style>
