// Значки админки и кабинета — набор Solar Linear (тонкая линия, 27.10;
// раньше Bold Duotone). Контуры —
// lib/admin-icons.ts, генерирует scripts/gen-admin-icons.mjs.
// Цвет и размер — от места вставки.
import { ADMIN_ICONS, type AdminIconName } from '../../lib/admin-icons';

interface Props {
  name: AdminIconName;
  class?: string;
}
const { name, class: className } = Astro.props;
---

<svg class={className} viewBox="0 0 24 24" aria-hidden="true" set:html={ADMIN_ICONS[name]} />

<style>
  svg { display: block; width: 18px; height: 18px; flex: none; }
</style>
