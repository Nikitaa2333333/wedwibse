---
// ТЕКСТ КАРТОЧКИ СТРУКТУРОЙ ИСХОДНИКА (CHARACTER.md, 08.10.2026).
// Один модуль на подрядчика (поле story) и площадку (блок type: 'story'):
// разделы идут в том порядке и под теми заголовками, что прислал автор
// текста. Это не каталог блоков — раздел умеет только текстовые формы
// (заголовок, крупная фраза, абзацы, плашки, пункты с именем, меню),
// набор и порядок переписываются из исходника.
//
// Правки заказчика 08.10.2026 (вечер):
// - перечисления — плашками .plates, а не столбцом буллитов: list и tiles
//   рисуются одинаково;
// - крупная фраза (lead) кеглем h2 — только у раздела без заголовка;
//   под заголовком она лид, иначе не видно, где заголовок;
// - ритм: внутри раздела тесно, между разделами — секционный отступ;
// - раздел kind: 'menu' — меню кейтеринга одной плашкой, состав мелко;
// - фото работ между разделами: пары вертикальных кадров из photos.
//
// Фирменный маркер <mark> (global.css): фразы из sec.mark подсвечиваются
// там, где встречаются в тексте раздела; знак в конце фразы — внутри.
import { Image } from 'astro:assets';
import type { StorySection } from '../data/specialists';
import { resolveImage, IMG_WIDTHS } from '../lib/images';
import { isPortrait, isVideo } from '../lib/media';

interface Props {
  sections: StorySection[];
  /** портрет автора: на телефоне над текстом, на ПК липким столбцом слева */
  portrait?: string;
  name?: string;
  /** кадры работ для пауз между разделами (берутся вертикальные, парами) */
  photos?: string[];
}

const { sections, portrait, name = '', photos = [] } = Astro.props;

/** режет строку на куски «обычный / под маркером» по фразам раздела */
function marked(text: string, marks: string[] = []): { t: string; m: boolean }[] {
  let parts = [{ t: text, m: false }];
  for (const phrase of marks) {
    parts = parts.flatMap((p) => {
      const at = p.m ? -1 : p.t.indexOf(phrase);
      if (at < 0) return [p];
      // знак в конце фразы («от 5 до 95 лет!») уходит под подложку вместе
      // с ней: оторванный восклицательный выглядит ошибкой выделения
      const tail = p.t.slice(at + phrase.length).match(/^[!?…]+/)?.[0] ?? '';
      const end = at + phrase.length + tail.length;
      return [
        { t: p.t.slice(0, at), m: false },
        { t: p.t.slice(at, end), m: true },
        { t: p.t.slice(end), m: false },
      ];
    });
  }
  return parts.filter((p) => p.t);
}

// ПАУЗЫ ФОТО. Первые кадры человек уже листал в первом экране, поэтому
// берём с середины съёмки; только вертикальные — пара встаёт ровно.
// Пауза — после каждого второго раздела, но не после последнего: текст
// заканчивается текстом, а ниже и так идут ролики и «Похожие».
const pool = photos.filter((p) => !isVideo(p) && isPortrait(p)).slice(3);
const pairs: string[][] = [];
for (let i = 0; i + 1 < pool.length; i += 2) pairs.push([pool[i], pool[i + 1]]);
const pauseAfter = new Map<number, string[]>();
let next = 0;
sections.forEach((_, i) => {
  if (i % 2 === 1 && i < sections.length - 1 && next < pairs.length) pauseAfter.set(i, pairs[next++]);
});
---

<div class:list={['story', portrait && 'story--portrait']}>
  {portrait && (
    <figure class="story__portrait media">
      <Image
        src={resolveImage(portrait)}
        alt={`${name} — портрет`}
        widths={IMG_WIDTHS.card}
        sizes="(min-width: 900px) 320px, 100vw"
        loading="lazy"
        decoding="async"
      />
    </figure>
  )}
  {sections.map((sec, i) => {
    const M = (t: string) => marked(t, sec.mark).map((p) => (p.m ? <mark>{p.t}</mark> : p.t));
    const plates = [...(sec.list ?? []), ...(sec.tiles ?? [])];
    const pause = pauseAfter.get(i);
    return (
      <>
        <section class:list={['story__sec', !sec.title && 'story__sec--cont']}>
          {sec.title && <h2 class="t-h2 story__title">{sec.title}</h2>}
          {sec.lead && <p class:list={[sec.title ? 'story__sublead' : 'story__lead']}>{sec.lead}</p>}
          {sec.text?.map((p) => <p class="story__text">{M(p)}</p>)}
          {plates.length > 0 && (
            <ul class="plates">
              {plates.map((t) => <li>{M(t)}</li>)}
            </ul>
          )}
          {sec.items && (
            <div class:list={['story__items', sec.kind === 'menu' && 'story__items--menu']}>
              {sec.items.map((it) => (
                <article class="story__item">
                  <h3 class="story__item-title">{it.title}</h3>
                  {it.text && <p class="story__item-text">{M(it.text)}</p>}
                </article>
              ))}
            </div>
          )}
          {sec.after?.map((p) => <p class="story__text">{M(p)}</p>)}
        </section>
        {pause && (
          <div class="story__pause">
            {pause.map((src) => (
              <figure class="story__shot media">
                <Image
                  src={resolveImage(src)}
                  alt={`${name} — работа`}
                  widths={IMG_WIDTHS.card}
                  sizes="(min-width: 900px) 360px, 50vw"
                  loading="lazy"
                  decoding="async"
                />
              </figure>
            ))}
          </div>
        )}
      </>
    );
  })}
</div>

<style>
  /* ============ РИТМ ============
     Внешнее больше внутреннего: между разделами — секционный отступ
     (--section-gap-tight с каждой стороны не нужен, хватает нижнего),
     внутри раздела — --s-3/--s-4. Раздел без заголовка — продолжение
     предыдущего, перед ним меньше воздуха, чем перед новым заголовком. */
  .story__sec {
    padding: 0 var(--gutter) var(--section-gap);
  }

  .story__sec:has(+ .story__sec--cont) { padding-bottom: var(--s-6); }

  .story__sec > * + * { margin-top: var(--s-4); }
  .story__sec > h2 + * { margin-top: var(--s-4); }

  /* Заголовок раздела антиквой образа, но плотнее: Cormorant 600
     на бумаге читался бледным (заказчик, 08.10.2026). Шрифт переменный
     300–700, вес берём из токена крупных заголовков. */
  .story .story__title {
    font-weight: var(--w-head-lg);
    max-width: var(--measure-head);
  }

  .story__text { max-width: var(--measure-text); }

  /* Фраза, которую автор сам вынес отдельно (премия, девиз, финал), —
     кеглем h2, когда своего заголовка у раздела нет: она и есть заголовок. */
  .story__lead {
    font-size: var(--fs-h2);
    font-weight: var(--w-head);
    line-height: var(--lh-heading);
    letter-spacing: var(--ls-display);
    max-width: var(--measure-lead);
  }

  /* Та же фраза под заголовком — лид: кегль меньше h2, иначе две
     строки одного размера спорят, где заголовок. */
  .story__sublead {
    font-size: var(--fs-lead);
    font-weight: var(--w-medium);
    line-height: var(--lh-heading);
    max-width: var(--measure-lead);
  }

  .story__sec > .plates { max-width: var(--measure-text); }

  /* ============ ПУНКТЫ С ИМЕНЕМ ============
     Имя пункта и его текст — одна группа (--s-1), между пунктами —
     --s-5: заметно меньше, чем между разделами. */
  .story__items {
    display: grid;
    gap: var(--s-5) var(--s-7);
  }

  @media (min-width: 720px) {
    .story__items { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  /* Имя пункта — жирная строка гротеском в кегле текста; крупно здесь
     только h2 раздела. Двойной класс перебивает правило образа для h3. */
  .story .story__item-title {
    font-family: var(--font-sans);
    font-size: var(--fs-body);
    font-weight: var(--w-head-lg);
    line-height: var(--lh-heading);
    letter-spacing: 0;
  }

  .story__item-text {
    margin-top: var(--s-1);
    max-width: var(--measure-text);
  }

  /* ============ МЕНЮ ============
     Меню выглядит меню: одна плашка --surface, блюда плотно, название
     жирным, состав кеглем подписи вплотную под ним. Линий между блюдами
     нет (правило списков), их разделяет воздух --s-4. */
  .story__items--menu {
    background: var(--surface);
    border-radius: var(--radius-card);
    padding: var(--s-5) var(--s-4);
    gap: var(--s-4) var(--s-6);
    max-width: var(--measure-text);
  }

  @media (min-width: 720px) {
    .story__items--menu { padding: var(--s-6); }
  }

  .story__items--menu .story__item-text {
    margin-top: 2px;
    font-size: var(--fs-small);
    line-height: var(--lh-heading);
  }

  /* ============ ПАУЗА ФОТО ============
     Пара вертикальных кадров встык по сетке: читается разворотом, не
     растягивает телефон на два экрана (каждый кадр — полколонки). */
  .story__pause {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-2);
    padding: 0 var(--gutter) var(--section-gap);
    max-width: calc(var(--measure-text) + 2 * var(--gutter));
  }

  .story__shot {
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--surface-dim);
  }

  .story__shot :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ============ ПОРТРЕТ ============
     На телефоне над текстом во всю колонку, на ПК слева фиксированным
     столбцом и едет вместе с прокруткой разделов. */
  .story__portrait {
    margin: 0 var(--gutter) var(--s-6);
  }

  .story__portrait :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (min-width: 900px) {
    .story--portrait {
      display: grid;
      grid-template-columns: minmax(0, 320px) minmax(0, 1fr);
      column-gap: var(--s-7);
      padding-left: var(--gutter);
    }

    .story--portrait .story__portrait {
      grid-column: 1;
      grid-row: 1 / span 40;
      align-self: start;
      position: sticky;
      top: var(--s-6);
      margin: 0;
    }

    .story--portrait .story__sec,
    .story--portrait .story__pause {
      grid-column: 2;
      padding-left: 0;
    }
  }
</style>
