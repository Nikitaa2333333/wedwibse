---
// Переключатель категорий специалистов: прилипающая полоса над каталогом.
// Раньше здесь было два ряда — группы (Организация · Ведущие · Декор …)
// и категории группы. Ряд групп снят (заказчик, 25.09.2026): группу
// человек уже выбрал на хабе раздела, повторять её в каталоге — лишний
// этаж на телефоне. Вместо него — стрелка «назад» на хаб
// (pages/moskva/podryadchiki/index.astro), а вкладки внутри группы
// лежат на тёмной скруглённой плашке рядом со стрелкой: это главный
// переключатель страницы, и он должен читаться сразу.
// Живёт под SiteHeader — top берёт готовую высоту шапки из --header-h
// (SiteHeader сам её публикует).
import type { SpecialistCategory } from '../data/specialists';
import { SPECIALIST_GROUPS } from '../data/specialists';
import BackButton from './BackButton.astro';

interface Props {
  categories: SpecialistCategory[];
  activeSlug: string;
  basePath?: string;
}

const { categories, activeSlug, basePath = '/moskva/podryadchiki/' } = Astro.props;

const bySlug = new Map(categories.map((c) => [c.slug, c]));
const activeGroup = SPECIALIST_GROUPS.find((g) => g.categories.includes(activeSlug));

// Категория вне групп (новая, ещё не разложенная) — показываем полный
// список, как раньше: лучше длинный ряд, чем пустой
const rowSlugs = (activeGroup?.categories ?? categories.map((c) => c.slug)).filter((s) => bySlug.has(s));

// Раздел без вкладок (в группе одна категория) — плашку не рисуем:
// одна вкладка повторяла бы заголовок каталога и притворялась
// переключателем, которому не на что переключать. Стрелка остаётся.
const showCats = rowSlugs.length > 1;
---

<nav class="cat-nav" aria-label="Категории специалистов">
  <!-- Та же кнопка «назад», что на карточке (BackButton). Всегда по
       ссылке на хаб, не по истории: после щелчков по вкладкам шаг назад
       вернул бы на соседнюю вкладку, а не к выбору раздела. -->
  <BackButton href={basePath} label="Все разделы специалистов" history={false} />

  {showCats && (
    <div class="cat-nav__tabs">
      {rowSlugs.map((slug) => {
        const c = bySlug.get(slug)!;
        return (
          <a
            href={`${basePath}${c.slug}/`}
            class={`cat-nav__cat${c.slug === activeSlug ? ' is-active' : ''}`}
            aria-current={c.slug === activeSlug ? 'page' : undefined}
          >
            {c.label}
          </a>
        );
      })}
    </div>
  )}
</nav>

<style>
  .cat-nav {
    position: sticky;
    top: var(--header-h);
    z-index: calc(var(--z-nav) - 1);
    display: flex;
    align-items: center;
    gap: var(--s-2);
    padding: var(--s-3) var(--gutter) 0;
    background: var(--bg);
  }

  /* ============ ПЛАШКА ВКЛАДОК ============
     Чернильная скруглённая плашка (--radius-card, не пилюля: пилюля у нас
     значит «кнопка-действие»), внутри — вкладки группы. Текущая вкладка —
     светлое «окошко» в плашке, та же инверсия, что у .chip и .map-pin.
     Вкладок больше, чем влезает, — плашка листается вбок сама, страница
     при этом не едет (overflow только по X, ось Y закрыта явно).
     touch-action не ставим — ось жеста выбирает браузер
     (см. DESIGN.md, «Жест на лентах»). */
  .cat-nav__tabs {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    gap: 2px;
    padding: var(--s-1);
    overflow-x: auto;
    overflow-y: clip;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    color: var(--bg);
    background: var(--fg);
    border-radius: var(--radius-card);
  }

  .cat-nav__tabs::-webkit-scrollbar { display: none; }

  .cat-nav__cat {
    flex: 1 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 8px 8px;
    font-size: var(--fs-caption);
    font-weight: var(--w-medium);
    line-height: 1;
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
    border-radius: calc(var(--radius-card) - 4px);
    transition: background var(--dur-fast) var(--ease-out),
                color var(--dur-fast) var(--ease-out);
  }

  .cat-nav__cat.is-active { background: var(--bg); color: var(--fg); }

  @media (hover: hover) {
    .cat-nav__cat:not(.is-active):hover { opacity: 0.7; }
  }
</style>
