---
// Оболочка страниц для подрядчиков и площадок (второй этап, STAGE2.md §0.1).
// Пока это ПРОТОТИП на wed-secrets.ru/profi/… — без базы, данные-заглушки.
// Вместе с кабинетом переедет на поддомен profi.wed-secrets.ru.
//
// noindex стоит ВСЕГДА: индексация сайта открыта с 20.10.2026, и черновая
// страница без него ушла бы в выдачу. Промо-страницу откроем поиску, когда
// она станет настоящей, — снимем prototype={false}, а не этот тег руками.
//
// Три вида (Никита, 20.10.2026):
// - look="promo" — промо-страница: шапка со знаком и «Войти», подвал.
// - look="auth" — вход, регистрация, пароль: только знак, без кнопки
//   в шапке (раньше она прыгала «Войти» ↔ «Регистрация») и без подвала.
// Живой кабинет (/profi/moi/) и админка — на своей оболочке CabinetShell;
// вид «tech» с меню прототипа /profi/kabinet/ удалён вместе с прототипом (05.11.2026).
// Во входе заголовки без антиквы.
import Layout from '../../layouts/Layout.astro';

interface Props {
  title: string;
  description?: string;
  /** правая ссылка в шапке (промо) */
  action?: { href: string; label: string };
  /** прототип: закрыт от поиска (по умолчанию да) */
  prototype?: boolean;
  look?: 'promo' | 'auth';
  /** свой знак в шапке вместо «WED Secrets для профи» (экран входа) */
  brand?: string;
}

const {
  title,
  description = 'Wed Secrets для подрядчиков и площадок: карточка в свадебном каталоге Москвы.',
  action,
  prototype = true,
  look = 'auth',
  brand,
} = Astro.props;

---

<Layout title={`${title} — Wed Secrets для профи`} description={description}>
  <Fragment slot="head">
    {prototype && <meta name="robots" content="noindex, nofollow" />}
  </Fragment>

  <div class={`profi profi--${look}`}>
    <header class="pbar">
      <div class:list={['pbar__in container', { 'pbar__in--center': brand }]}>
        <a class="pbar__brand" href="/profi/">
          <span class="pbar__name">{brand ?? 'Wed Secrets'}</span>
          {!brand && <span class="pbar__for">для профи</span>}
        </a>
        {action && <a class="pill pill--sm pbar__btn" href={action.href}>{action.label}</a>}
      </div>
    </header>

    <slot />

    {look === 'promo' && (
      <footer class="pfoot theme-dark">
        <div class="pfoot__in container">
          <p class="t-caption">Wed Secrets — свадебный каталог площадок и подрядчиков Москвы и области.</p>
          <p class="t-caption"><a href="/">Каталог для пар</a></p>
        </div>
      </footer>
    )}

  </div>
</Layout>

<style>
  /* Шапка узкая и стоит наверху всегда (Никита, 20.10.2026). */
  .pbar {
    position: sticky;
    top: 0;
    z-index: var(--z-nav);
    background: var(--bg);
  }
  .pbar__in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    min-height: 52px;
  }
  /* Свой знак (экран входа) стоит по центру, как на макете. */
  .pbar__in--center { justify-content: center; }
  .pbar__btn { padding-block: 6px; }

  .pbar__brand {
    display: flex;
    align-items: baseline;
    gap: var(--s-2);
    color: inherit;
    text-decoration: none;
  }

  .pbar__name {
    font-size: var(--fs-small);
    font-weight: var(--w-head-lg);
  }

  .pbar__for { font-size: var(--fs-caption); }

  /* Подвал промо — продолжение тёмного финала страницы, одна заливка до низа */
  .pfoot { margin-top: -1px; padding-block: 1px calc(var(--s-7) + var(--safe-b, 0px)); }
  .pfoot__in { display: grid; gap: var(--s-2); }

  .pfoot a { color: inherit; }

</style>

<style is:global>
  /* Кабинет и вход — рабочий инструмент: антиквы образа «крем» здесь нет
     (Никита, 20.10.2026). Селектор тяжелее правила образа в global.css. */
  html[data-look] .profi--auth :is(h1, h2, h3, h4, .t-display, .t-h1, .t-h2) {
    font-family: var(--font-sans);
    font-weight: var(--w-head-lg);
    letter-spacing: -0.01em;
  }
  html[data-look] .profi--auth :is(h1, .t-h1) { font-size: var(--fs-h2); }
  html[data-look] .profi--auth :is(h2, .t-h2) { font-size: var(--fs-h3); }
  html[data-look] .profi--auth h3 { font-size: var(--fs-body); }

  /* Промо: заголовки тоже Onest (Никита, 20.10.2026), антиква остаётся
     только у заголовка первого экрана (.hero__title). */
  html[data-look] .profi--promo :is(h2, h3, h4, .t-h1, .t-h2) {
    font-family: var(--font-sans);
    font-weight: var(--w-head-lg);
    letter-spacing: -0.02em;
  }
</style>
