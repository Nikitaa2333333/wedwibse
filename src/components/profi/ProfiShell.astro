---
// Оболочка страниц для подрядчиков и площадок (второй этап, STAGE2.md §0.1).
// Пока это ПРОТОТИП на wed-secrets.ru/profi/… — без базы, данные-заглушки.
// Вместе с кабинетом переедет на поддомен profi.wed-secrets.ru.
//
// noindex стоит ВСЕГДА: индексация сайта открыта с 20.10.2026, и черновая
// страница без него ушла бы в выдачу. Промо-страницу откроем поиску, когда
// она станет настоящей, — снимем prototype={false}, а не этот тег руками.
//
// Два вида (решение Никиты 20.10.2026):
// - look="promo" — промо-страница, витрина: шапка лежит поверх первого
//   экрана светлым по тёмному, здесь дизайн и моушн «на полную».
// - look="tech" (по умолчанию) — вход и кабинет: рабочий инструмент,
//   заголовки без засечек, без украшений. Палитра сайта та же.
//
// Нижнего дока невесты здесь нет: это другой продукт и другой человек.
import Layout from '../../layouts/Layout.astro';

interface Props {
  title: string;
  description?: string;
  /** правая ссылка в шапке */
  action?: { href: string; label: string };
  /** прототип: закрыт от поиска (по умолчанию да) */
  prototype?: boolean;
  look?: 'promo' | 'tech';
}

const {
  title,
  description = 'WED Secrets для подрядчиков и площадок: карточка в свадебном каталоге Москвы.',
  action,
  prototype = true,
  look = 'tech',
} = Astro.props;
---

<Layout title={`${title} — WED Secrets для профи`} description={description}>
  <Fragment slot="head">
    {prototype && <meta name="robots" content="noindex, nofollow" />}
  </Fragment>

  <div class={`profi profi--${look}`}>
    <header class="pbar container">
      <a class="pbar__brand" href="/profi/">
        <span class="pbar__name">WED Secrets</span>
        <span class="pbar__for">для профи</span>
      </a>
      {action && <a class="pill pill--sm pbar__btn" href={action.href}>{action.label}</a>}
    </header>

    <slot />

    <footer class="pfoot container">
      <p class="t-caption">WED Secrets — свадебный каталог площадок и подрядчиков Москвы и области.</p>
      <p class="t-caption"><a href="/">Каталог для пар</a></p>
    </footer>
  </div>
</Layout>

<style>
  .pbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    padding-block: var(--s-5);
  }

  .pbar__brand {
    display: flex;
    align-items: baseline;
    gap: var(--s-2);
    color: inherit;
    text-decoration: none;
  }

  .pbar__name {
    font-size: var(--fs-body);
    font-weight: var(--w-head-lg);
  }

  .pbar__for { font-size: var(--fs-small); }

  .pfoot {
    display: grid;
    gap: var(--s-2);
    padding-block: var(--section-gap) var(--s-7);
  }

  .pfoot a { color: inherit; }

  /* Промо: шапка поверх первого экрана, светлым по кадру. */
  .profi--promo .pbar {
    position: absolute;
    inset: 0 0 auto 0;
    z-index: 5;
    color: var(--white);
  }
  .profi--promo .pbar__btn { color: var(--white); border-color: var(--white); }
</style>

<style is:global>
  /* Кабинет и вход — рабочий инструмент: антиква образа «крем» здесь не
     нужна (Никита, 20.10.2026). Селектор тяжелее правила образа в
     global.css, иначе оно перебьёт. */
  html[data-look] .profi--tech :is(h1, h2, h3, h4, .t-display, .t-h1, .t-h2) {
    font-family: var(--font-sans);
    font-weight: var(--w-head-lg);
    letter-spacing: -0.01em;
  }
  html[data-look] .profi--tech :is(h1, .t-h1) { font-size: var(--fs-h2); }
  html[data-look] .profi--tech :is(h2, .t-h2) { font-size: var(--fs-h3); }
  html[data-look] .profi--tech h3 { font-size: var(--fs-body); }
</style>
