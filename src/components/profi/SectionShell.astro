---
// Экран одного раздела анкеты (CABINET-UX.md §2 п.4: один экран — одна
// задача). Сверху «назад» на хаб анкеты и имя раздела, строка «Сохранено»,
// содержимое, внизу «Готово» — та же ссылка на хаб. Кнопка «назад» —
// BackButton, единственная в проекте (CLAUDE.md).
import ProfiShell from './ProfiShell.astro';
import BackButton from '../BackButton.astro';

interface Props {
  title: string;
  /** подсказка под заголовком, одна строка */
  lead?: string;
  back?: string;
}

const { title, lead, back = '/profi/kabinet/anketa/' } = Astro.props;
---

<ProfiShell title={`${title} — анкета`} section="cards">
  <main class="container sec">
    <BackButton plain href={back} label="К анкете" />
    <header class="sec__head">
      <h1 class="t-h1 sec__title">{title}</h1>
      <p class="sec__saved" aria-live="polite" data-saved>Сохранено · 12:04</p>
    </header>
    {lead && <p class="sec__lead">{lead}</p>}

    <div class="sec__body"><slot /></div>

    <a class="pill pill--lg pill--solid pill--block sec__done" href={back}>Готово</a>
  </main>
</ProfiShell>

<script>
  // Автосохранение без кнопки (CABINET-UX.md §2 п.9): любое изменение
  // на экране через полсекунды становится «Сохранено · ЧЧ:ММ». В прототипе
  // на сервер ничего не уходит — только строка.
  const saved = document.querySelector<HTMLElement>('[data-saved]');
  const main = document.querySelector('main');
  if (saved && main) {
    let t = 0;
    const mark = () => {
      saved.textContent = 'Сохраняем…';
      clearTimeout(t);
      t = window.setTimeout(() => {
        const d = new Date();
        saved.textContent = `Сохранено · ${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`;
      }, 600);
    };
    main.addEventListener('input', mark);
    main.addEventListener('change', mark);
  }
</script>

<style>
  .sec { max-width: 720px; padding-top: var(--s-1); }
  /* Заголовок слева, «Сохранено» справа в той же строке (макет Никиты). */
  .sec__head { display: flex; align-items: baseline; justify-content: space-between; gap: var(--s-4); }
  .sec__title { line-height: var(--lh-caption); }
  .sec__saved { font-size: var(--fs-caption); color: var(--text-2); white-space: nowrap; }
  .sec__lead { margin-top: var(--s-3); font-size: var(--fs-small); max-width: var(--measure-text); }
  .sec__body { margin-top: var(--s-5); display: grid; gap: var(--s-5); }
  .sec__done { margin-top: var(--section-gap); }
</style>
