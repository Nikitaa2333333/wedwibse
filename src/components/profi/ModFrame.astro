---
// Рамка админки модерации: меню разделов слева (на телефоне — вкладки
// вбок) и рабочая область. Счётчики — из той же очереди, что на экране.
// В прототипе живые только разделы очереди; журнал, жалобы и подрядчики
// появятся вместе с базой — пунктов-пустышек в меню не ставим.
import { DEMO_REVISIONS, LANE, type Lane } from '../../data/moderation-demo';
import './mod.css';

interface Props {
  /** активный пункт: 'all' или полоса */
  active?: 'all' | Lane;
}
const { active } = Astro.props;

const count = (lane?: Lane) => DEMO_REVISIONS.filter((r) => !lane || r.lane === lane).length;
const items = [
  { key: 'all', href: '/profi/moderaciya/', label: 'Все правки', n: count() },
  ...(['red', 'yellow', 'green'] as Lane[]).map((lane) => ({
    key: lane,
    href: `/profi/moderaciya/#${lane}`,
    label: LANE[lane].queue,
    n: count(lane),
  })),
];
---

<div class="mf">
  <nav class="mnav" aria-label="Разделы модерации">
    <span class="mnav__label">Очередь</span>
    {items.map((it) => (
      <a class:list={['mnav__item', { 'is-active': active === it.key }]} href={it.href} data-lane-link={it.key}>
        <span>{it.label}</span>
        <span class="mnav__count">{it.n}</span>
      </a>
    ))}
    <span class="mnav__label">Каталог</span>
    <a class="mnav__item" href="/moskva/podryadchiki/" target="_blank" rel="noopener"><span>Карточки на сайте</span></a>
  </nav>
  <div class="mf__main">
    <slot />
  </div>
</div>
