---
// «Войти через MAX» — второй мессенджер входа рядом с Telegram (решение
// Никиты 20.10.2026, docs/cabinet/CABINET.md §23). Готового виджета входа для сайтов
// у MAX нет: кнопка ведёт в нашего бота ссылкой с одноразовым кодом,
// человек жмёт «Начать», сервер по вебхуку привязывает аккаунт и пускает
// в кабинет (lib/max-login.ts). Без PUBLIC_MAX_BOT в сборке — ссылка
// прототипа на кабинет. Знак — официальный логотип MAX
// (src/assets/profi/max-mark.webp), декоративный, как у Telegram.
import { Image } from 'astro:assets';
import maxMark from '../../assets/profi/max-mark.webp';

interface Props {
  href?: string;
  label?: string;
}

const { href = '/profi/moi/', label = 'Войти через' } = Astro.props;
---

<a class="pill pill--lg pill--solid pill--block mx" href={href} data-max-login>
  <Image class="mx__mark" src={maxMark} alt="" width={26} height={26} widths={[26, 52, 78]} sizes="26px" />
  <span>{label} <b class="mx__word">MAX</b></span>
</a>

<p class="mx__note" data-max-note hidden>Нажмите «Начать» в MAX — кабинет откроется здесь сам.</p>
<p class="mx__error" role="alert" data-max-error hidden></p>

<script>
  import { MAX_BOT, prepareMaxLink, waitMaxSignIn, pendingMax } from '../../lib/max-login';
  import { afterLogin } from '../../lib/tg-login';
  import { errText } from '../../lib/cabinet-api';

  if (MAX_BOT) {
    // одно ожидание на страницу, сколько бы кнопок MAX на ней ни стояло
    let waiting = '';
    const buttons = [...document.querySelectorAll<HTMLAnchorElement>('[data-max-login]')];
    const parts = (btn: HTMLAnchorElement) => ({
      note: btn.parentElement!.querySelector<HTMLElement>('[data-max-note]')!,
      error: btn.parentElement!.querySelector<HTMLElement>('[data-max-error]')!,
    });
    const fail = (btn: HTMLAnchorElement, m: string) => {
      const { note, error } = parts(btn);
      note.hidden = true; error.textContent = m; error.hidden = false;
    };
    const wait = async (btn: HTMLAnchorElement, code: string, p: { invite?: string; next?: string }, at?: number) => {
      if (waiting === code) return;
      waiting = code;
      const { note, error } = parts(btn);
      error.hidden = true;
      note.hidden = false;
      try {
        if ((await waitMaxSignIn(code, p, at)) === 'needs-accept') location.href = '/profi/usloviya/';
        else afterLogin(p.next);
      } catch (err) {
        fail(btn, errText(err));
      } finally {
        waiting = '';
      }
    };
    buttons.forEach((btn) => {
      const current = prepareMaxLink(btn, (m) => fail(btn, m));
      btn.addEventListener('click', (ev) => {
        const c = current();
        // кнопка за галочками согласия (регистрация) не живёт, пока они не стоят;
        // код ещё не пришёл — ссылка пока ведёт на заглушку, не пускаем
        if (btn.closest('[aria-disabled="true"]') || !c) { ev.preventDefault(); return; }
        // переход по ссылке (новая вкладка / приложение MAX) — браузер делает сам
        const q = new URLSearchParams(location.search);
        wait(btn, c.code, { invite: q.get('invite') || undefined, next: q.get('next') || undefined });
      });
    });
    // ушли в MAX, а вкладка перезагрузилась или вернулась «назад» — ждём дальше
    const resume = () => {
      const w = pendingMax();
      if (w && buttons[0]) wait(buttons[0], w.code, { invite: w.invite, next: w.next }, w.at);
    };
    resume();
    window.addEventListener('pageshow', (e) => { if (e.persisted) resume(); });
  }
</script>

<style>
  .mx { align-items: center; gap: var(--s-3); background: var(--brand-max); color: var(--brand-fg); border-color: transparent; }
  @media (hover: hover) { .mx:hover { background: var(--brand-max); color: var(--brand-fg); border-color: transparent; } }
  .mx__mark { width: 26px; height: 26px; flex: none; }
  .mx__word { font-weight: var(--w-head-lg); letter-spacing: 0.02em; }
  .mx__note { font-size: var(--fs-small); line-height: var(--lh-snug); }
  .mx__note a { text-decoration: underline; }
  .mx__error { color: var(--error-text); font-size: var(--fs-small); line-height: var(--lh-snug); }
</style>
