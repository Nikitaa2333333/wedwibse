---
// «Войти через MAX» — второй мессенджер входа рядом с Telegram (решение
// Никиты 20.10.2026, CABINET.md §23). Готового виджета входа для сайтов
// у MAX нет: кнопка ведёт в нашего бота ссылкой с одноразовым кодом,
// человек жмёт «Начать», сервер по вебхуку привязывает аккаунт и пускает
// в кабинет (lib/max-login.ts). Без PUBLIC_MAX_BOT в сборке — ссылка
// прототипа на кабинет. Знак — официальный логотип MAX
// (src/assets/profi/max-mark.webp), декоративный, как у Telegram.
import { Image } from 'astro:assets';
import maxMark from '../../assets/profi/max-mark.webp';

interface Props {
  href?: string;
  label?: string;
}

const { href = '/profi/kabinet/', label = 'Войти через' } = Astro.props;
---

<a class="pill pill--lg pill--solid pill--block mx" href={href} data-max-login>
  <Image class="mx__mark" src={maxMark} alt="" width={26} height={26} widths={[26, 52, 78]} sizes="26px" />
  <span>{label} <b class="mx__word">MAX</b></span>
</a>

<p class="mx__note" data-max-note hidden>Нажмите «Начать» в MAX — кабинет откроется здесь сам.</p>
<p class="mx__error" role="alert" data-max-error hidden></p>

<script>
  import { MAX_BOT, prepareMaxLink, waitMaxSignIn } from '../../lib/max-login';
  import { afterLogin } from '../../lib/tg-login';

  if (MAX_BOT) {
    document.querySelectorAll<HTMLAnchorElement>('[data-max-login]').forEach((btn) => {
      const note = btn.parentElement!.querySelector<HTMLElement>('[data-max-note]')!;
      const error = btn.parentElement!.querySelector<HTMLElement>('[data-max-error]')!;
      const fail = (m: string) => { note.hidden = true; error.textContent = m; error.hidden = false; };
      const current = prepareMaxLink(btn, fail);
      let waiting = '';
      btn.addEventListener('click', async (ev) => {
        const c = current();
        // кнопка за галочками согласия (регистрация) не живёт, пока они не стоят;
        // код ещё не пришёл — ссылка пока ведёт на заглушку, не пускаем
        if (btn.closest('[aria-disabled="true"]') || !c) { ev.preventDefault(); return; }
        // переход по ссылке (новая вкладка / приложение MAX) — браузер делает сам
        if (waiting === c.code) return;
        waiting = c.code;
        error.hidden = true;
        note.hidden = false;
        try {
          const q = new URLSearchParams(location.search);
          const p = { invite: q.get('invite') || undefined, next: q.get('next') || undefined };
          if ((await waitMaxSignIn(c.code, p)) === 'needs-accept') location.href = '/profi/usloviya/';
          else afterLogin(p.next);
        } catch (err) {
          fail((err as Error).message);
        } finally {
          waiting = '';
        }
      });
    });
  }
</script>

<style>
  .mx { align-items: center; gap: var(--s-3); background: var(--brand-max); color: var(--brand-fg); border-color: transparent; }
  @media (hover: hover) { .mx:hover { background: var(--brand-max); color: var(--brand-fg); border-color: transparent; } }
  .mx__mark { width: 26px; height: 26px; flex: none; }
  .mx__word { font-weight: var(--w-head-lg); letter-spacing: 0.02em; }
  .mx__note { font-size: var(--fs-small); line-height: var(--lh-snug); }
  .mx__note a { text-decoration: underline; }
  .mx__error { color: var(--st-bad-text); font-size: var(--fs-small); line-height: var(--lh-snug); }
</style>
