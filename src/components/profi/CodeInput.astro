---
// КОД ИЗ ПИСЬМА — шесть клеток, как в MAX и Telegram (Никита 06.11).
// Под клетками одно настоящее поле: работает автоподстановка кода из почты
// (autocomplete="one-time-code"), вставка целиком и проверка формы. Клетки —
// только вид; активная (куда пойдёт следующая цифра) подсвечена контуром.
interface Props { name?: string; label?: string }
const { name = 'code', label = 'Код из письма' } = Astro.props;
---

<div class="otp" data-otp>
  <input class="otp__input" name={name} inputmode="numeric" autocomplete="one-time-code" maxlength="6" pattern="\d{6}" required aria-label={label} />
  <div class="otp__cells" aria-hidden="true">
    {Array.from({ length: 6 }, () => <span class="otp__cell"></span>)}
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-otp]').forEach((box) => {
    const input = box.querySelector<HTMLInputElement>('input')!;
    const cells = [...box.querySelectorAll<HTMLElement>('.otp__cell')];
    const paint = () => {
      const v = input.value;
      const focused = document.activeElement === input;
      cells.forEach((c, i) => {
        c.textContent = v[i] ?? '';
        c.classList.toggle('is-active', focused && i === Math.min(v.length, 5));
      });
    };
    input.addEventListener('input', () => {
      const digits = input.value.replace(/\D/g, '').slice(0, 6);
      if (digits !== input.value) input.value = digits;
      paint();
    });
    input.addEventListener('focus', paint);
    input.addEventListener('blur', paint);
    paint();
  });
</script>
