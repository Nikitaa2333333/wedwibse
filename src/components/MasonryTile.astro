---
// ПЛИТКА ДОСКИ-МАСОНРИ — одна ячейка потока (PhotoMasonry). Вынесена из
// доски в свой компонент, потому что доска рисует плитки в двух местах:
// в колонках и в скрытом «хвосте» галереи (первые N кадров видны, остальные
// досыпаются по кнопке) — одна разметка, а не две копии.
//
// Кадр-плитка — PhotoRail (точки, свайп), статья — типографическая плашка.
// Сердца на плитке нет: на фотографии не лежит ничего. Нажатие на кадр —
// обычный переход на карточку по href (с якорем на этот же кадр): оверлея
// поверх доски больше нет, полноэкранный кадр со стеклом — первый экран
// самой карточки, и с него человек уходит вниз, к описанию и брони.
import PhotoRail from './PhotoRail.astro';
import type { Tile } from '../lib/gallery';

interface Props {
  tile: Tile;
  sizes: string;
  widths: number[];
  /** плитка в скрытом хвосте галереи: есть в HTML, не показана и не грузится */
  hidden?: boolean;
}

const { tile, sizes, widths, hidden = false } = Astro.props;
---

<article
  class:list={['pin', tile.kind === 'article' && 'pin--article']}
  style={`--card-ratio:${tile.ratio};`}
  data-i={tile.index}
  data-h={tile.height.toFixed(3)}
  hidden={hidden}
>
  {tile.kind === 'article' ? (
    <a class="note theme-dark" href={tile.href}>
      <span class="note__rubric t-caption">{tile.rubric}</span>
      <h3 class="note__title">{tile.title}</h3>
      <span class="pill pill--sm note__cta">Читать</span>
    </a>
  ) : (
    <PhotoRail photos={tile.photos} alt={tile.alt} href={tile.href ?? undefined} sizes={sizes} widths={widths} />
  )}
</article>

<style>
  /* СТАТЬЯ В ПОТОКЕ — плашка-инверсия той же пропорции, что кадр рядом.
     Рубрика сверху, заголовок в середине, пилюля «Читать» внизу — три
     уровня одной плитки, как у текстового пина. Цвета из .theme-dark:
     пилюля внутри сама становится белой, руками ничего не красим. */
  .note {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--s-4);
    aspect-ratio: var(--card-ratio);
    padding: var(--s-4);
    background: var(--bg);
    color: var(--fg);
    /* Плитка статьи — не кадр, а залитая плашка, поэтому радиус ей нужен
       отдельной строкой: у фото-плиток его держит .prail. Форма общая
       с остальными карточками — --radius-card. */
    border-radius: var(--radius-card);
    text-decoration: none;
  }

  .note__rubric { font-weight: var(--w-medium); }

  /* Кегль от ширины колонки, не экрана: колонка на телефоне ~190px
     (→ 19px, пять строк), на ПК ~300px (→ 27px) — заголовок держит плашку,
     а не тонет в ней. Без переносов внутри слова. */
  .note__title {
    font-size: clamp(19px, 9cqi, 30px);
    font-weight: var(--w-head);
    line-height: var(--lh-heading);
    letter-spacing: var(--ls-display);
    hyphens: manual;
  }

  .note__cta { align-self: flex-start; }

  .pin--article { container-type: inline-size; }

  /* Скрытый хвост галереи: плитка есть в HTML (SEO), но не занимает места
     и не грузит кадр — lazy-картинка без бокса не пересекает вьюпорт. */
  .pin[hidden] { display: none; }

  @media (min-width: 1024px) {
    .note { padding: var(--s-5); }
  }
</style>
