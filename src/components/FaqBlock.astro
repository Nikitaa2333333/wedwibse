---
// Вопросы и ответы — статикой в HTML, без JS-аккордеонов:
// это главный SEO-корм посадочной страницы.
import type { Venue } from '../data/venues';

interface Props {
  kicker: string;
  title: string;
  items: Venue['faq'];
}

const { kicker, title, items } = Astro.props;
---

<section class="faq section" id="voprosy">
  <div class="container container--wide">
    <header class="faq__head">
      <p class="faq__kicker t-caption">{kicker}</p>
      <h2 class="faq__title">{title}</h2>
    </header>

    <div class="faq__grid">
      {
        items.map((item) => (
          <article class="qa">
            <h3 class="qa__q">{item.q}</h3>
            {item.a.map((p) => (
              <p class="qa__a">{p}</p>
            ))}
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Блок идёт по полям страницы, как сцены: потолка ширины нет.
     Строку при этом держит сам ответ — иначе на широком мониторе
     абзац растянулся бы за сотню знаков. */
  .faq :global(.container) { max-width: none; }

  .faq__head { margin-bottom: var(--section-gap-tight); }

  .faq__kicker {
    font-weight: var(--w-medium);
    margin-bottom: var(--s-3);
  }

  .faq__title {
    font-size: var(--fs-h1);
    font-weight: var(--w-head-lg);
    line-height: var(--lh-display);
    letter-spacing: var(--ls-display);
    max-width: var(--measure-head);
  }

  /* Между вопросами --s-6, вопрос к своему ответу --s-2: пара «вопрос —
     ответ» читается группой, а не тонет в пустоте (заказчик, 08.10.2026). */
  .faq__grid {
    display: grid;
    gap: var(--s-6) var(--s-8);
  }

  /* Антиква образа «крем» читается только крупно: вопрос — кеглем
     сцены, а не мелким h3. */
  .qa__q {
    font-size: clamp(24px, 2.8vw, 32px);
    font-weight: var(--w-head-lg);
    line-height: var(--lh-heading);
    margin-bottom: var(--s-2);
  }

  .qa__a { max-width: var(--measure-text); }

  .qa__a + .qa__a { margin-top: var(--s-4); }

  @media (min-width: 900px) {
    .faq__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
