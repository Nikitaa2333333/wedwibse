---
import { rowsClass } from '../lib/rows';
// СЦЕНЫ — главный модуль карточки подрядчика.
// ПК: справа кадр во весь экран, он «висит» неподвижно, пока слева
// листается текст сцены; на границе сцен кадр сменяется следующим.
// Мобилка: та же последовательность обычным потоком — кадр, затем текст.
// Сделано без JS: sticky + грид-строки. Одно изображение на сцену,
// дублей в разметке нет — мобильный трафик не удваивается.
import { Image } from 'astro:assets';
import type { VenueScene } from '../data/venues';
import { resolveImage, IMG_WIDTHS } from '../lib/images';

interface Props {
  title: string;
  scenes: VenueScene[];
}

const { title, scenes } = Astro.props;
---

<section class="scenes section" id="o-ploshchadke">
  <div class="container container--wide">
    <header class="scenes__head">
      <h2 class="scenes__title">{title}</h2>
    </header>

    <div class="scenes__list">
      {
        scenes.map((scene, i) => (
          <article class={`scene scene--${scene.layout ?? 'split'}`} style={`--row:${i + 1}`}>
            {/* Слайдер у сцены-галереи снят: один кадр тем же элементом .shot,
                что у подрядчика (заказчик, 08.10.2026). */}
            {(
              <figure class="scene__shot shot">
                {/* Все кадры ленивые, первый тоже: сцены стоят ниже первого
                    экрана, а eager у первой (2560 px, sizes 100vw) качал её
                    вместе с дежурным кадром карточки и делил с ним канал. */}
                <Image
                  src={resolveImage(scene.images?.[0] ?? scene.image)}
                  alt={scene.alt}
                  widths={IMG_WIDTHS.stage}
                  sizes={scene.layout === 'wide' ? '100vw' : '(min-width: 1024px) 55vw, 100vw'}
                  loading="lazy"
                  decoding="async"
                />
              </figure>
            )}

            <div class="scene__text">
              <h3 class="scene__name">{scene.title}</h3>

              {scene.body.map((p) => (
                <p class="scene__p">{p}</p>
              ))}

              {scene.facts && (
                <dl class={`${rowsClass(scene.facts)} scene__facts`}>
                  {scene.facts.map((fact) => (
                    <div class="rows__row">
                      <dt class="rows__label">{fact.label}</dt>
                      <dd class="rows__value">{fact.value}</dd>
                    </div>
                  ))}
                </dl>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Сцены — полноширинный модуль: потолка ширины нет, поля даёт
     только сам контейнер, и кадр их гасит, уходя в край экрана. */
  .scenes :global(.container) { max-width: none; }

  .scenes__head { margin-bottom: var(--section-gap-tight); }


  .scenes__title {
    font-size: var(--fs-h1);
    font-weight: var(--w-head-lg);
    line-height: var(--lh-display);
    letter-spacing: var(--ls-display);
    max-width: var(--measure-head);
  }

  /* ============ МОБИЛКА: кадр, потом текст ============ */
  .scene + .scene { margin-top: var(--section-gap); }

  /* кадр в полях страницы, со скруглением (.shot) — как у подрядчика */
  .scene__shot { margin-bottom: var(--s-5); }

  /* Номера сцен 01, 02, 03 сняты (заказчик, 08.10.2026): «выглядит
     отвратительно» — порядок и так виден по прокрутке. */

  .scene__name {
    font-size: clamp(28px, 3.6vw, 40px); /* антиква мелким кеглем нечитаема — крупнее (08.10) */
    font-weight: var(--w-head-lg);
    line-height: var(--lh-heading);
    letter-spacing: var(--ls-display);
    margin-bottom: var(--s-5);
  }

  /* колонка тянется вместе с экраном — меру строки держит сам абзац */
  .scene__p { max-width: var(--measure-text); }

  .scene__p + .scene__p { margin-top: var(--s-4); }

  .scene__facts { margin-top: var(--s-6); }

  /* ============ ПК: закреплённый кадр справа ============ */
  @media (min-width: 1024px) {
    .scenes__list {
      display: grid;
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      column-gap: var(--s-8);
    }

    /* сцена растворяется, её половины становятся ячейками общей сетки */
    .scene { display: contents; }

    /* Текст выровнен по верху своей строки, а не по центру: строка высотой
       --scene-span (170svh), и при центрировании текст оказывался почти на
       экран ниже кадра — сначала листалась фотография и пустая колонка,
       и только потом приходил текст. По верху они входят в экран вместе. */
    .scene__text {
      grid-column: 1;
      grid-row: var(--row);
      min-height: var(--scene-span);
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      padding-block: var(--s-7) var(--s-8);
    }

    .scene__shot {
      grid-column: 2;
      grid-row: var(--row);
      position: sticky;
      top: 0;
      align-self: start;
      height: 100svh;
      aspect-ratio: auto;
      margin-block: 0;
      margin-left: 0;
      /* правым краем кадр выходит в край экрана */
      margin-right: calc(var(--gutter) * -1);
      border-radius: 0; /* на ПК кадр липкой колонкой в край экрана */
    }

    /* ============ СЦЕНА ВО ВСЮ ШИРИНУ ============
       Разрыв в ритме: кадр (или лента кадров) занимает всю ширину, текст
       идёт под ним. Такая сцена не растворяется в общей сетке, а остаётся
       обычным блоком на всю строку — поэтому grid-column/row её детей
       не действуют и сбрасывать их не нужно. */
    /* Липкие кадры соседних сцен не отпускаются на границе строки: они
       позиционированные и висят поверх обычных блоков, как бы ни шёл
       порядок в разметке. Поэтому широкая сцена: а) поднимается своим
       слоем, б) занимает всю ширину экрана вместе с подложкой — иначе
       кадр выглядывает полосой в боковых полях. */
    .scene--wide,
    .scene--gallery {
      display: block;
      grid-column: 1 / -1;
      grid-row: var(--row);
      position: relative;
      z-index: 1;
      background: var(--bg);
      margin-inline: calc(var(--gutter) * -1);
      padding: var(--s-8) var(--gutter);
    }

    .scene--wide .scene__shot {
      position: static;
      height: auto;
      aspect-ratio: 21 / 9;
      margin-inline: calc(var(--gutter) * -1);
      margin-bottom: var(--s-7);
    }


    /* текст такой сцены — обычная колонка под кадром, меру держат абзацы */
    .scene--wide .scene__text,
    .scene--gallery .scene__text {
      display: block;
      min-height: 0;
      padding-block: 0;
    }
  }
</style>
