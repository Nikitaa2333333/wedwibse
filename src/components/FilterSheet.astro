---
// ШТОРКА ФИЛЬТРОВ (реф. Яндекс Путешествия): поднимается снизу экрана,
// одна на все каталоги. Внутри: поиск (если задан), затем каждая группа —
// сворачиваемый раздел со строками-отметками (один вид на телефоне и ПК,
// 12.11.2026; блок «Популярные» снят). Внизу липкая панель:
// строка «Нашли N …» и две кнопки — «Сбросить» и «Применить».
// Оболочка шторки — реестр .sheet в global.css, открытие — lib/sheet.ts.
//
// Фильтры применяются к карточкам сразу при клике (как раньше в колонке):
// «Применить» только закрывает шторку, а строка «Нашли N» живёт как
// предпросмотр результата. Все карточки уже в разметке — скрипт только
// прячет/показывает по совпадению. Внутри группы — ИЛИ, между группами — И.
//
// Состояние одно — настоящие чекбоксы в группах ([data-filter-key]).
// «Популярные» в шторке и чипы полосы FilterBar — прокси-кнопки
// [data-chip-proxy] с data-chip-key/-value (два атрибута, а не одна строка:
// в значениях бывают пробелы — «Банкетный зал»), они переключают эти
// чекбоксы и подсвечиваются от них.
// Одиночный выбор (type: 'single') тоже чекбоксы — так пункт можно снять
// повторным нажатием; «один в группе» держит скрипт по data-filter-single.
//
// ПК (от 1024px): та же разметка пристыковывается слева постоянной колонкой
// (.sheet--dock в global.css), чипы становятся строками с квадратной
// отметкой и счётчиком (реф. Яндекс Путешествия, ПК-версия), первой группой
// встаёт «Сортировка» — на ПК никаких всплывающих настроек, всё слева.
import type { FilterGroup } from '../data/specialists';
import type { FilterCounts } from '../lib/filter-counts';
import { SORTS } from '../lib/sort';
import Icon from './Icon.astro';

interface Props {
  groups: FilterGroup[];
  counts?: FilterCounts;
  /** формы слова для «Нашли 12 площадок»: [одна, две, пять] */
  noun?: [string, string, string];
  /** есть ли что сортировать — группа «Сортировка» в колонке на ПК */
  sortable?: boolean;
  /** поиск по названию первым полем шторки (как у wedwed, 12.11.2026):
      строка — подсказка в поле; карточки сравниваются по data-name */
  search?: string;
}

const { groups, counts = {}, noun = ['предложение', 'предложения', 'предложений'], sortable = false, search } = Astro.props;

---

<div class="sheet sheet--dock" data-sheet="filters" data-noun={JSON.stringify(noun)}>
  <div class="sheet__backdrop" data-sheet-close></div>

  <section class="sheet__panel" role="dialog" aria-modal="true" aria-labelledby="filters-title">
    <header class="sheet__head">
      <h2 class="sheet__title" id="filters-title">Фильтры</h2>
      <button class="sheet__reset" type="button" data-filters-reset>Сбросить</button>
      <button class="icon-btn" type="button" data-sheet-close aria-label="Закрыть фильтры">
        <Icon name="close" />
      </button>
    </header>

    <div class="sheet__body fsheet__body" data-sheet-body data-lenis-prevent>
      {search && (
        <section class="fsheet__group fsheet__group--search">
          <input class="input fsheet__search" type="search" placeholder={search} aria-label={search} autocomplete="off" enterkeyhint="search" data-filter-search />
        </section>
      )}

      {sortable && (
        <section class="fsheet__group fsheet__group--sort">
          <h3 class="fsheet__label">Сортировка</h3>
          <div class="radio-list">
            {SORTS.map((s, i) => (
              <label class="radio-row">
                <input class="radio-row__input" type="radio" name="sort-dock" value={s.value} checked={i === 0} data-sort-by />
                <span class="radio-row__mark" aria-hidden="true"></span>
                <span class="radio-row__label">{s.label}</span>
              </label>
            ))}
          </div>
        </section>
      )}

      {groups.map((group) => (
        <details class="fsheet__group fsheet__fold" data-sheet-group={group.key} hidden={group.hidden}>
          <summary class="fsheet__sum">
            <span class="fsheet__sum-text">
              <span class="fsheet__label">{group.label}</span>
              <span class="fsheet__picked" data-picked hidden></span>
            </span>
            <Icon name="caretDown" class="fsheet__caret" />
          </summary>
          <div class="fsheet__chips">
            {group.options.map((opt) => (
              <label class="chip-opt">
                <input
                  class="chip-opt__input"
                  type="checkbox"
                  name={group.key}
                  value={opt.value}
                  data-filter-key={group.key}
                  data-filter-single={group.type === 'single' ? '' : undefined}
                />
                <span class="chip">{opt.label}{counts[group.key]?.[opt.value] !== undefined && <span class="chip__count">{counts[group.key][opt.value]}</span>}</span>
              </label>
            ))}
          </div>
        </details>
      ))}
    </div>

    <footer class="sheet__foot">
      <p class="fsheet__found t-small" data-sheet-found></p>
      <div class="fsheet__actions">
        <button class="pill fsheet__btn" type="button" data-filters-reset>Сбросить</button>
        <button class="pill is-active fsheet__btn" type="button" data-sheet-close>Применить</button>
      </div>
    </footer>
  </section>
</div>

<style>
  /* ОДИН ВИД НА ТЕЛЕФОНЕ И ПК (Никита 12.11.2026, по образцу wedwed):
     группа — сворачиваемый раздел (details), под названием группы — что в
     ней выбрано; пункт — строка с кружком-отметкой и счётчиком. Раньше на
     телефоне были капсулы и блок «Популярные», а на ПК — строки: два разных
     вида одного и того же фильтра. */
  .fsheet__body {
    display: grid;
    gap: var(--s-4);
  }

  .fsheet__fold[hidden] { display: none; }

  .fsheet__sum {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    min-height: 44px;
    list-style: none;
    cursor: pointer;
  }

  .fsheet__sum::-webkit-details-marker { display: none; }

  .fsheet__sum-text { display: grid; gap: var(--s-1); min-width: 0; }

  /* Заголовок группы — кеглем корпуса, весом заголовка */
  .fsheet__label {
    font-size: var(--fs-body);
    font-weight: var(--w-head);
    line-height: var(--lh-caption);
  }

  /* выбранное в группе — строкой под названием, видно и в свёрнутой */
  .fsheet__picked {
    font-size: var(--fs-small);
    line-height: var(--lh-snug);
    overflow-wrap: anywhere;
  }

  .fsheet__caret {
    flex: none;
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .fsheet__fold[open] .fsheet__caret { transform: rotate(180deg); }

  .fsheet__chips {
    display: grid;
    padding-block: var(--s-2) var(--s-3);
  }

  /* Пункт — строка с кружком слева, а не капсула: снимаем у .chip заливку,
     обводку (--chip-line в тёмной теме) и скругление. Строка — блок с
     отступом под кружок: при переносе счётчик стоит за последним словом.
     Высота строки — зона нажатия 44 px. */
  .fsheet__chips .chip {
    position: relative;
    display: block;
    min-height: 44px;
    padding: var(--s-2) 0 var(--s-2) calc(20px + var(--s-3));
    background: none;
    border: 0;
    border-radius: 0;
    white-space: normal;
    text-align: left;
    font-size: var(--fs-body);
    font-weight: var(--w-body);
    line-height: var(--lh-body);
    color: var(--fg);
  }

  .fsheet__chips .chip::before {
    content: '';
    position: absolute;
    left: 0;
    top: calc(var(--s-2) + (1em * var(--lh-body) - 20px) / 2);
    width: 20px;
    height: 20px;
    border: 1px solid var(--fg);
    border-radius: 50%;
    transition: background var(--dur-fast) var(--ease-out);
  }

  /* белая точка внутри включённого кружка */
  .fsheet__chips .chip::after {
    content: '';
    position: absolute;
    left: 7px;
    top: calc(var(--s-2) + (1em * var(--lh-body) - 20px) / 2 + 7px);
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--bg);
    opacity: 0;
  }

  .fsheet__chips .chip__count {
    margin-left: var(--s-2);
    font-size: var(--fs-small);
  }

  .fsheet__chips .chip-opt__input:checked + .chip { background: none; color: var(--fg); }
  .fsheet__chips .chip-opt__input:checked + .chip::before { background: var(--fg); }
  .fsheet__chips .chip-opt__input:checked + .chip::after { opacity: 1; }
  .fsheet__chips .chip-opt__input:focus-visible + .chip { outline: none; }
  .fsheet__chips .chip-opt__input:focus-visible + .chip::before { outline: 2px solid var(--fg); outline-offset: 3px; }

  @media (hover: hover) {
    .fsheet__chips .chip:hover,
    .fsheet__chips .chip-opt__input:not(:checked) + .chip:hover { background: none; }
  }

  .fsheet__found {
    text-align: center;
    min-height: 1.55em;
  }

  .fsheet__actions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-3);
  }

  .fsheet__btn {
    width: 100%;
    text-align: center;
    padding-inline: var(--s-4);
  }

  /* Тач: нажатие на пилюлю — мгновенный отклик, но чернильная «Применить»
     от нажатия не должна «гаснуть» */
  .fsheet__btn.is-active:active { background: var(--fg); color: var(--bg); }

  /* поиск по названию — первым полем, во всю ширину (min-width: 0 — поле в grid) */
  .fsheet__group--search { min-width: 0; }
  .fsheet__search { width: 100%; }

  /* Сортировка на телефоне живёт своей шторкой (FilterBar) */
  .fsheet__group--sort { display: none; }

  /* ПК (от 1024px): та же шторка постоянной колонкой слева (.sheet--dock),
     кегль строк мельче — колонка узкая; первой встаёт «Сортировка». */
  @media (min-width: 1024px) {
    .fsheet__group--sort { display: block; }
    .fsheet__group--sort .fsheet__label { display: block; margin-bottom: var(--s-3); }
    .fsheet__label { font-size: var(--fs-small); font-weight: var(--w-medium); }
    .fsheet__chips .chip { font-size: var(--fs-small); min-height: 0; padding-block: var(--s-1); }
    .fsheet__chips .chip::before { top: calc(var(--s-1) + (1em * var(--lh-body) - 20px) / 2); }
    .fsheet__chips .chip::after { top: calc(var(--s-1) + (1em * var(--lh-body) - 20px) / 2 + 7px); }
    .fsheet__chips .chip__count { font-size: var(--fs-caption); }
  }
</style>

<script>
  import { bindSheet } from '../lib/sheet';
  // Склонение при числе — общее правило проекта (та же строка «N площадок»
  // считается на сборке в EntryRail), поэтому лежит в lib, а не здесь.
  import { plural } from '../lib/plural';

  const sheet = document.querySelector<HTMLElement>('[data-sheet="filters"]');

  if (sheet) {
    const body = sheet.querySelector<HTMLElement>('[data-sheet-body]')!;
    const foundEl = sheet.querySelector<HTMLElement>('[data-sheet-found]')!;
    const noun = JSON.parse(sheet.dataset.noun || '[]') as [string, string, string];

    const inputs = Array.from(document.querySelectorAll<HTMLInputElement>('[data-filter-key]'));
    const proxies = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-chip-proxy]'));
    const quickChips = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-quick-group]'));
    const badge = document.querySelector<HTMLElement>('[data-filters-badge]');
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-card]'));
    const emptyEl = document.querySelector<HTMLElement>('[data-results-empty]');
    const searchEl = sheet.querySelector<HTMLInputElement>('[data-filter-search]');

    // Быстрый чип («Цена ▾») открывает шторку, прокрученную к своей группе
    bindSheet(sheet, {
      onOpen(opener) {
        const key = opener?.dataset.sheetGroup;
        const target = key ? body.querySelector<HTMLElement>(`[data-sheet-group="${key}"]`) : null;
        if (target instanceof HTMLDetailsElement) target.open = true;
        body.scrollTo({ top: target ? target.offsetTop - body.offsetTop : 0 });
      },
    });

    // ============ ФИЛЬТРАЦИЯ ============
    function selections(): Record<string, string[]> {
      const map: Record<string, string[]> = {};
      inputs.forEach((input) => {
        if (!input.checked) return;
        (map[input.dataset.filterKey!] ??= []).push(input.value);
      });
      return map;
    }

    // ПК: колонка слева — все группы раскрыты, сворачивать там незачем
    const folds = Array.from(sheet.querySelectorAll<HTMLDetailsElement>('details[data-sheet-group]'));
    const wide = window.matchMedia('(min-width: 1024px)');
    const openWide = () => { if (wide.matches) folds.forEach((d) => { d.open = true; }); };
    openWide();
    wide.addEventListener('change', openWide);

    function syncChips(sel: Record<string, string[]>) {
      // под названием группы — выбранное через запятую (видно и в свёрнутой)
      folds.forEach((d) => {
        const picked = d.querySelector<HTMLElement>('[data-picked]');
        if (!picked) return;
        const labels = Array.from(d.querySelectorAll<HTMLInputElement>('[data-filter-key]:checked'))
          .map((i) => i.nextElementSibling?.firstChild?.textContent?.trim() ?? '');
        picked.textContent = labels.join(', ');
        picked.hidden = labels.length === 0;
      });
      proxies.forEach((p) => {
        const { chipKey: key, chipValue: value } = p.dataset;
        p.setAttribute('aria-pressed', String(sel[key!]?.includes(value!) ?? false));
      });
      quickChips.forEach((c) => c.classList.toggle('is-active', Boolean(sel[c.dataset.quickGroup!])));
      if (badge) {
        const n = Object.values(sel).reduce((sum, v) => sum + v.length, 0) + (searchEl?.value.trim() ? 1 : 0);
        badge.textContent = String(n);
        badge.hidden = n === 0;
      }
    }

    function applyFilters() {
      const sel = selections();
      const activeKeys = Object.keys(sel);
      const q = (searchEl?.value ?? '').trim().toLowerCase();
      let visible = 0;

      cards.forEach((card) => {
        const data = JSON.parse(card.dataset.filters || '{}') as Record<string, string | string[]>;
        const match = activeKeys.every((key) => {
          const wanted = sel[key];
          const value = data[key];
          if (Array.isArray(value)) return value.some((v) => wanted.includes(v));
          return wanted.includes(value);
        }) && (!q || (card.dataset.name ?? '').includes(q));
        card.classList.toggle('is-hidden', !match);
        if (match) visible += 1;
      });

      if (emptyEl) emptyEl.hidden = visible !== 0;
      if (cards.length) foundEl.textContent = visible ? `Нашли ${visible} ${plural(visible, noun)}` : 'Ничего не нашли';
      syncChips(sel);
    }

    searchEl?.addEventListener('input', () => applyFilters());

    inputs.forEach((input) =>
      input.addEventListener('change', () => {
        // Группа «один вариант»: включили пункт — соседи гаснут
        if (input.checked && input.dataset.filterSingle !== undefined) {
          inputs.forEach((i) => {
            if (i !== input && i.name === input.name) i.checked = false;
          });
        }
        applyFilters();
      })
    );

    // Прокси-чипы (популярные в шторке и в полосе) переключают настоящий чекбокс
    proxies.forEach((p) =>
      p.addEventListener('click', () => {
        const { chipKey: key, chipValue: value } = p.dataset;
        const input = inputs.find((i) => i.dataset.filterKey === key && i.value === value);
        if (!input) return;
        input.checked = !input.checked;
        input.dispatchEvent(new Event('change', { bubbles: true }));
      })
    );

    // «Сбросить» два: в шапке (колонка на ПК) и в футере (шторка на телефоне)
    sheet.querySelectorAll<HTMLButtonElement>('[data-filters-reset]').forEach((btn) =>
      btn.addEventListener('click', () => {
        inputs.forEach((input) => { input.checked = false; });
        if (searchEl) searchEl.value = '';
        applyFilters();
        // локацию шапки (ScopePicker) сбрасываем вместе с фильтрами: иначе она
        // запомнена в браузере и возвращалась при следующем заходе (Никита 08.11)
        document.dispatchEvent(new CustomEvent('filters:reset'));
      })
    );

    applyFilters();
  }
</script>
