---
// ШТОРКА ФИЛЬТРОВ (реф. Яндекс Путешествия): поднимается снизу экрана,
// одна на все каталоги. Внутри: «Популярные фильтры» (сборная из пунктов
// с popular), затем каждая группа своим блоком чипов. Внизу липкая панель:
// строка «Нашли N …» и две кнопки — «Сбросить» и «Применить».
// Оболочка шторки — реестр .sheet в global.css, открытие — lib/sheet.ts.
//
// Фильтры применяются к карточкам сразу при клике (как раньше в колонке):
// «Применить» только закрывает шторку, а строка «Нашли N» живёт как
// предпросмотр результата. Все карточки уже в разметке — скрипт только
// прячет/показывает по совпадению. Внутри группы — ИЛИ, между группами — И.
//
// Состояние одно — настоящие чекбоксы в группах ([data-filter-key]).
// «Популярные» в шторке и чипы полосы FilterBar — прокси-кнопки
// [data-chip-proxy] с data-chip-key/-value (два атрибута, а не одна строка:
// в значениях бывают пробелы — «Банкетный зал»), они переключают эти
// чекбоксы и подсвечиваются от них.
// Одиночный выбор (type: 'single') тоже чекбоксы — так пункт можно снять
// повторным нажатием; «один в группе» держит скрипт по data-filter-single.
//
// ПК (от 1024px): та же разметка пристыковывается слева постоянной колонкой
// (.sheet--dock в global.css), чипы становятся строками с квадратной
// отметкой и счётчиком (реф. Яндекс Путешествия, ПК-версия), первой группой
// встаёт «Сортировка» — на ПК никаких всплывающих настроек, всё слева.
import type { FilterGroup } from '../data/specialists';
import type { FilterCounts } from '../lib/filter-counts';
import { SORTS } from '../lib/sort';
import Icon from './Icon.astro';

interface Props {
  groups: FilterGroup[];
  counts?: FilterCounts;
  /** формы слова для «Нашли 12 площадок»: [одна, две, пять] */
  noun?: [string, string, string];
  /** есть ли что сортировать — группа «Сортировка» в колонке на ПК */
  sortable?: boolean;
}

const { groups, counts = {}, noun = ['предложение', 'предложения', 'предложений'], sortable = false } = Astro.props;

const popular = groups.flatMap((g) =>
  g.options
    .filter((o) => o.popular)
    .map((o) => ({
      key: g.key,
      value: o.value,
      label: typeof o.popular === 'string' ? o.popular : o.label,
      count: counts[g.key]?.[o.value],
    }))
);
---

<div class="sheet sheet--dock" data-sheet="filters" data-noun={JSON.stringify(noun)}>
  <div class="sheet__backdrop" data-sheet-close></div>

  <section class="sheet__panel" role="dialog" aria-modal="true" aria-labelledby="filters-title">
    <header class="sheet__head">
      <h2 class="sheet__title" id="filters-title">Фильтры</h2>
      <button class="sheet__reset" type="button" data-filters-reset>Сбросить</button>
      <button class="icon-btn" type="button" data-sheet-close aria-label="Закрыть фильтры">
        <Icon name="close" />
      </button>
    </header>

    <div class="sheet__body fsheet__body" data-sheet-body data-lenis-prevent>
      {sortable && (
        <section class="fsheet__group fsheet__group--sort">
          <h3 class="fsheet__label">Сортировка</h3>
          <div class="radio-list">
            {SORTS.map((s, i) => (
              <label class="radio-row">
                <input class="radio-row__input" type="radio" name="sort-dock" value={s.value} checked={i === 0} data-sort-by />
                <span class="radio-row__mark" aria-hidden="true"></span>
                <span class="radio-row__label">{s.label}</span>
              </label>
            ))}
          </div>
        </section>
      )}

      {popular.length > 0 && (
        <section class="fsheet__group fsheet__group--popular">
          <h3 class="fsheet__label">Популярные фильтры</h3>
          <div class="fsheet__chips">
            {popular.map((p) => (
              <button class="chip" type="button" data-chip-proxy data-chip-key={p.key} data-chip-value={p.value} aria-pressed="false">
                {p.label}
                {p.count !== undefined && <span class="chip__count">{p.count}</span>}
              </button>
            ))}
          </div>
        </section>
      )}

      {groups.map((group) => (
        <section class="fsheet__group" data-sheet-group={group.key}>
          <h3 class="fsheet__label">{group.label}</h3>
          <div class="fsheet__chips">
            {group.options.map((opt) => (
              <label class="chip-opt">
                <input
                  class="chip-opt__input"
                  type="checkbox"
                  name={group.key}
                  value={opt.value}
                  data-filter-key={group.key}
                  data-filter-single={group.type === 'single' ? '' : undefined}
                />
                <span class="chip">
                  {opt.label}
                  {counts[group.key]?.[opt.value] !== undefined && (
                    <span class="chip__count">{counts[group.key][opt.value]}</span>
                  )}
                </span>
              </label>
            ))}
          </div>
        </section>
      ))}
    </div>

    <footer class="sheet__foot">
      <p class="fsheet__found t-small" data-sheet-found></p>
      <div class="fsheet__actions">
        <button class="pill fsheet__btn" type="button" data-filters-reset>Сбросить</button>
        <button class="pill is-active fsheet__btn" type="button" data-sheet-close>Применить</button>
      </div>
    </footer>
  </section>
</div>

<style>
  .fsheet__body {
    display: grid;
    gap: var(--s-6);
  }

  /* Заголовок группы — кеглем корпуса, весом заголовка; над чипами воздух */
  .fsheet__label {
    font-size: var(--fs-body);
    font-weight: var(--w-head);
    margin-bottom: var(--s-3);
  }

  .fsheet__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }

  .fsheet__found {
    text-align: center;
    min-height: 1.55em;
  }

  .fsheet__actions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-3);
  }

  .fsheet__btn {
    width: 100%;
    text-align: center;
    padding-inline: var(--s-4);
  }

  /* Тач: нажатие на пилюлю — мгновенный отклик, но чернильная «Применить»
     от нажатия не должна «гаснуть» */
  .fsheet__btn.is-active:active { background: var(--fg); color: var(--bg); }

  /* Сортировка на телефоне живёт своей шторкой (FilterBar) */
  .fsheet__group--sort { display: none; }

  /* ============ ПК: КОЛОНКА СЛЕВА ============
     Чипы превращаются в строки: кружок-отметка, подпись, счётчик — тот же
     язык, что у строк .radio-row. Включённый пункт — кружок залит
     чернилами с белой точкой, сам текст не красится.
     Строка — блок с отступом под кружок (кружок абсолютом слева), а не
     flex: подпись и счётчик остаются в одном потоке, и при переносе
     счётчик стоит сразу за последним словом, а не улетает к краю. */
  @media (min-width: 1024px) {
    .fsheet__group--sort { display: block; }
    /* «Популярные» — приём телефонной шторки; в колонке всё и так на виду */
    .fsheet__group--popular { display: none; }

    .fsheet__body { gap: var(--s-6); }

    .fsheet__label {
      font-size: var(--fs-small);
      font-weight: var(--w-medium);
    }

    .fsheet__chips {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--s-2);
    }

    .fsheet__chips .chip {
      position: relative;
      display: block;
      min-height: 0;
      padding: 0 0 0 calc(16px + var(--s-3));
      background: none;
      border-radius: 0;
      white-space: normal;
      text-align: left;
      font-size: var(--fs-small);
      font-weight: var(--w-body);
      line-height: var(--lh-body);
      color: var(--fg);
    }

    .fsheet__chips .chip::before {
      content: '';
      position: absolute;
      left: 0;
      top: calc((1em * var(--lh-body) - 16px) / 2);
      width: 16px;
      height: 16px;
      border: 1px solid var(--fg);
      border-radius: 50%;
      transition: background var(--dur-fast) var(--ease-out);
    }

    /* Белая точка внутри включённого кружка */
    .fsheet__chips .chip::after {
      content: '';
      position: absolute;
      left: 5px;
      top: calc((1em * var(--lh-body) - 16px) / 2 + 5px);
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--bg);
      opacity: 0;
    }

    .fsheet__chips .chip__count {
      margin-left: var(--s-2);
      font-size: var(--fs-caption);
    }

    .fsheet__chips .chip[aria-pressed='true'],
    .fsheet__chips .chip-opt__input:checked + .chip {
      background: none;
      color: var(--fg);
    }

    .fsheet__chips .chip[aria-pressed='true']::before,
    .fsheet__chips .chip-opt__input:checked + .chip::before { background: var(--fg); }

    .fsheet__chips .chip[aria-pressed='true']::after,
    .fsheet__chips .chip-opt__input:checked + .chip::after { opacity: 1; }

    .fsheet__chips .chip-opt__input:focus-visible + .chip {
      outline: none;
    }

    .fsheet__chips .chip-opt__input:focus-visible + .chip::before {
      outline: 2px solid var(--fg);
      outline-offset: 3px;
    }
  }

  @media (min-width: 1024px) and (hover: hover) {
    .fsheet__chips .chip:hover,
    .fsheet__chips .chip-opt__input:not(:checked) + .chip:hover { background: none; }
  }
</style>

<script>
  import { bindSheet } from '../lib/sheet';

  const sheet = document.querySelector<HTMLElement>('[data-sheet="filters"]');

  if (sheet) {
    const body = sheet.querySelector<HTMLElement>('[data-sheet-body]')!;
    const foundEl = sheet.querySelector<HTMLElement>('[data-sheet-found]')!;
    const noun = JSON.parse(sheet.dataset.noun || '[]') as [string, string, string];

    const inputs = Array.from(document.querySelectorAll<HTMLInputElement>('[data-filter-key]'));
    const proxies = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-chip-proxy]'));
    const quickChips = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-quick-group]'));
    const badge = document.querySelector<HTMLElement>('[data-filters-badge]');
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-card]'));
    const countEl = document.querySelector<HTMLElement>('[data-results-count]');
    const emptyEl = document.querySelector<HTMLElement>('[data-results-empty]');

    // Быстрый чип («Цена ▾») открывает шторку, прокрученную к своей группе
    bindSheet(sheet, {
      onOpen(opener) {
        const key = opener?.dataset.sheetGroup;
        const target = key ? body.querySelector<HTMLElement>(`[data-sheet-group="${key}"]`) : null;
        body.scrollTo({ top: target ? target.offsetTop - body.offsetTop : 0 });
      },
    });

    // ============ ФИЛЬТРАЦИЯ ============
    function selections(): Record<string, string[]> {
      const map: Record<string, string[]> = {};
      inputs.forEach((input) => {
        if (!input.checked) return;
        (map[input.dataset.filterKey!] ??= []).push(input.value);
      });
      return map;
    }

    function plural(n: number): string {
      const m10 = n % 10;
      const m100 = n % 100;
      if (m10 === 1 && m100 !== 11) return noun[0];
      if (m10 >= 2 && m10 <= 4 && (m100 < 12 || m100 > 14)) return noun[1];
      return noun[2];
    }

    function syncChips(sel: Record<string, string[]>) {
      proxies.forEach((p) => {
        const { chipKey: key, chipValue: value } = p.dataset;
        p.setAttribute('aria-pressed', String(sel[key!]?.includes(value!) ?? false));
      });
      quickChips.forEach((c) => c.classList.toggle('is-active', Boolean(sel[c.dataset.quickGroup!])));
      if (badge) {
        const n = Object.values(sel).reduce((sum, v) => sum + v.length, 0);
        badge.textContent = String(n);
        badge.hidden = n === 0;
      }
    }

    function applyFilters() {
      const sel = selections();
      const activeKeys = Object.keys(sel);
      let visible = 0;

      cards.forEach((card) => {
        const data = JSON.parse(card.dataset.filters || '{}') as Record<string, string | string[]>;
        const match = activeKeys.every((key) => {
          const wanted = sel[key];
          const value = data[key];
          if (Array.isArray(value)) return value.some((v) => wanted.includes(v));
          return wanted.includes(value);
        });
        card.classList.toggle('is-hidden', !match);
        if (match) visible += 1;
      });

      if (countEl) countEl.textContent = `${visible} найдено`;
      if (emptyEl) emptyEl.hidden = visible !== 0;
      if (cards.length) foundEl.textContent = visible ? `Нашли ${visible} ${plural(visible)}` : 'Ничего не нашли';
      syncChips(sel);
    }

    inputs.forEach((input) =>
      input.addEventListener('change', () => {
        // Группа «один вариант»: включили пункт — соседи гаснут
        if (input.checked && input.dataset.filterSingle !== undefined) {
          inputs.forEach((i) => {
            if (i !== input && i.name === input.name) i.checked = false;
          });
        }
        applyFilters();
      })
    );

    // Прокси-чипы (популярные в шторке и в полосе) переключают настоящий чекбокс
    proxies.forEach((p) =>
      p.addEventListener('click', () => {
        const { chipKey: key, chipValue: value } = p.dataset;
        const input = inputs.find((i) => i.dataset.filterKey === key && i.value === value);
        if (!input) return;
        input.checked = !input.checked;
        input.dispatchEvent(new Event('change', { bubbles: true }));
      })
    );

    // «Сбросить» два: в шапке (колонка на ПК) и в футере (шторка на телефоне)
    sheet.querySelectorAll<HTMLButtonElement>('[data-filters-reset]').forEach((btn) =>
      btn.addEventListener('click', () => {
        inputs.forEach((input) => { input.checked = false; });
        applyFilters();
      })
    );

    applyFilters();
  }
</script>
