---
// Единственная точка вывода иконок проекта. Набор — Solar (Bold),
// контуры лежат во внешнем спрайте public/icons.svg (генерируется
// scripts/gen-icons.mjs из src/lib/icons.ts — там же исходные контуры).
// Вместо инлайна полного <svg> на каждое место использования — <use> на
// symbol в спрайте: раньше повторяющиеся иконки (sound/soundOff/play на
// каждый ролик карточки) раздували HTML на десятки КБ (см. AUDIT.md).
// Размер и цвет иконка берёт от места, куда вставлена: currentColor
// и размеры класса-хозяина — своих значений компонент не задаёт.
import { spriteVersion, type IconName } from '../lib/icons';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg class={className} fill="currentColor" aria-hidden="true"><use href={`/icons.svg?v=${spriteVersion}#i-${name}`} /></svg>

<style>
  /* Подстраховка от «растянутого» SVG: у svg без размеров дефолт 300×150,
     а scoped-стили страницы-хозяина внутрь компонента не достают
     (селектор .dock__icon получает data-атрибут своего файла).
     Поэтому базовый размер живёт здесь, а места, где нужен другой,
     объявляют свой класс через :global(). */
  svg {
    display: block;
    width: 24px;
    height: 24px;
    flex: none;
  }
</style>
