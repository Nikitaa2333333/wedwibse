---
// Полоса цифр-фактов. Единственное место, где живёт тонкое гигантское
// начертание (--w-thin через .t-num).
import type { Venue } from '../data/venues';

interface Props {
  items: Venue['stats'];
  /** внутри чужого блока (раздел текста карточки): только сетка цифр,
      без своей секции, контейнера и отступов */
  inline?: boolean;
}

const { items, inline = false } = Astro.props;
---

{inline ? (
  <div class="stats__grid stats__grid--inline">
    {items.map((item) => (
      <div class="stat">
        <span class:list={['stat__value t-num', item.value.length > 4 && 'stat__value--long']}>{item.value}</span>
        <span class="stat__label t-small">{item.label}</span>
      </div>
    ))}
  </div>
) : (
  <section class="stats section section--tight">
    <div class="container container--wide">
      <div class="stats__grid">
        {items.map((item) => (
          <div class="stat">
            <span class:list={['stat__value t-num', item.value.length > 4 && 'stat__value--long']}>{item.value}</span>
            <span class="stat__label t-small">{item.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .stats__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-6) var(--s-5);
  }

  /* внутри раздела текста: отступ от заголовка раздела. Ставит сама сетка —
     правило соседства StoryText на чужой компонент не распространяется */
  .stats__grid--inline { margin-top: var(--s-5); }

  .stat {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }

  .stat__value {
    font-size: clamp(46px, 8vw, 92px);
    letter-spacing: var(--ls-display);
  }

  /* Длинное число («2 000+») в половину телефона не влезало и рвалось
     по пробелу на «2» и «000+» (заказчик, 12.10.2026). Не переносим,
     а ужимаем кегль под ширину колонки; короткие числа не трогаем. */
  .stat { container-type: inline-size; }

  .stat__value--long {
    white-space: nowrap;
    font-size: min(clamp(46px, 8vw, 92px), 24cqi);
  }

  .stat__label { font-weight: var(--w-medium); line-height: var(--lh-caption); }

  @media (min-width: 900px) {
    .stats__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    /* в колонке текста карточки четыре в ряд не помещаются */
    .stats__grid--inline { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
