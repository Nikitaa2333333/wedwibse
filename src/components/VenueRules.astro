---
// «Что важно знать» — ограничения площадки. Инверсия секции одним
// классом .theme-dark. У пункта есть свой заголовок, поэтому маркеры
// не ставим, линий между пунктами нет.
import type { Venue } from '../data/venues';

interface Props {
  kicker: string;
  title: string;
  rules: Venue['rules'];
}

const { kicker, title, rules } = Astro.props;
---

<section class="rules section theme-dark" id="pravila">
  <div class="container container--wide">
    <header class="rules__head">
      <p class="rules__kicker t-caption">{kicker}</p>
      <h2 class="rules__title">{title}</h2>
    </header>

    <div class="rules__grid" data-reveal-group>
      {
        rules.map((rule) => (
          <article class="rule">
            <h3 class="rule__name">{rule.title}</h3>
            <p class="rule__text">{rule.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* По полям страницы, как сцены и вопросы */
  .rules :global(.container) { max-width: none; }

  .rules__head { margin-bottom: var(--section-gap-tight); }

  .rules__kicker {
    font-weight: var(--w-medium);
    margin-bottom: var(--s-3);
  }

  .rules__title {
    font-size: var(--fs-h1);
    font-weight: var(--w-head-lg);
    line-height: var(--lh-display);
    letter-spacing: var(--ls-display);
    max-width: var(--measure-head);
  }

  .rules__grid {
    display: grid;
    gap: var(--s-7) var(--s-8);
  }

  .rule__name {
    font-size: var(--fs-h3);
    font-weight: var(--w-head);
    margin-bottom: var(--s-3);
  }

  .rule__text { max-width: var(--measure-text); }

  @media (min-width: 900px) {
    .rules__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
