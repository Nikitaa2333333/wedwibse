---
// ЗАГОЛОВОК-ПЕРЕКЛЮЧАТЕЛЬ каталога: сам h1 раздела — кнопка, рядом чип
// локации. Клик по любому из них поднимает снизу шторку «Локация» со
// списком «один из» (реф. Яндекс Путешествия: любая настройка — шторка,
// не выпадающий список). Оболочка — реестр .sheet, открытие — lib/sheet.ts.
//
// Колонки «Направление» тут больше нет: переход между разделами живёт
// в навигации, а шапка раздела отвечает только за «где я ищу».
// Локация — пока клиентская фиксация: отмечает соответствующий пункт
// фильтра «город» этой страницы и запоминается в localStorage.
// ЗАГЛУШКА: когда появится серверная выдача, локация переедет в URL
// (/podolsk/ploshchadki/), сама шторка не изменится.
import type { FilterGroup } from '../data/specialists';
import Icon from './Icon.astro';

interface Props {
  title: string;
  /** 'ploshchadki' либо slug категории специалистов — текущий раздел.
      Панель его больше не показывает, проп оставлен: страницы его передают
      и он понадобится, когда локация переедет в URL раздела. */
  active: string;
  /** готовая строка счётчика («12 найдено»), обновляется фильтрами страницы */
  count?: string;
  /** группа фильтра «город» этой страницы: из неё строится список локаций */
  cityGroup?: FilterGroup;
}

const { title, count, cityGroup } = Astro.props;

// Страницы без своих фильтров (категории-заглушки) всё равно должны давать
// выбор локации — тут запасной список, он ничего не фильтрует.
const FALLBACK_CITIES: FilterGroup = {
  key: 'city',
  label: 'Локация',
  type: 'single',
  options: [
    { value: 'Москва', label: 'Москва' },
    { value: 'Московская область', label: 'Московская область' },
  ],
};

const cities = cityGroup ?? FALLBACK_CITIES;
const ALL_LABEL = 'Москва и область';
const options = [{ value: '', label: ALL_LABEL }, ...cities.options];
---

<header class="scope" data-scope>
  <div class="scope__title-row">
    <h1 class="t-h1 scope__title">{title}</h1>
    {count && <p class="scope__count" data-results-count>{count}</p>}
  </div>

  <div class="scope__tools">
    <button class="pill pill--sm scope__city" type="button" data-sheet-open="scope" aria-controls="scope-sheet" aria-expanded="false">
      <Icon name="venue" class="scope__pin" />
      <span data-scope-city-label>{ALL_LABEL}</span>
      <span class="scope__city-caret" aria-hidden="true">▾</span>
    </button>
    <slot name="actions" />
  </div>

  <div class="sheet" id="scope-sheet" data-sheet="scope">
    <div class="sheet__backdrop" data-sheet-close></div>
    <section class="sheet__panel" role="dialog" aria-modal="true" aria-labelledby="scope-title">
      <header class="sheet__head">
        <h2 class="sheet__title" id="scope-title">Локация</h2>
        <button class="icon-btn" type="button" data-sheet-close aria-label="Закрыть">
          <Icon name="close" />
        </button>
      </header>
      <div class="sheet__body" data-lenis-prevent>
        <div class="radio-list">
          {options.map((o, i) => (
            <label class="radio-row">
              <input class="radio-row__input" type="radio" name="scope-city" value={o.value} checked={i === 0} data-scope-city />
              <span class="radio-row__mark" aria-hidden="true"></span>
              <span class="radio-row__label">{o.label}</span>
            </label>
          ))}
        </div>
      </div>
    </section>
  </div>
</header>

<style>
  /* ============ ШАПКА РАЗДЕЛА ============ */
  .scope {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-4);
    padding: var(--s-6) var(--gutter) var(--s-5);
  }

  .scope__title-row {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--s-3);
  }

  /* Счётчик — рядом с заголовком, крупно: сразу виден объём каталога */
  .scope__count {
    font-size: var(--fs-h3);
    font-weight: var(--w-medium);
  }

  /* Инструменты (локация + слот «Фильтры»): на телефоне своей строкой,
     от планшета — прижаты вправо к заголовку. */
  .scope__tools {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    flex: 1 0 100%;
  }

  @media (min-width: 640px) {
    .scope__tools { flex: 0 0 auto; margin-left: auto; }
  }

  .scope__city {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  :global(.scope__pin) { width: 13px; height: 13px; flex: none; }
  .scope__city-caret { font-size: 9px; }

  /* ПК: локация выбирается в левой колонке (группа «Локация» фильтров),
     шторка не нужна — чип прячем. */
  @media (min-width: 1024px) {
    .scope__city { display: none; }
  }
</style>

<script>
  import { bindSheet } from '../lib/sheet';

  // Шторка одна на страницу: открывается заголовком и чипом локации.
  const scope = document.querySelector<HTMLElement>('[data-scope]');
  const sheet = scope?.querySelector<HTMLElement>('[data-sheet="scope"]');

  if (scope && sheet) {
    const toggles = Array.from(scope.querySelectorAll<HTMLButtonElement>('[data-sheet-open="scope"]'));
    const chip = scope.querySelector<HTMLElement>('[data-scope-city-label]');
    const radios = Array.from(sheet.querySelectorAll<HTMLInputElement>('[data-scope-city]'));
    const ALL_LABEL = chip?.textContent?.trim() ?? '';
    const STORE_KEY = 'wed:scope-city';

    const setOpen = (open: boolean) => {
      scope.classList.toggle('is-open', open);
      toggles.forEach((t) => t.setAttribute('aria-expanded', String(open)));
    };

    const handle = bindSheet(sheet, {
      onOpen: () => setOpen(true),
      onClose: () => setOpen(false),
    });

    const labelOf = (r: HTMLInputElement) =>
      r.closest('.radio-row')!.querySelector('.radio-row__label')!.textContent!.trim();

    // Выбор локации: отметка в списке, подпись в чипе и — если у страницы
    // есть фильтр «город» — отметка соответствующего пункта. Дальше работает
    // обычная фильтрация каталога (FilterSheet слушает change).
    function pickCity(value: string, save = true) {
      const radio = radios.find((r) => r.value === value) ?? radios[0];
      radios.forEach((r) => { r.checked = r === radio; });
      if (chip) chip.textContent = value ? labelOf(radio) : ALL_LABEL;

      const inputs = Array.from(document.querySelectorAll<HTMLInputElement>('[data-filter-key="city"]'));
      inputs.forEach((i) => { i.checked = value !== '' && i.value === value; });
      inputs[0]?.dispatchEvent(new Event('change', { bubbles: true }));

      if (save) {
        try { localStorage.setItem(STORE_KEY, value); } catch {}
      }
    }

    radios.forEach((r) =>
      r.addEventListener('change', () => {
        if (!r.checked) return;
        pickCity(r.value);
        handle.close();
      })
    );

    // Локация переносится между страницами каталога. Словарь городов у разделов
    // разный (у площадок — города, у ведущих — округа), поэтому чужое значение
    // молча игнорируем: раздел просто открывается без фиксации.
    try {
      const saved = localStorage.getItem(STORE_KEY);
      if (saved && radios.some((r) => r.value === saved)) pickCity(saved, false);
    } catch {}
  }
</script>
