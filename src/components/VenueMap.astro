---
// КАРТА ПЛОЩАДОК — модуль каталога, а не украшение одной страницы.
// Метка (.map-pin в global.css) показывает цену, клик на ПК поднимает
// карточку площадки поверх карты, на телефоне сразу уводит на её страницу.
//
// Три вещи, ради которых компонент устроен именно так:
//   1. Карточки под карту рендерятся здесь же, на сервере: фото проходит
//      через astro:assets (сжатие + srcset), а не собирается строкой в
//      браузере.
//   2. Скрипт Яндекса грузится лениво — только когда карта реально показана
//      (в каталоге она за кнопкой «На карте»). Пока карту не открыли, страница
//      не тянет ни килобайта чужого JS.
//   3. Если рядом на странице есть карточки каталога ([data-card][data-slug]),
//      карта повторяет их фильтрацию: скрытую фильтрами площадку убираем и
//      с карты.
import { getImage } from 'astro:assets';
import { resolveImage, IMG_WIDTHS } from '../lib/images';
import type { MapPoint } from '../lib/map-points';

interface Props {
  points: MapPoint[];
  /** 'block' — карта высотой в блок (обычная секция страницы),
   *  'screen' — почти во весь экран (режим «На карте» в каталоге) */
  size?: 'block' | 'screen';
}

const { points, size = 'block' } = Astro.props;

// Кадр для метки-фокуса (см. «ФОКУС» в скрипте): её разметку собирает
// шаблон Яндекса в браузере, <Image> туда не вставить — поэтому готовый
// пережатый srcset считаем здесь, на сборке, и отдаём вместе с точкой.
const clientPoints = await Promise.all(
  points.map(async (point) => {
    const img = await getImage({
      src: resolveImage(point.photo),
      widths: IMG_WIDTHS.thumb,
      sizes: '160px',
      format: 'webp',
    });
    return { ...point, thumb: img.src, thumbSet: img.srcSet.attribute };
  })
);

// Ключ пакета «JavaScript API» — публичный браузерный ключ (защищается
// списком доменов в кабинете Яндекса, не секретностью), но в репозиторий
// текстом не кладём: читается из секрета GitHub Actions на сборке.
const apiKey = import.meta.env.YANDEX_MAPS_API_KEY;
---

<div
  class:list={['vmap', { 'vmap--screen': size === 'screen' }]}
  data-venue-map
  data-points={JSON.stringify(clientPoints)}
  data-api-key={apiKey}
>
  <div class="vmap__canvas" data-map-canvas></div>

</div>

<style>
  .vmap {
    position: relative;
  }

  .vmap__canvas {
    width: 100%;
    height: 480px;
    background: var(--surface-dim);
    overflow: hidden;
  }

  /* Режим «На карте»: карта занимает ЦЕЛЫЙ экран, без нижнего дока.
     Не 72dvh, как было: та высота оставляла под картой полосу пустой
     бумаги, и экран читался незаконченным. Секция липкая (см. .mapview
     в каталоге), поэтому при прокрутке фильтры уходят наверх, а карта
     встаёт ровно во весь экран над доком. */
  .vmap--screen .vmap__canvas { height: calc(100dvh - var(--dock-h)); }
</style>

<script>
  import { seenSet, seenId } from '../lib/seen';

  interface MapPointData {
    slug: string;
    name: string;
    coords: [number, number];
    href: string;
    price: string;
    /** цена в том виде, в каком она влезает в метку (см. lib/map-points) */
    label: string;
    /** пережатый кадр для метки-фокуса (считается на сборке, см. фронтматтер) */
    thumb: string;
    thumbSet: string;
  }

  // Скрипт Яндекса один на страницу и грузится по первому показу карты
  let apiPromise: Promise<any> | null = null;

  function loadMapsApi(key: string): Promise<any> {
    if (!apiPromise) {
      apiPromise = new Promise((resolve, reject) => {
        const script = document.createElement('script');
        script.src = `https://api-maps.yandex.ru/2.1/?apikey=${key}&lang=ru_RU`;
        script.onload = () => (window as any).ymaps.ready(() => resolve((window as any).ymaps));
        script.onerror = reject;
        document.head.appendChild(script);
      });
    }
    return apiPromise;
  }

  function initMap(root: HTMLElement) {
    const canvas = root.querySelector<HTMLElement>('[data-map-canvas]');
    const points: MapPointData[] = JSON.parse(root.dataset.points || '[]');
    const key = root.dataset.apiKey || '';
    if (!canvas || points.length === 0) return;

    loadMapsApi(key).then((ymaps) => {
      const map = new ymaps.Map(canvas, { center: [55.75, 37.62], zoom: 9 });

      // ============ КЛАСТЕРЫ ============
      // Реф. ЦИАН: отдалили — точки схлопываются в кружок с числом,
      // приблизили — снова цены. Без кластеров карта врёт: «Лесная Роса»
      // и «Из-за любви» стоят в ста метрах друг от друга, и на масштабе
      // области их метки просто накладываются — видно одну, второй как
      // будто нет. С ростом каталога до сотен площадок это не косметика,
      // а единственный способ показать Москву и область целиком.
      // Клик по кластеру — приближение (это поведение по умолчанию,
      // балон отключён): тот же жест, что у всех карт.
      const ClusterLayout = ymaps.templateLayoutFactory.createClass(
        '<span class="map-cluster">$[properties.geoObjects.length]</span>'
      );

      const clusterer = new ymaps.Clusterer({
        clusterIconLayout: ClusterLayout,
        // рамка кружка: у своей вёрстки метки размеры Яндекс не знает
        clusterIconShape: { type: 'Circle', coordinates: [0, 0], radius: 22 },
        clusterDisableClickZoom: false,
        hasBalloon: false,
        // мельче сетка — кластеры распадаются раньше, а нам важно как раз
        // не склеивать соседние площадки на среднем масштабе
        gridSize: 64,
      });

      map.geoObjects.add(clusterer);

      // Метка не ссылка: у неё задан iconShape, и клики забирает слой карты —
      // нажатие ловим событием метки ниже.
      // Подпись метки — ТОЛЬКО ЦЕНА (см. .map-pin в global.css): название
      // с карты снято, оно живёт в title метки и в карточке, которая
      // поднимается по клику.
      const PinLayout = ymaps.templateLayoutFactory.createClass(
        '<span class="map-pin $[properties.pinState]" title="$[properties.pinTitle]">' +
          '<span class="map-pin__price">$[properties.pinPrice]</span>' +
          '</span>'
      );

      const marks = new Map<string, any>();
      const bySlug = new Map(points.map((p) => [p.slug, p]));

      // ============ «УЖЕ СМОТРЕЛ» ============
      // Открытая карточка гасит свою метку (реф. ЦИАН): на карте из
      // десятков точек сразу видно, что осталось. Отметку ставит сама
      // страница площадки (lib/seen), здесь только читаем.
      const seen = seenSet();
      const stateOf = (slug: string) => (seen.has(seenId('venue', slug)) ? 'is-seen' : '');

      points.forEach((point) => {
        marks.set(
          point.slug,
          new ymaps.Placemark(
            point.coords,
            {
              pinPrice: point.label,
              pinTitle: point.price ? `${point.name} — ${point.price}` : point.name,
              pinState: stateOf(point.slug),
            },
            {
              iconLayout: PinLayout,
              // активная область: капсула стоит над точкой, ширина зависит
              // от подписи — берём с запасом под самую длинную цену
              // (в CSS она всё равно ограничена 16ch)
              iconShape: { type: 'Rectangle', coordinates: [[-70, -38], [70, 4]] },
              hasBalloon: false,
            }
          )
        );
      });

      // ============ МИНИ-КАРТОЧКА ПО НАЖАТИЮ НА МЕТКУ ============
      // Нажали на цену — на её месте всплывает мини-карточка: кадр сверху,
      // название под ним (.map-pin--card в global.css). Нажали на карточку —
      // переход на страницу площадки. Крестик в углу кадра сворачивает её
      // обратно в цену: человек остаётся на карте и смотрит соседей — там,
      // где площадки стоят плотно, это главный сценарий (заказчик, 26.09.2026).
      // Одно поведение на телефоне и ПК: раньше телефон уводил на страницу
      // с первого касания, а ПК поднимал плашку внизу карты.
      //
      // Карточка — отдельная метка вне кластера, поверх соседей: на любом
      // масштабе её не схлопнет в кружок с числом. Крестик — ещё одна,
      // невидимая метка над углом карточки: клики у меток с iconShape
      // забирает слой карты, и понять, что нажали именно крестик, можно
      // только его собственной меткой с более высоким zIndex.
      //
      // Размеры карточки заданы в CSS жёстко (CARD_W × CARD_H) и повторены
      // здесь: по ним считаются активные области меток. Меняются — вместе.
      const CARD_W = 116;
      const CARD_H = 132;
      const CLOSE_R = 14; // радиус крестика; центр — в правом верхнем углу кадра

      const CardLayout = ymaps.templateLayoutFactory.createClass(
        '<span class="map-pin map-pin--card" title="$[properties.name]">' +
          '<img class="map-pin__photo" src="$[properties.thumb]" srcset="$[properties.thumbSet]"' +
          ' sizes="' + (CARD_W - 8) + 'px" alt="" decoding="async">' +
          '<span class="map-pin__close" aria-hidden="true">' +
            '<svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>' +
          '</span>' +
          '<span class="map-pin__name">$[properties.name]</span>' +
          '</span>'
      );
      const CloseLayout = ymaps.templateLayoutFactory.createClass('<span></span>');

      const closeCenter: [number, number] = [CARD_W / 2 - 4 - CLOSE_R, -CARD_H + 4 + CLOSE_R];

      let openSlug: string | null = null;
      let cardMark: any = null;
      let closeMark: any = null;

      const collapse = () => {
        if (!openSlug) return;
        map.geoObjects.remove(cardMark);
        map.geoObjects.remove(closeMark);
        const slug = openSlug;
        openSlug = null;
        cardMark = closeMark = null;
        // цена возвращается в кластер, только если площадка не отфильтрована
        const mark = marks.get(slug);
        if (mark && visible.has(slug)) clusterer.add(mark);
      };

      const expand = (slug: string) => {
        if (openSlug === slug) return;
        collapse();
        const point = bySlug.get(slug);
        if (!point) return;

        openSlug = slug;
        const mark = marks.get(slug);
        if (mark) clusterer.remove(mark);

        cardMark = new ymaps.Placemark(
          point.coords,
          { name: point.name, thumb: point.thumb, thumbSet: point.thumbSet },
          {
            iconLayout: CardLayout,
            // карточка над точкой: CARD_W шириной, CARD_H высотой + остриё
            iconShape: { type: 'Rectangle', coordinates: [[-CARD_W / 2, -CARD_H], [CARD_W / 2, 6]] },
            hasBalloon: false,
            zIndex: 1000,
            zIndexHover: 1000,
          }
        );
        cardMark.events.add('click', () => { window.location.href = point.href; });

        closeMark = new ymaps.Placemark(
          point.coords,
          {},
          {
            iconLayout: CloseLayout,
            iconShape: { type: 'Circle', coordinates: closeCenter, radius: CLOSE_R + 4 },
            hasBalloon: false,
            zIndex: 1100,
            zIndexHover: 1100,
          }
        );
        closeMark.events.add('click', collapse);

        map.geoObjects.add(cardMark);
        map.geoObjects.add(closeMark);
      };

      marks.forEach((mark, slug) => {
        mark.events.add('click', () => expand(slug));
      });

      // клик по метке всплывает и до карты — сворачиваем только по подложке
      map.events.add('click', (event: any) => {
        if (event.get('target') === map) collapse();
      });

      // ——— карта повторяет фильтрацию каталога ———
      // Карточка выдачи скрывается классом .is-hidden (см. FilterSheet):
      // ту же площадку убираем и с карты, потом подгоняем масштаб под
      // оставшиеся метки.
      // Карточек с одним slug может быть несколько (демо-карточки ленты ведут
      // на ту же площадку) — метка остаётся, пока видна хоть одна из них.
      const visibleSlugs = () =>
        points
          .filter((point) => {
            const cards = document.querySelectorAll<HTMLElement>(`[data-card][data-slug="${point.slug}"]`);
            return cards.length === 0 || Array.from(cards).some((card) => !card.classList.contains('is-hidden'));
          })
          .map((point) => point.slug);

      let visible = new Set<string>();

      // fit=false — не подгонять масштаб: при заходе с фокусом карта сразу
      // встаёт на площадку. setBounds асинхронный и отрабатывал ПОСЛЕ
      // setCenter, перебивая его, — карта оставалась на всей области,
      // а карточка фокуса висела у края (заказчик, 26.09.2026).
      const sync = (fit = true) => {
        visible = new Set(visibleSlugs());
        if (openSlug && !visible.has(openSlug)) collapse();

        clusterer.removeAll();
        clusterer.add(
          points
            .filter((p) => visible.has(p.slug) && p.slug !== openSlug)
            .map((p) => marks.get(p.slug))
        );

        if (!fit) return;
        const bounds = clusterer.getBounds();
        if (bounds) map.setBounds(bounds, { checkZoomRange: true, zoomMargin: 48 });
      };

      // ============ ФОКУС: ПРИШЛИ СО СТРАНИЦЫ ПЛОЩАДКИ ============
      // data-focus ставит каталог по ?karta= (кнопка «На карте» в
      // VenueHero): карта встаёт на площадку, её карточка уже раскрыта.
      const focus = root.dataset.focus ? bySlug.get(root.dataset.focus) : undefined;

      sync(!focus);

      if (focus) {
        map.setCenter(focus.coords, 14);
        expand(focus.slug);
      }

      const refit = () => sync();
      document.addEventListener('change', refit); // фильтры каталога — обычные input'ы
      root.addEventListener('vmap:show', refit);
    });
  }

  // Инициализация по первому показу: скрытый блок ничего не пересекает,
  // поэтому карта в каталоге просыпается ровно тогда, когда её открыли.
  document.querySelectorAll<HTMLElement>('[data-venue-map]').forEach((root) => {
    const observer = new IntersectionObserver((entries) => {
      if (!entries.some((entry) => entry.isIntersecting)) return;
      observer.disconnect();
      initMap(root);
    });
    observer.observe(root);
  });
</script>
