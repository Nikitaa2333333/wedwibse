---
// ============================================================
// КНОПКА «НАЗАД» — замена хлебной крошке текстом на карточках-потомках
// (площадка, специалист): круглая ink-капсула поверх кадра, тот же язык,
// что у метки на карте — чернильная подложка читается на любом фото,
// белое стекло тонуло бы на светлых кадрах.
//
// Ставится там, куда попадают ВГЛУБЬ каталога, а не через нижний док:
// у раздела из дока («Площадки», «Специалисты», «Избранное») своей
// кнопки назад нет — он сам корень своей ветки.
//
// href — настоящая ссылка на раздел-родитель: работает без JS и это
// живая внутренняя перелинковка (крошка текстом её и давала). Скрипт
// поверх подменяет переход на history.back(), если у вкладки есть
// история этого же сайта — обычный путь «пришли из каталога». Прямой
// заход (поиск, закладка) истории не даёт — тогда просто едем по href.
import Icon from './Icon.astro';

interface Props {
  href: string;
  label?: string;
}

const { href, label = 'Назад' } = Astro.props;
---

<a class="back-btn" href={href} data-back-btn aria-label={label}>
  <Icon name="arrowLeft" />
</a>

<style>
  .back-btn {
    position: absolute;
    top: calc(var(--s-4) + env(safe-area-inset-top, 0px));
    left: var(--s-4);
    z-index: 2;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: color-mix(in srgb, var(--black) 42%, transparent);
    color: var(--white);
    text-decoration: none;
    filter: drop-shadow(0 1px 8px rgb(0 0 0 / 0.35));
    transition: background var(--dur-fast) var(--ease-out);
  }

  .back-btn svg { width: 20px; height: 20px; }

  @media (hover: hover) {
    .back-btn:hover { background: var(--black); }
  }
</style>

<script>
  document.querySelectorAll<HTMLAnchorElement>('[data-back-btn]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      if (window.history.length > 1 && document.referrer.startsWith(location.origin)) {
        e.preventDefault();
        history.back();
      }
    });
  });
</script>
