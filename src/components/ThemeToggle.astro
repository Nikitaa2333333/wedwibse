---
// ТУМБЛЕР ТЕМЫ — светлая/тёмная палитра сайта.
//
// Форма — общий элемент .switch из реестра (global.css), своих размеров
// и цветов компонент не держит: тумблер в проекте не обязан остаться
// единственным, и вторая настройка возьмёт тот же класс.
//
// Разметка — button role="switch": это переключатель состояния, а не
// кнопка-действие, поэтому состояние живёт в aria-checked, а подпись
// («Тёмная тема») постоянная. Прыгающая подпись у переключателя читается
// скринридером как смена смысла кнопки, хотя смысл один.
//
// Механика — lib/theme.ts (выбор помнится в localStorage). Атрибут темы
// на <html> к этому моменту уже стоит: его ставит inline-скрипт в <head>
// Layout, иначе на каждом переходе была бы белая вспышка.
---

<button
  class="switch"
  type="button"
  role="switch"
  aria-checked="false"
  aria-label="Тёмная тема"
  data-theme-toggle
>
  <span class="switch__track">
    <span class="switch__thumb"></span>
  </span>
</button>

<script>
  import { applyTheme, readTheme, toggleTheme } from '../lib/theme';

  // Догоняем состояние самой кнопки — тема на странице уже применена.
  applyTheme(readTheme());

  document.querySelectorAll<HTMLElement>('[data-theme-toggle]').forEach((btn) => {
    btn.addEventListener('click', () => toggleTheme());
  });
</script>
