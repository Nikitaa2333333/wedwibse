---
// ДОСКА-МАСОНРИ — общая вёрстка потока кадров, как в Pinterest: колонки
// одной ширины, каждая плитка в своей настоящей пропорции, следующая
// плитка ложится в самую короткую колонку (layoutColumns в lib/gallery).
//
// Один поток, а не сетка: колонки идут вниз и заканчиваются на разной
// высоте, как лента. Ни полос во всю ширину, ни растянутых «дотянутых»
// кадров — и то и другое ломает пропорцию снимка ради ровной линии.
//
// Компонент общий на весь проект: доска главной (PhotoBoard) и галерея
// карточки подрядчика показывают кадры ОДИНАКОВО. Раньше галерея визитки
// была отдельной сеткой с жёстким aspect-ratio 3/4 — каждый кадр там
// кропился под чужую рамку, и вертикальный портрет соседствовал с
// обрезанным горизонтальным. Появится третья галерея — берёт этот же
// компонент, а не заводит свою вёрстку. Сама плитка — MasonryTile.
//
// Сервер раскладывает под телефон — две колонки: это основной сценарий,
// и там доска стоит без единой строки JS. На широком экране колонок 3–5:
// скрипт ниже перекладывает те же плитки тем же жадным алгоритмом —
// узлы переезжают, ничего не рисуется заново, слушатели PhotoRail живы.
//
// РЕЖИМЫ СВЕРХ ЭТОГО, пропами:
//   limit    — видны первые N плиток, остальные лежат в HTML скрытым
//              хвостом (SEO) и досыпаются в колонки на месте, без перехода
//              на другую страницу. Скрытый кадр браузер не грузит:
//              lazy-картинка без бокса.
//   infinite — как хвост досыпается. Без него — по кнопке «Показать все
//              N фото» (галерея карточки: она стоит посреди страницы, и
//              растущая сама по себе доска отодвигала бы отзывы и бронь
//              за горизонт). С ним — сам, при прокрутке: сторож под
//              колонками (IntersectionObserver) за полтора экрана до конца
//              подкладывает следующую порцию BATCH — бесконечная лента
//              доски главной, как в Pinterest. Плитки при этом не
//              перекладываются заново: колонки продолжаются с того места,
//              где остановилась раскладка (тем же pickColumn), так что
//              уже загруженные кадры не двигаются и ролики не сбиваются.
//
// Просмотра-оверлея на весь экран тут больше нет: нажатие на кадр ведёт
// на страницу карточки, где полноэкранный кадр со стеклом — её первый
// экран (HeroStage), и с него можно уйти вниз, к описанию и брони.
import MasonryTile from './MasonryTile.astro';
import { layoutColumns, type Tile } from '../lib/gallery';
import { IMG_WIDTHS } from '../lib/images';

interface Props {
  tiles: Tile[];
  /** sizes для <Image> внутри плитки: зависит от того, во сколько колонок
   *  идёт доска на каждом брейкпоинте */
  sizes: string;
  widths?: number[];
  /** сколько плиток показать сразу; остальные — хвостом (см. шапку) */
  limit?: number;
  /** хвост досыпается сам при прокрутке, а не по кнопке (доска главной) */
  infinite?: boolean;
  /** доска — первый экран страницы (главная): первый ряд получает LCP-приоритет.
   *  В галерее карточки НЕ ставить — там первый экран уже держит HeroStage,
   *  второй fetchpriority="high" ниже сгиба только отбирает у него канал */
  priority?: boolean;
}

const { tiles, sizes, widths = IMG_WIDTHS.tile, limit, infinite = false, priority = false } = Astro.props;

// Видимая часть и скрытый хвост. Раскладка под телефон считается на сервере
// только по видимым — скрытые в колонках места не занимают; шире и после
// раскрытия перекладывает скрипт.
const shown = limit && tiles.length > limit ? tiles.slice(0, limit) : tiles;
const rest = tiles.slice(shown.length);
const columns = layoutColumns(shown, 2);

// ПЕРВЫЙ РЯД ДОСКИ — ОН ЖЕ LCP ГЛАВНОЙ. На телефоне (2 колонки, основной
// сценарий) первый ряд — первые два кадра потока: layoutColumns на старте
// всегда кладёт первую плитку в колонку 0, вторую — в колонку 1 (обе колонки
// пустые, жадный алгоритм берёт по порядку). Эти две плитки помечаем
// priority — тем же пропом, что уже гонит первый кадр HeroStage без lazy
// и с fetchpriority="high" (см. PhotoRail), только тут это первый кадр
// каждой из двух карусельных плиток, а не все кадры рельса.
const priorityTiles = new Set(
  priority ? shown.filter((t) => t.kind === 'photo').slice(0, 2).map((t) => t.index) : []
);
---

<!-- Без параллакса намеренно: доска листается как обычная страница,
     все кадры на месте сразу, ничего не проявляется. -->
<div class="masonry-host" data-masonry-host>
  <div class="masonry" data-masonry>
    {
      columns.map((col) => (
        <div class="masonry__col">
          {col.map((tile) => (
            <MasonryTile tile={tile} sizes={sizes} widths={widths} priority={priorityTiles.has(tile.index)} />
          ))}
        </div>
      ))
    }
  </div>

  <!-- Хвост галереи (limit): в HTML целиком, на экране — после кнопки.
       Скрипт переносит плитки отсюда в колонки на месте. -->
  {rest.length > 0 && (
    <div data-masonry-rest hidden>
      {rest.map((tile) => (
        <MasonryTile tile={tile} sizes={sizes} widths={widths} hidden />
      ))}
    </div>
  )}
  {rest.length > 0 && !infinite && (
    <p class="masonry__more">
      <button class="pill" type="button" data-masonry-reveal>Показать все {tiles.length} фото</button>
    </p>
  )}
  <!-- Сторож бесконечной ленты: пустой блок под колонками, по его
       приближению к экрану скрипт досыпает следующую порцию. Без JS
       хвост просто остаётся скрытым — первые limit плиток стоят как есть. -->
  {rest.length > 0 && infinite && <div class="masonry__sentinel" data-masonry-sentinel aria-hidden="true"></div>}

</div>

<style>
  /* Поле от края экрана — волосок --edge-gap — держит САМА доска, а не
     тот, кто её поставил: пока его писал каждый хост отдельно, галерея
     подрядчика осталась без него и кадры упирались в стекло, а та же
     доска у площадки и на главной стояла с полем. */
  .masonry-host { padding-inline: var(--edge-gap); }

  /* --board-cols — число колонок на брейкпоинте; его же читает скрипт,
     чтобы переложить плитки. Зазор и поле подписи — общие ручки доски
     (--pin-gap, --cap-pad в global.css), своих чисел тут нет. */
  .masonry {
    --board-cols: 2;
    display: grid;
    grid-template-columns: repeat(var(--board-cols), minmax(0, 1fr));
    gap: var(--pin-gap);
    align-items: start;
  }

  .masonry__col {
    display: flex;
    flex-direction: column;
    gap: var(--pin-gap);
    min-width: 0;
  }

  /* Затемнение под подписи тут лишнее: подпись живёт под кадром, а не на
     нём, и градиент только гасит низ фотографии. */
  .masonry :global(.veil) { display: none; }

  /* ВЕТКА-ПРЕВЬЮ: подписи под кадрами (.cap с названием площадки) сняты —
     доска идёт чистым потоком фотографий, как в Pinterest. Вместе с ними
     ушла и высота подписи в раскладке (CAPTION_H в lib/gallery). */

  /* Кнопка «Показать все» — по центру под колонками, отбивка как у секции */
  .masonry__more {
    display: flex;
    justify-content: center;
    padding-top: var(--s-5);
  }

  /* Сторож бесконечной ленты: не нулевой высоты, чтобы IntersectionObserver
     видел его во всех браузерах одинаково; на глаз его нет. */
  .masonry__sentinel { height: 1px; }

  @media (min-width: 640px) {
    .masonry { --board-cols: 3; }
  }

  @media (min-width: 1024px) {
    .masonry { --board-cols: 4; }
  }

  @media (min-width: 1440px) {
    .masonry { --board-cols: 5; }
  }
</style>

<script>
  import { isWide, pickColumn } from '../lib/masonry';

  // Перекладка под число колонок с экрана. Высота плитки известна из
  // data-h (пропорция + подпись, в долях ширины колонки) — картинки ждать
  // не нужно, раскладка считается до их загрузки. Колонку клонируем
  // с существующей, чтобы сохранить scoped-атрибут стилей Astro.
  // Скрытый хвост (limit) в раскладке не участвует, пока его не раскрыли.
  //
  // Состояние раскладки (высоты колонок, чем каждая заканчивается, счётчик
  // статей) живёт между вызовами: бесконечная лента ПРОДОЛЖАЕТ колонки
  // с того же места, а не перекладывает доску заново — иначе на каждой
  // порции все загруженные кадры прыгали бы, а ролики сбивались.
  // На телефоне (две колонки, серверная раскладка) состояние читается
  // из готового DOM, чтобы не двигать ни одной плитки без нужды.
  const BATCH = 12;

  document.querySelectorAll<HTMLElement>('[data-masonry-host]').forEach((host) => {
    const board = host.querySelector<HTMLElement>('[data-masonry]');
    const proto = board?.firstElementChild as HTMLElement | null;
    if (!board || !proto) return;

    const pins = Array.from(host.querySelectorAll<HTMLElement>('.pin')).sort(
      (a, b) => Number(a.dataset.i) - Number(b.dataset.i)
    );

    const heightOf = (pin: HTMLElement) => parseFloat(pin.dataset.h || '1');
    const isArticle = (pin: HTMLElement) => pin.classList.contains('pin--article');

    let cols: HTMLElement[] = [];
    let tall: number[] = [];
    let lastWide: boolean[] = [];
    let article = 0;

    // та же развилка, что на сервере (layoutColumns): статьи идут по
    // колонкам по кругу, кадры — по pickColumn
    const place = (pin: HTMLElement) => {
      let k = article % cols.length;

      if (isArticle(pin)) {
        article++;
      } else {
        k = pickColumn(tall, lastWide, isWide(heightOf(pin)));
      }

      cols[k].append(pin);
      tall[k] += heightOf(pin);
      lastWide[k] = isWide(heightOf(pin));
    };

    // Состояние из серверной раскладки: колонки уже стоят, считаем их
    // высоты и хвосты, ничего не переставляя.
    const readState = () => {
      cols = Array.from(board.children) as HTMLElement[];
      tall = cols.map((col) => Array.from(col.children).reduce((sum, pin) => sum + heightOf(pin as HTMLElement), 0));
      lastWide = cols.map((col) => {
        const last = col.lastElementChild as HTMLElement | null;
        return last ? isWide(heightOf(last)) : false;
      });
      article = pins.filter((pin) => !pin.hidden && isArticle(pin)).length;
    };

    const relayout = () => {
      const count = parseInt(getComputedStyle(board).getPropertyValue('--board-cols'), 10) || 2;
      if (count === cols.length) return;

      cols = Array.from({ length: count }, () => proto.cloneNode(false) as HTMLElement);
      tall = new Array<number>(count).fill(0);
      lastWide = new Array<boolean>(count).fill(false);
      article = 0;

      for (const pin of pins) if (!pin.hidden) place(pin);

      board.replaceChildren(...cols);
    };

    readState();
    relayout();
    // выходит сразу, если число колонок не поменялось — ресайз дешёвый
    window.addEventListener('resize', relayout);

    // ============ ХВОСТ: ПО КНОПКЕ ИЛИ ПРИ ПРОКРУТКЕ ============
    const rest = host.querySelector<HTMLElement>('[data-masonry-rest]');
    const reveal = host.querySelector<HTMLElement>('[data-masonry-reveal]');
    const sentinel = host.querySelector<HTMLElement>('[data-masonry-sentinel]');

    // Досыпать n скрытых плиток в существующие колонки, продолжая раскладку.
    // Возвращает, остались ли ещё скрытые.
    const append = (n: number) => {
      const hidden = pins.filter((pin) => pin.hidden);

      for (const pin of hidden.slice(0, n)) {
        pin.hidden = false;
        place(pin);
      }

      const left = hidden.length > n;
      if (!left) rest?.remove();
      return left;
    };

    reveal?.addEventListener('click', () => {
      append(pins.length);
      reveal.closest('.masonry__more')?.remove();
    });

    if (sentinel) {
      // Порог — полтора экрана до сторожа: порция встаёт в колонки раньше,
      // чем человек долистает до пустоты. Наблюдатель перезапускается после
      // каждой порции (unobserve/observe даёт свежий срез): если сторож
      // всё ещё на экране — следующая порция сразу, без ожидания скролла.
      const io = new IntersectionObserver(
        (entries) => {
          if (!entries.some((e) => e.isIntersecting)) return;

          if (append(BATCH)) {
            io.unobserve(sentinel);
            io.observe(sentinel);
          } else {
            io.disconnect();
            sentinel.remove();
          }
        },
        { rootMargin: '150% 0px' }
      );

      io.observe(sentinel);
    }
  });
</script>
