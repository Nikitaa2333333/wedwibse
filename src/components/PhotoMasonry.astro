---
// ДОСКА-МАСОНРИ — общая вёрстка потока кадров, как в Pinterest: колонки
// одной ширины, каждая плитка в своей настоящей пропорции, следующая
// плитка ложится в самую короткую колонку (layoutColumns в lib/gallery).
//
// Один поток, а не сетка: колонки идут вниз и заканчиваются на разной
// высоте, как лента. Ни полос во всю ширину, ни растянутых «дотянутых»
// кадров — и то и другое ломает пропорцию снимка ради ровной линии.
//
// Компонент общий на весь проект: доска главной (PhotoBoard) и галерея
// карточки подрядчика показывают кадры ОДИНАКОВО. Раньше галерея визитки
// была отдельной сеткой с жёстким aspect-ratio 3/4 — каждый кадр там
// кропился под чужую рамку, и вертикальный портрет соседствовал с
// обрезанным горизонтальным. Появится третья галерея — берёт этот же
// компонент, а не заводит свою вёрстку. Сама плитка — MasonryTile.
//
// Сервер раскладывает под телефон — две колонки: это основной сценарий,
// и там доска стоит без единой строки JS. На широком экране колонок 3–5:
// скрипт ниже перекладывает те же плитки тем же жадным алгоритмом —
// узлы переезжают, ничего не рисуется заново, слушатели PhotoRail живы.
//
// ДВА РЕЖИМА СВЕРХ ЭТОГО, оба пропами:
//   viewer — нажатие на плитку открывает кадр на весь экран поверх доски
//            (lib/viewer.ts), а не уводит на страницу карточки. Кадр для
//            просмотра считается здесь, на сервере: один URL под потолком
//            hero, не полный srcset (см. viewFrames ниже — почему).
//   limit  — галерея карточки: видны первые N кадров, остальные лежат
//            в HTML скрытым хвостом (SEO) и досыпаются в колонки по кнопке
//            «Показать все N фото», без перехода на другую страницу.
//            Скрытый кадр браузер не грузит: lazy-картинка без бокса.
import { getImage } from 'astro:assets';
import MasonryTile from './MasonryTile.astro';
import Icon from './Icon.astro';
import { layoutColumns, type Tile } from '../lib/gallery';
import type { ViewFrame } from '../lib/viewer';
import { resolveImage, IMG_WIDTHS } from '../lib/images';
import { isVideo, posterOf } from '../lib/media';

interface Props {
  tiles: Tile[];
  /** sizes для <Image> внутри плитки: зависит от того, во сколько колонок
   *  идёт доска на каждом брейкпоинте */
  sizes: string;
  widths?: number[];
  /** просмотр кадра на весь экран по нажатию (доска главной) */
  viewer?: boolean;
  /** сколько плиток показать сразу; остальные — по кнопке (галерея карточки) */
  limit?: number;
}

const { tiles, sizes, widths = IMG_WIDTHS.tile, viewer = false, limit } = Astro.props;

// Видимая часть и скрытый хвост. Раскладка под телефон считается на сервере
// только по видимым — скрытые в колонках места не занимают; шире и после
// раскрытия перекладывает скрипт.
const shown = limit && tiles.length > limit ? tiles.slice(0, limit) : tiles;
const rest = tiles.slice(shown.length);
const columns = layoutColumns(shown, 2);

// ============ КАДРЫ ДЛЯ ПРОСМОТРА ============
// Кадр в просмотре — ОДИН URL под потолком качества hero (см. lib/viewer.ts,
// ViewFrame), не полный srcset на все ширины: просмотр открывается по клику,
// не на первом экране, а полный набор ширин на КАЖДОЙ плитке доски (даже той,
// которую никто не откроет) раздувал HTML главной впустую — тот же кадр уже
// есть в самой плитке (PhotoRail), тут дублировался только его срез под
// полный экран. Один крупный кадр даёт то же качество на весь экран вчетверо
// дешевле по разметке.
//
// Владелец нужен не всем плиткам (демо-ролики общего потока — см.
// lib/gallery.ts reelPins), но кадр открывать в просмотре всё равно можно:
// href/owner тогда просто нет, viewer.ts прячет подпись.
const VIEWER_FRAME_WIDTH = IMG_WIDTHS.hero.at(-1)!;

async function viewFrames(tile: Tile): Promise<ViewFrame[] | null> {
  if (!viewer || tile.kind !== 'photo') return null;

  return Promise.all(
    tile.photos.map(async (src, n) => {
      const video = isVideo(src);
      const meta = resolveImage(video ? posterOf(src) : src);
      const out = await getImage({ src: meta, width: VIEWER_FRAME_WIDTH, format: 'webp' });

      return {
        src: out.src,
        w: meta.width,
        h: meta.height,
        alt: tile.photos.length > 1 ? `${tile.alt} — ${video ? 'видео' : 'фото'} ${n + 1}` : tile.alt,
        ...(video ? { video: src } : {}),
      };
    })
  );
}

const views = new Map<number, ViewFrame[] | null>();
for (const tile of tiles) views.set(tile.index, await viewFrames(tile));
---

<!-- Без параллакса намеренно: доска листается как обычная страница,
     все кадры на месте сразу, ничего не проявляется. -->
<div class="masonry-host" data-masonry-host>
  <div class="masonry" data-masonry>
    {
      columns.map((col) => (
        <div class="masonry__col">
          {col.map((tile) => (
            <MasonryTile tile={tile} sizes={sizes} widths={widths} view={views.get(tile.index)} />
          ))}
        </div>
      ))
    }
  </div>

  <!-- Хвост галереи (limit): в HTML целиком, на экране — после кнопки.
       Скрипт переносит плитки отсюда в колонки на месте. -->
  {rest.length > 0 && (
    <div data-masonry-rest hidden>
      {rest.map((tile) => (
        <MasonryTile tile={tile} sizes={sizes} widths={widths} view={views.get(tile.index)} hidden />
      ))}
    </div>
  )}
  {rest.length > 0 && (
    <p class="masonry__more">
      <button class="pill" type="button" data-masonry-reveal>Показать все {tiles.length} фото</button>
    </p>
  )}

  <!-- ПРОСМОТР НА ВЕСЬ ЭКРАН (viewer). Пустая оболочка: кадр и подпись
       подставляет lib/viewer из data-view/data-owner плитки. Единственный
       <img> без src в проекте — не сырой файл, а слот под srcset, который
       сервер уже посчитал через getImage (роль hero). Текст на кадре не
       лежит: подпись — на бумаге под ним, как у карточки каталога. -->
  {viewer && (
    <div class="viewer" data-viewer role="dialog" aria-modal="true" aria-label="Просмотр фотографии">
      <div class="viewer__bar">
        <button class="icon-btn" type="button" data-viewer-close aria-label="Закрыть">
          <Icon name="close" />
        </button>
        <span class="viewer__count t-caption" data-viewer-count></span>
      </div>

      <div class="viewer__stage" data-viewer-stage>
        <button class="icon-btn viewer__nav viewer__nav--prev" type="button" data-viewer-prev aria-label="Предыдущий кадр">
          <Icon name="arrowLeft" />
        </button>
        <img class="viewer__img" alt="" decoding="async" data-viewer-img />
        <video class="viewer__video" muted loop playsinline preload="none" data-viewer-video hidden></video>
        <button class="icon-btn viewer__nav viewer__nav--next" type="button" data-viewer-next aria-label="Следующий кадр">
          <Icon name="arrowLeft" />
        </button>
      </div>

      <!-- Чей кадр: имя + место слева, звезда справа — ровно строка
           vcard__top/scard__top из каталога. Весь блок — ссылка на карточку. -->
      <a class="viewer__owner" href="#" data-viewer-owner>
        <span class="viewer__title">
          <span class="viewer__name" data-viewer-name></span>
          <span class="viewer__meta" data-viewer-meta></span>
        </span>
        <span class="viewer__rate" data-viewer-rate hidden></span>
      </a>
    </div>
  )}
</div>

<style>
  /* --board-cols — число колонок на брейкпоинте; его же читает скрипт,
     чтобы переложить плитки. Зазор и поле подписи — общие ручки доски
     (--pin-gap, --cap-pad в global.css), своих чисел тут нет. */
  .masonry {
    --board-cols: 2;
    display: grid;
    grid-template-columns: repeat(var(--board-cols), minmax(0, 1fr));
    gap: var(--pin-gap);
    align-items: start;
  }

  .masonry__col {
    display: flex;
    flex-direction: column;
    gap: var(--pin-gap);
    min-width: 0;
  }

  /* Затемнение под подписи тут лишнее: подпись живёт под кадром, а не на
     нём, и градиент только гасит низ фотографии. */
  .masonry :global(.veil) { display: none; }

  /* ВЕТКА-ПРЕВЬЮ: подписи под кадрами (.cap с названием площадки) сняты —
     доска идёт чистым потоком фотографий, как в Pinterest. Вместе с ними
     ушла и высота подписи в раскладке (CAPTION_H в lib/gallery). */

  /* Кнопка «Показать все» — по центру под колонками, отбивка как у секции */
  .masonry__more {
    display: flex;
    justify-content: center;
    padding-top: var(--s-5);
  }

  /* ============ ПРОСМОТР НА ВЕСЬ ЭКРАН ============
     Закрытый невидим и не ловит клики (visibility), открытый проявляется —
     только opacity, моушн-бюджет телефона. Колонка: строка с крестиком,
     сцена с кадром, подпись на бумаге. Фон — бумага секции (--bg):
     в тёмной теме темнеет сама. */
  .viewer {
    position: fixed;
    inset: 0;
    z-index: var(--z-overlay);
    display: flex;
    flex-direction: column;
    padding-bottom: var(--safe-b);
    background: var(--bg);
    color: var(--fg);
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--dur-fast) var(--ease-out),
                visibility 0s linear var(--dur-fast);
  }

  .viewer.is-open {
    opacity: 1;
    visibility: visible;
    transition-delay: 0s;
  }

  .viewer__bar {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    padding: var(--s-3) var(--s-4);
  }

  /* Сцена забирает всё между строкой и подписью. flex-basis 0, а не auto:
     проценты высоты у кадра внутри иначе не резолвятся (см. CLAUDE.md,
     «циклическая процентная высота во flex»). */
  .viewer__stage {
    position: relative;
    flex: 1 1 0;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Кадр — в своей пропорции, целиком, ничего не кроится: ограничен и
     шириной, и высотой сцены, масштабируется по меньшей. */
  .viewer__img,
  .viewer__video {
    display: block;
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    background: var(--surface-dim);
    -webkit-user-drag: none;
    user-select: none;
  }

  /* display выше перебивает браузерное [hidden] — возвращаем его явно:
     в сцене всегда виден ровно один из двух, кадр или ролик */
  .viewer__img[hidden],
  .viewer__video[hidden] { display: none; }

  /* Стрелки — только там, где есть мышь; на тач листают свайпом.
     Подложка бумаги: кнопка стоит рядом с кадром на поле сцены, а не на
     фотографии (иконка без тени на снимке бы тонула). */
  .viewer__nav {
    display: none;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: var(--bg);
  }

  .viewer__nav:disabled { visibility: hidden; }
  .viewer__nav--prev { left: var(--s-4); }
  .viewer__nav--next { right: var(--s-4); }
  /* одна стрелка на обе стороны: правая — зеркало левой. svg рисует Icon,
     до него достаём :global — селектор уникален, схлопывать его не с чем */
  .viewer__nav--next :global(svg) { transform: scaleX(-1); }

  /* Подпись — та же строка, что у карточки каталога (vcard__top): имя и
     место слева одной группой, рейтинг справа по первой строке имени. */
  .viewer__owner {
    flex: none;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--s-3);
    padding: var(--s-3) var(--s-4) var(--s-4);
    color: inherit;
    text-decoration: none;
  }

  .viewer__title { min-width: 0; }

  .viewer__name {
    display: block;
    font-size: var(--fs-body);
    font-weight: var(--w-head);
    line-height: 1.2;
  }

  .viewer__meta {
    display: block;
    font-size: var(--fs-caption);
    line-height: 1.3;
  }

  .viewer__rate {
    flex-shrink: 0;
    padding-top: 0.15em;
    font-size: var(--fs-caption);
    font-weight: var(--w-medium);
  }

  @media (min-width: 640px) {
    .masonry { --board-cols: 3; }
    .viewer__name { font-size: var(--fs-h3); line-height: 1.15; }
    .viewer__meta { font-size: var(--fs-small); }
    .viewer__rate { font-size: var(--fs-small); padding-top: 0.2em; }
  }

  @media (min-width: 1024px) {
    .masonry { --board-cols: 4; }

    /* На широком экране подпись не растягивается на всю ширину окна —
       узкая колонка по центру под кадром, как у шторки (--sheet-max-w). */
    .viewer__owner {
      width: min(100%, var(--sheet-max-w));
      margin-inline: auto;
    }
  }

  @media (min-width: 1024px) and (pointer: fine) {
    .viewer__nav { display: inline-flex; }
  }

  @media (min-width: 1440px) {
    .masonry { --board-cols: 5; }
  }
</style>

<script>
  // Перекладка под число колонок с экрана. Высота плитки известна из
  // data-h (пропорция + подпись, в долях ширины колонки) — картинки ждать
  // не нужно, раскладка считается до их загрузки. Колонку клонируем
  // с существующей, чтобы сохранить scoped-атрибут стилей Astro.
  // Скрытый хвост (limit) в раскладке не участвует, пока его не раскрыли:
  // по кнопке плитки получают видимость и перекладываются вместе со всеми.
  import { bindViewer } from '../lib/viewer';

  document.querySelectorAll<HTMLElement>('[data-masonry-host]').forEach((host) => {
    const board = host.querySelector<HTMLElement>('[data-masonry]');
    const proto = board?.firstElementChild as HTMLElement | null;
    if (!board || !proto) return;

    const pins = Array.from(host.querySelectorAll<HTMLElement>('.pin')).sort(
      (a, b) => Number(a.dataset.i) - Number(b.dataset.i)
    );

    let current = board.children.length;

    const relayout = (force = false) => {
      const count = parseInt(getComputedStyle(board).getPropertyValue('--board-cols'), 10) || 2;
      if (!force && count === current) return;
      current = count;

      const cols = Array.from({ length: count }, () => proto.cloneNode(false) as HTMLElement);
      const tall = new Array<number>(count).fill(0);

      for (const pin of pins) {
        if (pin.hidden) continue;
        let k = 0;
        for (let j = 1; j < count; j++) if (tall[j] < tall[k]) k = j;
        cols[k].append(pin);
        tall[k] += parseFloat(pin.dataset.h || '1');
      }

      board.replaceChildren(...cols);
    };

    relayout();
    // выходит сразу, если число колонок не поменялось — ресайз дешёвый
    window.addEventListener('resize', () => relayout());

    // ============ ПОКАЗАТЬ ВСЕ ============
    const rest = host.querySelector<HTMLElement>('[data-masonry-rest]');
    const reveal = host.querySelector<HTMLElement>('[data-masonry-reveal]');

    reveal?.addEventListener('click', () => {
      pins.forEach((pin) => { pin.hidden = false; });
      relayout(true);
      rest?.remove();
      reveal.closest('.masonry__more')?.remove();
    });

    // ============ ПРОСМОТР НА ВЕСЬ ЭКРАН ============
    const viewer = host.querySelector<HTMLElement>('[data-viewer]');
    if (viewer) bindViewer(host, viewer);
  });
</script>
