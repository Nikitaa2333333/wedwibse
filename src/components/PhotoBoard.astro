---
// ДОСКА КАДРОВ (главная) — поток фотографий всего каталога. Сама раскладка
// (колонки-масонри, плитки, статьи в потоке) живёт в PhotoMasonry: тот же
// компонент показывает галерею карточки подрядчика, чтобы кадры на главной
// и в визитке выглядели одинаково. Здесь остаётся то, что есть только
// у главной, — источник плиток.
//
// Входы в разделы («Площадки», «Подрядчики», направления) доске больше
// не принадлежат: они переехали в EntryRail — цветной ряд над доской.
// Раньше это были две фото-плашки первой строкой доски, и вход в раздел
// приходилось искать среди кадров, которыми доска и заполнена.
import PhotoMasonry from './PhotoMasonry.astro';
import { collectTiles } from '../lib/gallery';
import { IMG_WIDTHS } from '../lib/images';

const TILE_SIZES =
  '(min-width: 1440px) 19vw, (min-width: 1024px) 24vw, (min-width: 640px) 32vw, 48vw';
---

<section class="board" aria-label="Фотографии площадок каталога">
  <PhotoMasonry tiles={collectTiles()} sizes={TILE_SIZES} widths={IMG_WIDTHS.tile} />
</section>

<style>
  .board {
    background: var(--bg);
    /* Сверху ноль: отбивку от заголовка даёт ряд входов над доской,
       плитки начинаются сразу под ним. */
    padding-block: 0 var(--section-gap);
    display: flex;
    flex-direction: column;
    gap: var(--pin-gap);
    /* Боковых полей нет: крайние кадры идут в край экрана. Зазор доски
       и поле подписи — общие ручки проекта (--pin-gap, --cap-pad
       в global.css), тут они только используются. */
  }
</style>
