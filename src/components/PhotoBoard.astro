---
// ДОСКА КАДРОВ (главная) — масонри как в Pinterest: колонки одной ширины,
// каждая плитка в своей настоящей пропорции, следующая плитка ложится
// в самую короткую колонку (layoutColumns в lib/gallery.ts).
//
// Доска — один непрерывный поток: колонки идут вниз и заканчиваются
// на разной высоте, как лента. Ни полос во всю ширину, ни растянутых
// «дотянутых» кадров: и то и другое ломает пропорцию снимка ради
// ровной линии. Кадры в доске только вертикальные (см. lib/gallery.ts).
//
// Сервер раскладывает под телефон — две колонки: это основной сценарий,
// и там доска стоит без единой строки JS. На широком экране колонок 3–5:
// скрипт ниже перекладывает те же плитки тем же жадным алгоритмом —
// узлы переезжают, ничего не рисуется заново, слушатели PhotoRail живы.
//
// Плитка с несколькими кадрами получает точки-индикаторы и листание
// свайпом — тот же PhotoRail, что в карточке каталога. Пропорция кадра
// приходит через --card-ratio: её читает .prail внутри рельса.
//
// Раз в несколько плиток в потоке попадается статья — типографическая
// плашка (.theme-dark) той же пропорции, что кадры вокруг. Блог человек
// встречает, пока листает фотографии, а не идёт за ним отдельно.
//
// ПЕРКИ (площадки/специалисты — входы в разделы) вписаны прямо в поток
// доски — две первые плитки, той же ширины и пропорции, что и карточка
// статьи (--card-ratio 2:3): обычная колонка потока, не полоса и не
// отдельная строка. Выделяет их только стиль (фото/бумага), не размер.
import PhotoRail from './PhotoRail.astro';
import { collectTiles, layoutColumns, type Tile } from '../lib/gallery';

interface Perk {
  kind: 'photo' | 'light';
  name: string;
  tag: string;
  imgs: string[];
  alt: string;
  href: string;
  words?: string[];
}

interface Props {
  perks?: Perk[];
}

const { perks = [] } = Astro.props;

// Та же пропорция, что у карточки статьи, — перк встаёт в ритм доски
// как ещё один текстовый пин, не выламывается шириной или высотой.
const PERK_RATIO = 2 / 3;

const perkTiles: Tile[] = perks.map((perk) => ({
  ...perk,
  kind: 'perk' as const,
  variant: perk.kind,
  ratio: `${PERK_RATIO} / 1`,
  index: 0,
  height: 1 / PERK_RATIO,
}));

const columns = layoutColumns(
  [...perkTiles, ...collectTiles()].map((tile, index) => ({ ...tile, index })),
  2
);

const TILE_SIZES =
  '(min-width: 1440px) 19vw, (min-width: 1024px) 24vw, (min-width: 640px) 32vw, 48vw';
---

<!-- Без data-reveal и без параллакса намеренно: доска листается как
     обычная страница, все кадры на месте сразу, ничего не проявляется. -->
<section class="board" aria-label="Фотографии площадок каталога">
  <div class="board__cols" data-board>
    {
      columns.map((col) => (
        <div class="board__col">
          {col.map((tile) => (
            <article
              class:list={['pin', (tile.kind === 'article' || tile.kind === 'perk') && `pin--${tile.kind}`]}
              style={`--card-ratio:${tile.ratio};`}
              data-i={tile.index}
              data-h={tile.height.toFixed(3)}
            >
              {tile.kind === 'article' ? (
                <a class="note theme-dark" href={tile.href}>
                  <span class="note__rubric t-caption">{tile.rubric}</span>
                  <h3 class="note__title">{tile.title}</h3>
                  <span class="pill pill--sm note__cta">Читать</span>
                </a>
              ) : tile.kind === 'perk' ? (
                tile.variant === 'photo' ? (
                  <a class="perk perk--photo" href={tile.href}>
                    <PhotoRail photos={tile.imgs} alt={tile.alt} sizes={TILE_SIZES} widths={[360, 560, 800]} />
                    <span class="perk__overlay">
                      <span class="perk__name">{tile.name}</span>
                      <span class="perk__tag" set:html={tile.tag} />
                    </span>
                  </a>
                ) : (
                  <a class="perk perk--light" href={tile.href}>
                    <PhotoRail photos={tile.imgs} alt={tile.alt} sizes={TILE_SIZES} widths={[360, 560, 800]} />
                    <span class="perk__scrim" aria-hidden="true"></span>

                    <span class="perk__body">
                      <span class="perk__top">
                        <span class="perk__tag">{tile.tag}</span>
                        <span class="perk__arrow">↗</span>
                      </span>
                      <span class="perk__name">{tile.name}</span>
                    </span>

                    <span class="perk__list" aria-hidden="true">
                      <span class="perk__list-track">
                        {(tile.words ?? []).concat(tile.words ?? []).map((word: string) => (
                          <span class="perk__word">{word}</span>
                        ))}
                      </span>
                    </span>
                  </a>
                )
              ) : (
                <>
                  <PhotoRail
                    photos={tile.photos}
                    alt={tile.alt}
                    href={tile.href}
                    sizes={TILE_SIZES}
                    widths={[360, 560, 800]}
                  />

                  {tile.caption && (
                    <a class="cap t-caption" href={tile.href}>
                      {tile.caption}
                    </a>
                  )}
                </>
              )}
            </article>
          ))}
        </div>
      ))
    }
  </div>
</section>

<style>
  .board {
    background: var(--bg);
    padding-block: var(--s-6) var(--section-gap);
    display: flex;
    flex-direction: column;
    gap: var(--pin-gap);
    /* --pin-gap — единственная ручка зазора доски: на телефоне волосок,
       как стык карточек каталога, на ПК полный шов. Боковых полей нет:
       крайние кадры идут в край экрана. */
    --pin-gap: clamp(6px, 0.9vw, 12px);
    /* --cap-pad — поле подписи от краёв кадра. Своя ручка, а не --catalog-pad:
       тот от 640px обнуляется (карточки каталога там не в край), а доска
       в край на любой ширине — и подпись впритык к краю читается плохо. */
    --cap-pad: var(--s-3);
  }

  /* Затемнение под подписи тут лишнее: подпись живёт под кадром, а не на
     нём, и градиент только гасит низ фотографии. */
  .board :global(.veil) { display: none; }

  /* ============ ПЕРКИ: обычная плитка потока, как у статьи ============
     Вход в «Площадки»/«Специалисты» — такая же колонка ленты, как кадр
     или заметка блога (--card-ratio 2:3), просто со своим стилем вместо
     фото или инверсии. Ширину и высоту у соседних плиток не отбирает. */
  .pin--perk { container-type: inline-size; }

  .perk {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    aspect-ratio: var(--card-ratio);
    padding: var(--s-4);
    background: var(--surface);
    color: var(--ink);
    text-decoration: none;
    overflow: hidden;
  }

  /* Плашке с фото нужен свой veil обратно: текст лежит прямо на кадре */
  .perk--photo :global(.veil) { display: block; }

  .perk__top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-3);
  }

  .perk__tag {
    font-size: var(--fs-small);
    font-weight: var(--w-medium);
    line-height: 1.35;
  }

  .perk__arrow {
    font-size: var(--fs-body);
    line-height: 1;
  }

  .perk__name {
    font-size: clamp(17px, 11cqi, 28px);
    font-weight: var(--w-head);
    line-height: 1.05;
    letter-spacing: -0.015em;
  }

  /* Фото-плашка: тот же слайдер, что в каталоге (PhotoRail) — кадры
     листаются при наведении и свайпом, с точками-индикаторами. */
  .perk--photo { padding: 0; overflow: hidden; }

  .perk--photo :global(.prail-wrap) {
    position: absolute;
    inset: 0;
  }

  .perk--photo :global(.prail) {
    aspect-ratio: auto;
    height: 100%;
  }

  .perk__overlay {
    position: relative;
    margin-top: auto;
    padding: var(--s-4);
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    color: var(--white);
  }

  /* Светлая плашка: слева статичный текст, справа — колесо категорий
     во всю высоту карточки. */
  .perk--light {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: stretch;
    background: var(--paper);
    color: var(--ink);
  }

  .perk--light :global(.prail-wrap) {
    position: absolute;
    inset: 0 34% 0 0;
  }

  .perk--light :global(.prail) {
    aspect-ratio: auto;
    height: 100%;
    background: var(--paper);
  }

  .perk--light :global(.veil) { display: none; }

  .perk__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      transparent 0%,
      color-mix(in srgb, var(--paper) 55%, transparent) 34%,
      var(--paper) 66%
    );
    pointer-events: none;
  }

  .perk__body {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-width: 0;
    grid-column: 1;
  }

  /* Колесо категорий — крутится непрерывно, обрезается краями карточки */
  .perk__list {
    position: relative;
    grid-column: 2;
    overflow: hidden;
    text-align: right;
    mask-image: linear-gradient(to bottom, transparent 0%, black 38%, black 62%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 38%, black 62%, transparent 100%);
  }

  .perk__list-track {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    animation: perk-scroll 14s linear infinite;
  }

  .perk__word {
    height: 1.15em;
    display: flex;
    align-items: center;
    font-size: clamp(13px, 9cqi, 22px);
    font-weight: var(--w-head);
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  @keyframes perk-scroll {
    from { transform: translateY(0); }
    to { transform: translateY(-50%); }
  }

  @media (hover: hover) {
    .perk { transition: transform var(--dur-fast) var(--ease-out); }
    .perk__arrow { transition: transform var(--dur-fast) var(--ease-out); }
    .perk:hover .perk__arrow { transform: translate(3px, -3px); }
  }

  /* --board-cols — число колонок на брейкпоинте; его же читает скрипт,
     чтобы переложить плитки. */
  .board__cols {
    --board-cols: 2;
    display: grid;
    grid-template-columns: repeat(var(--board-cols), minmax(0, 1fr));
    gap: var(--pin-gap);
    align-items: start;
  }

  .board__col {
    display: flex;
    flex-direction: column;
    gap: var(--pin-gap);
    min-width: 0;
  }

  /* Подпись прижата к своему кадру по вертикали (--s-1 против --pin-gap
     до соседнего) — правило внутреннего и внешнего. По горизонтали, наоборот,
     отступает от краёв кадра (--cap-pad): текст впритык к краю некрасив. */
  .cap {
    display: block;
    padding: var(--s-1) var(--cap-pad) 0;
    color: var(--ink);
    font-weight: var(--w-body);
    text-decoration: none;
  }

  /* СТАТЬЯ В ПОТОКЕ — плашка-инверсия той же пропорции, что кадр рядом.
     Рубрика сверху, заголовок в середине, пилюля «Читать» внизу — три
     уровня одной плитки, как у текстового пина. Цвета из .theme-dark:
     пилюля внутри сама становится белой, руками ничего не красим. */
  .note {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--s-4);
    aspect-ratio: var(--card-ratio);
    padding: var(--s-4);
    background: var(--bg);
    color: var(--fg);
    text-decoration: none;
  }

  .note__rubric { font-weight: var(--w-medium); }

  /* Кегль от ширины колонки, не экрана: колонка на телефоне ~190px
     (→ 19px, пять строк), на ПК ~300px (→ 27px) — заголовок держит плашку,
     а не тонет в ней. Без переносов внутри слова. */
  .note__title {
    font-size: clamp(19px, 9cqi, 30px);
    font-weight: var(--w-head);
    line-height: var(--lh-heading);
    letter-spacing: var(--ls-display);
    hyphens: manual;
  }

  .note__cta { align-self: flex-start; }

  .pin--article { container-type: inline-size; }

  @media (min-width: 1024px) {
    .note { padding: var(--s-5); }
  }

  @media (min-width: 640px) {
    .board__cols { --board-cols: 3; }
  }

  @media (min-width: 1024px) {
    .board__cols { --board-cols: 4; }
  }

  @media (min-width: 1440px) {
    .board__cols { --board-cols: 5; }
  }
</style>

<script>
  // Перекладка под число колонок с экрана. Высота плитки известна из
  // data-h (пропорция + подпись, в долях ширины колонки) — картинки ждать
  // не нужно, раскладка считается до их загрузки. Колонку клонируем
  // с существующей, чтобы сохранить scoped-атрибут стилей Astro.
  document.querySelectorAll<HTMLElement>('[data-board]').forEach((board) => {
    const pins = Array.from(board.querySelectorAll<HTMLElement>('.pin')).sort(
      (a, b) => Number(a.dataset.i) - Number(b.dataset.i)
    );
    const proto = board.firstElementChild as HTMLElement | null;
    if (!proto) return;

    let current = board.children.length;

    const relayout = () => {
      const count = parseInt(getComputedStyle(board).getPropertyValue('--board-cols'), 10) || 2;
      if (count === current) return;
      current = count;

      const cols = Array.from({ length: count }, () => proto.cloneNode(false) as HTMLElement);
      const tall = new Array<number>(count).fill(0);

      for (const pin of pins) {
        let k = 0;
        for (let j = 1; j < count; j++) if (tall[j] < tall[k]) k = j;
        cols[k].append(pin);
        tall[k] += parseFloat(pin.dataset.h || '1');
      }

      board.replaceChildren(...cols);
    };

    relayout();
    // выходит сразу, если число колонок не поменялось — ресайз дешёвый
    window.addEventListener('resize', relayout);
  });
</script>
