---
// ЗАЛЫ КОМПЛЕКСА — секции по одной на зал (блок `halls`, данные venue.halls).
// Одна усадьба, девять площадок: у каждой свои кадры, площадь, посадка и
// тариф по дням недели. Сюда ведут плитки оглавления (HallsIndex) по
// якорю #hall-<id>; общие для всех залов условия (сервисный сбор, меню,
// парковка) здесь не повторяются — они один раз в блоке `terms` ниже.
//
// Структура секции взята с сайта усадьбы, где тариф по дням — главный
// элемент страницы зала: кадры → тип и имя → три числа → таблица тарифа
// → что входит → 1–2 абзаца. Таблица — единственное место, где линии
// между строками разрешены (это структура, а не разделители списка).
import { Image } from 'astro:assets';
import type { VenueHall } from '../data/venues';
import { IMG_WIDTHS, resolveImage } from '../lib/images';

interface Props {
  halls: VenueHall[];
}

const { halls } = Astro.props;
---

<div class="halls">
  {/* НАВИГАЦИЯ ПО ЗАЛАМ (заказчик, 08.10.2026: «человек листает залы — чтобы
      не запутаться, сверху высвечивается навигация»). Липкая полоса пилюль
      под кнопками первого экрана; текущий зал подсвечивает скрипт ниже.
      Ссылки настоящие — без JS это просто оглавление по якорям. */}
  {halls.length > 2 && (
    <nav class="halls__nav" aria-label="Залы">
      <div class="halls__rail">
        {halls.map((hall) => (
          <a class="chip halls__link" href={`#hall-${hall.id}`} data-hall-link={hall.id}>{hall.name}</a>
        ))}
      </div>
    </nav>
  )}
  {halls.map((hall, i) => (
    <section class="hall section" id={`hall-${hall.id}`}>
      <div class="container container--wide">
        <div class="hall__grid">
          {/* Кадр зала на телефоне — во всю ширину экрана и без точек
              (заказчик, 17.09): в полях страницы он читался вставкой, а
              двенадцать точек под ним — полосой прокрутки. Листается
              свайпом как раньше. */}
          {/* Один кадр зала элементом .shot, без слайдера: тот же вид фото,
              что у подрядчика (заказчик, 08.10.2026). Остальные кадры зала
              листаются в первом экране площадки. */}
          <figure class="hall__media shot">
            <Image
              src={resolveImage(hall.photos[0])}
              alt={hall.alt}
              widths={IMG_WIDTHS.card}
              sizes="(min-width: 900px) 42vw, 100vw"
              loading="lazy"
              decoding="async"
            />
          </figure>

          <div class="hall__body">
            <header class="hall__head">
              <h2 class="hall__title">{hall.name}</h2>
            </header>

            {/* Три числа, по которым зал сравнивают с соседями */}
            <dl class="hall__stats">
              <div class="hall__stat">
                <dd class="hall__val">{hall.areaM2}<span class="hall__unit"> м²</span></dd>
                <dt class="hall__lbl t-caption">{hall.areaNote ?? 'площадь зала'}</dt>
              </div>
              <div class="hall__stat">
                <dd class="hall__val">{hall.banquet}</dd>
                <dt class="hall__lbl t-caption">гостей на банкете</dt>
              </div>
              <div class="hall__stat">
                <dd class="hall__val">{hall.buffet}</dd>
                <dt class="hall__lbl t-caption">гостей на фуршете</dt>
              </div>
            </dl>

            <table class="tariff">
              <caption class="tariff__caption t-caption">Аренда зала 10:00–23:00 и минимальный заказ по меню</caption>
              <thead>
                <tr>
                  <th scope="col">День</th>
                  <th scope="col">Аренда</th>
                  <th scope="col">Заказ от</th>
                </tr>
              </thead>
              <tbody>
                {hall.tariff.map((t) => (
                  <tr>
                    <th scope="row">{t.day}</th>
                    <td>{t.rent}</td>
                    <td>{t.deposit}</td>
                  </tr>
                ))}
              </tbody>
            </table>

            <div class="hall__text">
              <p class="hall__included">
              <span class="hall__included-label">В аренду входит: </span>
              {hall.included.join(', ')}
              </p>
              {hall.body.map((p) => <p class="hall__p">{p}</p>)}
            </div>

            <a class="hall__up t-small" href="#zaly">Все залы ↑</a>
          </div>
        </div>
      </div>
    </section>
  ))}
</div>

<style>
  /* ============ НАВИГАЦИЯ ПО ЗАЛАМ ============
     Под фиксированными кнопками первого экрана (--s-4 + 40px + зазор):
     полоса не налезает на «назад» и сердце. Вбок листается сама, ось Y
     закрыта явно — иначе ряд «ездит» пальцем (ловушка из CLAUDE.md). */
  /* Сплошная бумажная шапка от верха экрана: фиксированные кнопки
     первого экрана лежат на ней, пилюли — под ними. Фото больше не
     проглядывает полосой между краем экрана и пилюлями (заказчик, 08.10). */
  .halls__nav {
    position: sticky;
    top: 0;
    z-index: calc(var(--z-nav) - 1);
    background: var(--bg);
    padding-top: calc(var(--s-4) + 40px + var(--s-2) + var(--safe-t));
    padding-bottom: var(--s-2);
  }

  @media (min-width: 1024px) {
    .halls__nav { padding-top: var(--s-2); }
  }

  .halls__rail {
    display: flex;
    gap: var(--s-2);
    padding-inline: var(--gutter);
    overflow-x: auto;
    overflow-y: clip;
    scrollbar-width: none;
  }

  .halls__rail::-webkit-scrollbar { display: none; }

  .halls__link { flex: none; white-space: nowrap; }

  .hall :global(.container) { max-width: none; }

  /* Секции залов идут подряд: между ними обычный ритм секции, а не
     удвоенный (низ верхней + верх нижней) — иначе девять залов
     растягиваются дырами. */
  .hall + .hall { padding-top: 0; }

  /* Якорь встаёт с воздухом сверху, а не в упор к краю экрана */
  .hall { scroll-margin-top: var(--s-6); }

  .hall__grid {
    display: grid;
    gap: var(--s-6);
  }

  /* Кадр в край экрана: вычитаем поле контейнера с обеих сторон. На ПК
     (сетка ниже) поле возвращается — там кадр стоит колонкой. */
  /* кадр в полях страницы (.shot) — как у подрядчика */

  .hall__body {
    display: flex;
    flex-direction: column;
    gap: var(--s-6);
    min-width: 0;
  }

  .hall__kicker {
    display: flex;
    gap: var(--s-2);
    font-weight: var(--w-medium);
    margin-bottom: var(--s-3);
  }


  .hall__title {
    font-size: var(--fs-h1);
    font-weight: var(--w-head-lg);
    line-height: var(--lh-display);
    letter-spacing: var(--ls-display);
    max-width: var(--measure-head);
  }

  /* Числа — три колонки в любую ширину; у чисел короткие подписи,
     и они читаются рядом даже на 360px */
  .hall__stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-4);
    margin: 0;
  }

  .hall__stat { min-width: 0; }

  .hall__val {
    font-size: var(--fs-h2);
    font-weight: var(--w-head);
    line-height: 1;
    letter-spacing: var(--ls-display);
    font-variant-numeric: tabular-nums;
    margin: 0 0 var(--s-1);
  }

  .hall__unit { font-size: var(--fs-small); }

  .hall__lbl { font-weight: var(--w-medium); line-height: var(--lh-caption); }

  /* ТАРИФ. Таблица во всю ширину колонки, линии между строками —
     структура таблицы (единственное разрешённое место для линий). */
  .tariff {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    font-variant-numeric: tabular-nums;
  }

  .tariff__caption {
    text-align: left;
    font-weight: var(--w-medium);
    padding-bottom: var(--s-3);
  }

  .tariff th,
  .tariff td {
    text-align: left;
    padding: var(--s-3) var(--s-3) var(--s-3) 0;
    border-bottom: 1px solid var(--line);
    vertical-align: baseline;
  }

  .tariff thead th {
    font-size: var(--fs-caption);
    font-weight: var(--w-medium);
  }

  .tariff tbody th { font-weight: var(--w-body); }

  .tariff td { white-space: nowrap; }

  .hall__included {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    max-width: var(--measure-text);
  }

  .hall__included-label { font-weight: var(--w-medium); }

  .hall__p {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    max-width: var(--measure-text);
  }

  /* «В аренду входит» и описание — одна группа: абзацный зазор, без дыры */
  .hall__text > * + * { margin-top: var(--s-4); }

  .hall__up {
    align-self: flex-start;
    color: inherit;
    font-weight: var(--w-medium);
  }

  @media (min-width: 900px) {
    /* Кадр слева и липкий: секция зала длиннее окна 4:5, и пока читают
       тариф, зал остаётся перед глазами. */
    .hall__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--s-8);
      align-items: start;
    }

    .hall__media {
      position: sticky;
      top: var(--s-6);
    }

    .hall__up { display: none; }
  }
</style>

<script>
  // Текущий зал в полосе навигации: тот, чья секция пересекает верхнюю
  // треть экрана. Активная пилюля доезжает в видимую часть ряда сама.
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('[data-hall-link]')].map((a) => [`hall-${a.dataset.hallLink}`, a]),
  );
  if (links.size) {
    const rail = document.querySelector<HTMLElement>('.halls__rail');
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          links.forEach((a) => a.classList.remove('is-active'));
          const a = links.get(e.target.id);
          if (!a) continue;
          a.classList.add('is-active');
          if (rail) rail.scrollTo({ left: a.offsetLeft - rail.clientWidth / 2 + a.clientWidth / 2, behavior: 'smooth' });
        }
      },
      { rootMargin: '-30% 0px -60% 0px' },
    );
    links.forEach((_, id) => {
      const s = document.getElementById(id);
      if (s) io.observe(s);
    });
  }
</script>
