---
// ОТЗЫВЫ — один блок на карточку площадки и карточку подрядчика.
// Вид у отзыва один и тот же независимо от того, о ком он: шапка
// (кружок автора, имя, дата, оценка) и текст под ней. Разметка выросла
// из блока на карточке подрядчика; вынесена в компонент сразу, чтобы
// на второй карточке не завелась вторая верстка того же — так уже
// разошёлся первый экран, и сводить обратно пришлось отдельным заходом.
//
// Шапка блока показывает агрегат: крупная оценка, под ней — из скольких
// оценок она сложилась и сколько отзывов с текстом. Это разные числа,
// и подменять одно другим нельзя: оценку ставят молча гораздо чаще,
// чем пишут текст.
//
// Линий между отзывами нет (правило проекта): пункт от пункта отделяет
// подложка карточки, а не полоска.
import Avatar from './Avatar.astro';
import Icon from './Icon.astro';
import { plural } from '../lib/plural';
import { showcaseReviews } from '../data/venue-reviews';

interface Review {
  author: string;
  date: string;
  rating: number;
  text: string;
  /** портрет автора, если он есть; нет — Avatar сам поставит инициалы */
  photo?: string;
}

interface Props {
  reviews: Review[];
  /** средняя оценка: не считаем её из показанных — показаны не все */
  rating?: number | null;
  /** сколько всего оценок (с текстом и без) */
  ratings?: number | null;
  /** сколько всего отзывов с текстом */
  total?: number | null;
  id?: string;
  title?: string;
}

const { reviews, rating = null, ratings = null, total = null, id = 'otzyvy', title = 'Отзывы' } = Astro.props;

// ЧТО ИМЕННО ПОКАЗЫВАЕМ — решает одно правило на весь проект
// (showcaseReviews в data/venue-reviews): последние десять с оценкой
// 4 и выше. Фильтруем здесь, а не на каждой странице: блок общий для
// площадки и подрядчика, и страница, которая забыла бы фильтр, молча
// выставила бы на витрину единицы.
const items = showcaseReviews(reviews);

const shown = items.length;

// ПОРОГ СВОРАЧИВАНИЯ. Пока отзывы шли столбиком, сворачивать имело смысл
// только простыни (900 знаков): средний отзыв никому не мешал. В ленте
// вбок карточки стоят в один ряд и тянутся до высоты самой длинной —
// один разговорчивый гость задавал рост всему ряду. Порог опущен до
// шести строк карточки (~260 знаков): обрезано ровно то, у чего есть
// кнопка «Читать целиком», без обрезков без кнопки.
const LONG = 260;
---

<section class="reviews section section--tight" id={id}>
  <div class="container container--wide">
    <header class="reviews__head">
      <h2 class="t-h2">{title}</h2>

      {
        rating !== null && (
          <p class="reviews__agg">
            <span class="reviews__score">
              <Icon name="star" />
              {rating.toFixed(1).replace('.', ',')}
            </span>
            <span class="reviews__count t-small">
              {ratings !== null && <>{ratings}&nbsp;{plural(ratings, ['оценка', 'оценки', 'оценок'])}</>}
              {ratings !== null && total !== null && ' · '}
              {total !== null && <>{total}&nbsp;{plural(total, ['отзыв', 'отзыва', 'отзывов'])}</>}
            </span>
          </p>
        )
      }
    </header>

    <!-- ЛЕНТА ВБОК, а не столбик (заказчик, 21.09.2026): десять отзывов
         в столбик растягивали карточку на несколько экранов, и всё, что
         идёт после них («Похожие»), уезжало за горизонт. Вбок — тот же
         жест, которым человек уже листал кадры выше по странице. -->
    <div class="reviews__list">
      {
        items.map((r) => (
          <article class="review">
            <header class="review__head">
              <Avatar src={r.photo} name={r.author} size={44} />
              <div class="review__who">
                <p class="review__author">{r.author}</p>
                <p class="review__date t-caption">{r.date}</p>
              </div>
              <p class="review__rate" aria-label={`Оценка ${r.rating} из 5`}>
                {'★'.repeat(r.rating)}{'☆'.repeat(5 - r.rating)}
              </p>
            </header>
            {/* Длинный отзыв свёрнут до нескольких строк, как на самих Картах:
                простыня на 5 000 знаков посреди карточки перебивает соседей.
                Порог — по длине текста на сборке; кнопка раскрывает, без JS
                текст виден целиком (clamp снимается классом, не разметкой). */}
            <p class:list={['review__text', { 'is-clamped': r.text.length > LONG }]}>{r.text}</p>
            {r.text.length > LONG && (
              <button class="review__more pill pill--sm" type="button" data-review-more aria-expanded="false">Читать целиком</button>
            )}
          </article>
        ))
      }
    </div>

    {
      total !== null && total > shown && (
        <p class="reviews__more t-small">
          Показаны {shown} из {total} {plural(total, ['отзыва', 'отзывов', 'отзывов'])}
        </p>
      )
    }
  </div>
</section>

<style>
  .reviews :global(.container) { max-width: none; }

  .reviews__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-4);
  }

  /* Агрегат прижат к правому краю заголовка: это факт о площадке,
     а не второй заголовок, и в столбик под h2 он читался бы как
     ещё одна строка названия. */
  .reviews__agg {
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
  }

  .reviews__score {
    display: inline-flex;
    align-items: baseline;
    gap: var(--s-1);
    font-size: var(--fs-h3);
    font-weight: var(--w-head);
    letter-spacing: var(--ls-display);
  }

  /* Звезда садится на базовую линию цифры: у inline-flex по умолчанию
     она бы висела серединой строки и уезжала вверх. */
  .reviews__score :global(svg) {
    width: 0.72em;
    height: 0.72em;
    align-self: center;
  }

  .reviews__count { opacity: 0.6; }

  /* Лента отзывов: ряд карточек, который крутится вбок. Идёт от края до
     края экрана — поля контейнера снимаются отрицательным полем и тут же
     возвращаются внутренним отступом, чтобы первая карточка стояла по
     сетке текста, а последняя докручивалась до правого поля.
     touch-action не ставим (см. DESIGN.md, «Жест на лентах»): pan-x
     стоил бы вертикального скролла страницы с самой ленты. */
  .reviews__list {
    display: flex;
    gap: var(--s-3);
    margin-top: var(--s-5);
    margin-inline: calc(-1 * var(--gutter));
    padding-inline: var(--gutter);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    scroll-padding-inline-start: var(--gutter);
    scrollbar-width: none;
  }

  .reviews__list::-webkit-scrollbar { display: none; }

  /* Отзыв — карточка на подложке шириной почти в экран телефона: узкая
     колонка текста и подсказка листания — кромка следующей карточки.
     Мера строки здесь не токеном: ширину задаёт сам модуль. */
  .review {
    flex: none;
    width: min(84vw, 420px);
    scroll-snap-align: start;
    padding: var(--s-5);
    background: var(--surface-dim);
    border-radius: var(--radius-card);
  }

  .review__head {
    display: flex;
    align-items: center;
    gap: var(--s-3);
  }

  /* Кружок автора светлее подложки карточки, иначе он на ней теряется. */
  .review :global(.avatar) { background: var(--bg); }

  .review__who { flex: 1; min-width: 0; }

  .review__author { font-weight: var(--w-medium); }

  .review__date { opacity: 0.6; }

  /* Звёзды строкой символов, а не иконками: пять иконок в ряд на карточке
     отзыва весят больше, чем сам факт оценки. */
  .review__rate {
    flex: none;
    font-size: var(--fs-small);
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  /* Текст отзыва — чужой и как попало набранный: «новое,масштабное,впечатляющее»
     без пробелов — одно слово на 40 знаков, оно не переносится, вылезает
     за колонку и на телефоне раздвигает всю страницу вбок (Гребнево, 17.09).
     Переносим где угодно: лучше рваное слово, чем горизонтальный скролл. */
  .review__text {
    margin-top: var(--s-4);
    overflow-wrap: anywhere;
  }

  /* свёрнутый отзыв: шесть строк, дальше обрез многоточием */
  .review__text.is-clamped {
    display: -webkit-box;
    -webkit-line-clamp: 6;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .review__more { margin-top: var(--s-3); }

  .reviews__more {
    margin-top: var(--s-4);
    opacity: 0.6;
  }
</style>

<script>
  // «Читать целиком»: снимает обрез с текста своего отзыва и прячется —
  // обратно сворачивать незачем, человек уже прочитал
  document.querySelectorAll<HTMLButtonElement>('[data-review-more]').forEach((btn) => {
    btn.addEventListener('click', () => {
      btn.previousElementSibling?.classList.remove('is-clamped');
      btn.setAttribute('aria-expanded', 'true');
      btn.hidden = true;
    });
  });
</script>
