---
// Финальный экран: призыв + контакты площадки + как добраться.
// Форма-анкета появится здесь же — пока ведём на телефон и почту.
import { Image } from 'astro:assets';
import type { Venue } from '../data/venues';
import { resolveImage } from '../lib/images';

interface Props {
  venue: Venue;
}

const { venue } = Astro.props;
const { contacts } = venue;
---

<section class="cta section theme-dark" id="zayavka">
  <div class="container">
    <div class="cta__top">
      <div class="cta__body">
        <h2 class="cta__title">Забронировать дату в&nbsp;{venue.name}</h2>
        <p class="cta__lead t-lead">
          Напишите или позвоните — менеджер площадки подтвердит свободную дату, соберёт смету
          и&nbsp;покажет зал вживую.
        </p>

        <div class="cta__actions">
          <a class="pill pill--lg" href={contacts.phoneHref}>{contacts.phone}</a>
          <a class="cta__mail" href={`mailto:${contacts.email}`}>{contacts.email}</a>
        </div>

        <dl class="rows cta__rows">
          <div class="rows__row">
            <dt class="rows__label">Адрес</dt>
            <dd class="rows__value">{contacts.address}</dd>
          </div>
          <div class="rows__row">
            <dt class="rows__label">Рядом</dt>
            <dd class="rows__value">{contacts.addressNote}</dd>
          </div>
          <div class="rows__row">
            <dt class="rows__label">Режим работы</dt>
            <dd class="rows__value">{contacts.hours}</dd>
          </div>
        </dl>
      </div>

      <figure class="cta__shot media">
        <Image
          src={resolveImage(venue.hero.portrait)}
          alt={venue.hero.portraitAlt}
          widths={[480, 800, 1200, 1600]}
          sizes="(min-width: 1024px) 50vw, 100vw"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>

    <div class="cta__bottom">
      <div>
        <h3 class="cta__sub">Как добраться</h3>
        <dl class="rows">
          {
            contacts.routes.map((row) => (
              <div class="rows__row">
                <dt class="rows__label">{row.label}</dt>
                <dd class="rows__value">{row.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div>
        <h3 class="cta__sub">Ссылки</h3>
        <ul class="list cta__links">
          {
            contacts.links.map((link) => (
              <li>
                <a href={link.href} rel="noopener" target="_blank">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  /* секция с кадром — полноширинная, потолок ширины снят */
  .cta :global(.container) { max-width: none; }

  .cta__top {
    display: grid;
    gap: var(--section-gap-tight) var(--s-8);
    margin-bottom: var(--section-gap-tight);
  }

  .cta__title {
    font-size: var(--fs-h1);
    font-weight: var(--w-light);
    line-height: var(--lh-display);
    letter-spacing: var(--ls-display);
    max-width: var(--measure-head);
    margin-bottom: var(--s-5);
  }

  .cta__lead { margin-bottom: var(--s-6); }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-5);
    margin-bottom: var(--s-7);
  }

  .cta__mail {
    font-weight: var(--w-medium);
    text-decoration: none;
  }

  /* на мобилке кадр тоже уходит в край страницы */
  .cta__shot {
    aspect-ratio: 4 / 5;
    margin-inline: calc(var(--gutter) * -1);
  }

  .cta__bottom {
    display: grid;
    gap: var(--s-7) var(--s-8);
  }

  .cta__sub {
    font-size: var(--fs-h3);
    font-weight: var(--w-light);
    margin-bottom: var(--s-4);
  }

  .cta__links a { text-decoration: none; }

  @media (hover: hover) {
    .cta__mail:hover,
    .cta__links a:hover { text-decoration: underline; }
  }

  @media (min-width: 900px) {
    .cta__top { grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr); }
    .cta__bottom { grid-template-columns: repeat(2, minmax(0, 1fr)); }

    .cta__shot {
      height: 100%;
      aspect-ratio: auto;
      margin-left: 0;
      /* правым краем кадр выходит в край экрана */
      margin-right: calc(var(--gutter) * -1);
    }
  }
</style>
