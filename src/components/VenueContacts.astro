---
// Финальный экран карточки: призыв, две кнопки и как добраться.
//
// КОНТАКТОВ ПАРТНЁРА НА СТРАНИЦЕ НЕТ (решение заказчика 14.09.2026).
// Ни телефона, ни почты, ни ссылок на сайт и соцсети: мы агрегатор, и
// заявка должна идти через нас, а не мимо. Страница с чужим номером
// телефона — это витрина, с которой уходят, не оставив следа; по такой
// карточке нельзя ни посчитать обращения, ни взять за них деньги.
// Данные остаются в `venue.contacts` (они нужны нам самим — менеджеру,
// который повезёт заявку площадке), просто не рендерятся.
//
// ОСТАЛИСЬ ДВЕ КНОПКИ: «В избранное» и «Заказать». Первая — та же
// механика, что у сердца поверх первого кадра (lib/save.ts, data-save),
// только здесь она подписана словами: человек дочитал карточку до конца,
// и сердечко в шапке уже давно за экраном. Вторая пока ведёт на заглушку
// формы — сама форма-анкета появится на этом же месте.
//
// Адрес и «как добраться» — НЕ контакты, а сведения о месте: по ним
// выбирают площадку (сколько ехать от МКАД, есть ли парковка), они же
// работают на поиск. Остаются.
import { Image } from 'astro:assets';
import type { Venue } from '../data/venues';
import { resolveImage, IMG_WIDTHS } from '../lib/images';
import { venueFavorite } from '../lib/favorite-snapshot';

interface Props {
  venue: Venue;
}

const { venue } = Astro.props;
const { contacts } = venue;

// Снимок карточки для «Избранного» — ТОТ ЖЕ, что у сердца в первом экране
// (lib/favorite-snapshot): две кнопки на одной странице обязаны класть
// в хранилище одну запись, иначе площадка задвоится в разделе.
const favorite = await venueFavorite(venue);
const saveData = JSON.stringify(favorite);
---

<section class="cta section theme-dark" id="zayavka">
  <div class="container">
    <div class="cta__top">
      <div class="cta__body">
        <h2 class="cta__title">Забронировать дату в&nbsp;{venue.name}</h2>
        <p class="cta__lead t-lead">
          Напишите или позвоните — менеджер площадки подтвердит свободную дату, соберёт смету
          и&nbsp;покажет зал вживую.
        </p>

        <div class="cta__actions">
          {/* ЗАГЛУШКА: форма-анкета встанет на это же место (фаза дизайна).
              Пока кнопка никуда не ведёт — телефон партнёра с карточки снят
              намеренно, подставлять его обратно нельзя. */}
          <a class="pill pill--lg" href="#">Заказать</a>
          {/* Та же кнопка «в избранное», что сердце в первом экране:
              одна привязка на проект (bindSaveButtons по data-save),
              подпись меняется сама по aria-pressed. */}
          <button class="pill pill--lg cta__save" type="button" data-save={saveData} aria-pressed="false">
            <span class="cta__save-off">В избранное</span>
            <span class="cta__save-on">В избранном</span>
          </button>
        </div>

        <dl class="rows cta__rows">
          <div class="rows__row">
            <dt class="rows__label">Адрес</dt>
            <dd class="rows__value">{contacts.address}</dd>
          </div>
          <div class="rows__row">
            <dt class="rows__label">Рядом</dt>
            <dd class="rows__value">{contacts.addressNote}</dd>
          </div>
        </dl>
      </div>

      <figure class="cta__shot media">
        <Image
          src={resolveImage(venue.hero.portrait)}
          alt={venue.hero.portraitAlt}
          widths={IMG_WIDTHS.hero}
          sizes="(min-width: 1024px) 50vw, 100vw"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>

    <div class="cta__bottom">
      <div>
        <h3 class="cta__sub">Как добраться</h3>
        <dl class="rows">
          {
            contacts.routes.map((row) => (
              <div class="rows__row">
                <dt class="rows__label">{row.label}</dt>
                <dd class="rows__value">{row.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>

    </div>
  </div>
</section>

<style>
  /* секция с кадром — полноширинная, потолок ширины снят */
  .cta :global(.container) { max-width: none; }

  .cta__top {
    display: grid;
    gap: var(--section-gap-tight) var(--s-8);
    margin-bottom: var(--section-gap-tight);
  }

  .cta__title {
    font-size: var(--fs-h1);
    font-weight: var(--w-head-lg);
    line-height: var(--lh-display);
    letter-spacing: var(--ls-display);
    max-width: var(--measure-head);
    margin-bottom: var(--s-5);
  }

  .cta__lead { margin-bottom: var(--s-6); }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-5);
    margin-bottom: var(--s-7);
  }

  /* Подпись кнопки меняется по состоянию, а не иконка: слово «В избранном»
     на бумаге читается без догадок, в отличие от закрашенного сердца. */
  .cta__save-on { display: none; }
  .cta__save[aria-pressed='true'] .cta__save-on { display: inline; }
  .cta__save[aria-pressed='true'] .cta__save-off { display: none; }

  /* на мобилке кадр тоже уходит в край страницы */
  .cta__shot {
    aspect-ratio: 4 / 5;
    margin-inline: calc(var(--gutter) * -1);
  }

  .cta__bottom {
    display: grid;
    gap: var(--s-7) var(--s-8);
  }

  .cta__sub {
    font-size: var(--fs-h3);
    font-weight: var(--w-head);
    margin-bottom: var(--s-4);
  }

  @media (min-width: 900px) {
    .cta__top { grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr); }
    .cta__bottom { grid-template-columns: repeat(2, minmax(0, 1fr)); }

    .cta__shot {
      height: 100%;
      aspect-ratio: auto;
      margin-left: 0;
      /* правым краем кадр выходит в край экрана */
      margin-right: calc(var(--gutter) * -1);
    }
  }
</style>

<script>
  // Кнопка «В избранное» на бумаге — та же привязка, что у сердца поверх
  // кадра. Зовём здесь, а не полагаемся на скрипт первого экрана: блок
  // может встать на странице, где того первого экрана нет.
  import { bindSaveButtons } from '../lib/save';

  bindSaveButtons();
</script>
