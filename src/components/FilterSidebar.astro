---
// ПАНЕЛЬ ФИЛЬТРОВ — переиспользуемый модуль для любой категории подрядчиков.
// Группы приходят снаружи (FilterGroup[] из data/specialists), сама панель
// ничего не знает про «ведущих» — только про форму фильтра.
// Никакого своего скролла и высоты: панель — обычный поток, листается
// вместе со страницей (реф. Ozon). Кнопки «Показать» нет — фильтры
// применяются мгновенно при клике. Раскрытие групп — нативный <details>.
// Вариант — строка с квадратной отметкой (язык маркера .list).
import type { FilterGroup } from '../data/specialists';
import Icon from './Icon.astro';

interface Props {
  groups: FilterGroup[];
}

const { groups } = Astro.props;
---

<div class="filters">
  <div class="filters__head">
    <h2 class="filters__title">Фильтры</h2>
    <button class="filters__reset" type="button" data-filters-reset>Сбросить</button>
  </div>

  {groups.map((group, i) => (
    <details class="fgroup" open={i < 3}>
      <summary class="fgroup__head">
        <span>{group.label}</span>
        <Icon name="caretDown" class="fgroup__caret" />
      </summary>
      <div class="fgroup__options">
        {group.options.map((opt) => (
          <label class="fopt">
            <input
              class="fopt__input"
              type={group.type === 'single' ? 'radio' : 'checkbox'}
              name={group.key}
              value={opt.value}
              data-filter-key={group.key}
            />
            <span class="fopt__box" aria-hidden="true"></span>
            <span class="fopt__label">{opt.label}</span>
          </label>
        ))}
      </div>
    </details>
  ))}
</div>

<style>
  /* Колонка фильтров не заливается плашкой — выделяем её структурой:
     линия под шапкой «Фильтры» и вертикальная отбивка от каталога (ПК).
     Заливка тут проигрывает: рядом мозаика фото, ещё один прямоугольник
     цвета спорит с карточками. */
  .filters__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-3);
    padding-bottom: var(--s-4);
    margin-bottom: var(--s-6);
    border-bottom: 1px solid var(--hairline);
  }

  /* Шапка колонки крупнее пунктов — иерархия кеглем, не цветом */
  .filters__title {
    font-size: var(--fs-body);
    font-weight: var(--w-head);
  }

  .filters__reset {
    border: 0;
    background: none;
    color: var(--fg);
    font-size: var(--fs-caption);
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  .fgroup { padding-bottom: var(--s-6); }

  .fgroup:last-child { padding-bottom: 0; }

  .fgroup__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    font-size: var(--fs-small);
    font-weight: var(--w-medium);
    cursor: pointer;
    list-style: none;
  }

  .fgroup__head::-webkit-details-marker { display: none; }

  .fgroup__caret {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .fgroup[open] .fgroup__caret { transform: rotate(180deg); }

  .fgroup__options {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    padding-top: var(--s-4);
  }

  .fopt {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    cursor: pointer;
  }

  /* Чекбокс/радио спрятан, но доступен клавиатуре и скринридеру
     (не display:none) — видимая отметка ниже, .fopt__box. */
  .fopt__input {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .fopt__box {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    border: 1px solid var(--fg);
    border-radius: 50%;
  }

  /* Выбранный пункт — единственный цвет проекта: видно, что фильтр включён */
  .fopt__input:checked + .fopt__box {
    background: var(--accent);
    border-color: var(--accent);
  }

  .fopt__input:checked ~ .fopt__label { color: var(--accent); }

  .fopt__input:focus-visible + .fopt__box {
    outline: 2px solid var(--fg);
    outline-offset: 3px;
  }

  .fopt__label { font-size: var(--fs-small); }

  /* ПК: вертикальная отбивка отделяет колонку фильтров от мозаики каталога */
  @media (min-width: 1024px) {
    .filters {
      border-right: 1px solid var(--hairline);
      padding-right: var(--s-6);
    }
  }
</style>
