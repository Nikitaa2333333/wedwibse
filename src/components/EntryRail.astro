---
// КАРТОЧКИ-ВХОДЫ (главная) — два раздела каталога со счётчиками:
// «Площадки» и «Подрядчики». Больше здесь ничего нет.
//
// Раньше за ними стояли ещё два десятка направлений подрядчиков поимённо
// (ведущие, фотографы, декораторы…). Их убрали: у раздела появился свой
// экран выбора — хаб с шестью группами (pages/moskva/podryadchiki),
// и длинный хвост направлений на главной стал его дубликатом. Главная
// отвечает на вопрос «куда я иду», а не «кто именно мне нужен».
//
// ПЛАШКА СВЕДЕНА К МИНИМУМУ (13.09.2026). С неё сняты три слоя, каждый
// из которых был декорацией, а не сообщением:
//   • чернильный кружок-иконка в углу (пин, фигурки) — значок повторял
//     то же, что крупная строка имени под ним, и первым ловил взгляд;
//   • геометрическая фигура на заднем фоне (купол/клевер) — фон, который
//     тянул на себя внимание и заставлял плашку быть высокой, чтобы его
//     было куда положить;
//   • кружок вокруг стрелки — сама стрелка и есть знак «это ссылка».
// Осталось ровно то, ради чего сюда смотрят: стрелка, имя раздела и живые
// кадры его объектов. Высоту плашка больше не задаёт пропорцией — её
// держит содержимое, поэтому карточка стала низкой сама собой.
//
// ЧИСЛА И ФОТО НЕ ПИШУТСЯ РУКАМИ. Счётчики и кадры берутся на сборке из
// тех же данных, из которых собираются каталоги: завели площадку или
// карточку специалиста — главная подхватила сама.
import { Image } from 'astro:assets';
import { VENUES } from '../data/venues';
import { SPECIALISTS_BY_CATEGORY, type Specialist } from '../data/specialists';
import { withCount, type PluralForms } from '../lib/plural';
import { resolveImage, IMG_WIDTHS } from '../lib/images';

interface Card {
  name: string;
  href: string;
  count: number;
  /** форма слова под числом; без неё в подписи стоит одно число */
  noun?: PluralForms;
  /** кадры для стопки под именем: первые объекты раздела */
  thumbs: string[];
  /** раздел каталога: крупнее набором */
  lead?: boolean;
}

/** сколько кружков-фото стоит в стопке */
const THUMBS = 3;

// Подрядчик, стоящий в двух направлениях сразу (фотограф, который снимает
// и видео), — это один подрядчик, а не два: считаем по slug'ам, иначе
// счётчик раздела разойдётся с числом живых карточек.
const vendors = new Map<string, Specialist>();
for (const list of Object.values(SPECIALISTS_BY_CATEGORY)) {
  for (const s of list) vendors.set(s.slug, s);
}

const portraits = (list: Specialist[]) =>
  list.slice(0, THUMBS).map((s) => s.photos[0]).filter(Boolean);

const VENDORS: PluralForms = ['подрядчик', 'подрядчика', 'подрядчиков'];

const cards: Card[] = [
  {
    name: 'Площадки',
    href: '/moskva/ploshchadki/',
    count: VENUES.length,
    noun: ['площадка', 'площадки', 'площадок'],
    thumbs: VENUES.slice(0, THUMBS).map((v) => v.hero.portrait),
    lead: true,
  },
  {
    // Ведём на хаб раздела — экран с плитками шести групп
    // (pages/moskva/podryadchiki/index.astro), а не сразу в каталог
    // первого направления: из хаба человек выбирает группу сам.
    name: 'Подрядчики',
    href: '/moskva/podryadchiki/',
    count: vendors.size,
    noun: VENDORS,
    thumbs: portraits([...vendors.values()]),
    lead: true,
  },
];

// В подписи — одно число, без существительного: слово («13 подрядчиков»)
// повторяет имя раздела крупной строкой прямо над ним, а в узкой колонке
// телефона строка не влезала и распирала плашку за её край.
// Вслух число без слова не читается, поэтому у ссылки своя подпись — с ним.
const view = cards.map((card) => ({
  ...card,
  capsule: card.count === 0 ? 'скоро' : String(card.count),
  aria: `${card.name} — ${card.count === 0 ? 'скоро' : withCount(card.count, card.noun ?? VENDORS)}`,
}));
---

<section class="entries" aria-label="Разделы каталога">
  <ul class="entries__rail">
    {view.map((card, i) => (
      <li class="entries__item">
        <a
          class:list={['ecard', card.lead && 'ecard--lead']}
          href={card.href}
          aria-label={card.aria}
        >
          <span class="ecard__top">
            <span class="ecard__go" aria-hidden="true">↗</span>
          </span>

          <span class="ecard__foot">
            <span class="ecard__name">{card.name}</span>

            {/* Кадры — декорация к числу, поэтому без alt, и вся строка
                скрыта от читалки: ссылка уже подписана целиком. */}
            <span class="ecard__count" aria-hidden="true">
              {card.thumbs.length > 0 && (
                <span class="ecard__stack">
                  {card.thumbs.map((src) => (
                    <Image
                      class="ecard__thumb"
                      src={resolveImage(src)}
                      alt=""
                      widths={IMG_WIDTHS.thumb}
                      sizes="48px"
                      loading={i < 2 ? 'eager' : 'lazy'}
                      decoding="async"
                    />
                  ))}
                </span>
              )}
              <span class="ecard__label">{card.capsule}</span>
            </span>
          </span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  /* Поля до края экрана держит сам ряд (--edge-gap ниже). */
  .entries {
    background: var(--bg);
    padding-block: var(--s-5) var(--s-4);
  }

  /* Две карточки — значит не лента, а две равные колонки: листать нечего,
     и обрезанный край второй плашки звал бы жестом, которого нет.
     Ленту (overflow-x, снап, поля-под-скролл) сняли вместе с хвостом
     направлений — вернутся карточки, вернётся и она. */
  .entries__rail {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--pin-gap);
    /* От края экрана — волосок (--edge-gap), а не зазор между плашками:
       ряд стоит вровень с доской кадров под ним. */
    padding-inline: var(--edge-gap);
    list-style: none;
  }

  /* От планшета колонки перестают тянуться: две плашки во всю ширину
     монитора — это две башни в рост экрана. Встают слева, как начало
     ряда, а не растягиваются по нему. */
  @media (min-width: 640px) {
    .entries__rail {
      grid-template-columns: repeat(2, minmax(0, var(--entry-card-max)));
      justify-content: start;
    }
  }

  /* Плашка низкая: высоту задаёт содержимое (стрелка · имя · кадры),
     а не пропорция. Прежние 3/4 нужны были фигуре на заднем фоне —
     фигуры нет, и пустая высота вместе с ней. Строкой грид тянет обе
     плашки до одной высоты сам (align-items: stretch по умолчанию),
     поэтому aspect-ratio здесь не нужен: он же когда-то и заставлял
     карточку вылезать из колонки на длинном слове. */
  .ecard {
    /* БЕЗ ЦВЕТА. Тона --tint-* сняты: на главной остаётся палитра проекта —
       бумага, серая плашка, чернила. Заливка семантическая (--surface),
       поэтому в тёмной теме плашка темнеет сама, руками ничего не красим. */
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--s-5);
    width: 100%;
    min-width: 0;
    padding: var(--s-4);
    background: var(--surface);
    /* Набор — чернила текущей темы: плашка теперь того же семейства, что
       бумага страницы, и в тёмной теме переворачивается вместе с ней. */
    color: var(--ink);
    border-radius: var(--radius-card);
    text-decoration: none;
  }

  .ecard__top {
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }

  /* Стрелка без кружка: обводка вокруг неё делала из служебного знака
     второй значок в углу, а значков на плашке больше нет. Приглушение —
     opacity (правило проекта: не серый краской), поэтому стрелка гаснет
     в свой же тон и остаётся чернильной в любой теме. */
  .ecard__go {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: var(--fs-lead);
    line-height: 1;
    opacity: var(--entry-knob-dim);
  }

  .ecard__foot {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-3);
    min-width: 0;
  }

  /* Имя набрано плотнее обычного заголовка: в референсе именно трекинг
     держит крупную строку в узкой карточке. */
  .ecard__name {
    font-size: clamp(22px, 5.6vw, 26px);
    font-weight: var(--w-head);
    line-height: 1.02;
    letter-spacing: -0.03em;
  }

  /* Кегль считается от колонки, а не от экрана: раньше плашка занимала
     62vw в ленте, теперь их две по половине ширины — на прежних 8vw
     «Подрядчики» одним словом распирали карточку изнутри и она вылезала
     за свою колонку. Слово целиком, без переносов — значит и потолок
     кегля держим по нему. */
  .ecard--lead .ecard__name { font-size: clamp(22px, 5.4vw, 30px); }

  /* Строка «кадры + число» — «сколько их там» до перехода в каталог.
     Пилюли под ней больше нет: бумажная капсула была рамкой вокруг
     кадров и мешала им быть крупными — кружок в неё влезал только
     мелкий. Теперь кадры стоят прямо на плашке и держат размер сами,
     число — подписью рядом. */
  .ecard__count {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    font-size: var(--fs-caption);
    font-weight: var(--w-medium);
    line-height: 1.2;
    white-space: nowrap;
    max-width: 100%;
  }

  .ecard--lead .ecard__count { font-size: var(--fs-small); }

  /* Стопка: кружки лежат внахлёст на треть, каждый с обводкой цвета
     плашки, чтобы граница между соседними кадрами читалась */
  .ecard__stack {
    display: inline-flex;
    flex: none;
  }

  .ecard__thumb {
    width: var(--entry-thumb);
    height: var(--entry-thumb);
    border-radius: var(--radius-pill);
    object-fit: cover;
    /* обводка тоном плашки — кадры лежат прямо на ней */
    border: 2px solid var(--surface);
    background: var(--surface-dim);
  }

  .ecard__thumb + .ecard__thumb { margin-left: calc(var(--entry-thumb) / -3); }

  /* Число — полутон, а не чернила: это справка «сколько их там», и полным
     набором она спорит с именем раздела над ней. Приглушение — opacity
     (правило проекта: не серый краской), поэтому подпись гаснет в свой же
     тон. Гасим саму подпись, а не строку: иначе выцветут и кадры. */
  .ecard__label {
    min-width: 0;
    opacity: 0.7;
  }

  @media (hover: hover) {
    .ecard__go {
      transition: transform var(--dur-fast) var(--ease-out), opacity var(--dur-fast) var(--ease-out);
    }
    .ecard:hover .ecard__go { transform: translate(3px, -3px); opacity: 1; }
  }
</style>
