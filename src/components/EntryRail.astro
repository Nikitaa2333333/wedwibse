---
// КАРТОЧКИ-ВХОДЫ (главная) — два раздела каталога со счётчиками:
// «Площадки» и «Подрядчики». Больше здесь ничего нет.
//
// Раньше за ними стояли ещё два десятка направлений подрядчиков поимённо
// (ведущие, фотографы, декораторы…). Их убрали: у раздела появился свой
// экран выбора — хаб с шестью группами (pages/moskva/podryadchiki),
// и длинный хвост направлений на главной стал его дубликатом. Главная
// отвечает на вопрос «куда я иду», а не «кто именно мне нужен».
//
// ПЛИТКА ТЕПЕРЬ ТА ЖЕ, ЧТО В ХАБЕ (заказчик, 21.09.2026): кадр во всю
// ширину сверху, под ним имя и капсула со счётчиком — общий компонент
// CoverTile, а не вторая верстка того же. Прежняя плашка (иконка и
// стрелка в углах, стопка кружков-портретов внизу) рядом с хабом
// читалась другим сервисом: там раздел показывают люди на кадре,
// здесь — два значка и три кружка по 52 px.
//
// КАДРЫ КРУТЯТСЯ ТОЛЬКО У ПОДРЯДЧИКОВ (заказчик, 21.09.2026). За этим
// входом стоит не один человек, а весь раздел, и одной фотографией он
// говорит про одного: плитка перебирает обложки живых групп (ведущий,
// фотограф, декоратор) — те же кадры, что на плитках хаба. Смену делает
// CoverTile кроссфейдом по таймеру.
//
// ЗАГЛУШКА: у «Площадок» стоит ОДИН кадр реальной площадки и не
// меняется — свой кадр раздела (здание в том же ключе, что портреты
// подрядчиков на однотонном фоне) рисует заказчик. Появится — меняется
// одна строка VENUE_COVER ниже, и смена там не нужна: кадр раздела
// у площадок будет один, как знак.
//
// ЧИСЛА И ФОТО НЕ ПИШУТСЯ РУКАМИ. Счётчики и кадры берутся на сборке из
// тех же данных, из которых собираются каталоги: завели площадку или
// карточку специалиста — главная подхватила сама.
import CoverTile from './CoverTile.astro';
import { VENUES } from '../data/venues';
import {
  SPECIALIST_GROUPS,
  SPECIALISTS_BY_CATEGORY,
  type Specialist,
} from '../data/specialists';
import { withCount, type PluralForms } from '../lib/plural';
import { resolveImage, IMG_WIDTHS } from '../lib/images';

/** сколько кадров крутится в плитке */
const COVERS = 3;

// Подрядчик, стоящий в двух направлениях сразу (фотограф, который снимает
// и видео), — это один подрядчик, а не два: считаем по slug'ам, иначе
// счётчик раздела разойдётся с числом живых карточек.
const vendors = new Map<string, Specialist>();
for (const list of Object.values(SPECIALISTS_BY_CATEGORY)) {
  for (const s of list) vendors.set(s.slug, s);
}

// ОБЛОЖКИ ПОДРЯДЧИКОВ — те же кадры, что на плитках хаба: портрет
// на однотонном фоне в тон плашки. Первыми идут группы, в которых
// уже есть живые карточки: плитка показывает то, что за ней
// действительно стоит, а не раздел «скоро».
const filled = new Set<string>();
for (const g of SPECIALIST_GROUPS) {
  const has = g.categories.some((slug) => (SPECIALISTS_BY_CATEGORY[slug] ?? []).length > 0);
  if (has) filled.add(g.key);
}

const vendorCovers = [
  ...SPECIALIST_GROUPS.filter((g) => filled.has(g.key) && g.cover),
  ...SPECIALIST_GROUPS.filter((g) => !filled.has(g.key) && g.cover),
]
  .slice(0, COVERS)
  .map((g) => resolveImage(g.cover!));

const VENUE_COVER = VENUES[0] ? [resolveImage(VENUES[0].hero.portrait)] : [];

const VENDORS: PluralForms = ['подрядчик', 'подрядчика', 'подрядчиков'];

const cards = [
  {
    name: 'Площадки',
    href: '/moskva/ploshchadki/',
    capsule: VENUES.length === 0 ? 'скоро' : withCount(VENUES.length, ['площадка', 'площадки', 'площадок']),
    covers: VENUE_COVER,
    tone: 'beige' as const,
  },
  {
    // Ведём на хаб раздела — экран с плитками групп, а не сразу в каталог
    // первого направления: из хаба человек выбирает группу сам.
    name: 'Подрядчики',
    href: '/moskva/podryadchiki/',
    capsule: vendors.size === 0 ? 'скоро' : withCount(vendors.size, VENDORS),
    covers: vendorCovers,
    tone: 'dark' as const,
  },
];
---

<section class="entries" aria-label="Разделы каталога">
  <ul class="entries__rail">
    {cards.map((card) => (
      <li class="entries__item">
        <CoverTile
          name={card.name}
          href={card.href}
          capsule={card.capsule}
          covers={card.covers}
          tone={card.tone}
          widths={IMG_WIDTHS.card}
          sizes="(min-width: 640px) 320px, 50vw"
          eager
        />
      </li>
    ))}
  </ul>
</section>

<style>
  /* Поля до края экрана держит сам ряд (--edge-gap ниже). */
  .entries {
    background: var(--bg);
    padding-block: var(--s-5) var(--s-4);
  }

  /* Две карточки — значит не лента, а две равные колонки: листать нечего,
     и обрезанный край второй плашки звал бы жестом, которого нет.
     Ленту (overflow-x, снап, поля-под-скролл) сняли вместе с хвостом
     направлений — вернутся карточки, вернётся и она. */
  .entries__rail {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--pin-gap);
    /* От края экрана — волосок (--edge-gap), а не зазор между плашками:
       ряд стоит вровень с доской кадров под ним. */
    padding-inline: var(--edge-gap);
    list-style: none;
  }

  /* От планшета колонки перестают тянуться: две плашки во всю ширину
     монитора — это две башни в рост экрана. Встают слева, как начало
     ряда, а не растягиваются по нему. */
  @media (min-width: 640px) {
    .entries__rail {
      grid-template-columns: repeat(2, minmax(0, var(--entry-card-max)));
      justify-content: start;
    }
  }

  /* Плитка тянется на всю высоту своей ячейки — вид и пропорцию кадра
     держит сам CoverTile (4/5 у обложки), поэтому здесь высоты нет:
     aspect-ratio на самой плашке спорил бы с высотой ряда. */
  .entries__item { display: flex; }

</style>
