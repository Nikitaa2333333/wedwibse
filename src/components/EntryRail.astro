---
// КАРТОЧКИ-ВХОДЫ (главная) — два раздела каталога со счётчиками:
// «Площадки» и «Подрядчики». Больше здесь ничего нет.
//
// Раньше за ними стояли ещё два десятка направлений подрядчиков поимённо
// (ведущие, фотографы, декораторы…). Их убрали: у раздела появился свой
// экран выбора — хаб с шестью группами (pages/moskva/podryadchiki),
// и длинный хвост направлений на главной стал его дубликатом. Главная
// отвечает на вопрос «куда я иду», а не «кто именно мне нужен».
//
// Референс — экран проектов из мобильного приложения: вертикальные плашки,
// в углу чернильный кружок-иконка и кружок со стрелкой; имя набрано крупно
// и плотно; у низа — капсула со стопкой круглых фото и числом. Цвет из
// референса не взят: плашка залита серой бумагой проекта (--surface),
// капсула на тон гуще (--surface-dim), своих цветов у компонента нет.
//
// ЧИСЛА И ФОТО НЕ ПИШУТСЯ РУКАМИ. Счётчики и кадры в капсуле берутся
// на сборке из тех же данных, из которых собираются каталоги: завели
// площадку или карточку специалиста — главная подхватила сама.
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { VENUES } from '../data/venues';
import { SPECIALISTS_BY_CATEGORY, type Specialist } from '../data/specialists';
import { withCount, type PluralForms } from '../lib/plural';
import { resolveImage, IMG_WIDTHS } from '../lib/images';
import type { IconName } from '../lib/icons';

interface Card {
  name: string;
  href: string;
  count: number;
  /** форма слова под числом; без неё в капсуле стоит одно число */
  noun?: PluralForms;
  /** кадры для стопки в капсуле: два первых объекта раздела */
  thumbs: string[];
  icon?: IconName;
  /** геометрическая фигура на заднем фоне плашки (только у разделов) */
  figure?: 'dome' | 'clover';
  /** раздел каталога: крупнее набором, с кружком-иконкой */
  lead?: boolean;
}

/** сколько кружков-фото стоит в капсуле; больше двух — уже не стопка, а ряд */
const THUMBS = 2;

// Подрядчик, стоящий в двух направлениях сразу (фотограф, который снимает
// и видео), — это один подрядчик, а не два: считаем по slug'ам, иначе
// счётчик раздела разойдётся с числом живых карточек.
const vendors = new Map<string, Specialist>();
for (const list of Object.values(SPECIALISTS_BY_CATEGORY)) {
  for (const s of list) vendors.set(s.slug, s);
}

const portraits = (list: Specialist[]) =>
  list.slice(0, THUMBS).map((s) => s.photos[0]).filter(Boolean);

const VENDORS: PluralForms = ['подрядчик', 'подрядчика', 'подрядчиков'];

const cards: Card[] = [
  {
    name: 'Площадки',
    href: '/moskva/ploshchadki/',
    count: VENUES.length,
    noun: ['площадка', 'площадки', 'площадок'],
    thumbs: VENUES.slice(0, THUMBS).map((v) => v.hero.portrait),
    icon: 'venue',
    figure: 'dome',
    lead: true,
  },
  {
    // Ведём на хаб раздела — экран с плитками шести групп
    // (pages/moskva/podryadchiki/index.astro), а не сразу в каталог
    // первого направления: из хаба человек выбирает группу сам.
    name: 'Подрядчики',
    href: '/moskva/podryadchiki/',
    count: vendors.size,
    noun: VENDORS,
    thumbs: portraits([...vendors.values()]),
    icon: 'vendors',
    figure: 'clover',
    lead: true,
  },
];

// В капсуле — одно число, без существительного: слово («13 подрядчиков»)
// повторяет имя раздела крупной строкой прямо над капсулой, а в узкой
// колонке телефона строка не влезала и распирала плашку за её край.
// Вслух число без слова не читается, поэтому у ссылки своя подпись — с ним.
const view = cards.map((card) => ({
  ...card,
  capsule: card.count === 0 ? 'скоро' : String(card.count),
  aria: `${card.name} — ${card.count === 0 ? 'скоро' : withCount(card.count, card.noun ?? VENDORS)}`,
}));
---

<section class="entries" aria-label="Разделы каталога">
  <ul class="entries__rail">
    {view.map((card, i) => (
      <li class="entries__item">
        <a
          class:list={['ecard', card.lead && 'ecard--lead', card.figure && `ecard--${card.figure}`]}
          href={card.href}
          aria-label={card.aria}
        >
          {card.figure && <span class="ecard__fig" aria-hidden="true" />}

          <span class="ecard__top">
            {card.icon && (
              <span class="ecard__badge" aria-hidden="true"><Icon name={card.icon} /></span>
            )}
            <span class="ecard__go" aria-hidden="true">↗</span>
          </span>

          <span class="ecard__foot">
            <span class="ecard__name">{card.name}</span>

            {/* Капсула стоит на каждой карточке, даже на пустой: без неё имя
                проваливается к самому низу и ряд встаёт по двум разным
                вертикалям. Кадры внутри — декорация к числу, поэтому без alt
                и вся капсула скрыта от читалки: ссылка уже подписана целиком. */}
            <span class:list={['ecard__count', card.thumbs.length > 0 && 'ecard__count--thumbs']} aria-hidden="true">
              {card.thumbs.length > 0 && (
                <span class="ecard__stack">
                  {card.thumbs.map((src) => (
                    <Image
                      class="ecard__thumb"
                      src={resolveImage(src)}
                      alt=""
                      widths={IMG_WIDTHS.thumb}
                      sizes="32px"
                      loading={i < 2 ? 'eager' : 'lazy'}
                      decoding="async"
                    />
                  ))}
                </span>
              )}
              <span class="ecard__label">{card.capsule}</span>
            </span>
          </span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  /* Поля до края экрана держит сам ряд (--edge-gap ниже). */
  .entries {
    background: var(--bg);
    padding-block: var(--s-5) var(--s-4);
  }

  /* Две карточки — значит не лента, а две равные колонки: листать нечего,
     и обрезанный край второй плашки звал бы жестом, которого нет.
     Ленту (overflow-x, снап, поля-под-скролл) сняли вместе с хвостом
     направлений — вернутся карточки, вернётся и она. */
  .entries__rail {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--pin-gap);
    /* От края экрана — волосок (--edge-gap), а не зазор между плашками:
       ряд стоит вровень с доской кадров под ним. */
    padding-inline: var(--edge-gap);
    list-style: none;
  }

  /* От планшета колонки перестают тянуться: две плашки во всю ширину
     монитора — это две башни в рост экрана. Встают слева, как начало
     ряда, а не растягиваются по нему. */
  @media (min-width: 640px) {
    .entries__rail {
      grid-template-columns: repeat(2, minmax(0, var(--entry-card-max)));
      justify-content: start;
    }
  }

  /* Карточка вертикальная, как в референсе: ширину задаёт колонка, высота —
     от неё, пропорцией. Обе одного размера: ряд с рваным низом читается
     как сбой вёрстки, а не как ритм. */
  .ecard {
    /* БЕЗ ЦВЕТА. Тона --tint-* сняты: на главной остаётся палитра проекта —
       бумага, серая плашка, чернила. Заливка семантическая (--surface),
       поэтому в тёмной теме плашка темнеет сама, руками ничего не красим.
       Вернуть цветность = вернуть сюда --tint-*, разметка не изменится. */
    --tile: var(--surface);
    --tile-deep: var(--surface-dim);
    /* фигуре на заднем фоне нужен свой слой и обрезка по скруглению */
    position: relative;
    overflow: hidden;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--s-5);
    /* Ширину задаёт колонка, высоту — пропорция от неё. Никакого
       height: 100% рядом с aspect-ratio: растянутая по строке высота
       начинает диктовать ширину, карточка перестаёт слушаться колонки
       и вылезает за неё — тем сильнее, чем длиннее слово внутри. */
    width: 100%;
    min-width: 0;
    aspect-ratio: 3 / 4;
    padding: var(--s-4);
    background: var(--tile);
    /* Набор — чернила текущей темы: плашка теперь того же семейства, что
       бумага страницы, и в тёмной теме переворачивается вместе с ней. */
    color: var(--ink);
    border-radius: var(--radius-card);
    text-decoration: none;
  }

  /* ФИГУРА НА ЗАДНЕМ ФОНЕ. Тот же приём, что у папок «Избранного»:
     плашка остаётся плашкой, а внутри неё стоит простая геометрическая
     форма — маска из data-URI SVG поверх заливки. Отличие от «Избранного»
     в том, что там под маской фото, а здесь глубокая ступень того же
     тона (--tile-deep): фигура должна быть фоном, а не картинкой.
     Цвет плашки с тех пор стал серым (--surface/--surface-dim) — фигура
     ушла в тон вместе с ним, своих значений у неё по-прежнему нет.
     Своих цветов и картинок компонент по-прежнему не заводит.

     Держится в средней полосе — между строкой иконок и именем — и НЕ
     заходит под капсулу: капсула набрана тем же --tile-deep, на фигуре
     она растворяется (проверено макетом до вёрстки). Размер задаётся
     высотой, ширина идёт из aspect-ratio: круги клевера обязаны остаться
     круглыми, растянутая по ширине маска их сплющивает. */
  .ecard__fig {
    position: absolute;
    top: 19%;
    left: 50%;
    translate: -50% 0;
    height: 46%;
    aspect-ratio: 1;
    background: var(--tile-deep);
    -webkit-mask-image: var(--figure);
    mask-image: var(--figure);
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
  }

  /* Купол — площадки: арка зала, самая «архитектурная» из простых форм. */
  .ecard--dome .ecard__fig {
    --figure: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><path d='M6 100V50A44 44 0 0 1 94 50V100Z'/></svg>");
  }

  /* Клевер — подрядчики: четыре круга, каждый сам по себе, вместе одна
     форма. Маска рисуется четырьмя <circle>, а не путём: объединение
     кругов альфа-канал делает сам, руками путь сводить не нужно. */
  .ecard--clover .ecard__fig {
    --figure: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><circle cx='33' cy='33' r='28'/><circle cx='67' cy='33' r='28'/><circle cx='33' cy='67' r='28'/><circle cx='67' cy='67' r='28'/></svg>");
  }

  /* Содержимое — слоем выше фигуры */
  .ecard__top,
  .ecard__foot { position: relative; }

  .ecard__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    min-height: var(--entry-knob);
  }

  /* Кружок-иконка: чернильная заливка на тоне. Есть только у разделов
     каталога — если повесить его и на направления, ряд превращается
     в набор одинаковых значков и иконка перестаёт что-либо значить. */
  .ecard__badge {
    width: var(--entry-knob);
    height: var(--entry-knob);
    border-radius: var(--radius-pill);
    background: var(--ink);
    color: var(--paper);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .ecard__badge :global(svg) { width: 20px; height: 20px; }

  /* Стрелка в кружке — обводкой и приглушённая: она служебная, «это
     ссылка», и рядом с чернильным кружком-иконкой не должна с ним спорить.
     Приглушение — opacity, а не серый цвет (правило проекта): так кружок
     остаётся чернильным на любом тоне. */
  .ecard__go {
    margin-left: auto;
    width: var(--entry-knob);
    height: var(--entry-knob);
    flex: none;
    border-radius: var(--radius-pill);
    border: var(--entry-knob-line) solid currentColor;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: var(--fs-small);
    line-height: 1;
    opacity: var(--entry-knob-dim);
  }

  .ecard__foot {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-3);
    min-width: 0;
  }

  /* Имя набрано плотнее обычного заголовка: в референсе именно трекинг
     держит крупную строку в узкой карточке. */
  .ecard__name {
    font-size: clamp(22px, 5.6vw, 26px);
    font-weight: var(--w-head);
    line-height: 1.02;
    letter-spacing: -0.03em;
  }

  /* Кегль считается от колонки, а не от экрана: раньше плашка занимала
     62vw в ленте, теперь их две по половине ширины — на прежних 8vw
     «Подрядчики» одним словом распирали карточку изнутри и она вылезала
     за свою колонку. Слово целиком, без переносов — значит и потолок
     кегля держим по нему. */
  .ecard--lead .ecard__name { font-size: clamp(22px, 5.4vw, 30px); }

  /* Капсула со счётчиком — «сколько их там» до перехода в каталог.
     Того же тона, что карточка, только гуще (--tile-deep): белая капсула
     на тоне читалась заплаткой. Слева — стопка круглых кадров объектов
     раздела, справа число. */
  .ecard__count {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    padding: 6px 12px;
    border-radius: var(--radius-pill);
    background: var(--tile-deep);
    font-size: var(--fs-caption);
    font-weight: var(--w-medium);
    line-height: 1.2;
    white-space: nowrap;
    max-width: 100%;
  }

  /* Со стопкой кадров левое поле уже: у кружков своя граница, им воздух
     не нужен, а тексту справа — нужен */
  .ecard__count--thumbs { padding: 4px 12px 4px 4px; }

  .ecard--lead .ecard__count { font-size: var(--fs-small); }

  /* Стопка: кружки лежат внахлёст на треть, каждый с обводкой цвета
     капсулы, чтобы граница между двумя кадрами читалась */
  .ecard__stack {
    display: inline-flex;
    flex: none;
  }

  .ecard__thumb {
    width: 32px;
    height: 32px;
    border-radius: var(--radius-pill);
    object-fit: cover;
    border: 2px solid var(--tile-deep);
    background: var(--surface-dim);
  }

  .ecard__thumb + .ecard__thumb { margin-left: -10px; }

  /* Число со словом — полутон, а не чернила: в капсуле это справка
     «сколько их там», и полным набором она спорит с именем раздела над
     ней. Приглушение — opacity (правило проекта: не серый краской),
     поэтому подпись гаснет в свой же тон, а не в чужой серый.
     0.7 — нижняя граница: на самых глухих тонах (глина, лаванда) это
     ещё 4.9:1 к заливке капсулы, тише — мелкий кегль уходит под 4.5:1.
     Гасим саму подпись, а не капсулу: иначе выцветут и кадры в стопке. */
  .ecard__label {
    min-width: 0;
    opacity: 0.7;
  }

  @media (hover: hover) {
    .ecard__go {
      transition: transform var(--dur-fast) var(--ease-out), opacity var(--dur-fast) var(--ease-out);
    }
    .ecard:hover .ecard__go { transform: translate(3px, -3px); opacity: 1; }
  }
</style>
