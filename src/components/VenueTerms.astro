---
// Условия площадки: деньги, бронирование, что входит в стоимость,
// что считается отдельно. Всё «метка — значение» идёт строками (.rows),
// чистые перечисления — маркированным списком (.list).
import type { Venue } from '../data/venues';

interface Props {
  kicker: string;
  title: string;
  terms: Venue['terms'];
  included: Venue['included'];
  extras: Venue['extras'];
}

const { kicker, title, terms, included, extras } = Astro.props;
---

<section class="terms section" id="usloviya">
  <div class="container container--wide">
    <header class="terms__head">
      <p class="terms__kicker t-caption">{kicker}</p>
      <h2 class="terms__title">{title}</h2>
    </header>

    <!-- ДЕНЬГИ: прайс и депозит. Каждая таблица занимает всю ширину —
         в половине колонки метка и значение сталкивались и переносились. -->
    <div class="terms__money">
      {
        terms.map((group) => (
          <div class="group" data-reveal>
            <h3 class="group__name">{group.title}</h3>
            <dl class="rows">
              {group.rows.map((row) => (
                <div class="rows__row">
                  <dt class="rows__label">{row.label}</dt>
                  <dd class="rows__value">{row.value}</dd>
                </div>
              ))}
            </dl>
          </div>
        ))
      }
    </div>

    <!-- ЧТО ВХОДИТ: чистые перечисления, поэтому колонки читаются легко -->
    <div class="terms__included" data-reveal-group>
      {
        included.map((group) => (
          <div class="group">
            <h3 class="group__name">{group.title}</h3>
            {group.note && <p class="group__note t-small">{group.note}</p>}
            <ul class="list">
              {group.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <!-- ЗА ОТДЕЛЬНУЮ ПЛАТУ: снова таблица, снова во всю ширину -->
    <div class="terms__extras">
      {
        extras.map((group) => (
          <div class="group" data-reveal>
            <h3 class="group__name">{group.title}</h3>
            {group.note && <p class="group__note t-small">{group.note}</p>}
            <dl class="rows">
              {group.rows.map((row) => (
                <div class="rows__row">
                  <dt class="rows__label">{row.label}</dt>
                  <dd class="rows__value">{row.value}</dd>
                </div>
              ))}
            </dl>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* По полям страницы, как сцены и вопросы */
  .terms :global(.container) { max-width: none; }

  .terms__head { margin-bottom: var(--section-gap-tight); }

  .terms__kicker {
    font-weight: var(--w-medium);
    margin-bottom: var(--s-3);
  }

  .terms__title {
    font-size: var(--fs-h1);
    font-weight: var(--w-head-lg);
    line-height: var(--lh-display);
    letter-spacing: var(--ls-display);
    max-width: var(--measure-head);
  }

  /* Три блока с разным характером: таблица — во всю ширину, перечисления —
     в колонки. Разрыв между блоками один, задаётся здесь. */
  .terms__money,
  .terms__included,
  .terms__extras {
    display: grid;
    gap: var(--section-gap-tight) var(--s-8);
  }

  .terms__included,
  .terms__extras { margin-top: var(--section-gap-tight); }

  .group__name {
    font-size: var(--fs-h3);
    font-weight: var(--w-head);
    margin-bottom: var(--s-4);
  }

  .group__note { margin-bottom: var(--s-4); }

  /* внутри колонки ширину задаёт сама колонка — меру не дублируем */
  .group .list { max-width: none; }

  @media (min-width: 900px) {
    /* В колонки уходят только списки: у них короткая строка и свой маркер,
       поэтому две колонки помогают читать, а не мешают. Таблицы «метка —
       значение» остаются на всю ширину. */
    .terms__included { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
