{
  "name": "wed-secrets-video",
  "private": true,
  "description": "Промо-ролики WED Secrets на Remotion. Отдельно от сайта: в сборку и на сервер не идёт.",
  "type": "module",
  "scripts": {
    "studio": "remotion studio",
    "capture": "node scripts/capture.mjs",
    "render": "npm run render:v && npm run render:h",
    "render:v": "remotion render PromoVertical out/promo-9x16.mp4",
    "render:h": "remotion render PromoWide out/promo-16x9.mp4",
    "still": "remotion still PromoVertical out/still.png --frame=45"
  },
  "dependencies": {
    "@remotion/cli": "4.0.538",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.538"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}
