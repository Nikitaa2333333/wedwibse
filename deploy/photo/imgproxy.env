# imgproxy — сервис фото WED Secrets (07.11.2026, docs/PHOTO-SERVICE.md).
# На сервере: /etc/wedsecrets/imgproxy.env, читает служба imgproxy.service.
# Значения сверены с docs.imgproxy.net/configuration/options (v4.0).

# только изнутри сервера: снаружи его видит лишь nginx
IMGPROXY_BIND=127.0.0.1:8081

# Оригиналы: служба монтирует внутрь корня две папки только на чтение
# (BindReadOnlyPaths в imgproxy.service): site → /var/www/wedsecrets/_astro,
# pb → /srv/wedsecrets-pb/pb_data/storage.
IMGPROXY_LOCAL_FILESYSTEM_ROOT=/srv/wedsecrets-photos/src
# кроме диска — только кадры превью анкеты у базы на 127.0.0.1
IMGPROXY_ALLOWED_SOURCES=local://,http://127.0.0.1:8090/api/wed/preview-file
IMGPROXY_ALLOW_LOOPBACK_SOURCE_ADDRESSES=true

# Без подписи, но режет ТОЛЬКО наши ширины (пресеты): чужую картинку через нас
# не прогнать (источники выше), свои кадры — только в наши размеры. Лестница
# ширин — src/lib/photo-url.mjs (PHOTO_WIDTHS); меняется там — меняется здесь
# и в регулярках deploy/photo/nginx-*.conf.
IMGPROXY_ONLY_PRESETS=true
IMGPROXY_PRESETS=w220=rs:fit:220:0/f:webp,w320=rs:fit:320:0/f:webp,w360=rs:fit:360:0/f:webp,w440=rs:fit:440:0/f:webp,w480=rs:fit:480:0/f:webp,w560=rs:fit:560:0/f:webp,w640=rs:fit:640:0/f:webp,w720=rs:fit:720:0/f:webp,w800=rs:fit:800:0/f:webp,w900=rs:fit:900:0/f:webp,w1100=rs:fit:1100:0/f:webp,w1200=rs:fit:1200:0/f:webp,w1400=rs:fit:1400:0/f:webp,w1800=rs:fit:1800:0/f:webp,w2400=rs:fit:2400:0/f:webp

# качество — дефолт imgproxy (webp 79 ≈ дефолт sharp ~80), руками не дожимаем
# (CLAUDE.md, «Изображения»); метаданные срезаются, цветовой профиль → sRGB

# память: 2 ГБ на весь сервер, страницы важнее. Два потока на два ядра,
# очередь не бесконечная, огромный исходник не берём.
IMGPROXY_WORKERS=2
IMGPROXY_REQUESTS_QUEUE_SIZE=64
IMGPROXY_MAX_SRC_RESOLUTION=50
MALLOC_ARENA_MAX=2

# ответ кэшируют nginx и браузер: адрес варианта неизменен
IMGPROXY_TTL=31536000
