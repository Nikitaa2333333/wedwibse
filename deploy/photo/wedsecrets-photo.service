# /etc/systemd/system/wedsecrets-photo.service — обработчик нарезки
# (scripts/photo-worker.mjs, 07.11.2026). Код кладёт деплой в
# /srv/wedsecrets-photos/app/ с той же раскладкой папок, что в репозитории.
[Unit]
Description=WED Secrets — нарезка фото по «Готово» и обходом (docs/PHOTO-SERVICE.md)
After=network.target imgproxy.service nginx.service
Wants=imgproxy.service

[Service]
User=deploy
Group=deploy
WorkingDirectory=/srv/wedsecrets-photos/app
ExecStart=/usr/bin/node scripts/photo-worker.mjs
Environment=PHOTO_QUEUE=/srv/wedsecrets-photos/queue
Environment=PHOTO_STORE=/srv/wedsecrets-photos/store
Environment=PB_STORAGE=/srv/wedsecrets-pb/pb_data/storage
Environment=SITE_ASTRO=/var/www/wedsecrets/_astro
Environment=CUT_URL=http://127.0.0.1:8088
# specialists, venues (id коллекций из миграций базы)
Environment=CARD_COLLS=pbc_1374551344,pbc_1379753955
Environment=SWEEP_MIN=10
Restart=always
RestartSec=10
MemoryMax=150M
Nice=10

[Install]
WantedBy=multi-user.target
